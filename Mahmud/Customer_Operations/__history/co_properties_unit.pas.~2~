{function TCO_PropertiesForm.New: Boolean;
begin
  Reset;
  CO_Datamod.ActiveCustomerList.Insert;
  InfoView.Visible := False;
  ShowModal;
  Result := FChanged; 
end;
    }     {
procedure TCO_PropertiesForm.Edit(ID: Integer);
var
  Customer: TCustomer;
begin
  Reset;
  CO_DataMod.ActiveCustomerList.Edit;
  Sb_GetCustomer(ID, Customer);
  CustomerParams := Customer;
  InfoView.Visible := True;
  ShowModal;
end;
procedure TCO_PropertiesForm.SetClientClosed(Value: Boolean);
begin
  FClientClosed := Value;
//  ClientClosedPanel.Visible := Value;
  CloseDateEdit.Enabled := Value;
  ClientClosedCB.Checked := Value;
end;

procedure TCO_PropertiesForm.Reset;
begin
  FChanged := False;
  OpenDateEdit.DateTime := Sb_GetSystemDate();
  ClientClosed := False;
end;

procedure TCO_PropertiesForm.SetCustomerParams(Customer: TCustomer);
begin
  FCustomerParams := Customer;

  with CustomerParams do
  begin
    OpenDateEdit.DateTime := OpenDate;
    CloseDateEdit.DateTime := CloseDate;
    ClientClosed := CloseDate <> NullDate;

    CO_DataMod.Relation.DataSet.Locate('ID', RelationID, []);
  end;
end;          }
procedure TCO_PropertiesForm.CancelButtonClick(Sender: TObject);
begin
  Close;
end;

procedure TCO_PropertiesForm.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
if Key = VK_ESCAPE then
    Close;
end;

procedure TCO_PropertiesForm.FormKeyPress(Sender: TObject; var Key: Char);
begin
if Ord(Key) = VK_RETURN then
    SelectNext(ActiveControl, True, True);
end;

end.
