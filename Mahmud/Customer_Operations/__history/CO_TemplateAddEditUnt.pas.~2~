unit CO_TemplateAddEditUnt;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, ActnList, Buttons, Mask, DBCtrls;

type
  TCO_TemplAddEditForm = class(TForm)
    DBEdit1: TDBEdit;
    DBEdit2: TDBEdit;
    SBOpenDlg: TSpeedButton;
    ActionList1: TActionList;
    ActnAccept: TAction;
    ActnReject: TAction;
    Label1: TLabel;
    Label2: TLabel;
    Button1: TButton;
    Button2: TButton;
    DBEdit3: TDBEdit;
    procedure ActnAcceptExecute(Sender: TObject);
    procedure ActnRejectExecute(Sender: TObject);
    procedure SBOpenDlgClick(Sender: TObject);



  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  CO_TemplAddEditForm: TCO_TemplAddEditForm;

implementation
uses CO_datamod_impl,BookmarkSetup;
{$R *.DFM}


procedure TCO_TemplAddEditForm.ActnAcceptExecute(Sender: TObject);
begin
       DBEdit3.Text:='0' ;
      if (DBEdit1.Text<>'') and (DBEdit2.Text<>'')  then
      begin
        with CO_DataMod.Templates do
             Post;
             ModalResult := mrOk;
      end  else
      begin
        if DBEdit1.Text='' then  ShowMessage('Ўаблонун ады даxил  eдилм€йиб');
        if DBEdit2.Text='' then  ShowMessage('Ўаблон файлы даxил  eдилм€йиб');
        with CO_DataMod.Templates do
             Cancel;
      end;

end;

procedure TCO_TemplAddEditForm.ActnRejectExecute(Sender: TObject);
begin
    with CO_DataMod.Templates do
          Cancel;
          ModalResult := mrCancel;
end;



procedure TCO_TemplAddEditForm.SBOpenDlgClick(Sender: TObject);
begin
  if CO_BookmarkSetup.OpenDlg.Execute then
  CO_DataMod.Templates.FieldByName('Path').AsString :=CO_BookmarkSetup.OpenDlg.FileName;

end;

end.
