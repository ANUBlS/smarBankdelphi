procedure TCustomerInfoForm.CustInfoDataAfterOpen(DataSet: TDataSet);
var
  Index: Integer;
begin
Customers_relations.Close;
Customers_relations.SetVariable('v_custid',CO_DataMod.Customers.FieldByName('ID').AsInteger);
Customers_relations.Open;
CustInfoData.FieldByName('IDCust').AsInteger := Customers_relations.FieldByName('custid2').AsInteger;
  //CustInfoData.FieldByName('IDCust').AsInteger := CO_DataMod.Customers.FieldByName('ID').AsInteger;
  with DataSet, TabControl do
  begin
    Tabs.Clear;
    for Index := 0 to RecordCount-1 do
      Tabs.Add(Format('Kart N-%d', [Index]));
    First;
  end;

end;

