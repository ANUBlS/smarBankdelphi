end;

procedure TCO_DataMod.SetCommission(CommissionID, DebitID, CreditID: Longint;
  DebitAmmount, CreditAmmount: Currency; TransDate: TDateTime);

  function IsCommission: Boolean;
  begin
    with CO_TransTypeIncOUT do
      Result := OperationMode = omCommission;
  end;

begin
  if IsCommission then
    with OSCT do
      CallProcedure(cs_commission_execute, ['CommisionID', CommissionID,
        'DebitID', DebitID, 'CreditID', CreditID, 'DebitAmmount', DebitAmmount,
        'CreditAmmount', CreditAmmount, 'TransDate', TransDate]);
end;

