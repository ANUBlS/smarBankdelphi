procedure TCO_DataMod.CustomersApplyRecord(Sender: TOracleDataSet; Action: Char;
  var Applied: Boolean; var NewRowId: string);
var
  CustomerInfo: TCustomer;
begin
  with Sender, CustomerInfo do
  begin
    Name := FieldByName('NAME').AsString;
    ShortName := FieldByName('Short_Name').AsString;
    OpenDate := FieldByName('OPEN_DAT').AsDateTime;
    CloseDate := FieldByName('CLOSE_DAT').AsDateTime;
    RelationID := FieldByName('PRINAD_KOD').AsInteger;
    GroupID := FieldByName('GROUP_KLIE').AsInteger;
    EstateType := FieldByName('VID_SOB').AsInteger;
    OrganizationType := FieldByName('ORG_SOB').AsInteger;
    ActionArea := FieldByName('SFERA_DEY').AsInteger;
    BranchID := FieldByName('OTRASL').AsInteger;
    TaxAreaID := FieldByName('NALOG_KOD').AsInteger;
    IsResident := FieldByName('NEREZIDENT').AsInteger = 1;
    TaxIDString := FieldByName('INN').AsString;
    BankIDString := FieldByName('BIK').AsString;
    OKPRO := FieldByName('KOD_OKPRO').AsString;
    // GovOfficer := FieldByName('OTV_LICO').AsString;
    TaxDepartmentRegDate := FieldByName('DAT_NAL').AsDateTime;
    CapitalRegDate := FieldByName('DAT_USTAV').AsDateTime;
    INCORPORATION_NUMBER := FieldByName('INCORPORATION_NUMBER').AsString;
    tph_contact_type := FieldByName('TPH_CONTACT_TYPE').AsString;
    TPH_COMMUNICATION_TYPE := FieldByName('TPH_COMMUNICATION_TYPE').AsString;
    TPH_NUMBER := FieldByName('TPH_NUMBER').AsString;
    ADDRESS_TYPE := FieldByName('ADDRESS_TYPE').AsString;
    ADDRESS := FieldByName('ADDRESS').AsString;
    CITY := FieldByName('CITY').AsString;
    COUNTRY_CODE := FieldByName('COUNTRY_CODE').AsString;
    EMAIL := FieldByName('EMAIL').AsString;
    URL := FieldByName('URL').AsString;
    INCORPORATION_STATE := FieldByName('INCORPORATION_STATE').AsString;
    INCORPORATION_CNTR := FieldByName('INCORPORATION_CNTR').AsString;
    TPH_EXTENSION := FieldByName('TPH_EXTENSION').AsString;
    TPH_ZIP := FieldByName('TPH_ZIP').AsString;
    tph_country_prefix := FieldByName('TPH_COUNTRY_PREFIX').AsString;
    TPH_STATE := FieldByName('TPH_STATE').AsString;
    RISK_CATEG := FieldByName('RISK_CATEG').AsString;

  end;

  Applied := True;

  case Action of
    'I':
      Sb_AddCustomer(CustomerInfo);
    'U':
      Sb_EditCustomer(Sender.FieldByName('ID').AsInteger, CustomerInfo);
  else
    Applied := False;
  end;
end;

