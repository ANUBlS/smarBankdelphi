unit UnitAccountTrans;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, Mask, DBCtrls, Buttons, ExtCtrls, DB, OracleData,
  SearchEdit, CMDBSearchEdit;

type
  TFormAccountTrans = class(TForm)
    Panel1: TPanel;
    SpeedButton2: TSpeedButton;
    Panel2: TPanel;
    SpeedButton1: TSpeedButton;
    Label1: TLabel;
    Panel3: TPanel;
    SpeedButton3: TSpeedButton;
    Label2: TLabel;
    Panel4: TPanel;
    SpeedButton4: TSpeedButton;
    Label3: TLabel;
    OracleDataSet1: TOracleDataSet;
    DataSource1: TDataSource;
    OracleDataSet2: TOracleDataSet;
    DataSource2: TDataSource;
    OracleDataSet3: TOracleDataSet;
    DataSource3: TDataSource;
    CMSearchEdit1: TCMSearchEdit;
    CMSearchEdit2: TCMSearchEdit;
    CMSearchEdit3: TCMSearchEdit;
    procedure SpeedButton1Click(Sender: TObject);
    procedure FormActivate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure SpeedButton3Click(Sender: TObject);
    procedure SpeedButton4Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormAccountTrans: TFormAccountTrans;

implementation

{$R *.dfm}
uses sboapiDataModuleImpl, DataAIFUnit;

procedure TFormAccountTrans.FormActivate(Sender: TObject);
  var s:integer;
begin
  OracleDataSet1.Open;
  OracleDataSet2.Open;
  OracleDataSet3.Open;
  //s:=DataModuleAIF.AifConfig.FieldByName('paccid').AsInteger;
 // OracleDataSet1.Filtered:=false;
 // OracleDataSet1.Filter:='(id=s)';
  CMSearchEdit1.Text:=OracleDataSet1.FieldByName('acc_no').AsString;
end;

procedure TFormAccountTrans.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  OracleDataSet1.Close;
  OracleDataSet2.Close;
  OracleDataSet3.Close;
end;

procedure TFormAccountTrans.SpeedButton1Click(Sender: TObject);
begin
  DataModuleAIF.DEL.CallProcedure('aifconfigaddaccid',[CMSearchEdit1.Text,1]);
end;

procedure TFormAccountTrans.SpeedButton3Click(Sender: TObject);
begin
  DataModuleAIF.DEL.CallProcedure('aifconfigaddaccid',[CMSearchEdit2.Text,2]);
end;

procedure TFormAccountTrans.SpeedButton4Click(Sender: TObject);
begin
  DataModuleAIF.DEL.CallProcedure('aifconfigaddaccid',[CMSearchEdit3.Text,3]);
end;

end.
