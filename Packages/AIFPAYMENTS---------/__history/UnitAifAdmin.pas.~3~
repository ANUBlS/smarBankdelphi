unit UnitAifAdmin;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, DBGridEhGrouping, GridsEh, DBGridEh, StdCtrls, ExtCtrls;

type
  TFormAdmin = class(TForm)
    Panel1: TPanel;
    GroupBox1: TGroupBox;
    DBGEh_Admin_Setting: TDBGridEh;
    GroupBox4: TGroupBox;
    DBGridEh1: TDBGridEh;
    DBGridEh2: TDBGridEh;
    procedure DBGridEh1KeyPress(Sender: TObject; var Key: Char);
    procedure DBGridEh1DblClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormAdmin: TFormAdmin;

implementation
uses DataAIFUnit;

{$R *.dfm}

procedure TFormAdmin.DBGridEh1DblClick(Sender: TObject);
begin
  With DataModuleAIF do
  begin
    DEL.CallProcedure('xs_Admin_in_Add',[AIFADMIN.FieldByName('ID').AsInteger
                                        ,ODS_Ad_Sett_Fili.FieldByName('ID').AsInteger
                                        ,ODS_Admin_Setting.FieldByName('NAME').AsString
                                        ,ODS_Ad_Sett_Fili.FieldByName('NAME').AsString]);
   DataModuleAIF.AIFADMIN.Refresh;

end;

procedure TFormAdmin.DBGridEh1KeyPress(Sender: TObject; var Key: Char);
begin
  if key=#13 then
      DBGridEh1DblClick(Sender);
   if key=#27 then
   begin
      Close;
      key:=#0;
   end;
end;

end.
