unit UnitAifAdmin;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, DBGridEhGrouping, GridsEh, DBGridEh, StdCtrls, ExtCtrls;

type
  TFormAdmin = class(TForm)
    Panel1: TPanel;
    GroupBox1: TGroupBox;
    DBGEh_Admin_Setting: TDBGridEh;
    GroupBox4: TGroupBox;
    DBGridEh1: TDBGridEh;
    DBGridEh2: TDBGridEh;
    procedure DBGridEh1KeyPress(Sender: TObject; var Key: Char);
    procedure DBGridEh1DblClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormAdmin: TFormAdmin;

implementation
uses DataAIFUnit;

{$R *.dfm}

procedure TFormAdmin.DBGridEh1DblClick(Sender: TObject);
begin
  With DataModuleAIF do
  begin
    DEL.CallProcedure('xs_Admin_in_Add',[AifUsers.FieldByName('ID').AsInteger
                                        ,AifFilial.FieldByName('ID').AsInteger
                                        ,AifUsers.FieldByName('NAME').AsString
                                        ,AifFilial.FieldByName('NAME').AsString]);
    AIFADMIN.Refresh;
  end;

end;

procedure TFormAdmin.DBGridEh1KeyPress(Sender: TObject; var Key: Char);
begin
  if key=#13 then
      DBGridEh1DblClick(Sender);
   if key=#27 then
   begin
      Close;
      key:=#0;
   end;
end;

procedure TFormAdmin.FormClose(Sender: TObject; var Action: TCloseAction);
begin
   With DataModuleAIF do
   begin
     AifUsers.Active:=False;
     AifFilial.Active:=False;
   end;
end;

end.
