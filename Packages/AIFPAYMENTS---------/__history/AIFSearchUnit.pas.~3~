unit AIFSearchUnit;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, Buttons, DBCtrls, ComCtrls, ExtCtrls,SearchEdit;

type
  TFormAifSearch = class(TForm)
    Panel1: TPanel;
    PageControl1: TPageControl;
    TabSheet1: TTabSheet;
    GroupBox1: TGroupBox;
    Label1: TLabel;
    Label2: TLabel;
    CBSearchWhere: TDBLookupComboBox;
    BitBtn2: TBitBtn;
    Edit1: TEdit;
    BitBtn1: TBitBtn;
    Edit2: TEdit;
    procedure FormShow(Sender: TObject);
    procedure BitBtn2Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormAifSearch: TFormAifSearch;

implementation

{$R *.dfm}

procedure TFormAifSearch.BitBtn2Click(Sender: TObject);
resourcestring
  rsNothingToSearch = 'Axtarılmalı olanı daxil edin!';
var
  FieldToSearch : String;
  SearchValue : String;
begin
  SearchValue := Edit1.Text;

  if SearchValue = '' then
  if not Visible then
  begin
    Show;
    Edit1.SetFocus;
    Edit1.SelectAll;
    Exit
  end
  else
    raise ESearchError.Create(rsNothingToSearch);

  with  ExpressFrom do
  begin
    DbGr.SelectedRows.Clear;
     FieldToSearch := CBSearchWhere.KeyValue;

  FindNextRecord(
      DbGr.DataSource.DataSet,
      FieldToSearch,
      SearchValue )
  end;

end;


procedure TFormAifSearch.FormShow(Sender: TObject);
begin
  Edit1.Clear;
end;

end.
