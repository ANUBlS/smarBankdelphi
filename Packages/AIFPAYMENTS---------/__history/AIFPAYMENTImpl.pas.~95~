procedure TAIFPAYMENT.XDBGrid1TitleClick(Column: TXColumn);
begin
 IF Column.FieldName = '' THEN
    exit;
  with DataModuleAIF, AIFPAYMENTS do
  begin
    close;
    if Column.Title.MarkerIndex = 2 then
      SetVariable('title', Column.FieldName + ' ' + 'ASC')
    else
      SetVariable('title', Column.FieldName + ' ' + 'DESC');
    open;
  end;

end;

Function ChekPayid(S:string):boolean;
begin
  with DataModuleAIF do
  begin
    AifDataCheck.Close;
    AifDataCheck.SQL.Clear;
    AifDataCheck.SQL.Add('Select pay_id from aifpayments where pay_id='''+S+'''');
    AifDataCheck.Open;
  end;
  if DataModuleAIF.AifDataCheck.RecordCount > 0 then Result:=False
                                                else Result:=True;
end;


procedure TAIFPAYMENT.ConvertToBase;
var X,Y,I,K,ToEnd: Integer;
    oldCursor: TCursor;
    Tx:array[0..18]of String;
    ErrStr:string;

begin
  oldCursor:= Screen.Cursor;
  Screen.Cursor:= crHourglass;
  Info_ListBox.Clear;
  Panel_info.Hide;
  with RichEdit1 do begin
                      X:=0;
                      Y:=0;
                      i:=0;
                      ToEnd:=length(Text);
                      while X <> -1 do begin
                                         X:=FindText(fields[i], X, ToEnd, []);
                                         SetFocus;
                                         SelStart:=X;
                                         SelLength:=length(fields[i]);
                                         Y:=CaretPos.Y;
                                         Tx[i]:=Trim(copy(Lines[Y],length(fields[i])+1,length(Lines[Y])-length(fields[i])-length('/'+fields[i])));
                                         inc(i);
                                         if (X< ToEnd) and (i=19) then
                                         begin
                                           i:=0;
                                           if ChekPayid(Tx[15]) then
                                           DataModuleAIF.aif_payments.CallProcedure('aifpaymentsinsert',
                                                                                    ['v_PAYDATE'      ,Tx[0],
                                                                                     'v_FULLNAME'     ,Tx[1],
                                                                                     'v_CLIENTID'     ,Tx[2],
                                                                                     'v_CREDITID'     ,Tx[3],
                                                                                     'v_CR'           ,Tx[4],
                                                                                     'v_FONDINT'      ,Tx[5],
                                                                                     'v_BANKINT'      ,Tx[6],
                                                                                     'v_ODCR'         ,Tx[7],
                                                                                     'v_ODFONDINT'    ,Tx[8],
                                                                                     'v_ODBANKINT'    ,Tx[9],
                                                                                     'v_ODPENALTYINT' ,Tx[10],
                                                                                     'v_PAYTYPE'      ,Tx[11],
                                                                                     'v_MPAYM'        ,Tx[12],
                                                                                     'v_MATURITY'     ,Tx[13],
                                                                                     'v_CRBAL'        ,Tx[14],
                                                                                     'v_PAYID'        ,Tx[15],
                                                                                     'v_NEXTMPAYM'    ,Tx[16],
                                                                                     'v_NEXTMFONDINT' ,Tx[17],
                                                                                     'v_NEXTMBANKINT' ,Tx[18]
                                                                                     ]
                                                                                     )
                                          else  begin
                                                  ErrStr := ErrStr + 'Xəbərdarlıq:  <'+Tx[15]+'>   Artıq konvert olunub !'+#13;
                                                  Info_ListBox.Items.Text := ErrStr;
                                                  Panel_Info.Show;
                                                end;
                                        end;
                                       end;
                   end;
  Screen.Cursor:= oldCursor;
end;


