procedure TAIFPAYMENT.ToolButton3Click(Sender: TObject);
 var i,j,k,S : integer;
     GridBookMark:TBookMark;

begin
   k:=0;
   DataModuleAIF.SB_ACA.CallProcedure('CheckAdvancedObjectAccess',['AIF_DELETE']);
   if XDBGrid1.DataSource.DataSet.RecordCount = 0 then Exit;
   //XDBGrid1.SetFocus;
   //XDBGrid1.SelectedRows.CurrentRowSelected:=XDBGrid1.DataSource.DataSet.RecordCount<>0;

   With XDBGrid1.SelectedRows do
   begin
     GridBookMark:=XDBGrid1.DataSource.DataSet.GetBookmark;
     for i:=0 to Count-1 do
     begin
       if IndexOf(Items[i]) > -1 then
       begin
         XDBGrid1.Datasource.Dataset.Bookmark:= Items[i];
         S:=XDBGrid1.DataSource.DataSet.fieldbyname('id').asinteger;
       end;
       case
         MessageDlg(format('Əməliyyat silinsinmi #%d ?',[S]), mtConfirmation,[mbyes,mbno,mbcancel,mball], 0) of
           mryes : begin
                     DataModuleAIF.DEL.CallProcedure('aifpaymentsdelete',[S]);
                     XDBGrid1.DataSource.DataSet.GotoBookmark(GridBookMark);
                   end;
           mrno  : begin
                     XDBGrid1.DataSource.DataSet.Refresh;
                     XDBGrid1.SelectedRows.Clear;
                     exit;
                   end;
           mrcancel : begin
                        XDBGrid1.DataSource.DataSet.Refresh;
                        XDBGrid1.SelectedRows.Clear;
                        Break;
                      end;
           mrall : begin
                     With XDBGrid1.SelectedRows do
                     begin
                       GridBookMark:=XDBGrid1.DataSource.DataSet.GetBookmark;
                       case MessageDlg(inttostr(Count)+' sayda əməliyyat silinsinmi ?', mtConfirmation,[mbyes,mbno], 0) of
                         mryes: begin
                                for j:=0 to Count-1 do
                                begin
                                  if IndexOf(Items[j]) > -1 then
                                  begin
                                    XDBGrid1.Datasource.Dataset.Bookmark:= Items[j];
                                    S:=XDBGrid1.DataSource.DataSet.fieldbyname('id').asinteger;
                                  end;
                                  DataModuleAIF.DEL.CallProcedure('aifpaymentsdelete',[S]);
                                  XDBGrid1.DataSource.DataSet.GotoBookmark(GridBookMark);
                                end;
                                XDBGrid1.DataSource.DataSet.Refresh;
                                XDBGrid1.SelectedRows.Clear;
                                break;
                              end;
                         mrno : exit;
                       end;
                     end;
                   end;
       end;
     end;
   end;
   XDBGrid1.DataSource.DataSet.Refresh;
   XDBGrid1.SelectedRows.Clear;
end;

procedure TAIFPAYMENT.ToolButton4Click(Sender: TObject);
var id,i,j,status:integer;
    F:boolean;
begin
  if XDBGrid1.DataSource.DataSet.RecordCount=0 then exit;
  XDBGrid1.SetFocus;
  XDBGrid1.SelectedRows.CurrentRowSelected:=XDBGrid1.DataSource.DataSet.RecordCount<>0;
   for i:=0 to XDBGrid1.SelectedRows.Count-1 do
   begin
      XDBGrid1.DataSource.DataSet.GotoBookmark(pointer(XDBGrid1.SelectedRows.items[i]));
      id:=XDBGrid1.DataSource.DataSet.fieldbyname('ID').asinteger;
      case MessageDlg(format('Əməliyyat təsdiqlənsinmi #%d ?',[id]), mtConfirmation,[mbyes,mbno,mbcancel,mball], 0) of
           mryes :begin
                    status:=XDBGrid1.DataSource.DataSet.fieldbyname('status').asinteger;
                    if status=0 then
                    begin
                      F:=DataModuleAIF.DEL.CallBooleanFunction('AifPayments_Transactions',[id]);
                      if F then sboapiDataModule.SBSession.Commit
                           else begin
                                  sboapiDataModule.SBSession.Rollback;
                                  DataModuleAIF.DEL.CallProcedure('aifupdatestatus',[id]);
                                end;
                      XDBGrid1.DataSource.DataSet.Refresh;
                      if XDBGrid1.SelectedRows.Count=1 then XDBGrid1.SelectedRows.Clear;
                    end;
                  end;
           mrno  : exit;
           mrcancel : Break;
           mrall : begin
                     case MessageDlg(inttostr(XDBGrid1.SelectedRows.Count)+' sayda əməliyyat təsdiqlənsinmi ?', mtConfirmation,[mbyes,mbno], 0) of
                     mryes: begin
                              for j:=0 to XDBGrid1.SelectedRows.Count-1 do
                              begin
                                XDBGrid1.DataSource.DataSet.GotoBookmark(pointer(XDBGrid1.SelectedRows.items[j]));
                                id:=XDBGrid1.DataSource.DataSet.fieldbyname('ID').asinteger;
                                status:=XDBGrid1.DataSource.DataSet.fieldbyname('status').asinteger;
                                if status=0 then
                                begin
                                  F:=DataModuleAIF.DEL.CallBooleanFunction('AifPayments_Transactions',[id]);
                                  if F then sboapiDataModule.SBSession.Commit
                                       else begin
                                              sboapiDataModule.SBSession.Rollback;
                                              DataModuleAIF.DEL.CallProcedure('aifupdatestatus',[id]);
                                            end;
                                end;
                              end;
                              XDBGrid1.DataSource.DataSet.Refresh;
                              XDBGrid1.SelectedRows.Clear;
                              break;
                            end;
                     mrno : exit;
                     end;
                   end;
      end;

   end;
end;

