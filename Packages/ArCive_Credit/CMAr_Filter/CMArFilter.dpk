package CMArFilter;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Filter'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  sboapi50,
  CMAr_COMMON,
  CMVCL50,
  doa41dXE,
  SBTranslate;

contains
  ArMainUnitImpl in 'ArMainUnitImpl.pas' {FilterMainForm},
  ArDataModuleImpl in 'ArDataModuleImpl.pas' {ArFilterDataModule: TDataModule};

end.
