package CMAr_Conclusion;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Adding And Editing Contract'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  doa41dxe,
  sboapi50,
  CMVCL50,
  CMAr_COMMON,
  SBTranslate;

contains
  DataModuleARConclusion in 'DataModuleARConclusion.pas' {ArDataModuleConcl: TDataModule},
  ArConclusionMainUnitImpl in 'ArConclusionMainUnitImpl.pas' {ArConclusionForm},
  ArConclusionCommonDecls in 'ArConclusionCommonDecls.pas',
  CreateCMArAccountsImpl in 'CreateCMArAccountsImpl.pas' {FormCreateCMAccounts},
  ArLoanBalAccsUnit in 'ArLoanBalAccsUnit.pas' {FormLoanBalance},
  ArNewaccountimpl in 'ArNewaccountimpl.pas' {Newaccount};

end.
