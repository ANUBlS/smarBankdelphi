package CMAr_Statement;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Statement'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CMAr_COMMON,
  CMVCL50,
  doa41dXE,
  dclbde,
  SBTranslate,
  QR5RunDXE;

contains
  ArStatementDataModule in 'ArStatementDataModule.pas' {ArStatementDataMod: TDataModule},
  ArStatementMainFormImpl in 'ArStatementMainFormImpl.pas' {CrdStatementMainForm},
  ArRestsHistoryImpl in 'ArRestsHistoryImpl.pas' {RestForm},
  ArInterestshistoryImpl in 'ArInterestshistoryImpl.pas' {InterestsForm},
  ArRepUnit in 'ArRepUnit.pas' {ReportForm},
  ArReportsheduleUnit in 'ArReportsheduleUnit.pas' {ReportSheduleForm};

end.
