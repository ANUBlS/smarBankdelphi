package CMAr_Payment;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Payment '}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  CMAr_COMMON,
  sboapi50,
  CMVCL50,
  doa41dXE,
  sbtranslate;

contains
  ArPaymentMainFormImpl in 'ArPaymentMainFormImpl.pas' {PaymentForm},
  ArPaymentDataModuleImpl in 'ArPaymentDataModuleImpl.pas' {ArPaymentDataModule: TDataModule},
  ArPaymentAddFormImpl in 'ArPaymentAddFormImpl.pas' {PaymentAddForm},
  ArReplaceImpl in 'ArReplaceImpl.pas' {SheduleReplace},
  ArCust_combined in 'ArCust_combined.pas' {Form1};

end.
