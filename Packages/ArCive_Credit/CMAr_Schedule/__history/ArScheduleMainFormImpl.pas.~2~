procedure TScheduleForm.SchduleGridKeyPress(Sender: TObject;
  var Key: Char);
begin
  if ord(key) = 1 then
  with SchduleGrid,SelectedRows,DataSource.DataSet do
  begin
    DisableControls;
    try
      First;
      while not Eof do
      begin
        CurrentRowSelected := True;
        Next;
      end;
    finally
      EnableControls;
    end;
  end;
end;

