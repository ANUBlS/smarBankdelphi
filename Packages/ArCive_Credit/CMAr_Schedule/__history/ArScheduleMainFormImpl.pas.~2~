procedure TScheduleForm.ActionDeleteExecute(Sender: TObject);
resourcestring rs_DelshedulePayments = ' Silinməsinə əminsinizmi? ';
var
  count,I : Integer;
begin
   with ScheduleDataModule,adm do
  count:=CallIntegerFunction('getadmaddition',['PAYMENTSHE']);

  if count=0 then
  begin
 showmessage('Sizin dəyişmək hüququnuz yoxdur!'+#13+'Əlavə məlumat üçün sistem administratoruna müracət edin.');
 exit;
  end;
 if MessageDlg(rs_DelshedulePayments,
      mtConfirmation, [mbYes, mbNo], 0) = mrNO then  Exit;

  with SchduleGrid do
  for I := SelectedRows.Count - 1 downto 0 do
  begin
    DataSource.DataSet.GotoBookmark(Pointer(SelectedRows[I]));
    DataSource.DataSet.Delete;
  end;
end;

