unit TrSchedAddImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
   ExtCtrls, StdCtrls, ComCtrls, ImgList,
  ToolWin, CMCurrencyEdit;

type
  TfrmAddTrSched = class(TForm)
    Panel1: TPanel;
    Label1: TLabel;
    Label2: TLabel;
    trchDate: TDateTimePicker;
    ToolBar1: TToolBar;
    ToolButton1: TToolButton;
    ToolButton2: TToolButton;
    ToolButton3: TToolButton;
    ImageList1: TImageList;
    trchAmount: TCMCurrencyEdit;
    procedure ToolButton1Click(Sender: TObject);
    procedure ToolButton2Click(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmAddTrSched: TfrmAddTrSched;

implementation

uses ArCommonDecls, TrancheScheduleDataModuleImpl;

{$R *.DFM}

procedure TfrmAddTrSched.ToolButton1Click(Sender: TObject);
begin
  with TrancheSheduleDataMod, CM_SCHEDULE do begin
    CallProcedure('TrSchedule_Add', [Get_SelectedCrdID
                                   , trchDate.DateTime
                                   , trchAmount.Value]);
    Session.Commit;
    TrancheScheduleDataSet.Refresh;
  end;
  Close;
end;

procedure TfrmAddTrSched.ToolButton2Click(Sender: TObject);
begin
  Close;
end;

procedure TfrmAddTrSched.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if ord(Key)=VK_ESCAPE then begin
     Key := #0;
     Close;  
  end;
end;

end.
