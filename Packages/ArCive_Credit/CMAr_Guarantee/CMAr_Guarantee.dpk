package CMAr_Guarantee;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  CMAR_COMMON,
  sboapi50,
  CMVCL50,
  SBTranslate;

contains
  ArGuaranteImpl in 'ArGuaranteImpl.pas' {FrmGuarante},
  ArDmImpl in 'ArDmImpl.pas' {ArGurDm: TDataModule},
  ArAddGuarFormImpl in 'ArAddGuarFormImpl.pas' {AddGuarForm},
  ArAddGuarFormNImpl in 'ArAddGuarFormNImpl.pas' {AddGuarFormN};

end.
