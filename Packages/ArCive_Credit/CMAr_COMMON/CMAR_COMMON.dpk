package CMAR_COMMON;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Credits Managment Common Declarations, Functions Classes'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  Vcldb,
  CMVCL50,
  doa41dXE,
  Ehlib150,
  sboapi50,
  VCLXFiles150;

contains
  ArCommonDecls in 'ArCommonDecls.pas',
  ArLogoutputImpl in 'ArLogoutputImpl.pas' {frmLogOutput},
  ArDatasetsContol in 'ArDatasetsContol.pas',
  ArTemporaryTransactionsViewFormImpl in 'ArTemporaryTransactionsViewFormImpl.pas' {TrViewForm},
  ArCommonDataModuleImpl in 'ArCommonDataModuleImpl.pas' {ArCommonDataModule: TDataModule};

end.
