procedure TCC_CashOperation.FindBtnClick(Sender: TObject);
var
p_first : string;
p_last : string;
p_middle : string;
p_code : string;
p_cont : string;
begin


            if (FirstEdit.Text='')  and (LastEdit.Text='')
            and (MiddleEdit.Text='') and (CodeEdit.Text='')
            and (ContEdit.Text='') then
            begin
            ShowMessage('Heç bir məlumat tapılmadı!');
            exit;
              end;

             if FirstEdit.Text<>'' then
             begin
             p_first:='%';
             end else
             begin
             p_first:='';
             end;

             if LastEdit.Text<>'' then
             begin
             p_last:='%';
             end else
             begin
             p_last:='';
             end;

             if MiddleEdit.Text<>'' then
             begin
             p_middle:='%';
             end else
             begin
             p_middle:='';
             end;

              if CodeEdit.Text<>'' then
             begin
             p_code:='%';
             end else
             begin
             p_code:='';
             end;

              if ContEdit.Text<>'' then
             begin
             p_code:='%';
             end else
             begin
             p_code:='';
             end;
             DataModule1.cc_contracts.Close;
             DataModule1.cc_contracts.SQL[6]:='';
             DataModule1.cc_contracts.SQL[6]:=' and nvl(upper(code),0) like upper('+''''+p_code+CodeEdit.Text+'%'+''''+')'
                                  +' and nvl(upper(firstname),0) like upper('+''''+p_first+FirstEdit.Text+'%'+''''+')'
                                  +' and nvl(upper(lastname),0) like upper('+''''+p_last+LastEdit.Text+'%'+''''+')'
                                  +' and nvl(upper(middlename),0) like upper('+''''+p_middle+MiddleEdit.Text+'%'+''''+')'
                                  +' and nvl(upper(contnum),0) like upper('+''''+p_cont+ContEdit.Text+'%'+''''+')';

             DataModule1.cc_contracts.Open;
  //            Memo1.Lines.Clear;
  //           Memo1.Lines.Add(cc_contracts.SQL.Text);
             if DataModule1.cc_contracts.RecordCount=0 then
              begin
            ShowMessage('Heç bir məlumat tapılmadı!');
            exit;
              end;

end;

