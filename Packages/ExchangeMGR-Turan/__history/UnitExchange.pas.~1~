procedure TFormExchange.DBLC_CurrencyClick(Sender: TObject);
begin

   with DataModExch.ODSExchAcc do begin
       Edit_purchase_course.Text := FieldByName('val_purchase_course').AsString;
       Edit_nb_course.Text := FieldByName('val_nb_course').AsString;

    end;
 Edit_Exchange_Amount.Enabled:=(Edit_purchase_course.Text<>'');
 Edit_Ekv_Amount.Enabled := (Edit_purchase_course.Text<>'');
 Edit_Fee_Amount.Enabled := (Edit_purchase_course.Text<>'');


    if Edit_Exchange_Amount.Text<>'' then
      begin
        Edit_Exchange_AmountChange(Sender);
      end;

end;

procedure TFormExchange.DBLC_Curr_OtherClick(Sender: TObject);
begin

   with DataModExch.ODSExchRateOther do begin
    if Edit_purchase_course.Text<>'' then begin
       Edit_selling_course.Text    :=  FieldByName('val_selling_course').AsString;
       Edit_Relation_Course.Text :=  FormatFloat('#.##',( StrToFloat(Edit_purchase_course.Text)/StrToFloat(Edit_selling_course.Text)));
       Edit_other_nb_course.Text :=  FieldByName('val_nb_course').AsString;
      end
          else
                  DBLC_Curr_Other.KeyValue:=-1; 
  end;
    
end;

procedure TFormExchange.Edit_Exchange_AmountChange(Sender: TObject);
var
          man_ekv              ,
          man_ekv_other        ,
          val_nb_course        ,
          val_other_nb_course  ,
          purchase_course      ,
          exchange_amount      ,
          ekv_amount           ,
          selling_course       ,
          result_amount        ,
          Fee               :double;

begin

    Edit_Setting.Text:=SumNumToFull(StrToFloat(Edit_Exchange_Amount.Text))
    +
    ' '
    +
     DBLC_Currency.ListSource.DataSet.FieldByName('val_name').AsString
    +
    '-nin '
    +
    DBLC_Curr_Other.ListSource.DataSet.FieldByName('val_name').AsString
    +
    '-a '
    +
    Edit_Relation_Course.Text
    +
    ' курсла дяйшдирилмяси';

     if Edit_Exchange_Amount.Text<>'' then
      begin
         purchase_course      := StrToFloat(Edit_purchase_course.Text);
         selling_course       := StrToFloat(Edit_selling_course.Text);
         val_other_nb_course  := StrToFloat(Edit_other_nb_course.Text);
         val_nb_course        := StrToFloat(Edit_nb_course.Text);
         exchange_amount      := StrToFloat(Edit_Exchange_Amount.Text);
         man_ekv              := exchange_amount * purchase_course;
         result_amount        := man_ekv / selling_course;
         Edit_Ekv_Amount.Text := FormatFloat('#.##',result_amount);
         ekv_amount           := StrToFloat(Edit_Ekv_Amount.Text);
         man_ekv_other        := ekv_amount * selling_course;
         Fee                  := abs(man_ekv-(val_nb_course*exchange_amount))+abs(man_ekv_other-(val_other_nb_course*ekv_amount));
         Edit_Fee_Amount.Text := FormatFloat('#.##',Fee);
     end
         else
             begin
              Edit_Ekv_Amount.Text := '';
              Edit_Fee_Amount.Text := '';
             end;



end;

