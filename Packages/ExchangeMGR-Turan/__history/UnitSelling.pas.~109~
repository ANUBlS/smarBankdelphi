function TFormSelling.ExRemOstat(valid:integer):real;
var
 rest:real;
begin
  with DataModExch do
  begin
   ODSExRemainder.Close;
   ODSExRemainder.Filtered:=False;
   ODSExRemainder.Filter:='val_id='+IntToStr(valid);
   ODSExRemainder.Filtered:=True;
   ODSExRemainder.Open;
   rest:=ODSExRemainder.FieldByName('current_ostat').AsFloat;
   ExRemOstat:=rest;
   ODSExRemainder.Close;
   ODSExRemainder.Filtered:=False;
   ODSExRemainder.Filter:='';
   ODSExRemainder.Open;
  end;
end;


