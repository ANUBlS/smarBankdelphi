procedure TFormSelling.Edit_Ekv_AmountChange(Sender: TObject);
var Ekv:real;
begin
  Ekv:=StrToFloat(Edit_Ekv_Amount.Text);
  if Ekv>=500 then
  begin
  if (Ekv>=500) and (Ekv<20000) then
  begin
    Edit_Source_Type.Color:=clWhite;
    DBLC_Source_Type.Color:=clWhite;
    DBLC_Source_Type.Enabled:=True;
    Source_text.Enabled:=False;
    Source_text.Clear;
    Source_text.Color:=clGray;
  end;
  if (Ekv>=20000)  then
  begin
    Source_text.Enabled:=True;
    Source_text.Color:=clWhite;
    Edit_Source_Type.Color:=clWhite;
    DBLC_Source_Type.Enabled:=True;
    DBLC_Source_Type.Color:=clWhite;
  end;
  end
  else
    begin
      Source_text.Enabled:=False;
      Source_text.Clear;
      Source_text.Color:=clGray;
      Edit_Source_Type.Color:=clGray;
      Edit_Source_Type.Clear;
      DBLC_Source_Type.KeyValue:=-1;
      DBLC_Source_Type.Enabled:=False;
      DBLC_Source_Type.Color:=clGray;
    end;


end;

procedure TFormSelling.Edit_First_NameKeyPress(Sender: TObject; var Key: Char);
var b:integer;
begin
  b:=ord(Key);
  if not(Key in ['a'..'z','A'..'Z',' ',#8]) and
  (b<>286) and
  (b<>287) and
  (b<>350) and
  (b<>351) and
  (b<>399) and
  (b<>601) and
  (b<>220) and
  (b<>252) and
  (b<>214) and
  (b<>246) and
  (b<>199) and
  (b<>231) and
  (b<>305) and
  (b<>73)  and
  (b<>304) and
  (b<>105)
  then
    Key:=#0;


end;

