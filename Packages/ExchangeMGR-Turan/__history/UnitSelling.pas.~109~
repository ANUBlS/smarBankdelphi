    Edit_Fee_Amount.Text:=FloatToStr(Fee);}

    Ekv:=DataModExch.OPExchMgr.CallFloatFunction('RoundNew',[EkvM]);
    FeeRR:=DataModExch.OPExchMgr.CallFloatFunction('RoundNew',[FeeR]);
    FeeMM:=DataModExch.OPExchMgr.CallFloatFunction('RoundNew',[FeeM]);
    Fee:=abs(FeeRR-FeeMM);
    Edit_Ekv_Amount.Text:=FloatToStr(Ekv);
    Edit_Fee_Amount.Text:=FloatToStr(Fee);

 { Ekv:=StrToFloat(Edit_Selling_Amount.Text)*StrToFloat(Edit_selling_course.Text);
  Fee:=//ABS
           (
           RoundToEx((StrToFloat(Edit_Selling_Amount.Text)*StrToFloat(Edit_selling_course.Text)),-2)
           -
           RoundToEx((StrToFloat(Edit_Selling_Amount.Text)*StrToFloat(Edit_nb_course.Text)),-2)
           );

     // Edit_Ekv_Amount.Text:=FormatFloat('#.00',Ekv);
      //Edit_Fee_Amount.Text:=FormatFloat('#.##',Fee);
       Edit_Ekv_Amount.Text:=FloatToStr(RoundToEx(Ekv,-2));
       Edit_Fee_Amount.Text:=FloatToStr(RoundToEx(Fee,-2));  }

 end
   else
     begin
      Edit_Setting.Text:=EmptyStr;
      Edit_Ekv_Amount.Text:=EmptyStr;
      Edit_Fee_Amount.Text:=EmptyStr;
    end;


 end;

