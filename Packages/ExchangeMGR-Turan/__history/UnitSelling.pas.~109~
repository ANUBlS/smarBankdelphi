      selling_status=' KURSLA SATIŞI ';
var
      // Ekv,Fee :Extended;
      EkvM,Ekv,Fee,FeeM,FeeR,FeeMM,FeeRR :Double;
begin

if Edit_Selling_Amount.Text<>'' then
 begin

   Edit_Setting.Text:=SumNumToFull(StrToFloat(Edit_Selling_Amount.Text))
    +
    ' '
    +
     DBLC_Currency.ListSource.DataSet.FieldByName('val_name').AsString
    +
    ' -nin '
    +
    Edit_selling_course.Text
    +
    selling_status;

    EkvM:=StrToFloat(Edit_Selling_Amount.Text)*StrToFloat(Edit_selling_course.Text);
    FeeR:=StrToFloat(Edit_Selling_Amount.Text)*StrToFloat(Edit_selling_course.Text);
    FeeM:=StrToFloat(Edit_Selling_Amount.Text)*StrToFloat(Edit_nb_course.Text);
    {Ekv:=DataModExch.OPExchMgr.CallFloatFunction('FracNumberEkv',[EkvM]);
