{$R *.DFM}

procedure TDataModExch.ODSExchProvarchAfterInsert(DataSet: TDataSet);
begin
   ODSSumTrans.Refresh;
end;

procedure TDataModExch.ODSExchProvarchAfterScroll(DataSet: TDataSet);
begin
  ExchangeMGR_X.DBGridEhTrans.SelectedRows.Clear;
  ExchangeMGR_X.ToolButton1.Enabled:=not DataSet.IsEmpty;
  ExchangeMGR_X.ToolButton1.Enabled:=DataModExch.ODSExchProvarch.FieldByName('trans_close').AsInteger in [msCommit];
  ExchangeMGR_X.ToolButton27.Enabled:=not DataSet.IsEmpty;
  ExchangeMGR_X.ToolButton27.Enabled:=DataModExch.ODSExchProvarch.FieldByName('trans_close').AsInteger in [msdefault];

end;

procedure TDataModExch.ODSExchProvarchBeforeInsert(DataSet: TDataSet);
begin
   ODSSumTrans.Refresh;
end;

procedure TDataModExch.ODSExRemainderCalcFields(DataSet: TDataSet);
begin
  ODSExRemainderCURRENT_OSTAT.AsCurrency:=
  ODSExRemainderFIRST_OSTAT.AsCurrency+ODSExRemainderFTPE_OSTAT.AsCurrency-ODSExRemainderPEFR_OSTAT.AsCurrency+ODSExRemainderPURCHASE_TURN.AsCurrency-ODSExRemainderSELLING_TURN.AsCurrency;
end;

procedure TDataModExch.ODSLimitBANK_BUY_OSTATChange(Sender: TField);
var d:real;
begin
  d:=ODSLimitBANK_BUY_OSTAT.AsFloat*ODSLimitKursOSTAT.AsFloat;
  ODSLimitBANK_BUY_POK_OSTAT.AsFloat:=roundto(d,-2);
end;

procedure TDataModExch.ODSLimitBANK_SELL_OSTATChange(Sender: TField);
var d:real;
begin
  d:=ODSLimitBANK_SELL_OSTAT.AsFloat*ODSLimitKursOSTAT.AsFloat;
   ODSLimitBANK_SELL_POK_OSTAT.AsFloat:=roundto(d,-2);
end;

procedure TDataModExch.ODSLimitBUY_OSTATChange(Sender: TField);
begin
  ODSLimit.Post;
  OPExchMgr.CallProcedure('NextLimitBuy',[ODSLimitDAT.AsDateTime,ODSLimitBUY_OSTAT.AsFloat]);
  ODSLimit.Refresh;
end;

procedure TDataModExch.ODSLimitSELL_OSTATChange(Sender: TField);
begin
  ODSLimit.Post;
  OPExchMgr.CallProcedure('NextLimitSell',[ODSLimitDAT.AsDateTime,ODSLimitSELL_OSTAT.AsFloat]);
  ODSLimit.Refresh;
end;

procedure TDataModExch.ODSReestrOstatCalcFields(DataSet: TDataSet);
begin
   ODSReestrOstatV_NAME.AsString:=ODSReestrOstatVAL_NAME.AsString;
   ODSReestrOstatCURRENT_OSTAT.AsCurrency:=ODSReestrOstat.FieldByName('FIRST_OSTAT').AsCurrency+
   ODSReestrOstatFTPE_OSTAT.AsCurrency-ODSReestrOstatPEFR_OSTAT.AsCurrency+ODSReestrOstat.FieldByName('PURCHASE_TURN').AsCurrency-ODSReestrOstat.FieldByName('SELLING_TURN').AsCurrency;
end;

procedure TDataModExch.ODSReportingCalcFields(DataSet: TDataSet);
begin
  ODSReportingDeltaAmount.AsFloat:=ODSReportingPURCHASEAMOUNT.AsFloat-ODSReportingSALESAMOUNT.AsFloat;
end;

procedure TDataModExch.ODS_ExRemainCalcFields(DataSet: TDataSet);
begin
  ODS_ExRemainCURRENT_OSTAT.AsCurrency:=
  ODS_ExRemainFIRST_OSTAT.AsCurrency+ODS_ExRemainFTPE_OSTAT.AsCurrency-ODS_ExRemainPEFR_OSTAT.AsCurrency+ODS_ExRemainPURCHASE_TURN.AsCurrency-ODS_ExRemainSELLING_TURN.AsCurrency;
end;

