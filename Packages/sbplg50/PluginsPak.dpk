package PluginsPak;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart - Plugins Support Package'}
{$IMPLICITBUILD OFF}

requires
  vcl50;

contains
  PluginsPakReg in 'PluginsPakReg.pas',
  PluginIntf in 'PluginIntf.pas',
  CustomInst in 'CustomInst.pas',
  PluginSrv in 'PluginSrv.pas',
  IniSource in 'IniSource.pas';

end.
