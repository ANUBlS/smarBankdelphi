var
  Plugin: TPlugin;
  AParamsAsString: String;
  Index : Integer;
  IsAcc : Boolean;
begin
{  if Assigned(PluginManager) then
    PluginManager.InPlaceTarget := nil;}
  IsAcc:=True;
  Repaint;
  if not FClosing then
  begin
    Plugin := PluginByNode(Node);
   //---- adm
   if (Plugin is TInPlacePlugin)then
      begin
       if Assigned(OnAccessCheck) then OnAccessCheck(self,TInPlacePlugin(Plugin),IsAcc);
         {if not(IsAcc) then
          begin
            Index:=GetNodeIndex(Node);
            //PPluginNode(FPluginNodeMap[Index])^.Plugin:=PPluginNode(FPluginNodeMap[0])^.Plugin;
            TInPlacePlugin(PPluginNode(FPluginNodeMap[Index])^.Plugin).ClassId:=
            TInPlacePlugin(PPluginNode(FPluginNodeMap[0])^.Plugin).ClassId;
            PPluginNode(FPluginNodeMap[Index])^.ParamsAsString:='SplashTarget=AccessDenied';
            Plugin := PluginByNode(Node);
          end; } {Closed by H.R 10.06.2026}

         {added by H.R. 10.06.2026}
         if not(IsAcc) then begin
           Index := GetNodeIndex(Node);
           // Do NOT corrupt the plugin map — just redirect params for this call only
           PPluginNode(FPluginNodeMap[Index])^.ParamsAsString := 'SplashTarget=AccessDenied';
           Plugin := PPluginNode(FPluginNodeMap[0])^.Plugin;  // use first plugin directly
         end;
         {*** added by H.R. 10.06.2026 ***}
      end;
    //---- adm
