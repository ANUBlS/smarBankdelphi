unit PluginTreeView;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  ComCtrls,ComObj, TreeViewIni, PluginSrv, IniSource;

type
  TPluginTreeView = class;

  TPlgInPlaceActivateNotify = procedure(Sender: TPluginTreeView; Plugin: TInPlacePlugin;
    const ParamsAsString: String) of object;
   TAccessCheckEvent = procedure(Sender :TObject;Plugin :TInPlacePlugin;var IsAccessed : Boolean)
    of object;//adm

  EPluginTreeViewError = class(Exception);

  TPluginTreeView = class(TTreeViewIni)
  private
    FPluginManager: TPluginManager;
    FInPlaceTarget: TComponent;
    FPluginNodeMap: TList;
    FPluginIniSecion: String;
    FPluginImages: TImageList;
    FInPlaceActivateEvent: TPlgInPlaceActivateNotify;
    FClosing: Boolean;
    FOpenPlugin: Boolean;
    FOnAccessCheck : TAccessCheckEvent;
    procedure SetPluginIniSection(const Value: String);
    procedure SetInPlaceTarget(Value: TComponent);
  protected
    procedure SetIniSource(Value: TIniSource); override;
    procedure Change(Node: TTreeNode); override;
    procedure ReadNode(ANode: TTreeNode); override;
    procedure WriteNode(ANode: TTreeNode); override;
    procedure DoOpen; override;
    procedure DoClose; override;
    function GetActivePluginIcon(Plugin: TPlugin; Icon: TIcon): Boolean; virtual;
    function GetClosedPluginIcon(Plugin: TPlugin; Icon: TIcon): Boolean; virtual;
  public
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;
    function GetNodeIndex(ANode: TTreeNode): Integer;
    function PluginByNode(ANode: TTreeNode): TPlugin;
    function ParamsByNode(ANode: TTreeNode; out AParamsAsString: String): Boolean;
    function NodeByPlugin(APlugin: TPlugin; const ParamStr: String = ''): TTreeNode;
    procedure RefreshNode(ANode: TTreeNode); virtual;
  published
    property InPlaceTarget: TComponent read FInPlaceTarget write SetInPlaceTarget;
    property PluginManager: TPluginManager read FPluginManager write FPluginManager;
    property PluginIniSection: String read FPluginIniSecion write SetPluginIniSection;
    property OnInPlaceExecute: TPlgInPlaceActivateNotify read FInPlaceActivateEvent write FInPlaceActivateEvent;
    property OpenPlugin: Boolean read FOpenPlugin write FOpenPlugin;
    property OnAccessCheck :TAccessCheckEvent read FOnAccessCheck write FOnAccessCheck; //adm
  end;

implementation

uses SBPlgAx50_TLB;
type
  TPluginNode = record
    Plugin: TPlugin;
    ParamsAsString: ShortString;
    Node: TTreeNode;
    AliveIcon: TIcon;
  end;
  PPluginNode = ^TPluginNode;

constructor TPluginTreeView.Create(AOwner: TComponent);
begin
  FClosing := False;
  FPluginNodeMap := TList.Create;
  Images := FPluginImages;
  inherited;
  FPluginImages := TImageList.Create(Self);
  if Images = nil then
    Images := FPluginImages;
end;

destructor TPluginTreeView.Destroy;
begin
  inherited;
  FPluginNodeMap.Free;
end;

