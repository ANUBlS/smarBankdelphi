var
  Index: Integer;
begin
  for Index := 0 to Plugins.Count - 1 do
  begin
    Result := Plugins[Index];
    with Result do
      if Location = ALocation then
        exit;
  end;
  raise EPluginManagerError.CreateFmt('Plugin with location set to "%s" not found', [ALocation]);
end;

