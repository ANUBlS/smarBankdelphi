package sbplg50;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart - Plugins Support Package'}
{$IMPLICITBUILD OFF}

requires
  vcl,
  SBCommon50,
  sboapi50;

contains
  PluginSrv in 'PluginSrv.pas',
  PluginsPakReg in 'PluginsPakReg.pas',
  PluginControlBar in 'PluginControlBar.pas',
  PluginIntf in 'PluginIntf.pas',
  AxLoader in 'AxLoader.pas',
  SBPlgAx50_TLB in 'ActiveX\SBPlgAx50_TLB.pas',
  PluginTreeView in 'PluginTreeView.pas';

end.
