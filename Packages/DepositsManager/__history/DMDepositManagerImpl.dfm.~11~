        'id) as CustomerName,'
      
        '       --sbcm_stored_programs.get_customername(acc.contractaccid' +
        ') as CustomerName,'
      '       cont.opendate,'
      '       cont.closedate,'
      '       cont.amount,'
      '       cont.amount*tmp.ostat as ekamount,'
      '       intr.interest,         '
      '       cstate.facticaldebt,'
      '       cstate.facticaldebt*tmp.ostat as ekfacticaldebt,'
      '       cstate.facticalinterestdebt,'
      
        '       cstate.facticalinterestdebt*tmp.ostat as ekfacticalintere' +
        'stdebt,'
      
        '      -- sbcm_stored_programs.Get_ClientFacticalDebt(acc.clienta' +
        'ccid) as clientfacticaldebt, '
      
        '     --  sbcm_stored_programs.Get_GiftFacticalDebt(acc.giftaccid' +
        ') as giftfacticaldebt,'
      '       cstate.stopcalculationdate,'
      
        '       --SBCM_Stored_Programs.CheckContractState(cont.ID) as  St' +
        'atus,'
      '       cont.currency,'
      '       cont.personaltype,'
      '       cont.clienttype,'
      '       cont.branchid,'
      '      (select name from filial where id=cont.branchid)as Filial,'
      '       cont.contracttype,'
      
        '      (select type from sbcm_deposit_types where id=cont.contrac' +
        'ttype)as contracttypename,'
      '       cstate.calculationenabled as status,'
      
        '      (select kli_id from account where id=acc.clientaccid) as a' +
        'ccountid,'
      '       cont.customerid,'
      '       cont.sid# as usid'
      'from sbcm_contracts cont,'
      '     sbcm_contract_accounts acc,'
      '     sbcm_interests intr,'
      '     sbcm_contract_state cstate,'
      '     avalute av,'
      '     temprate tmp'
      'where acc.id# = cont.id and'
      '      intr.id# = cont.id and'
      '      cstate.id# = cont.id and'
      '      cont.currency = av.valute and'
