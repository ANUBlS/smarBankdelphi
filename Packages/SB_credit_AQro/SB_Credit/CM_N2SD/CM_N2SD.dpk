package CM_N2SD;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  doa40d5,
  CMOracleAPI,
  CMVCL50,
  DclEhlib50,
  CM_COMMON,
  Ehlib50;

contains
  DatModN2SdImpl in 'DatModN2SdImpl.pas' {DatModN2Sd: TDataModule},
  N2SdUnit in 'N2SdUnit.pas' {FormSd},
  PrUnit in 'PrUnit.pas' {FormPr};

end.
