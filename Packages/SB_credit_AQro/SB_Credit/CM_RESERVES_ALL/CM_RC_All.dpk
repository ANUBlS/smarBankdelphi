package CM_RC_All;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  sboapi50,
  CM_COMMON,
  CMVCL50,
  DclEhlib50,
  doa41dXE,
  Ehlib50;

contains
  RADatModImpl in 'RADatModImpl.pas' {RAllDatMod: TDataModule},
  RAUnit in 'RAUnit.pas' {RAForm},
  ReserveProgressFormImplpas in 'ReserveProgressFormImplpas.pas' {ProgressForm};

end.
