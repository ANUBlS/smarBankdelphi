package CM_Reserves;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Reserve Corrector'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  CMVCL50,
  CMOracleAPI,
  CM_COMMON,
  doa40d5,
  Ehlib50;

contains
  ReserveContDataModule in 'ReserveContDataModule.pas' {ReserveContDataMod: TDataModule},
  ReserveCtrlMainUnit in 'ReserveCtrlMainUnit.pas' {ReserveContMainForm},
  ReserveProgressFormImpl in 'ReserveProgressFormImpl.pas' {ProgressForm};

end.
