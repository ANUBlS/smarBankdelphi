unit ExpireAddFormImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, NLSDialogs,
  NLSLocalizer, StdCtrls, CMCurrencyEdit, Mask, DBCtrlsEh, ExtCtrls,
  DBLookupEh, ActnList, Variants;

type
  TExpireAddForm = class(TForm)
    NLSLocalizer1: TNLSLocalizer;
    GroupBox5: TGroupBox;
    Panel4: TPanel;
    StaticText2: TStaticText;
    DBEditEh3: TDBEditEh;
    Panel5: TPanel;
    StaticText3: TStaticText;
    DBEditEh4: TDBEditEh;
    Panel1: TPanel;
    GroupBox1: TGroupBox;
    Panel2: TPanel;
    StaticText1: TStaticText;
    DBEditEh1: TDBEditEh;
    Panel3: TPanel;
    StaticText4: TStaticText;
    DBEditEh2: TDBEditEh;
    ExpiredAmountEdit: TCMCurrencyEdit;
    Label1: TLabel;
    GroupBox2: TGroupBox;
    GroupBox4: TGroupBox;
    DBLookupComboboxEh2: TDBLookupComboboxEh;
    Button1: TButton;
    Button2: TButton;
    ActionList1: TActionList;
    CheckBoxUseTransactions: TCheckBox;
    ActionCommit: TAction;
    ActionClose: TAction;
    procedure ActionCommitUpdate(Sender: TObject);
    procedure ActionCloseExecute(Sender: TObject);
    procedure ActionCommitExecute(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  ExpireAddForm: TExpireAddForm;

implementation

uses
  ExpireDataModuleImpl, CommonDecls, SystemState;

{$R *.DFM}

procedure TExpireAddForm.ActionCommitUpdate(Sender: TObject);
begin
  (Sender as TAction).Enabled := (ExpiredAmountEdit.Value > 0);

  with DBLookupComboboxEh2 do
   (Sender as TAction).Enabled := (Sender as TAction).Enabled
   and ListSource.DataSet.Active
   and (not VarIsNull(KeyValue)); 
end;

procedure TExpireAddForm.ActionCloseExecute(Sender: TObject);
begin
  Close
end;

procedure TExpireAddForm.ActionCommitExecute(Sender: TObject);
resourcestring
  rsTransactionsWillProcessed = 'Кредитин эежикдирилмяси .';
var
  CreditID : Integer;
  UseTransactions : Boolean;
  ExpDate : TDateTime;
  SReserveID : Integer;
  Amount : Real;
  ConfirmCommit : Boolean;
begin
  CreditID := Get_SelectedCrdID;
  ExpDate := Integer(Trunc(Get_CurrentDate));
  UseTransactions :=  CheckBoxUseTransactions.Checked;
  Amount := ExpiredAmountEdit.Value;
  SReserveID := DBLookupComboboxEh2.KeyValue;

  with ExpireDataModule do
  begin
    CM_EXPIRE.CallProcedure('Expire_Add',[
      'p_CreditID' , CreditID ,
      'p_Date' , ExpDate ,
      'p_Amount' , Amount ,
      'p_SReserveID' , SReserveID ,
      'p_UseTransactions' , UseTransactions
    ]);

    try
      ConfirmCommit := TrDelayed_Show(Self,rsTransactionsWillProcessed);

      Self.Update;

      CM_EXPIRE.CallProcedure('CommitExpire',[
         'DoCommit' , ConfirmCommit
      ]);

     if ConfirmCommit then
       Self.ModalResult := mrOk;

     Self.Update;

    except

      CM_EXPIRE.CallProcedure('CommitExpire',[
         'DoCommit' , False
      ]);

      raise;

    end;
  end; // With


end;

procedure TExpireAddForm.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if Ord(Key) = VK_ESCAPE then
  begin
    ActionClose.Execute;
    Key := #0;
  end;
end;

procedure TExpireAddForm.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  ExpiredAmountEdit.Value := 0;
end;

end.
