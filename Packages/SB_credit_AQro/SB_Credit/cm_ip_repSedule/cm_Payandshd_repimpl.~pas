procedure TRepFrm.OracleDataSet1CalcFields(DataSet: TDataSet);
   const
number_format='0.0000';
begin
if OracleDataSet1.FieldByName('alevpredcost').asFloat =0 then
OracleDataSet1.FieldByName('kr/ev').asFloat:=0
else
OracleDataSet1.FieldByName('kr/ev').asFloat:=
StrToFloat(FormatFloat(number_format,OracleDataSet1.FieldByName('NEWFINANCEAMOUNT').asFloat/OracleDataSet1.FieldByName('alevpredcost').asfloat))   ;

if OracleDataSet1.FieldByName('predcost').asFloat =0 then
OracleDataSet1.FieldByName('kr/ip').asFloat:=0
else
OracleDataSet1.FieldByName('kr/ip').asFloat:=
StrToFloat(FormatFloat(number_format,OracleDataSet1.FieldByName('NEWFINANCEAMOUNT').asFloat/OracleDataSet1.FieldByName('predcost').asFloat))    ;


if OracleDataSet1.FieldByName('MONTHLYPROFIT').asFloat =0 then
OracleDataSet1.FieldByName('ann/gelir').asFloat:=0
else
OracleDataSet1.FieldByName('ann/gelir').asFloat:=
StrToFloat(FormatFloat(number_format,OracleDataSet1.FieldByName('ANNUTIET').asFloat/OracleDataSet1.FieldByName('MONTHLYPROFIT').asFloat))


end;

