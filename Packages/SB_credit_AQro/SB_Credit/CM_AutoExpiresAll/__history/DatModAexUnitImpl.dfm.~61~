  object DatSetExpCredits: TOracleDataSet
    SQL.Strings = (
      
        'SELECT p.ID, p.numberofcredit, p.currency, p.personaltype, p.cus' +
        'tomertype,p.creditlineamount,u.description,(select name from cm_' +
        'mehsul where id =p.mehsulid) as mehsul ,(select name from filial' +
        ' where id=p.branchid)filial,'
      
        '       p.branchid, p.credittype, b.NAME, av.val_name,b.salary,(s' +
        'elect max(paydate) from cm_payments where creditid=p.id) paydate' +
        ','
      
        '       cm_common.accountnumber_get (a.contractaccid) AS contract' +
        'accno,'
      
        '       cm_common.accountrest_get (a.booroweraccid) AS custaccres' +
        't,p.duedatelastcontract,'
      '       cm_utils.Get_PlanPrincipal (p.ID, :PDAT) AS principal,'
      
        '       cm_utils.Get_IntPlanPayment (p.ID, :PDAT) AS interest,cm_' +
        'utils.Get_creditPlanPayment(p.id) ayliqod,'
      '         cm_utils.Get_PlanPrincipal(p.ID, :PDAT)'
      '       + c.interestrest+  c.penaltyrest AS sumamt,'
      
        '        /*cm_utils.get_gecgun(p.ID, :PDAT)*/c.dueday as expdatco' +
        'unt,o.ostat,'
      '       c.penaltyrest, c.reserveid,'
      
        '       cm_utils.get_creditplanrest (p.ID, :PDAT) AS plr,(select ' +
        'name from cm_expert where id=p.expertid)expert,'
      '       p.dateofconclusion as opendate,'
      
        '       p.duedatefirstcontract as closedate,g.pledgename,g.pledge' +
        'price,'
      '       p.annualyinterestrate,p.purposeofcredit,'
      
        '       cm_common.get_AccountBalance(a.contractaccid) as BalaccNo' +
        ',c.dueday,'
      '       p.boorowerid ,b.PHONENUMBER,'
      
        'case when p.duedatefirstcontract<:PDAT and nvl(p.duedatelastcont' +
        'ract,'#39'01-jan-2002'#39')<:PDAT '
      
        'then '#39#1042#1072#1093#1090#1099' bitib '#39' else '#39' - '#39' end as creditend,c.rest,c.interes' +
        'trest,'
      'g1.guarantorname,g1.zaminwork1,g1.zamintel1,g1.zmtelmob1,'
      
        'g2.guarantorname name2,g2.zaminwork1 wr2,g2.zamintel1 evtel2,g2.' +
        'zmtelmob1 mobtel2,'
      
        'g3.guarantorname name3,g3.zaminwork1 wr3,g3.zamintel1 evtel3,g3.' +
        'zmtelmob1 mobtel3,dueinterestrest,cm_utils.Get_PlanPrincipal (p.' +
        'ID, :PDAT)+DUEINTERESTREST+PENALTYREST gecikmis_cem'
      
        ',(select text from cm_notes_report where id in(select max(id) fr' +
        'om cm_notes_report where creditid=p.id))as notes_report,st.name ' +
        'region_name'
      
        ' ,(select name from user$ where id in(select usid from cm_notes_' +
        'report where id in(select max(id) from cm_notes_report where cre' +
        'ditid=p.id))) usname'
      
        ',(select dat from cm_notes_report where id in(select max(id) fro' +
        'm cm_notes_report where creditid=p.id))as tarix'
      ' FROM cm_active_credits p,cm_guarantee g,cm_usergroups u,'
      
        '       cm_boorowerinfo b,CM_GUARANTOR g1,CM_GUARANTOR g2,CM_GUAR' +
        'ANTOR g3,'
      '       cm_accounts a,operkurs o,'
      '       cm_history c,'
      '       avalute av , cm_store st'
      '       '
      
        ' WHERE b.creditid = p.ID and p.id=g1.creditid(+) and g1.cardid(+' +
        ')=1 '
      
        '   AND a.creditid = p.ID and p.id=g2.creditid(+) and g2.cardid(+' +
        ')=2'
      
        '   And p.currency=av.valute  and p.id=g3.creditid(+) and g3.card' +
        'id(+)=3'
      '   AND c.creditid = p.ID and p.usrgroup=u.id '
      '   and c.hdate=:PDAT and  p.ID=g.creditid(+) '
      'and c.rest+c.duerest > 0'
      '-- esas and c.dueday>=1'
      
        '--and  (c.dueday>=1 and c.duerest+c.dueinterestrest+c.penaltyres' +
        't>0)/*azkredit*/'
      
        ' and cm_utils.Get_MainPlanPayment(a.creditid,:PDAT)+c.duerest>0/' +
        '*finternd*/'
      'and o.dat=:PDAT and p.currency=o.val_kod and st.type(+)=p.store'
      'ORDER BY :orderfield'
      ''
      ''
      ''
      '')
