package CM_CardPercentViewer;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  CMOracleAPI,
  CMVCL50,
  DclEhlib50,
  Ehlib50,
  CM_COMMON;

contains
  frmCardPercentImpl in 'frmCardPercentImpl.pas' {rmCardPercent},
  DMCardPercentImpl in 'DMCardPercentImpl.pas' {DMCardPercent: TDataModule},
  frmTranchRestImpl in 'frmTranchRestImpl.pas' {frmTranchRest},
  frmTranchCalcedIntImpl in 'frmTranchCalcedIntImpl.pas' {frmTranchCalcedInt},
  frmTranchPaymentImpl in 'frmTranchPaymentImpl.pas' {frmTranchPayment};

end.
