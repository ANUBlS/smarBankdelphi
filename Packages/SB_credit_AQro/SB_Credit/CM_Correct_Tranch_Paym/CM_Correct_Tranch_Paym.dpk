package CM_Correct_Tranch_Paym;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Credits Manager VCL'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  Ehlib50,
  CMVCL50,
  DclEhlib50,
  DOA,
  CMOracleAPI;

contains
  Correct_Tr_Py_Impl in 'Correct_Tr_Py_Impl.pas' {Correct_Tr_Py_DatMod: TDataModule},
  Correct_Tr_Py_Unit in 'Correct_Tr_Py_Unit.pas' {CTPMainForm};

end.
