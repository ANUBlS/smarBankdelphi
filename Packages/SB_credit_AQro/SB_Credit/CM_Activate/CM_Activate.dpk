package CM_Activate;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Activate'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  CMVCL50,
  CMOracleAPI,
  CMSYSTEM,
  CM_COMMON,
  doa41dXE;

contains
  ActvMainUnitImpl in 'ActvMainUnitImpl.pas' {MainForm},
  ActvDataModuleImpl in 'ActvDataModuleImpl.pas' {ActvDataMod: TDataModule};

end.
