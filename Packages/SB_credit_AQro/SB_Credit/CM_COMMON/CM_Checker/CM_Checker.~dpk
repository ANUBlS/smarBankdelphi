package CM_Checker;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CreditsMgr Checker'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  CMOracleAPI,
  CMVCL50,
  CM_COMMON,
  doa,
  Ehlib50;

contains
  CheckerDataModImpl in 'CheckerDataModImpl.pas' {ChkDataModule: TDataModule},
  CheckerMainForm in 'CheckerMainForm.pas' {ChkMainForm};

end.
