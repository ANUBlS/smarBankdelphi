procedure TActFrom.OracleDataSet3ApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: String);
var v_id,v_person,v_act_id :integer; v_code,v_description ,v_kodu:String;
begin

   with Sender do
   begin
      v_id := FieldByName('id').AsInteger;
      v_code :=  FieldByName('code').AsString;
      v_person := 0 {FieldByName('person').AsInteger};
      v_description := FieldByName('description').Asstring;
      v_act_id:=OracleDataSet2.FieldByName('id').AsInteger;
      v_kodu:=FieldByName('kodu').AsString;
   end;

   Applied := True;
   Case Action of
    'I':CM_SETUP.CallProcedure('CategoriesAdd',[v_person,
                                                v_code,
                                                v_description,
                                                v_act_id,v_kodu]);
    'U':CM_SETUP.CallProcedure('CategoriesEdit',[v_id,
                                                 v_person,
                                                 v_code,
                                                 v_description,
                                                 v_act_id,v_kodu]);
    'D':CM_SETUP.CallProcedure('CategoriesDelete',[v_id])
    else Applied := False;
  end;
 //LinksData.refresh;
  end;
