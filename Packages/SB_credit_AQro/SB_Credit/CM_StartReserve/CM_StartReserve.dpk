package CM_StartReserve;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Statement'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  CMVCL50,
  CMOracleAPI,
  DclEhlib50,
  Ehlib50,
  CM_COMMON;

contains
  StartReserveMainFormImpl in 'StartReserveMainFormImpl.pas' {StartReserveForm},
  StartReserveDatModImpl in 'StartReserveDatModImpl.pas' {SRDatMod: TDataModule};

end.
