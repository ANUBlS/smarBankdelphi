package CM_Statement;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Statement'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  sboapi50,
  CM_COMMON,
  CMVCL50,
  doa41dxe,
  Ehlib50,
  dclbde,
  QR5RunDXE,
  SBTranslate;

contains
  StatementDataModule in 'StatementDataModule.pas' {StatementDataMod: TDataModule},
  RestsHistoryImpl in 'RestsHistoryImpl.pas' {RestForm},
  InterestshistoryImpl in 'InterestshistoryImpl.pas' {InterestsForm},
  RepUnit in 'RepUnit.pas' {ReportForm},
  ReportsheduleUnit in 'ReportsheduleUnit.pas' {ReportSheduleForm};

end.
