package CM_BUSINESS_PLAN;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM_BUSINESS_PLAN'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  CM_COMMON,
  CMOracleAPI,
  CMVCL50,
  DOA;

contains
  BPDataModuleImpl in 'BPDataModuleImpl.pas' {BPDataModule: TDataModule},
  BPMainFormImpl in 'BPMainFormImpl.pas' {BPMainForm},
  BPLoader in 'BPLoader.pas',
  LegalMeasuresImpl in 'LegalMeasuresImpl.pas' {LMMainForm};

end.
