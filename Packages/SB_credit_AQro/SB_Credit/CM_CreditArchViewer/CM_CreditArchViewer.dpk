package CM_CreditArchViewer;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart - Plugins Support Package'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  DclEhlib50,
  CMOracleAPI,
  CMVCL50,
  CM_COMMON,
  DOA,
  Ehlib50;

contains
  CredArchDatModUnitImpl in 'CredArchDatModUnitImpl.pas' {CredArchDatMod: TDataModule},
  FrmCredArchUnitImpl in 'FrmCredArchUnitImpl.pas' {FrmCreditArch};

end.
