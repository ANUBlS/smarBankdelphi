package CM_N3SD;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Credits Manager - Auto account creator'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  CM_COMMON,
  CMOracleAPI,
  CMVCL50,
  DclEhlib50,
  doa40d5,
  Ehlib50;

contains
  UnitN3SD in 'UnitN3SD.pas' {FormN3SD},
  DatModN3SDImpl in 'DatModN3SDImpl.pas' {DatModN3SD: TDataModule},
  UnitProgress in 'UnitProgress.pas' {FormProgress},
  CtagoriesImpl in '..\CM_Balisrc\CtagoriesImpl.pas' {FrmCatagories};

end.
