procedure TPRMainForm.ActnCalculateExecute(Sender: TObject);
resourcestring
  rsConfirmForOne = '%s  - № li kredit üçün %s. Əminsiniz?';
  rsConfirmForAll = '%d - sayda kredit üçün %s. Əminsiniz?';
  rsCalcPercent   = 'Faiz hesablanacaq';
  rsAlreadyCalced = '%s - № li kredit üçün faizlər artıq hesablanıb !';
  rsProgressCaption = '                            Faizlər hesablanır. gözləyin.   .....';
var
  I : Integer;
  SelectedRowsCnt : Integer;
  CrdID : Integer;
  CrdNo : String;
  Date : TDateTime;
  EndOfMonth : Boolean;
  CrdStatus : Integer;

begin

  Date := Integer(Trunc(DTPCalcDate.DateTime));
  EndOfMonth := CBEOM.Checked;
  with CalcGrid, DataSource.DataSet do
  begin

    SelectedRowsCnt := SelectedRows.Count;

    if SelectedRowsCnt > 1 then
    begin

      if not
        ExcuseMeUser(
              Format(rsConfirmForAll,[SelectedRowsCnt,rsCalcPercent])
              ) then   Exit;

      Self.Update;

      PrepareProgress(SelectedRowsCnt,rsProgressCaption);

      for I := 0 to SelectedRowsCnt - 1 do
      begin
      
        GotoBookmark(Pointer(SelectedRows[I]));

        CrdID := FieldByName('ID').AsInteger;
        CrdNo := FieldByName('NumberOfCredit').AsString;
        CrdStatus := FieldByName('TrProcessed').AsInteger;
        if CrdStatus in [0,1] then
          begin
         //   PlaceOutBForOne(CrdID,Date,CrdNo);
            CalcIntForOne(CrdID, Date, EndOfMonth,CrdNo);
          end
        else
          LogWarning(Format(rsAlreadyCalced,[CrdNo]));

        NewProgressForm.ProgressShower.Position := I + 1;
      end;

      ProgressForm.Close; //

    end else
    begin
      CrdID := FieldByName('ID').AsInteger;
      CrdNo := FieldByName('NumberOfCredit').AsString;
      CrdStatus := FieldByName('TrProcessed').AsInteger;

      if not
         ExcuseMeUser(Format(rsConfirmForOne,[CrdNo,rsCalcPercent]))
         then         Exit;
         
      if CrdStatus in [0,1] then
      begin
        CalcIntForOne(CrdID, Date, EndOfMonth,CrdNo);
       // PlaceOutBForOne(CrdID,Date,CrdNo);
        end
      else
        LogWarning(Format(rsAlreadyCalced,[CrdNo]));
    end;
    
    SafelyRefresh(False);

  end; // WITH

end;

