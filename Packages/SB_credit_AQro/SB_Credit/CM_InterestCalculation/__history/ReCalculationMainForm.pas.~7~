  begin
    Position := 0;
    Max := ProgCnt;
    Step := 1;
    Caption := opDesc;
  end;
  ProgressForm.Show;
end;

function TPRMainForm.ExcuseMeUser(Question : String) : Boolean;
begin
  Result :=
    MessageDlg(
      Question
     ,mtConfirmation
     ,[mbYes,mbNo]
     ,0
     ) = mrYes;
end;

procedure TPRMainForm.SafelyRefresh(Safely : Boolean);
var
  SavePlace : TBookmark;
begin
  with CalcGrid, DataSource.DataSet do
  begin
    SavePlace := GetBookmark;
    Refresh;
    SelectedRows.Clear;
    if Safely then
    GotoBookmark(SavePlace);
  end;
end;

