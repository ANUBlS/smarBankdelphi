procedure TPRMainForm.ActnCalcAllintrestExecute(Sender: TObject);
resourcestring   rsProgressCaption = '                        Faizler tesdiq olunur. gözləyin.   .....';
  rsConfirmForAll = '%d -  sayda kredit üçün %s. Əminsiniz?';
  rsCalcPercent   = ' faizlər hesablanıb, təsdiq olunacaq';

var crdid,i,rowcnt :integer;
currdat :TDateTime;

begin

   i:=1;
   Currdat := integer(trunc(DTPCalcDate.datetime)){Get_CurrentDate};
   ShowMessage(DateToStr(Currdat));
   PRDataModule.IntCache.CloseAll;
   PRDataModule.IntCache.Open;
   rowcnt := PRDataModule.IntCache.RecordCount;

       if not
        ExcuseMeUser(
              Format(rsConfirmForAll,[rowcnt,rsCalcPercent])
              ) then   Exit;

   PrepareProgress(rowcnt,rsProgressCaption);
   with PRDataModule,IntCache,CalculatorPackage do
   begin
      First;
      while not EOF do
      begin
      try
        crdid := FieldByName('ID').AsInteger;
        CallProcedure('CalcPercents',['p_CreditID',
                                      crdid,
                                      'p_date',Currdat,
                                      'p_EndOfMonth',false]);
       CallProcedure ('AcceptCalcedPercents',['p_CreditID',crdid]);
        except
         on E: Exception do
         LogError(E.Message);
       end;
       Next;
       newProgressForm.ProgressShower.Position := I + 1;
       i:= i+1;
      end;
   end;
    with PRDataModule.cm_autoexp do
    try
     CallProcedure('autoexp',[Get_CurrentDate]);
     CallProcedure('autores',[Get_CurrentDate]);
     except
     on E:Exception do
     LogError(E.Message);
   end;
   
   ProgressForm.Close;
   SafelyRefresh(False);
end;

procedure TPRMainForm.N1DrawItem(Sender: TObject; ACanvas: TCanvas;
  ARect: TRect; Selected: Boolean);
  var  LineBottom: Integer;
  SText: String;
  Bar: TRect;
begin
  with ACanvas, Sender as TMenuItem do
  begin
    with Font do
    begin
      Name := 'Azl Sans Serif';
      Charset := RUSSIAN_CHARSET;
      if Default then
        Style := [fsBold];
    end;
    if Caption = '-' then
    begin
      Pen.Color := clBlack;
      LineBottom := (ARect.Top + (ARect.Bottom - ARect.Top) div 2)-1;
      MoveTo(ARect.Left, LineBottom);
      LineTo(ARect.Right, LineBottom);
      inc(LineBottom);
      Pen.Color := clWhite;
      MoveTo(ARect.Left, LineBottom);
      LineTo(ARect.Right, LineBottom);
    end
    else
    begin
      if Selected then
      begin
        Brush.Color := clNavy;
        if Enabled then
          Font.Color := clWhite
        else
          Font.Color := clSilver;
      end
      else
      begin
        Brush.Color := clBtnFace;
        if Enabled then
          Font.Color := clBlack
        else
          Font.Color := clGrayText;
      end;
      Bar := ARect;
     // Inc(Bar.Left, 22);
      FillRect(Bar);
      TextOut(ARect.Left+2, ARect.Top+1, Caption);
    end;
    SText :=ShortCutToText(ShortCut);
    TextOut(ARect.Right-TextWidth(SText)-2, ARect.Top+1, SText);
    if ImageIndex <> -1 then
      with GetParentMenu do
        if Assigned(Images) then
        begin
          if Checked then
          begin
            Bar.Left := ARect.Left + 1;
            Bar.Right := Bar.Left + 16;
            Bar.Top := ARect.Top + 1;
            Bar.Bottom := Bar.Top + 16;

            ACanvas.Brush.Color := clBtnShadow;
            ACanvas.FrameRect(Bar);

            Inc(Bar.Left, 2);
            Inc(Bar.Right, 2);
            Inc(Bar.Top, 2);
            Inc(Bar.Bottom, 2);

            ACanvas.Brush.Color := clBtnHighlight;
            ACanvas.FrameRect(Bar);

            Dec(Bar.Left, 1);
            Dec(Bar.Right, 1);
            Dec(Bar.Top, 1);
            Dec(Bar.Bottom, 1);

            if Selected then
              ACanvas.Brush.Color := clBtnFace
            else
              ACanvas.Brush.Color := clBtnHighlight;
            ACanvas.FillRect(Bar);
          end;

          Images.Draw(ACanvas, ARect.Left, ARect.Top, ImageIndex, Enabled);
        end;
        end;

end;

