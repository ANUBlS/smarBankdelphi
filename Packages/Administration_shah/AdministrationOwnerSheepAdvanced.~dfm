  object DepozitsData: TOracleDataSet
    SQL.Strings = (
      'Select'
      '    Contracts.rowid,'
      '    Contracts.ID'
      '   ,Contracts.ContractNo'
      '   ,Contracts.SID#  as OP_ID     '
      '   ,Contracts.OpenDate'
      '   ,to_char(OpenDate,'#39'DD'#39') as MonthDay'
      '   ,Contracts.CloseDate'
      '   ,Contracts.Amount'
      '   ,Contracts.ContractType'
      '   ,Contracts.PledgeType'
      '   ,Contracts.ReliabilityID'
      '   ,Contracts.OverdueReliabilityID'
      '   ,Contracts.ClientType'
      '   ,Contracts.PledgePrice'
      '   ,ContractAccs.ContractAccID'
      '   ,ContractAccs.ClientAccID'
      '   ,ContractAccs.ReserveAccID'
      '   ,ContractAccs.InterestAccID'
      '   ,ContractAccs.OverdueAccID'
      '   ,ContractAccs.OverdueInterestAccID'
      '   ,ContractAccs.OverdueReserveAccID'
      '   ,ContractState.FacticalDebt'
      '   ,ContractState.FacticalInterestDebt'
      '   ,ContractState.OverdueDebt'
      '   ,ContractState.OverdueInterestDebt'
      '   ,ContractState.StopCalculationDate'
      '   ,ContractState.CalculationEnabled'
      '   ,ContractState.ReguiredAmountDec'
      '   ,ContractState.ReguiredPercentDec'
      '   ,ContractState.LastProcessDate'
      '   ,ContractState.ResiduaryAmount'
      
        '   ,SBCM_Stored_Programs.SBCMGetAccNoFromID(ContractAccs.Contrac' +
        'tAccID) as ContractAccNo'
      
        '   ,SBCM_Stored_Programs.SBCMGetAccNoFromID(ContractAccs.Interes' +
        'tAccID) as InterestAccNo'
      
        '   ,SBCM_Stored_Programs.SBCMGetCurrencyShortName(ContractAccs.C' +
        'ontractAccID)as ContractCurrency'
      
        '   ,SBCM_Stored_Programs.SBCMGetAccName(ContractAccs.ContractAcc' +
        'ID) as ContractAccName   '
      
        '   ,SBCM_Stored_Programs.GetContractCurrency(Contracts.ID) as Co' +
        'ntractCurrencyID'
      
        '   ,SBCM_Stored_Programs.CheckContractState(Contracts.ID) as  St' +
        'atus'
      
        '   ,SBCM_Stored_Programs.GetAccountBalance(ContractAccs.Interest' +
        'AccID) as InterestBalance'
      
        '   ,SBCM_Stored_Programs.GetAccountBalance(ContractAccs.ClientAc' +
        'cID) as ClientBalance'
      'From'
      '   SBCM_Contracts Contracts'
      '  ,SBCM_Contract_Accounts ContractAccs'
      '  ,SBCM_Contract_State ContractState'
      'Where'
      '   Contracts.Type# in (3,4) And '
      '    Contracts.ID = ContractAccs.ID#'
