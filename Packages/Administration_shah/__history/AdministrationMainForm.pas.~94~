procedure TAdministrationForm.CreateTreeList(IsCreate: Boolean;Node: string;Data: TDataSet;Field,AdmField: String;ImageId: Integer);
var
TempNode,ParentNode: TTreeNode;
Bk: TBookmark;
Rec: Integer;
begin
if not(AdministrationData.UsersData.Active) then Exit;
ParentNode:=GetNode(tvMain.Items,Node);
if IsCreate then
 with Data,TempNode do
  begin
     BK:=GetBookmark;
     First;
     while not Eof do
      begin
       with tvMain do
       TempNode:=Items.AddChild(ParentNode,FieldByName(Field).AsString);
       if (AdmField<>EmptyStr)and (FieldByName('is_adm').AsInteger=1) then
        begin
         ImageIndex:=icoAdm;
         SelectedIndex:=icoAdm;
        end
       else
      if (AdmField<>EmptyStr)and (FieldByName('is_locked').AsInteger=1) then
        begin
         ImageIndex:=icoLockUser;
         SelectedIndex:=icoLockUser;
        end
        else
        begin
         ImageIndex:=ImageId;
         SelectedIndex:=ImageId;
        end;
       Next;
      end;
      if BookmarkValid(BK) then
      GotoBookmark(BK) else First;
  end
else
 begin
   ParentNode.DeleteChildren;
  with Data do
  try
   Rec:=RecNo;
   Refresh;
   if Rec>RecNo then
   Last else RecNo:=Rec;
  finally
  end;

 end;
end;

