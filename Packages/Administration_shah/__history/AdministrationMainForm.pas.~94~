procedure CheckAddusers(Sender: TComponent);
var
 i,z: integer;
begin
with AdministrationData,GroupsData do
 if (Sender is TStringGrid) then
  with (Sender as TStringGrid) do
  try
   UsersData.DisableControls;
   for i:=0 to ColCount-1 do
    for z:=0 to RowCount-1 do
      if Cells[i,z] <>EmptyStr then
       begin
         UsersData.Locate('NAME',Cells[i,z],[]);
         if i<>2 then
          if AdministrationData.pcAca.CallBooleanFunction('isadm',[UsersData.FieldByName('NAME').AsString]) then
           begin
            hbErrorBox.ShowMessage(Format('Administrator %s qrupda yalnız neytral istifadəçi ola bilər',[UsersData.FieldByName('NAME').AsString]));
            Abort;
          end;

        if not(pcADM.CallBooleanFunction('CheckForAddUseringroup',[UsersData.FieldByName('USER#').AsInteger,FieldByName('id').AsInteger,i+1]))
         then
          begin
           hbErrorBox.ShowMessage(Format('İstifadəçi %s bu qrupa daxil ola bilməz',[UsersData.FieldByName('NAME').AsString]));
           Abort;
         end;
       end;
  finally
   UsersData.EnableControls;
  end;
end;

var
BrForm: TBarForm;
i,z: Integer;
Recr :Boolean;
bk: TBookmark;

begin

Recr:=False;
BrForm:=TBarForm.Create(self);
 with AdministrationData,AdministrationData.GroupsData do
  begin
     if not(UsersData.Active) then Exit;
     CheckAddusers(slGroupGrid);
 try
   UsersData.DisableControls;
    BrForm.Execute('Group access','Group access','Process...',10,60);
    Recr:=edGroupName.Text<>FieldByName('obj').AsString;
    pcADM.CallProcedure('updategroup',[FieldByName('id').AsInteger,edGroupName.Text,edGroupDescr.Text]);
  SendM(BrForm);
    
    pcADM.CallProcedure('backupgroupman',[FieldByName('id').AsInteger]);
    pcADM.CallProcedure('cleargroupman',[FieldByName('id').AsInteger]);
  SendM(BrForm);

  with slGroupGrid do
    for i:=0 to ColCount-1 do
     begin
     for z:=0 to RowCount-1 do
      if Cells[i,z]<>EmptyStr then
       begin
        UsersData.Locate('NAME',Cells[i,z],[]);
        pcADM.CallProcedure('adduseringrup',[UsersData.FieldByName('USER#').AsInteger,i+1,FieldByName('id').AsInteger]);
       end;
      SendM(BrForm);
     end;

  SendM(BrForm);
   finally
   UsersData.EnableControls;
   pcADM.CallProcedure('refreshgroup',[FieldByName('id').AsInteger]);
   pcADM.CallProcedure('locknewusers',[FieldByName('id').AsInteger]);
   Bk:=GetBookmark;
   Refresh;
   if BookmarkValid(bk) then
    GotoBookmark(bk);
   FreeBookmark(bk);
   if Recr then RecreateTreeList;
   if Assigned(BrForm) then
    BrForm.Release;
   end;
  end;
end;

