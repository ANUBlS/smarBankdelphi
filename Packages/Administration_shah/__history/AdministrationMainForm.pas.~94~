procedure TAdministrationForm.LockUserExecute(Sender: TObject);
begin
with AdministrationData,pcADM,UsersData do
 if (Sender is TAction) then
  with (Sender as  Taction) do
   begin
    if FieldByName('Is_Adm').AsInteger = 1 then
     begin
      hbErrorBox.ShowMessage('Administrator istifadəçini ləğv etmək olmaz');
      Abort;
     end;
    Checked:=not(Checked);
    CallBooleanFunction('LockUser',[tvMain.Selected.text,Checked]);
    DBRefresh.OnExecute(UsersData);
    ChangeSelectedLockImage(Checked);
   end;
 end;

