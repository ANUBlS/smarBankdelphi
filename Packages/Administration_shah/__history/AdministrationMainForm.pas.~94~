procedure TAdministrationForm.ExecuteChange(Hand: TBarForm;Data : TDataSet;
ProcName:string;Activ :TActive );
var
Bk: TBookmark;
macc: Integer;
GrModified: Boolean;
RowModified: Boolean;
begin
with Data  do
 begin
  GrModified:=False;
  Bk:=GetBookmark;
  DisableControls;
  try
  First;
  while not(EOF) do
  begin
    with AdministrationData,AdministrationData.pcADM do
      case Activ of
       acModule:
        begin
         RowModified:=CallBooleanFunction(ProcName,[FieldByName('DESCRIPTION').AsString,tvMain.Selected.text,IntToBool(FieldByName('MODACC').AsInteger)]);
         GrModified:=GrModified or RowModified;
         macc:=FieldByName('MODACC').AsInteger;
         if RowModified then
          begin
           CallProcedure('SetAdvancedGrants',[FieldByName('DESCRIPTION').AsString,tvMain.Selected.text,macc,macc,macc]);
           CallProcedure('UserAdvacedGrantsbyModule',[IntToBool(FieldByName('MODACC').AsInteger),tvMain.Selected.text,FieldByName('id').AsInteger]);
          end;
        end;
       acTable: CallProcedure(ProcName,[FieldByName('DESCRIPTION').AsString,tvMain.Selected.text,
       FieldByName('CAN_INSERT').AsInteger,FieldByName('CAN_DELETE').AsInteger,
       FieldByName('CAN_UPDATE').AsInteger]);
      end;
   Application.ProcessMessages;
   SendMsg(Hand);
   Next;
  end;
  finally
  if GrModified then
   with AdministrationData do
   begin
   pcADM.CallProcedure('clearclassforuser',[tvMain.Selected.text]);
   Usersdata.Refresh;
   end;
  RefreshMD.Execute;
  GotoBookmark(Bk);
  EnableControls;
  with Hand do
   if Assigned(Hand) then
    begin
    Hide;
    Release;
    end;
  end;
 end;
end;

