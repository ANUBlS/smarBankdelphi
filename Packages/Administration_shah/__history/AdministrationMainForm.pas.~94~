  TempBtn:=  THeaderButton.Create(BtnParent);
  with BtnParent,TempBtn do
   begin
   with Rect do
   SetBounds(Left,Top,Right-Left,Bottom-Top);
   Flat:=True;
   Tag:=BtnTag;
   if Assigned(Picture) then
    Glyph:=Picture;
    HeadState := BtnState;
    case BtnState of
     hsDel:
     begin
      if Assigned(Methods.DelCol) then
      OnClick:=Methods.DelCol;
     end;
     hsLeft:
      begin
      if Assigned(Methods.MoveLeft) then
       OnClick:=Methods.MoveLeft;
       Enabled:=(BtnTag<>0);
      end;
     hsRight:
      begin
      if Assigned(Methods.MoveRight) then
       OnClick:=Methods.MoveRight;
       Enabled:=(BtnTag<>Head.Sections.Count-1);
      end;
     hsAdd:
      begin
      if Assigned(Methods.Add) then
       OnClick:=Methods.Add;
      end;
    end;
    Parent:=BtnParent;
   end;
 end;

 procedure CreateHeadButtons(Index: Integer;ImageList: TImageList);

  function ReturnBitmap(Index: Integer): Boolean;
   var
    Bitmap: TBitmap;
   begin
    Bitmap:=TBitmap.Create;
    with ImageList do
     try
      GetBitmap(Index,Bitmap);
      BtnBitmap.Assign(Bitmap);
      Result:=True;
     finally
      Bitmap.Free;
     end;
   end;


 begin
  with Head do
   begin
      BtnRect:=Rect(Sections[Index].Right-SpeedButtonWidth-SpeedButtonFirstInterval,2,Sections[Index].Right-SpeedButtonFirstInterval,2+SpeedButtonHeight);
      ReturnBitmap(PRightInd);
      CreateHeadButton(Head,BtnRect,Index,BtnBitmap,hsRight);
      ReturnBitmap(PLeftInd);
      BtnRect.Right:=BtnRect.Left-SpeedButtonInterval;
      BtnRect.Left:=BtnRect.right-SpeedButtonWidth;
      CreateHeadButton(Head,BtnRect,Index,BtnBitmap,hsLeft);
      ReturnBitmap(PDelInd);
      BtnRect.Right:=BtnRect.Left-SpeedButtonInterval;
      BtnRect.Left:=BtnRect.right-SpeedButtonWidth;
      CreateHeadButton(Head,BtnRect,Index,BtnBitmap,hsDel);
      ReturnBitmap(PAddInd);
      BtnRect.Right:=BtnRect.Left-SpeedButtonInterval;
      BtnRect.Left:=BtnRect.right-SpeedButtonWidth;
      CreateHeadButton(Head,BtnRect,Index,BtnBitmap,hsAdd);
   end;

 end;

var
 i: Integer;
begin
BtnBitmap:=TBitmap.Create;
 try
with Head do
  for i:=0 to Sections.Count-1 do
   CreateHeadButtons(i,BTnImageList);
 finally
   BtnBitmap.Free;
 end;
end;


procedure TAdministrationForm.hcQroupHeadSectionResize(
  HeaderControl: THeaderControl; Section: THeaderSection);
var
i,size : Integer;
begin
size:=0;
with HeaderControl do
 begin
  for i:=0 to Sections.Count-2 do
   size:=size+Sections[i].Width;

 if Width-(size+2)>2 then
  Sections[Sections.Count-1].Width:=Width-(size+2);


with slGroupGrid do
   begin
    ColWidths[Section.Index]:=Section.Width;
    ColWidths[ColCount-1]:=Sections[Sections.Count-1].Width-5;
   end;
 end;

   with HeaderControl do
    for i:=0 to ControlCount-1 do
     begin
       if (Controls[i] is THeaderButton) then
        with (Controls[i] as THeaderButton) do
           case HeadState of
           hsRight: Left:=Sections[Controls[i].Tag].Right-(SpeedButtonFirstInterval+SpeedButtonWidth);
           hsLeft:
           Left:=Sections[Controls[i].Tag].Right-
           (SpeedButtonFirstInterval+2*SpeedButtonWidth+SpeedButtonInterval);
           hsDel:
            Left:=Sections[Controls[i].Tag].Right-
            (SpeedButtonFirstInterval+3*SpeedButtonWidth+2*SpeedButtonInterval);
           hsAdd:
            Left:=Sections[Controls[i].Tag].Right-
            (SpeedButtonFirstInterval+4*SpeedButtonWidth+3*SpeedButtonInterval);
           end;
        Controls[i].Visible:=Sections[Controls[i].Tag].Width> Canvas.TextWidth(Sections[Controls[i].Tag].Text)+3*SpeedButtonWidth
    end;
end;


