    EditMask:=emptystr;
    Text:=FieldByName('Phone').AsString;
    EditMask:=M;
   end;
  edUsInfCrDat.Text:=FieldByName('CTIME').AsString;
  UserGroupData.SetVariable('UserID',UsersData.FieldByName('USER#').ASInteger);
  UserGroupData.Refresh;
 end;
end;

