 function GetUseDate : TDateTime;
begin
    if DataModXhoks.XS_CONFIG.FieldByName('USEBANKDATE').AsInteger = 1 then
       Result := Trunc(DataModXhoks.GetSysDate.CallDateFunction('GET_DATE',[]))
    else
       Result := Trunc(Date);
end;

function CheckField(all : Boolean): Boolean;
begin
       DataModXhoks.DataCheck.Close;
       DataModXhoks.DataCheck.SQL.Clear;
       DataModXhoks.DataCheck.SQL.Add('Select * from account where acc_no = '''+FormXohks.AccSearch.Text+'''');
       DataModXhoks.DataCheck.Open;
    if (Trim(FormXohks.AccSearch.Text) = '')    or
       //(Length(TransForm.AccSearch.Text)<16)    or
       (FormXohks.Edit_Client_voen.Text='')     or
