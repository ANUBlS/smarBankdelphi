procedure TFormXohks.ButtonPostClick(Sender: TObject);
 var ISfilial: integer;
        TransDate : TDate;
        Format:string;
begin
    if (checkfield(true) = false)or(Trim(FormXohks.Edit_Referens.Text)='') then
    begin
      MessageDlg('ÃˇÎÛÏ‡Ú “‡Ï ‰ÂÈËÎ',mtWarning,[mbok],0);
      exit
    end;
    if Valute_ID.Items[Combo_valute.ItemIndex] <>
        DataModXhoks.DataAccount.FieldByName('val_acc').AsString then
    begin
      MessageDlg('Bu hesab secilmish valutaya uygun deyil !',mtWarning,[mbok],0);
      exit;
    end;
    {UPDATE to change}
    trans_date:=trunc(Combo_date.DateTime);
    if Edit_BNF.Text <> '/BNF/0' then
    begin
        if Batchs_Edit then
        begin
           if (edit_referens.text = DataModXhoks.XS_BATCHS.fieldbyname('trans_ref').AsString)and
              (DataModXhoks.XS_BATCHS.fieldbyname('Status').AsInteger<>0)
           then
             begin
                MessageDlg('√ÂÈ‰ËÈÈ‡Ú π-ÒË ‰ÂÈ˚¯ËÎÏˇÎË‰Ë!',mtWarning,[mbok],0); exit;
             end;
           new_id:=DataModXhoks.XS_BATCHS.fieldbyname('id').AsInteger;
        end;

        ISfilial:=FindFilialID;
        TransDate := Trunc(GetUseDate);

        if FormPayment_Det.RB_102.Checked  then
        begin
          MainXohksForm.GridBatchs.Columns[13].Font.Color:=clblack;
          Format:='MT102';
        end;

        if FormPayment_Det.RB_102T.Checked then
        begin
          MainXohksForm.GridBatchs.Columns[13].Font.Color:=clred;
          Format:='MT102T';
        end;

        DataModXhoks.INS.CallProcedure('xs_Batchs_update',[  new_id,
                                                      'CREDIT',
                                                      DataModXhoks.DataAccount.fieldbyname('id').asinteger,//strtoint(Edit_acc_id.text),
                                                      edit_clientname.text,
                                                      edit_client_code.text,
                                                      edit_referens.text,
                                                      edit_amount.value,
                                                      strtofloat(valute_id.items[combo_valute.itemindex]),
                                                      iSfilial,
                                                      Edit_client_voen.text,
                                                      Format]);
       sboapiDataModule.SBSession.Commit;
       if Batchs_Edit then
       begin
            DataModXhoks.Ins.CallIntegerFunction('xs_Batchs_ChangeStatus',[DataModXhoks.XS_BATCHS.fieldbyname('ID').ASinteger,0]);
            DataModXhoks.XS_BATCHS.RefreshRecord;
       end
       else MainXohksForm.RefreshDataBatchs;
   end;
   close;

end;

