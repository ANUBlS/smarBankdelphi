unit FormOperationShowLmpl ;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, XFSCtrls, ComCtrls;

type
  TFormOperationShow = class(TForm)
    Edit1: TEdit;
    Edit2: TEdit;
    XFLabel1: TXFLabel;
    XFLabel2: TXFLabel;
    DateTimePicker1: TDateTimePicker;
    DateTimePicker2: TDateTimePicker;
    XFLabel3: TXFLabel;
    XFLabel4: TXFLabel;
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormOperationShow: TFormOperationShow;

implementation

uses
 UnitDataModPCustService  ;
{$R *.dfm}

procedure TFormOperationShow.FormKeyPress(Sender: TObject; var Key: Char);
begin
if ord(Key) = 27 then
    Close;
end;

procedure TFormOperationShow.FormShow(Sender: TObject);
begin
edit1.Text:=DataModPCustService.ODS_sb_business_opers.FieldByName('REFERENCE').AsString;
edit2.Text:=DataModPCustService.ODS_sb_business_opers.FieldByName('NAME').AsString;
DateTimePicker1.DateTime:=DataModPCustService.ODS_sb_business_opers.FieldByName('DAT').AsDateTime;
DateTimePicker2.DateTime:=DataModPCustService.ODS_sb_business_opers.FieldByName('TIM').AsDateTime;
end;

end.
