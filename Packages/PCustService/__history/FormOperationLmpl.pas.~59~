procedure TFormOperation.Qbz1Click(Sender: TObject);
var
  CustName, CustInn: string;
  TransactionID: string;
  WithManat, NoManat, WithCoin: string;
  ManatPosition, i: integer;
  ValuteName: string;
begin
  if not Assigned(QRptInterval) then
    QRptInterval := TQRptInterval.Create(self);
  NoManat := '';
  try
    with DataModPCustService.ODS_trancation do
    begin
      GetCustomerInfo(fieldbyname('CREDITID').asInteger, CustName, CustInn);
      DataModPCustService.ForFizFsVoen.Close;
      DataModPCustService.ForFizFsVoen.SetVariable('v_acc_no',
        fieldbyname('creditaccno').asstring);
      DataModPCustService.ForFizFsVoen.open;
      if DataModPCustService.ForFizFsVoen.fieldbyname('CUST_TYPE')
        .asInteger = 1 then
        CustInn := '';

      TransactionID := fieldbyname('ID').asstring;
      Filter := ' ID=' + TransactionID;
      Filtered := True;
    end;

    with DataModPCustService, ODSValuteName do
    begin
      Close;
      SetVariable('valute', ODS_trancation.fieldbyname
        ('debitcurrencyid').Value);
      ODSValuteName.open;
      ValuteName := AnsiLowerCase(fieldbyname('Valu_name').asstring);
    end;

    WithManat := CurrencyToHR_Azeri
      (Trunc(DataModPCustService.ODS_trancation.fieldbyname('creditamount')
      .AsFloat), 0, [0]);

    ManatPosition := POS('manat', WithManat);
    if ManatPosition > 0 then
      for i := 1 to ManatPosition - 1 do
        NoManat := NoManat + WithManat[i];

    WithCoin := FloatToStr
      (Frac(DataModPCustService.ODS_trancation.fieldbyname('creditamount')
      .AsFloat));
    if WithCoin <> '0' then
    begin
      Delete(WithCoin, 1, 2);
      if length(WithCoin) < 2 then
        WithCoin := WithCoin + '0'
      else if length(WithCoin) > 2 then
        Delete(WithCoin, 3, length(WithCoin));
      WithCoin := WithCoin + ' ' + DataModPCustService.ODSValuteName.fieldbyname
        ('valu_bala').asstring;
    end { if WithCoin<>'0' }
    else
      WithCoin := '';

    ValuteName := AnsiLowerCase(DataModPCustService.ODSValuteName.fieldbyname
      ('Valu_name').asstring + '  ' + WithCoin);

    if NoManat = EmptyStr then
      NoManat := '0 ';

    DataModPCustService.ODSBank.open;
    QRptInterval.QRAMMOUNT1.Caption := NoManat + ValuteName;
    QRptInterval.QRAMMOUNT2.Caption := NoManat + ValuteName;
    QRptInterval.QRCustInn1.Caption := CustInn;
    QRptInterval.QRCustInn2.Caption := CustInn;
    QRptInterval.QRCustInn3.Caption := CustInn;
    QRptInterval.QRDat1.Caption :=
      ExtractMonth(QRptInterval.DataSet.fieldbyname('DAT').asdatetime, '-');
    QRptInterval.QRDat2.Caption :=
      ExtractMonth(QRptInterval.DataSet.fieldbyname('DAT').asdatetime, '-');
    QRptInterval.QRDat3.Caption :=
      ExtractMonth(QRptInterval.DataSet.fieldbyname('DAT').asdatetime, '-');
    QRptInterval.Preview;
  finally
    // ActionFilterExecute(Sender);
    DataModPCustService.ODS_trancation.Locate('ID', TransactionID, []);
    DataModPCustService.ODSBank.Close;
    DataModPCustService.ODS_trancation.Filtered := False;
  end;

end;

