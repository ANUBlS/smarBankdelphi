function ErrorInCheck(Look: TEvanescence; ErrorMsg: String=''):Boolean;
 begin
  Result := True;
  if Look.GetCheckedKeyList.Count = 0 then Result := False;
  if (ErrorMsg <> '') and (not Result)then ShowMessage(ErrorMsg);
 end;

procedure TFrmDayByDayBalance.ActiveFormCreate(Sender: TObject);
var
i:integer;

  procedure FillBranches;
  var
     IDIndex : integer;
  begin
    with  Branches do
    begin
      Open;
      First;
      SetLength(BrancheIDs,RecordCount+1);
      with CBBranches.Items do
      begin
        ADD('Bütün filiallar');
        IDIndex := 0;
        BrancheIDs[IDIndex] := -1;
        while not EOF do
        begin
          INC(IDIndex);
          ADD(FieldByName('Name').AsString);
          BrancheIDs[IDIndex] := FieldByName('ID').AsInteger;
          Next;
        end;
      end;
    end;
  end;
begin
 CheckBox2.Checked:=true ;
 CheckBox3.Checked:=true ;

    for i := 0 to ComponentCount - 1 do
       if Components[i].Tag = 3112 then
     begin
      (Components[i] as TEvanescence).Open;
      (Components[i] as TEvanescence).CheckAll;
     end;
   SYSDAT.Open;
  FillBranches;
  CBBranches.ItemIndex := 0;
  DTPBegin.DateTime := SYSDAT.FieldByName('TEK_DAT').AsDateTime;
  DTPEnd  .DateTime := SYSDAT.FieldByName('TEK_DAT').AsDateTime;
  RefreshButton.Click;

  SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);
end;


