procedure TFrmDayByDayBalance.BalanceDataCalcFields(DataSet: TDataSet);
const
  UniqueValue = 1000000;
var
  d,m,y : word;
  CurrDate : TDateTime ;
begin
  with  DataSet  do
  begin
    CurrDate := FieldByName('ADate').AsDateTime;
    DecodeDate(CurrDate,y,m,d);
    FieldByName('ID').AsInteger := FieldByName('AccountNUM').AsInteger+UniqueValue*D;
  end;
end;

