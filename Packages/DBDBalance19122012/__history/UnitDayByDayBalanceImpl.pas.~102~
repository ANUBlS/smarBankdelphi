procedure TFrmDayByDayBalance.RefreshButtonClick(Sender: TObject);
var
  FirstDate , LastDate : TDateTime;
  ADDITIONALPARAMS,symbols,faiz: String;
  RestsStr,chpayStr: String;
 BalansH,SsudaH, a,FilterStr,CheckStr:String;
  i: Integer;
begin
 dbgrid1.DataSource:=datasrcbalance;
 RefreshButton.Down:=true;
//  Screen.Cursor := crSQLWait;
  FirstDate := Trunc(DTPBegin.DateTime);
  LastDate  := Trunc(DTPEnd  .DateTime);
   ////////////////////////////
  FilterStr:='' ;
  CheckStr := '';
  chpayStr := '';
  
  if (CheckStr<>'') and (FilterStr<>'') then
  FilterStr := FilterStr+' AND '+CheckStr;

  if (CheckStr<>'') and (FilterStr='') then
  FilterStr := CheckStr;


  FilterStr := FilterStr+ chpayStr;
  if FilterStr<>'' then ADDITIONALPARAMS:=' AND '+FilterStr
  else ADDITIONALPARAMS:='';

  if not ErrorInCheck(LookSimvol,rsErrorSinvol) then   Exit;
  if not ErrorInCheck(LookValute,rsErrorValute) then   Exit;

   if (LookValute.GetCheckedKeyList.Count<>LookValute.Items.Count) then
  ADDITIONALPARAMS := ADDITIONALPARAMS + ' AND ac.VAL_ACC in ('
                   +LookValute.GetCheckedKeyList.CommaText+')' ;

   if (LookSimvol.GetCheckedKeyList.Count<>LookSimvol.Items.Count) then
   begin
   symbols:=LookSimvol.GetCheckedKeyList.CommaText;
  // showmessage(symbols);
   faiz:='%'') or ac.tipacc like  (''%';
   symbols:=StringReplace(symbols,',',faiz,[rfReplaceAll]);
  // showmessage(symbols);

  ADDITIONALPARAMS := ADDITIONALPARAMS + ' and (ac.tipacc like ('
                   +'''%'
                   +symbols
                   +'%'''
                   +'))'
                   +#13#10;

  end;

  if RestsStr <> ''  then ADDITIONALPARAMS := ADDITIONALPARAMS+' and '+RestsStr ;
   // showmessage(ADDITIONALPARAMS);
  ///////////////////////////
  BalansH:= 'and (ac.bal_cn1 IN ('+ EditDebt.Text + '))';
  SsudaH:=  'and (ac.acc_no IN ('+ StrToComma(EditDebt.Text) + '))';
  //showmessage('111111111111');
    try
   if EditDebt.Text<>'' then
  case RG1.ItemIndex of
  0:
    begin
       if out_balance.Checked then
       out_NEDPackage.CallProcedure('NON_EXSIST_DATES',[FirstDate,LastDate,BrancheIDs[CBBranches.ItemIndex],null,null]) ;
           NEDPackage.CallProcedure('NON_EXSIST_DATES',[FirstDate,LastDate,BrancheIDs[CBBranches.ItemIndex],null,null,ADDITIONALPARAMS,BalansH]) ;
    end;
  1:
    begin
     // showmessage('22222222222');
    if out_balance.Checked then
     out_NEDPackage.CallProcedure('NON_EXSIST_DATES',[FirstDate,LastDate,BrancheIDs[CBBranches.ItemIndex],null,null]) ;
         NEDPackage.CallProcedure('NON_EXSIST_DATES',[FirstDate,LastDate,BrancheIDs[CBBranches.ItemIndex],null,null,ADDITIONALPARAMS,SsudaH]) ;
     end;
  end
    else
    begin
    if out_balance.Checked then
   out_NEDPackage.CallProcedure('NON_EXSIST_DATES',[FirstDate,LastDate,BrancheIDs[CBBranches.ItemIndex],null,null]) ;
       NEDPackage.CallProcedure('NON_EXSIST_DATES',[FirstDate,LastDate,BrancheIDs[CBBranches.ItemIndex],null,null,ADDITIONALPARAMS]) ;

   end;

            // showmessage(SsudaH);
   if out_balance.Checked then
   begin
    full_dbbalance.CloseAll ;
    full_dbbalance.open;
    dbgrid1.DataSource:=ds_fulldbbalance;
    end;

  with  BalanceData  do
  begin
    if Active  then  CloseAll;
    Open;
  end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

