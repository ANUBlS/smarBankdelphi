procedure TCashSymbolX.ActiveFormCreate(Sender: TObject);
begin
 CashSymbolX :=Self;
 ODSCashSymbols.Open;
 CBAssignment.ItemIndex :=0;
end;

procedure TCashSymbolX.Button1Click(Sender: TObject);
begin
 case OperationState of
   omAdd :
      with OPCashSymbols ,ODSCashSymbols do
       begin
        CallProcedure('AddCashSymbols',[{StrToInt}(ESymbol.text),EName.text,CBAssignment.ItemIndex]);
        Refresh;
       end;
   omEdit:
      with OPCashSymbols ,ODSCashSymbols do
       begin
        CallProcedure('UpdateCashSymbols',[FieldByName('Symbol').Value,{StrToInt}(ESymbol.text),EName.text,CBAssignment.ItemIndex]);
        Refresh;
       end;
 end;
 PanelAdd.Visible :=False;
end;

procedure TCashSymbolX.ODSCashSymbolsCalcFields(DataSet: TDataSet);
begin
 with DataSet do
  begin
   if FieldByName('mediocrity').value = 0 then
     FieldByName('Assignment').value :='Мядахил'
   else
    if FieldByName('mediocrity').value = 1 then
     FieldByName('Assignment').value :='Мяхариж';
  end;
end;

procedure TCashSymbolX.ActionAddExecute(Sender: TObject);
begin
 OperationState :=omAdd;
 PanelAdd.Visible :=True;
 EName.Text :='';
 ESymbol.Text :='';
 CBAssignment.ItemIndex :=0;
end;

procedure TCashSymbolX.ActionUpdateExecute(Sender: TObject);
begin
 OperationState :=omEdit;
 PanelAdd.Visible :=True;
 with ODSCashSymbols do
  begin
   ESymbol.Text :=FieldByName('Symbol').AsString;
   EName.Text :=FieldByName('Name').AsString;
   CBAssignment.ItemIndex :=FieldByName('Mediocrity').AsInteger;
  end;
end;

procedure TCashSymbolX.ActionDeleteExecute(Sender: TObject);
begin
 if MessageDlg('Do you want delete this cash symbol?',mtConfirmation,mbYesNoCancel,0)=mrYes then
   with OPCashSymbols ,ODSCashSymbols do
    begin
     CallProcedure('DeleteCashSymbols',[FieldByName('Symbol').Value]);
     Refresh;
    end;
end;

procedure TCashSymbolX.ODSCashSymbolsAfterScroll(DataSet: TDataSet);
begin
with DataSet do
 begin
  ESymbol.Text :=FieldByName('Symbol').AsString;
  EName.Text :=FieldByName('Name').AsString;
  CBAssignment.ItemIndex :=FieldByName('Mediocrity').AsInteger;
 end;
end;

