procedure TFormid_quality.XFButton1Click(Sender: TObject);
var
 id_quality:integer;
 id_qualityCust:integer;
 v_id_quality:integer;
begin
  id_quality:=CO_DataMod.ods_custID_quality.FieldByName('id').AsInteger;
  id_qualityCust:=CO_DataMod.customers.FieldByName('id').AsInteger;
  v_id_quality:=CO_DataMod.ods_custID_quality.FieldByName('id').AsInteger;
  CO_DataMod.ods_cust_ID_quality1.First;
  with CO_DataMod do
  begin

  Ods_cust_id_qualityCount.Close;
  Ods_cust_id_qualityCount.SetVariable('custid',id_qualityCust);
  Ods_cust_id_qualityCount.SetVariable('id_quality',id_quality);
  Ods_cust_id_qualityCount.Open;
  if Ods_cust_id_qualityCount.FieldByName('checked').AsInteger=0 then
  begin
  ShowMessage('Təsnifat keyfiyyətinin növünü daxil edin  !');
  exit
  end;
  end;




  CO_DataMod.SBOP.CallProcedure('upd_custid_quality',
     ['v_idquality',id_quality ]);


   CO_DataMod.SBOP.CallProcedure('update_customers',
     ['v_idcust',    id_qualityCust,
      'v_id_quality',v_id_quality ]);

   if not CO_DataMod.Customers.FieldByName('quality_id').isNull
         and (CO_DataMod.CustomersID.AsInteger=id_qualityCust)then
      begin
   FrmCustProps.id_quality_DBLookupComboboxEh.KeyValue :=  v_id_quality;

      end  ;

