procedure TCO_MEmorialForm.OpenDataControls(BeginDate, EndDate: TDateTime);

 procedure Open_(DataSet: TOracleDataSet);
 begin
  with DataSet do
  begin
   CloseAll;
   SetVariable('AccountID', AccountID);
   SetVariable('StartDate', BeginDate);
   SetVariable('EndDate', EndDate);
   Open;
  end;
 end;

begin
 with CO_Datamod.Account do
  AccountID :=FieldByName('ID').AsInteger;

 Open_(CO_Datamod.DebetTransactionsData);
 Open_(CO_Datamod.CreditTransactionsData);





end;
 procedure TCO_MemorialForm.FillAmounts(DataSet: TDataSet; AmountField, LAmountField: TField;
  AmountEdit, LAmountEdit: TCurrencyEdit);
var
  Amount: Currency;
  LAmount: Currency;
begin
  Amount := 0.0;
  LAmount := 0.0;
  with DataSet do
  begin
    DisableControls;
    try
      while not Eof do
      begin
        Amount := Amount + AmountField.Value;
        LAmount := LAmount + LAmountField.Value;
        Next;
      end;
    finally
      EnableControls;
    end;
  end;
  AmountEdit.Value := Amount;
  LAmountEdit.Value := LAmount;
end;

procedure TCO_MemorialForm.DebetTransactionsDataAfterOpen(
  DataSet: TDataSet);
begin
  FillAmounts(
    DataSet,
    CO_Datamod.DebetTransactionsDataDEBITAMOUNT,
    CO_Datamod.DebetTransactionsDataLAMOUNT,
    DebitAmountEdit,
    DebitLAmountEdit);

end;

