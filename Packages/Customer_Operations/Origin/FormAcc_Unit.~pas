begin
  DDate :=Trunc(DTPOpenDate.DateTime);
  if EditAcc.text ='' then begin
   Showmessage('ўесабын адыны дахил един!');
  end;
  if EditAcc.text <>'' then begin
   begin
   CO_DataMod.OPackage.CallIntegerFunction('open_Account',[
                                                        Editacc.text,
                                                        Editvalute.text,
                                                        Editball.text,
                                                        Editcust.text,
                                                        Ddate,
                                                        0,
                                                         0,
                                                         EditFil.text,
                                                        0,
                                                        EditAccName.text,
                                                        Buyerid.text]);
