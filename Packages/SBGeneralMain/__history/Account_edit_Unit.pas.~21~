procedure TAccount_edit.XFBitBtn1Click(Sender: TObject);
  var
  v_bal_cn2,v_symbol, v_sim_otcet:variant;
 v_old_accNo, v_accid,v_BankCode,v_acc_no, v_tip_acc, v_accName,v_limit: String;
  v_open_dat: Tdatetime;
  v_cust_id,v_id, v_val_id ,  v_fil_id ,v_bal_cn1: Integer;
  id :variant;
begin
DataAcc.SB_ACA.CallProcedure('CheckObjectAccess', ['PCUSTSERVICE','update']);
  if XFLabel21.Visible=true then
  if DBLookupComboboxEh1.Text = '' then
    begin
      ShowMessage('Hesabın tipi  seçilmeyib !');
      exit;
    end;

    if DBLookupComboboxEh2.Text = '' then
    begin
      ShowMessage('Hesabın valyutası  seçilmeyib !');
      exit;
    end;

    if DBLookupComboboxEh3.Text = '' then
    begin
      ShowMessage('Balans hesabı  seçilmeyib!');
      exit;
    end;
      if XFLabel18.Visible=true then
    begin
    if DBLookupComboboxEh4.Text = '' then
    begin
      ShowMessage('Hesabın  təyinatı  seçilmeyib !');
      exit;
    end;
    end;
    if EditAccNo.Text = '' then
    begin
      ShowMessage('Hesab nömrəsi yaradılmayıb !');
      exit;
    end;
    //ShowMessage(inttostr(v_cust_id));
    v_cust_id := strtoint(EditId.Text) ;
    //DataAcc.account_edit.FieldByName('ID').AsInteger;
  //  ShowMessage(inttostr(v_cust_id));
    v_tip_acc := Label_Symbols.Caption;
    v_accName := Edit_AccName.Text;
    v_symbol := DBLookupComboboxEh4.KeyValue;
    v_sim_otcet := DBLookupComboboxEh5.KeyValue;
    v_bal_cn1 := DBLookupComboboxEh3.KeyValue;
    v_bal_cn2 :=DBLookupComboboxEh6.KeyValue;
    v_Limit :=Edit_limit.Text;
    v_fil_id := DBLookupComboBoxBranchName.KeyValue;
    v_val_id := DBLookupComboboxEh2.KeyValue;
    v_BankCode:=Edit_BankCod.Text;
    v_old_accNo:=Edit_MuxKod.Text;
    v_accid:=accont_id;
    // ShowMessage((v_acc_no));
    v_open_dat := DTPOpenDate.DateTime;//DataAcc.Sysdat.FieldByName('Tek_dat').AsDateTime;
      id:=DataAcc.Account.FieldByName('id').AsVariant;


    v_acc_no:=EditAccNo.Text;
    v_acc_no:=StringReplace(v_acc_no,' ','',[rfReplaceAll]);
//--  ShowMessage((DateToStr(v_open_dat)));
    DataAcc.SBOP.CallProcedure('upd_account',
     [ v_accid, v_cust_id,null, v_acc_no, v_val_id, v_accName,
      v_open_dat, v_bal_cn1, v_Limit, null, v_bal_cn2,
      0, 0, v_fil_id, v_sim_otcet, v_tip_acc, v_old_accNo, 0, 0, v_symbol,null,v_BankCode]);

      Account_edit.Close;

end;

