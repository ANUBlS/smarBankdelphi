procedure TAccount_edit.Acc_nuber_avtoClick(Sender: TObject);
var
id: variant;
 edit_bal_cn2,edit_cust_id, edit_val_id, edit_fil_id, edit_bal_cn1 ,edit_sim_otcet:Variant;

begin
if XFLabel21.Visible=true then
 if DBLookupComboboxEh1.Text = '' then
  begin
    ShowMessage('Hesabın tipi  seçilmeyib !');
    exit;
  end;

  if DBLookupComboboxEh2.Text = '' then
  begin
    ShowMessage('Hesabın valyutası  seçilmeyib !');
    exit;
  end;

  if DBLookupComboboxEh3.Text = '' then
  begin
    ShowMessage('Balans hesabı  seçilmeyib!');
    exit;
  end;
 if  Pcust_Balans_hesabı.Visible=true then
 begin
   if DBLookupComboboxEh6.Text = '' then
  begin
    ShowMessage('Yeni Balans hesabı  seçilmeyib!');
    exit;
  end;
  end;

  if XFLabel18.Visible=true then
    begin
   if DBLookupComboboxEh4.Text = '' then
  begin
    ShowMessage('Hesabın  təyinatı  seçilmeyib !');
    exit;
  end;
    end;
  edit_cust_id := strtoint(editid.Text);
  edit_val_id := DBLookupComboboxEh2.KeyValue;
  edit_fil_id := DBLookupComboBoxBranchName.KeyValue;
  edit_bal_cn1 := DBLookupComboboxEh3.KeyValue;
  edit_bal_cn2:= DBLookupComboboxEh6.KeyValue;
  if  VarIsNull(DBLookupComboboxEh5.KeyValue) then
   DBLookupComboboxEh5.KeyValue:=null
  else
  edit_sim_otcet :=DBLookupComboboxEh5.KeyValue;
  notecode:=(EditNoteCode.Text);
  id:=DataAcc.Account_edit.FieldByName('id').AsVariant;
  EditAccNo.Text:=DataAcc.SBOP.CallStringFunction
 ('GenerateAccountNumber',[
                           edit_bal_cn1,
                           edit_val_id,
                           edit_cust_id,
                           edit_fil_id,
                           edit_sim_otcet,
                           notecode,
                           edit_bal_cn2
                          ]);

end;

