var
  Form1: TForm1;
  dey:Boolean;
implementation
uses
sboapiDataModuleImpl,OpenAccountImpl;
{$R *.dfm}

procedure TForm1.FormClose(Sender: TObject; var Action: TCloseAction);
begin
DBLookupComboBox1.KeyValue:=-1;
DBLookupComboBox2.KeyValue:=-1;
memo1.Clear;
end;

procedure TForm1.FormCreate(Sender: TObject);
begin

//OracleDataSet3.close;
OracleDataSet1.Open;
OracleDataSet2.Open;
end;

procedure TForm1.FormShow(Sender: TObject);
begin

with OracleDataSet4 do
begin
close;
SetVariable('v_id',strtoint(note_id));
open;
end;
XFButton1.Enabled:=false;
 XFButton2.Enabled:=True;
end;

procedure TForm1.XDBGrid1CellClick(Column: TXColumn);
begin
DBLookupComboBox1.KeyValue:=OracleDataSet4NOTETYPE.AsInteger;
DBLookupComboBox2.KeyValue:=OracleDataSet4COMMTYPE.AsInteger;
 memo1.Text:=OracleDataSet4NOTE.AsString;
 XFButton1.Enabled:=true;
 XFButton2.Enabled:=False;
end;

procedure TForm1.XFButton1Click(Sender: TObject);
begin
 if DBLookupComboBox1.KeyValue=-1 then
   begin
   showmessage('Modul növü sahəsi seçilməyib  !');
   exit
   end;
   if DBLookupComboBox2.KeyValue=-1 then
   begin
   showmessage('Əlaqə növü sahəsi seçilməyib   !');
   exit
   end;
    if trim(memo1.text)='' then
   begin
   showmessage('Qeyd sahəsi doldurulmayıb  !');
   exit
   end;
pgcust_note.CallProcedure('updat_cust_notes',[OracleDataSet4.FieldByName('id').AsInteger,
                                                   strtoint(note_id),
                                                   DBLookupComboBox1.KeyValue,
                                                   DBLookupComboBox2.KeyValue,
                                                    memo1.Text,
                                                    1
                                                  ]);


    DBLookupComboBox1.KeyValue:=-1;
    DBLookupComboBox2.KeyValue:=-1;
    memo1.Clear;
    XFButton1.Enabled:=false;
    XFButton2.Enabled:=true;
     OracleDataSet4.Refresh;


end;

procedure TForm1.XFButton2Click(Sender: TObject);
begin
//showmessage('sss');    showmessage(note_id);
   if DBLookupComboBox1.KeyValue=-1 then
   begin
   showmessage('Modul növü sahəsi seçilməyib  !');
