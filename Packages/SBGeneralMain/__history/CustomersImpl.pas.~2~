  vCustId := ODS_CUSTOMERSID.AsInteger;
  FormCustomers.Close;
end;

procedure TFormCustomers.ToolButton2Click(Sender: TObject);
begin
  vCustId := -1;
  FormCustomers.Close;
end;

procedure TFormCustomers.XFButton1Click(Sender: TObject);
var
  custid, custid2: Integer;
begin
 custid2 := ODS_CUSTOMERS.FieldByName('id').AsInteger;
custid:=DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName('id').AsInteger;
  DataModPCustService.PG_PCustService.CallProcedure('add_cust_relations',
  [custid, custid2]);
  DataModPCustService.ODS_Pozition.Refresh;
  DataModPCustService.ODS_CUSTOMERS_PHYS_FS.refresh;
  DataModPCustService.ODS_CUSTOMERS_PHYS_FS.Locate('id', custid, []) ;
  FormCustomers.Close;

end;

procedure TFormCustomers.XFButton2Click(Sender: TObject);
begin
 vCustId := -1;
  FormCustomers.Close;
end;

