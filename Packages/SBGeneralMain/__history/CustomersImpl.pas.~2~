procedure TFormCustomers.EditSearchChange(Sender: TObject);
begin
if cust_elaqe_Transaction=1 then
begin
  if Length(EditSearch.Text)<>0 then
  begin
  ODS_CUSTOMERS.Close;
  case CBSearch.ItemIndex of
  0:ODS_CUSTOMERS.SQL[3]:='and ID like '''+EditSearch.Text+'%''';
  1:ODS_CUSTOMERS.SQL[3]:='and upper(cust_name) like upper(''%'+EditSearch.Text+'%'')';
  2:ODS_CUSTOMERS.SQL[3]:='and upper('+ODS_CUSTOMERS.Fields[CBSearch.ItemIndex].FieldName+') like upper(''%'+EditSearch.Text+'%'')';
  // ShowMessage('and upper('+ODS_CUSTOMERS.Fields[CBSearch.ItemIndex].FieldName+') like upper(''%'+EditSearch.Text+'%'')'); end;
  3:ODS_CUSTOMERS.SQL[3]:='and upper('+ODS_CUSTOMERS.Fields[CBSearch.ItemIndex].FieldName+') like upper(''%'+EditSearch.Text+'%'')';
  4:ODS_CUSTOMERS.SQL[3]:='and upper('+ODS_CUSTOMERS.Fields[CBSearch.ItemIndex].FieldName+') like upper(''%'+EditSearch.Text+'%'')';
  end;
  ODS_CUSTOMERS.Open;
  end
  else
  begin
  ODS_CUSTOMERS.Close;
  ODS_CUSTOMERS.SQL[3]:='';
  ODS_CUSTOMERS.Open;
  end;
  end;
  if cust_elaqe_Transaction in[2,3,4] then
begin
  if Length(EditSearch.Text)<>0 then
  begin
  ODS_CUSTOMERS_tr.Close;
  case CBSearch.ItemIndex of
  0:ODS_CUSTOMERS_tr.SQL[3]:='and p.ID like (''%'+EditSearch.Text+'%'')';
  1:ODS_CUSTOMERS_tr.SQL[3]:='and upper(p.cust_name) like upper(''%'+EditSearch.Text+'%'')';
  2:ODS_CUSTOMERS_tr.SQL[3]:='and upper('+ODS_CUSTOMERS_tr.Fields[CBSearch.ItemIndex].FieldName+') like upper(''%'+EditSearch.Text+'%'')';
  // ShowMessage('and upper('+ODS_CUSTOMERS.Fields[CBSearch.ItemIndex].FieldName+') like upper(''%'+EditSearch.Text+'%'')'); end;
  3:ODS_CUSTOMERS_tr.SQL[3]:='and upper('+ODS_CUSTOMERS_tr.Fields[CBSearch.ItemIndex].FieldName+') like upper(''%'+EditSearch.Text+'%'')';
  4:ODS_CUSTOMERS_tr.SQL[3]:='and upper('+ODS_CUSTOMERS_tr.Fields[CBSearch.ItemIndex].FieldName+') like upper(''%'+EditSearch.Text+'%'')';
  end;
  ODS_CUSTOMERS_tr.Open;
   end
 else
  begin
  ODS_CUSTOMERS_tr.Close;
  ODS_CUSTOMERS_tr.SQL[3]:='';
  ODS_CUSTOMERS_tr.Open;
  end;
 end;
end;

