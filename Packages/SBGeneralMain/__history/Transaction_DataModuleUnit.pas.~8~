function TTransaction_DataModule.GenerateID: Longint;
begin
  with SBTransaction do
    Result := CallIntegerFunction(cs_generateid, []);
end;

function TTransaction_DataModule.AddTransaction(Transaction
  : TTransaction): Longint;
var
  ATransactionID: Variant;
  begin
  with Transaction, SBTransaction do
  begin
    if TransactionID = -1 then
      ATransactionID := -1

    else
      ATransactionID := TransactionID;
    Result := CallIntegerFunction(cs_add_transaction,
      ['TransactionDate', TransactionDate, 'DebitID', DebitID, 'CreditID',
      CreditID, 'DebitAmount', DebitAmount, 'CreditAmount', CreditAmount,
      'LAmount', LAmount, 'DebitRate', DebitRate, 'CreditRate', CreditRate,
      'TrName', TransactionName, 'Flags', Flags, 'InBalanceChar', CashSymbol,
      'OutBalanceChar', ConvertationSymbol, 'TransactionID', ATransactionID,
      'OperationType', OperationCode, 'TransactionNo', TransactionNo,
      'pReportID', Reportid, 'pCountrID', CountrID])
  end;

  OP_MMX.CallProcedure('ins_mmx_transinfo',[TransactionForm.DBLC_MMX_Transmode.Keyvalue, Result, ODS_DebtCustomerID.AsInteger,ODS_CredCustomerID.AsInteger]);

end;

