    with Transaction_DataModule, TransactionForm,Transactions do begin
    if Active then close;
     SetVariable(':trid',0);
     SetVariable(':TransactionDate',sysdat.FieldByName('tek_dat').AsDateTime);

    //Transactions.open;

    SB_ACA.CallProcedure('CheckObjectAccess', ['TransactionManager','insert']);
    open;
    Insert;

     TransactionForm.ShowModal;

     end;
     end;


   if s='TransactionEditForm' then
     begin

   trid:=custid;


   with Transaction_DataModule, TransactionForm do begin
    //Transactions.open;

   if Transaction_DataModule.Transactions.FieldByName('status').AsInteger=1
   then
   Transaction_DataModule.SB_ACA.CallProcedure('checkadvancedobjectaccess',['DELAYEDEDIT']);

   if Transaction_DataModule.Transactions.FieldByName('status').AsInteger=2
   then
   Transaction_DataModule.SB_ACA.CallProcedure('checkadvancedobjectaccess',['COMMITEDEDIT']);

   with  Transaction_DataModule, Transactions do
 begin
 if Active then close;
  SetVariable(':trid',trid);
  SetVariable(':TransactionDate',sysdat.FieldByName('tek_dat').AsDateTime);
  open;

SB_ACA.CallProcedure('CheckObjectAccess', ['TransactionManager','update']);
//showmessage(inttostr( Transaction_DataModule.Transactions.FieldByName('a1').AsInteger));
   Edit;

end;
   end;
  TransactionForm.ShowModal;
 end;

 // InitProperties;
 //GridTransactions.SelectedRows.Clear   ;


  if s='account_edit' then
  begin
  accont_id:=custid;
  Account_edit.ShowModal;

  end;

  if s='depozit_stetment' then
