   Payment_order.ShowModal;

    END;
    if s='Trancation_FormPaymentOrder' then
    begin

    odeme_trid:=custid;
    Payment_order.ShowModal;
    end;

   if s='DB_Hesab' then
     begin

    Form_Close:='DB_Hesab' ;
    phys_cust_DbHesabID:=custid;
   //  showmessage('custid'+phys_cust_DbHesabID);
        with Transaction_DataModule, TransactionForm,Transactions do begin
    if Active then close;
    // SetVariable(':trid',0);
     SetVariable(':TransactionDate',sysdat.FieldByName('tek_dat').AsDateTime);
      Transactions.open;
     SB_ACA.CallProcedure('CheckObjectAccess', ['TransactionManager','insert']);
    open;
    Insert;
     end;

