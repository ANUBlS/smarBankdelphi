  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Grids, XDBGrids, StdCtrls, XFSCtrls, ExtCtrls;

type
  TFormParametr = class(TForm)
    XFPanel1: TXFPanel;
    XFPanel2: TXFPanel;
    XFPanel3: TXFPanel;
    XFPanel4: TXFPanel;
    XFPanel5: TXFPanel;
    XFGroupBox1: TXFGroupBox;
    XFGroupBox2: TXFGroupBox;
    XDBGrid1: TXDBGrid;
    XDBGrid2: TXDBGrid;
    XDBGrid3: TXDBGrid;
    procedure XDBGrid2DblClick(Sender: TObject);
    procedure XDBGrid1DblClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormParametr: TFormParametr;

implementation

uses UnitDataModuleCourt;

{$R *.dfm}

procedure TFormParametr.XDBGrid1DblClick(Sender: TObject);
begin
  DataModuleCourt.Ins.CallProcedure('admin_add',[DataMod.ODS_Admin_Setting.FieldByName('ID').AsInteger
                                                ,DataMod.ODS_Ad_Sett_Fili.FieldByName('ID').AsInteger
                                                ,DataMod.ODS_Admin_Setting.FieldByName('NAME').AsString
                                                ,DataMod.ODS_Ad_Sett_Fili.FieldByName('NAME').AsString]);
  DataModuleCourt.ODSAdminIn.Refresh;
end;

procedure TFormParametr.XDBGrid2DblClick(Sender: TObject);
begin
  begin
   DataModuleCourt.Ins.CallProcedure('admin_del',[DataModuleCourt.ODSAdminIn.FieldByName('USERID').AsInteger
                                                 ,DataModuleCourt.ODSAdminIn.FieldByName('QRUP').AsInteger
                                                 ,DataModuleCourt.ODSAdminIn.FieldByName('USERNAME').AsString
                                                 ,DataModuleCourt.ODSAdminIn.FieldByName('QRUPNAME').AsString]);
   DataModuleCourt.ODSAdminIn.Refresh;
end;
end;

end.
