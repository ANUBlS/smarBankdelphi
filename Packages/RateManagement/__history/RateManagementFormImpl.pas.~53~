function SearchForText_AndSelect(RichEdit: TRichEdit; SearchText: string): Boolean;
var
 s, StartPos, Position, Endpos: Integer;
begin
s:=0;
  StartPos := 0;
  with RichEdit do
  begin
    Endpos := Length(RichEdit.Text);
    Lines.BeginUpdate;
    while FindText(SearchText, StartPos, Endpos, [stMatchCase])<>-1 do
    begin
      Endpos   := Length(RichEdit.Text) - startpos;
      Position := FindText(SearchText, StartPos, Endpos, [stMatchCase]);
      Inc(StartPos, Length(SearchText));
      SetFocus;
      SelStart  := Position;
      SelLength := Length(SearchText);
      s:=s+1;
    end;
    ShowMessage(inttostr(s));
    Lines.EndUpdate;
  end;
end;

procedure TRateManagementForm.CommitNewRatesExecute(Sender: TObject);
var
//  TempID: Integer;
   TrCount : Integer;
   StartTime : TTime;

begin
  if MessageDlg('Yeni valyuta məzənnələri qəbul edilsin?', mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
  begin
   StartTime:=Time;
    with SBRateManagement do
     begin
       CallProcedure('commit_new_rates', []);
       TrCount := CallIntegerFunction('calc_rate_difference', []);
       sboapiDataModule.SBSession.Commit;
     end;
    ShowMessage(Format('Əməliyyat yerinə yetirildi.'+#13#10+'Günün sənədlərinə %d əməliyyat daxil oldu'
    +#13#10+'Əməliyyat vaxtı: %s - %s = %s',[TrCount,TimeToStr(StartTime),TimeToStr(Time),FormatDateTime('nn:ss',Time-StartTime)]));
    {    with TTemporaryTransactionCommitForm.Create(Self) do
    try
      if Execute(TempID, 'Rate difference', False) then
        MessageDlg(Format('Number of commited transaction: %d', [TransactionsCount]), mtInformation, [mbOk], 0);
    finally
      Release;
    end; }

  end;
end;

