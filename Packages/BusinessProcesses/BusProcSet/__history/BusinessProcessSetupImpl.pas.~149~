procedure TBusinessProcessSetup.XDBGrid1TitleClick(Column: TXColumn);
var
  titlename: string;
  kind: string;
begin

  if not((Column.FieldName = 'NAME') or (Column.FieldName = 'ID')) then
    Exit;
  // else

  titlename := Column.FieldName;
  if Column.Field.Calculated then
    Exit;
  with DMBusProcSet.ODS_SB_BUSINESS_PROCESSES do
  begin
    Screen.Cursor := crSQLWait;
    SetVariable('sort', titlename + ' ' + kind);
    Open;
    refresh;
    Screen.Cursor := crDefault;
  end;

end;

procedure TBusinessProcessSetup.XDBGrid3CellDblClick(Column: TXColumn);
var
  a, b: String;

begin
  b := Column.FieldName;
  a := Column.FieldName;
  // c := Column.FieldName;

  if b = 'KASSA_Z_NAME' then
  begin
    a := 'KASSA_Z';
    if not assigned(konvert1) then
      konvert1 := Tkonvert1.Create(self);
    konvert1.ShowModal;
    if not(DMBusProcSet.Ods_sb_business_proc_childs.State in [dsInsert,
      dsedit]) then
      DMBusProcSet.Ods_sb_business_proc_childs.Edit;
    DMBusProcSet.Ods_sb_business_proc_childs.FieldByName(a).AsInteger :=
      konvert1.v_shortname;
    DMBusProcSet.Ods_sb_business_proc_childs.Post;
    DMBusProcSet.ODS_sb_business_proc_childs.Refresh;

  end;

  if b = 'REPORTDESC' then
  begin

    a := 'REPORTID';
    if not assigned(FrmReport) then
      FrmReport := TFrmReport.Create(self);
    FrmReport.ShowModal;
    if not(DMBusProcSet.Ods_sb_business_proc_childs.State in [dsInsert,
      dsedit]) then
      DMBusProcSet.Ods_sb_business_proc_childs.Edit;
    DMBusProcSet.Ods_sb_business_proc_childs.FieldByName(a).AsInteger :=
      FrmReport.v_id;
    DMBusProcSet.Ods_sb_business_proc_childs.Post;
    DMBusProcSet.Ods_sb_business_proc_childs.refresh;
  end;

  if b = 'KASSA_B' then
  begin
    a := 'KASSA_B';
    if not assigned(kassa1) then
      kassa1 := Tkassa1.Create(self);
    kassa1.ShowModal;
    if not(DMBusProcSet.Ods_sb_business_proc_childs.State in [dsInsert,
      dsedit]) then
      DMBusProcSet.Ods_sb_business_proc_childs.Edit;
    DMBusProcSet.Ods_sb_business_proc_childs.FieldByName(a).AsString :=
      kassa1.v_kassa;
    DMBusProcSet.Ods_sb_business_proc_childs.Post;
    DMBusProcSet.Ods_sb_business_proc_childs.refresh;
  end;

  if b = 'VID_OP_NAME' then
  begin
    a := 'VID_OP';
    if not assigned(FrmTransaction) then
      FrmTransaction := TFrmTransaction.Create(self);
    FrmTransaction.ShowModal;
    if not(DMBusProcSet.Ods_sb_business_proc_childs.State in [dsInsert,
      dsedit]) then
      DMBusProcSet.Ods_sb_business_proc_childs.Edit;
    DMBusProcSet.Ods_sb_business_proc_childs.FieldByName(a).AsInteger :=
      FrmTransaction.v_transaction;
    DMBusProcSet.Ods_sb_business_proc_childs.Post;
    DMBusProcSet.Ods_sb_business_proc_childs.refresh;
  end;
    if b = 'CNTR_NAME' then
  begin
    a := 'COUNTRID';
    if not assigned(FrmCountry) then
      FrmCountry := TFrmCountry.Create(self);
    FrmCountry.ShowModal;
    if not(DMBusProcSet.Ods_sb_business_proc_childs.State in [dsInsert,
      dsedit]) then
      DMBusProcSet.Ods_sb_business_proc_childs.Edit;
    DMBusProcSet.Ods_sb_business_proc_childs.FieldByName(a).AsInteger;
    DMBusProcSet.Ods_sb_business_proc_childs.FieldByName(a).AsInteger :=
     FrmCountry.v_countries;
    DMBusProcSet.Ods_sb_business_proc_childs.Post;
    DMBusProcSet.Ods_sb_business_proc_childs.refresh;
  end;

  if a = 'DEBTACC' then
  begin
    a := 'DEBT';
    if not assigned(Form6) then
      Form6 := TForm6.Create(self);
    Form6.v_accID := DMBusProcSet.Ods_sb_business_proc_childs.FieldByName(a)
      .AsInteger;
    Form6.ShowModal;

    if not(DMBusProcSet.Ods_sb_business_proc_childs.State in [dsInsert,
      dsedit]) then
      DMBusProcSet.Ods_sb_business_proc_childs.Edit;
    DMBusProcSet.Ods_sb_business_proc_childs.FieldByName(a).AsInteger :=
      Form6.v_accID;
    DMBusProcSet.Ods_sb_business_proc_childs.Post;
    DMBusProcSet.Ods_sb_business_proc_childs.refresh;
  end;

  if a = 'KREDACC' then
  begin
    a := 'KREDIT';
    if not assigned(Form6) then
      Form6 := TForm6.Create(self);
    Form6.v_accID := DMBusProcSet.Ods_sb_business_proc_childs.FieldByName(a)
      .AsInteger;
    Form6.ShowModal;

    if not(DMBusProcSet.Ods_sb_business_proc_childs.State in [dsInsert,
      dsedit]) then
      DMBusProcSet.Ods_sb_business_proc_childs.Edit;
    DMBusProcSet.Ods_sb_business_proc_childs.FieldByName(a).AsInteger :=
      Form6.v_accID;
    DMBusProcSet.Ods_sb_business_proc_childs.Post;
    DMBusProcSet.Ods_sb_business_proc_childs.refresh;
  end;
end;

