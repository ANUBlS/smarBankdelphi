  var
  OrdNum: Integer;
  begin
   with RepDataModule.TransactionData,SQL do
    begin
      OrdNum:=FindOrder(SQL);
     if OrdNum<>-1 then SQL[OrdNum]:='ORDER BY '+value
     else SQL.Add('ORDER BY '+value);
    end;
  end;

