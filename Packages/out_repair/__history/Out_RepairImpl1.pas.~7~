procedure TOut_RepairFrm.ReInitializeFilters(DataSet: TDataSet);
const
 orExpr=' or ';
var
 First: Boolean;
 FilterString: string;

procedure AddToFilter(Field,Value,Operation: string;Bracket: TBracket;BolType: string= ' and ');

function AddBracketToFilter(Value: TBracket): String;
begin
 if Value<>brNone then
  result:=Char(Ord(Value)+$28)
 else result:=EmptyStr;
end;

var
 DecompleteRes: string;
begin
 if First then
   begin
    DecompleteRes:=EmptyStr;
    First:=False;
   end
 else DecompleteRes:=BolType;
if Bracket=brBegin then
  FilterString:=FilterString+DecompleteRes+AddBracketToFilter(Bracket)+'('+Field+operation+value+')'
else
  FilterString:=FilterString+DecompleteRes+'('+Field+operation+value+')'+AddBracketToFilter(Bracket);
end;

procedure ExecuteCheckBoxFilter(Box :TCheckListBox;Field1,Field2: string ;Val: Boolean;Operation: string='<>');
var
  i,Cnt: Integer;
  Brackets: TBracket;
begin
with Box,Items do
 begin
 if not(Count>0) then Exit;
 if Val then Cnt:=Count-2
 else Cnt:=Count-1;
 if not(Field2 = EmptyStr) then Brackets:=brBegin
 else Brackets:=brNone;

  for i:=0 to Cnt do
    if not(Checked[i]) then
     begin
      AddToFilter(Field1,TStringList(Pointer(Box.Tag)^).Strings[i],operation,Brackets);
     if not(Field2 = EmptyStr) then
      AddToFilter(Field2,TStringList(Pointer(Box.Tag)^).Strings[i],operation,brEnd,orExpr);
     end;
  if Val and not(Checked[Count-1]) then
    AddToFilter(Field1,TStringList(Pointer(Box.Tag)^).Strings[Count-1],'=',brNone);
 end;
end;

 procedure ExecuteComboBoxFilter(Sender: TObject;DataSet: TDataSet;FieldExpression,Field,Operation: string);
 begin
  with RepDataModule do
  begin
   if DataSet.Active then
     with (Sender as TComboBox)  do
      if (ItemIndex<>-1) and (ItemIndex<>0) then
       AddToFilter(FieldExpression,DataSet.FieldByName(Field).AsString,Operation,brNone);
  end;
 end;

begin
First:=True;
with RepDataModule,DataSet do
 begin
  FilterString:=EmptyStr;
  if (scUser.ItemIndex>0)and(scUser.DataSource.DataSet.Active) then
  AddToFilter('OPERATORID',scUser.DataSource.DataSet.FieldByName('ID').AsString,'=',brNone);
  ExecuteCheckBoxFilter(clbValute,'DebitCurrencyID','CreditCurrencyID',True);
  ExecuteCheckBoxFilter(clbOperation,'OperationType',EmptyStr,False);
  ExecuteComboBoxFilter(scDebetFilial,FilialDebetData,'DebFil','ID','=');
  ExecuteComboBoxFilter(scKreditFilial,FilialCreditData,'CredFil','ID','=');
  Filter:=FilterString;
  Filtered:=True;
 end;
end;

