procedure TOut_RepairFrm.FastSearch(Sender: TObject);
var
 RecOpt :TSearchRecordOptions;
begin
 RecOpt:=[srIgnoreCase,srPartialMatch];
 if (Sender is TEdit) then
  with (Sender as TEdit),RepDataModule.TransactionData do
    if Active then
      begin
        case FOrder of
         soForward: Include(RecOpt,srForward);
         soBackward: Include(RecOpt,srBackward);
         soNone: Include(RecOpt,srFromBeginning);
        end;
         SearchRecord(Hint,Text,RecOpt);
      end;
end;
