procedure TOut_RepairFrm.CreateSearchPanel;
var
i,edLeft: Integer;
TempEdit: TEdit;
begin
 with out_dbMain do
  begin
    edLeft:=4;
   for i:=0 to Columns.Count-1 do
    with TempEdit do
     begin
      TempEdit:=TEdit.Create(pnSearch);
      Hint:=Columns[i].Field.FieldName;
      if pnSearch.FindComponent('ed_'+Hint)=nil then Name:='ed_'+Hint;
      Text:=EmptyStr;
      OnChange:=FastSearch;
      OnKeyPress:=KeyFastSearch;
      OnKeyDown:=KeyFastUpDownSearch;
      SetBounds(edLeft,4,Columns[i].Width,10);
      Parent:=pnSearch;
      Ctl3D:=False;
      Color:=clSilver;
      Font.Color:=clNavy;
      edLeft:=edLeft+Columns[i].Width+1;
     end;
  end;
 pnSearchOrder.BringToFront;
end;

procedure TOut_RepairFrm.ShowSearchPanelExecute(Sender: TObject);
begin
with (Sender as TAction) do
 begin
   Checked:=not(Checked);
   pnSearch.Visible:=Checked;
   tbSearch.Down:=Checked;
  if Checked then CreateSearchPanel
  else ClearSearhPanel;
 end;
