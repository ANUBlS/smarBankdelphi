end;


procedure TOut_RepairFrm.FilterShowAction(Value: TFilterType);

function EnableData(Sender: TDataset): Boolean;
begin
 if (Sender is TDataSet) then
  begin
  with (Sender as TDataSet) do
   if not(Active) then
     Open else Refresh;
    EnableData:=True;
  end
 else EnableData:=False;
end;

begin
with RepDataModule do
begin
 if (Value=ftMain) or (Value=ftAll) then
   begin
    if Value=ftAll then
     begin
      clbValute.Clear;
      TStringList(Pointer(clbValute.Tag)^).Clear;
      clbOperation.Clear;
      TStringList(Pointer(clbOperation.Tag)^).Clear;
     end;
    scUser.DataSource:=Users;
    EnableData(UsersData);
    if not(clbValute.Items.Count>1) then Valutes.Execute;
    if not(clbOperation.Items.Count>1) then VidOp.Execute;
   end;

 if (Value=ftFilial) or (Value=ftAll) then
   begin
  if not(FilialDebetData.Active)or (Value=ftAll) then
   if EnableData(FilialDebetData) then
    begin
      scDebetFilial.DataSource:=FilialDebet;
      scDebetFilial.Refresh;
    end;
  if not(FilialCreditData.Active)or(Value=ftAll) then
   if  EnableData(FilialCreditData) then
     begin
      scKreditFilial.DataSource:=FilialCredit;
      scKreditFilial.Refresh;
     end;
   end;
end;
end;
