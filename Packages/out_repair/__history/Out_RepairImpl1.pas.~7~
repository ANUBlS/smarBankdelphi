procedure TOut_RepairFrm.Out_pnGridlayerResize(Sender: TObject);

 function ColumnsWidth: Integer;
  var
   i: Integer;
  begin
    Result:=0;
    with Out_dbMain do
     for i:=0 to Columns.Count-1 do
      Result:=Result+Columns[i].Width;
  end;


begin
with Out_dbMain do
 begin
   if Tag=0 then
      begin
       Tag:=(Sender as TPanel).Width;
       Out_pnGridlayer.Tag:=Columns[Columns.Count-1].Width;
       TempWidth:=(Sender as TPanel).Width;
     end;

    if (Columns[Columns.Count-1].Width+((Sender as TPanel).Width-Tag)>Out_pnGridlayer.Tag)
    and ((Sender as TPanel).Width > TempWidth+4) then
     begin
      Columns[Columns.Count-1].Width:=Columns[Columns.Count-1].Width+((Sender as TPanel).Width-Tag);
      Tag:=(Sender as TPanel).Width;
     end
    else
     begin
      Columns[Columns.Count-1].Width:=Out_pnGridlayer.Tag;
      Tag:=(Sender as TPanel).Width;
     end;
 end;

end;
function FindOrder(List: TStrings;Value: string=csOrder): integer;
var
 I :integer;
begin
FindOrder:=-1;
with List do
 for i:=0 to Count-1 do
  if Pos(UpperCase(Value),UPperCase(Strings[i]))<>0 then
   begin
   FindOrder:=i;
   Break;
   end
  else FindOrder:=-1;
end;

