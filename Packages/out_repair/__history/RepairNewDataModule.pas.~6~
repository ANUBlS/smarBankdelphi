function TRepDataModule.SaveTransaction(Value: TTransaction): Boolean;
var
 TempAct: Integer;
begin
with Value do
begin
 case Action of
  acDelete: TempAct:=0;
  acInsert: TempAct:=1;
  acUpdate: TempAct:=2;
 else
  TempAct:=-1;
 end;

 Result:=pcCorrect.CallIntegerFunction('Main', [
   'Flag',TempAct
  ,'CorMode',Mode
  ,'TransactionID'   ,ID
  ,'TransactionDate' ,Date
  ,'DebitID'         ,DebitId
  ,'CreditID'        ,CreditId
  ,'DebitAmount'     ,DebitAmmount
  ,'CreditAmount'    ,CreditAmmount
  ,'LAmount'         ,LAmmount
  ,'DebitRate'       ,DebitRate
  ,'CreditRate'      ,CreditRate
  ,'TrName'          ,Name
  ,'InBalanceChar'   ,InBalanceChar
  ,'OutBalanceChar'  ,OutBalanceChar
 ]);

 end;

end;

