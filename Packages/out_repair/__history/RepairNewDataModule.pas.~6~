function DisableProperty(Sender: TComponent;Propertyname: String): Boolean;
var
 PropInfo: PPropInfo;
begin
 PropInfo := GetPropInfo(Sender.ClassInfo, Propertyname);
 if PropInfo <> nil then
    SetPropValue(sender,'Enabled',False);
 Result:=PropInfo <> nil;
end;

