function TRepDataModule.CheckTransaction(Value: TTransaction): boolean;

procedure ShowError(value: string);
begin
 raise EHint.Create(value);
end;

resourcestring
 erConvert='Конвертасиййа тяйинаты дахил олунмайыб. Редактяни давам етмяйя разысынызмы?'#13#10'''Имтина'' дцймясини басандан сонра ямалиййат эцнцн сярядляриня ялавя олунажаг. ';
 erDebt= 'Дебет щесабынын валйутасы дцзэцн дахил един ';
 erCred='Кредит щесабынын валйутасы дцзэцн дахил един ';
 erKassa='Касса символу дцзэцн дахил един ';
 erDescr='Ямалиййатын тяйиннаты дахил един ';
begin
 Result:=False;
 with Value do
 begin
  if DebitCurId<>DebetAccData.FieldByName('VAL_ACC').AsInteger then ShowError(erDebt);
  if CreditCurId<>CreditAccData.FieldByName('VAL_ACC').AsInteger then ShowError(erCred);
  if Name=EmptyStr then ShowError(erDescr);
  if not(OutRepairEdit.CheckInBalance) and (InBalanceChar=null) then ShowError(erKassa);

  if not((DebitCurId<>CreditCurId)
     and (not (RepDataModule.DebetAccData.FieldByName('IsCacheAccount').AsInteger in [1,2]))
     and (not (RepDataModule.CreditAccData.FieldByName('IsCacheAccount').AsInteger in [1,2]))
     and (OutBalanceChar=0))
     then
       Result := True
     else
       if MessageDlg(erConvert,mtConfirmation,[mbYes, mbCancel],0)=mrYes then
          Exit
      else Result := True;
 end;
end;

