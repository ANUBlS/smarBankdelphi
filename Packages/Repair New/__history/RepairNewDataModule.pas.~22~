function DisableProperty(Sender: TComponent;Propertyname: String): Boolean;
var
 PropInfo: PPropInfo;
begin
 PropInfo := GetPropInfo(Sender.ClassInfo, Propertyname);
 if PropInfo <> nil then
    SetPropValue(sender,'Enabled',False);
 Result:=PropInfo <> nil;
end;

procedure CheckDates;
begin
if Assigned(RepairNewMain) then
with RepairNewMain do
if dtpOpDat.DateTime>dtOpDatEnd.DateTime  then
 begin
  MessageDlg('Ямялиййат тарихини дцзэцн дахил един',mtError,[mbOk],0);
  Abort;
 end;
end;


procedure TRapNewDataModule.FullRefresh;

procedure DisableAllControls;

procedure DisableContr(Value: TComponent);
 var
 I : Integer;
 begin
  if Assigned(Value) then
     with Value do
       For i:=0 to ComponentCount-1 do
        DisableProperty(Components[i],'Enabled');
 end;

begin
 DisableContr(self);
 DisableContr(RepairNewMain);
 DisableContr(RepairEdit);
end;

procedure OpenData(Value: TDataSet);
begin
 with Value do
  if not(Active) then Open else Refresh;
end;

begin

try
 CheckDates;
 TransactionData.SetVariable('DAT',RepairNewMain.dtpOpDat.DateTime);
 TransactionData.SetVariable('DAT2',RepairNewMain.dtOpDatEnd.DateTime);
 //TransactionData.Open;  {closed by H.R. 06.02.2019}

 with CreditRateData do
  begin
   SetVariable('DAT',RepairNewMain.dtpOpDat.DateTime);
   OpenData(CreditRateData);
  end;
 with DebetRateData do
  begin
   SetVariable('DAT',RepairNewMain.dtpOpDat.DateTime);
   OpenData(DebetRateData);
  end;
 OpenData(CurDebetData);
 OpenData(CurKreditData);
 //OpenData(DebetAccData);  {closed by H.R. 30.01.2018}
 //OpenData(CreditAccData);  {closed by H.R. 30.01.2018}
 OpenData(OutBalanceCharData);
 OpenData(InBalanceCharData);
 if UsersData.Active then
  begin
   RepairNewMain.FilterShowAction(ftAll);
   RepairNewMain.Filter.Execute;
  end;
except
 on E: EAbort do
  Beep;
 else
  begin
   DisableAllControls;
   raise;
  end;
end;
end;

procedure TRapNewDataModule.CurDebetDataAfterScroll(DataSet: TDataSet);
begin
if Assigned(RepairEdit) then
with RepairEdit,DataSet do
  begin
   DebetRateData.Locate('id',FieldByName('VALUTE').AsInteger,[loCaseInsensitive,loPartialKey]);
   if dblcCurDebet.KeyValue<>FieldByName('VALUTE').AsInteger then
     dblcCurDebet.KeyValue:=FieldByName('VALUTE').AsInteger;
  end;
end;

procedure TRapNewDataModule.CurKreditDataAfterScroll(DataSet: TDataSet);
