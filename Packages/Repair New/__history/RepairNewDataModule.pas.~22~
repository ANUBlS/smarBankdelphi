procedure TRapNewDataModule.TransactionDataApplyRecord(
  Sender: TOracleDataSet; Action: Char; var Applied: Boolean;
  var NewRowId: String);
begin
  case Action of
  'I':
    begin
      Applied := True;
    end;
  'U':
    begin
      Applied := True;
    end;
  'L','R','C':
      Applied := True;
  else
    Applied := False;
  end;
end;



procedure TRapNewDataModule.DebetAccDataAfterScroll(DataSet: TDataSet);
begin
 if Assigned(RepairEdit) then
  with RepairEdit,DataSet do
   if (edDebitAccNo.Focused)then
