  end;
end;

procedure TRapNewDataModule.InBalanceCharDataAfterScroll(
  DataSet: TDataSet);
begin
  if Assigned(RepairEdit) then
   with RepairEdit,Dataset do
    if not(dlbcBalance.Focused) then
     if dlbcBalance.Text {KeyValue}<>FieldByName('SYMBOL').AsString then //AsInteger then
      dlbcBalance.KeyValue:=FieldByName('SYMBOL').AsString;  //AsInteger;
end;

function TRapNewDataModule.CheckTransaction(Value: TTransaction): boolean;

procedure ShowError(value: string);
begin
 raise EHint.Create(value);
end;

resourcestring
 erConvert='Конвертасиййа тяйинаты дахил олунмайыб. Редактяни давам етмяйя разысынызмы?'#13#10'''Имтина'' дцймясини басандан сонра ямалиййат эцнцн сярядляриня ялавя олунажаг. ';
 erDebt= 'Дебет щесабынын валйутасы дцзэцн дахил един ';
 erCred='Кредит щесабынын валйутасы дцзэцн дахил един ';
 erKassa='Касса символу дцзэцн дахил един ';
 erDescr='Ямалиййатын тяйиннаты дахил един ';
begin
 Result:=False;
 with Value do
 begin
  if DebitCurId<>DebetAccData.FieldByName('VAL_ACC').AsInteger then ShowError(erDebt);
  if CreditCurId<>CreditAccData.FieldByName('VAL_ACC').AsInteger then ShowError(erCred);
  if Name=EmptyStr then ShowError(erDescr);
  if not(RepairEdit.CheckInBalance) and (InBalanceChar=null) then ShowError(erKassa);

  if not((DebitCurId<>CreditCurId)
     and (not (RapNewDataModule.DebetAccData.FieldByName('IsCacheAccount').AsInteger in [1,2]))
     and (not (RapNewDataModule.CreditAccData.FieldByName('IsCacheAccount').AsInteger in [1,2]))
     and (OutBalanceChar=0))
     then
       Result := True
     else
       if MessageDlg(erConvert,mtConfirmation,[mbYes, mbCancel],0)=mrYes then
          Exit
      else Result := True;
 end;
end;

function TRapNewDataModule.SaveTransaction(Value: TTransaction): Boolean;
var
 TempAct: Integer;
begin
with Value do
begin
 case Action of
  acDelete: TempAct:=0;
  acInsert: TempAct:=1;
  acUpdate: TempAct:=2;
 else
  TempAct:=-1;
 end;

 Result:=pcCorrect.CallIntegerFunction('Main', [
   'Flag',TempAct
  ,'CorMode',Mode
  ,'TransactionID'   ,ID
  ,'TransactionDate' ,Date
  ,'DebitID'         ,DebitId
  ,'CreditID'        ,CreditId
  ,'DebitAmount'     ,DebitAmmount
  ,'CreditAmount'    ,CreditAmmount
  ,'LAmount'         ,LAmmount
  ,'DebitRate'       ,DebitRate
  ,'CreditRate'      ,CreditRate
  ,'TrName'          ,Name
  ,'InBalanceChar'   ,InBalanceChar
  ,'OutBalanceChar'  ,OutBalanceChar
 ]);

 end;

end;

procedure TRapNewDataModule.UsersDataAfterOpen(DataSet: TDataSet);
