procedure TRapNewDataModule.ValutesThreadRecord(Sender: TOracleQuery);
begin
if Assigned(RepairNewMain) then
 with RepairNewMain,clbValute,Items do
  begin
   Add(Sender.Field('valu_name'));
   Checked[Count-1]:=True;
   TStringList(Pointer(clbValute.Tag)^).Add(Sender.Field('valute'))
 end;
end;

procedure TRapNewDataModule.VidOpThreadRecord(Sender: TOracleQuery);
begin
if Assigned(RepairNewMain) then
 with RepairNewMain,clbOperation,Items do
