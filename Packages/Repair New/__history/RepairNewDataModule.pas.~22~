   Add(Sender.Field('name'));
   Checked[Count-1]:=True;
   TStringList(Pointer(clbOperation.Tag)^).Add(Sender.Field('ID'))
  end;
end;

procedure TRapNewDataModule.ValutesThreadFinished(Sender: TOracleQuery);
begin
if Assigned(RepairNewMain) then
 with RepairNewMain,clbValute,Items do
  begin
    Add('Multivalyuta');
    TStringList(Pointer(clbValute.Tag)^).Add('CreditCurrencyID');
    Checked[Count-1]:=True;
