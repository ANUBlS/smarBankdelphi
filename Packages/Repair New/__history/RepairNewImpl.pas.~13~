procedure TRepairNewMain.CreateSearchPanel;
var
i,edLeft: Integer;
TempEdit: TEdit;
begin
 with dbMain do
  begin
    edLeft:=4;
   for i:=0 to Columns.Count-1 do
    with TempEdit do
     begin
      TempEdit:=TEdit.Create(pnSearch);
      Hint:=Columns[i].Field.FieldName;
      if pnSearch.FindComponent('ed_'+Hint)=nil then Name:='ed_'+Hint;
      Text:=EmptyStr;
      OnChange:=FastSearch;
      OnKeyPress:=KeyFastSearch;
      OnKeyDown:=KeyFastUpDownSearch;
      SetBounds(edLeft,4,Columns[i].Width,10);
      Parent:=pnSearch;
      Ctl3D:=False;
      Color:=clSilver;
      Font.Color:=clNavy;
      edLeft:=edLeft+Columns[i].Width+1;
     end;
  end;
 pnSearchOrder.BringToFront;
end;


procedure TRepairNewMain.KeyFastSearch(Sender: TObject; var Key: Char);
begin
 if Ord(Key)=13 then
  begin
   sbUpClick(sbMiddle);
   FastSearch(Sender);
   Key:=#0;
  end;
end;

procedure TRepairNewMain.KeyFastUpDownSearch(Sender: TObject; var Key: Word;Shift: TShiftState);
begin
  case Key of
  VK_UP:
   begin
    sbUpClick(sbUp);
    FastSearch(Sender);
    Key:=0;
   end;
  VK_DOWN:
   begin
    sbUpClick(sbDown);
    FastSearch(Sender);
    Key:=0;
   end;
  end;
end;

procedure TRepairNewMain.FastSearch(Sender: TObject);
var
 RecOpt :TSearchRecordOptions;
begin
 RecOpt:=[srIgnoreCase,srPartialMatch];
 if (Sender is TEdit) then
  with (Sender as TEdit),RapNewDataModule.TransactionData do
    if Active then
      begin
        case FOrder of
         soForward: Include(RecOpt,srForward);
         soBackward: Include(RecOpt,srBackward);
         soNone: Include(RecOpt,srFromBeginning);
        end;
         SearchRecord(Hint,Text,RecOpt);
      end;
end;

procedure TRepairNewMain.sbUpClick(Sender: TObject);

procedure ReenableControls(Sender: TControl);
 var
  i: Integer;
 begin
 with Sender.Parent do
  for i:=0 to ControlCount-1 do
     Controls[i].Enabled:=True;
  Sender.Enabled:=False;
 end;
begin
 if Sender=sbUp then FOrder:=soBackward
 else if Sender=sbMiddle then FOrder:=soNone
 else if Sender=sbDown then FOrder:=soForward;
   ReenableControls(TControl(sender));
end;

