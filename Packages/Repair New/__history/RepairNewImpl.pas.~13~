function TRepairNewMain.ExecuteEditAction(DataSet: TDataSet;Value:  TEditAction): Boolean;

procedure ShowEditForm(AcValue: TEditAction);
begin
if not(Assigned(RepairEdit)) then
 RepairEdit:=TRepairEdit.Create(self);
 try
  RepairEdit.EditAction:=AcValue;
  RepairEdit.ShowModal;
 finally
  RepairEdit.Release;
  RepairEdit:=nil;
 end;
end;

begin
 ExecuteEditAction:=False;
 case Value of
 acInsert:
  begin
   DataSet.Insert;
   ShowEditForm(Value);
   Result:=True;
  end;
 acUpdate:
  begin
   DataSet.Edit;
   ShowEditForm(Value);
   Result:=True;
  end;
 acDelete:Beep;
 end;
end;

procedure TRepairNewMain.pnGridlayerResize(Sender: TObject);

 function ColumnsWidth: Integer;
  var
   i: Integer;
  begin
    Result:=0;
    with dbMain do
     for i:=0 to Columns.Count-1 do
      Result:=Result+Columns[i].Width;
  end;


begin
with dbMain do
 begin
   if Tag=0 then
      begin
       Tag:=(Sender as TPanel).Width;
       pnGridlayer.Tag:=Columns[Columns.Count-1].Width;
       TempWidth:=(Sender as TPanel).Width;
     end;

    if (Columns[Columns.Count-1].Width+((Sender as TPanel).Width-Tag)>pnGridlayer.Tag)
    and ((Sender as TPanel).Width > TempWidth+4) then
     begin
      Columns[Columns.Count-1].Width:=Columns[Columns.Count-1].Width+((Sender as TPanel).Width-Tag);
      Tag:=(Sender as TPanel).Width;
     end
    else
     begin
      Columns[Columns.Count-1].Width:=pnGridlayer.Tag;
      Tag:=(Sender as TPanel).Width;
     end;
 end;
end;


procedure TRepairNewMain.FilterShowAction(Value: TFilterType);

function EnableData(Sender: TDataset): Boolean;
begin
 if (Sender is TDataSet) then
  begin
  with (Sender as TDataSet) do
   if not(Active) then
     Open else Refresh;
    EnableData:=True;
  end
 else EnableData:=False;
end;

begin
with RapNewDataModule do
begin
 if (Value=ftMain) or (Value=ftAll) then
   begin
    if Value=ftAll then
     begin
      clbValute.Clear;
      TStringList(Pointer(clbValute.Tag)^).Clear;
      clbOperation.Clear;
      TStringList(Pointer(clbOperation.Tag)^).Clear;
     end;
    scUser.DataSource:=Users;
    EnableData(UsersData);
    if not(clbValute.Items.Count>1) then Valutes.Execute;
    if not(clbOperation.Items.Count>1) then VidOp.Execute;
   end;

 if (Value=ftFilial) or (Value=ftAll) then
   begin
  if not(FilialDebetData.Active)or (Value=ftAll) then
   if EnableData(FilialDebetData) then
    begin
      scDebetFilial.DataSource:=FilialDebet;
      scDebetFilial.Refresh;
    end;
  if not(FilialCreditData.Active)or(Value=ftAll) then
   if  EnableData(FilialCreditData) then
     begin
      scKreditFilial.DataSource:=FilialCredit;
      scKreditFilial.Refresh;
     end;
   end;
end;
end;


