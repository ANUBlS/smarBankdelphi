function Sezar(Key:Integer; S:String; Decode:Boolean):String;
var
  i:Integer;
  st:String;
begin
  st:=S;
  if Decode then Key:=-Key;
  for i:=1 to Length(S) do
    st[i]:=Chr((Ord(S[i])+Key));
  Result:=st;
end;




