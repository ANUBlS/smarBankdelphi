  then
 begin
 //showmessage(IDS);
  with SWDataModule.SW_IN_FORAddIn do
     begin
     Close;
     SetVariable('IDs',IDS);
     Open;
     for i:=0 to recordcount-1 do begin
  
   SwDataModule.sw_in_insert.CallProcedure('add_in_transactions',[fieldbyName('id').asinteger,
