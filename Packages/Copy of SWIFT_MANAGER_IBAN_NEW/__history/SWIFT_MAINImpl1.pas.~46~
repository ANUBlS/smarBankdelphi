procedure TSWIFT_MAIN.CreateFaylExecute(Sender: TObject);
var
 sum,kesr:real;
i:integer;
output:TextFile;
FileName,Swmessage,dir,edit_ref,BeginMessage,Endmesage,valu:String;

begin
   GRIDOUT2.SetFocus;
   GRIDOUT2.SelectedRows.CurrentRowSelected:=Grid_out.DataSource.DataSet.RecordCount<>0;
   if GRIDOUT2.DataSource.DataSet.FieldByName('status').asinteger=5 then
  begin
  edit_ref:=GRIDOUT2.DataSource.DataSet.FieldByName('id').asstring;
  for i:=1 to (8-length(edit_ref)) do begin
  edit_ref:='0'+edit_ref;
  end;
  valu:=GRIDOUT2.DataSource.DataSet.FieldByName('MF32A_CURR').asstring;
  if valu='AZN' then valu:='AZM';
  if not DirectoryExists(SWDataModule.sw_settings.fieldbyname('path_out').asstring) then
  MkDir(SWDataModule.sw_settings.fieldbyname('path_out').asstring);
  dir:=SWDataModule.sw_settings.fieldbyname('path_out').asstring+'\'+FormatDateTime('ddmmyy',date)+'\';
  if not DirectoryExists(dir) then
  MkDir(dir);
   //bke:=copy(GRIDOUT2.DataSource.DataSet.FieldByName('SENDERBIC').asstring,0,6);
   FileName:=dir+'sw'+edit_ref+'.fin';
   AssignFile(output,FileName);
   Rewrite(output);

   BeginMessage:='{1:F01';
   Swmessage:=GRIDOUT2.DataSource.DataSet.FieldByName('SENDERBIC').asstring+

   'AXXX1234123456}{2:I'+copy(GRIDOUT2.DataSource.DataSet.FieldByName('MESSAGETYPE').asstring,3,3)+
    copy(GRIDOUT2.DataSource.DataSet.FieldByName('RECEIVERBIC').asstring,0,8)+'X'+copy(GRIDOUT2.DataSource.DataSet.FieldByName('RECEIVERBIC').asstring,9,3)+'N}{3:{'+
    copy(GRIDOUT2.DataSource.DataSet.FieldByName('MESSAGETYPE').asstring,3,3)+ ':'+ valu
    +'}}{4:';
    BeginMessage:= BeginMessage+Swmessage;
   Writeln(output,BeginMessage);
//--------------body file------------------

// referense write
     Swmessage:=GRIDOUT2.DataSource.DataSet.fieldbyname('MF20').AsString;;
     Swmessage:=Swmessage+GRIDOUT2.DataSource.DataSet.fieldbyname('MF20_REFERENCE').AsString;
     Writeln(output,swmessage);

//mf23 write
     Swmessage:=GRIDOUT2.DataSource.DataSet.fieldbyname('M23B').AsString;
     Swmessage:=Swmessage+GRIDOUT2.DataSource.DataSet.fieldbyname('MF23B').AsString;
     Writeln(output,swmessage);

//mf26t write
     if GRIDOUT2.DataSource.DataSet.fieldbyname('M26T').AsString<>'' then
        begin
          Swmessage:=GRIDOUT2.DataSource.DataSet.fieldbyname('M26T').AsString;
          Swmessage:=Swmessage+GRIDOUT2.DataSource.DataSet.fieldbyname('MF26T').AsString;
          Writeln(output,swmessage);
        end;

//mf32a
      sum:= GRIDOUT2.DataSource.DataSet.fieldbyname('MF32A_AMOUNT').AsFloat;
      kesr:=frac(sum);

      Swmessage:= GRIDOUT2.DataSource.DataSet.fieldbyname('M32A').AsString;
      Swmessage:=Swmessage+FormatDateTime('ddmmyy',GRIDOUT2.DataSource.DataSet.fieldbyname('MF32A_DATE').AsDateTime);
      Swmessage:=Swmessage+GRIDOUT2.DataSource.DataSet.fieldbyname('MF32A_CURR').AsString;
      Swmessage:=Swmessage+GRIDOUT2.DataSource.DataSet.fieldbyname('MF32A_AMOUNT').AsString;
      if kesr=0 then Swmessage:=Swmessage+',' else Swmessage:=StringReplace(Swmessage, '.', ',',
                          [rfReplaceAll, rfIgnoreCase]);
      Writeln(output,swmessage);

//mf36
    if GRIDOUT2.DataSource.DataSet.fieldbyname('M36').AsString<>'' then
       begin
       Swmessage:= GRIDOUT2.DataSource.DataSet.fieldbyname('M36').AsString;
       Swmessage:=Swmessage+GRIDOUT2.DataSource.DataSet.fieldbyname('MF36').AsString;
       Writeln(output,swmessage);
       end;

//mf50
    if GRIDOUT2.DataSource.DataSet.fieldbyname('M50').AsString<>'' then
       begin
       Swmessage:= GRIDOUT2.DataSource.DataSet.fieldbyname('M50').AsString;
       if GRIDOUT2.DataSource.DataSet.fieldbyname('MF50_ACCOUNT').AsString<>'' then
       begin
       Swmessage:=Swmessage+'/'+GRIDOUT2.DataSource.DataSet.fieldbyname('MF50_ACCOUNT').AsString;
       Writeln(output,swmessage);
       end;
       if GRIDOUT2.DataSource.DataSet.fieldbyname('MF50_BIC').AsString<>'' then
       begin
       Swmessage:= GRIDOUT2.DataSource.DataSet.fieldbyname('MF50_BIC').AsString;
       Writeln(output,swmessage);
       end;
       if GRIDOUT2.DataSource.DataSet.fieldbyname('MF50_NAME$ADRESS').AsString<>'' then
       begin
       Swmessage:= GRIDOUT2.DataSource.DataSet.fieldbyname('MF50_NAME$ADRESS').AsString;
       Writeln(output,swmessage);
       end;
       end;

//mf52
    if GRIDOUT2.DataSource.DataSet.fieldbyname('M52').AsString<>'' then
       begin
       Swmessage:=GRIDOUT2.DataSource.DataSet.fieldbyname('M52').AsString;
       Swmessage:=Swmessage+'/'+GRIDOUT2.DataSource.DataSet.fieldbyname('MF52_ACCOUNT').AsString;
       Writeln(output,swmessage);
       Swmessage:= GRIDOUT2.DataSource.DataSet.fieldbyname('MF52_BIC').AsString;
       Writeln(output,swmessage);
       Swmessage:= GRIDOUT2.DataSource.DataSet.fieldbyname('MF52_NAME$ADRESS').AsString;
       Writeln(output,swmessage);
       end;

//mf53
    if GRIDOUT2.DataSource.DataSet.fieldbyname('M53').AsString<>'' then
       begin
       Swmessage:=GRIDOUT2.DataSource.DataSet.fieldbyname('M53').AsString;
       Swmessage:=Swmessage+'/'+GRIDOUT2.DataSource.DataSet.fieldbyname('MF53_ACCOUNT').AsString;
       Writeln(output,swmessage);
       Swmessage:= GRIDOUT2.DataSource.DataSet.fieldbyname('MF53_BIC').AsString;
       Writeln(output,swmessage);
       Swmessage:= GRIDOUT2.DataSource.DataSet.fieldbyname('MF53_NAME$LOCATION').AsString;
       Writeln(output,swmessage);
       end;

//mf54
    if GRIDOUT2.DataSource.DataSet.fieldbyname('M54').AsString<>'' then
