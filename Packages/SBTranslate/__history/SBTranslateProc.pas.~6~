function CDecrypt(StrValue :string):String;
var
  Cipher: TDCP_rc4;
  KeyStr: string;
begin
  KeyStr:= '';
  Cipher:= TDCP_rc4.Create(nil);
  Cipher.InitStr(KeyStr,TDCP_sha1);
  KeyStr:= Cipher.DecryptString(StrValue);
  Cipher.Burn;
  Cipher.Free;
  Result :=KeyStr;
end;

function EnDeCrypt(const Value : String) : String;
var
  CharIndex : integer;
begin
  Result := Value;
  for CharIndex := 1 to Length(Value) do
    Result[CharIndex] := chr(not(ord(Value[CharIndex])));
end;

