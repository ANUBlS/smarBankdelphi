procedure InsertComponentCaptions(FormName :TActiveForm; PackName :TOraclePackage);
var
  i,j :integer;
begin
  if TranslatingPeriod='1' then begin
   with FormName, PackName do begin
    for i := 0 to FormName.ComponentCount - 1  do begin

    try          
     {Inserting used component class names;
       it shall not deleted (only commentered) because it may be used by mine sometimes}
     CallProcedure('InsertComponentClassName',[(FormName.Components[i].ClassName)]);

     {TLabel}
     if (FormName.Components[i].ClassType = TLabel) then
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TLabel).Caption]);
     {TButton}
     if (FormName.Components[i].ClassType = TButton) then
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TButton).Caption]);
     {TSpeedButton}
     if (FormName.Components[i].ClassType = TSpeedButton) then
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TSpeedButton).Caption]);
     {TToolButton}     if (FormName.Components[i].ClassType = TToolButton) then
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TToolButton).Caption]);
     {TGroupBox}
     if (FormName.Components[i].ClassType = TGroupBox) then
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TGroupBox).Caption]);
     {CheckBox}
     if (FormName.Components[i].ClassType = TCheckBox) then
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TCheckBox).Caption]);
     {TRadioGroup}
     if (FormName.Components[i].ClassType = TRadioGroup) then begin
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TRadioGroup).Caption]);
     for j :=0 to (FormName.Components[i] as TRadioGroup).Items.Count-1 do begin
      try CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TRadioGroup).Items[j]]); except end;
     end;{RadoiGroup.Items.Count}
     end;{TRadioGroup}
     {TComboBox}
     if (FormName.Components[i].ClassType = TComboBox) then begin
      for j :=0 to (FormName.Components[i] as TComboBox).Items.Count-1 do begin
       try CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TComboBox).Items[j]]); except end;
      end;{ComboBox.Items.Count}
     end;{TComboBox}
     {TSearchCombo}
     if (FormName.Components[i].ClassType = TSearchCombo) then begin
      for j :=0 to (FormName.Components[i] as TSearchCombo).Items.Count-1 do begin
       try CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TSearchCombo).Items[j]]); except end;
      end;{SearchCombo.Items.Count}
     end;{TSearchCombo}
     {TDBGrid}
     if (FormName.Components[i].ClassType = TDBGrid) then begin
      for j :=0 to (FormName.Components[i] as TDBGrid).Columns.Count-1 do begin
       try CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TDBGrid).Columns[j].Title.Caption]); except end;
      end;{DBGrid.Columns.Count}
     end;{TDBGrid}
     {TStaticText}
     if (FormName.Components[i].ClassType = TStaticText) then
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TStaticText).Caption]);
     {TPanel}
     if (FormName.Components[i].ClassType = TPanel) then
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TPanel).Caption]);
     {TBitBtn}
     if (FormName.Components[i].ClassType = TBitBtn) then
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TBitBtn).Caption]);
     {TMainMenu}
     if (FormName.Components[i].ClassType = TMainMenu) then begin
      for j :=0 to (FormName.Components[i] as TMainMenu).Items.Count-1 do begin
       try CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TMainMenu).Items[j].Caption]); except end;
     end;{MainMenu.Items.Count}
    end;{TMainMenu}
    {TMenuItem}
    if (FormName.Components[i].ClassType = TMenuItem) then
      CallProcedure('InsertComponentCaption',[(FormName.Components[i] as TMenuItem).Caption]);

    except end;
    end; {for i := 0 to FormName.ComponentCount - 1}
   end; {with FormName, PackName}
  end; {if TranslatingPeriod='1'}
end;

