unit Unitcust;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Grids, DBGrids, StdCtrls, ExtCtrls, DB, OracleData, XDBGrids,
  Buttons, XFSCtrls;

type
  TFormCUT = class(TForm)
    Panel1: TPanel;
    Panel3: TPanel;
    Panel4: TPanel;
    Panel5: TPanel;
    CBSearch: TComboBox;
    EditSearch: TEdit;
    DBGrid1: TDBGrid;
    ODS_CUSTOMERS: TOracleDataSet;
    ODS_CUSTOMERSID: TIntegerField;
    DS_CUSTOMERS: TDataSource;
    ODS_CUSTOMERSNAME: TWideStringField;
    Ods_satici: TOracleDataSet;
    DS_Satici: TDataSource;
    Ods_saticiCUSTID2: TFloatField;
    Ods_saticiSONAME: TWideStringField;
    Ods_saticiNAME: TWideStringField;
    Ods_saticiLASTNAME: TWideStringField;
    Ods_saticiPASSPIN: TWideStringField;
    Ods_saticiPASSSER: TWideStringField;
    XFBitBtn1: TXFBitBtn;
    XFBitBtn2: TXFBitBtn;
    DBGrid2: TDBGrid;
    ODS_CUSTOMERSINN: TWideStringField;
    Ods_saticiFUL_NAME: TWideStringField;
    procedure EditSearchChange(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure XFBitBtn1Click(Sender: TObject);
    procedure XFBitBtn2Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormCUT: TFormCUT;

implementation
 uses sboapiDataModuleImpl , GuaranteeMgrImpl,DashinmazImpl;
{$R *.dfm}

procedure TFormCUT.EditSearchChange(Sender: TObject);
begin
  if Length(EditSearch.Text)<>0 then
  begin
  ODS_CUSTOMERS.Close;
  case CBSearch.ItemIndex of
  0:ODS_CUSTOMERS.SQL[3]:='and ID like '''+EditSearch.Text+'%''';
  1:ODS_CUSTOMERS.SQL[3]:='and upper(name) like upper(''%'+EditSearch.Text+'%'')';
   end;
  ODS_CUSTOMERS.Open;
  end
end;

procedure TFormCUT.FormShow(Sender: TObject);
 var

 i:integer;
begin
  CBSearch.Clear;
for i := 0 to DBGrid1.Columns.Count-1 do
CBSearch.Items.Add(DBGrid1.Columns[i].Title.Caption);

 CBSearch.ItemIndex:=0;
  if not(ODS_CUSTOMERS.Active = True) then
    ODS_CUSTOMERS.Open
  else
    ODS_CUSTOMERS.Refresh;
end;

procedure TFormCUT.XFBitBtn1Click(Sender: TObject);
begin
FormCUT.Close
end;

procedure TFormCUT.XFBitBtn2Click(Sender: TObject);
begin
with FrmDashinmaz do
begin
  Edit1.Text:=ODS_CUSTOMERSID.AsString;
  edit2.Text:=ODS_CUSTOMERSNAME.AsString;
  edit3.Text:=ODS_CUSTOMERSINN.AsString;
  edit4.Text:=Ods_saticiCUSTID2.AsString;
  edit5.Text:=Ods_saticiFUL_NAME.AsString;
  edit6.Text:=Ods_saticiPASSPIN.AsString;

  mkt_id:=ODS_CUSTOMERSID.AsInteger;
  satici_id:=Ods_saticiCUSTID2.AsInteger;


  FormCUT.Close
end;
end;

end.
