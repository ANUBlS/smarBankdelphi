    SQL.Strings = (
      'select'
      
        '  RestForLastPeriod.AccountID,(select prinad_kod from customers ' +
        'where id=RestForLastPeriod.kliid)as mesubyet,(SELECT acc_kli_id(' +
        'RestForLastPeriod.AccNo) from dual )as ID ,(SELECT   SUBSTR (Res' +
        'tForLastPeriod.AccNo, sbop.get_acc_no_sub+1, 30) FROM DUAL)AS ac' +
        'c_no2 ,'
      
        '  RestForLastPeriod.AccNo , RestForLastPeriod.AccName as ACC_NAM' +
        'E ,'
      '  RestForLastPeriod.CurrencyID ,'
      '  RestForLastPeriod.BranchID ,'
      '  RestForLastPeriod.BalanceNo ,'
      '  RestForFirstPeriod.Active as BeginActive ,'
      '  RestForFirstPeriod.Passive as BeginPassive ,'
      '  RestForFirstPeriod.LActive as LBeginActive ,'
      '  RestForFirstPeriod.LPassive as LBeginPassive ,'
      '  TurnOvers.DTurnOver ,'
      '  TurnOvers.CTurnOver ,'
      '  TurnOvers.LDTurnOver ,'
      '  TurnOvers.LCTurnOver ,'
      '  RestForLastPeriod.Active as EndActive ,'
      '  RestForLastPeriod.Passive as EndPassive ,'
      '  RestForLastPeriod.LActive as LEndActive ,'
      '  RestForLastPeriod.LPassive as LEndPassive'
      'from'
      ''
      '(select'
      '  ac.kli_id as kliid, ac.ID as AccountID ,'
      '  ac.acc_no as AccNo ,'
      '  b.bal_cn  as BalanceNo ,'
      ''
      '  sb_mtoutview.active ('
      '    ar.ostat,'
      '    b.typeid,'
      '    b.additionaltypeid'
      '  ) as Active ,'
      ''
      '  sb_mtoutview.passiv ('
      '     ar.ostat,'
      '     b.typeid,'
      '     b.additionaltypeid'
      '  ) as Passive ,'
      ''
      '  sb_mtoutview.active ('
      '    ar.pok_ostat,'
      '    b.typeid,'
      '    b.additionaltypeid'
      '  ) as LActive ,'
      ''
      '  sb_mtoutview.passiv ('
      '     ar.pok_ostat,   '
      '     b.typeid,'
      '     b.additionaltypeid'
      '  ) as LPassive'
      ''
      'from'
      '  account ac ,'
      '  archost ar ,'
      '  bal_spr%d b  /*52*/'
      'where'
      '  ar.acc_id = ac.id and'
      '  ac.bal_cn%d = b.bal_cn and     /*55*/'
      '  ar.DatDate = :BeginPeriod  and '
      '  ((ac.Close_Dat is null)or(ac.Close_Dat > :BeginPeriod)) '
      ') RestForFirstPeriod ,'
      ''
      '(select'
      '  ac.kli_id as kliid,ac.ID as AccountID ,'
      '  ac.acc_no as AccNo , ac.name as AccName ,'
      '  ac.val_acc as CurrencyID ,'
      '  ac.filial as BranchID ,'
      '  b.bal_cn  as BalanceNo ,'
      ''
      '  sb_mtoutview.active ('
      '    ar.ostat,'
      '    b.typeid,'
      '    b.additionaltypeid'
      '  ) as Active ,'
      ''
      '  sb_mtoutview.passiv ('
      '     ar.ostat,'
      '     b.typeid,'
      '     b.additionaltypeid'
      '  ) as Passive ,'
      ''
      '  sb_mtoutview.active ('
      '    ar.pok_ostat,'
      '    b.typeid,'
      '    b.additionaltypeid'
      '  ) as LActive ,'
      ''
      '  sb_mtoutview.passiv ('
      '     ar.pok_ostat,'
      '     b.typeid,'
      '     b.additionaltypeid'
      '  ) as LPassive'
      ''
      'from'
      '  account ac ,'
      '  archost ar ,'
      '  bal_spr%d b  /*94*/'
      'where'
      '  ar.acc_id = ac.id and'
      '  ac.bal_cn%d = b.bal_cn and  /*97*/'
      '  ar.DatDate = :EndDate  and'
      ' ((ac.Close_Dat is null)or(ac.Close_Dat > :BeginPeriod)) '
      ') RestForLastPeriod ,'
      ''
      '(select'
      '  ac.ID as AccountID ,'
      '  min(ac.acc_no) as AccNo,'
      '  min(b.bal_cn)  as BalanceNo ,'
      '  sum(ar.Obr_D) as DTurnOver ,'
      '  sum(ar.Obr_K) as CTurnOver ,  '
      '  sum(ar.Pok_Obr_D) as LDTurnOver ,'
      '  sum(ar.Pok_Obr_K) as LCTurnOver   '
      ''
      'from'
      '  account ac ,'
      '  archost ar ,'
      '  bal_spr%d b  /*114*/'
      'where'
      '  ar.acc_id = ac.id and'
      '  ac.bal_cn%d = b.bal_cn and /*117*/'
      '  ar.DatDate between :BeginDate and :EndDate'
      'group by'
      '  ac.ID'
      ') TurnOvers'
      ''
      'where'
      '  (RestForLastPeriod.BalanceNo in (%s)) and /*124*/'
      '   RestForLastPeriod.CurrencyID = %d and /*125*/'
      '   RestForLastPeriod.BranchID = %d and /*126*/'
      '   RestForLastPeriod.AccNo like %s and /*127*/'
      '   TurnOvers.AccountID = RestForFirstPeriod.AccountID  (+) and'
      '   TurnOvers.AccountID = RestForLastPeriod.AccountID (+) '
      '   '
      'order by'
      
        '  RestForLastPeriod.BalanceNo, acc_no2,RestForLastPeriod.BranchI' +
        'D ')
