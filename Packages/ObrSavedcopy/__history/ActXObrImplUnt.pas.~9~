end;

procedure  OpenODS;
const
      cGetUserName='GetUserName';
var
    aStr :string;
begin
  with   DataModMain.OpackMain do
    aStr :=CallStringFunction(cGetUserName,[]);
    aStr :='TURN_'+aStr ;
    with  DatamodMain do
    begin
     if   ODSLocate.Active  then  ODSLocate.Close;
     if   ODSSum.Active   then ODSSum.Close;
      ODSLocate.SQL.Clear;
      ODSLocate.SQL.Add('Select * from  '+aStr+' order by Bal_cn,Acc_no');
      ODSLocate.Open;

      ODSSum.SQL.Clear;
      ODSSum.SQL.Add('select  Sum(s_act),Sum(p_act),Sum(s_pas),Sum(p_pas),Sum(Obr_k),Sum(Obr_d),Sum(pok_Obr_k),Sum(pok_Obr_d)  from '+aStr+ '  order by Acc_no,Bal_cn');
      ODSSum.Open;
    end;

    {with  DataModMain do
    begin
      with ODSLocate do Refresh;
      with ODSSum do    Refresh;
    end;}
end;
procedure TActXObr.BitBtnOstClick(Sender: TObject);
var
    strBalList:string;
begin
  if  Trunc(DateTimePicker1.DateTime)>getBankday then
   begin
     ShowMessage('Daxil etdiyiniz tarix yalnışdır!'#13+'Bankın son iş  günü: '+DateToStr(getBankday));
     Abort
   end;
 //if   (Sender as TBitBtn).Tag=0 then
  Screen.Cursor:=crHourGlass;
 try
 try
  if  EditBal.Text='' then
    strBalList :='@' else
    strBalList :=EditBal.Text;
    ProgressBar1.Max :=100;
    sb_GetBalance(GetCurrDate,Kk[n],ComboBox1.ItemIndex+1,strBalList,RadioGroup2.ItemIndex,Branch[CBBranch.ItemIndex]);

    ProgressBar1.StepBy(50);
