procedure TActXObr.ActiveFormCreate(Sender: TObject);
begin
    ActXObr := Self;
    DataModMain :=TDataModMain.Create(Self);
    QuickRepObr1 :=TQuickRepObr1.Create(Self);
    QuickRepObr2 :=TQuickRepObr2.Create(Self);
