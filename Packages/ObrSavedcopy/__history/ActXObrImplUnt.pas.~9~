procedure TActXObr.PrintDefaultRate;
var
     V:Variant;
begin
 V:=Integer(Trunc(DateTimePicker1.DateTime));
 if    BtnTag=0 then
  with  QuickRepObr2 do begin
   ValNames.Lines.Clear;
   ValRates.Lines.Clear;
   end else
  with  QuickRepObr1 do begin
    ValNames.Lines.Clear;
    ValRates.Lines.Clear;
   end;
  with DataModMain.ODSValute do
  begin
  if  Active then Close;

    SetVariable('ADate',V);
    Open;
    First;
  end;
    while not DataModMain.ODSValute.Eof do
    begin
     if  BtnTag = 0 then
     with QuickRepObr2 do
     begin
      with ValNames.Lines do
        Add(DataModMain.ODSValute.FieldByName('Name').AsString);
      with ValRates.Lines do
        Add(FormatFloat('0.0000',DataModMain.ODSValute.FieldByName('DefaultRate').Value));
     end
     else
     with QuickRepObr1 do
     begin
      with ValNames.Lines do
        Add(DataModMain.ODSValute.FieldByName('Name').AsString);
      with ValRates.Lines do
        Add(FormatFloat('0.0000',DataModMain.ODSValute.FieldByName('DefaultRate').Value));
     end;
      DataModMain.ODSValute.Next
    end;
    DataModMain.ODSValute.Close
end;
