procedure TActXObr.GetCurrencyKourse;
begin
      DataModMain.ODSSysKod.Open;
      n := 0;
      ComboBoxKurs.Style :=csDropDown;
      ComboBoxKurs.Items.Clear;
      ComboBoxKurs.Items.Add('Bütün valyutalar ');
      Kk[n] := -1;
      DataModMain.ODSSysKod.First;
      n := 1;
      While not DataModMain.ODSSysKod.EOF do
      begin
       Kk[n] := DataModMain.ODSSysKod.FieldByName('VALUTE').AsInteger;
       ComboBoxKurs.Items.Add( DataModMain.ODSSysKod.FieldByName('VALU_NAME').AsString);
       Inc(n);
       DataModMain.ODSSysKod.Next;
      end;
      DataModMain.ODSSysKod.Close;
      ComboBoxKurs.Style:= csDropDownList;
end;
procedure TActXObr.InitializeRpt(BtnTag:Byte);
begin
  if  BtnTag=0 then
  begin
      PrintDefaultRate(BtnTag);
      QuickRepObr2.ChildBand1.Enabled:=(RadioGroup4.ItemIndex=1);
      QuickRepObr2.DetailBand1.ForceNewPage := RadioGroup1.ItemIndex=1;
      QuickRepObr2.QRLabel8.Caption :=FormatDateTime('dd/mm/yyyy',Trunc(DateTimePicker1.DateTime));
      QuickRepObr2.QRLabel3.Caption :=ComboBoxKurs.Items[ComboBoxKurs.ItemIndex];

   if   (RadioGroup3.ItemIndex = 0)and(n<>0)  then
   with  QuickRepObr2 do begin
       QRDBText4.DataField :='OBR_D';
       QRExpr9.Expression:='SUM(ODSLocate.OBR_D)';
       QRDBText5.DataField:='SUM(OBR_D)';
       QRDBText2.DataField :='OBR_K';
       QRExpr10.Expression:='SUM(ODSLocate.OBR_K)';
       QRDBText10.DataField:='SUM(OBR_K)';
       QRDBText7.DataField :='S_ACT';
       QRExpr11.Expression:='SUM(ODSLocate.S_ACT)';
       QRDBText12.DataField:='SUM(S_ACT)';
       QRDBText9.DataField :='S_PAS';
       QRExpr12.Expression:='SUM(ODSLocate.S_PAS)';
       QRDBText13.DataField:='SUM(S_PAS)';
     end else
     with  QuickRepObr2 do begin
       QRDBText4.DataField :='POK_OBR_D';
       QRExpr9.Expression:='SUM(ODSLocate.POK_OBR_D)';
       QRDBText5.DataField:='SUM(POK_OBR_D)';
       QRDBText2.DataField :='POK_OBR_K';
       QRExpr10.Expression:='SUM(ODSLocate.POK_OBR_K)';
       QRDBText10.DataField:='SUM(POK_OBR_K)';
       QRDBText7.DataField :='P_ACT';
       QRExpr11.Expression:='SUM(ODSLocate.P_ACT)';
       QRDBText12.DataField:='SUM(P_ACT)';
       QRDBText9.DataField :='P_PAS';
       QRExpr12.Expression:='SUM(ODSLocate.P_PAS)';
       QRDBText13.DataField:='SUM(P_PAS)';
     end;
    with QuickRepObr2 do
      Preview;

   end else begin
      PrintDefaultRate(BtnTag);
      QuickRepObr1.QRDBText6.Enabled:=(RadioGroup4.ItemIndex=1);
      QuickRepObr1.QRLabel10.Enabled :=(RadioGroup4.ItemIndex=1);
      QuickRepObr1.DetailBand1.ForceNewPage := RadioGroup1.ItemIndex=1;
      QuickRepObr1.QRLabel8.Caption :=FormatDateTime('dd/mm/yyyy',Trunc(DateTimePicker1.DateTime));
      QuickRepObr1.QRLabel3.Caption :=ComboBoxKurs.Items[ComboBoxKurs.ItemIndex];;

   if   (RadioGroup3.ItemIndex = 0)and(n<>0)  then
   with  QuickRepObr1 do begin
       QRDBText2.DataField :='S_ACT';
       QRExpr5.Expression:='SUM(ODSLocate.S_ACT)';
       QRDBText10.DataField:='SUM(S_ACT)';
       QRDBText4.DataField :='S_PAS';
       QRExpr6.Expression:='SUM(ODSLocate.S_PAS)';
       QRDBText11.DataField:='SUM(S_PAS)';
     end else
     with  QuickRepObr1 do begin
        QRDBText2.DataField :='P_ACT';
        QRExpr5.Expression:='SUM(ODSLocate.P_ACT)';
        QRDBText10.DataField:='SUM(P_ACT)';
        QRDBText4.DataField :='P_PAS';
        QRExpr6.Expression:='SUM(ODSLocate.P_PAS)';
        QRDBText11.DataField:='SUM(P_PAS)';
      end;
     with QuickRepObr1 do
       Preview;
   end;
end;
