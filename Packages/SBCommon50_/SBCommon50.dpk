package SBCommon50;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart - Common Components, Functions and Classes'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  Vcldb50,
  Vclbde50;

contains
  IniSource in 'IniSource.pas',
  CustomInst in 'CustomInst.pas',
  SBDecls in 'SBDecls.pas',
  SBCommonReg in 'SBCommonReg.pas',
  SBUtils in 'SBUtils.pas',
  ObjectEventManager in 'ObjectEventManager.pas',
  CurrencyEdit in 'CurrencyEdit.pas',
  LogSrv in 'LogSrv.pas',
  ProductVersion in 'ProductVersion.pas',
  Version in 'Version.pas',
  CommonClasses in 'CommonClasses.pas',
  RegUtils in 'RegUtils.pas',
  HintBox in 'HintBox.pas',
  ProgressFormImpl in 'ProgressFormImpl.pas' {ProgressForm},
  SBAxCommon50_TLB in 'ActiveX\SBAxCommon50_TLB.pas',
  TreeViewIni in 'TreeViewIni.pas',
  DBViewComboBox in 'DBViewComboBox.pas',
  CommandManagement in 'CommandManagement.pas',
  Jobs in 'Jobs.pas',
  CurrencyToHRImpl in 'CurrencyToHRImpl.pas',
  CurrencyToHR_Azeri_Impl in 'CurrencyToHR_Azeri_Impl.pas',
  Task in 'Task.pas',
  TaskManager in 'TaskManager.pas';

end.
