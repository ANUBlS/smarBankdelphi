{$R *.dfm}
 uses sboapiDataModuleImpl, AddReserveImpl;
procedure TFrmReserve.Button1Click(Sender: TObject);
begin
 id:=OracleDataSet1.FieldByName('id').asinteger;
AddReserve.ShowModal;
end;

procedure TFrmReserve.Button2Click(Sender: TObject);
var
sql :string;
begin
  if MessageDlg(
       'Silinməsinə əminsinizmi?',
       mtConfirmation,
       [mbYes,mbNo],
       0) <> mrYes
     then   Exit;
     OracleDataSet2.Close;
  sql:='delete cm_reserve_turan_filial where id='+OracleDataSet1.FieldByName('id').AsString;
  OracleDataSet2.SQL.Text:=sql;
  OracleDataSet2.open;
  OracleDataSet2.Session.Commit;
  AddReserve.OracleDataSet4.Refresh;
end;

procedure TFrmReserve.Button3Click(Sender: TObject);
begin
close
end;

procedure TFrmReserve.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
