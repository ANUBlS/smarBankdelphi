procedure TTrchAddForm.ActnProcessTrancheExecute(Sender: TObject);
resourcestring
  rsTransactionsWillProcessed = 'Kredit tranşı ...';
var
  CrdID : Integer;
  TrchDate : TDateTime;
  CustAccID : Integer;
  TrchAmount : Real;
  P_gelAmmount:  Real;
  TrProcess : Boolean;
  CommitTranche : Boolean;
  return_id:integer;
  p_accid :integer;
  p_accVender:integer;
  p_SubsidyaAccid :integer;

begin
  CrdID := Get_SelectedCrdID;
  TrchDate := Integer(Trunc(TrancheDatePckr.DateTime));
  CustAccID := AccountListCB.ListSource.DataSet.FieldByName('ID').AsInteger;
  TrchAmount := TrancheSumEdit.Value;
  P_gelAmmount:=CMCurrencyEdit1.Value;
  p_accid :=DBLookupComboboxEh1.ListSource.DataSet.FieldByName('ID').AsInteger;
  p_accVender:= DBLookupComboboxEh2.ListSource.DataSet.FieldByName('ID').AsInteger;
  p_SubsidyaAccid:=DBLookupComboboxEh3.ListSource.DataSet.FieldByName('ID').AsInteger;
  TrProcess := CBPrcessTransactions.Checked;


      if
      ((AccountListCB.KeyValue=-1)or(AccountListCB.Text='')) or
      ((DBLookupComboboxEh2.KeyValue=-1)or(DBLookupComboboxEh2.Text=''))
         then
    begin
     ShowMessage(' Məlumatlar tam seçilmeyib !');
    exit;
    end;
      if panel3.Visible=true then
      begin
     if (DBLookupComboboxEh3.KeyValue=-1)or(DBLookupComboboxEh3.Text='') then
      begin
       ShowMessage(' Məlumatlar tam seçilmeyib !');
      exit;
      end;
      end;

     if panel4.Visible=true then
      begin
     if (DBLookupComboboxEh1.KeyValue=-1)or(DBLookupComboboxEh1.Text='') then
      begin
       ShowMessage(' Məlumatlar tam seçilmeyib !');
      exit;
      end;
      end;
       if CMCurrencyEdit1.Visible= true then

      if  CMCurrencyEdit1.Value<=0 then
        begin
      ShowMessage(' Faktorinq məbləği daxil edin  !');
      exit;
      end;



     with TrancheDataModule do
  CM_TRANCHE.CallProcedure('Tranche_Add',[
     'p_CreditID' ,CrdID ,
     'p_TrchDate' ,TrchDate ,
     'p_CustAccID' ,CustAccID ,
     'p_TrchAmount' ,TrchAmount ,
     'p_ProcessTransactions' ,TrProcess,
     'p_accid',p_accid ,
     'p_accidVender',p_accVender,
     'p_SubsidyaAccid',p_SubsidyaAccid,
     'P_gelAmmount',P_gelAmmount ,
     'p_EDV',EDV


  ]);
   CMCurrencyEdit1.Value:=0;
  try

    CommitTranche := TrDelayed_Show(Self,rsTransactionsWillProcessed);

    Update;

    with TrancheDataModule do
    CM_TRANCHE.CallProcedure('CommitTranche',[
       'DoCommit' , CommitTranche
    ]);
      TrancheDataModule.cm_reserve_count_new.CallProcedure
                                             ('reserve_contr_new',[CrdID,1,TrchDate]);
    if CommitTranche then
    Self.ModalResult := mrOk;
    Self.Update;

  except

    with TrancheDataModule do
    CM_TRANCHE.CallProcedure('CommitTranche',[
       'DoCommit' , False
    ]);

    raise;

  end;

end;

procedure TTrchAddForm.ActnProcessTrancheUpdate(Sender: TObject);
begin
  (Sender as TAction).Enabled := TrancheSumEdit.Value > 0;
end;

procedure TTrchAddForm.CheckBox1Click(Sender: TObject);

begin
if CheckBox1.Checked=true then
   EDV:=1
