unit Unit_delivery;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, ExtCtrls, Oracle;

type
  TForm_delivery = class(TForm)
    Panel1: TPanel;
    Button1: TButton;
    Panel2: TPanel;
    Memo1: TMemo;
    Panel3: TPanel;
    RadioGroup1: TRadioGroup;
    OraclePackage: TOraclePackage;
    procedure RadioGroup1Click(Sender: TObject);
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
    v_status :integer;
  public
    { Public declarations }
  end;

var
  Form_delivery: TForm_delivery;

implementation

uses MainUnit, UnitFormMain_delivery;

{$R *.dfm}

procedure TForm_delivery.Button1Click(Sender: TObject);
begin
OraclePackage.CallProcedure
                           ('Addcm_notes_report',
                           ['v_creditid',creditid,
                            'v_par1' , memo1.Text,
                            'v_status',v_status]);
       FormMain_delivery.OracleDataSet2.refresh;
        memo1.Clear;
end;

procedure TForm_delivery.RadioGroup1Click(Sender: TObject);
begin
if RadioGroup1.ItemIndex=0 then
begin
   Memo1.Text:='Düz çatdırılma';
   v_status:=1;
   end ;

   if RadioGroup1.ItemIndex=1 then
   begin
    Memo1.Text:='Səhv çatdırılma' ;
    v_status:=2;
   end;
   if RadioGroup1.ItemIndex=2 then
    begin
    Memo1.Text:='' ;
    v_status:=3;

end;
end;

end.
