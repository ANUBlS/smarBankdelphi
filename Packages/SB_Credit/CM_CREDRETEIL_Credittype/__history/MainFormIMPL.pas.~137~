procedure TMainForm.Edit2Change(Sender: TObject);
var
  S, Cleaned, Formatted: string;
  I: Integer;
  SelPos: Integer;
begin
  // Cari mövqeyi saxla
  SelPos := Edit2.SelStart;

  // Mətni götür, boşluqları sil
  S := Edit2.Text;
  Cleaned := StringReplace(S, ' ', '', [rfReplaceAll]);

  // Hər 4 simvoldan sonra boşluq əlavə et
  Formatted := '';
  for I := 1 to Length(Cleaned) do
  begin
    Formatted := Formatted + Cleaned[I];
    if (I mod 4 = 0) and (I <> Length(Cleaned)) then
      Formatted := Formatted + ' ';
  end;

  // Əgər dəyişiklik varsa yenilə
  if Formatted <> S then
  begin
    Edit2.Text := Formatted;
    Edit2.SelStart := Length(Formatted); // Kursoru sona qoy
  end;

end;

