  object DatSetExpCredits: TOracleDataSet
    SQL.Strings = (
      ''
      
        'SELECT p.ID, p.numberofcredit, p.currency, p.personaltype, p.cus' +
        'tomertype,'
      '       p.branchid, p.credittype, b.NAME, av.val_name,b.salary,'
      
        '       cm_common.accountnumber_get (a.contractaccid) AS contract' +
        'accno,'
      
        '       cm_common.accountrest_get (a.booroweraccid) AS custaccres' +
        't,'
      '       cm_utils.Get_PlanPrincipal (p.ID, :PDAT) AS principal,'
      '       cm_utils.Get_IntPlanPayment (p.ID, :PDAT) AS interest,'
      '         cm_utils.Get_PlanPrincipal(p.ID, :PDAT)'
      '       + cm_utils.Get_IntPlanPayment(p.ID, :PDAT) AS sumamt,'
      '        cm_utils.get_gecgun(p.ID, :PDAT) as expdatcount,'
      '       c.penaltyrest, c.reserveid,'
      '       cm_utils.get_creditplanrest (p.ID, :PDAT) AS plr,'
      '       p.dateofconclusion as opendate,'
      '       p.duedatefirstcontract as closedate,'
      '       p.annualyinterestrate,'
      
        '       cm_common.get_AccountBalance(a.contractaccid) as BalaccNo' +
        ','
      '       p.boorowerid ,b.PHONENUMBER,'
      
        'case when p.duedatefirstcontract<:PDAT and nvl(p.duedatelastcont' +
        'ract,'#39'01-jan-2002'#39')<:PDAT '
      
        'then '#39'Vaxt'#305' bitib '#39' else '#39' - '#39' end as creditend,c.rest,c.interes' +
        'trest'
      
        ', (select name  from cm_partniyor where id=p.partid) part, (sele' +
        'ct description from cm_usergroups where id=p.usrgroup) expert,'
      
        '(select name  from cm_qovluq where id=p.qovid) qovluq,(select na' +
        'me from cm_expert where id=p.expertid) shert'
      '  FROM cm_active_credits p,'
      '       cm_boorowerinfo b,'
      '       cm_accounts a,'
      '       cm_curr_state c,'
      '       avalute av'
      '       '
      ' WHERE b.creditid = p.ID'
      '   AND a.creditid = p.ID'
      '   AND c.creditid = p.ID'
      '   AND av.valute = p.currency'
      
        '  -- AND abs((cm_utils.get_creditplanrest (p.ID, :PDAT+1) - (c.r' +
        'est+c.duerest)))>=0.5'
      
        'and c.rest+c.duerest <> 0 and  cm_utils.get_gecgun(p.ID, :PDAT+1' +
        ')>0'
      '--and  cm_utils.Get_PlanPrincipal (p.ID, :PDAT)>0'
      '--and p.intcalcmethod=0'
      'ORDER BY :orderfield'
      ''
      ''
      ''
      '')
