end;

procedure TAfForm.DBEditEh10Change(Sender: TObject);
begin
if (DBEditEh5.text<>'')and(DBEditEh10.text<>'') then
  begin
DBEditEh7.Text:=DBEditEh5.Value-DBEditEh10.Value;
DBEditEh3.Text:=DBEditEh7.Value*edit2.text;
DBEditEh8.Text:=inttostr( round((DBEditEh3.Value*edit1.text)/100+((DBEditEh3.Value*edit1.text)/100*0.44)));
if DBEditEh7.Value<0 then
   DBEditEh7.Color:=clred
   else
   DBEditEh7.Color:=clWhite;
end;
end;

procedure TAfForm.DBEditEh10KeyPress(Sender: TObject; var Key: Char);
begin
if not (key in['0'..'9',decimalseparator,#8]) then key:=#0;
end;

procedure TAfForm.DBEditEh5Change(Sender: TObject);
begin
if ( DBEditEh10.text<>'') and (DBEditEh5.text<>'')  then
begin
DBEditEh7.Text:=DBEditEh5.Value-DBEditEh10.Value;
DBEditEh3.Text:=DBEditEh7.Value*edit2.text;
DBEditEh8.Text:=inttostr( round((DBEditEh3.Value*edit1.text)/100+((DBEditEh3.Value*edit1.text)/100*0.44)));
if DBEditEh7.Value<0 then
   DBEditEh7.Color:=clred
   else
   DBEditEh7.Color:=clWhite;
end;
end;

