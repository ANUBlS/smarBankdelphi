package CM_InfoOfIntOutB;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Credits Manager VCL'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  Ehlib50,
  CMVCL50,
  DclEhlib50,
  doa40d5,
  CMOracleAPI,
  CM_COMMON;

contains
  InfoOutIntImpl in 'InfoOutIntImpl.pas' {InfOutIntDatMod: TDataModule},
  InfoOutIntUnit in 'InfoOutIntUnit.pas' {InfoOutIntMainForm},
  IntPaynentUnit in 'IntPaynentUnit.pas' {PaymentForm};

end.
