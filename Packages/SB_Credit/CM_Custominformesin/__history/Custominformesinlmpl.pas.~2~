    end;
  Sheet.cells[8+j,16]:=m16;

   aa:='V'+inttostr(8+j);
   Sheet.cells[8+j,13]:='= '+floattostr(orta)+'/'+aa;

  Sheet.cells[8+j,17]:=m17;
