uses   CommonDecls,CustDataMod,CMOracleApiDataModuleImpl;


procedure InitPlugin(s:string);export;
var
pesonid :integer;
begin

 with CustDataModu, person do
      begin
         if Active then Close;
         SetVariable('credid',Get_SelectedCrdID);
        Open;
       pesonid:=fieldbyname('personaltype').asinteger
      end;
    if pesonid=1 then
    begin
    Custominformesin.Button2.enabled:=true;
    Custominformesin.Button1.enabled:=false
    end
      else
    begin
     Custominformesin.Button1.enabled:=true;
     Custominformesin.Button2.enabled:=false;
    end;
   Custominformesin.ShowModal;
end;
exports
     InitPlugin;

procedure TCustominformesin.FormCreate(Sender: TObject);

begin

 CustDataModu:=TCustDataModu.create(self);
 DateTimePicker1.DateTime:= CustDataModu.sysdat.fieldbyname('tek_dat').AsDateTime;
 DateTimePicker2.DateTime:= CustDataModu.sysdat.fieldbyname('tek_dat').AsDateTime;

  
 end;

procedure TCustominformesin.FormDestroy(Sender: TObject);
begin
CustDataModu.UsrGrpDataSet.close;
CustDataModu.PersonelTypeDataSet.close;
end;

