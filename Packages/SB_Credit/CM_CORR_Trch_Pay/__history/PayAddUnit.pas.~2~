unit PayAddUnit;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  NLSLocalizer, StdCtrls, Buttons, ComCtrls;

type
  TPaymentAddForm = class(TForm)
    NLSLocalizer1: TNLSLocalizer;
    EditRest: TEdit;
    EditDueRest: TEdit;
    EditinterestRest: TEdit;
    EditDueinterestRest: TEdit;
    SpeedButton1: TSpeedButton;
    SpeedButton2: TSpeedButton;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    Label4: TLabel;
    DateTimePicker: TDateTimePicker;
    Label5: TLabel;
    procedure SpeedButton1Click(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure SpeedButton2Click(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  PaymentAddForm: TPaymentAddForm;

implementation

{$R *.DFM}
uses CorrectDatModImpl,CommonDecls,sbsystem;

procedure TPaymentAddForm.SpeedButton1Click(Sender: TObject);
var
   P_CrdID :integer;
   P_PayDate :TDateTime;
   P_Rest :Real;
   P_DueRest :Real;
   P_InterestRest :Real;
   P_DueInterestRest :Real;
begin
  P_CrdID := Get_SelectedCrdID;
  P_PayDate := integer(trunc(DateTimePicker.DateTime));
  P_Rest := StrToFloat(EditRest.Text);
  P_DueRest := StrToFloat(EditDueRest.Text);
  P_interestRest := StrToFloat(EditinterestRest.Text);
  P_DueInterestRest := StrToFloat(EditDueinterestRest.Text);

  with CorrectDatMod ,CM_CORR_TRCH_PAY ,Payments do
  begin
      CallProcedure('add_payments',[P_CrdID ,
                                    P_PayDate ,
                                    P_Rest ,
                                    P_interestRest ,
                                    P_DueRest ,
                                    P_DueInterestRest]);
     Refresh;                               
  end;

  Close;
end;

procedure TPaymentAddForm.FormKeyPress(Sender: TObject; var Key: Char);
begin
   if ord(Key) = VK_ESCAPE then Close;
end;

procedure TPaymentAddForm.SpeedButton2Click(Sender: TObject);
begin
   Close;
end;

procedure TPaymentAddForm.FormCreate(Sender: TObject);
begin
    DateTimePicker.DateTime := Get_CurrentDate;
    EditRest.Text := '0';
    EditDueRest.Text := '0';
    EditInterestRest.Text := '0';
    EditDueInterestRest.Text := '0';

end;

end.
