package CM_CORR_Trch_Pay;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,

  sboapi50,
  CMVCL50,

  doa41dxe,
  CM_COMMON;

contains
  CorrectDatModImpl in 'CorrectDatModImpl.pas' {CorrectDatMod: TDataModule},
  CorrectMainUnit in 'CorrectMainUnit.pas' {CorrectMainForm},
  Tranches_AddEditUnit in 'Tranches_AddEditUnit.pas' {Tranches_AddEditForm},
  EditTrUnit in 'EditTrUnit.pas' {EditTrForm},
  PayAddUnit in 'PayAddUnit.pas' {PaymentAddForm},
  PayEditUnit in 'PayEditUnit.pas' {PaymentEditForm};

end.
