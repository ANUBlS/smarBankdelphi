OracleDataSet1CREDITID.AsInteger:=CrdID ;

end;

procedure TYoneltmeFrm.OracleDataSet1ApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: string);
begin
OracleDataSet1CREDITID.AsInteger:=CrdID ;
end;

end.
