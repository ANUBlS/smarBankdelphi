procedure TBPMainForm.DBLookupComboboxEh1KeyValueChanged(Sender: TObject);
begin
 with (Sender as TDBLookupComboboxEh) do
 if DataSource.DataSet.Active then
 UpdateData;
end;

procedure TBPMainForm.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  with BPDataModule do
  begin
    BPData.CloseAll;
    CreditInfo.CloseAll;
  end;
end;

procedure TBPMainForm.Action1Execute(Sender: TObject);
begin
  OracleDataSet1.Insert;
end;

procedure TBPMainForm.Action2Execute(Sender: TObject);
begin
  //OracleDataSet1.SetVariable('CREDITID', Get_SelectedCrdID);
  OracleDataSet1.Post;
end;

procedure TBPMainForm.Action3Execute(Sender: TObject);
begin
  OracleDataSet1.Cancel;
end;

procedure TBPMainForm.Action4Execute(Sender: TObject);
begin
  Close
end;

procedure TBPMainForm.Action5Execute(Sender: TObject);
begin
  OracleDataSet1.Delete;
end;

procedure TBPMainForm.Action2Update(Sender: TObject);
begin
  if OracleDataSet1.Active then
  (Sender as TAction).Enabled := OracleDataSet1.Modified;
end;

procedure TBPMainForm.Action5Update(Sender: TObject);
begin
  (Sender as TAction).Enabled := OracleDataSet1.RecordCount > 0
end;

procedure TBPMainForm.OracleDataSet1AfterPost(DataSet: TDataSet);
var
  B : TBookmark;
begin
  with DataSet do
  begin
    B := GetBookmark;
    Refresh;
    GotoBookmark(B);
  end;
end;

procedure TBPMainForm.pcMainChange(Sender: TObject);
resourcestring
  rsLMCaption = '%s nömrəli müqavilə . Hüquqi tədbirlər';
  rsBPCaption = '%s nömrəli kredit üçün Biznes - Plan';
  rsGTCaption = '%s nömrəli kreditin Qrant texnikası';
var
  CrdID :Integer;
begin
  //ShowMessage(pcMain.ActivePage.Name);
  if pcMain.ActivePage = tsLM then begin
    CrdID := Get_SelectedCrdID;
    {Caption := Localizer.Caption;
    Localizer.Caption := Format(rsLMCaption,[Get_SelectedCrdNo]);
    }OracleDataSet2.Open;
    with OracleDataSet1 do begin
      if Active then CloseAll;
      //ClearVariables;
      SetVariable('CreditID',CrdID);
      Open;
    end;
    with CreditInfo do begin
      if Active then CloseAll;
      //ClearVariables;
      SetVariable('CreditID',CrdID);
      Open;
    end;
  end else
  if pcMain.ActivePage = tsBP then begin
    {Caption := Localizer.Caption;
    Localizer.Caption := Format(rsBPCaption,[Get_SelectedCrdNo]);
    }EditCrdNo.Text := Get_SelectedCrdNo;
    with BPDataModule do begin
      with CreditInfo do begin
        if Active then CloseAll;
        ClearVariables;
        SetVariable('CreditID',Get_SelectedCrdID);
        Open;
      end;
      with BPData do begin
        if Active then CloseAll;
        ClearVariables;
        SetVariable('CreditID',Get_SelectedCrdID);
        Open;
        Edit;
        if FieldByName('CreditID').IsNull then
          FieldByName('CreditID').AsInteger := Get_SelectedCrdID;

          
      end;
    end;
  end;
end;

procedure TBPMainForm.OracleDataSet1AfterInsert(DataSet: TDataSet);
begin
  OracleDataSet1.FieldByName('CreditID').AsInteger := Get_SelectedCrdID;
end;

