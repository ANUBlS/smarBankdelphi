procedure TBPMainForm.FormCreate(Sender: TObject);
var
  i : Integer;
begin
  BPDataModule := TBPDataModule.Create(Self);
  for i := 0 to ComponentCount-1 do
    if Components[i].Tag = 12 then
      (Components[i] as TDataSet).Open;
  pcMain.ActivePageIndex := 0;
end;

procedure TBPMainForm.FormDestroy(Sender: TObject);
begin
  BPDataModule.Free;
end;

procedure InitPlugin(S : String);export;
begin
  if S='BP' then
  BPMainForm.ShowModal
end;

procedure TBPMainForm.ActionSaveUpdate(Sender: TObject);
begin
  (Sender as TAction).Enabled := BPDataModule.BPData.Modified;
end;

procedure TBPMainForm.ActionSaveExecute(Sender: TObject);
begin
if DBLookupComboboxEh1.KeyValue =null then
begin
CMHintBox1.ShowMessage('Dövür sahəsi boşdur !') ;
exit;
end;
if DBLookupComboboxEh9.KeyValue =null then
begin
CMHintBox1.ShowMessage('Qərar sahəsi boşdur !') ;
exit;
end;
if DBLookupComboboxEh4.KeyValue =null then
begin
CMHintBox1.ShowMessage('RAyon sahəsi boşdur !') ;
exit;
end;
if DBLookupComboboxEh5.KeyValue =null then
begin
CMHintBox1.ShowMessage('Kənt sahəsi boşdur !') ;
exit;
end;

if DBLookupComboboxEh5.KeyValue =null then
begin
CMHintBox1.ShowMessage('Məhsulun tipi sahəsi boşdur !') ;
exit;
end;
  with BPDataModule.BPData do
  Post;
end;

procedure TBPMainForm.ActionDismisExecute(Sender: TObject);
begin
  with BPDataModule.BPData do
  Cancel;
  Close;
end;

procedure TBPMainForm.FormShow(Sender: TObject);
resourcestring
  rsFormCaption = '%s Nömrəli kredit haqqında məlumat';
var
  CrdID: Integer;
  Temp : Integer;
begin
  Caption := Format(rsFormCaption,[Get_SelectedCrdNo]);
  EditCrdNo.Text := Get_SelectedCrdNo;
  edCreditNo.Text := Get_SelectedCrdNo;

  CrdID := Get_SelectedCrdID;
    {Caption := Localizer.Caption;
    Localizer.Caption := Format(rsLMCaption,[Get_SelectedCrdNo]);
    }OracleDataSet2.Open;
    with OracleDataSet1 do begin
      if Active then CloseAll;
      //ClearVariables;
      SetVariable('CreditID',CrdID);
      Open;
    end;
    with CreditInfo do begin
      if Active then CloseAll;
      //ClearVariables;
      SetVariable('CreditID',CrdID);
      Open;
    end;

  with BPDataModule do
  begin

    with CreditInfo do
    begin
      if Active then CloseAll;
      ClearVariables;
      SetVariable('CreditID',Get_SelectedCrdID);
      Open;
    end;

    with PortInf do
    begin
      if Active then CloseAll;
      ClearVariables;
      SetVariable('CreditID',Get_SelectedCrdID);
      Open;
    end;

    pcMain.Pages[2].Enabled := PortInfPROJECTID.AsInteger = 3;
//    showmessage(IntTostr(PortInfPROJECTID.AsInteger));

    with GTMachinesDataSet do begin
      if Active then CloseAll;
        ClearVariables;
        SetVariable('CreditID',Get_SelectedCrdID);
        Open;
        Edit;
        if FieldByName('CreditID').IsNull then
          FieldByName('CreditID').AsInteger := Get_SelectedCrdID;
    end;

    with BPData do
    begin
      if Active then CloseAll;
      ClearVariables;
      SetVariable('CreditID',Get_SelectedCrdID);
      Open;
      Edit;
      if FieldByName('CreditID').IsNull then
        FieldByName('CreditID').AsInteger := Get_SelectedCrdID;

      if not FieldByName('VillageID').IsNull then begin
        DBLookupComboboxEh4.KeyValue :=
          CM_AKF.CallIntegerFunction('BPCreditDistrictID', [Get_SelectedCrdID]);
        Temp :=FieldByName('VILLAGEID').Value;
        DBLookupComboboxEh5.KeyValue := Null;
        DBLookupComboboxEh5.KeyValue := Temp;
      end;

      if not FieldByName('AKPURPOSE').IsNull then begin
        DBLookupComboboxEh6.KeyValue :=
          CM_AKF.CallIntegerFunction('BPCreditAKTargetID', [Get_SelectedCrdID]);

        Temp := FieldByName('AKPURPOSE').Value;
        DBLookupComboboxEh7.KeyValue := Null;
        DBLookupComboboxEh7.KeyValue := Temp;
      end;
    end;

  end;
end;

