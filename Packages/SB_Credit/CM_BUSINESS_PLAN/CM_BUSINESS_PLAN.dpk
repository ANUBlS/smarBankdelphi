package CM_BUSINESS_PLAN;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM_BUSINESS_PLAN'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  CM_COMMON,
  sboapi50,
  CMVCL50,
  doa41dxe,
  SBTranslate;

contains
  BPDataModuleImpl in 'BPDataModuleImpl.pas' {BPDataModule: TDataModule},
  BPMainFormImpl in 'BPMainFormImpl.pas' {BPMainForm},
  BPLoader in 'BPLoader.pas',
  YoneltmeImpl in 'YoneltmeImpl.pas' {YoneltmeFrm};

end.
