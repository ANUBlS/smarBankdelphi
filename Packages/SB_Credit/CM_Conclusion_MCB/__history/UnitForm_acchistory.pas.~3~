procedure TForm_acchistory.Button1Click(Sender: TObject);
begin
with ods_archost do
begin
close;
     SetVariable('accid',v_accid);
     SetVariable('dat1',trunc(StartDateEdit.DateTime));
     SetVariable('dat2',trunc(EndDateEdit.DateTime));
open;
end;
end;

procedure TForm_acchistory.Button2Click(Sender: TObject);
begin
 with MisExcelExport do
  begin
     Connect;
     ExportDataset(ods_archost,'Qaliq',true,false);
     Disconnect;

  end;
end;

