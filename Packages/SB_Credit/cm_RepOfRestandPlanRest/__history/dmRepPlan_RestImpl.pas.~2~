implementation

{$R *.DFM}
uses SboApiDataModuleImpl;

procedure TdmRepPlan_Rest.DataModuleCreate(Sender: TObject);
begin
ODFValute.open;
ODFReserves.open;
ODFPersons.open;
ODFPledges.open;
ODFBranch .open;
ODFCategories .open;
ODFCustomers.open;
ODFUsrGroup .open;
ODFUsers.open;
ODFCrdTypes  .open;
end;

procedure TdmRepPlan_Rest.DataModuleDestroy(Sender: TObject);
begin
  ODFValute.closeall;
  ODFReserves.closeall;
  ODFPersons.closeall;
  ODFPledges.closeall;
  ODFBranch.closeall;
  ODFCategories.closeall;
  ODFCustomers.closeall;
  ODFUsrGroup.closeall;
  ODFUsers.closeall;
  ODFCrdTypes .closeall;
end;

end.
