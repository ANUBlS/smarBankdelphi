procedure TFormN3SD.SpeedButton1Click(Sender: TObject);
var bdate,edate :TDateTime;rcount :integer;
begin
 ProgressBar.Visible:=true;
  bdate := BeginDate.DateTime;
  edate := EndDate.DateTime;
  with DatModN3SD.Crdinfo do
  begin
    Filtered := False;
    Filter := BuildFilterString;
    Filtered := True;

      Session.Commit;
      Rcount := RecordCount;

      with ProgressBar do
      begin
     // Visible:=true;
      Position := 0;
      Max := Rcount;
      Step := 1;
      end;

   //  FormProgress.Show;
   //  FormProgress.Update;
     Self.Update;
     First;

      LogInformation('Ихраж башлады',true);
    while not EOF do
    begin
    //  LogInformation(inttostr(FieldByName('ID').AsInteger),true);
      DatModN3SD.CM_N3_SD.CallProcedure('pn3_sdf',[
                                                  'p_creditid',FieldByName('ID').AsInteger,
                                                  'p_bdate',bdate,
                                                  'p_edate',edate
                                                  ]);
     ProgressBar.Position := RecNo + 1;
   
     Next;
    end;
   ProgressBar. Visible:=false;
   LogInformation('Ихраж гуртарды',true);
  end;

 // FormProgress.Close;

 with DatModN3SD do
 begin
   N3SDDataSet.CloseAll;
   N3SDDataSet.Open;

    with ExcelExport do
    begin
       Connect;
       ExportDataset(N3SDDataSet,'Н3-СД',true);
       Disconnect;
    end;                 
 end;

end;

