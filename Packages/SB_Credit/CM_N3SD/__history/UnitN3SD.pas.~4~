function TFormN3SD.BuildFilterString : String;

  procedure ConcatFilter(var S: String; const Prefix : String; Checked : Boolean; KeyValue : Variant);
  const
     csFormat = '(%s=%s)';
  var
    Temp : String;
  begin

    if Checked then
    begin
      Temp := Format(csFormat,[Prefix,Keyvalue]);
      if S = '' then
        S := Temp
      else
        S :=S + 'AND ' + Temp;
    end;
    
  end;
begin

  Result := '';
  ConcatFilter(Result,'CUSTOMERTYPE',CheckBoxCust.Checked,DBLookupComboboxEhCust.KeyValue);
  ConcatFilter(Result,'BRANCHID',CheckBoxBr.Checked,DBLookupComboboxEhBr.KeyValue);
  ConcatFilter(Result,'VILLAGEID',CheckBoxReg.Checked,DBLookupComboboxEhReg.KeyValue);
  ConcatFilter(Result,'VID_SOB',CheckBoxvid.Checked,DBLookupComboboxEhVid.KeyValue);

end;

