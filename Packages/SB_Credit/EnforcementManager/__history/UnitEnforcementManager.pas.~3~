procedure TEnforcementManager.SpeedButton2Click(Sender: TObject);
begin
  PanelFilter.Visible := not PanelFilter.Visible;

  if( SpeedButton2.AllowAllUp ) then
  begin
    SpeedButton2.AllowAllUp := False;
    SpeedButton2.Down := True;
  end else
  begin
    SpeedButton2.AllowAllUp := True;
    SpeedButton2.Down := False;
  end;
  DBLExecutive.KeyValue:=-1;
  DBLCourt.KeyValue:=-1;
end;

procedure TEnforcementManager.SpeedButton5Click(Sender: TObject);
