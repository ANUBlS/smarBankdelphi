procedure TNewaccount.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  with DataModuleConcl do begin
      if OracleDataSet3.Active then
     OracleDataSet3.close;
     OracleDataSet3.SetVariable('custid',Customer.FieldByName('ID').Asinteger);
     OracleDataSet3.Open;
  end;
end;

procedure TNewaccount.FormShow(Sender: TObject);
var
  i: Integer;
begin
  for i := 0 to ComponentCount - 1 do
    if Components[i].Tag = 3112 then begin
      (Components[i] as TEvanescence).Open;
      (Components[i] as TEvanescence).CheckAll;
    end;

end;

