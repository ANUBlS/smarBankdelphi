package CU_Conclusion;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Adding And Editing Contract'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  doa41dxe,
  sboapi50,
  CMVCL50,
  CU_COMMON,
  SBTranslate;

contains
  CUDataModuleConclusion in 'CUDataModuleConclusion.pas' {CUDataModuleConcl: TDataModule},
  CUConclusionMainUnitImpl in 'CUConclusionMainUnitImpl.pas' {ConclusionForm},
  CUConclusionCommonDecls in 'CUConclusionCommonDecls.pas',
  CUCreateCMAccountsImpl in 'CUCreateCMAccountsImpl.pas' {FormCreateCMAccounts},
  CULoanBalAccsUnit in 'CULoanBalAccsUnit.pas' {FormLoanBalance},
  CUNewaccountimpl in 'CUNewaccountimpl.pas' {Newaccount},
  CUFrmDepozitImpl in 'CUFrmDepozitImpl.pas' {FrmDepozit};

end.
