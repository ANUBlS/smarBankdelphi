package CM_PaymentScheduleRep;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  CMOracleAPI,
  CMVCL50,
  DclEhlib50,
  doa40d5,
  Ehlib50,
  CM_COMMON,
  Vclbde50,
  Qrpt50;

contains
  repAnnutyPaymentFormImpl in 'repAnnutyPaymentFormImpl.pas' {AnnutyForm},
  repChangeScheduleImpl in 'repChangeScheduleImpl.pas' {FrmChangeSchedule},
  repfrmReport in 'repfrmReport.pas' {frmRep},
  repfrmReportTypeImpl in 'repfrmReportTypeImpl.pas' {frmReportType},
  repReportImpl in 'repReportImpl.pas' {ReportForm},
  repScheduleDataModuleImpl in 'repScheduleDataModuleImpl.pas' {ScheduleDataModule: TDataModule},
  repScheduleLoaderImpl in 'repScheduleLoaderImpl.pas',
  repScheduleMainFormImpl in 'repScheduleMainFormImpl.pas' {ScheduleForm},
  repSheduleAddUnt in 'repSheduleAddUnt.pas' {AddEditForm};

end.
