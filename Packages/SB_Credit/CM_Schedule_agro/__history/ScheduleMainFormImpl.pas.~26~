procedure TScheduleForm.ActionSaveExecute(Sender: TObject);
begin
  with ScheduleDataModule, ScheduleData.Session do
  begin
    ApplyUpdates([ScheduleData],True);
    Commit;
  end;
end;

procedure TScheduleForm.ActionSaveUpdate(Sender: TObject);
