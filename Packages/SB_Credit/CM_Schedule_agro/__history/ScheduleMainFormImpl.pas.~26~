procedure  TScheduleForm.ShowPaymentSchedule;

resourcestring
  rsScheludeCaption = '%s № li müqavilə üçün ödəmə planı.';
  
begin

  ScheduleDataModule := TScheduleDataModule.Create(Self);
  frmReportType := TfrmReportType.Create(Self);
  ReportForm := TReportForm.create(self);
  AddEditForm := TAddEditForm.Create(Self);
  AnnutyForm := TAnnutyForm.Create(Self);
  FrmChangeSchedule := TFrmChangeSchedule.Create(Self);


  Caption := Format(rsScheludeCaption,[Get_SelectedCrdNo]);
  CreditID := Get_SelectedCrdID;

  with ScheduleDataModule do
  begin
    with ScheduleData do
    begin
      ClearVariables;
      SetVariable('CreditID',CreditID);
      Open
    end;
    with BoorowerInfo do
    begin
      ClearVariables;
      SetVariable('CreditID',CreditID);
      Open    ;
       ReportForm.QRLabel9.caption := BoorowerInfoNAME.AsString+' ______________________';

    end;
    with CreditInfo do
    begin
      ClearVariables;
      SetVariable('ID',CreditID);
      Open
    end;

    with   BankInfo do
    begin
      close;
      SetVariable('v_fil',CreditInfoBRANCHID.AsInteger);
      open ;

        ReportForm.QRLabel8.caption :=' ______________________'+BankInfoSEDRFIL.asstring ;

    end;






  {   HeadOfficeID.open;

          if FilialInfo.Active then FilialInfo.CloseAll;
          FilialInfo.SetVariable('brid',CreditInfo.FieldByName('BranchID').AsInteger);
          FilialInfo.Open;



         if FilialInfo.FieldByName('ID').AsInteger = HeadOfficeID.FieldbyName('minid').AsInteger then
           ReportForm.QRLabel10.caption := 'Müştəri xidmətləri departamentinin direktoru______________________________'
         else
           ReportForm.QRLabel10.caption := 'Filial direktoru                                                         ______________________________';
       }
  end;
  
  ShowModal;
end;



