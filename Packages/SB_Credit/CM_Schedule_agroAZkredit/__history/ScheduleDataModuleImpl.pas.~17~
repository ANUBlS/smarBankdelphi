procedure TScheduleDataModule.ScheduleData_reportCalcFields(DataSet: TDataSet);
begin
with DataSet do
  FieldByName('TOTALPAY').AsFloat := FieldByName('PRINCIPAL').AsFloat + FieldByName('INTEREST').AsFloat;
end;

procedure TScheduleDataModule.ScheduleData_reportSeqNoGetText(Sender: TField;
  var Text: String; DisplayText: Boolean);
begin
  Text := IntToStr(Sender.DataSet.RecNo);
end;

procedure TScheduleDataModule.ScheduleDataApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: string);
var
  ID, CreditID : Integer;
  PayDate : TDateTime;
  Principial, Interest : Real;
begin
  Applied := True;
  with Sender do
  begin
    ID := FieldByName('ID').AsInteger;
    CreditID := FieldByName('CreditID').AsInteger;
    PayDate := FieldByName('PaymentDate').AsDateTime;
    Principial := FieldByName('PRINCIPAL').AsFloat;
    Interest := FieldByName('Interest').AsFloat;
  end;
//  LogInformation('Apply Record');
  case Action of
    'I','U' :
       with  CM_SCHEDULE do
       ID :=
       CallIntegerFunction('PaymentSchedule_AddEdit',[
         'p_ID' , ID ,
         'p_CreditID' , CreditID ,
         'p_PayDate' , PayDate ,
         'p_Principial' , Principial ,
         'p_Interest' , Interest
       ]);
    'D' :
       with  CM_SCHEDULE do
       CallProcedure('PaymentSchedule_Delete',['p_ID',ID]);
  else
    Applied := False;
  end; // Case

end;

