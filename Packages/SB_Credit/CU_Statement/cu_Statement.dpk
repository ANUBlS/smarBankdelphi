package Cu_Statement;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Statement'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  Cu_COMMON,
  CMVCL50,
  doa41dXE,
  dclbde,
  SBTranslate,
  QR5RunDXE;

contains
   CUStatementDataModule in 'CUStatementDataModule.pas' {StatementDataMod: TDataModule},
   CUStatementMainFormImpl in 'CUStatementMainFormImpl.pas' {CrdStatementMainForm},
   cuRestsHistoryImpl in 'cuRestsHistoryImpl.pas' {RestForm},
   cuInterestshistoryImpl in 'cuInterestshistoryImpl.pas' {InterestsForm},
   cuRepUnit in 'cuRepUnit.pas' {ReportForm},
   CUReportsheduleUnit in 'CUReportsheduleUnit.pas' {ReportSheduleForm};

end.
