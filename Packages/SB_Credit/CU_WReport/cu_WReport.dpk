package CU_WReport;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM MIS'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  CU_COMMON,
  sboapi50,
  SBCommon50;

contains
  CUAgreeUnit in 'CUAgreeUnit.pas' {AgreeForm},
  CUAgreeDataModImplUnit in 'CUAgreeDataModImplUnit.pas' {AgreeDataModule: TDataModule},
  CUWRRepLoader in 'CUWRRepLoader.pas',
  CUCurrencyToHR_AzeriAbo_Impl in 'CUCurrencyToHR_AzeriAbo_Impl.pas';

end.
