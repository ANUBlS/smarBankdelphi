procedure TFormContractAccounts.XFBitBtn1Click(Sender: TObject);
var
    boorowerid,
    booroweraccid,
    loanaccid,
    dueloanaccid,
    interestaccid ,
    dueinterestaccid,
    primaryreserveaccid ,
    secondaryreserveaccid,
    secondarypurreserveaccid ,
    primarypurreserveaccid,
                  Loanid,Presid,intid,custid :integer;
begin
   with CCDataMod,Accounts, CM_CREDIT do
   begin
    boorowerid              := fieldbyname('BOOROWERID').AsInteger;
    booroweraccid           := fieldbyname('BOOROWERAccID').AsInteger;
    loanaccid                := fieldbyname('loanaccid').AsInteger;
    dueloanaccid             := fieldbyname('dueloanaccid').AsInteger;
    interestaccid            := fieldbyname('interestaccid').AsInteger;
    dueinterestaccid         := fieldbyname('dueinterestaccid').AsInteger;
    primaryreserveaccid      := fieldbyname('primaryreserveaccid').AsInteger;
    secondaryreserveaccid    := fieldbyname('secondaryreserveaccid').AsInteger;
    secondarypurreserveaccid := fieldbyname('secondarypurreserveaccid').AsInteger;
    primarypurreserveaccid   := fieldbyname('primarypurreserveaccid').AsInteger;

    CallProcedure('CloseCont_Account',[  'p_id',boorowerid,
                                           'defCA',XFCheckBox1.Checked]);
     CallProcedure('CloseCont_Account',[  'p_id',booroweraccid,
                                           'defCA',XFCheckBox2.Checked]);
     CallProcedure('CloseCont_Account',[  'p_id',loanaccid,
                                           'defCA',XFCheckBox3.Checked]);
     CallProcedure('CloseCont_Account',[  'p_id',dueloanaccid,
                                           'defCA',XFCheckBox4.Checked]);
     CallProcedure('CloseCont_Account',[  'p_id',interestaccid,
                                           'defCA',XFCheckBox5.Checked]);
     CallProcedure('CloseCont_Account',[  'p_id',dueinterestaccid,
                                           'defCA',XFCheckBox6.Checked]);
     CallProcedure('CloseCont_Account',[  'p_id',primaryreserveaccid,
                                           'defCA',XFCheckBox7.Checked]);
     CallProcedure('CloseCont_Account',[  'p_id',secondaryreserveaccid,
                                           'defCA',XFCheckBox8.Checked]);
     CallProcedure('CloseCont_Account',[  'p_id',secondarypurreserveaccid,
                                           'defCA',XFCheckBox9.Checked]);
     CallProcedure('CloseCont_Account',[  'p_id',primarypurreserveaccid,
                                           'defCA',XFCheckBox10.Checked]);
     CallProcedure('CloseCont_Customers',[ 'p_id',custid,
                                            'defCA',XFCheckBox1.Checked]);
      CloseAll;
   end;
end;


