package CM_CreditControl;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Control'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CMVCL50,
  doa41dxe,
  CM_COMMON,
  VCLXFiles150;

contains
  CCDataModuleImpl in 'CCDataModuleImpl.pas' {CCDataMod: TDataModule},
  CCLoaderImpl in 'CCLoaderImpl.pas',
  CCAccountImpl in 'CCAccountImpl.pas' {FormContractAccounts};

end.
