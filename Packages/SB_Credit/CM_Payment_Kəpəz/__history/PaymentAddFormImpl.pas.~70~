  IntAmt  := IntAmtEdit.Value;
  DueAmt  := DueAmtEdit.Value;
  DueIntAmt := DueIntAmtEdit.Value;
  PenaltyAmt := PenaltyAmtEdit.Value;
  BkIntAmt:=CMCurrencyEdit1.value;
  f:=MainAmt+ IntAmt+PenaltyAmt +BkIntAmt+DueIntAmt-0.01;
 if PaymentDataModule.PaymentAccounts.FieldByName('rest').AsFloat<f then
  begin
   ShowMessage(' Ödənişlərin cəmi  cari hesabın qalığından cox ola bilmez !');
   exit;
  end;
 {NBC  if (PaymentDataModule.PortfInfo.FieldByName('qovid').AsInteger=4)and (FullPayAmt.Value>(CMCurrencyEdit3.Value+CMCurrencyEdit4.Value+CMCurrencyEdit5.Value)) then
  begin
   ShowMessage(' Ödənişlərin cəmi  qətnamə  qalığından cox ola bilmez !');
   exit;
  end; }

 {    if MainAmt>faktatm then
   begin
         SheduleReplace.Rest.Value:=DBEditEh4.value-MainAmt;
         SheduleReplace.showmodal;
   end;
   if a=1 then
   exit;    }
   cusb:=0;
   with PaymentDataModule do
   begin
   if PortfInfo.FieldByName('credittype').AsInteger=1555 then
   begin
   if ODS_CUST_COMBİNED.Active then
    ODS_CUST_COMBİNED.Close;
    ODS_CUST_COMBİNED.SetVariable('creditid',CrdID);
    ODS_CUST_COMBİNED.open;
    Form1.ShowModal;
    if (cusb=0) and(ODS_CUST_COMBİNED.RecordCount>0) then
     begin
     ShowMessage('Birgə borcalanı seçməmisiniz !');
     exit;
     end;
    end;
    CM_PAYMENT.CallProcedure('PaymentAdd',[
    'p_CreditID', CrdID,
    'p_Date', Date,
    'p_CustAccID', CustAccID,
    'P_PenaltyAccID',PenaltyAccID,
    'p_MainDebt', MainAmt,
    'p_MainInterest', IntAmt,
    'p_DueDebt', DueAmt,
    'p_DueInterest', DueIntAmt,
    'P_PenaltyRest',PenaltyAmt,
    'p_ProcessTransactions', TrProcess,
    'p_fullpayment',CBFullPay.checked,
    'p_changeplandate',ChBchangePlandat.checked,
    'p_bkint',BkIntAmt {,
    'p_cusb',cusb    }
  ]);

  end;

  try

    CommitTranche := TrDelayed_Show(Self,rsTransactionsWillProcessed);

    Self.Update;

    with PaymentDataModule do
    CM_PAYMENT.CallProcedure('CommitPayment',[
       'DoCommit' , CommitTranche
    ]);

    if CommitTranche then
    Self.ModalResult := mrOk;

    Self.Update;

  except

    with PaymentDataModule do
    CM_PAYMENT.CallProcedure('CommitPayment',[
       'DoCommit' , False
    ]);

    raise;

  end;

end;

