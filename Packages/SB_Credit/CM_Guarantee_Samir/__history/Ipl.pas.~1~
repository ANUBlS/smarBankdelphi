procedure TLombarForm.Button1Click(Sender: TObject);
var
count: integer;
begin
if (DBLookupComboboxEh1.Text='') or(DBLookupComboboxEh1.KeyValue=-1)or(DBEditEh5.Text='') then
    begin
         showmessage(' Məlumat tam doldurulmayıb  !');
    exit;
    end;


if GurDm.MainDSet.FieldByName('cardid').AsInteger=0 then
    count:=1
    else
    count:=GurDm.MainDSet.FieldByName('cardid').AsInteger ;

GurDm.Guarante.CallProcedure('Guarantee_AddGold' ,
                              [Get_SelectedCrdID,
                               count,
                               DBEditEh1.Text,
                               DBLookupComboboxEh1.Value,
                               edit1.Text,
                               Edit2.Text,
                               DBEditEh6.Text,
                               DBEditEh3.Text,
                               DBEditEh8.Text,
                               DBEditEh4.Text,
                               DBEditEh5.Text,
                               DBEditEh10.Text,
                               DBEditEh7.Text,
                               Memo1.Text,
                               Edit3.Text]);

ods_gold.Close;
ods_gold.SetVariable('v_crid',Get_SelectedCrdID);
ods_gold.SetVariable('v_cardid',count);
ods_gold.Open;
              FormClear(Sender);

end;

