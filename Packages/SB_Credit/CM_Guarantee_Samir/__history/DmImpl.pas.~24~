procedure TGurDm.BAliDSetAfterOpen(DataSet: TDataSet);
var index: integer;
begin
   with DataSet, FrmGuarante.Panel do
begin
    Tabs.Clear;
    for Index := 0 to RecordCount-1 do
      Tabs.Add(Format('Zamin ¹%d ', [Index]));
    if recordcount=0 then tabs.Add ((Format('Zamin ¹%d ', [0]))) ;
    First;
  end;


end;

