   DBEditEh10.Value:=0;
   DBEditEh5.Enabled:=false;
   DBEditEh10.Enabled:=false;
end;

procedure TAfForm.Button1Click(Sender: TObject);
var
count: integer;
begin
  showmessage(GurDm.MainDSet.FieldByName('cardid').AsString);
if GurDm.MainDSet.FieldByName('cardid').AsInteger=0 then
    count:=1
    else
    count:=GurDm.MainDSet.FieldByName('cardid').AsInteger ;

GurDm.Guarante.CallProcedure('Guarantee_AddGold' ,
                              [Get_SelectedCrdID,
                               count,
                               DBEditEh1.Text,
                               DBLookupComboboxEh1.Value,
                               edit1.Text,
                               Edit2.Text,
                               DBEditEh6.Text,
                               DBEditEh3.Text,
                               DBEditEh8.Text,
                               DBEditEh4.Text,
                               DBEditEh5.Text,
                               DBEditEh10.Text,
                               DBEditEh7.Text,
                               Memo1.Text,
                               Edit3.Text]);
              ods_gold.Refresh;
              FormClear(Sender);

end;

