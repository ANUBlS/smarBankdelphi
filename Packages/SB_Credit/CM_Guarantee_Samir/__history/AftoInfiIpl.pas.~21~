  procedure TAfForm.FormClear(Sender: TObject);
begin
   DBEditEh1.Clear;
   DBLookupComboboxEh1.Value:=-1;
   edit1.Clear;
   Edit2.Clear;
   DBEditEh6.Clear;
   DBEditEh3.Clear;
