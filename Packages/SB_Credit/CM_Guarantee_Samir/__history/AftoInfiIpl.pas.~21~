procedure TAfForm.DBLookupComboboxEh1CloseUp(Sender: TObject; Accept: Boolean);
begin
  DBEditEh5.Enabled:=true;
  DBEditEh10.Enabled:=true;
  Edit1.Text:=Ods_goldstandartPERCENT.AsString;
  Edit2.Text:=Ods_goldstandartPRICE.AsString;

  if DBEditEh7.Text<>'' then
  begin
  DBEditEh3.Text:=DBEditEh7.Value*edit2.text;
  DBEditEh8.Text:=inttostr( round((DBEditEh3.Value*edit1.text)/100+((DBEditEh3.Value*edit1.text)/100*0.44)));
  end;
end;

