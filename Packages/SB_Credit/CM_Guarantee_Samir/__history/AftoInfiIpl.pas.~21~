procedure TAfForm.FormShow(Sender: TObject);
begin
 DBEditEh5.Enabled:=false;
  DBEditEh10.Enabled:=false;

ods_gold.Close;
ods_gold.SetVariable('v_crid',Get_SelectedCrdID);
ods_gold.SetVariable('v_cardid',GurDm.MainDSet.FieldByName('cardid').AsInteger);
ods_gold.Open;

ods_avto_qizl.Close;
