package Cm_AutoReserve_Settings;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  CM_COMMON,
  sboapi50,
  CMVCL50,
  doa41dXE,
  VCLXFiles150;

contains
  ResSettingImpl in 'ResSettingImpl.pas' {FrmResSetting},
  TesFrmImpl in 'TesFrmImpl.pas' {AddTesFrm},
  RsAccFormImpl in 'RsAccFormImpl.pas' {RsAccForm};

end.
