{$R *.DFM}

uses
  CMOracleAPIDataModuleImpl;



procedure TWRSetupDataMod.WRBookmarksDataSetApplyRecord(
  Sender: TOracleDataSet; Action: Char; var Applied: Boolean;
  var NewRowId: String);
var  id, stemplid,sfieldid:integer; sbookmarkname:string;
begin
   with Sender do
      begin
         stemplid:=FieldByName('Templateid').Asinteger;
         sfieldid:=FieldByName('Fieldid').Asinteger;
         Sbookmarkname:=FieldByName('Bookmarkname').Asstring;
         id:=FieldByName('id').Asinteger;
      end;

   Case  Action of

   'I':  CM_WR_TOOLS.CallProcedure('AddBookmark',[
            stemplid,
            sfieldid,
            sbookmarkname]);

   'D':  CM_WR_TOOLS.CallProcedure('DeleteBookmark',[id]);

   'U':  CM_WR_TOOLS.CallProcedure('updateBookmark',[
            id,
            sbookmarkname,
            stemplid,
            sfieldid]);
        end;
        Applied:=true;
end;


procedure TWRSetupDataMod.WRTemplatesDataSetApplyRecord(
  Sender: TOracleDataSet; Action: Char; var Applied: Boolean;
  var NewRowId: String);
var
  SName , SPath : String;templid:integer;
begin

    with Sender do
        begin
          SName := FieldByName('NAME').AsString;
          SPath := FieldByName('PATH').AsString;
          templid:=FieldByName('ID').AsInteger;
        end;
  case Action of

  'I' : CM_WR_TOOLS.CallProcedure('AddTemplate',[
           SName ,
           SPath
         ]);

  'D' : CM_WR_TOOLS.CallProcedure('DeleteTemplate',[templid]);

  'U' : CM_WR_TOOLS.CallProcedure('UpdateTemplates',[
            templid,
            sname,
             spath
           ]);
   end;
 Applied:=true;

end;

end.
