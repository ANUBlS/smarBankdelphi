 function TPayForm.BuildFilterString : String;

  procedure ConcatFilter(var S: String; const Prefix : String; Checked : Boolean; KeyValue : Variant);
  const
     csFormat = '(%s=%s)';
  var
    Temp : String;
  begin

    if Checked then
    begin
      Temp := Format(csFormat,[Prefix,Keyvalue]);
      if S = '' then
        S := Temp
      else
        S :=S + 'AND ' + Temp;
    end;

  end;
begin
  Result := '';
  ConcatFilter(Result,'Credittype',CheckBox1.Checked,DBLookupComboboxEh7.KeyValue);
  ConcatFilter(Result,'USRGROUP',CheckBox2.Checked,DBLookupComboboxEh1.KeyValue);
  //LogInformation(Result);
end;
