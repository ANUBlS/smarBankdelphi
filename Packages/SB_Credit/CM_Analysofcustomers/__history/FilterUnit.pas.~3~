function TFilterForm.FilterString:String;
var scurrency,sbranchid,spersons,sandpersons ,
    susers,sandusers,sandcustomertype,scustomertype,
    sandcredittype, screditType,susergroup,sandusergroup,
    scustomer,sandcustomer: String; mass :massiv; i:integer;

function F_Ev(Const cs :string; Checked :Boolean; Ev :TEvanescence):String;
var s,s1 :string;
 i :integer;

begin
   s:='';S1:='';
   if Checked then
   begin
     for i :=0 to Ev.GetCheckedKeyList.Count - 1 do
      begin
         s1 := '('+cs+'='+Ev.GetCheckedKeyList[I]+')';
         if s ='' then s :=s1 else s := s+' or '+s1;
       end;
      Result :=s;
   end
   else Result :='';
end;

function F_LCOMB(Const cs,cd :string; Checked :Boolean; Comb :TDBLookupComboboxEh):String;
var Kv :string;
begin
  if Checked then
  begin
     Kv := String(Comb.KeyValue);
     Result := cd+'('+cs+'='+Kv+')';
  end
  else Result :='';
end;

begin

   sandpersons := F_LCOMB('PERSONALTYPE','AND',CheckBoxPersons.Checked,DBLookupComEhPersons);
   spersons := F_LCOMB('PERSONALTYPE','',CheckBoxPersons.Checked,DBLookupComEhPersons);
   sandusers := F_LCOMB('USID','AND',CheckBoxUsers.Checked,DBLookupComEhUsers);
   susers := F_LCOMB('USID','',CheckBoxUsers.Checked,DBLookupComEhUsers);
   sandusergroup := F_LCOMB('USRGROUP','AND',CheckBoxUsersgroup.Checked,DBLookupComEhUsersGroup);
   susergroup := F_LCOMB('USRGROUP','',CheckBoxUsersgroup.Checked,DBLookupComEhUsersGroup);
   sandcustomerType := F_LCOMB('CUSTOMERTYPE','AND',CheckBoxCategories.Checked,DBLookupComEhCategories);
   scustomerType := F_LCOMB('CUSTOMERTYPE','',CheckBoxCategories.Checked,DBLookupComEhCategories);
   sandcreditType := F_LCOMB('CREDITTYPE','AND',CheckBoxCreditType.Checked,DBLookupComEhCredittype);
   screditType := F_LCOMB('CREDITTYPE','',CheckBoxCreditType.Checked,DBLookupComEhCredittype);
   sandcustomer := F_LCOMB('BOOROWERID','AND',CheckBoxCustomer.Checked,DBLookupComEhCustomer);
   scustomer := F_LCOMB('BOOROWERID','',CheckBoxCustomer.Checked,DBLookupComEhCustomer);
   scurrency := F_Ev('CURRENCY',CheckBoxValute.Checked,EvanescenceValute);
   sbranchid := F_Ev('BRANCHID',CheckBoxFilial.Checked,EvanescenceFilial);

   IF (scurrency <>'')and(sbranchid <> '') then
   Result :=scurrency+'and'+sbranchid+sandpersons+sandusers+sandcustomertype+
   sandcredittype+sandusergroup+sandcustomer;

   IF (scurrency <>'')and(sbranchid = '') then
   Result :=scurrency+sandpersons+sandusers+sandcustomertype+
   sandcredittype+sandusergroup+sandcustomer;

   IF (scurrency ='')and(sbranchid <> '') then
   Result :=sbranchid+sandpersons+sandusers+sandcustomertype+
   sandcredittype+sandusergroup+sandcustomer;

   mass[1] := spersons;
   mass[2] := susers;
   mass[3] := scustomertype;
   mass[4] := scredittype;
   mass[5] := susergroup;
   mass[6] := scustomer;


   IF (scurrency ='')and(sbranchid = '') then
   begin
      Result :='';
      for i := 1 to 6 do
      if mass[i] <> '' then
      begin
        if Result = '' then Result := mass[i]
        else Result := Result+' and '+mass[i]
      end;
   end;

 //  ShowMessage(Result);
end;


