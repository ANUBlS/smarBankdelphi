package CM_Expire;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'ContMgr Expire Control Package'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  sboapi50,
  CM_COMMON,
  CMVCL50,
  doa41dXE;

contains
  ExpireDataModuleImpl in 'ExpireDataModuleImpl.pas' {ExpireDataModule: TDataModule},
  ExpireMainFormImpl in 'ExpireMainFormImpl.pas' {ExpMainForm},
  ExpireAddFormImpl in 'ExpireAddFormImpl.pas' {ExpireAddForm};

end.
