unit ExpireMainFormImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, NLSDialogs,
  NLSLocalizer, StdCtrls, Mask, DBCtrls, ComCtrls, ExtCtrls, ImgList,
  ToolWin, ActnList, Grids, DBGridEh, CMExcelExport;

type
  TExpMainForm = class(TForm)
    Localizer: TNLSLocalizer;
    GroupBox1: TGroupBox;
    DBEdit1: TDBEdit;
    Panel1: TPanel;
    StatusBar1: TStatusBar;
    ToolBar1: TToolBar;
    ToolButton1: TToolButton;
    ToolButton2: TToolButton;
    ToolButton3: TToolButton;
    ToolButton4: TToolButton;
    ToolButton5: TToolButton;
    ToolButton6: TToolButton;
    ImageList1: TImageList;
    ToolButton7: TToolButton;
    ActionList1: TActionList;
    Action1: TAction;
    Action2: TAction;
    Action3: TAction;
    Action4: TAction;
    DBGridEh1: TDBGridEh;
    ExpireExport: TCMExcelExport;
    ToolButton8: TToolButton;
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure Action4Execute(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure Action1Execute(Sender: TObject);
    procedure Action3Execute(Sender: TObject);
    procedure Action2Execute(Sender: TObject);
    procedure Action2Update(Sender: TObject);
  private
    procedure ShowExpireForm;
    { Private declarations }
  public
    { Public declarations }
  end;

var
  ExpMainForm: TExpMainForm;

procedure InitPlugin(S : String); export;

implementation

{$R *.DFM}

uses
  CommonDecls, SystemState, ExpireDataModuleImpl, ExpireAddFormImpl;

var
  NeedRefreshAfterClose : Boolean;

procedure TExpMainForm.ShowExpireForm;
resourcestring
  rsExpireFormCaption = '%s - № ли кредитин эежикдирилмяси.';
var
  CreditID : Integer;
  SReserveID : Integer;
begin

  CreditID := Get_SelectedCrdID;
  Localizer.Caption := Format(rsExpireFormCaption,[Get_SelectedCrdNo]);
  with ExpireDataModule do
  begin

    with ExpireData do
    begin
      SetVariable('CreditID',CreditID);
      Open;
    end;

    with LoanRest do
    begin
      SetVariable('CreditID',CreditID);
      Open;
    end;

    with DueRest do
    begin
      SetVariable('CreditID',CreditID);
      Open;
    end;

    with CreditInfo do
    begin
      SetVariable('CreditID',CreditID);
      Open;
      SReserveID := FieldByName('DueReserveID').AsInteger;
    end;

    with SReserves do
    begin
      Open;
      if Locate('ID', SReserveID ,[]) then
      ExpireAddForm.DBLookupComboboxEh2.KeyValue := SReserveID;
    end;

  end;
  NeedRefreshAfterClose := False;

  ShowModal;
end;

procedure TExpMainForm.FormCreate(Sender: TObject);
begin
  ExpireDataModule := TExpireDataModule.Create(Self);
  ExpireAddForm := TExpireAddForm.Create(Self);
end;

procedure TExpMainForm.FormDestroy(Sender: TObject);
begin
  ExpireAddForm.Free;
  ExpireDataModule.Free;
end;

procedure TExpMainForm.Action4Execute(Sender: TObject);
begin
  Close;
end;

procedure TExpMainForm.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  with ExpireDataModule do
  begin
    with SReserves do
      Close;
    with LoanRest do
      Close;
    with DueRest do
      Close;
    with CreditInfo do
      Close;
    with ExpireData do
      Close;  
  end;

  if NeedRefreshAfterClose then
    SafeRefresh(True,rmLocateAfterRefresh);
end;

procedure TExpMainForm.Action1Execute(Sender: TObject);
begin
  ExpireAddForm.ActiveControl := ExpireAddForm.ExpiredAmountEdit;
  ExpireAddForm.ExpiredAmountEdit.SelectAll;
  if ExpireAddForm.ShowModal = mrOk then
  begin
    with ExpireDataModule.ExpireData do
      Refresh;
    NeedRefreshAfterClose :=  True;
  end;
end;

procedure TExpMainForm.Action3Execute(Sender: TObject);
begin
  with ExpireExport do
  begin
    Connect;
    ExportDataset(ExpireDataModule.ExpireData, 'Expire',True);
  end;
end;

procedure TExpMainForm.Action2Execute(Sender: TObject);

resourcestring
  rsAskBeforeDelete = 'Эежикдирилмя силиняжяк! Яминсиниз?';
  
var
  ExpID : Integer;

begin

  if MessageDlg(rsAskBeforeDelete,mtWarning,[mbYes,mbNo],0) <> mrYes
  then     EXIT;

  with ExpireDataModule do
  begin
    ExpID := ExpireData.FieldByName('ID').AsInteger;
    CM_EXPIRE.CallProcedure('Expire_Delete',[
      'p_ExpID' , ExpID
    ]);
  end;

end;

procedure TExpMainForm.Action2Update(Sender: TObject);
begin
  with ExpireDataModule.ExpireData do
  (Sender as TAction).Enabled := Active and (RecordCount > 0)
end;

procedure InitPlugin(S : String); export;
begin
  ExpMainForm.ShowExpireForm;
end;

exports
  InitPlugin;
  
initialization
  ExpMainForm := TExpMainForm.Create(CommonApplication);

end.
