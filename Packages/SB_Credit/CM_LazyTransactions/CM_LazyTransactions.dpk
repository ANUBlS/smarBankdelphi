package CM_LazyTransactions;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,rtl,
  sboapi50,
  CMVCL50,
  DclEhlib150,
  doa41dxe,
  Ehlib150,
  CM_COMMON;

contains
  LazyTransactionDatModImpl in 'LazyTransactionDatModImpl.pas' {LazTrDatMod: TDataModule},
  LazyTransactionMainImpl in 'LazyTransactionMainImpl.pas' {LazTransMainForm},
  ProgressImpl in 'ProgressImpl.pas' {TransactionProgForm},
  BanklarImpl in '..\CM_TurningAccounts\BanklarImpl.pas' {FormBank};

end.
