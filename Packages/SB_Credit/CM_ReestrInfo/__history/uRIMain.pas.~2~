unit uRIMain;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, Mask, DBCtrlsEh, DBLookupEh, CheckLst, Evanescence;

type
  TfrmRIMain = class(TForm)
    DBLookupComboboxEh1: TDBLookupComboboxEh;
    chkCredits: TEvanescence;
    Button1: TButton;
    Button2: TButton;
    procedure FormCreate(Sender: TObject);
    procedure DBLookupComboboxEh1Change(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmRIMain: TfrmRIMain;

implementation

uses uRIDM, urepRI;

{$R *.DFM}

procedure TfrmRIMain.FormCreate(Sender: TObject);
begin
  RIDataMod:= TRIDataMod.Create(Self);
  qrpRIRep := TqrpRIRep.Create(Self);
end;

procedure TfrmRIMain.DBLookupComboboxEh1Change(Sender: TObject);
begin
  chkCredits.Close;
  chkCredits.Open;
end;

procedure TfrmRIMain.Button2Click(Sender: TObject);
begin
  Close;
end;

procedure TfrmRIMain.Button1Click(Sender: TObject);
begin
  with RIDataMod, ODSRep, qrpRIRep do begin
    Close;
    SQL[1] := 'where creditid in ('+chkCredits.GetCheckedKeyList.CommaText+')';
    //SQL.SaveToFile('c:\a.txt');
    Open;           
    ODSNextVal.Close;
    ODSNextVal.SetVariable('bankid', ODSBanks.fieldbyname('id').AsVariant);
    ODSNextVal.Open;
    ODSUpdNextVal.SetVariable('bankid', ODSBanks.fieldbyname('id').AsVariant);
    ODSUpdNextVal.ExecSQL;
    Session.Commit;
    qlbTop.Caption:='Азярбайжан Республикасынын Милли Банкы няздиндя Азярбайжан Ипотека Фонду иля "'+ODSRep.FieldByName('MKBANK').AsString+'" арасында "'+ODSNextVal.FieldByName('CONTRDATE').AsString+'" тарихли '+ODSNextVal.FieldByName('kod_bank').AsString+' сайлы Хидмят мцгавилясиня ялавя';
    Preview;
  end;
end;

end.
