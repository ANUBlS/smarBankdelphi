package CM_DECA;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'DECA'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  CM_COMMON,
  sboapi50,
  CMVCL50,
  doa41dxe,
  vcl,
  rtl,
  dclbde,
  SBTranslate,
  VclSmp;

contains
  DecaMainForm in 'DecaMainForm.pas' {DecaForm},
  DecaDataModuleImpl in 'DecaDataModuleImpl.pas' {DecaDataModule: TDataModule},
  BankInfoImpl in 'BankInfoImpl.pas' {FrmBankinfo};

end.
