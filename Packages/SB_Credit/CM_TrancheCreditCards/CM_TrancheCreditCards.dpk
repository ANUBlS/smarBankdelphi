package CM_TrancheCreditCards;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,

  sboapi50,
  CMVCL50,

  doa41dxe,
  CM_COMMON;

contains
  TrancheCreditCardsUnit in 'TrancheCreditCardsUnit.pas' {MainTrForm},
  TrCreditCDatModImpl in 'TrCreditCDatModImpl.pas' {CreditCardDatMod: TDataModule},
  TrCTransactionUnit in 'TrCTransactionUnit.pas' {CreditCartdsForm},
  TrProgressUnit in 'TrProgressUnit.pas' {TrProgressForm};

end.
