  object BONS: TOracleDataSet
    SQL.Strings = (
      
        'select usrgroup, description, name, sum(crmeb)crmeb, sum(rest)re' +
        'st, sum(fullsay)fullsay,'
      
        '      sum(aymeb)aymeb, sum(sayay)sayay, sum(avtosay)avtosay, sum' +
        '(gecsay)gecsay, sum(gecmeb)gecmeb, sum(musbons)musbons,'
      '       sum(minbons)minbons from '
      ''
      
        '(select  p.usrgroup,u.description, f.name,sum((p.creditlineamoun' +
        't-nvl(hh.creditlineamount,0))*o.ostat )crmeb,sum((h.rest-nvl(hh.' +
        'rest,0))*o.ostat)+sum((h.duerest-nvl(hh.duerest,0))*o.ostat) res' +
        't,'
      
        'COUNT(*)fullsay, (ay.crmebay) aymeb ,ay.sayay,sayavto.avto avtos' +
        'ay, gec.gecsay,gec.gecmeb '
      
        ',nvl(nvl(ay.sayay*2,0)+nvl(sayavto.avto*5,0)+(sum((h.rest-nvl(hh' +
        '.rest,0))*o.ostat)+sum((h.duerest-nvl(hh.duerest,0))*o.ostat) )*' +
        '0.0003,0) musbons,nvl(gec.gecsay*6+(gec.gecmeb*0.0009),0) minbon' +
        's'
      ' from '
      'cm_portfolio p,'
      'cm_usergroups u,cm_history h,'
      'filial_t f,'
      'operkurs o,'
      
        '(select p.usrgroup, u.description, f.name,sum(p.creditlineamount' +
        '*o.ostat) crmebay ,count(*) sayay from '
      'cm_portfolio p,'
      'cm_usergroups u,'
      'filial_t f,'
      'operkurs o'
      'where p.usrgroup=u.id and'
      'p.branchid=f.id and'
      'p.dateofconclusion BETWEEN trunc(:dat,'#39'MON'#39') and :dat  and'
      'p.credittype in(4,17,18,22,23) AND'
      'p.branchid not in (0) and'
      'p.currency=o.val_kod and'
      'o.dat=:dat'
      'group by p.usrgroup, u.description, f.name'
      ') ay,('
      
        ' select p.usrgroup, sum(h.rest+h.duerest) gecmeb, COUNT(*) gecsa' +
        'y from  cm_portfolio p, cm_history h'
      ' where p.id=h.creditid and '
      ' p.dateofconclusion>'#39'01-apr-2014'#39' and'
      ' p.credittype in(4,17,18,22,23) AND'
      ' p.branchid not in (0) and'
      ' h.hdate=:dat and h.rest+h.duerest>0 and h.dueday>10'
      ' group by p.usrgroup ) gec,'
      
        ' (select usrgroup, count(id) avto from cm_portfolio where dateof' +
        'conclusion BETWEEN trunc(:dat,'#39'MON'#39') and :dat and credittype in(' +
        '1,16)  group by usrgroup) sayavto'
      
        ',(select creditid,rest,duerest,creditlineamount from cm_history ' +
        'h,cm_portfolio p'
      'where'
      'hdate=:dat and p.id=h.creditid and  credittype in(1,16)) hh'
      'where p.usrgroup=u.id(+) and'
      'p.branchid=f.id and'
      'p.dateofconclusion>'#39'01-apr-2014'#39'   and'
      'p.credittype in(20,4,17,18,22,23,1,16)  AND'
      'p.branchid not in (0) and'
      'p.currency=o.val_kod and'
      'o.dat=:dat and'
      'p.usrgroup=ay.usrgroup(+) and'
      'p.usrgroup=gec.usrgroup(+)and'
      'p.usrgroup=sayavto.usrgroup(+)and'
      'p.id=h.creditid and'
      'h.hdate=:dat and '
      'h.rest+h.duerest>0 and'
      'p.id=hh.creditid(+) '
      ''
      
        'group by p.usrgroup, u.description, f.name,ay.crmebay,sayay,gec.' +
        'gecsay,gecmeb ,sayavto.avto'
      ''
      'union all'
      
        'select  p.usrgroup,u.description, f.name,sum((p.creditlineamount' +
        '-nvl(hh.creditlineamount,0))*o.ostat )crmeb,sum((h.rest-nvl(hh.r' +
        'est,0))*o.ostat)+sum((h.duerest-nvl(hh.duerest,0))*o.ostat) rest' +
        ','
      
        'COUNT(*)fullsay, (ay.crmebay) aymeb ,ay.sayay,sayavto.avto avtos' +
        'ay, gec.gecsay,gec.gecmeb'
      
        ',nvl(nvl(ay.sayay*2,0)+nvl(sayavto.avto*5,0)+(sum((h.rest-nvl(hh' +
        '.rest,0))*o.ostat)+sum((h.duerest-nvl(hh.duerest,0))*o.ostat) )*' +
        '0.0003,0) musbons,nvl(gec.gecsay*6+(gec.gecmeb*0.0009),0) minbon' +
        's'
      ' from '
      'cm_portfolio p,'
      'cm_usergroups u,cm_history h,'
      'filial_t f,'
      'operkurs o,'
      
        '(select p.usrgroup, u.description, f.name,sum(p.creditlineamount' +
        '*o.ostat) crmebay ,count(*) sayay from '
      'cm_portfolio p,'
      'cm_usergroups u,'
      'filial_t f,'
      'operkurs o'
      'where p.usrgroup=u.id and'
      'p.branchid=f.id and'
      'p.dateofconclusion BETWEEN trunc(:dat,'#39'MON'#39') and :dat  and'
      'p.credittype=24 and p.expertid=44 AND'
      'p.branchid not in (0) and'
      'p.currency=o.val_kod and'
      'o.dat=:dat'
      'group by p.usrgroup, u.description, f.name'
      ') ay,('
      
        ' select p.usrgroup, sum(h.rest+h.duerest) gecmeb, COUNT(*) gecsa' +
        'y from  cm_portfolio p, cm_history h'
      ' where p.id=h.creditid and '
      ' p.dateofconclusion>'#39'01-apr-2014'#39' and'
      ' p.credittype =24 AND p.expertid=44 and'
      ' p.branchid not in (0) and'
      ' h.hdate=:dat and h.dueday>10'
      ' group by p.usrgroup ) gec,'
      
        ' (select usrgroup, count(id) avto from cm_portfolio where dateof' +
        'conclusion BETWEEN trunc(:dat,'#39'MON'#39') and :dat and credittype in(' +
        '1,16)  group by usrgroup) sayavto'
      
        ',(select creditid,rest,duerest,creditlineamount from cm_history ' +
        'h,cm_portfolio p'
      'where'
      'hdate=:dat and p.id=h.creditid and  credittype in(1,16)) hh'
      'where p.usrgroup=u.id and'
      'p.branchid=f.id and'
      'p.dateofconclusion>'#39'01-apr-2014'#39'   and'
      'p.credittype in(24)  and(p.expertid=44) AND'
      'p.branchid not in (0) and'
      'p.currency=o.val_kod and'
      'o.dat=:dat and'
      'p.usrgroup=ay.usrgroup(+) and'
      'p.usrgroup=gec.usrgroup(+)and'
      'p.usrgroup=sayavto.usrgroup(+)and'
      'p.id=h.creditid and'
      'h.hdate=:dat and '
      'p.id=hh.creditid(+) '
      ''
      
        'group by p.usrgroup, u.description, f.name,ay.crmebay,sayay,gec.' +
