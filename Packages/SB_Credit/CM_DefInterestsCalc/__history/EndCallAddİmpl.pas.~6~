unit EndCallAddİmpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, Buttons, DBCtrlsEh, Mask;

type
  TEndCallAddform = class(TForm)
    BitBtn1: TBitBtn;
    BitBtn2: TBitBtn;
    GroupBox1: TGroupBox;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    CheckBox1: TCheckBox;
    DBDateTimeEditEh1: TDBDateTimeEditEh;
    CheckBox2: TCheckBox;
    CheckBox3: TCheckBox;
    procedure BitBtn1Click(Sender: TObject);
    procedure CheckBox2Click(Sender: TObject);
    procedure CheckBox1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  EndCallAddform: TEndCallAddform;

implementation

{$R *.dfm}
 uses IntCalcDataModImpl;
procedure TEndCallAddform.BitBtn1Click(Sender: TObject);
begin
DefineCalcDatMod.OracleDataSet2.Post;
close;
end;

procedure TEndCallAddform.CheckBox1Click(Sender: TObject);
begin
if CheckBox1.Checked then
begin
 DBDateTimeEditEh1.Enabled:=False;
 CheckBox2.Checked :=false;
 CheckBox3.Checked :=false;
end;

end;

procedure TEndCallAddform.CheckBox2Click(Sender: TObject);
begin
 if CheckBox2.Checked  then
  DefineCalcDatMod.OracleDataSet2INTEREST.AsInteger:=1
else
DefineCalcDatMod.OracleDataSet2INTEREST.AsInteger:=0   ;

 if CheckBox3.Checked  then
  DefineCalcDatMod.OracleDataSet2DUEINTEREST.AsInteger:=1
else
DefineCalcDatMod.OracleDataSet2DUEINTEREST.AsInteger:=0
end;

end.
