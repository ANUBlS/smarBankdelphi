unit InterestsCalcUnit;

interface

uses  Windows, Messages, SysUtils, Classes, NLSDialogs, DB, Controls;

procedure InitPlugin(S : String); export;

implementation

uses IntCalcDataModImpl,InfarmatoinImpl, CommonDecls;

procedure ShowStopIntCalc;
resourcestring
   rsStopIntCalc = '‘аизл€рин балансда hесабланмасы дайандырылыр €минсинизми?';
    rsSOutIntCalc = '‘аизл€рин  hесабланмасы балансданк€нарда давам етдирилсин?';
var
  creditid :Integer;
begin
  creditid := Get_SelectedCrdID;
  if MessageDlg(
            rsStopIntCalc,
            mtWarning ,
            [mbYes,mbNo],
            0
  ) = mrYes then
  begin
    if MessageDlg(
            rsSOutIntCalc,
            mtWarning ,
            [mbYes,mbNo],
            0
  ) = mrYes then
  FrmInfarmatoin.showmodal
  else

    DefineCalcDatMod.CM_CREDITS.CallProcedure('EnabledInterestCalc',[creditid]);
 end;
  end;

procedure ShowContinueIntcalc;
resourcestring
   rsContinueintCalc = '‘аизл€рин hесабланмасы давам етдирилсинми?';
var
  creditid :Integer;
begin
  creditid := Get_SelectedCrdID;
  if MessageDlg(
            rsContinueintCalc,
            mtWarning ,
            [mbYes,mbNo],
            0
  ) = mrYes then
  begin
    DefineCalcDatMod.CM_CREDITS.CallProcedure('DisableInterestCalc',[creditid]);
  end;
end;

procedure InitPlugin(S:String); export;
const
  cStopIntcalc = 'StopIntCalc';
  CConIntCalc = 'ConIntCalc';
begin
  if s = cStopIntcalc then  ShowStopIntCalc;
  if s = CConIntCalc then   ShowContinueIntcalc;
end;
exports
  InitPlugin;
Initialization
 DefineCalcDatMod := TDefineCalcDatMod.Create(CommonApplication);
  FrmInfarmatoin:= TFrmInfarmatoin.Create(CommonApplication);
end.
