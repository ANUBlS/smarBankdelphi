  DataCol: Integer; Column: TColumn; State: TGridDrawState);
 Var Style   : Integer;
  begin
IF  Column.Title.Caption=''
Then begin
 IF  DepoziProps.FieldByName('DONR').value=1
   Then Style := DFCS_CHECKED
