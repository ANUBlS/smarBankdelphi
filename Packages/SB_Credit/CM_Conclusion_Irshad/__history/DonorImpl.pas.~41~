end;

procedure TFrmDonor.FormShow(Sender: TObject);
begin
DepoziProps.Open;

OracleDataSet1.close;
OracleDataSet1.SetVariable('crid',Get_SelectedCrdID);
OracleDataSet1.Open;
OracleDataSet1.edit;
end;

procedure TFrmDonor.OracleDataSet1ApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: string);
var
  Result : Integer;
begin
  Result := 0;
  case Action of
  'I' :
       begin

       Applied := True;

       end;
  'U' :
       begin
        with OracleDataSet1 do
     Result :=
         DonrPg.CallIntegerFunction('upd_donor',[FieldByName('id').AsInteger,
                                                 FieldByName('donid').AsInteger,
                                                 FieldByName('donorammount').AsInteger] );
         Applied := True;
         DepoziProps.Refresh;
       end;

       end;
     DepoziProps.Refresh;
  end;

