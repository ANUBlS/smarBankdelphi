procedure TFrmDonor.DBGrid1CellClick(Column: TColumn);
begin
if Column.FieldName='' then
  begin
    if DepoziProps.FieldByName('DONR').AsInteger=0 then
    with DepoziProps do begin
      edit;
      FieldByName('DONR').AsInteger:=1;
      Post;
      end
    else
    with DepoziProps do begin
      edit;
      FieldByName('DONR').AsInteger:=0;
      Post;
      end;
  end;
end;

