unit ControlFormImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
   Buttons, CMExcelExport, StdCtrls, Mask, DBCtrlsEh,
  DBLookupEh, ComCtrls, DBCtrls;

type
  TFormControl = class(TForm)
    CMExcelExport: TCMExcelExport;
    PageControl1: TPageControl;
    TabSheet1: TTabSheet;
    Label3: TLabel;
    Label4: TLabel;
    DateTimePicker1: TDateTimePicker;
    DBLookupComboBox1: TDBLookupComboBox;
    BitBtn1: TBitBtn;
    BitBtn2: TBitBtn;
    TabSheet2: TTabSheet;
    Label5: TLabel;
    DateTimePicker2: TDateTimePicker;
    BitBtn3: TBitBtn;
    BitBtn4: TBitBtn;
    DateTimePicker3: TDateTimePicker;
    Label1: TLabel;
    procedure FormCanResize(Sender: TObject; var NewWidth,
      NewHeight: Integer; var Resize: Boolean);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure BitBtn1Click(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure BitBtn3Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormControl: TFormControl;

implementation

{$R *.DFM}
uses commondecls,ControlDatModImpl,sbsystem;

procedure InitPlugin(s:string);export;
begin
  FormControl.ShowModal;
end;

exports
InitPlugin;
procedure TFormControl.BitBtn3Click(Sender: TObject);
var
Bdat,Edat :TDateTime;
begin
Bdat:= DateTimePicker2.DateTime;
Edat:= DateTimePicker3.DateTime;
with ControlDatMod,OracleDataSet1 do
  begin
   // Session.Commit;
    Cursor := crSQLWait;
     if Active then CloseAll;
       Open;
       if RecordCount=0 then
        begin
          ShowMessage('Hecbir ferq yoxdur !');
          exit;
        end;

    with  CMExcelExport do
    begin
       Connect;
       ExportDataset(OracleDataSet1,'Nəticələr',true);
       Disconnect;
    end;
    Cursor := crDefault;
end;

end;
procedure TFormControl.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
 Resize :=false;
end;

procedure TFormControl.FormClose(Sender: TObject; var Action: TCloseAction);
begin
CMExcelExport.Disconnect
end;

procedure TFormControl.FormKeyPress(Sender: TObject; var Key: Char);
begin
   if ord(key) = VK_ESCAPE then close;
end;

procedure TFormControl.BitBtn1Click(Sender: TObject);
var BranchID :integer;
    ContDate :TDateTime;
begin
  BranchID:= DBLookupComboBox1.KeyValue;
  ContDate:= DateTimePicker1.DateTime;
  with ControlDatMod,CM_CONTROL,ResultsDatSet do
  begin
    Session.Commit;
    Cursor := crSQLWait;
    if BranchID<0 then
    callprocedure('control_full',[BranchID,ContDate])
    else
    callprocedure('control',[BranchID,ContDate]);

    if Active then CloseAll;
       Open;

    if ResultsDatSet.RecordCount=0 then
    begin
    ShowMessage('Heç bir məlumat tapılmadı ');
    exit;
    end;
    with  CMExcelExport do
    begin
       Connect;
       ExportDataset(ResultsDatSet,'Nəticələr',true);
    //   Disconnect;
    end;
    Cursor := crDefault;

  end;
end;



procedure TFormControl.FormCreate(Sender: TObject);
begin
  DateTimePicker1.DateTime:=Get_CurrentDate;
  DateTimePicker2.DateTime:=Get_CurrentDate;
   DateTimePicker3.DateTime:=Get_CurrentDate;
  ControlDatMod := TControlDatMod.Create(self);
  ControlDatMod.Branchs.Open;
  DBLookupCombobox1.KeyValue:=ControlDatMod.Branchs.FieldByname('ID').asinteger;
end;

procedure TFormControl.FormDestroy(Sender: TObject);
begin
 ControlDatMod.free;
end;

initialization
  FormControl := TFormControl.Create(CommonApplication);
end.
