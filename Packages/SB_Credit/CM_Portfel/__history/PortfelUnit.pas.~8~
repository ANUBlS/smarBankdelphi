procedure TPortfelForm.Calculation(var Rrest,Rinterest,RRduerest,RDueInRest,RRobl :real);
var
  srest,sinterest,sRduerest,SDueInRest,sRobl :Real; i:integer; ADate :TDate;
begin
   srest := 0;
   sinterest := 0;
   sRduerest := 0;
   SDueInRest := 0;
   sRobl := 0;

   ADate := Integer(Trunc(DateTimePicker.DateTime));

  if Adate = Get_CurrentDate then
   begin
       with PortfelDataModule.MainDataSet do
       begin
        Filter := FilterString;
        Filtered := False;
        Filtered := True;
       end;

       for i:=0 to PortfelDataModule.MainDataSet.RecordCount-1 do
       begin
          sRobl := sRobl+PortfelDataModule.MainDataSet.FieldByName('obligation').AsFloat;
          sDueInRest := sDueInRest+PortfelDataModule.MainDataSet.FieldByName('dueinterestrest').AsFloat;
          srest := srest+PortfelDataModule.MainDataSet.FieldByName('Rest').AsFloat;
          sinterest := sinterest+PortfelDataModule.MainDataSet.FieldByName('INTERESTREST').AsFloat;
          sRduerest := sRduerest+PortfelDataModule.MainDataSet.FieldByName('DUEREST').AsFloat;
          PortfelDataModule.MainDataSet.Next;
       end;

      Rrest := srest;
      Rinterest := Sinterest;
      RRduerest := sRduerest;
      RDueInRest := sDueInRest;
      RRobl := sRobl;

    end;


   if Adate <>Get_CurrentDate then
   begin
       with PortfelDataModule.DateDataSet do
       begin
          CloseAll;
          SetVariable('Hdate',ADate);
          Open;
          Filtered := False;
          Filter := FilterString;
          Filtered := True;
       end;

       for i:=0 to PortfelDataModule.DateDataSet.RecordCount-1 do
       begin
          sRobl := sRobl+PortfelDataModule.DateDataSet.FieldByName('obligation').AsFloat;
          sDueInRest := sDueInRest+PortfelDataModule.DateDataSet.FieldByName('dueinterestrest').AsFloat;
          srest := srest+PortfelDataModule.DateDataSet.FieldByName('Rest').AsFloat;
          sinterest := sinterest+PortfelDataModule.DateDataSet.FieldByName('INTERESTREST').AsFloat;
          sRduerest := sRduerest+PortfelDataModule.DateDataSet.FieldByName('DUEREST').AsFloat;
          PortfelDataModule.DateDataSet.Next;
       end;

        Rrest :=Srest;
        Rinterest := Sinterest;
        RRduerest := sRduerest;
        RDueInRest := sDueInRest;
        RRobl := sRobl;
  end;

end;


