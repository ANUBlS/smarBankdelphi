procedure TPortfelForm.ActionFilterAcceptExecute(Sender: TObject);
resourcestring ErrorMSG = 'Uyğun sahə seçilməyib';
var Rrest,Rinrest,RDuerest ,RDueInrest,Robl,curs  :Real; ADate :TDateTime;
begin
 try
   Cursor := crSQLWait;
  ADate := Integer(Trunc(DateTimePicker.DateTime));
  if  CheckBoxvalute.Checked then
  begin
    with  PortfelDataModule.OperkursDataSet do
    begin
      if Active then CloseAll;
      SetVariable('DDATE',ADate);
      SetVariable('val_kod',DBLookupComboboxValute.KeyValue);
      Open;
      curs := FieldByName('ostat').AsFloat;
      ShowMessage(floattostr(curs));
      Calculation(Rrest,Rinrest,RDuerest ,RDueInrest,Robl);
      Editrests.Text      := FormatFloat('#,#0.00',Rrest*curs);
      EditInterest.Text   := FormatFloat('#,#0.00',Rinrest*curs);
      EditDueRests.Text   := FormatFloat('#,#0.00',RDuerest*curs);
      EditDueInRest.Text  :=  FormatFloat('#,#0.00',RDueInrest*curs);
      EditObligation.Text :=  FormatFloat('#,#0.00',Robl*curs);
    end;
  end
     else
  begin
    Calculation(Rrest,Rinrest,RDuerest ,RDueInrest,Robl);
    Editrests.Text := FormatFloat('#,#0.00',Rrest);
    EditInterest.Text   := FormatFloat('#,#0.00',Rinrest);
    EditDueRests.Text   := FormatFloat('#,#0.00',RDuerest);
    EditDueInRest.Text  :=  FormatFloat('#,#0.00',RDueInrest);
    EditObligation.Text :=  FormatFloat('#,#0.00',Robl);
  end;
  finally
    cursor := crDefault;
  end;
end;

