procedure TPortfelForm.FormCreate(Sender: TObject);
var Rrest,Rinrest,RDuerest ,RDueInrest,Robl,curs : Real;
begin
   PortfelDataModule := TPortfelDataModule.Create(Self);
   with PortfelDataModule do
   begin
