procedure TfrmReserveInf.BitBtnOkClick(Sender: TObject);
var repdat : TDateTime;
  partkey,  FilterStr : String;
begin
  repdat := integer(trunc(DTPDat.DateTime));
  Animate1.Visible:=True;
  Animate1.Active:=True;
  Animate1.CommonAVI:=aviFindFolder ;

  if ChBActCrd.checked
  then partkey:='and p.partitionkey=0 '
  else partkey:='and p.partitionkey like ''%''';

    with dmReserveInf,ReserveInf do
    begin
         if Active then CloseAll;
         SetVariable('dat',repdat);
         if BuildFilterString <> '' then  begin
         FilterStr := ' and '+BuildFilterString;
         SQL[77] := FilterStr;
                                        end;
        SQL[78] :=partkey;
        // Memo1.Text := SQL.Text;
         open;
    end;

    with EExport do begin
        Connect;
        ExportDataset(dmReserveInf.ReserveInf,'Ehtiyyat hesabati',true,false);
        Disconnect;
    end;
   Animate1.Visible:=false;
  Animate1.Active :=false;
end;

