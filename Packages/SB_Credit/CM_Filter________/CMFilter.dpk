package CMFilter;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Filter'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  sboapi50,
  CM_COMMON,
  CMVCL50,
  doa41dXE,
  SBTranslate;

contains
  MainUnitImpl in 'MainUnitImpl.pas' {FilterMainForm},
  DataModuleImpl in 'DataModuleImpl.pas' {FilterDataModule: TDataModule},
  Unit7 in 'Unit7.pas' {Form7};

end.
