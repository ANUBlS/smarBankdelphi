procedure TRtDataModule.PersonLinkApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: string);

begin
{Result := 0;
if SavedCredit.ins=1 then

  case Action of
  'I' :  begin
         Result := 0;
       end;
  'U' :
       begin
       showmessage('jjj');
         with PgRetel ,SavedCredit do
           Result := CallIntegerFunction('cred_add',[
           'CreditID',PersonLink.FieldByName('id').AsInteger,
           'boorowerid',boorowerid,
           'Currency',Currency,
           'CreditLineAmount',CreditLineAmount,
           'AnnualyInterestRate',AnnualyInterestRate,
           'AnnualyOverdueRate',AnnualyOverdueRate,
           'AnnualyPenaltyRate',AnnualyPenaltyRate,
           'DateOfConclusion',DateOfConclusion,
           'DueDateFirstContract',DueDateFirstContract,
           'NumberOfCredit',NumberOfCredit,
           'PurposeOfCredit',PurposeOfCredit,
           'BranchID',BranchID,
           'pldgid_t',pldgid_t ,
           'REGION' ,REGION ,
           'REGION_DISTRICT',REGION_DISTRICT
         ]);
         Applied := True;
       end;
    end;
     }


end;

procedure TRtDataModule.PersonLinkCalcFields(DataSet: TDataSet);
begin
  { with DataSet do
        FieldByName('PeriodContracts').AsInteger
          := cm_common.CallIntegerFunction('GetPeriod',
          [FieldByname('DATEOFCONCLUSION').AsDateTime,
           FieldByname('DUEDATEFIRSTCONTRACT').AsDateTime ]);    }
end;

procedure TRtDataModule.ScheduleDataCalcFields(DataSet: TDataSet);
begin
 with DataSet do
  FieldByName('TOTALPAY').AsFloat := FieldByName('PRINCIPAL').AsFloat + FieldByName('INTEREST').AsFloat;

end;

end.
