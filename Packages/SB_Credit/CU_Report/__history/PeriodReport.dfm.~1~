      'SELECT p.numberofcredit, '
      '      r.*, '
      '      CM_AK_REPORTS.get_balcn(r.contractno) as balcn,'
      '       b.name,'
      '       h.descripion person,'
      '       g.description project,p.ANNUALYINTERESTRATE,'
      '       --f.name filial ,'
      '       get_filialname(p.branchid) filial,'
      '       V.Val_name,'
      '       p.DATEOFCONCLUSION,'
      '       p.DUEDATEFIRSTCONTRACT'
