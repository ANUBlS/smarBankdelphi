package CM_Schedule;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Adding And Editing Contract'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  sboapi50,
  CMVCL50,
  CM_COMMON,
  doa41dxe,
  dclbde,
  QR5RunDXE,
  SBtranslate;

contains
  ScheduleDataModuleImpl in 'ScheduleDataModuleImpl.pas' {ScheduleDataModule: TDataModule},
  ScheduleMainFormImpl in 'ScheduleMainFormImpl.pas' {ScheduleForm},
  SheduleAddUnt in 'SheduleAddUnt.pas' {AddEditForm},
  ScheduleLoaderImpl in 'ScheduleLoaderImpl.pas',
  TrancheScheduleImpl in 'TrancheScheduleImpl.pas' {TrancheScheduleForm},
  TrancheScheduleDataModuleImpl in 'TrancheScheduleDataModuleImpl.pas' {TrancheSheduleDataMod: TDataModule},
  AnnutyPaymentFormImpl in 'AnnutyPaymentFormImpl.pas' {AnnutyForm},
  TrSchedUpdImpl in 'TrSchedUpdImpl.pas' {frmUpdTrSched},
  TrSchedAddImpl in 'TrSchedAddImpl.pas' {frmAddTrSched},
  frmReportTypeImpl in 'frmReportTypeImpl.pas' {frmReportType},
  ReportImpl in 'ReportImpl.pas' {ReportForm},
  ChangeScheduleImpl in 'ChangeScheduleImpl.pas' {FrmChangeSchedule},
  ReportBKFormUnit in 'ReportBKFormUnit.pas' {ReportBKForm},
  UnitInsurance in 'UnitInsurance.pas' {FormInsurance};

end.
