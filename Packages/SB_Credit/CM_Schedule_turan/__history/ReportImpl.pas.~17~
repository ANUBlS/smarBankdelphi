procedure TReportForm.logo;

var
  JpegImage: TJPEGImage;
  BlobStream: TStream;
begin
  if (not ScheduleDataModule.BankInfo.FieldByName('logo').IsNull) then
    begin
      BlobStream := (ScheduleDataModule.BankInfo.FieldByName('logo'));
      JpegImage := TJPEGImage.Create;
      try
        JpegImage.LoadFromStream(BlobStream);
        ReportForm.QRImage1.Picture.Assign(JpegImage);
        ReportForm.QRImage1.Visible := True;
      finally
        JpegImage.Free;
        BlobStream.Free;
      end;
    end
  else
    ReportForm.QRImage1.Visible := False;
end;
