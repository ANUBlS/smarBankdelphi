procedure TPaymentAddForm.GenerateFullPayment;
var pen :real;
begin
   with PaymentDataModule,cm_utils do
   begin
      MainAmtEdit.Text := FloatToStr(LoanRest.FieldByName('REST').AsFloat);
      IntAmtEdit.Text := FloatToStr(IntRest.FieldByName('INTERESTREST').AsFloat);
      PenaltyAmtEdit.Text := FloatToStr(CallFloatFunction('Get_creditPenalty',[crdid]));
      pen := round(MainAmtEdit.Value/100) ;

      FirstPayment.Text:= FloatToStr(AllExpenses.FieldByName('INITIALVALUEOSTAT').AsFloat);
      CascoPayment.Text:= FloatToStr(AllExpenses.FieldByName('CARINSURANCEOSTAT').AsFloat);
      CommisionPay.Text:= FloatToStr(AllExpenses.FieldByName('COMCOMMITMENTOSTAT').AsFloat);
      DocComPay.Text:= FloatToStr(AllExpenses.FieldByName('COMREPORTOSTAT').AsFloat);
      DypPay.Text:= FloatToStr(AllExpenses.FieldByName('DYPDOCUMENTATIONOSTAT').AsFloat);
      BkhPay.Text:= FloatToStr(AllExpenses.FieldByName('EXAMENTRYCARDOSTAT').AsFloat);
      RegPay.Text:= FloatToStr(AllExpenses.FieldByName('REGISTRATOROSTAT').AsFloat);
      GpsPay.Text:= FloatToStr(AllExpenses.FieldByName('GPSOSTAT').AsFloat);
      ManPay.Text:= FloatToStr(AllExpenses.FieldByName('COMPINSURANCEOSTAT').AsFloat);

      FullPayAmt.Value := MainAmtEdit.Value+IntAmtEdit.Value+PenaltyAmtEdit.Value+
      {pen+}DueAmtEdit.Value+DueIntAmtEdit.Value+BkPercentPay.Value+FirstPayment.Value+CascoPayment.Value+
      CommisionPay.Value+DocComPay.Value+DypPay.Value+BkhPay.Value+RegPay.Value+
      GpsPay.Value+ManPay.Value;
   end;

end;



