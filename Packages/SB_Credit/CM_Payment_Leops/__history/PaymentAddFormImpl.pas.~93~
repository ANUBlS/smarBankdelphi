procedure TPaymentAddForm.GeneratePlanPayment;
begin
   with PaymentDataModule,cm_utils do
   begin
      MainAmtEdit.Value  := CallFloatFunction('Get_MainPlanPayment',[crdid]);
      IntAmtEdit.Value   := { CallFloatFunction('Get_IntPlanPayment',[crdid])}IntRest.FieldByName('intrest').AsFloat;
      DueAmtEdit.Value   :=  PaymentDataModule.DueRest.FieldbyName('DUEREST').AsFloat;
      DueIntAmtEdit.Value:= PaymentDataModule.DueIntRest.FieldbyName('DUEINTERESTREST').AsFloat;
      FirstPayment.Value:=CallFloatFunction('Get_advancePayment',[crdid]);
      CascoPayment.Value:=CallFloatFunction('Get_InsuranceePayment',[crdid]);
      CommisionPay.Value:=CallFloatFunction('Get_CommisyonPayment',[crdid]);
      DocComPay.Value:=CallFloatFunction('Get_DocComPay',[crdid]);
      DypPay.Value:=CallFloatFunction('Get_DypPay',[crdid]);
      BkhPay.Value:=CallFloatFunction('Get_BkhPay',[crdid]);
      RegPay.Value:=CallFloatFunction('Get_RegPay',[crdid]);
      GpsPay.Value:=CallFloatFunction('Get_GpsPay',[crdid]);
      ManPay.Value:=CallFloatFunction('Get_ManPay',[crdid]);

      PenaltyAmtEdit.Value := CallFloatFunction('Get_creditPenalty',[crdid]);
      BkPercentPay.value:=CallFloatFunction('Get_BkIntPlanPayment',[crdid]);


      FullPayAmt.Value := MainAmtEdit.Value+IntAmtEdit.Value+PenaltyAmtEdit.Value+
      PaymentDataModule.DueRest.FieldbyName('DUEREST').AsFloat+BkPercentPay.value+
      PaymentDataModule.DueIntRest.FieldbyName('DUEINTERESTREST').AsFloat+
      FirstPayment.Value+CascoPayment.Value+CommisionPay.Value+DocComPay.Value+DypPay.Value+
      BkhPay.Value+RegPay.Value+GpsPay.Value+ManPay.Value;



      CMCurrencyEdit2.Value:=CallFloatFunction('Get_MainPlanPayment',[crdid])+ PaymentDataModule.DueRest.FieldbyName('DUEREST').AsFloat;
       if LoanRest.FieldByName('qovid').AsInteger=4 then
        begin
          CMCurrencyEdit3.Value:= CallFloatFunction('get_qetname',[crdid,1]);
          CMCurrencyEdit4.Value:= CallFloatFunction('get_qetname',[crdid,2]);
          CMCurrencyEdit5.Value:= CallFloatFunction('get_qetname',[crdid,3]);
          CMCurrencyEdit6.Value:= CallFloatFunction('get_qetname',[crdid,1])+
                                  CallFloatFunction('get_qetname',[crdid,2])+
                                  CallFloatFunction('get_qetname',[crdid,3]);
        end;
 if not (PaymentDataModule.PortfInfo.FieldByName('stopcalcdate').IsNull) then
   begin
     IntAmtEdit.value:=0;
     DueIntAmtEdit.value:=0;
     BkPercentPay.value:=0;
   end;
    with expcrdcnt do
    begin
      if active then Close;
      SetVariable('CrdID',CrdID);
      SetVariable('dat',Get_CurrentDate);
      Open;
    end;
      ExpdateCount.Text := IntToStr(expcrdcnt.FieldByName('EXDATCOUNT').AsInteger);
    end;

end;

