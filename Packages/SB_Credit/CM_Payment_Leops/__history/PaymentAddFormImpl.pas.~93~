 if (PaymentDataModule.PaymentAccounts.FieldByName('rest').AsFloat<f)  and  not CBTermination.Checked then
  begin
   ShowMessage(' Ödənişlərin cəmi  cari hesabın qalığından cox ola bilmez !');
   exit;
  end;
   if (PaymentDataModule.PortfInfo.FieldByName('qovid').AsInteger=4)and (FullPayAmt.Value>(CMCurrencyEdit3.Value+CMCurrencyEdit4.Value+CMCurrencyEdit5.Value)) then
  begin
   ShowMessage(' Ödənişlərin cəmi  qətnamə  qalığından cox ola bilmez !');
   exit;
  end;
  if CBFullPay.checked and CBTermination.Checked then
  begin
    ShowMessage(' Tam ödəniş və Xitam eyni zamanda seçilə bilməz !!!');
    exit;
  end;
  if CBTermination.Checked then
  if  DBLCustomers.Text='' then
  begin
   ShowMessage('Xitam verilən  müqavilədə digər müştəri seçilməyib !');
   exit;
  end;



 {    if MainAmt>faktatm then
   begin
         SheduleReplace.Rest.Value:=DBEditEh4.value-MainAmt;
         SheduleReplace.showmodal;
   end;
   if a=1 then
   exit;    }
   cusb:=0;
   with PaymentDataModule do
   begin
   if PortfInfo.FieldByName('credittype').AsInteger=1555 then
   begin
   if ODS_CUST_COMBİNED.Active then
    ODS_CUST_COMBİNED.Close;
    ODS_CUST_COMBİNED.SetVariable('creditid',CrdID);
    ODS_CUST_COMBİNED.open;
    Form1.ShowModal;
    if (cusb=0) and(ODS_CUST_COMBİNED.RecordCount>0) then
     begin
     ShowMessage('Birgə borcalanı seçməmisiniz !');
     exit;
     end;
    end;
