unit ZaminGirovImpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Buttons, StdCtrls, ExtCtrls;

type
  TZaminGirovFrm = class(TForm)
    Panel1: TPanel;
    Label1: TLabel;
    Edit1: TEdit;
    SpeedButton1: TSpeedButton;
    procedure FormCanResize(Sender: TObject; var NewWidth, NewHeight: Integer;
      var Resize: Boolean);
    procedure SpeedButton1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  ZaminGirovFrm: TZaminGirovFrm;

implementation

{$R *.dfm}
 uses RtDmImpl;
procedure TZaminGirovFrm.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
resize:=false
end;

procedure TZaminGirovFrm.SpeedButton1Click(Sender: TObject);
begin
with RtDataModule do
 begin
   if zaminsrc.Active then
      zaminsrc.Close;
      zaminsrc.SetVariable('id',Edit1.Text);
      zaminsrc.Open;
     if zaminsrc.RecordCount>0 then
        if MessageDlg(
      zaminsrc.FieldByName('name').AsString+' Tapıldı zamin kimi daxil etmək istəyirsinizmi !' ,
       mtConfirmation,
       [mbYes,mbNo],
       0) <> mrYes
      then   Exit;

 end;

end;

end.
