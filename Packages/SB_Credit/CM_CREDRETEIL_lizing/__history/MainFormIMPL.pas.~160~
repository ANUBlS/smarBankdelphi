function TMainForm.CalcFullIntpayment:Real;
begin
   result := 0;
   with RtDataModule,ScheduleData do
   begin
      First;
      while not EOF do
      begin
       result := result+ FieldByName('INTEREST').AsFloat;
       Next;
      end;
   end;
end;
 procedure TMainForm.exportreport(CreditID:integer);
var factint :real;
  s :string[5];

begin

     with RtDataModule do
  begin
    with ScheduleData do
    begin
      ClearVariables;
      SetVariable('CreditID',CreditID);
      Open
    end;
    with BoorowerInfo do
    begin
      ClearVariables;
      SetVariable('CreditID',CreditID);
      Open
    end;
    with CreditInfo do
    begin
      ClearVariables;
      SetVariable('ID',CreditID);
      Open
    end;

     BankInfo.open;
     HeadOfficeID.open;

          if FilialInfo.Active then FilialInfo.CloseAll;
          FilialInfo.SetVariable('brid',CreditInfo.FieldByName('BranchID').AsInteger);
          FilialInfo.Open;

         FormReport.QRLabel11.Caption := FilialInfo.fieldByName('name').asstring;

         if FilialInfo.FieldByName('ID').AsInteger = HeadOfficeID.FieldbyName('minid').AsInteger then
           FormReport.QRLabel10.caption := 'Müştəri xidmətləri departamentinin direktoru______________________________'
         else
           FormReport.QRLabel10.caption := 'Filial direktoru'

     end;

    with RtDataModule,CreditInfo do  begin
          factint := (CalcFullIntpayment/FieldByName('CREDITLINEAMOUNT').AsFloat)*100;
           s := FloatToStr(FieldByName('ANNUALYINTERESTRATE').AsFloat);
   end;

    with FormReport do
    begin
         ANNUALYINTERESTRATE.Caption := s+'%';
         FullIntPayment.Caption := FloatToStr(CalcFullIntpayment);
         s := Floattostr(factint);
         Facticalintforrest.Caption :=  s+'%';
         QrpfrmRep.Preview;
    end;

end;
