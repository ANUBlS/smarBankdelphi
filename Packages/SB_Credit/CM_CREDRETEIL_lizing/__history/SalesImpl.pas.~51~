procedure TSalesFrm.BitBtn1Click(Sender: TObject);
var
sql:string;
begin
 if DBLookupComboboxEh12.Text='' then
 begin
  ShowMessage('Məhsulun tipini seçin');
  exit;
 end;

 if DBLookupComboboxEh1.Text='' then
 begin
  ShowMessage('Məhsulun adını seçin');
  exit;
 end;
  if edit2.Text='' then
 begin
  ShowMessage('Məhsulun sayını daxil edin');
  exit;
 end;
 if CMCurrencyEdit1.Value=0 then
 begin
  ShowMessage('Məbləği daxil edin ');
  exit;
 end;
   RtDataModule.OracleQuery1.SetVariable('custid',rt);
   RtDataModule.OracleQuery1.SetVariable('mebleg',CMCurrencyEdit1.Value);
   RtDataModule.OracleQuery1.SetVariable('prname',DBLookupComboboxEh1.Text);
   RtDataModule.OracleQuery1.SetVariable('price',CMCurrencyEdit1.Value);
   RtDataModule.OracleQuery1.SetVariable('catid',DBLookupComboboxEh12.KeyValue);
   RtDataModule.OracleQuery1.SetVariable('prid',DBLookupComboboxEh1.KeyValue);
   RtDataModule.OracleQuery1.SetVariable('unitid',RtDataModule.ProductSet.FieldByName('unit_id').AsInteger);
   RtDataModule.OracleQuery1.SetVariable('sayi',Edit2.Text);
   RtDataModule.OracleQuery1.SetVariable('barcode',RtDataModule.ProductSet.FieldByName('barcode').AsString);
   RtDataModule.OracleQuery1.SetVariable('code',RtDataModule.ProductSet.FieldByName('code').AsString);

   RtDataModule.OracleQuery1.Execute;
//   RtDataModule.OracleQuery1.Session.Commit;

   DBLookupComboboxEh1.KeyValue:=-1 ;
   DBLookupComboboxEh12.KeyValue:=-1 ;
   edit1.Text:='';
   edit2.Text:='';
   CMCurrencyEdit1.Value:=0;

   RtDataModule.SaleSet.Close;
   RtDataModule.SaleSet.SetVariable('sale_cust',rt);
   RtDataModule.SaleSet.open;
   BitBtn4.Enabled:=true;
end;

