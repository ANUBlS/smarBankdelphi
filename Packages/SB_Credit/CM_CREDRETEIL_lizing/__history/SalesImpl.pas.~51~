procedure TSalesFrm.BitBtn3Click(Sender: TObject);
var
sql:string;
begin
RtDataModule.SaleSet.Refresh;
if RtDataModule.SaleSet.RecordCount>0 then
 begin
  if MessageDlg( RtDataModule.SaleSet.FieldByName('productname').AsString +#13+
       ' adlı produkt sifarişlərdən silinecək əminsinizmi?',
       mtConfirmation,
       [mbYes,mbNo],
       0) = mrYes
     then
     begin
      sql:='delete  stocksmart.sale_log where id='+RtDataModule.SaleSet.FieldByName('id').AsString  ;
        RtDataModule.OracleQuery1.SQL.Text:=sql;
        RtDataModule.OracleQuery1.Execute;
        RtDataModule.OracleQuery1.Session.Commit;
        RtDataModule.SaleSet.Refresh;
     end;
 end;
end;

