unit ZaminGirovImpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Buttons, StdCtrls, ExtCtrls, Grids, XDBGrids, ComCtrls;

type
  TZaminGirovFrm = class(TForm)
    PageControl1: TPageControl;
    TabSheet1: TTabSheet;
    Panel1: TPanel;
    Label1: TLabel;
    SpeedButton1: TSpeedButton;
    Edit1: TEdit;
    XDBGrid1: TXDBGrid;
    procedure FormCanResize(Sender: TObject; var NewWidth, NewHeight: Integer;
      var Resize: Boolean);
    procedure SpeedButton1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  ZaminGirovFrm: TZaminGirovFrm;

implementation

{$R *.dfm}
 uses RtDmImpl;
procedure TZaminGirovFrm.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
resize:=false
end;

procedure TZaminGirovFrm.SpeedButton1Click(Sender: TObject);
begin
with RtDataModule do
 begin
   if zaminsrc.Active then
      zaminsrc.Close;
      zaminsrc.SetVariable('id',Edit1.Text);
      zaminsrc.Open;
     if zaminsrc.RecordCount>0 then
        if MessageDlg(
        zaminsrc.FieldByName('name').AsString+' Tapıldı zamin kimi daxil etmək istəyirsinizmi !' ,
       mtConfirmation,
       [mbYes,mbNo],
       0) <> mrYes  then Exit;

       PgRetel.CallProcedure('add_zamin',['p_custid',strtoint(edit1.Text),
                                          'p_creditid',Result ]);

     if ZaminSet.Active then
        ZaminSet.Close;
        ZaminSet.SetVariable('creditid',Result);
        ZaminSet.Open;
 end;


end;

end.
