procedure TTrchAddForm.DBLookupComboboxEh1CloseUp(Sender: TObject;
  Accept: Boolean);
  var
  LAmmount: Currency;
begin
Cash_ammount:=0;
 CMCurrencyComm.Clear;

with ods_partner do
begin
   close;
    SetVariable('v_id',DBLookupComboboxEh1.KeyValue);
   open;

end;
with ods_partid do
begin
  close;
   SetVariable('v_parID',ods_partnerID.AsInteger);
   SetVariable('per_id',TrancheDataModule.CreditInfoperiodcontracts.AsInteger);
   open;
 end;
   if ods_partner.RecordCount=0 then
      begin
        showmessage( ' Partnyor  sazlanmayıb  !');
      end;

  if ods_partner.RecordCount=1 then
      begin
    LAmmount:=
          RoundNew(TrancheSumEdit.Value-(TrancheSumEdit.Value*ods_partidPERCENT.AsFloat/100) -ods_partidAMOUNT.AsFloat  , 1000000);
    CMCurrencyComm.Value:=LAmmount;

       if not  VarIsNull(ods_partidCASH_PERCENT.AsFloat)and (ods_partidCASH_PERCENT.AsFloat>0 ) then

    Cash_ammount:= RoundNew(LAmmount*ods_partidCASH_PERCENT.AsFloat/100 ,1000000);

      end ;

     if ods_partner.RecordCount>1 then
      begin
        showmessage( ' Eyni partnyor  1 dəfədən çox sazlanəb !');
      end;




end;

