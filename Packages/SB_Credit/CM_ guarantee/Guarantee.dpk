package Guarantee;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  doa41dXE,
  CMOracleAPI,
  CMVCL50,
  CM_COMMON;

contains
  guaranteeImpl in 'guaranteeImpl.pas' {FrmGuarantee},
  GirovImpl in 'GirovImpl.pas' {FrmGirov},
  GrovDataModuleImpl in 'GrovDataModuleImpl.pas' {GrovDataMod: TDataModule};

end.
