  object active: TOracleDataSet
    SQL.Strings = (
      
        'select p.numberofcredit,u.description mehsul_shexs,p.creditlinea' +
        'mount,p.dateofgrant, psh.PRINCIPAL,psh.INTEREST,psh.PRINCIPAL+ps' +
        'h.INTEREST odcem,psh.PAYMENTDATE,v.val_name,cm_common.get_accnam' +
        'e(ac.CONTRACTACCID)  as name ,e.name exname, l.phonenumber ,cm_u' +
        'tils.Get_PlanPrincipal(p.ID, :dat1) eo,interestrest,penaltyrest,' +
        'cm_utils.Get_PlanPrincipal(p.ID, :dat1) +interestrest+penaltyres' +
        't  cem '
      
        ',interestrest+((h.rest*annualyinterestrate/36000)*(:dat1-:dat)) ' +
        'proq,cm_utils.Get_MainPlanPayment(p.id,:dat1) odemeli from'
      
        'cm_active_credits p,cm_history h,CM_PAYMENT_SCHEDULE psh,smart.a' +
        'valute_t v,cm_accounts ac,cm_expert e,cm_boorowerinfo l,cm_userg' +
        'roups u'
      
        'where p.id=h.creditid and ac.creditid=p.id and p.id=l.creditid a' +
        'nd'
      
