package CM_IP;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Ipoteka Predmet'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  CMOracleAPI,
  CM_COMMON,
  CMVCL50,
  DclEhlib50,
  doa41dXE,
  Ehlib50,
  dclbde,
  QR5RunDXE;

contains
  uIpPredMainImpl in 'uIpPredMainImpl.pas' {frmIpPredMain},
  uIPYMReportImpl in 'uIPYMReportImpl.pas' {qrpIPYM: TQuickRep},
  CurrencyToHR_Azeri_Impl in 'CurrencyToHR_Azeri_Impl.pas',
  CurrencyToHRImpl in 'CurrencyToHRImpl.pas',
  uIPReestrReportImpl in 'uIPReestrReportImpl.pas' {qrpReestrInfo: TQuickRep},
  uIpReestr in 'uIpReestr.pas' {frmReestr};

end.
