procedure TfrmImpPayments.BitBtn1Click(Sender: TObject);
const
  StartRow = 7;
  RootCell = 2;
var
    V, Sheet, Sheets  :Variant;
    Row : Integer;
    CellStr : String;

      variable ,
      p_debitaccid : Integer;
      p_debitamt : Real;
      p_debitamt1 : Real;
      p_debitamt2 : Real;
      p_trdate :TDateTime;
      LoanAccNo,IntAccNo,ErrMessage,CustName : String;
      CheckResults : Boolean;
      CountOperaions : Integer;

begin

   p_trdate := Integer(Trunc(DTPImpDate.DateTime));
   CountOperaions := 0;
   Row := StartRow;
   ProgressShower.Position := 1;
   ProgressShower.Max := 100;

   V:=ExcelApplication1.Application;
   ExcelApplication1.Connect;
   try
     V.Workbooks.Open(SavePathEdit.Text);
     Sheet := V.Workbooks[1].Worksheets['MIS']; //
     Sheets := V.Sheets;
     CellStr := Sheet.cells[Row,RootCell];

     with  DMImpPayments,cm_common do
       p_debitaccid := callIntegerFunction('Get_correspondentAccID',[]);


     while CellStr <> '' do
     try
       CustName :=  Sheet.cells[Row,2];
       LoanAccno := Sheet.cells[Row,3];
       IntAccNo :=  Sheet.cells[Row,4];

       ProgressShower.Position := 50;
       with  DMImpPayments do begin

       {------------------------------------MainDebit----------------------------------}

         variable :=  cm_common.callIntegerFunction('Get_AccIDByNumber',[LoanAccno]);
         p_debitamt1 := Sheet.cells[Row,5];
         p_debitamt2 := Sheet.cells[Row,7];
         p_debitamt := p_debitamt1 + p_debitamt2;
         
         CheckResults := cm_dif_trans.CallBooleanFunction('check_credittransaction',[
                                       'p_variable',variable,
                                       'debitaccid',p_debitaccid,
                                       'debitamt',p_debitamt,
                                       'trdate',p_trdate]);

        if CheckResults then CountOperaions := CountOperaions+1;
       {------------------------------------End MainDebit-----------------------------}


       {------------------------------------IntDebit--------------------------------}
         variable :=  cm_common.callIntegerFunction('Get_AccIDByNumber',[IntAccNo]);
         p_debitamt := Sheet.cells[Row,6];
         CheckResults := cm_dif_trans.CallBooleanFunction('check_credittransaction',[
                                       'p_variable',variable,
                                       'debitaccid',p_debitaccid,
                                       'debitamt',p_debitamt,
                                       'trdate',p_trdate]);
        if CheckResults then CountOperaions := CountOperaions+1;

       {------------------------------------EndIntDebit-----------------------------}

       Inc(Row);
       CellStr := Sheet.cells[Row,RootCell];
    end;
   except
        on E:EOracleError do
        begin
          ErrMessage := E.Message;
          ShowMessage(ErrMessage+'---'+CustName);
          Continue;
         end;
   end;

   finally
     ExcelApplication1.Quit;
     ExcelApplication1.Disconnect;
     ProgressShower.Position := 100;
     ProgressShower.Position := 0;
     ShowMessage(IntToStr(CountOperaions)+' - сайда ямялиййат апарылды');
   end;

end;

