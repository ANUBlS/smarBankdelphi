unit ErizeImpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Grids, DBGridEh, ExtCtrls, DB, OracleData;

type
  TERizeFrm = class(TForm)
    Panel1: TPanel;
    CalcGrid: TDBGridEh;
    Erize: TOracleDataSet;
    DataSur: TDataSource;
    procedure FormCanResize(Sender: TObject; var NewWidth, NewHeight: Integer;
      var Resize: Boolean);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  ERizeFrm: TERizeFrm;

implementation
uses   CommonDecls, CMOracleAPIDataModuleImpl  ;
{$R *.dfm}

procedure TERizeFrm.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
Resize:=false
end;

procedure TERizeFrm.FormCreate(Sender: TObject);
begin
Erize.Open
end;

procedure TERizeFrm.FormDestroy(Sender: TObject);
begin
Erize.close
end;

procedure TERizeFrm.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if Ord(Key) = VK_ESCAPE then
  begin
    Close;
    Key := #0;
  end;

end;

end.
