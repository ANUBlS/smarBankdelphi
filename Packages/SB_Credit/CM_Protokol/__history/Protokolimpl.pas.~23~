var
  mainform: Tmainform;
   procedure InitPlugin(s:string);export;
implementation
uses   CommonDecls, protImpl,CMOracleAPIDataModuleImpl, ErizeImpl;

{$R *.DFM}
  procedure InitPlugin(s:string);export;
begin
if s='Main' then
   mainform.Show;

if s='Prot' then
   ProtFrm.ShowModal;


if s='Erize' then
   ERizeFrm.Showmodal
end;

exports
     InitPlugin;

 procedure Tmainform.BitBtn1Click(Sender: TObject);
 Resourcestring Can_Inf = 'Seçilmiş ərizələrin protokola daxil edilməsiinə əminsinizmi ?';
var i ,
    SlectedRowCnt,
    CrdId:Integer;
    dat:tdatetime;
begin
  dat:=integer(trunc(DateTimePicker1.DateTime));
   if MessageDlg(Can_Inf,
              mtInformation,
              [mbYes,mbNo],
               0) <> mrYes
               then exit ;


  if   ERizeFrm.MainGrid.SelectedRows.Count>1 then
  begin

   with ERizeFrm.MainGrid, DataSource.DataSet do
   begin
      SlectedRowCnt := SelectedRows.Count;
      for i:=0 to SlectedRowCnt-1 do
      begin
         GotoBookmark(Pointer(SelectedRows[I]));
         CrdId :=FieldByName('ID').AsInteger;

            {  Protokol.CallProcedure('up_port_protokol',[
              CrdId,
              dat,
              edit1.Text]);}

   end;
   end;
   end
else
   begin
   with CommonDBGrid, DataSource.DataSet do
   begin
         CrdId :=FieldByName('ID').AsInteger;
         Protokol.CallProcedure('up_port_protokol',[
              CrdId,
              dat,
              edit1.Text]);

   end;
   end;

 ProtFrm.ShowModal
end;

