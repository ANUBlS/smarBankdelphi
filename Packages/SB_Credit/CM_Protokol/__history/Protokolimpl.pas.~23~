end;

procedure Tmainform.FormCreate(Sender: TObject);
begin
sysdat.Open;
ProtFrm:=TProtFrm.create(Self);
ERizeFrm:=TERizeFrm.create(self);
DateTimePicker1.DateTime:=sysdat.FieldByName('Tek_dat').AsDateTime;
 end;
initialization
 mainform := Tmainform.Create(CommonApplication);
end.
