package CM_AK_Report;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM MIS'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  CM_COMMON,
  CMOracleAPI,
  DOA,
  Vclbde50,
  Qrpt50;

contains
  AKReportLoader in 'AKReportLoader.pas',
  BriefcaseDataModuleImpl in 'BriefcaseDataModuleImpl.pas' {BriefcaseDataMod: TDataModule},
  BriefcaseImpl in 'BriefcaseImpl.pas' {BriefcaseForm},
  BriefcaseQrepDataModuleImpl in 'BriefcaseQrepDataModuleImpl.pas' {BriefcaseQRepDataMod: TDataModule},
  BriefcaseQRepImpl in 'BriefcaseQRepImpl.pas' {BriefcaseReportForm: TQuickRep};

end.
