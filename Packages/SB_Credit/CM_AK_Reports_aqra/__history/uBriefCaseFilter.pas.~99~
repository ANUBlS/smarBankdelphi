           '(select id from agro_village where depend_id in( select id from agro_region where zonaid= '+ZonaDataSetID.AsString+')))';
  end;
  // showmessage(s);  exit;
  if CheckBox17.Checked then begin
    S := S+' and  id in (select creditid from cm_ak_grants where typeid = '+GTypesID.AsString+')';
