procedure TfrmBCFilter.FormCreate(Sender: TObject);
function GetMonLastDay(dM, dY: Word): Word;
begin
  if (dM in [1,3,5,7,8,10,12]) then
    Result := 31
  else if (dM in [4,6,9,11]) then
    Result := 30
  else if (dY div 4 = 0) then
    Result := 29
  else
    Result := 28;
end;
var dY, dM, dD: Word;
begin
  ZonaDataSet.open;
  ODSCmActCat.Open;
  DecodeDate(date, dY, dM, dD);
  if dM-1=0 then begin
    dM := 12;
    dY := dY -1;
  end else begin
    dM := dM -1;
  end;
  BDateP.DateTime := EncodeDate(dY, dM, 1);
  EDateP.DateTime := EncodeDate(dY, dM, GetMonLastDay(dM,dY));
  GCredEndD.DateTime := EDateP.DateTime;

  //BDateP.DateTime := Get_CurrentDate;
  //EDateP.DateTime := Get_CurrentDate;

  AKProgressForm := TAKProgressForm.Create(Self);
  DMBC := TDMBC.Create(Self);
  QRF1 := TQRF1.Create(Self);
  QRF2 := TQRF2.Create(Self);
  QRF3 := TQRF3.Create(Self);
  GBQRF1 := TGBQRF1.Create(Self);
  QRFProviz := TQRFProviz.Create(Self);
  btnAll.Visible := UpperCase(CreditsDS.Session.LogonUsername)='SMART';
  SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;


