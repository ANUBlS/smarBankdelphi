function TfrmBCFilter.BuildFilterString : String;

  procedure ConcatFilter(var S: String; const Prefix : String; Checked : Boolean; KeyValue : Variant);
  const
     csFormat = '(%s=%s)';
  var
    Temp : String;
  begin

    if Checked then
    begin
      Temp := Format(csFormat,[Prefix,Keyvalue]);
      if S = '' then
        S := Temp
      else
        S :=S + 'AND ' + Temp;
    end;
    
  end;
begin        
  Result := 'DATEOFCONCLUSION between '''+FormatDateTime('d-mmm-yyyy', GCredBegD.DateTime)+''' AND '''+FormatDateTime('d-mmm-yyyy', GCredEndD.DateTime)+''' ';
  ConcatFilter(Result,'CURRENCY',CheckBox1.Checked,DBLookupComboboxEh1.KeyValue);
  ConcatFilter(Result,'BRANCHID',CheckBox2.Checked,DBLookupComboboxEh2.KeyValue);
  ConcatFilter(Result,'USRGROUP',CheckBox3.Checked,DBLookupComboboxEh3.KeyValue);
  ConcatFilter(Result,'PERSONALTYPE',CheckBox7.Checked,DBLookupComboboxEh7.KeyValue);
  ConcatFilter(Result,'CREDITTYPE',CheckBox8.Checked,DBLookupComboboxEh8.KeyValue);
  ConcatFilter(Result,'BOOROWERID',CheckBox5.Checked,DBLookupComboboxEh4.KeyValue);
  ConcatFilter(Result,'BOOROWERID',CheckBox9.Checked,DBLookupComboboxEh6.KeyValue);
  //LogInformation(Result);
end;


