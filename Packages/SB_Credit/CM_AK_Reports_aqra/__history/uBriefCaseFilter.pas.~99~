procedure TfrmBCFilter.Button1Click(Sender: TObject);
var
  S          : String;
  CrdID      : Integer;
  PrintDeep  : Integer;
  Counter    : Integer;
begin

  if CheckBox4.Checked then begin
    PrintDeep := StrToInt(FloatToStr(Round(power(2,3-cbPrintDeep.ItemIndex))));
  end else begin
    PrintDeep := 32;
  end;

  if  BuildFilterString <>'' then
    S := 'and '+BuildFilterString;
  if rgKredStatus.ItemIndex = 0 then
    S := S + ' and id not in (select creditid from cm_old_credits)';
  if CheckBox11.Checked then begin
     S := S + ' AND id in (select creditid from cm_business_plan WHERE purpose = '+ Periods.FieldByName('ID').AsString+') '
  end;
  if CheckBox16.Checked then begin
     S := S + ' AND id in (select creditid from cm_business_plan WHERE source = '+ Short.FieldByName('ID').AsString+') '
  end;
  if CheckBox13.Checked then begin
     S := S + ' AND ANNUALYINTERESTRATE between '+fsm.Text+' AND '+fsx.Text;
  end;
  if CheckBox14.Checked then begin
     S := S + ' AND id in (select creditid from cm_business_plan WHERE type = '+ Types.FieldByName('ID').AsString+') '
  end;
  if CheckBox15.Checked then begin
     S := S + ' AND CREDITLINEAMOUNT between '+floattostr(ntmm.Value)+' AND '+floattostr(ntmx.Value);
  end;
  if CheckBox12.Checked then begin
     S := S + ' AND id in (select creditid from cm_curr_state WHERE decode(stopcalcdate,null,1,0) = '+ Statuses.FieldByName('ID').AsString +') '
  end;
  if CheckBox6.Checked then begin
    S := S+' and  id in (select creditid from cm_business_plan where villageid in'+
           '(select id from agro_village where depend_id='+DistrictsID.AsString+'))';
  end;
