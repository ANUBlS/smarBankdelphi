  object Rest: TOracleDataSet
    SQL.Strings = (
      
        'select sum(rest*k.ostat) as rest,sum( CM_RPORT.get_gununevqaliq(' +
        '(select max(dat) from smart.OPERKURS where dat<:dat),0,p.id))as ' +
        'AZN,'
      
        'sum(CM_RPORT.get_gununevqaliq((select max(dat) from smart.OPERKU' +
        'RS where dat<:dat),1,p.id)*k.ostat)as USD,sum(CM_RPORT.get_gunun' +
        'evqaliq((select max(dat) from smart.OPERKURS where dat<:dat),45,' +
        'p.id)*k.ostat)as EUR,'
      
        'sum(CM_RPORT.get_Tranches(p.id,:dat ) *k.ostat)-sum(CM_RPORT.get' +
        '_payment(p.id,:dat )*k.ostat) as ferq,'
      
        '(sum(rest*k.ostat) +(sum(CM_RPORT.get_Tranches(p.id,:dat ) *k.os' +
        'tat)-sum(CM_RPORT.get_payment(p.id,:dat )*k.ostat))) as gununson' +
        'una'
      ' from cm_history h,cm_active_credits p,smart.OPERKURS k'
      
        'where hdate=(select max(hdate) from cm_history where hdate<=(sel' +
        'ect max(dat) from smart.OPERKURS where dat<:dat)) and p.usrgroup' +
        ' not in(84,85)'
      
        'and p.id=h.creditid and k.val_kod =p.currency and k.dat=(select ' +
        'max(dat) from smart.OPERKURS where dat<:dat)'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      '/*7**/'
      '')
