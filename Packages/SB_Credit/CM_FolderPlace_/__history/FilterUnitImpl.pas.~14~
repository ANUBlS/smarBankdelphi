function TFilterMainForm.BuildFilterString : String;

  procedure ConcatFilter(var S: String; const Prefix : String; Checked : Boolean; KeyValue : Variant);
  const
     csFormat = '(%s=%s)';
  var
    Temp : String;   
  begin

    if Checked then
    begin
      Temp := Format(csFormat,[Prefix,Keyvalue]);
      if S = '' then
        S := Temp
      else
        S :=S + 'and ' + Temp;
    end;
    
  end;  // Concat Filter

  procedure ConcatFilter2(var S: String; const Prefix : String; Checked : Boolean; KeyValue : Variant);
  const
     csFormat = '(%s=%s)';
  var
    Temp : String;
  begin

    if Checked then
    begin
      Temp := Format(csFormat,[Prefix,Keyvalue]);
      if S = '' then
        S := Temp
      else
        S :=S + ' or ' + Temp;
    end;

  end;  // Concat Filter

  procedure ConcatFilter3(var S: String; const Prefix : String; Checked : Boolean; KeyValue : Variant);
  const
     csFormat = '(%s=%s)';
  var
    Temp : String;
  begin

    if Checked then
    begin
      Temp := Format(csFormat,[Prefix,Keyvalue]);
      if S = '' then
        S := Temp
      else
        S :=S + ' or ' + Temp;
    end;

  end;  // Concat Filter

var
  Temp,Temp1 : String;
begin

  Result := '';
  Temp := '';
  Temp1 := '';

  ConcatFilter(Result,'CURRENCY',CheckBox1.Checked,DBLookupComboboxEh1.KeyValue);
  ConcatFilter(Result,'BRANCHID',CheckBox2.Checked,DBLookupComboboxEh2.KeyValue);
  ConcatFilter(Result,'CREDITTYPE',CheckBox3.Checked,DBLookupComboboxEh3.KeyValue);
  ConcatFilter2(Temp,'TrProcessed',CheckBox22.Checked,1);
  ConcatFilter2(Temp,'TrProcessed',CheckBox21.Checked,0);
  ConcatFilter2(Temp,'TrProcessed',CheckBox4.Checked,2);
  ConcatFilter2(Temp,'TrProcessed',CheckBox20.Checked,3);
  ConcatFilter2(Temp,'TrProcessed',CheckBox5.Checked,4);

  ConcatFilter3(Temp1,'due',CheckBox6.Checked,0);
  ConcatFilter3(Temp1,'due',CheckBox7.Checked,1);
  ConcatFilter3(Temp1,'due',CheckBox8.Checked,2);

  if Temp1 <> '' then
  if Result <> '' then
    Result := Result + Format(' and (%s)',[Temp1])
  else
    Result := Format(' (%s)',[Temp1]);

  if Temp <> '' then
  if Result <> '' then
    Result := Result + Format(' and (%s)',[Temp])
  else
    Result := Temp;

 //  ShowMessage(Result);
  LogInformation(Result);
end;

procedure TFilterMainForm.Button1Click(Sender: TObject);
begin
  with FFilterGrid, DataSource.DataSet do
  begin
    Filter := BuildFilterString;
    Filtered := False;
    Filtered := True;
    SelectedRows.Clear;
  end;
end;

procedure TFilterMainForm.Button2Click(Sender: TObject);
begin
  with FFilterGrid, DataSource.DataSet do
  begin
    Filter := '';
    Filtered := False;
    SelectedRows.Clear;
  end;
end;

