  object IntCache_ex: TOracleDataSet
    SQL.Strings = (
      
        'select p.id,p.numberofcredit,VAL_NAME,b.name,REST,DUEREST, INTER' +
        'ESTREST,creditlineamount,dateofconclusion,duedatefirstcontract,'
      ' case when nvl(fl.status ,0)=1then'
      '0 else q.id end as'
      
        ' TRPROCESSED,(select count(*) from cm_folderplace_info where cre' +
        'ditid=p.id) qeydsayi,cr.description crtype,'
      ' case '
      ' when nvl(dueday,0) between 1 and 30 then '
      ' 1'
      ' when nvl(dueday,0) between 31 and 300000 then '
      ' 2'
      ' else'
      ' 0'
      
        ' end as due, b.phonenumber,gr.anyinfotodisting,gr.pledgeprice,g1' +
        '.guarantorname z1nam,g1.zaminwork1 z1work,g1.zmtelmob1 z1tel'
      
        ' ,g2.guarantorname z2nam,g2.zaminwork1 z2work,g2.zmtelmob1 z2tel' +
        ',g3.guarantorname z3nam,g3.zaminwork1 z1work,g3.zmtelmob1 z3tel,'
      
        '    LastintPaydate.paydat as lastintpaydate ,dLastintPaydate.pay' +
        'dat as dlastintpaydate ,'
      
        '    LastMainPaydate.paydat as lastmainpaydate , dLastMainPaydate' +
        '.paydat as dlastmainpaydate ,dLastMainPaydate.payeddueamt,'
      
        '    LastintPaydate.payedintamt,LastMainPaydate.payedamt,dLastint' +
        'Paydate.payeddueintamt,    '
      
        'DUEINTERESTREST,REST+DUEREST+INTERESTREST+DUEINTERESTREST fullre' +
        'st, dueday,q.id qovid,q.name qovluq,f.name filial,nvl(fl.status ' +
        ',0)status,p.currency,p.BRANCHID,p.credittype from '
      'cm_active_credits p,cm_credittypes cr,'
      'cm_curr_state h,cm_guarantee gr,'
      
        'cm_boorowerinfo b,CM_GUARANTOR g1,CM_GUARANTOR g2,CM_GUARANTOR g' +
        '3,'
      'cm_qovluq q,'
      'filial_t f,'
      'avalute_t v,'
      'cm_folderplace fl,'
      ' ((select '
      '          id as creditid,'
      '          null as paydat ,0 payedintamt'
      '        from cm_portfolio '
      '       minus'
      '       select '
      '       creditid ,'
      '       null as paydat,0 payedintamt from cm_payments p'
      '      where PAYEDINTAMT<>0  '
      
        '      and PAYDATE in(select max(paydate) from cm_payments where ' +
        'paydate<=sbop.get_date and creditid=p.creditid)'
      '      group by creditid)'
      '      union all'
      '      select '
      '       creditid ,'
      
        '       max(PAYDATE) as paydat,sum(payedintamt)payedintamt from c' +
        'm_payments p'
      '      where PAYEDINTAMT<>0  '
      
        '      and PAYDATE in(select max(paydate) from cm_payments where ' +
        'paydate<=sbop.get_date and creditid=p.creditid)'
      '      group by creditid) LastintPaydate,     '
      '      ((select '
      '          id as creditid,'
      '          null as paydat,0 payedamt'
      '        from cm_portfolio '
      '       minus'
      '       select '
      '       creditid ,'
      '       null as paydat,0 payedamt from cm_payments p'
      '      where payedamt<>0  '
      
        '      and PAYDATE in(select max(paydate) from cm_payments where ' +
        'paydate<=sbop.get_date and creditid=p.creditid)'
      '      group by creditid)'
      '      union all'
      '      select '
      '       creditid ,'
      
        '       max(PAYDATE) as paydat,sum(payedamt)payedamt from cm_paym' +
        'ents p'
      '      where payedamt<>0  '
      
        '      and PAYDATE in(select max(paydate) from cm_payments where ' +
        'paydate<=sbop.get_date and creditid=p.creditid)'
      '      group by creditid) LastMainPaydate      '
      '      ,            '
      '      ((select '
      '          id as creditid,'
      '          null as paydat,0 payeddueintamt'
      '        from cm_portfolio '
      '       minus'
      '       select '
      '       creditid ,'
      '       null as paydat, 0 payeddueintamt from cm_payments p'
      '      where payeddueintamt<>0  '
      
        '      and PAYDATE in(select max(paydate) from cm_payments where ' +
        'paydate<=sbop.get_date and creditid=p.creditid)'
      '      group by creditid)'
      '      union all'
      '      select  '
      '       creditid ,'
      
        '       max(PAYDATE) as paydat,sum(payeddueintamt) payeddueintamt' +
        ' from cm_payments p'
      '      where payeddueintamt<>0  '
      
        '      and PAYDATE in(select max(paydate) from cm_payments where ' +
        'paydate<=sbop.get_date and creditid=p.creditid)'
      '      group by creditid) dLastintPaydate,     '
      '      ((select '
      '          id as creditid,'
      '          null as paydat,0 payeddueamt'
      '        from cm_portfolio '
      '       minus'
      '       select '
      '       creditid ,'
      '       null as paydat, 0 payeddueamt from cm_payments p'
      '      where payeddueamt<>0  '
      
        '      and PAYDATE in(select max(paydate) from cm_payments where ' +
        'paydate<=sbop.get_date and creditid=p.creditid)'
      '      group by creditid)'
      '      union all'
      '      select '
      '       creditid ,'
      
        '       max(PAYDATE) as paydat, sum(payeddueamt) payeddueamt from' +
        ' cm_payments p'
      '      where payeddueamt<>0  '
      
        '      and PAYDATE in(select max(paydate) from cm_payments where ' +
        'paydate<=sbop.get_date and creditid=p.creditid)'
      '      group by creditid) dLastMainPaydate'
      'where p.id=h.creditid and'
      'p.id=b.creditid and'
      'p.qovid=q.id and'
      
        'p.id=gr.creditid(+)  and h.rest+h.duerest+h.interestrest+h.inter' +
        'estrest>0 and'
      'p.BRANCHID=f.id and'
      'p.id=fl.creditid(+) and'
      'fl.status(+)=1 and '
      'p.currency=v.valute  and p.credittype=cr.id'
      '  and LastintPaydate.creditid(+) = p.id'
      
        '  and LastMainPaydate.creditid(+) = p.id  and dLastintPaydate.cr' +
        'editid = p.id and dLastMainPaydate.creditid(+) = p.id'
