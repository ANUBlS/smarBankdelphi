procedure TCustAnalyz.ActiveFormCreate(Sender: TObject);
 var i:integer;
 a:string;
begin
DataModCustAnalyz:=TDataModCustAnalyz.create(self);
FormSedule:=TFormSedule.create(self);
FormPayments:=TFormPayments.create(self);
 CBSearch.Clear;
for i := 0 to DataModCustAnalyz.Ods_cust.FieldCount-1 do
CBSearch.Items.Add(DataModCustAnalyz.Ods_cust.Fields.Fields[i].fieldName);
 CBSearch.ItemIndex:=0;
  if not(DataModCustAnalyz.ODS_CUST.Active = True) then
    DataModCustAnalyz.ODS_CUST.Open
  else
    DataModCustAnalyz.ODS_CUST.Refresh;
  vCustId := -1;
 {showmessage(DataModCustAnalyz.Ods_custID.AsString);
  with  DataModCustAnalyz do
  begin
   Ods_portfol.Close;
   Ods_portfol.SetVariable('v_boorowerid',Ods_custID.AsInteger);
   Ods_portfol.open;
  end;  }
end;

