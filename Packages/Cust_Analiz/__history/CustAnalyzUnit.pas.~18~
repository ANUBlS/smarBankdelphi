procedure TCustAnalyz.EditSearchChange(Sender: TObject);
begin
 with DataModCustAnalyz do
   begin
 if Length(EditSearch.Text)<>0 then
  begin
   ODS_CUST.Close;
  case CBSearch.ItemIndex of
  0:ODS_CUST.SQL[3]:='and ID like '''+EditSearch.Text+'%''';
  1:ODS_CUST.SQL[3]:='and upper(cust_name)  like upper('''+EditSearch.Text+'%'')';
  2:ODS_CUST.SQL[3]:='and upper(firstname ) like upper('''+EditSearch.Text+'%'')';
  3:ODS_CUST.SQL[3]:='and upper(lastname)   like upper('''+EditSearch.Text+'%'')';
  4:ODS_CUST.SQL[3]:='and upper(patronymic) like upper('''+EditSearch.Text+'%'')';
  5:ODS_CUST.SQL[3]:='and upper(cust_type) like upper('''+EditSearch.Text+'%'')';
  end;
  ODS_CUST.Open;
  end
  else
  begin
  ODS_CUST.Close;
  ODS_CUST.SQL[3]:='';
  ODS_CUST.Open;

  end;
   end;
end;


