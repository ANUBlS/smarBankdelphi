implementation
uses  sboapiDataModuleImpl;
{$R *.dfm}

procedure TDataModCustAnalyz.Ods_custAfterScroll(DataSet: TDataSet);
begin
    with  DataModCustAnalyz do
  begin
   Ods_portfol.Close;
   Ods_portfol.SetVariable('v_boorowerid',Ods_custID.AsInteger);
   Ods_portfol.open;
   Ods_portfol.First;
  end;
   with  DataModCustAnalyz do
  begin
   Ods_Custinfo.Close;
   Ods_Custinfo.SetVariable('v_id',Ods_custID.AsInteger);
   Ods_Custinfo.open;
  end;
end;

procedure TDataModCustAnalyz.Ods_portfolAfterScroll(DataSet: TDataSet);
begin
 with  DataModCustAnalyz do
  begin
    Ods_zamin.Close;
   Ods_zamin.SetVariable('v_creditid',Ods_portfolid.AsInteger);
   Ods_zamin.open;
  end;
   with  DataModCustAnalyz do
  begin
   Ods_girov.Close;
   Ods_girov.SetVariable('v_creditid',Ods_portfolid.AsInteger);
   Ods_girov.open;
  end;

    with  DataModCustAnalyz do
  begin
   Ods_sedule.Close;
   Ods_sedule.SetVariable('v_creditid',Ods_portfolid.AsInteger);
   Ods_sedule.open;
  end;
   with  DataModCustAnalyz do
  begin
   Ods_payments.Close;
   Ods_payments.SetVariable('v_creditid',Ods_portfolid.AsInteger);
   Ods_payments.open;
  end;
end;

