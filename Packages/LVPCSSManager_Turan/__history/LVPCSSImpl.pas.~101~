procedure TLVPCSSForm.DBGridOUTArchBatchsTitleClick(Column: TColumn);
{Ordering}
  Procedure XS_BatchsArchiveOrderBy(OFields:String);
  begin
     screen.Cursor:=crSQLWait;
     try
       DataMod.XS_BatchsArchive.SetVariable('Title',Ofields);
       DataMod.XS_BatchsArchive.Refresh;
       DataMod.XS_BeneficiaryArchive.Refresh;
       //RefreshDataBatchs;
     finally
      screen.Cursor:=crDefault;
     end;
  end;
  {Change color}
  procedure ChangeTitleColor(Grid:Tdbgrid; ChColumn:Integer; OrderingColor,DefaulColor:TColor );
    var i : Integer;
  begin
    for i := 0 to Grid.Columns.Count-1 do   Grid.Columns[i].Title.Color:=DefaulColor;
        Grid.Columns[ChColumn].Title.Color:=OrderingColor;

  end;
begin
   if Column.Title.Caption= '№' then
   begin

     XS_BatchsArchiveOrderBy('x.id,x.status');
   end
   else
    if Column.Title.Caption='F' then
    begin

      XS_BatchsArchiveOrderBy('x.filial,x.status');
    end
    else
      if Column.Title.Caption='' then
      begin
        XS_BatchsArchiveOrderBy('x.status');
      end
      else
        if  Column.Title.Caption='Debet Məbləğ' then
      begin

        XS_BatchsArchiveOrderBy('x.AMOUNT,x.status');
      end
      else
         exit;
   ChangeTitleColor(DBGridOUTArchBatchs,Column.Index,clMaroon, $00804000);
end;


