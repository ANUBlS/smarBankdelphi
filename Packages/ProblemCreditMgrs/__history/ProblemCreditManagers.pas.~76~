procedure TProblemCreditMgr.ActiveFormCreate(Sender: TObject);
var
  i: Integer;
begin
  ProblemCreditMgr:=Self;
  PrCmDM := TPrCmDM.Create(Self);
   with PrCmDM do
   begin
     BonsFilterSet.Open;

     if BonsFilterSet.RecordCount>0 then
     begin
          PrCmDM.IntCache.SQL[45]:=' and p.bonus_user=user';
          PrCmDM.IntCache.open;
     end else
     begin
       PrCmDM.IntCache.SQL[45]:='';
      PrCmDM.IntCache.open;
     end;
   end;


  PrPayFrm:=TPrPayFrm.Create(Self);
  KrdInfoFrm:=TKrdInfoFrm.Create(Self);
  SendFrm:=TSendFrm.Create(Self);
  FormReport:=TFormReport.Create(Self);
  FormSettings:=TFormSettings.Create(Self);

  PrInfoFrm:=tPrInfoFrm.Create(Self);
  for i := 0 to ComponentCount - 1 do
    if Components[i].Tag = 3112 then begin
      (Components[i] as TEvanescence).Open;
      (Components[i] as TEvanescence).CheckAll;
    end;
end;
function ErrorInCheck(Look: TEvanescence; ErrorMsg: String=''):Boolean;
begin
  Result := True;
  if Look.GetCheckedKeyList.Count = 0 then Result := False;
  if (ErrorMsg <> '') and (not Result)then ShowMessage(ErrorMsg);
end;
procedure TProblemCreditMgr.BitBtn1Click(Sender: TObject);
var
   ADDITIONALPARAMS: String;
begin
 if not ErrorInCheck(LookQovluq,rsErrorQovluq) then Exit;

  if (LookQovluq.GetCheckedKeyList.Count<>LookQovluq.Items.Count) then
  ADDITIONALPARAMS := ADDITIONALPARAMS + ' AND p.Qovid in('
                   +LookQovluq.GetCheckedKeyList.CommaText+')'
                   +#13#10;
  ShowMessage(ADDITIONALPARAMS);
  PrCmDM.IntCache.Close;
  PrCmDM.IntCache.SQL[42]:=ADDITIONALPARAMS;
  PrCmDM.IntCache.open;
end;

