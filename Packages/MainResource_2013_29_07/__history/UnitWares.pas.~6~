  DBDateTimeEditEh1.TabOrder:=1;
  DBDateTimeEditEh1.Top:=104;
  DBDateTimeEditEh1.Width:=110;

  DBDateTimeEditEh2.Left:=120;

  DBDateTimeEditEh2.TabOrder:=1;
  DBDateTimeEditEh2.Top:=104;
  DBDateTimeEditEh2.Width:=110;

  end;

  if (FieldByName('close_format').AsInteger<>2) and (FieldByName('close_format').AsInteger<>3)then
  begin
  DTP_Using_Date.DateTime   := FieldByName('enter_date').AsDateTime;
  GroupBox3.Left:=3;
