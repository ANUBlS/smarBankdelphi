unit UnitUpdGroups;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, LDialogs,
  StdCtrls, Buttons, ExtCtrls,  DBCtrls,oracledata,oracle,sboapiDataModuleImpl,
  SearchCombo;

type
  TFormUpdGroups = class(TForm)
    PanelM: TPanel;
    SButton: TSpeedButton;
    GroupBoxName: TGroupBox;
    EditGroupName: TEdit;
    GroupBoxNBPercent: TGroupBox;
    EditPercentNB: TEdit;
    GroupBoxNLPercent: TGroupBox;
    EditPercentNL: TEdit;
    GroupBoxDebtAcc: TGroupBox;
    GroupBoxCredAcc: TGroupBox;
    GroupBox_main_acc: TGroupBox;
    CB_main_acc: TDBLookupComboBox;
    GroupBox_sale_acc: TGroupBox;
    CB_sale_acc: TDBLookupComboBox;
    CB_exp_acc: TDBLookupComboBox;
    CB_amort_acc: TDBLookupComboBox;
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormActivate(Sender: TObject);
    procedure SButtonClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormUpdGroups: TFormUpdGroups;
  s:string;

implementation

uses UnitData, SBTranslateProc;

{$R *.DFM}

procedure TFormUpdGroups.FormCreate(Sender: TObject);
begin
SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TFormUpdGroups.FormKeyPress(Sender: TObject; var Key: Char);
begin
 if (ORD(Key) =VK_ESCAPE) then Close;
end;

procedure TFormUpdGroups.FormActivate(Sender: TObject);
  var i:integer;
begin
 with  DataModWares do begin
        ODSViewGr.Close;
        ODSViewGr.Open;
        odsviewgr.first;
        if odsviewgr.RecordCount>0 then
        begin
        for i:=1 to odsviewgr.RecordCount-1 do
        begin
     //   dbcombobox1.Items.Add(odsviewgr.fieldbyname('acc_no').AsString);
        odsviewgr.Next;
        end;
        end;
          EditGroupName.Text:=ODSGroups.FieldByName('name').AsString;
          EditPercentNB.Text:=ODSGroups.FieldByName('amort').AsString;
          EditPercentNL.Text:=ODSGroups.FieldByName('taxamort').AsString;
          CB_main_acc.KeyValue:=ODSGroups.FieldByName('main_account').AsInteger;
          CB_amort_acc.KeyValue:=ODSGroups.FieldByName('amort_account').AsInteger;
          CB_exp_acc.KeyValue:=ODSGroups.FieldByName('exp_account').AsInteger;
          CB_sale_acc.KeyValue:=ODSGroups.FieldByName('sale_account').AsInteger;

    end;
end;

procedure TFormUpdGroups.SButtonClick(Sender: TObject);
begin
   if (EditGroupName.Text<>'') and (EditPercentNB.Text<>'') and
   (EditPercentNB.Text<>'')
   and (EditPercentNL.Text<>'') and (CB_amort_acc.Text<>'') and
   (CB_exp_acc.Text<>'')
   then
   begin

  DataModWares.SB_MAIN_RESOURCE.CallProcedure('upd_groups',[
                                     DataModWares.ODSGroups.FieldByName('id').AsFloat,
                                     EditGroupName.Text,
                                     strtofloat(EditPercentNB.Text),
                                     CB_main_acc.KeyValue,
                                     CB_exp_acc.KeyValue,
                                     CB_amort_acc.KeyValue,
                                     CB_sale_acc.KeyValue,
                                     strtofloat(EditPercentNL.Text)]);
             DataModWares.ODSGroups.Refresh;
         close;
   end
   else ShowMessage('Бош галан ханалар вар!');
end;





end.
