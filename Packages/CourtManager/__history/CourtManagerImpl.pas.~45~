procedure TCourtmgr.ActnSearchExecute(Sender: TObject);
var
  SearchField : string;
  SearchOptions : TSearchRecordOptions;
begin
  SearchOptions := [srIgnoreCase ,srPartialMatch];

  with Sender as TEdit  do
  begin
    SearchField := copy(Name,5,length(Name));
    MainGrid.SelectedRows.Clear;
    with  TOracleDataSet(MainGrid.DataSource.DataSet) do
    if  not SearchRecord(
                  SearchField
                 ,Text
                 ,SearchOptions + [srFromCurrent , srForward ]
                 ) then
    if MessageDlg(
              'Axtarış sona çatıb.'+#13+'əvvəldəb başlamaq istəyirsinizmi?'
             ,mtInformation
             ,[mbNo , mbYes]
             ,0
             ) = mrYes  then
    if  not SearchRecord(
                 SearchField
                ,Text
                ,SearchOptions + [ srFromBeginning ]
                )  then
    MessageDlg('Yazı Tapılmadı!',mtInformation,[mbOK],0);
  end;
   end;

procedure TCourtmgr.ActiveFormCreate(Sender: TObject);
var i:integer;
begin
  DataModuleCourt:=TDataModuleCourt.Create(self);
  FormPayments:=TFormPayments.Create(self);
  FormParametr:=TFormParametr.Create(self);
  FormCourtInfo:=TFormCourtInfo.Create(self);
  FormCreditInfo:=TFormCreditInfo.Create(self);
  FormSend:=TFormSend.Create(self);
  FormPdf:=TFormPdf.Create(self);
  FormExecutive:=TFormExecutive.Create(self);
  FormCourts:=TFormCourts.Create(self);
  for i := 0 to ComponentCount - 1 do
    if Components[i].Tag = 3112 then
    begin
      (Components[i] as TEvanescence).Open;
      (Components[i] as TEvanescence).CheckAll;
    end;
end;
function ErrorInCheck(Look: TEvanescence; ErrorMsg: String=''):Boolean;
begin
  Result := True;
  if Look.GetCheckedKeyList.Count = 0 then Result := False;
  if (ErrorMsg <> '') and (not Result)then ShowMessage(ErrorMsg);
end;

procedure TCourtmgr.BitBtn1Click(Sender: TObject);
var
   ADDITIONALPARAMS: String;
begin
 if not ErrorInCheck(LookQovluq,rsErrorQovluq) then Exit;

  if (LookQovluq.GetCheckedKeyList.Count<>LookQovluq.Items.Count) then
  ADDITIONALPARAMS := ADDITIONALPARAMS + ' AND p.courtid in('
                   +LookQovluq.GetCheckedKeyList.CommaText+')'
                   +#13#10;
  DataModuleCourt.ODSCourt.Close;
  DataModuleCourt.ODSCourt.SQL[42]:=ADDITIONALPARAMS;
  DataModuleCourt.ODSCourt.open;
end;

procedure TCourtmgr.BitBtn2Click(Sender: TObject);
var
   ADDITIONALPARAMS: String;
begin
 if not ErrorInCheck(FilialLukap,rsErrorQovluq) then Exit;

  if (FilialLukap.GetCheckedKeyList.Count<>FilialLukap.Items.Count) then
  ADDITIONALPARAMS := ADDITIONALPARAMS + ' AND p.branchid in('
                   +FilialLukap.GetCheckedKeyList.CommaText+')'
                   +#13#10;
  DataModuleCourt.ODSCourt.Close;
  DataModuleCourt.ODSCourt.SQL[43]:=ADDITIONALPARAMS;
  DataModuleCourt.ODSCourt.open;
end;

