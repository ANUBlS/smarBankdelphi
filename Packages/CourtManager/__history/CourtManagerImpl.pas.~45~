procedure TCourtmgr.Kredirmlumatlar1Click(Sender: TObject);
begin
 with  DataModuleCourt do
  begin
    if ScheduleCourt.Active then
      ScheduleCourt.close;
      ScheduleCourt.SetVariable('CrdID',ODSCourt.FieldByName('ID').AsInteger);
      ScheduleCourt.open;

    if PaymentsCourt.Active then
      PaymentsCourt.close;
      PaymentsCourt.SetVariable('CrdID',ODSCourt.FieldByName('ID').AsInteger);
      PaymentsCourt.open;

    if ZaminDSetCourt.Active then
      ZaminDSetCourt.close;
      ZaminDSetCourt.SetVariable('CrdID',ODSCourt.FieldByName('ID').AsInteger);
      ZaminDSetCourt.open;

    if GirovDSetCourt.Active then
      GirovDSetCourt.close;
      GirovDSetCourt.SetVariable('CrdID',ODSCourt.FieldByName('ID').AsInteger);
      GirovDSetCourt.open;
  end;
FormCreditInfo.showmodal;
end;

