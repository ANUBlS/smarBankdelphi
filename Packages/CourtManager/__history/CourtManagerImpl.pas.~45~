  DataModuleCourt.ODSAdminIn.Active:=true;
  with DataModuleCourt.ODSCourtAdmin do
  begin
      Open;
      if (UpperCase(Session.LogonUsername) = 'SMART')  or (UpperCase(Session.LogonUsername) ='TERLAN') then
      begin
         FormParametr.ShowModal;
      end else
      begin
         Application.MessageBox('Giriş Qadağandır!','Administratora müraciət edin!!!',0);
      end;
   end;
end;

