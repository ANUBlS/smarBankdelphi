{$R *.DFM}
     
function getlastdate(fromdate: TDateTime; amount: Double; monprice: Double): TDate;
var
  moncnt: Integer;
  restamt: Double;
  lastmon: TDateTime;
begin
  try
  moncnt := StrToInt(FloatToStr(Int(amount/monprice)));
  restamt := amount - moncnt * monprice;
  lastmon := IncMonth(fromdate, moncnt);
  Result := lastmon + Int(restamt/((monprice*12)/365));
  except
    result := StrToDate('01.01.1970');
  end;
end;
procedure TDataModC.DataModuleCreate(Sender: TObject);
var
 i: Integer;
begin
  for i:=0 to componentcount-1 do
    if (components[i] is toracledataset )and (components[i].tag=1 )then begin
      (components[i] as toracledataset).open;
    end;
end;

procedure TDataModC.odsContractsCalcFields(DataSet: TDataSet);
begin
  if odsContractsREST.Value<=0 then odsContractsLASTMON.AsVariant := null
  else
  odsContractsLASTMON.Value := getlastdate(odsContractsLASTCALCDATE.Value
                                          ,odsContractsREST.Value*(100-odsContractsDISCOUNT.Value)/100
                                          ,odsContractsPRICE.Value)
end;

