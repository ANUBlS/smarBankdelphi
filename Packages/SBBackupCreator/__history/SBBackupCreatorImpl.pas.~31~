   erase(f);
   end;
end;

function  TSBBackupCreatorMainForm.BuildBackupFileName;
var
  Today : TDate;
begin
  Today := Trunc(Now);
  Result := 'exp' + FormatDateTime('dd-mm-yyyy',Today);
end;

procedure TSBBackupCreatorMainForm.ActiveFormCreate(Sender: TObject);
begin
  CBExportMode.ItemIndex := 0;
  SaveDlg.FileName := BuildBackupFileName;
  SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);
end;

procedure TSBBackupCreatorMainForm.SBBrowseClick(Sender: TObject);
begin
  if SaveDlg.Execute then
  ArchiveFilePathEdit.Text := SaveDlg.FileName
end;

procedure TSBBackupCreatorMainForm.Button1Click(Sender: TObject);
const
  constUserID = 'userid=%s/%s@%s ';
  constFileName = 'file=(%s) ';
  constOwner = 'owner=(%s) ';
  constFullDataBase = 'full=%s ';
var
  CommandLine : String;
  //lpCmdLine : PAnsiChar; //array [byte] of Char;
 begin
  CommandLine := 'exp ';
  with sboapiDataModule.SBSession do
  begin
    CommandLine := CommandLine + Format(constUserID,[LogonUsername,LogonPassword,LogonDatabase]);
    CommandLine := CommandLine + Format(constFileName,[''''+ArchiveFilePathEdit.Text+'''']);
    if CBExportMode.ItemIndex > 0 then
    CommandLine := CommandLine + Format(constFullDataBase,['Y'])
    else
    CommandLine := CommandLine + Format(constOwner,[''''+LogonUsername+'''']);

   AssignFile(f, 'backup_file.bat');
   rewrite(f);
   writeln(f,CommandLine);
   closefile(f);

 ShellExecute(0, nil,  'backup_file.bat', nil, nil, SW_SHOWNORMAL);
     timer1.Enabled:=True;

   end;
end;

