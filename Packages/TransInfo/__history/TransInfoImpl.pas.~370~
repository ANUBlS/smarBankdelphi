 begin
 isOK:=False;
 with DM.ODS_TransInfo do
   begin
   Close;
   SetVariable('v_TransID',v_trID);
   Open;
   Edit;
  {transid,submission_code, entity_reference, fiu_ref_number}

   FieldByName('report_code').AsString:=DBLCB_mmx_reportcode.Keyvalue;
   FieldByName('reason').AsString:=Reason_Memo.Text;
   FieldByName('transmode_code').asString:=DBLCB_mmx_transmode.KeyValue;
   FieldByName('transmode_comment').asString:=Memo_transmode_comment.Text;
   FieldByName('from_funds_code').asString:=DBLCB_mmx_fromfunds.KeyValue;
   FieldByName('from_funds_comment').asString:=Memo_fromfundsComment.Text;
   FieldByName('to_funds_code').asString:=DBLCB_mmx_tofunds.KeyValue;
   FieldByName('to_funds_comment').asString:=Memo_tofundsComment.Text;
   FieldByName('contact_type').asString:=DBLCB_mmx_contact_type.KeyValue;
   FieldByName('itemadress').asString:=Edit_ItemAdress.Text;
   FieldByName('itemcountry').asString:=DBLCB_ItemCountry.KeyValue;
   FieldByName('itemcity').asString:=DBLCB_ItemCity.KeyValue;
   FieldByName('itemstate').asString:=Edit_ItemState.Text;
   FieldByName('itemzip').asString:=Edit_ItemZip.Text;
   FieldByName('item_type').asString:=DBLCB_mmx_transaction_item_type.KeyValue;
   FieldByName('item_make').asString:=Edit_ItemMake.Text;
   FieldByName('description').asString:=Memo_ItemDesc.Text;
   FieldByName('previously_registered_to').asString:=Edit_previously_registered_to.Text;
   FieldByName('presently_registered_to').asString:=Edit_presently_registered_to.Text;
   FieldByName('estimated_value').asFloat:=Edit_estimated_value.Value;
   FieldByName('status_code').asString:=DBLCB_MMX_TRANS_ITEM_STATUS.KeyValue;
   FieldByName('status_comments').asString:=Memo_status_comments.Text;
   FieldByName('disposed_value').asFloat:=Edit_disposed_value.Value;
   FieldByName('item_size').asString:=Edit_item_size.Text;
   FieldByName('item_size_uom').asString:=Edit_item_size_uom.Text;
   FieldByName('item_registration_date').asDateTime:=DTP_item_registration_date.DateTime;
   FieldByName('item_registration_number').asString:=Edit_registration_number.Text;
   FieldByName('item_identification_number').asString:=Edit_Identification_number.Text;
   FieldByName('item_comments').asString:=Memo_ItemComments.Text;
   Post;
   end;
    isOK:=True;
  end;

initialization

TransInfo := TTransInfo.Create(commonapplication);

