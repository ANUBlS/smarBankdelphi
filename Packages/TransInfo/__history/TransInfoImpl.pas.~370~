 procedure TTransInfo.SaveTransInfo;
 begin
   isOk:=False;
  if not (DBLCB_mmx_reportcode.KeyValue = null) then
    p_reportcode := DBLCB_mmx_reportcode.KeyValue
   else
  begin
    showmessage('Məlumatın növü daxil edilməlidir!');
    Exit;
   // p_reportcode := '';
  end;

  if DM.ODS_mmx_reportcodeNAME.Text='STR' then
  if trim(Reason_Memo.Text) <> '' then
  p_Reason := Reason_Memo.Text
  else
  begin
  showmessage('Məlumatın göndərilməsi üçün səbəbin nə olduğunu daxil edilməlidir!');
  Exit;
  end;

  if not (DBLCB_mmx_transmode.KeyValue = null) then
    p_transmode_code := DBLCB_mmx_transmode.KeyValue
  else
  begin
    showmessage('Əməliyyatın növü daxil edilməlidir!');
    Exit;
   //p_transmode_code := null;
  end;

  if DM.ODS_mmx_transmodeNAME.AsInteger=9999 then
   if trim(Memo_transmode_comment.Text) <> '' then
   p_transmode_comment := Memo_transmode_comment.Text
  else
  begin
  showmessage('Əməliyyatın növünün izahı daxil edilməlidir!');
  Exit;
  end;

  if not (DBLCB_mmx_fromfunds.KeyValue = null) then
    p_fromfunds_code := DBLCB_mmx_fromfunds.KeyValue
  else
  begin
    showmessage('Əməliyyatın predmeti olan vəsaitlərin növü daxil edilməlidir!');
    Exit;
//    p_fromfunds_code := '';
  end;

   if DM.ODS_mmx_fromfundsSYMBOL.Text='O' then
  if trim(Memo_fromfundsComment.Text) <> '' then
  p_fromfundsComment := Memo_fromfundsComment.Text
  else
  begin
  showmessage('Vəsaitin növünün izahı daxil edilməlidir!');
  Exit;
  end;

   if not (DBLCB_mmx_tofunds.KeyValue = null) then
    p_tofunds_code := DBLCB_mmx_tofunds.KeyValue
  else
   begin
    showmessage('Əməliyyatın predmeti olan vəsaitlərin növü daxil edilməlidir!');
    Exit;
//  p_tofunds_code := '';
   end;


  if DM.ODS_mmx_tofundsSYMBOL.Text='O' then
    if trim(Memo_tofundsComment.Text) <> '' then
    p_tofundsComment := Memo_tofundsComment.Text
    else
    begin
    showmessage('Vəsaitin növünün izahı daxil edilməlidir!');
    Exit;
    end;

  if not (DBLCB_mmx_contact_type.KeyValue = null) then
    p_contact_type := DBLCB_mmx_contact_type.KeyValue
  else
   begin
    showmessage('Əşyanın yerləşdiyi adress tipi daxil edilməlidir!');
    Exit;
//  p_contact_type := '';
   end;

  p_ItemAdress := Edit_ItemAdress.Text;

   if not (DBLCB_ItemCountry.KeyValue = null) then
    p_ItemCountry := DBLCB_ItemCountry.KeyValue
  else
  begin
    showmessage('Ölkə daxil edilməlidir!');
    Exit;
//  p_ItemCountry := '';
   end;

   {  if not (DBLCB_ItemCity.KeyValue = null) then
    p_ItemCity := DBLCB_ItemCity.KeyValue
  else
    p_ItemCity := -1;  }
    p_ItemCity:=DM.ODS_Cityes.FieldByName('city_name').AsString;

  p_ItemState := Edit_ItemState.Text;
  p_ItemZip := Edit_ItemZip.Text;

   if not (DBLCB_mmx_transaction_item_type.KeyValue = null) then
    p_transaction_item_type := DBLCB_mmx_transaction_item_type.KeyValue
  else
  begin
    showmessage('Əşyanın növü daxil edilməlidir!');
    Exit;
//      p_transaction_item_type := '';
   end;

  p_ItemMake := Edit_ItemMake.Text;
  p_ItemDesc := Memo_ItemDesc.Text;
  p_previously_registered_to := Edit_previously_registered_to.Text;
  p_presently_registered_to := Edit_presently_registered_to.Text;

  p_estimated_value := Edit_estimated_value.Value;

   if not (DBLCB_MMX_TRANS_ITEM_STATUS.KeyValue = null) then
    p_TRANS_ITEM_STATUS := DBLCB_MMX_TRANS_ITEM_STATUS.KeyValue
  else
  begin
    showmessage('Əşyanın statusu daxil edilməlidir!');
    Exit;
//    p_TRANS_ITEM_STATUS := '';
  end;

  p_status_comments := Memo_status_comments.Text;
  p_disposed_value := Edit_disposed_value.Value;
  p_item_size := strtofloat(Edit_item_size.Text);
  p_item_size_uom := Edit_item_size_uom.Text;
  p_item_registration_date := DTP_item_registration_date.Date;
  p_registration_number := Edit_registration_number.Text;
  p_Identification_number := Edit_Identification_number.Text;
  p_ItemComments := Memo_ItemComments.Text;
  p_transaction_id:=-1;
  isOk:=True;
 end;

