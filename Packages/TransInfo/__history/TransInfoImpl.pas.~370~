procedure TTransInfo.BitBtn1Click(Sender: TObject);
begin
if isEdit=True then
begin
UpdateTransInfo;
  if isOK then
  begin
  ClearAmmounts;
  TransInfo.Close;
  end;
end
else
begin
SaveTransInfo;
  if isOK then
  begin
  ClearAmmounts;
  TransInfo.Close;
  end;
end;
end;

procedure TTransInfo.BtnCancelClick(Sender: TObject);
begin
clearAmmounts;
