unit frmReferencesImpl_new;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,OracleData,
  Db, ComCtrls,Oracle, StdCtrls, Grids, DBGrids, DBCtrls, ExtCtrls;

type
  TfrmReferences_new = class(TForm)
    GroupBox1: TGroupBox;
    ValuesComboBox: TComboBox;
    ValuesEdit: TEdit;
    BtnApply: TButton;
    GroupBox2: TGroupBox;
    TV: TTreeView;
    StatusBar: TStatusBar;
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
  private
     procedure TVBuild;
    procedure TVAddNode(Node :TTreeNode;ID :Integer);
  public
       TreeItems :TList;
  end;

var
  frmReferences_new: TfrmReferences_new;

implementation

{$R *.dfm}
    uses DMReferences_new,SBTranslateProc,sboapiDataModuleimpl;

    procedure TFrmReferences_new.TVBuild;
begin
   TV.Items.Clear;
   TVAddNode(nil,-1);
   DataModReferences_new.ReferLink.Refresh;
end;
procedure TfrmReferences_new.FormCreate(Sender: TObject);
begin
   DataModReferences_new :=TDataModReferences_new.Create(Self);
   TreeItems :=TList.Create;
   SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TfrmReferences_new.FormDestroy(Sender: TObject);
begin
  TreeItems.Free;
end;

procedure TFrmReferences_new.TVAddNode(Node :TTreeNode;ID :Integer);
begin
    with  TOracleDataSet.Create(nil)  do
    try
      Session :=DataModReferences_new.TVSubItems.Session;
      SQL.Assign(DataModReferences_new.TVSubItems.SQL);
      DeclareVariable('ParentID',otInteger);
      SetVariable('ParentID',ID);
      Open;
      First;
      while  not EOF  do
      begin
        TreeItems.Add(Pointer(FieldByName('ID').AsInteger));
        TVAddNode(TV.Items.AddChild(Node,FieldByName('LName').AsString),FieldByName('ID').AsInteger);
        Next;
      end;
    finally
      Free;
    end;
end;
end.
