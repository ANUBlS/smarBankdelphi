procedure TQK_Import.ToolButton9Click(Sender: TObject);
 var
  SelectedRowsCnt, i: Integer;
   IDs: WideString;
   Status, TrCount: Word;
begin
    with XDBGrid1, DataSource.DataSet do
  begin

    SelectedRowsCnt := SelectedRows.Count;

    if SelectedRowsCnt > 1 then
    begin
    if MessageDlg(Format(inttostr(SelectedRowsCnt)+'  sayda  əməliyyat silinsinmi ? ', []),
      mtConfirmation, [mbYes, mbCancel], 0) = mrYes then

      for I := 0 to SelectedRowsCnt - 1 do
      begin

        GotoBookmark(Pointer(SelectedRows[I]));

     QKİmportDataMod.qk_accsettings.CallProcedure('del_QK_import',
     [QKİmportDataMod.ODS_qk_import.FieldByName('c').AsString]);

     end;

    end else
    begin
     if MessageDlg(Format(inttostr(SelectedRowsCnt)+'  sayda  əməliyyat silinsinmi ? ', []),
     mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
     QKİmportDataMod.qk_accsettings.CallProcedure('del_QK_import',
     [QKİmportDataMod.ODS_qk_import.FieldByName('c').AsString]);

  end;
  end;

   QKİmportDataMod.ODS_QK_import.Refresh;

end;

