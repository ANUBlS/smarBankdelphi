procedure TIncomeForm.Action_SrcExecute(Sender: TObject);
begin
 with QKİmportDataMod,Ods_FormIncomeAcc do
 begin
   if EditBal_Cn.Text<>'' then
   SQL[10] := 'and b.bal_cn like (''%' +
      EditBal_Cn.Text + '%'')'
      else
   SQL[10] := '';

  if EditAcc_No.Text <> '' then
    SQL[11] := 'and  nvl(upper(a.ACC_NO),0) like upper(''%' +
      EditAcc_No.Text + '%'')'
  else
    SQL[11] := '';

  if EditName.Text <> '' then
    SQL[12] := 'and nvl(upper(a.name),0) like upper(''%' +
      EditName.Text + '%'')'
  else
    SQL[12] := '';
   //nvl(upper(Cust_Name),0) like upper
 Refresh;

 end;
end;





