{var
  AccID: Integer;}
begin
  with AccountDataModule.Accounts.DataSet do
  begin
    Edit;
//    AccID := FieldByName('AccID').AsInteger;
    FillCBL(true,FieldByName('AccFlags').AsString);
//    ArestedButton.Down := Sb_GetAccountFlag(AccID, 'Arested');
//    OverdraftButton.Down := Sb_GetAccountFlag(AccID, 'Overdraft');
    OpenDateEdit.DateTime := Int(FieldByName('OpenDate').AsDateTime);
  end;
  FIsChanged := False;
  ShowModal;
