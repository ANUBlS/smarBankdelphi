end;

procedure TAccountPropertiesForm.FillCBL;
var
  I : Integer;
begin
 // ShowMessage(AccFlags+ ' ------  > Oooooo!!!!!!!');
  with  AccountDataModule.AccFlagsData do
  begin
    First;
    AccFlagsForm.CLBAccFlags.Items.Clear;
    while not EOF do
    begin
      with AccFlagsForm.CLBAccFlags do
      I :=Items.Add(FieldByName('Symbol').AsString+' - '+FieldByName('Description').AsString);
      if FillAndCheck and FlagExsist(AccFlags,FieldByName('Symbol').AsString[1]) then
      AccFlagsForm.CLBAccFlags.Checked[I] := True;
      Next;
    end;

  end;
end;

procedure TAccountPropertiesForm.FormKeyPress(Sender: TObject;
  var Key: Char);
