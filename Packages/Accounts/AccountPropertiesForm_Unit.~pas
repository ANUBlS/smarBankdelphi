procedure TAccountPropertiesForm.OkButtonClick(Sender: TObject);

  procedure CheckFields;
  const
    sDefEmptyFieldMessage = '"%s" сащясиня гиймят дахил олунмайыб';

    procedure ShowMessage(const Message: String);
    begin
      ErrorHint.ShowMessage(Message);
      Abort;
    end;

    procedure Check(
      Field: TField;
      Message: String = sDefEmptyFieldMessage;
      FieldName: String = '');
    begin
      if Field.IsNull then
      begin
        if FieldName = '' then
          FieldName := Field.DisplayName;
        Message := Format(Message, [FieldName]);
        ShowMessage(Message);
      end;
    end;

    procedure CheckByName(const FieldName: String);
    begin
      with AccountDataModule.AccountsData do
        Check(FieldByName(FieldName));
    end;

    procedure CheckByNames(const Names: array of String);
    var
      Index: Integer;
    begin
      for Index := Low(Names) to High(Names) do
        CheckByName(Names[Index]);
    end;

  begin
    CheckByNames(['AccNo', 'CurrencyID', 'SAcc', 'CustomerID', 'AccName']);
  end;

{var
  LastAccountID: Integer;}
begin
  CheckFields;
  FIsChanged := True;
  with AccountDataModule.AccountsData do
  begin
    FieldByName('OpenDate').AsDateTime := Trunc(OpenDateEdit.DateTime);
    Post;
    ApplyUpdates([aaInsert, aaUpdate]);
    CommitUpdates;
 {   with FieldByName('AccID') do
      if IsNull then
        LastAccountID := AccountDataModule.LastAccountID
      else
        LastAccountID := Value;}
//    Sb_SetAccountFlag(LastAccountID, 'Arested', ArestedButton.Down);
//    Sb_SetAccountFlag(LastAccountID, 'Overdraft', OverdraftButton.Down);
  end;
  Close;
end;

