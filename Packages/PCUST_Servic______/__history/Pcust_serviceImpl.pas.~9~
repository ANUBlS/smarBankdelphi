procedure TPcust_ServiceForm.createfiles;
var
  formattedDateTime, dir: String;
begin
  if not DirectoryExists(DMgoAml.ODS_FilesPathDESCRIPTION.AsWideString) then
    MkDir(DMgoAml.ODS_FilesPathDESCRIPTION.AsWideString);

  DateTimeToString(formattedDateTime, 'yyyyddmm', DTP1.Date);
  dir := DMgoAml.ODS_FilesPathDESCRIPTION.AsWideString +
    formattedDateTime + '\';

  if not DirectoryExists(dir) then
    MkDir(dir);

  DateTimeToString(formattedDateTime, 'yyyyddmm', DTP1.Date);
  FilePAth := dir + dey+'_'+ dey1
   + '.xml';
  AssignFile(f, FilePAth);
  Rewrite(f);
  Closefile(f);
  CreateXmlFile;

end;
procedure TPcust_ServiceForm.WriteLnString(S: string);
begin

  AssignFile(f, FilePAth); { Assigns the Filename }
  Append(f); { Opens the file for editing }
  Writeln(f, UTF8Encode(StringReplace(S, #13 + #10, '', [rfReplaceAll])));
  Closefile(f);
end;
procedure TPcust_ServiceForm.WriteString(S: string);
begin

  AssignFile(f, FilePAth); { Assigns the Filename }
  Append(f); { Opens the file for editing }
  Write(f, UTF8Encode(StringReplace(S, #13 + #10, '', [rfReplaceAll])));
  Closefile(f);
end;
