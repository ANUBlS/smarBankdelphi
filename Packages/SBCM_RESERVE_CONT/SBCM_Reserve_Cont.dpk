package SBCM_Reserve_Cont;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart Credit Managment :Reserve Controller'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  SBCommon50,
  SBCMCreditTranches,
  SBCMStorage,
  doa,
  sboapi50;

contains
  ReserveContUnit in 'ReserveContUnit.pas' {FrmReserveCont},
  ReserveDataModUnit in 'ReserveDataModUnit.pas' {DataModReserve: TDataModule};

end.
