procedure TFrmTodayBalance.ViewReport;
begin
  case Index of
  0 :

      with BalanceRpt1 ,DataSet do
      begin
        Filter := '(Active <> 0) or (Passive <> 0)';
        Filtered := True;
        TargetDate.Caption := FormatDateTime('dd/mm/yyyy',DTPTargetDate.DateTime);
        QRCurr.Caption :=Currencys.Text;
        Preview;
        Filtered := False;
      end;

  1 :

      with BalanceRpt2 ,DataSet do
      begin
        Filter := '(Active <> 0) or (Passive <> 0)';
        Filtered := True;
        TargetDate.Caption := FormatDateTime('dd/mm/yyyy',DTPTargetDate.DateTime);
        QRCurr.Caption :=Currencys.Text;
        Preview;
        Filtered := False;
      end;

  2 :

      with BalanceRpt3 ,DataSet do
      begin
        Filter := '(Active <> 0) or (Passive <> 0) or (DTurnOver <> 0) or (CTurnOver <> 0)';
        Filtered := True;
        TargetDate.Caption := FormatDateTime('dd/mm/yyyy',DTPTargetDate.DateTime);
        QRCurr.Caption :=Currencys.Text;
        Preview;

        Filtered := False;
      end;

  end; //case
end;

procedure TFrmTodayBalance.Transaction_Selections;
begin
  with Out_balancedatamodule.TransactionsData do
  begin
    SQL.CommaText := FTransactionsDataSQL;
    if Trunc(DTPTargetDate.DateTime) = CurrentBankDate then
      SQL[15] := Format(SQL[15] ,['Provdoc']) else
      SQL[15] := Format(SQL[15] ,['Provarch']);
   // LogMemo.Lines := SQL;
  end;
end;

procedure TFrmTodayBalance.Account_Selections;
begin
  with out_balancedatamodule.AccountData do
  begin
    SQL.CommaText := FAccountDataSQL;
    if AmountType = atExsistCurrency then
    begin
      SQL[4] := Format(SQL[4] ,['']);
      SQL[10] := Format(SQL[10] ,['']);
      SQL[17] := Format(SQL[17] ,['']);
      SQL[18] := Format(SQL[18] ,['']);
    end  else
    begin
      SQL[4] := Format(SQL[4] ,['Pok_']);
      SQL[10] := Format(SQL[10] ,['Pok_']);
      SQL[17] := Format(SQL[17] ,['Pok_']);
      SQL[18] := Format(SQL[18] ,['Pok_']);
    end;
    if Trunc(DTPTargetDate.DateTime) = CurrentBankDate then
      SQL[21] := Format(SQL[21] ,['Tenostat']) else
      SQL[21] := Format(SQL[21] ,['Archost']);
    if BranchID = -1 then
      SQL[26] := '' else
      SQL[26] := Format(SQL[26] ,[BranchID]);
    if CurrencyID = -1 then
      SQL[27] := '' else
      SQL[27] := Format(SQL[27] ,[CurrencyID]);
   // LogMemo.Lines := SQL;
  end;
end;

procedure TFrmTodayBalance.Balance_Selections;
begin
  with out_balancedatamodule.BalanceData do
  begin
    SQL.CommaText := FBalanceDataSQL;
    if AmountType = atExsistCurrency then
    begin
      SQL[4] := Format(SQL[4] ,['']);
      SQL[11] := Format(SQL[11] ,['']);
      SQL[16] := Format(SQL[16] ,['']);
      SQL[17] := Format(SQL[17] ,['']);
    end  else
    begin
      SQL[4] := Format(SQL[4] ,['Pok_']);
      SQL[11] := Format(SQL[11] ,['Pok_']);
      SQL[16] := Format(SQL[16] ,['Pok_']);
      SQL[17] := Format(SQL[17] ,['Pok_']);
    end;
    if Trunc(DTPTargetDate.DateTime) = CurrentBankDate then
      SQL[20] := Format(SQL[20] ,['Tenostat']) else
      SQL[20] := Format(SQL[20] ,['Archost']);
    if BranchID = -1 then
      SQL[24] := '' else
      SQL[24] := Format(SQL[24] ,[BranchID]);
    if CurrencyID = -1 then
      SQL[25] := '' else
      SQL[25] := Format(SQL[25] ,[CurrencyID]);
    if Trim(AccountList) = '' then
      SQL[26] := '' else
      SQL[26] := Format(SQL[26] ,[AccountList]);
   // LogMemo.Lines := SQL;
  end;

end;


