procedure TFrmTodayBalance.SBExecuteClick(Sender: TObject);
function Get_BankWorkDate(RealDate : TDateTime) : TDateTime;
begin
  with out_balancedatamodule.WorkDateData do
  begin
    ClearVariables;
    SetVariable('RealDate',RealDate);
    Open;
    Result := Integer(Trunc(FieldByName('WorkDate').AsDateTime));
    CloseAll;// Showmessage('knn');
  end;
end;

var
  CurrencyID , BranchID :Integer;
  AccountList : WideString;
  AmountType : TAmountType;
  BankWorkDate : TDateTime;
begin
  with Currencys,DataSource.DataSet do
    if ItemIndex > 0 then
      CurrencyID := FieldByName('Currency').AsInteger else
      CurrencyID := -1;
  with Branches ,DataSource.DataSet do
  if ItemIndex > 0 then
    BranchID := FieldByName('BranchID').AsInteger else
    BranchID := -1;
  if (CurrencyID <> -1) and (CBAmountType.ItemIndex = 0)  then
    AmountType := atExsistCurrency else
    AmountType := atNationalCurrency;
  AccountList := AccountsListEdit.Text;
  Screen.Cursor := crSQLWait;
  BankWorkDate :=Get_BankWorkDate(Integer(Trunc(DTPTargetDate.DateTime)));
  if Self.Modified then
  with out_balancedatamodule.BalanceData do
  try
    Balance_Selections(CurrencyID ,BranchID ,AccountList ,AmountType);
    if Active then CloseAll;
    SetVariable('TargetDate',BankWorkDate);
    Open;
  finally
    Screen.Cursor := crDefault;
  end else
  Screen.Cursor := crDefault;

  case  RGReportFormat.ItemIndex of
  0 :
        ViewReport(CBReportType.ItemIndex);
   1 :
     begin
       Screen.Cursor := crSQLWait;
       with  out_balancedatamodule do
       try
         if FAccountModified then
         begin
         with AccountData do
         begin
           Account_Selections(CurrencyID ,BranchID ,AmountType);
           if Active then CloseAll;
           SetVariable('TargetDate',BankWorkDate);
           Open;
           if CBRest.Checked then
           begin
             Filtered := False;
             Filter :='(DTurnOver <> 0) or (CTurnOver <> 0) or (Active <> 0) or (Passive <> 0)';
             Filtered := True;
           end else
             Filtered := False;
         end;
         with out_balancedatamodule.TransactionsData do
         begin
           Transaction_Selections;
           if Active then CloseAll;
           SetVariable('TargetDate',BankWorkDate);
           Open;
         end;
         end;  // if Modified
         FAccountModified := False;
         Screen.Cursor := crDefault;
         with FrmBalanceChecking do
         begin
           STTargetDate.Caption := FormatDateTime('dd/mm/yyyy',BankWorkDate);
           STCurrency.Caption := Currencys.Text;
           STBranch.Caption := Branches.Text;
           STCurrFormat.Caption := CBAmountType.Text;
           ShowModal
         end;
       finally
         Screen.Cursor := crDefault;
       end;
     end;
  2 :
     BalanceExporter.Report;
  end; //case
  Modified := False;
end;   

procedure TFrmTodayBalance.ActiveFormCreate(Sender: TObject);
begin
  out_balancedatamodule := Tout_balancedatamodule.Create(Self);
  FrmBalanceChecking := TFrmBalanceChecking.Create(Self);
  BalanceRpt1 := TBalanceRpt1.Create(Self);
  BalanceRpt2 := TBalanceRpt2.Create(Self);
  BalanceRpt3 := TBalanceRpt3.Create(Self);
  with out_balancedatamodule do
  begin
    FBalanceDataSQL := BalanceData.SQL.CommaText;
    FAccountDataSQL := AccountData.SQL.CommaText;
    FTransactionsDataSQL := TransactionsData.SQL.CommaText;
    SYSDAT.Open;
    CurrencyInfo.Open;
    BranchesInfo.Open;
    BankInfo.Open;
    FCurrentBankDate := Integer(Trunc(SYSDAT.FieldByName('CurrentDate').AsDateTime));
  end;
    Currencys.ItemIndex := 0;
    Branches.ItemIndex := 0;
    CBAmountType.ItemIndex := 0;
    CBReportType.ItemIndex := 0;
    DTPTargetDate.DateTime := CurrentBankDate;
    Modified := True;
    FAccountModified := True;
  SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);
end;

