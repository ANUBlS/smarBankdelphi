      '  SUM ('
      '     out_sb_mtoutview.passiv ('
      '        ar.%sostat,           /*11*/'
      '        b.typeid,'
      '        b.additionaltypeid'
      '     )'
      '  ) Passive,'
      '  SUM (ar.%sObr_D) as DTurnOver , /*16*/'
      '  SUM (ar.%sObr_K) as CTurnOver , /*17*/'
      '  MIN (b.balname) as AccountName'
      'from'
      '  out_archost ar ,        /*20*/'
      '  out_account ac ,'
      '  out_bal_spr1 b'
      'where'
      ' (ac.filial = %d) and        /*24  -- Branch   */'
      ' (ac.val_acc = %d) and       /*25  -- Currency */'
      ' (ac.bal_cn1 in (%s)) and    /*26  -- By Selected Accounts */'
      ' (ar.acc_id = ac.id) and'
      ' (ac.bal_cn1 = b.bal_cn) and'
      ' (ar.datdate = :TargetDate)'
      'group by b.bal_cn'
