procedure TFormRelatedPersons.ActiveFormCreate(Sender: TObject);
var
i:integer;
begin
  shortdateformat:='dd.mm.yyyy';
  sysdat.Open;
  date1.Date:=trunc(sysdat.fieldbyname('tek_dat').asdatetime);
  date2.Date:=date1.Date;
  prinad.open;
  prinad.First;
  for i:=1 to prinad.RecordCount do
  begin
  cb.Items.Add(prinad.fieldbyname('name').asstring);
  memo1.Lines.Add(prinad.fieldbyname('ID').asstring);
  prinad.Next;
  end;
  cb.ItemIndex:=0;

  SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);
end;

