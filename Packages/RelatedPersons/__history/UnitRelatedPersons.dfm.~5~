  object qal: TOracleDataSet
    SQL.Strings = (
      'select'
      
        '  RestForLastPeriod.AccountID ,RestForLastPeriod.name_1 as name_' +
        '1,'
      
        '  RestForLastPeriod.AccNo , RestForLastPeriod.AccName as ACC_NAM' +
        'E ,'
      '  RestForLastPeriod.CurrencyID ,'
      '  RestForLastPeriod.BranchID ,'
      '  RestForLastPeriod.BalanceNo ,'
      '  RestForFirstPeriod.Active as BeginActive ,'
      '  RestForFirstPeriod.Passive as BeginPassive ,'
      '  RestForFirstPeriod.LActive as LBeginActive ,'
      '  RestForFirstPeriod.LPassive as LBeginPassive ,'
      '  TurnOvers.DTurnOver ,'
      '  TurnOvers.CTurnOver ,'
      '  TurnOvers.LDTurnOver ,'
      '  TurnOvers.LCTurnOver ,'
      '  RestForLastPeriod.Active as EndActive ,'
      '  RestForLastPeriod.Passive as EndPassive ,'
      '  RestForLastPeriod.LActive as LEndActive ,'
      '  RestForLastPeriod.LPassive as LEndPassive'
      'from'
      ''
      '(select'
      '  ac.ID as AccountID ,'
      '  ac.acc_no as AccNo ,'
      '  b.bal_cn  as BalanceNo ,'
      ''
      '  sb_mtoutview.active ('
      '    ar.ostat,'
      '    b.typeid,'
      '    b.additionaltypeid'
      '  ) as Active ,'
      ''
      '  sb_mtoutview.passiv ('
      '     ar.ostat,'
      '     b.typeid,'
      '     b.additionaltypeid'
      '  ) as Passive ,'
      ''
      '  sb_mtoutview.active ('
      '    ar.pok_ostat,'
      '    b.typeid,'
      '    b.additionaltypeid'
      '  ) as LActive ,'
      ''
      '  sb_mtoutview.passiv ('
      '     ar.pok_ostat,'
      '     b.typeid,'
      '     b.additionaltypeid'
      '  ) as LPassive'
      ''
      'from'
      '  account ac ,'
      '  archost ar ,'
      '  bal_spr1  b  /*52*/'
      'where'
      '  ar.acc_id = ac.id and'
      '  ac.bal_cn1 = b.bal_cn and     /*55*/'
      '  ar.DatDate = :BeginPeriod  and'
      '  ((ac.Close_Dat is null)or(ac.Close_Dat > :BeginPeriod))'
      ') RestForFirstPeriod ,'
      ''
      '(select'
      '  ac.ID as AccountID , sb_mtoutview.prinadof(ac.id) as name_1,'
      '  ac.acc_no as AccNo , ac.name as AccName ,'
      '  ac.val_acc as CurrencyID ,'
      '  ac.filial as BranchID ,'
      '  b.bal_cn  as BalanceNo ,'
      ''
      '  sb_mtoutview.active ('
      '    ar.ostat,'
      '    b.typeid,'
      '    b.additionaltypeid'
      '  ) as Active ,'
      ''
      '  sb_mtoutview.passiv ('
      '     ar.ostat,'
      '     b.typeid,'
      '     b.additionaltypeid'
      '  ) as Passive ,'
      ''
      '  sb_mtoutview.active ('
      '    ar.pok_ostat,'
      '    b.typeid,'
      '    b.additionaltypeid'
      '  ) as LActive ,'
      ''
      '  sb_mtoutview.passiv ('
      '     ar.pok_ostat,'
      '     b.typeid,'
      '     b.additionaltypeid'
      '  ) as LPassive'
      ''
      'from'
      '  account ac ,'
      '  archost ar ,'
      '  bal_spr1   b  /*94*/'
      'where'
      '  ar.acc_id = ac.id and'
      '  ac.bal_cn1 = b.bal_cn  and  /*97*/'
      '  ar.DatDate = :EndDate  and'
      ' ((ac.Close_Dat is null)or(ac.Close_Dat > :BeginPeriod))'
      ') RestForLastPeriod ,'
      ''
      '(select'
      '  ac.ID as AccountID ,'
      '  min(ac.acc_no) as AccNo,'
      '  min(b.bal_cn)  as BalanceNo ,'
      '  sum(ar.Obr_D) as DTurnOver ,'
      '  sum(ar.Obr_K) as CTurnOver ,'
      '  sum(ar.Pok_Obr_D) as LDTurnOver ,'
      '  sum(ar.Pok_Obr_K) as LCTurnOver'
      ''
      'from'
      '  account ac ,'
      '  archost ar ,'
      '  bal_spr1   b  /*114*/'
      'where'
      '  ar.acc_id = ac.id and'
      '  ac.bal_cn1 = b.bal_cn  and /*117*/'
      '  ar.DatDate between :BeginDate and :EndDate'
      'group by'
      '  ac.ID'
      ') TurnOvers'
      ''
      'where'
      
        '   RestForLastPeriod.AccountID = RestForFirstPeriod.AccountID  (' +
        '+) and'
      '   RestForLastPeriod.AccountID = TurnOvers.AccountID'
      ''
      'order by'
      '  RestForLastPeriod.name_1,RestForLastPeriod.AccName'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
