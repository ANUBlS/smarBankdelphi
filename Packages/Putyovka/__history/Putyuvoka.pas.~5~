procedure TPutyukova.ExpXLS(DataSet: TDataSet; Arq: string; status:integer; Sh:string);
var
  ExcApp: OleVariant;
  i,l: integer;
begin
  ExcApp := CreateOleObject('Excel.Application');
  ExcApp.Visible := False;
  ExcApp.WorkBooks.Add;
  DataSet.First;
  l := 2;
  DataSet.First;
  while not DataSet.EOF do
  begin
    for i := 0 to DataSet.Fields.Count - 1 do
      ExcApp.WorkBooks[1].Sheets[1].Cells[l,i + 1] :=
        DataSet.Fields[i].DisplayText;
    DataSet.Next;
    l := l + 1;
  end;
  ExcApp.DisplayAlerts := False;
  ExcApp.WorkBooks[1].Sheets[1].name:=Sh;
  ExcApp.WorkBooks[1].SaveAs(Arq);
  IF par=1 THEN ExcApp.Quit
           ELSE ExcApp.Visible := True;
end;






