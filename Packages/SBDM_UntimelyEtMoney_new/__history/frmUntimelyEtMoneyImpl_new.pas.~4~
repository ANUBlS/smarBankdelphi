  if ord(Key) = VK_ESCAPE then Close
end;

procedure TfrmUntimelyEtMoney_new.FormShow(Sender: TObject);
begin
   DTPCalcPercent.DateTime := DepositInfo.FieldByName('OpenDate').AsDateTime;
   DTPBankDate.DateTime := Get_BankDate;
end;

