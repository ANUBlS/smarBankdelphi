    BankInfoBANK: TStringField;
    BankInfoLOGO: TBlobField;
    ReferDataSet: TOracleDataSet;
    DataSrcRefer: TDataSource;
    UsersList: TOracleDataSet;
    UsersListID: TFloatField;
    UsersListNAME: TStringField;
