procedure TTransactionManagerForm.ActionDeleteExecute(Sender: TObject);
var
   Index :Integer;
   WaitNextConfirm, WillRefresh: Boolean;
   TransactionID :Integer;
begin
if GridTransactions.DataSource.DataSet.FieldByName('status').AsInteger=1
then
TransactionDataModule.SB_ACA.CallProcedure('checkadvancedobjectaccess',['DELAYEDDELETE']);

if GridTransactions.DataSource.DataSet.FieldByName('status').AsInteger=2
then
TransactionDataModule.SB_ACA.CallProcedure('checkadvancedobjectaccess',['COMMITEDDELETE']);

 TransactionDataModule.SB_ACA.CallProcedure('CheckObjectAccess', ['TransactionManager','delete']);
  WaitNextConfirm :=True;
  WillRefresh :=False;
  Focus;
  with  GridTransactions, SelectedRows, DataSource.DataSet, TransactionDataModule do
  try
    if Count = 0 then CurrentRowSelected := True;
    for  Index :=0 to  Count - 1 do
    begin
      GotoBookmark(Pointer(Items[Index]));
      TransactionID :=FieldbyName('ID').AsInteger;

      if  WaitNextConfirm  then
      case MessageDlg(
        Format('Əməliyyat #%d silinsin?',[TransactionID])
       ,mtConfirmation
       ,[mbYes, mbNo ,mbCancel ,mbYesToAll]
       ,0
       )   of
        mrNo       : Continue;
        mrCancel   : Break;
        mrYesToAll :
          if MessageDlg(Format('%d sayda əməliyyat silinsin?', [Count - Index]), mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
           WaitNextConfirm :=False
          else
           Continue;
      end;
      Application.ProcessMessages;

      with ODS_VidOPTrDel do begin {H.R. 04.10.2010}
       Close;
       SetVariable('v_ID', GridTransactions.DataSource.DataSet.FieldByName('OperationCode').AsInteger);
       Open;
      end;
      if ODS_VidOPTrDel.FieldByName('Cnt').AsInteger = 1 then begin
       ShowMessage('Bu növ əməliyyatı bu moduldan silmək olmaz.');
       Continue;
      end; {*** H.R. 04.10.2010}

      if GridTransactions.SelectedRows.Count>1 then begin  {H.R. 17.03.2011}
       try
       DeleteTransaction(TransactionID);
       except
       end;
      end
      else
      begin
       DeleteTransaction(TransactionID); {*** H.R. 17.03.2011}
      end;

      WillRefresh :=True;
      SBCommit;
      TransactionState :=tsDelete;
    end;
  finally
   if WillRefresh then
    ActionRefreshExecute(Sender);
  end;
end;

