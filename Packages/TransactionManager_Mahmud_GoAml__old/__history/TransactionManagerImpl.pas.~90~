procedure TTransactionManagerForm.ActionStepCommitExecute(Sender: TObject);
var
   i: Integer;
   ID: Longint;
   WillRefresh: Boolean;
   Status, CommitedCount, ErrorCount: Word;
   LastErrorMessage: String;
begin
 CommitedCount :=0;
 ErrorCount :=0;
 WillRefresh :=False;
 with TransactionDataModule, GridTransactions, SelectedRows, DataSource.DataSet do
  if MessageDlg('Əməliyyatlar təsdiqlənsin?', mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
  begin
   DisableControls;
   try
    Application.ProcessMessages;
    if Count = 0 then CurrentRowSelected :=True;
    for i :=0 to Count -1 do
    try
     GotoBookmark(TBookmark(Items[i]));
     Status :=FieldByname('Status').AsInteger;
     if Status in [tsDelayed, tsRejected] then
     begin
      ID := FieldByName('ID').AsInteger;
      CommitTransaction(ID);
      WillRefresh :=True;
      Inc(CommitedCount);
      SBCommit();
      
      //***
      //SmSBankImpl.TransactionSMS2(ID, sboapiDataModule.OrPack_SMS);
      //***
      
     end;
     except
     on E: Exception do
      begin
       LastErrorMessage :=E.Message;
       Inc(ErrorCount);
       Continue;
      end;
    end;
   finally
    if ErrorCount > 0 then
     if ErrorCount = 1 then
      MessageDlg(LastErrorMessage, mtConfirmation, [mbOk], 0)
     else
      MessageDlg(Format(cs_CommitInformation, [CommitedCount + ErrorCount, CommitedCount, ErrorCount]), mtConfirmation, [mbOk], 0);

    EnableControls;


    if WillRefresh then
    begin
     TransactionState :=tsCommit;
     ActionRefreshExecute(Sender);
    end;

   end;
  end;
 GridTransactions.DataSource.DataSet.Locate('ID',ID,[loCaseInsensitive,loPartialKey]);

 //showmessage( SmSBankImpl.TransactionSMS(ID, sboapiDataModule.OrPack_SMS));
 //SmSBankImpl.TransactionSMS2(ID, sboapiDataModule.OrPack_SMS);      
 end;


procedure TTransactionManagerForm.ActionRejectExecute(Sender: TObject);
var
  i: integer;
  ID: Longint;
  WillRefresh: Boolean;
  RejectReason: String;
  Status, RejectedCount, ErrorCount: Word;
begin
 ErrorCount :=0;
 RejectedCount :=0;
 WillRefresh :=False;
 if InputQuery('İnkarolunma !!! ', 'Təyinat:',RejectReason ) then
  with TransactionDataModule, GridTransactions, SelectedRows, DataSource.DataSet do
  begin
   if Count = 0 then CurrentRowSelected :=True;
   for i:=0 to Count-1 do
   try
    GotoBookmark(TBookmark(Items[i]));
    Status :=FieldByname('Status').AsInteger;
    if Status in [tsDelayed, tsRejected] then
    begin
     ID :=FieldByName('ID').AsInteger;
     RejectTransaction(ID, RejectReason);
     WillRefresh :=True;
     Inc(RejectedCount);
     SBCommit();
    end;
   except
    Inc(ErrorCount);
    Continue;
   end
  end;

 if ErrorCount > 0 then
  MessageDlg(Format(cs_RejectInformation, [RejectedCount + ErrorCount, RejectedCount, ErrorCount]), mtConfirmation, [mbOk], 0);

 if WillRefresh then
  ActionRefreshExecute(Sender);


end;

