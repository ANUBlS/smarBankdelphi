procedure TTransactionManagerForm.ActionCommitExecute(Sender: TObject);
var
   i: Integer;
   IDs: WideString;
   Status, TrCount: Word;
begin
 IDs :='';
 TrCount :=0;
 with GridTransactions, SelectedRows, DataSource.DataSet do
  if Count = 0 then
   begin
    Inc(TrCount);
    IDs := FieldByName('ID').AsString;
   end
  else
  begin
   DisableControls;
   try
    for i :=0 to Count -1 do
    begin
     GotoBookmark(TBookmark(Items[i]));
     Status :=FieldByname('Status').AsInteger;
     if Status in [tsDelayed, tsRejected] then
     begin
      Inc(TrCount); 
      IDs :=IDs + ',' + FieldByName('ID').AsString;
     end;
    end;
   System.Delete(IDs, 1, 1);
   finally
    EnableControls;
   end;
  end;
  if MessageDlg(Format('%d sayda əməliyyat təsdiqlənsin?', [TrCount]), mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
  with TransactionDataModule do
  begin
   CommitTransactions(IDs);
   SBCommit();
   ActionRefreshExecute(Sender);
  end;
end;

