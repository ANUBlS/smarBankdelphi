procedure TTransactionManagerForm.ActionFilterExecute(Sender: TObject);

   function  CheckFiltred(IsChecked: Boolean; const FilterStr: String; Args: array of const): String;
   begin
    Result :='';
    if  IsChecked  then
     Result :=Format(FilterStr, Args);
   end;

   function AddBoolPrefix(WillAdd: boolean): string;
   begin
    Result :=' ';
    if WillAdd then Result :=BooleanPrefix;
   end;


  function GenerateFilter(CheckListBox: TCheckListBox; const FilterConst: string; ICount: word): string;
  var
     Position, i: word;
     Filter: string;
  begin
  Result :='';
   with CheckListBox,Items do
    begin
     Position :=0;
     if not(Count>0) then Exit;
     if not Checked[0] then
      if ICount= 1 then
       Filter :=Format(FilterConst,[StrToInt(TStringList(Pointer(Tag)^).Strings[0])])
      else
       Filter :=Format(FilterConst,[StrToInt(TStringList(Pointer(Tag)^).Strings[0]),StrToInt(TStringList(Pointer(Tag)^).Strings[0])])
     else
      Filter :='';

     for i :=1 to Items.Count -1 do
      if not Checked[i] then
       begin

        if ICount= 1 then
         Filter :=Filter + AddBoolPrefix(not Checked[Position]) + Format(FilterConst,[StrToInt(TStringList(Pointer(Tag)^).Strings[i])])
        else
         Filter :=Filter + AddBoolPrefix(not Checked[Position]) + Format(FilterConst,[StrToInt(TStringList(Pointer(Tag)^).Strings[i]),StrToInt(TStringList(Pointer(Tag)^).Strings[i])]);

        Position :=i;
       end;
    end;
    Result :=Filter;
  end;


const
   CurrencyFilter ='((DebitCurrencyID<>%d)AND(CreditCurrencyID<>%d))';
   DebetFilialFilter = '(DebitBranch=%d)';
   CreditFilialFilter = '(CreditBranch=%d)';
   OperatorFilter = '(OperatorID=%d)';
   OperationTypeFilter = '(OperationCode<>%d)';
   OperationStatus = '((Status=%d)OR(Status=%d)OR(Status=%d))';

var
   T_Delayed:  Word;
   T_Commited: Word;
   T_Rejected: Word;

   CurrencyF:        String;
   DebetFilialF:     String;
   CreditFilialF:    String;
   OperatorF:        String;
   OperationTypeF:   String;
   OperationStatusF: String;
   FilterStr:        String;

begin
 FilterStr :='';
 T_Delayed :=Word(CBDelayed.Checked)*CBDelayed.Tag;
 T_Commited :=Word(CBCommited.Checked)*CBCommited.Tag;
 T_Rejected :=Word(CBRejected.Checked)*CBRejected.Tag;

   DebetFilialF :=CheckFiltred(
                      CBDebetFilial.Checked
                     ,DebetFilialFilter
                     ,[DBLookup2.ListSource.DataSet.FieldByName('ID').AsInteger]
                     );

   CreditFilialF :=CheckFiltred(
                      CBCreditFilial.Checked
                     ,CreditFilialFilter
                     ,[DBLookup1.ListSource.DataSet.FieldByName('ID').AsInteger]
                     );

   OperatorF :=CheckFiltred(
                      CBOperator.Checked
                     ,OperatorFilter
                     ,[DBLookup3.ListSource.DataSet.FieldByName('ID').AsInteger]
                     );

   OperationStatusF :=CheckFiltred(
                      True
                     ,OperationStatus
                     ,[T_Delayed, T_Commited, T_Rejected]);
                     
   CurrencyF :=GenerateFilter(CLBCurrency,CurrencyFilter,2);
   OperationTypeF :=GenerateFilter(CLBOperationTypes,OperationTypeFilter,1);


   FilterStr :=CurrencyF;

    if  DebetFilialF <> '' then
    if  FilterStr=''  then
      FilterStr :=DebetFilialF
    else
      FilterStr :=FilterStr + BooleanPrefix + DebetFilialF;

    if  CreditFilialF <> '' then
    if  FilterStr=''  then
      FilterStr :=CreditFilialF
    else
      FilterStr :=FilterStr + BooleanPrefix + CreditFilialF;

    if  OperatorF <> '' then
    if  FilterStr=''  then
      FilterStr :=OperatorF
    else
      FilterStr :=FilterStr + BooleanPrefix +OperatorF;

    if  OperationTypeF <> '' then
    if  FilterStr=''  then
      FilterStr :=OperationTypeF
    else
      FilterStr :=FilterStr + BooleanPrefix +OperationTypeF;

    if  OperationStatusF <> '' then
    if  FilterStr=''  then
      FilterStr :=OperationStatusF
    else
      FilterStr :=FilterStr + BooleanPrefix +OperationStatusF;
   with GridTransactions.DataSource.DataSet do
   begin
    Filtered :=False;
    Filter :=FilterStr;
    Filtered :=True;
   end;

end;

function TTransactionManagerForm.FlagEnabled(Flag: Word): Boolean;

  procedure CheckRow;
  begin
    Result := GridTransactions.DataSource.DataSet.FieldByName('Status').AsInteger = Flag;
  end;

var
  SavedPos: TBookmark;
  Index: Integer;

begin
  Result :=False;
  with GridTransactions, SelectedRows, DataSource.DataSet do
  begin
   if (Count = 1) or (Count = 0) then
     CheckRow
   else
   begin
    DisableControls;
    SavedPos := GetBookmark;
    try
      for Index := 0 to Count -1 do
      begin
        GotoBookmark(TBookmark(Items[Index]));
        CheckRow;
        if Result then
         break;
      end;
    finally
      GotoBookmark(SavedPos);
      EnableControls;
    end;
   end;
  end;
end;

