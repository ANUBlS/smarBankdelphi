procedure TTransactionEditForm.SaveTransaction;
begin
  with TransactionDataModule, Transactions do
   if State in [dsEdit, dsInsert] then begin
    //if FieldByName('Status').AsInteger =2 then
     //SB_ACA.CallProcedure('CheckAdvancedObjectAccess',['TRANSACTIONCOMMITEDEDIT']); {S.A. 23.10.2012} {H.R. 28.10.2010}

     if (DebitAccData.FieldByName('fromTrans').AsInteger = 1) or (CreditAccData.FieldByName('fromTrans').AsInteger = 1) then begin
       ShowMessage('Bu balans hesabı ilə bu moduldan əməliyyat aparmaq olmaz!');
       Exit;
     end; {*** H.R. 10.01.2011}

     with ODS_VidOPTrDel do begin {H.R. 04.10.2010}
       Close;
       SetVariable('v_ID', TransactionDataModule.Transactions.FieldByName('OperationCode').AsInteger);
       Open;
      end;
      if ODS_VidOPTrDel.FieldByName('Cnt').AsInteger = 1 then begin
       ShowMessage('Bu növ əməliyyatı bu moduldan redaktə etmək olmaz.');
       Exit;
      end; {*** H.R. 04.10.2010}

   
     FieldByName('TransactionDate').AsDateTime :=Int(TransDate.DateTime);
     FieldByName('DebitAmount').AsCurrency :=CurrencyEditDebit.Value;
     FieldByName('CreditAmount').AsCurrency :=CurrencyEditCredit.Value;
     FieldByName('Lamount').AsCurrency :=CurrencyEditLammount.Value;

     FieldByName('Status').AsInteger :=1;
     FieldByName('DebitAccNo').AsString :=EditDebtAccNo.Text;
     FieldByName('CreditAccNo').AsString :=EditCredAccNo.Text;
     FieldByName('DebitCurrencySName').AsString :=DebitCurrencyData.FieldByName('SName').AsString;
     FieldByName('CreditCurrencySName').AsString :=CreditCurrencyData.FieldByName('SName').AsString;
     FieldByName('OperationNo').AsString :=DBEditOperationNo.Text;
     FieldByName('COUNTRID').AsString := CountrIDDBEdit.Text;

     if OperationTypeLookUp.Text = EmptyStr then
      FieldByName('OperationCode').Value :=Null;

     OP_MMX.CallProcedure('mmx_transaction',[DebitAccData.FieldByName('ID').AsInteger
                                           ,Sysdat.FieldByName('tek_dat').AsDateTime,
                                            CurrencyEditLammount.Value,DBLC_MMX_Transmode.KeyValue]);

     OP_MMX.CallProcedure('mmx_transaction',[CreditAccData.FieldByName('ID').AsInteger
                                           ,Sysdat.FieldByName('tek_dat').AsDateTime,
                                            CurrencyEditLammount.Value,DBLC_MMX_Transmode.KeyValue]);
    // p_reportcode:=DBLC_MMX_Transmode.KeyValue;

     Post;
     SBCommit();
    end;

end;

