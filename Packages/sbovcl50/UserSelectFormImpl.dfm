  object Users: TDataSource
    DataSet = UsersData
    Left = 72
    Top = 72
  end
  object UsersData: TOracleDataSet
    SQL.Strings = (
      'select'
      '  sc.ID,'
      '  sc.name,'
      '  sc.type#'
      'from'
      '  security_clients$ sc'
      'where not'
      '  id in ('
      '    select'
      '      scl.client#'
      '    from'
      '      security_sid_client_link scl'
      '    where'
      '      scl.sid# = :SID'
      '  )'
      'order by sc.type# desc, sc.name')
    Optimize = False
    Variables.Data = {
      0400000001000000080000003A00530049004400030000000000000000000000}
    QBEDefinition.QBEFieldDefs = {
      05000000030000000400000049004400010000000000080000004E0041004D00
      45000100000000000A00000054005900500045002300010000000000}
    MasterFields = 'ID'
    DetailFields = 'link#'
    Session = sboapiDataModule.SBSession
    Left = 104
    Top = 72
    object UsersDataID: TFloatField
      FieldName = 'ID'
      Required = True
    end
    object UsersDataNAME: TWideStringField
      FieldName = 'NAME'
      Size = 32
    end
    object UsersDataTYPE: TFloatField
      FieldName = 'TYPE#'
    end
  end
