  object SQLData: TOracleDataSet
    SQL.Strings = (
      'select i.*,i.rowid'
      'from INSTALLATION_ACTIONS i'
      'where task_id = ('
      '  select ID from INSTALLATION_TASKS where name = :TaskName'
      ')'
      'order by i.Metrica')
    Optimize = False
    Variables.Data = {
      0400000001000000120000003A005400410053004B004E0041004D0045000500
      00000000000000000000}
