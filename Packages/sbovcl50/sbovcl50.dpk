package sbovcl50;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart - Visual controls for Oracle'}
{$IMPLICITBUILD OFF}

requires
  vcl,
  Vcldb,
  SBCommon50,
  sboapi50,
  Vclx,
  dclofficexp;

contains
  SecurityBrowserImpl in 'SecurityBrowserImpl.pas' {SecurityBrowserForm},
  SBSecurityBrowser in 'SBSecurityBrowser.pas',
  MLDialogs in 'MLDialogs.pas',
  MLDialogFormImpl in 'MLDialogFormImpl.pas' {MLDialogForm},
  AccessSelectFormImpl in 'AccessSelectFormImpl.pas' {AccessSelectForm},
  UserSelectFormImpl in 'UserSelectFormImpl.pas' {UserSelectForm},
  InstallationTaskEditFrameImpl in 'InstallationTaskEditFrameImpl.pas' {InstallationTaskEditFrame: TFrame},
  DBIniFile in 'DBIniFile.pas',
  sbovclDataModuleImpl in 'sbovclDataModuleImpl.pas' {sbovclDataModule: TDataModule},
  DBIniSource in 'DBIniSource.pas',
  IniSourceViewer in 'IniSourceViewer.pas',
  LDialogs in 'LDialogs.pas',
  VisibleController in 'VisibleController.pas',
  sbovclRegUnit in 'sbovclRegUnit.pas',
  sbovclInitPkg in 'sbovclInitPkg.pas';

end.
