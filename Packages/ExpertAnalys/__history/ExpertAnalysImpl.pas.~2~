procedure TExpertAnalysX.ExportOperationClick(Sender: TObject);
begin
 if RBExpand.Checked then
   with ExpertDataModul, TrafficsForm do
    begin
     Traffics.CloseAll;
     if (Sender as TMenuItem).Tag = 1 then
      begin
       Traffics.SetVariable('operationID', Operations.FieldByName('ID').AsInteger);
       Traffics.SetVariable('balanceID', -1);
       Traffics.SetVariable('BeginDate', operationDate);
       Traffics.SetVariable('BeginPeriod', GetBeginPeriod(operationDate));
       Traffics.SetVariable('LastDate', LastDate);
      end
     else
      if (Sender as TMenuItem).Tag = 2 then
       begin
        Traffics.SetVariable('operationID', -1);
        Traffics.SetVariable('balanceID', Operations_balance.FieldByName('ID').AsInteger);
        Traffics.SetVariable('BeginDate', operationDate);
        Traffics.SetVariable('BeginPeriod', GetBeginPeriod(operationDate));
        Traffics.SetVariable('LastDate', LastDate);
       end;
     Traffics.Filtered :=False;
     Traffics.Filter :='(abs(' + CurrencyField + ') >='+ FloatToStr(CELimit.value)+')' + CheckCurrency;
     Traffics.Filtered :=True;
     Traffics.SQL[45] :=BuildBranchCondition;
     Traffics.SQL[72] :=BuildBranchCondition;
     Traffics.SQL[107] :=BuildBranchCondition;

     Traffics.Open;
     if Copy((Sender as TMenuItem).Name, 1, 7) = 'TMExcel' then
      ExportForm.ShowModal
     else
      ShowModal;
    end
 else
  with ExpertDataModul, MainTraffics do
   begin
    TotalTraffics.CloseAll;
    TotalTraffics.SQL.CommaText :=DefaultTotalTrafficsSQL;

      TotalTraffics.SQL[23] :=GenerateCurrencyFilter;

      TotalTraffics.SQL[24] :=Format(BuildAmmountCondition, [CELimit.value]);

     if (Sender as TMenuItem).Tag = 1 then
      begin
       TotalTraffics.SetVariable('operationID', Operations.FieldByName('ID').AsInteger);
       TotalTraffics.SetVariable('balanceID', -1);
       TotalTraffics.SetVariable('schemaID', -1);
       TotalTraffics.SetVariable('operationDate', operationDate);
      end
     else
      begin
       TotalTraffics.SetVariable('operationID', -1);
       TotalTraffics.SetVariable('balanceID', Operations_balance.FieldByName('ID').AsInteger);
       TotalTraffics.SetVariable('schemaID', -1);
       TotalTraffics.SetVariable('operationDate', operationDate);
      end;
    TotalTraffics.SQL[26] :=BuildBranchCondition;
    TotalTraffics.Open;
    ShowModal;
   end;
end;

