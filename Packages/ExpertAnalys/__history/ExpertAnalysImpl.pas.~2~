function TExpertAnalysX.BuildAmmountCondition :string;
begin
 if RBOstat.Checked then
  Result :='and abs(ar.ostat) >=%f'
 else
  Result :='and abs(ar.pok_ostat) >=%f'
end;

function TExpertAnalysX.BuildOperationCondition(OperationKind: word): string;
begin
 case OperationKind of
  0: Result :=' AND (schemaID = '+ ExpertDataModul.Schemas.FieldByName('ID').AsString+')';
  1: Result :=' AND (operationID = '+ ExpertDataModul.Operations.FieldByName('ID').AsString+')';
 end
end;

function TExpertAnalysX.BuildBranchCondition: string;
begin
 with DBLookupBranch  do
  if KeyValue =-1 then
   Result :=' '
  else
   Result :=' AND Ac.filial = ' + IntToStr(KeyValue);
end;

function TExpertAnalysX.GenerateCurrencyFilter: string;
begin
 case CBCurrency.ItemIndex of
  0: Result :='';
  1: Result :=' and ac.val_acc <> 0';
 else
  Result :=Format(ExpertDataModul.TotalTraffics.SQL[23],[rate[CBCurrency.ItemIndex-2]]);
 end;
end;

