function TExpertAnalysX.GetBeginPeriod(BeginDate: TDateTime): TDateTime;
begin
 with ExpertDataModul, PeriodData do
  begin
   CloseAll;
   SetVariable('BeginDate',BeginDate);
   Open;
   if FieldByName('BeginPeriod').IsNull then
    Result :=BeginDate
   else
    Result :=FieldByName('BeginPeriod').AsDateTime;
  end;
end;

