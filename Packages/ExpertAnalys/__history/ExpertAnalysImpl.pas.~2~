procedure TExpertAnalysX.ActiveFormCreate(Sender: TObject);
const
  PickListCount = 5;
var
  PickListIndex: word;
begin
 ExpertAnalysX :=Self;

 CheckDataModule;
 FillCurrency;
 CheckReport;
 TrafficsForm :=TTrafficsForm.Create(Self);
 MainTraffics :=TMainTraffics.Create(Self);
 ExportForm :=TExportForm.Create(Self);
 SchemaTrafficsForm :=TSchemaTrafficsForm.Create(Self);

 CBCurrency.ItemIndex :=0;
 DBLookupBranch.KeyValue :=-1; 
 DTPSysdat.DateTime :=ExpertDataModul.Sysdat.FieldByName('tek_dat').AsDateTime;
 OperationDate :=DTPSysdat.DateTime;
 LastDate :=OperationDate;
 CurrencyField :='LastRest';
 DefaultTotalTrafficsSQL :=ExpertDataModul.TotalTraffics.SQL.CommaText;
 DefaultSchemaTrafficsSQL :=ExpertDataModul.SchemaTraffics.SQL.CommaText;

 with ExpertDataModul, SettingsGrid do
 begin

   for PickListIndex :=0 to PickListCount -1 do
    Columns[PickListIndex].PickList.Clear;

   while not Accounts.EOF do
   begin
     Columns[0].PickList.Add(Accounts.FieldByName('acc_no').AsString);
     Accounts.Next;
   end;

   while not Balances.EOF do
   begin
     Columns[1].PickList.Add(Balances.FieldByName('bal_cn').AsString);
     Columns[2].PickList.Add(Balances.FieldByName('accgroup').AsString);
     Columns[3].PickList.Add(Balances.FieldByName('part').AsString);
     Balances.Next;
   end;

   while not AccFlags.EOF do
   begin
     Columns[4].PickList.Add(AccFlags.FieldByName('symbol').AsString);
     AccFlags.Next;
   end;

 end;
end;

