procedure TExpertAnalysX.FillCurrency;
var
    RateIndex :Integer;
begin
  RateIndex:=0;
   with   CBCurrency.Items  do
   begin
     Clear;
     Add('¡ˆÚˆÌ ‚‡ÎÈÛÚ‡Î‡');
     Add('’‡ËÊË ‚‡ÎÈÛÚ‡‰‡');
   end;
  with  ExpertDataModul.Currency  do
  begin
    Open;
    SetLength(Rate,RecordCount);
    First;
    while  not EOF  do
    begin
      Rate[RateIndex] :=FieldByName('Valute').AsInteger;
      CBCurrency.Items.Add(FieldByName('Valu_Name').AsString);
      Inc(RateIndex);
      Next;
    end;
  end;
end;

function TExpertAnalysX.CheckCurrency :string;
begin
 case CBCurrency.ItemIndex of
  0 :  Result :='';
  1 :  Result :=' and (val_acc <> 0)';
  else
   Result :=' and (val_acc = '+ IntToStr(rate[CBCurrency.ItemIndex-2])+')';
 end;
end;

