procedure TExpertAnalysX.SBSchemaReportClick(Sender: TObject);
var
  OperationKind: word;
begin
 OperationKind :=(Sender as TSpeedButton).Tag;
 with MainReport ,TOracleDataSet(DataSet) do
  begin
   Close;
   SetVariable('OperationDate',OperationDate);
   Filtered :=False;
   Filter :='(abs(' + CurrencyField + ') >='+ FloatToStr(CELimit.value)+')' + CheckCurrency + BuildOperationCondition(OperationKind);
   Filtered :=True;
   SQL[29] :=BuildBranchCondition;
   Open;
   if DTPSysdat.Date = DTPLastDate.Date then
    QRLabelDate.Caption :=FormatDateTime('dd/mm/yyyy',DTPSysdat.DateTime)
   else
    QRLabelDate.Caption :=FormatDateTime('dd/mm/yyyy',DTPSysdat.DateTime)+' - '+FormatDateTime('dd/mm/yyyy',DTPLastDate.DateTime);
   Preview;
  end;
end;

procedure TExpertAnalysX.Aanaliz1Click(Sender: TObject);
begin
 if RBTotal.Checked then
   with ExpertDataModul, SchemaTrafficsForm do
    begin
     SchemaTraffics.CloseAll;
     SchemaTraffics.SQL.CommaText:= DefaultSchemaTrafficsSQL;

      if CBCurrency.ItemIndex > 1 then
       SchemaTraffics.SQL[22] :=Format(SchemaTraffics.SQL[22],[rate[CBCurrency.ItemIndex-2]])
      else
       SchemaTraffics.SQL[22] :='';

       SchemaTraffics.SQL[23] :=Format(BuildAmmountCondition,[CELimit.value]);

     SchemaTraffics.SetVariable('schemaID',Schemas.FieldByName('ID').AsInteger);
     SchemaTraffics.SetVariable('operationDate',operationDate);
     SchemaTraffics.SQL[25] :=BuildBranchCondition;
     SchemaTraffics.Open;
     ShowModal;
    end
 else
  with ExpertDataModul, MainTraffics do
   begin
    TotalTraffics.CloseAll;
    TotalTraffics.SQL.CommaText :=DefaultTotalTrafficsSQL;

    TotalTraffics.SQL[23] :=GenerateCurrencyFilter;

    TotalTraffics.SQL[24] :=Format(BuildAmmountCondition,[CELimit.value]);

    TotalTraffics.SetVariable('operationID',-1);
    TotalTraffics.SetVariable('balanceID',-1);
    TotalTraffics.SetVariable('schemaID',Schemas.FieldByName('ID').AsInteger);
    TotalTraffics.SetVariable('operationDate',operationDate);
    TotalTraffics.SQL[26] :=BuildBranchCondition;
    TotalTraffics.Open;
    ShowModal;
   end;
end;

