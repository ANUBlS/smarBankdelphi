unit CableManContractAdd;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, ComCtrls, DBCtrls, OracleData, CurrencyEdit, Buttons;

type
  TfrmContractAdd = class(TForm)
    edcontract_num: tedit;
    edcard_num: tedit;
    edinst_date: TDateTimePicker;
    edinst_place: TComboBox;
    edserie: tedit;
    edworks_num: tedit;
    edreceiver_num: tedit;
    edcable_length: tedit;
    edamount: TCurrencyEdit;
    edcurr_code: TDBLookupComboBox;
    eddiscount: tedit;
    edeng_id: TDBLookupComboBox;
    edpack_num: TDBLookupComboBox;
    lbcontract_num: tlabel;
    lbcard_num: tlabel;
    lbinst_date: tlabel;
    lbinst_place: tlabel;
    lbserie: tlabel;
    lbworks_num: tlabel;
    lbreceiver_num: tlabel;
    lbcable_length: tlabel;
    lbamount: tlabel;
    lbcurr_code: tlabel;
    lbdiscount: tlabel;
    lbeng_id: tlabel;
    lbpack_num: tlabel;
    Button1: TButton;
    Button2: TButton;
    Label1: TLabel;
    edAcc_ID: TDBLookupComboBox;
    edCalcAg: TCheckBox;
    Label2: TLabel;
    edDiscDesc: TEdit;
    Label3: TLabel;
    edexp_date: TDateTimePicker;
    Label4: TLabel;
    Label5: TLabel;
    Label6: TLabel;
    Label7: TLabel;
    Label8: TLabel;
    Label9: TLabel;
    Label10: TLabel;
    Label11: TLabel;
    Label12: TLabel;
    Label13: TLabel;
    Label14: TLabel;
    SpeedButton1: TSpeedButton;
    Label15: TLabel;
    edSRV_num: TDBLookupComboBox;
    procedure FormCreate(Sender: TObject);
    procedure edpack_numCloseUp(Sender: TObject);
    procedure Label1DblClick(Sender: TObject);

  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmContractAdd: TfrmContractAdd;

implementation

uses CableManDataModuleImpl, CableManAccsImpl;

{$R *.DFM}

procedure TfrmContractAdd.FormCreate(Sender: TObject);
var
  i: Integer;
begin
  with DataModCable do begin
    for i:=0 to componentcount-1 do
      if (components[i] is toracledataset )and (components[i].tag=2 )then
        (components[i] as toracledataset).open;
  end;
end;

procedure TfrmContractAdd.edpack_numCloseUp(Sender: TObject);
begin
  edamount.value := (Sender as TDBLookupComboBox).ListSource.DataSet.Fields[2].AsCurrency+
  (Sender as TDBLookupComboBox).ListSource.DataSet.Fields[4].AsCurrency;
end;

procedure TfrmContractAdd.Label1DblClick(Sender: TObject);
var
  AcID: Integer;
begin
  if not assigned(frmAcc) then
    frmAcc := TfrmAcc.Create(Self);
  with DataModCable, frmAcc do begin
    if ShowModal=1 then begin
      AcID :=
      CABLE.CallIntegerFunction('open_account', [AccNoEdit.Text,
                                                 odsAbonents.Fields[1].AsString,
                                                 odsValutes.Fields[0].AsInteger]);
      odsAccs.Close;
      odsAccs.Open;
      odsAccs.Locate('ID', AcID,[]);
      edAcc_ID.KeyValue := AcID;
    end;
  end;
end;

end.
