package SBCMConclusion;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart Credit Menegment  -   Contract  Conclusion'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  Vcldb50,
  doa40d5,
  sboapi50,
  SBCMStorage,
  sbcmDataModule,
  SBCMVcl50;

contains
  UntConclusionDataModule in 'UntConclusionDataModule.pas' {DataModContract: TDataModule},
  UntContractConclusion in 'UntContractConclusion.pas' {FrmContract},
  UntPercents in 'UntPercents.pas' {FrmPercents};

end.
