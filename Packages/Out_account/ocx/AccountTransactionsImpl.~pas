    TabSheet2: TTabSheet;
    Panel5: TPanel;
    Label3: TLabel;
    Label4: TLabel;
    Bevel2: TBevel;
    CreditAmountEdit: TCurrencyEdit;
    CreditLAmountEdit: TCurrencyEdit;
    Panel4: TPanel;
    DBEdit2: TDBEdit;
    DBGrid1: TDBGrid;
    Panel3: TPanel;
    SpeedButton1: TSpeedButton;
    OkButton: TButton;
    DebetTransactionsData: TOracleDataSet;
    DebetTransactionsDataID: TFloatField;
