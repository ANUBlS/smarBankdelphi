  FormAccountTransactions: TFormAccountTransactions;

implementation

uses AccountDataModuleImpl,sboapiDataModuleImpl;

{$R *.DFM}
procedure TFormAccountTransactions.OpenDataControls(BeginDate, EndDate: TDateTime);

 procedure Open_(DataSet: TOracleDataSet);
 begin
  with DataSet do
  begin
   CloseAll;
   SetVariable('AccountID', AccountID);
   SetVariable('StartDate', BeginDate);
   SetVariable('EndDate', EndDate);
   Open;
  end;
 end;

begin
 with out_accdatamodule.Account do
  AccountID :=FieldByName('ID').AsInteger;

 Open_(DebetTransactionsData);
 Open_(CreditTransactionsData);





end;
procedure TFormAccountTransactions.DebetTransactionsDataAfterOpen(
  DataSet: TDataSet);
begin
  FillAmounts(
    DataSet,
    DebetTransactionsDataDEBITAMOUNT,
    DebetTransactionsDataLAMOUNT,
    DebitAmountEdit,
    DebitLAmountEdit);

end;

procedure TFormAccountTransactions.DebetTransactionsDataCalcFields(
  DataSet: TDataSet);
begin
 with DataSet do
  FieldByName('DebitAccNo').AsString :=out_accdatamodule.Account.FieldByName('acc_no').AsString;

end;

procedure TFormAccountTransactions.CreditTransactionsDataAfterOpen(
  DataSet: TDataSet);
begin
  FillAmounts(
    DataSet,
    CreditTransactionsDataCreditAMOUNT,
    CreditTransactionsDataLAMOUNT,
    CreditAmountEdit,
    CreditLAmountEdit);

end;

procedure TFormAccountTransactions.CreditTransactionsDataCalcFields(
  DataSet: TDataSet);
begin
 with DataSet do
  FieldByName('CreditAccNo').AsString :=out_accdatamodule.Account.FieldByName('acc_no').AsString;

end;
 
procedure TFormAccountTransactions.FillAmounts(DataSet: TDataSet; AmountField, LAmountField: TField;
  AmountEdit, LAmountEdit: TCurrencyEdit);
var
  Amount: Currency;
  LAmount: Currency;
begin
  Amount := 0.0;
  LAmount := 0.0;
  with DataSet do
  begin
    DisableControls;
    try
      while not Eof do
      begin
        Amount := Amount + AmountField.Value;
        LAmount := LAmount + LAmountField.Value;
        Next;
      end;
    finally
      EnableControls;
    end;
  end;
  AmountEdit.Value := Amount;
  LAmountEdit.Value := LAmount;
end;

procedure TFormAccountTransactions.SpeedButton1Click(Sender: TObject);
begin

  with  AccTrExport do
  begin
   if PageControlTrans.ActivePageIndex = 0 then
     ExportSource := DebetTransactions
   else
     ExportSource := CreditTransactions;
   Report;
  end;
end;



procedure TFormAccountTransactions.FormKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if Ord(Key) = VK_ESCAPE then
    Close;

end;

procedure TFormAccountTransactions.FormActivate(Sender: TObject);
const
     cs_message = 'Transactions for account "%s"';
begin
 with out_accdatamodule.Account do
  AccountNumber :=FieldByName('acc_no').AsString;
 Caption :=Format(cs_message, [AccountNumber]);
end;


end.
