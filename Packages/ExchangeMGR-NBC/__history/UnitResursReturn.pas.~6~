unit UnitResursReturn;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, DBCtrlsEh, CMCurrencyEdit, DBCtrls, Mask, ExtCtrls;

type
  TFormResursRetrun = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    Panel7: TPanel;
    Panel8: TPanel;
    DBEdit1: TDBEdit;
    Panel3: TPanel;
    Panel9: TPanel;
    DBLookupComboBox2: TDBLookupComboBox;
    Panel10: TPanel;
    Panel4: TPanel;
    Panel11: TPanel;
    Panel12: TPanel;
    CMCurrencyEdit1: TCMCurrencyEdit;
    Panel5: TPanel;
    Label1: TLabel;
    Panel6: TPanel;
    Label5: TLabel;
    Panel13: TPanel;
    ComboBox1: TComboBox;
    EditDescription: TEdit;
    Panel14: TPanel;
    Button1: TButton;
    Button2: TButton;
    procedure Button2Click(Sender: TObject);
    procedure ComboBox1Click(Sender: TObject);
    procedure ComboBox1DropDown(Sender: TObject);
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    Var VRetrunInsert:boolean;
    procedure LoadComboData(Sender: TComboBox);
  end;

var
  FormResursRetrun: TFormResursRetrun;

implementation
uses UnitDateExch;

{$R *.dfm}

procedure TFormResursRetrun.ComboBox1Click(Sender: TObject);
begin
  EditDescription.Text := (Sender as TComboBox).Text;
end;

procedure TFormResursRetrun.ComboBox1DropDown(Sender: TObject);
begin
  FormResursRetrun.LoadComboData(TComboBox(Sender));
end;

procedure TFormResursRetrun.FormShow(Sender: TObject);
if not (VResInsert)
  then
  begin
    CheckBox1.Checked:=False;
    EditDescription.Clear;
    Panel17.Font.Style:=Panel17.Font.Style - [fsBold];
    CMCurrencyEdit1.Value:=0;
    DBDateTimeEditEh1.Clear;
    DBLookupComboBox2.KeyValue:=-1;
    DBDateTimeEditEh1.Enabled:=False;
    DBDateTimeEditEh1.Color:=clGradientInactiveCaption;
  end
  else begin
         with DataModExch do
         begin
           if ODSResurs.FieldByName('nextstatus').AsInteger=1 then  begin
                                                                      CheckBox1.Checked:=True;
                                                                      Panel17.Font.Style:=Panel17.Font.Style + [fsBold];
                                                                      DBDateTimeEditEh1.Enabled:=true;
                                                                      DBDateTimeEditEh1.Color:=clWhite;
                                                                    end
                                                            else  begin
                                                                    CheckBox1.Checked:=False;
                                                                    Panel17.Font.Style:=Panel17.Font.Style - [fsBold];
                                                                    DBDateTimeEditEh1.Enabled:=False;
                                                                    DBDateTimeEditEh1.Color:=clGradientInactiveCaption;
                                                                  end;



         end;

       end;

end;


procedure TFormResursRetrun.LoadComboData(Sender: TComboBox);
begin
  with DataModExch.ODSRTrdestination, Sender do
  begin
    if not(Active) then
      Open
    else
    begin
      Refresh;
    end;
    if Items.Count <> RecordCount then
    begin
      Items.Clear;
      First;
      while not(EOF) do
      begin
        Items.Add(FieldByName('name').AsString);
        Next;
      end;
    end;
  end;
end;

procedure TFormResursRetrun.Button2Click(Sender: TObject);
begin
  FormResursRetrun.Close;
end;

end.
