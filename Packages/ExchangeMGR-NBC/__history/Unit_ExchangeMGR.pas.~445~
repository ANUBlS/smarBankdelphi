procedure TExchangeMGR_X.BitBtn9Click(Sender: TObject);
var
  v_beg_dat       :TDateTime;
  v_end_dat       :TDateTime;
  val_id          :Integer;
  status          :Integer;
  exch_no         :Integer;

  query_str       :string;
begin
  with DataModExch do
   begin
     try
      Screen.Cursor:=crSQLWait;
      v_beg_dat:=Integer(Trunc(DateTimePicker3.DateTime));
      v_end_dat:=Integer(Trunc(DateTimePicker4.DateTime));


      if CheckBox4.Checked then
      begin
        if  DBCB_Toplam.KeyValue=null then exch_no:=-1
        else exch_no:=DBCB_Toplam.KeyValue;
      end;
      if CheckBox3.Checked then
      begin
        if  DBLookupComboBox3.KeyValue=null then  val_id:=-1
        else val_id:=DBLookupComboBox3.KeyValue;
      end;

      status:=ComboBox1.ItemIndex;

      ODSReporting.Close;
      ODSReporting.SetVariable('bdat',v_beg_dat);
      ODSReporting.SetVariable('edat',v_end_dat);
      ODSReporting.SetVariable('val_id',val_id);
      ODSReporting.SetVariable('val_name',DBLookupComboBox3.Text);
      IF exch_no<>-1 THEN  ODSReporting.sql[15]:='where p.ex_no='+ IntToStr(exch_no)
                     ELSE  ODSReporting.sql[15]:='';

      ODSReporting.Open;
  finally
  Screen.Cursor:=crDefault;
 end;
end;

end;

