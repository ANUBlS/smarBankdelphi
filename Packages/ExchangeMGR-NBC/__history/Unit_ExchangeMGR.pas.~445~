procedure TExchangeMGR_X.InsertTransaction(
                                      Status       :Integer;
                                      ToTable      :TTable;
                                      DebitVal     :String;
                                      KreditVal    :String;
                                      DebitAccno   :String;
                                      KreditAccNo  :String;
                                      DebitAmount  :Real;
                                      LAmount      :Real;
                                      DebitRate    :Real;
                                      KreditRate   :Real;
                                      TrName       :string;
                                      SessionName : String //KNN
                                      );




begin


   with ToTable do
     begin
          Insert;
               FieldByName('Status').AsInteger:=Status;
               FieldByName('DebitVal').AsString:=DebitVal;
               FieldByName('KreditVal').AsString:=KreditVal;
               FieldByName('DebitAccno').AsString:=DebitAccno;
               FieldByName('KreditAccNo').AsString:=KreditAccno;
               FieldByName('DebitAmount').AsFloat:=DebitAmount;
               FieldByName('LAmount').AsFloat:=LAmount;
               FieldByName('DebitRate').AsFloat:=DebitRate;
               FieldByName('KreditRate').AsFloat:=KreditRate;
               FieldByName('TrName').AsString:=TrName;
               FieldByName('SessionName').AsString:=UpperCase(DataModExch.OPExchMgr.Session.LogonUsername);
          Post;
   end;

end;

