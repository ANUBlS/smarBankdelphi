function RoundNew(X: Double; Precision: Integer ): Double;
var
  ScaledFractPart, Temp : Double;
begin
  ScaledFractPart := Frac(X)*Precision;
  Temp := Frac(ScaledFractPart);
  ScaledFractPart := Int(ScaledFractPart);
  //if Temp >= 0.5 then ScaledFractPart := ScaledFractPart + 1; ***Closed by Hesen R.***
  //if Temp <= -0.5 then ScaledFractPart := ScaledFractPart - 1; ***Closed by Hesen R.***
  if Round(Temp*100) >= 50 then ScaledFractPart := ScaledFractPart + 1; //***Written by Hesen R.***
  if Round(Temp*100) <= -50 then ScaledFractPart := ScaledFractPart - 1; //***Written by Hesen R.***
  RoundNew := Int(X) + ScaledFractPart/Precision;
end;


function RoundToEx(const AValue: Double; const ADigit: TRoundToRange = -2): double;
var
  LFactor: double;
  i: integer;
  s: string;
begin
  LFactor := IntPower(10, ADigit);
  i := Round(AValue / (LFactor / 10));
  s := IntToStr(i);
  Result := (Trunc(i/10) + ord(StrToInt(s[Length(s)]) >= 5)) * LFactor;
  //Result:=Roundto(AValue,-2);   {Yuvarlasdirma ile elaqedar yuxari hiiseni bagladim}
end;
