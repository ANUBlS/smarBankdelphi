unit UnitResursGive;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, CurrencyEdit, DBCtrls, ExtCtrls, Mask, CMCurrencyEdit,
  DBCtrlsEh;

type
  TFormGivenResurs = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    Panel7: TPanel;
    Panel8: TPanel;
    DBEdit1: TDBEdit;
    Panel3: TPanel;
    Panel9: TPanel;
    DBLookupComboBox2: TDBLookupComboBox;
    Panel10: TPanel;
    Panel4: TPanel;
    Panel11: TPanel;
    Panel12: TPanel;
    CMCurrencyEdit1: TCMCurrencyEdit;
    Panel5: TPanel;
    Label1: TLabel;
    Panel6: TPanel;
    Label5: TLabel;
    Panel13: TPanel;
    ComboBox1: TComboBox;
    EditDescription: TEdit;
    Panel14: TPanel;
    Button1: TButton;
    Button2: TButton;
    Panel15: TPanel;
    Panel16: TPanel;
    Panel17: TPanel;
    DBDateTimeEditEh1: TDBDateTimeEditEh;
    CheckBox1: TCheckBox;
    procedure Button2Click(Sender: TObject);
    procedure ComboBox1Click(Sender: TObject);
    procedure ComboBox1DropDown(Sender: TObject);
    procedure CheckBox1Click(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure Button1Click(Sender: TObject);

  private
    { Private declarations }
  public
    procedure LoadComboData(Sender: TComboBox);
  end;

var
  FormGivenResurs: TFormGivenResurs;

implementation
uses UnitDateExch;
{$R *.dfm}

procedure TFormGivenResurs.LoadComboData(Sender: TComboBox);
begin
  with DataModExch.ODSTrdestination, Sender do
  begin
    if not(Active) then
      Open
    else
    begin
      Refresh;
    end;
    if Items.Count <> RecordCount then
    begin
      Items.Clear;
      First;
      while not(EOF) do
      begin
        Items.Add(FieldByName('name').AsString);
        Next;
      end;
    end;
  end;
end;

procedure TFormGivenResurs.Button1Click(Sender: TObject);
var
   FilNumber:integer;
   FilName  :string[120];
   ValNumber:integer;
   ValName :string[5];
   Amount:real;
   Nextday:TDateTime;
   Descript:string;
begin
  if DBLookupComboBox2.KeyValue='' then ShowMessage('Valyutanı seçin!...');
  if CMCurrencyEdit1.Value=0 then ShowMessage('Məbləği daxil edin !...');
  if CheckBox1.Checked then
  if DBDateTimeEditEh1.Value='' then ShowMessage('Tarixi daxil edin !...');
  if EditDescription.Text='' then ShowMessage('Təyinatı daxil edin!...');


end;

procedure TFormGivenResurs.Button2Click(Sender: TObject);
begin
  Close;
end;

procedure TFormGivenResurs.CheckBox1Click(Sender: TObject);
begin
  if CheckBox1.Checked then  begin
                               Panel17.Font.Style:=Panel17.Font.Style + [fsBold];
                               DBDateTimeEditEh1.Enabled:=true;
                               DBDateTimeEditEh1.Color:=clWhite;
                             end
                       else  begin
                               Panel17.Font.Style:=Panel17.Font.Style - [fsBold];
                               DBDateTimeEditEh1.Enabled:=False;
                               DBDateTimeEditEh1.Color:=clGradientInactiveCaption;
                             end


end;

procedure TFormGivenResurs.ComboBox1Click(Sender: TObject);
begin
  EditDescription.Text := (Sender as TComboBox).Text;
end;

procedure TFormGivenResurs.ComboBox1DropDown(Sender: TObject);
begin
  FormGivenResurs.LoadComboData(TComboBox(Sender));
end;

procedure TFormGivenResurs.FormShow(Sender: TObject);
begin
  CheckBox1.Checked:=False;
  EditDescription.Clear;
  Panel17.Font.Style:=Panel17.Font.Style - [fsBold];
  CMCurrencyEdit1.Value:=0;
  DBDateTimeEditEh1.Clear;
  DBDateTimeEditEh1.Enabled:=False;
  DBDateTimeEditEh1.Color:=clGradientInactiveCaption;

end;

end.
