procedure TAccExtraction.BitBtn1Click(Sender: TObject);
begin
  try
   Screen.Cursor := crSQLWait;
   CreateSheet;
   if (AccEd.Text  <> '') and (not BalCheck.Checked)
     then  GetBySubAccout(AccEd.Text, CheckBoxVal.Checked ,DTPBegin.Date, DTPEnd.Date)
     else
     if (AccEd.Text  <> '') and (BalCheck.Checked)
       then
         GetByBal(AccEd.Text, DTPBegin.Date, DTPEnd.Date)
       else
         Flag := False;
   FinishPosition := 0;
   ShowSheet;
  finally
   Screen.Cursor := crDefault;
   DestroySheet;
   if not Flag then ClearLogInfo;
   Flag := True;
  end;
end;

procedure TAccExtraction.ActiveFormCreate(Sender: TObject);
begin
  AccExtraction := self;
  with sboapiDataModule do
    CurrentDate:= SBOperationDay.CallDateFunction('get_date', []);
  DTPBegin.DateTime := CurrentDate;
  DTPEnd.DateTime := CurrentDate;
end;

procedure TAccExtraction.CreateSheet;
begin
  try
   Exl := CreateOleObject('Excel.Application');
   Exl.WorkBooks.add;
   Sheet := Exl.Application.Worksheets.Item[1];
  except
   SetLogInfo('Error in Create Excel');
  end;
end;

procedure TAccExtraction.ShowSheet;
begin
  try
   if Flag then
     Exl.Visible := True;
  except
   SetLogInfo('Error in Show Excel');
  end;
end;

procedure TAccExtraction.DestroySheet;
begin
  try
   Finalize(Sheet);
   Finalize(Exl);
  except
   SetLogInfo('Error in destroy Excel sheet');
  end;
end;

procedure TAccExtraction.SetLogInfo( Value: String);
begin
 with LogInfo do
  begin
   Caption := Value;
   Visible := True;
  end;
end;

procedure TAccExtraction.ClearLogInfo;
begin
 with LogInfo do
  begin
   Caption := '';
   Visible := False;
  end;
end;




