unit FormAccountsImpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Grids, XDBGrids, StdCtrls,OracleData, ActnList;

type
  TFormAccounts = class(TForm)
    GroupBox1: TGroupBox;
    XDBGridAccounts: TXDBGrid;
    Button1: TButton;
    EditACC_NO_SEARCH: TEdit;
    EditACC_NO: TEdit;
    EditName: TEdit;
    procedure Button1Click(Sender: TObject);
