    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure EditACC_NO_SEARCHKeyPress(Sender: TObject; var Key: Char);
    procedure EditACC_NOKeyPress(Sender: TObject; var Key: Char);
    procedure EditNameKeyPress(Sender: TObject; var Key: Char);
    procedure FormShow(Sender: TObject);
    procedure XDBGridAccountsDblClick(Sender: TObject);
    procedure CloseFormExecute(Sender: TObject);
    procedure FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
  private
    { Private declarations }
  public
    { Public declarations }
        v_AccNo: String;
    DebOrKred: Boolean;
  end;

var
  FormAccounts: TFormAccounts;

implementation

uses TransactionDataModuleUnit, TransactionPropertiesImpl;

{$R *.dfm}
procedure TFormAccounts.CloseFormExecute(Sender: TObject);
begin
  FormAccounts.Close;
end;

procedure TFormAccounts.ActionSpeedSearchExecute(
  Sender: TObject);
var
  SearchField : string;
  SearchOptions : TSearchRecordOptions;
begin
  SearchOptions := [srIgnoreCase ,srPartialMatch ];

  with Sender as TEdit  do
  begin
    SearchField := copy(Name,5,length(Name));
    with  TOracleDataSet(XDBGridAccounts.DataSource.DataSet) do
    if  not SearchRecord(
                  SearchField
                 ,Text
                 ,SearchOptions + [srFromCurrent , srForward ]
                 ) then
    if MessageDlg(
              'Axtarış sona çatdı.'+#13+'Əvvəldən başlansın?'
             ,mtInformation
             ,[mbNo , mbYes]
             ,0
             ) = mrYes  then
    if not SearchRecord(
                 SearchField
                ,Text
                ,SearchOptions + [ srFromBeginning ]
                )  then
    MessageDlg('Yazı tapılmayıb!',mtInformation,[mbOK],0);
 end;

end;

procedure TFormAccounts.Button1Click(Sender: TObject);
begin
  FormAccounts.Close;
end;

procedure TFormAccounts.EditACC_NOKeyPress(Sender: TObject; var Key: Char);
begin
if key=#13  then ActionSpeedSearchExecute(Sender);
end;

procedure TFormAccounts.EditACC_NO_SEARCHKeyPress(Sender: TObject;
  var Key: Char);
begin
if key=#13  then ActionSpeedSearchExecute(Sender);

end;

procedure TFormAccounts.EditNameKeyPress(Sender: TObject; var Key: Char);
begin
if key=#13  then ActionSpeedSearchExecute(Sender);
end;

procedure TFormAccounts.FormClose(Sender: TObject; var Action: TCloseAction);
begin
EditACC_NO_SEARCH.Clear;
EditACC_NO.Clear;
v_AccNo:=TransactionDataModule.ODS_Account.FieldByName('ACC_NO').AsString;

end;

