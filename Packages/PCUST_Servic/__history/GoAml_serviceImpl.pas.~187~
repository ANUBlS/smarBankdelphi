 procedure TGoAml_ServiceForm.ActinPrintExecute(Sender: TObject);
resourcestring
  FilenotFound = 'Fayl tapılmadı';
var
  Template, Templatebool, FTemplatePath, Itemindex, OBookmarkCount, What,
     oBookMarkName: Olevariant;
  IbookmarkCount: Integer;
  tFieldName: String;
  SaveChanges, OriginalFormat, RouteDocument: Olevariant;

begin
      with DM_goAml do
      begin
       Templates.Close;
        Templates.SetVariable('v_custtype',word_type);
       Templates.Open;
      end;

  What := Olevariant(wdGoToBookmark);
  FTemplatePath := DM_goAml.Templates.FieldByName('Path').AsString;
  TemplID := DM_goAml.Templates.FieldByName('ID').AsInteger;

  Template := EmptyParam;
  Templatebool := False;
  Itemindex := 1;

  WordApplication.Connect;

  WordApplication.Visible := True;
  WordApplication.Documents.Application.Caption :=  DM_goAml.Templates.FieldByName('Path').AsString;

  WordApplication.Options.CheckSpellingAsYouType := False;
  WordApplication.Options.CheckGrammarAsYouType := False;

  if FileExists(FTemplatePath) then
  begin

    WordApplication.Documents.Open(FTemplatePath, Template, Templatebool,
      Template, Template, Template, Template, Template, Template, Template,
      Template, Template, Template, Template, Template);

  end
  else
  begin

    SaveChanges := WdDoNotSaveChanges;
    OriginalFormat := UnAssigned;
    RouteDocument := UnAssigned;
    WordApplication.Quit(SaveChanges, OriginalFormat, RouteDocument);
    WordApplication.Disconnect;
    ShowMessage(FilenotFound);

  end;

  WordDocument.ConnectTo(WordApplication.Documents.Item(Itemindex));
  // WordDocument.Application.Get_ActiveWindow.Caption:=NLSLocalizer1.Caption;

  try

    with DM_goAml, ReplaceCustDataSet, WordDocument do
      For IbookmarkCount := 1 to Bookmarks.Count do
     begin

        OBookmarkCount := IbookmarkCount;
        oBookMarkName := Bookmarks.Item(OBookmarkCount).Get_Name;
        WordApplication.Selection.GoTo_(What, EmptyParam, EmptyParam,
          oBookMarkName);

      // showmessage(oBookMarkName+'d'+inttostr(TemplID));
        ReplaceCustDataSet.Close;
        SetVariable('tid', TemplID);
        SetVariable('bname', oBookMarkName);
        ReplaceCustDataSet.Open;
        tFieldName := FieldByName('FIELDNAME').AsString;

     //  showmessage(odsc_custSube.FieldByName(tFieldName).AsString) ;
        WordApplication.Selection.InsertAfter(odsc_custSube.FieldByName(tFieldName).AsString);
         end ;


    WordDocument.Disconnect;
    WordApplication.Disconnect;

  except
    SaveChanges := WdDoNotSaveChanges;
    OriginalFormat := UnAssigned;
    RouteDocument := UnAssigned;
    WordApplication.Quit(SaveChanges, OriginalFormat, RouteDocument);
    WordApplication.Disconnect;
    ShowMessage(oBookMarkName + '   Bukmarklar daxil edilmeyib ');
  end;

end;







