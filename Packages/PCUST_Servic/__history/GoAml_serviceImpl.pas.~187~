procedure TGoAml_ServiceForm.WriteLnString(S: string);
begin

  AssignFile(f, FilePAth); { Assigns the Filename }
  Append(f); { Opens the file for editing }
  Writeln(f, UTF8Encode(StringReplace(S, #13 + #10, '', [rfReplaceAll])));
  Closefile(f);
end;
procedure TGoAml_ServiceForm.WriteString(S: string);
begin

  AssignFile(f, FilePAth); { Assigns the Filename }
  Append(f); { Opens the file for editing }
  Write(f, UTF8Encode(StringReplace(S, #13 + #10, '', [rfReplaceAll])));
  Closefile(f);
end;
