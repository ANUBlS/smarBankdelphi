procedure TGoAml_ServiceForm.CreateXmlFile();
begin
   er_count := 0;
  RE_Errors.Clear;

  with DM_goAml.ODS_MainReport do
  begin
    WriteLnString('<report>');

    if not(FieldByName('rentity_id').isNUll) then
    begin
      WriteString('<rentity_id>');
      WriteString(FieldByName('rentity_id').AsString);
      WriteLnString('</rentity_id>');
    end
    else
    begin
      er_count := er_count + 1;
      RE_Errors.Lines.Add('Fayl yarnmadi! Səhvlər: rentity_id');
    end;

    WriteString('<rentity_branch>');
    WriteString(FieldByName('rentity_branch').AsString);
    WriteLnString('</rentity_branch>');

    if not(FieldByName('submission_code').isNUll) then
    begin
      WriteString('<submission_code>');
      WriteString(FieldByName('submission_code').AsString);
      WriteLnString('</submission_code>');
    end
    else
    begin
      er_count := er_count + 1;
      RE_Errors.Lines.Add('Göndərilmə tipi');
    end;

     if(pop_ctrtpr_clik=1)and
      ((DBGrid2.DataSource.DataSet.FieldByName('report_code').AsString='TPR1')or
      (DBGrid2.DataSource.DataSet.FieldByName('report_code').AsString='TPR2')or
      (DBGrid2.DataSource.DataSet.FieldByName('report_code').AsString='TPR3'))
       then
       begin
      WriteString('<report_code>');
      WriteString('CTR');
      WriteLnString('</report_code>');
       end
       else
       begin

    if not(FieldByName('report_code').isNUll) then
    begin
      WriteString('<report_code>');
      WriteString(FieldByName('report_code').AsString);
      WriteLnString('</report_code>');
    end
    else
    begin
      er_count := er_count + 1;
      RE_Errors.Lines.Add('report_code');
    end;
       end;

    WriteString('<entity_reference>');
    WriteString(FieldByName('entity_reference').AsString);
    WriteLnString('</entity_reference>');

    WriteString('<fiu_ref_number>');
    WriteString(FieldByName('fiu_ref_number').AsString);
    WriteLnString('</fiu_ref_number>');

    if not(FieldByName('submission_date').isNUll) then
    begin
      WriteString('<submission_date>');
      WriteString(FieldByName('submission_date').AsString);
      WriteLnString('</submission_date>');
    end
    else
    begin
      er_count := er_count + 1;
      RE_Errors.Lines.Add('submission_date');
    end;

    if not(FieldByName('currency_code_local').isNUll) then
    begin
      WriteString('<currency_code_local>');
      WriteString(FieldByName('currency_code_local').AsString);
      WriteLnString('</currency_code_local>');
    end
    else
    begin
      er_count := er_count + 1;
      RE_Errors.Lines.Add('currency_code_local');
