uses GoAml_serviceImpl,sboapiDataModuleImpl, DatUnit;

{$R *.dfm}

procedure TFormEdit.DBLC_MMX_reportcodeCloseUp(Sender: TObject);
begin
if DBLC_MMX_reportcode.KeyVAlue<>null then
Editreportcode.Text:=DBLC_MMX_reportcode.KeyVAlue;

end;

procedure TFormEdit.DBLC_MMX_TransmodeCloseUp(Sender: TObject);
begin
if DBLC_MMX_Transmode.KeyVAlue<>null then
EditTransModeCode.Text:=DBLC_MMX_Transmode.KeyVAlue;
end;

procedure TFormEdit.EditreportcodeKeyPress(Sender: TObject; var Key: Char);
begin
if key=#13 then

 DBLC_MMX_reportcode.KeyValue:=Editreportcode.Text;
end;

procedure TFormEdit.EditTransModeCodeKeyPress(Sender: TObject; var Key: Char);
begin
if key=#13 then
begin
if trim(EditTransModeCode.Text)<>'' then
DBLC_MMX_Transmode.KeyValue:=EditTransModeCode.Text;

DBLC_MMX_Transmode.SetFocus;
end;
end;

procedure TFormEdit.FormClose(Sender: TObject; var Action: TCloseAction);
begin
Editname.Text:='';
Editlastname.Text:='';
end;

procedure TFormEdit.FormCreate(Sender: TObject);
begin
ods_monex.Open;
end;

procedure TFormEdit.FormShow(Sender: TObject);
begin
ods_trinf.close;
ods_trinf.SetVariable('v_trid',GoAml_ServiceForm.DBGridTransactions1.DataSource.DataSet.FieldByName('transactionnumber').AsString );
ods_trinf.open;

    DBLC_MMX_Transmode.KeyValue:=ods_trinf.FieldByName('TRANSMODE_CODE').AsInteger;
    EditTransModeCode.Text:=ods_trinf.FieldByName('TRANSMODE_CODE').AsString;

    DBLC_MMX_reportcode.KeyValue:=ods_trinf.FieldByName('report_code').Asstring;
    Editreportcode.Text:=ods_trinf.FieldByName('report_code').AsString;
    XFLableTRid.Caption:= ods_trinf.FieldByName('TRANSID').AsString;
end;

procedure TFormEdit.XDBGrid1CellClick(Column: TXColumn);
begin

 case ods_trinf.FieldByName('transmode_code').AsInteger  of
  1000:begin
    showmessage('aaa')   ;
 mon_id:=ods_monex.FieldByName('id').AsInteger;

  end;
  1001:begin
    showmessage('aaa')   ;
 mon_id:=ods_monex.FieldByName('id').AsInteger;

  end;
 end;


end;

procedure TFormEdit.XFButton1Click(Sender: TObject);
begin

OP_MMXX.CallProcedure('update_mmxtransinfo' ,[ ods_trinf.FieldByName('TRANSID').AsInteger
                                             , strtoint(EditTransModeCode.Text)
                                             , Editreportcode.Text
                                             , mon_id


                                           ]);
     GoAml_ServiceForm.DBGrid2.DataSource.DataSet.First;
     GoAml_ServiceForm.DBGridTransactions1.DataSource.DataSet.Refresh;
     GoAml_ServiceForm.DBGrid2.DataSource.DataSet.Refresh;

                                           FormEdit.Close;

end;

procedure TFormEdit.XFButton2Click(Sender: TObject);
begin
if (ods_trinf.FieldByName('transmode_code').AsInteger = 1000) or
   (ods_trinf.FieldByName('transmode_code').AsInteger = 1001)
  then   begin
  showmessage('aaa222')   ;
if trim(Editname.Text)='' then
   begin
     showmessage('Adı sahəsi boşdur');
     exit;
 end;
 if trim(Editlastname.Text)='' then
   begin
     showmessage('Soyadı sahəsi boşdur');
     exit;
 end;


DM_goAml.PG_PCustService.CallProcedure('add_cust_monxs',
                                                                [Editname.Text,
                                                                 Editlastname.Text
                                                                 ]);

                                              ods_monex.Refresh;
                                            //  showmessage(ods_monex.FieldByName('id').asstring);
                                            mon_id:=ods_monex.FieldByName('id').AsInteger;
                                              Editname.Text:='';
                                              Editlastname.Text:='';
end;

end;
