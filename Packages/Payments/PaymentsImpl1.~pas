procedure TPaymentsForm.filterrefreshbuttonClick(Sender: TObject);
var
filt:string;
bc,c,bc1,c1:boolean;

begin

   bc:=false; c:=false;   bc1:=false; c1:=false;
   bc:=checkazips.Checked or checkbd.Checked;
   c:= checkbd.Checked;
   bc1:=checkbox2.Checked or checkbox3.Checked;
   c1:= checkbox3.Checked;
   dm.odspayments.SQL.Text:=dm.defds.SQL.Text;
 filt:='';
    dm.odspayments.SetVariable('sort','status');
   if checkdate.Checked then
      BEGIN
       dm.odspayments.DeclareAndSet('dat1',otdate,DTPBegin.Date);
       dm.odspayments.DeclareAndSet('dat2',otdate,DTPEnd.Date);
      END
      ELSE
      begin
        if dm.odspayments.VariableCount>1
        then
        begin
        dm.odspayments.DeleteVariable('dat1');
        dm.odspayments.DeleteVariable('dat2');
        end;
       dm.odspayments.SQL[46]:='--'+dm.odspayments.SQL[46];
      end;

 ////////////////////////////
  if checkxoks.Checked   then
  begin
  if bc then
   dm.odspayments.SQL[31]:='3,' else dm.odspayments.SQL[31]:='3' ;
   end
    else dm.odspayments.SQL[31]:='';
  if checkazips.Checked   then
  begin
  if c then dm.odspayments.SQL[32]:='2,'  else dm.odspayments.SQL[32]:='2'
   end
   else  dm.odspayments.SQL[32]:=''  ;

   if checkbd.Checked   then
   dm.odspayments.SQL[33]:='4' else dm.odspayments.SQL[33]:='' ;

   NOTHINGCHECK(checkxoks.Checked,checkazips.Checked,checkbd.Checked,1);

{-----------------------------------------------}

   IF CHECKBOX1.Checked then
   begin
   if bc1 then
   dm.odspayments.SQL[24]:='1,2'+',' else  dm.odspayments.SQL[24]:='1,2';
   end
   else dm.odspayments.SQL[24]:='';
    IF CHECKBOX2.Checked then
    BEGIN
   if c1 then Dm.odspayments.SQL[25]:='0 '+',' ELSE Dm.odspayments.SQL[25]:='0';
   END
    else Dm.odspayments.SQL[25]:='' ;
   IF CHECKBOX3.Checked then
   Dm.odspayments.SQL[26]:='3' else Dm.odspayments.SQL[26]:='' ;
     if bc1 or CHECKBOX2.Checked or CHECKBOX3.Checked then
   Dm.odspayments.SQL[26]:=Dm.odspayments.SQL[26]+',4'
   else
   Dm.odspayments.SQL[26]:=Dm.odspayments.SQL[26]+'4'   ;
    NOTHINGCHECK(checkbox1.Checked,checkbox2.Checked,checkbox3.Checked,2);
  ///////////////////////////////


  if  vartostr(filtfilials.KeyValue)<>'' then
  filt:=filt+' and filial='+vartostr(filtfilials.KeyValue)+'';
   Dm.odspayments.SQL[40]:=filt;
   memo1.Text:=Dm.odspayments.SQL.text;
   Dm.odspayments.close;
   Dm.odspayments.open;
 
