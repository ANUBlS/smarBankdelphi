  object ODSPayments: TOracleDataSet
    SQL.Strings = (
      'select * from ('
      
        'SELECT a.id,(select filial from account where id=nvl(a.from_acci' +
        'd,0)) as filial , a.amount, a.bank_acc, a.bank_bic, a.bank_code,' +
        ' a.bank_name, a.bank_tin,a.currency,'
      ' a.descreption||'#39'**'#39'||a.note as descreption,'
      
        '       a.pay_date,a.receiver_bank_acc, a.receiver_bank_bic, a.re' +
        'ceiver_bank_code,a.receiver_bank_name, a.receiver_bank_tin,'
      
        '       a.receiver_tin,a.transaction_type,a.cli_id, a.status, a.p' +
        'in1, a.pin2, a.trans_id, a.susdat,'
      '     case when a.transaction_type=1  then '#39'Bank daxili'#39
      '          when a.transaction_type=2  then '#39'AZIPS'#39
      '          when a.transaction_type=3  then '#39'Konvertasiya'#39
      '          when a.transaction_type=4 then '#39'X.O.H.K.S(paket uzvu)'#39
      '          when a.transaction_type=5 then '#39'X.O.H.K.S'#39
      '          when a.transaction_type=7  then '#39'Hesablar arasi'#39
      '          when a.transaction_type=8 then '#39'Emekhaqqi'#39
      '          when a.transaction_type=9 then '#39'Xarici kocurmeler'#39
      '          end as tr_type,'
      ''
      
        '  (select accno from ibank_client_products  where id=a.from_acci' +
        'd) as  gonderen_acc ,'
      '    case when a.transaction_type in(3,7) then'
      
        '          decode ((select accno from ibank_client_products  wher' +
        'e id=a.to_accid),null, receiver_acc,-1,receiver_acc,'
      
        '                  (select accno from ibank_client_products  wher' +
        'e id=a.to_accid))'
      '                  else a.receiver_acc end as alan_acc ,'
      '    case when a.transaction_type in(3,7) then'
      
        '                  decode ((select defaultname from ibank_client_' +
        'products  where id=a.to_accid),null, receiver_name,-1,receiver_n' +
        'ame,'
      
        '                          (select defaultname from ibank_client_' +
        'products  where id=a.to_accid))'
      '                  else a.receiver_name end as  alan_name,'
      
        '   (select defaultname from ibank_client_products  where id=a.fr' +
        'om_accid) as  gonderen_name ,'
      '    case when a.transaction_type in(3,7) then'
      
        '                  decode ((select acctin from ibank_client_produ' +
        'cts  where id=a.to_accid),null, receiver_tin,-1,receiver_tin,'
      
        '                          (select acctin from ibank_client_produ' +
        'cts  where id=a.to_accid))'
      '                  else a.receiver_tin end as  alan_inn,'
      
        '  (select acctin from ibank_client_products  where id=a.from_acc' +
        'id)           as  gonderen_inn'
      
        '   FROM ibank_temp_transaction a ,ibank_client_products c,ibank_' +
        'client_products c1'
      
        '   where  c.id(+)= a.to_accid and c1.id(+)= a.from_accid and tra' +
        'nsaction_type not in(44,55,88) and  a.trans_id is not null'
      ''
      
        'AND    (trunc(a.susdat)) >=:DAT1 AND  pay_date <=:DAT2 and a.sta' +
        'tus not in (0,9,10)'
      ')'
      ''
      ''
      ''
      ''
      ''
      ''
      '--order by transaction_type'
      ' order by :sort'
      '')
