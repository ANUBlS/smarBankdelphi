         Sheet.cells[i+k+1,17]:='=SUM(Q1:Q'+inttostr(i+k+1-1)+')';
         Sheet.Cells[i+k+1,17].Font.Bold :=true;
         Sheet.Cells[i+k+1,17].Font.Color:=clBlue;
   main.Session.Commit;
  finally

   Exl.Range['A1:A1'].Select;

   Screen.Cursor := crDefault;
   DestroySheet;
  main.EnableControls;
  end;
  main.close;

end;

 end;

