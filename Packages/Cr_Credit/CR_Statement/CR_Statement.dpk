package CR_Statement;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Statement'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CR_COMMON,
  CMVCL50,
  doa41dxe,
  Ehlib50,
  dclbde,
   QR5RunDXE,sbtranslate;

contains
  crStatementDataModule in 'crStatementDataModule.pas' {StatementDataMod: TDataModule},
  crStatementMainFormImpl in 'crStatementMainFormImpl.pas' {CrdStatementMainForm},
  crRestsHistoryImpl in 'crRestsHistoryImpl.pas' {RestForm},
  crInterestshistoryImpl in 'crInterestshistoryImpl.pas' {InterestsForm},
  crRepUnit in 'crRepUnit.pas' {ReportForm},
  crReportsheduleUnit in 'crReportsheduleUnit.pas' {ReportSheduleForm};

end.
