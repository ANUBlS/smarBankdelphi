package CR_Schedule;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Adding And Editing Contract'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CMVCL50,
  CR_COMMON,
  doa41dXE,
  dclbde,
  QR5RunDXE;

contains
  CrScheduleDataModuleImpl in 'CrScheduleDataModuleImpl.pas' {CrScheduleDataModule: TDataModule},
  CrScheduleMainFormImpl in 'CrScheduleMainFormImpl.pas' {ScheduleForm},
  CrSheduleAddUnt in 'CrSheduleAddUnt.pas' {AddEditForm},
  CrScheduleLoaderImpl in 'CrScheduleLoaderImpl.pas',
  CrTrancheScheduleImpl in 'CrTrancheScheduleImpl.pas' {TrancheScheduleForm},
  CrTrancheScheduleDataModuleImpl in 'CrTrancheScheduleDataModuleImpl.pas' {TrancheSheduleDataMod: TDataModule},
  CrAnnutyPaymentFormImpl in 'CrAnnutyPaymentFormImpl.pas' {AnnutyForm},
  CrTrSchedUpdImpl in 'CrTrSchedUpdImpl.pas' {frmUpdTrSched},
  CrTrSchedAddImpl in 'CrTrSchedAddImpl.pas' {frmAddTrSched},
  CrfrmReportTypeImpl in 'CrfrmReportTypeImpl.pas' {frmReportType},
  CrReportImpl in 'CrReportImpl.pas' {ReportForm},
  CRChangeScheduleImpl in 'CRChangeScheduleImpl.pas' {FrmChangeSchedule};

end.
