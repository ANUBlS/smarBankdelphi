package CRSYSTEM;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM System Managment Package'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  doa41dxe,
  Sboapi50,
  CMVCL50,
  CR_COMMON;

contains
  crSytemManager in 'crSytemManager.pas',
  crAboutProgramImpl in 'crAboutProgramImpl.pas' {frmAboutProgram};

end.
