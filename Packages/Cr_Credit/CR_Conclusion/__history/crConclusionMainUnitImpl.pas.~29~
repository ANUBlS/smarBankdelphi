        DBEdit13.SetFocus
      end;

     6:
      with PageControlGoorantee do
      if ActivePageIndex = 1 then
      begin
        ActivePageIndex := 2;
        DBEdit2.SetFocus
      end;

  end;
    Key := #0;
  end;
end;

procedure InitPlugin(P : String);export;
const
  sEditContract = 'Edit';
  sInsertContract = 'Insert';
  sLookContract='look'  ;

begin
  if P = sInsertContract then
    ConclusionForm.New
  else if P = sEditContract then
    ConclusionForm.Edit ;
    if P=sLookContract then
     ConclusionForm.look ;

end;

