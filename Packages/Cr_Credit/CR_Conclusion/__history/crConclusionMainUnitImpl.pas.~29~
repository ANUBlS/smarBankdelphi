        ActivePageIndex := 2;
        CMSearchEditLoacAccs.SetFocus

      end;

     4 :begin
          DBEditEh8.setFocus;
        end;
     5 :
      with PageControlGoorantee do
      if ActivePageIndex = 0 then
      begin
