procedure TConclusionForm.edNewNameClick;
var
  ProcName: String;
  i: Integer;
begin
  if (Trim((Sender as TEdit).Text)<>'') and (ord(key)=VK_RETURN) then begin
   // if (Sender as TEdit).Left>200 then
      ProcName := 'AddComp' ;

  ProcName:=' insert into cr_guarantyorgname (name) values '+'('+''''+ (Sender as TEdit).Text+''''+')';
  OracleQuery1.sql.text:=ProcName;
  OracleQuery1.Execute;
       OracleQuery1.sql.text:='commit';
      OracleQuery1.Execute;
      crDataModuleConcl.GUR_name.Refresh;

  OracleDataSet1.open;
   DBEdit30.KeyValue:= OracleDataSet1.fieldbyname('id').asinteger;

    (Sender as TEdit).Visible := False;
    for i:= 0 to ComponentCount-1 do
      if Components[i] is TSpeedButton then
        (Components[i] as TSpeedButton).Enabled := True;
  end;
  if  (ord(key)=VK_RETURN) then begin
    (Sender as TEdit).Visible := False;
    for i:= 0 to ComponentCount-1 do
      if Components[i] is TSpeedButton then
        (Components[i] as TSpeedButton).Enabled := True;
  end;

  end;

