procedure TConclusionForm.SaveState(Save : Boolean);
begin
  with crDataModuleConcl.CreditProps do
  begin

    if Save then
      Post
    else
      Cancel;

    if FInsertCredit then
    begin

      if Save then
    doInsert
      else
        Cancel;

      PageControlMain.ActivePageIndex := 0;

      CustIDEdit.SetFocus
    end
    else
    Self.Close;
  end;
end;

