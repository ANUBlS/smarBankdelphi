package CR_Conclusion;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Adding And Editing Contract'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  doa41dxe,
  Sboapi50,
  CMVCL50,
  CR_COMMON,
  SBTranslate;

contains
  crDataModuleConclusion in 'crDataModuleConclusion.pas' {CRDataModuleConcl: TDataModule},
  crConclusionMainUnitImpl in 'crConclusionMainUnitImpl.pas' {ConclusionForm},
  crConclusionCommonDecls in 'crConclusionCommonDecls.pas',
  crCreateCMAccountsImpl in 'crCreateCMAccountsImpl.pas' {FormCreateCMAccounts},
  crLoanBalAccsUnit in 'crLoanBalAccsUnit.pas' {FormLoanBalance};

end.
