package CR_Corrector;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Corrector'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  doa41dxe,
  sboapi50,
  CMVCL50,
  DclEhlib50,
  CR_COMMON;

contains
  cr_CorrectorMainFormImpl in 'cr_CorrectorMainFormImpl.pas' {CorrectorMainForm},
  cr_CorrectorDataModule in 'cr_CorrectorDataModule.pas' {CorrectorDataMod: TDataModule};

end.
