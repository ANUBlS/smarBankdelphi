package CR_ADM;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  doa41dxe,
  dclbde,
  CMVCL50,
  sboapi50,
  CR_COMMON,sbtranslate;

contains
  cr_admDataModule in 'cr_admDataModule.pas' {admDM: TDataModule},
  cr_admMainFormImpl in 'cr_admMainFormImpl.pas' {frmMain},
  cr_admLoader in 'cr_admLoader.pas',
  cr_admPluginAddImpl in 'cr_admPluginAddImpl.pas' {frmPluginAdd},
  cr_admPluginUpdImpl in 'cr_admPluginUpdImpl.pas' {frmUpdPlugin},
  cr_admUsersAddImplpas in 'cr_admUsersAddImplpas.pas' {frmUsersAdd},
  cr_admUsersDelImplpas in 'cr_admUsersDelImplpas.pas' {frmUsersDel},
  cr_admUserGrantsImpl in 'cr_admUserGrantsImpl.pas' {frmUserGrants},
  cr_admGroupAddImpl in 'cr_admGroupAddImpl.pas' {frmGroupAdd},
  cr_admGroupUsersImpl in 'cr_admGroupUsersImpl.pas' {frmGroupUsers},
  cr_admexpertimpl in 'cr_admexpertimpl.pas' {ExpertDel};

end.
