package CR_Prolongation;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM Prolongation Package'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  sboapi50,
  CR_COMMON,
  CMVCL50,

  doa41dxe
  ;

contains
  crProlongDataModuleImpl in 'crProlongDataModuleImpl.pas' {crProlongDataMod: TDataModule},
  crProlongMainFormImpl in 'crProlongMainFormImpl.pas' {ProlongMainForm},
  crProlongAddForm in 'crProlongAddForm.pas' {frmProlongAdd};

end.
