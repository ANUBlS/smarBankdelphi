package CR_WRSETUP;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Credit Manager WR Setup package'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CMVCL50,
  CR_COMMON,
  sbtranslate;

contains
  crWRSetupLoader in 'crWRSetupLoader.pas',
  crWRSetupDataModImpl in 'crWRSetupDataModImpl.pas' {WRSetupDataMod: TDataModule},
  crTemplateAddEditUnt in 'crTemplateAddEditUnt.pas' {TemplAddEditForm},
  crBookmarkAddEditunt in 'crBookmarkAddEditunt.pas' {BookmarkAddEditForm},
  crWRTemplatesTuning in 'crWRTemplatesTuning.pas' {WRTemplateSetup},
  crWRBookmarksTuning in 'crWRBookmarksTuning.pas' {WRBookmarkSetup},
  crFilialinfoimpl in 'crFilialinfoimpl.pas' {FrmFilial};

end.
