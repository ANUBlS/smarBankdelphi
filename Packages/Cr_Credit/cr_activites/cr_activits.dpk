package cr_activits;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Adding And Editing Contract'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
rtl        ,
  vcl,
  doa41dxe,
  Sboapi50,
  CMVCL50,
  CR_COMMON;

contains
  cractImpl in 'cractImpl.pas' {ActFrom},
  crFrmIEAddEditImpl in 'crFrmIEAddEditImpl.pas' {FrmIEAddEdit};

end.
