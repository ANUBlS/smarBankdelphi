function  TFrmTuning.CalcLimit(Active,Passive,Capital:Extended):Extended;
begin
  Result :=(Active-Passive)*100/Capital;//;(Abs(Active-Passive)*100)/Capital;
end;

procedure  TFrmTuning.OpenDataSet(DataSet :TOracleDataSet;VarabName:String;VarabValue:TDateTime);
begin
   with  DataSet  do
   begin
     if  Active  then Close;
     SetVariable(VarabName,VarabValue);
     Open;
   end;
end;
procedure  TFrmTuning.OpenDataSet(DataSet :ToracleDataSet;VariableNames :array of const;VariableValues :array of const);
var
   NameIndex  :0..255;
   NamesCount :0..255;
   TempruaryVName :string;
   TempruaryVValue :Variant;
begin
  NamesCount :=High(VariableNames);
  with   DataSet  do
  if  Active  then  Close;
  for   NameIndex :=0   to  NamesCount  do
  begin
    TempruaryVName :=VariableNames[NameIndex].VPChar;
    case  VariableValues[NameIndex].VType  of
        vtVariant :TempruaryVValue :=VariableValues[NameIndex].VVariant^;
        vtInteger :TempruaryVValue :=Integer(VariableValues[NameIndex].VInteger);
      end;// case
    with   DataSet   do
    begin
      SetVariable(TempruaryVName,TempruaryVValue);
    end;
  end;
  with   DataSet  do  Open
end;
