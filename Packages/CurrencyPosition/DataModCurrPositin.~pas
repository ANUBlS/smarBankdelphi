unit DataModCurrPositin;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  Oracle, Db, OracleData;

type
  TCPDataMod = class(TDataModule)
    OPackage: TOraclePackage;
    ODSCurrPosition: TOracleDataSet;
    DataSrcCurrPosition: TDataSource;
    ODSCurrency: TOracleDataSet;
    DataSrcRate: TDataSource;
    ODSDate: TOracleDataSet;
    DataSrcDate: TDataSource;
    ODSSum: TOracleDataSet;
    DataSrcSum: TDataSource;
    BankInfo: TOracleDataSet;
    CapitalData: TOracleDataSet;
    CapitalDataACTIVE: TFloatField;
    CapitalDataPASSIVE: TFloatField;
    CapitalDataCAPITAL: TFloatField;
    ODSCurrPositionBANKID: TStringField;
    ODSCurrPositionSHORTNAME: TStringField;
    ODSCurrPositionUSING: TIntegerField;
    ODSCurrPositionPRESENTDATE: TDateTimeField;
    ODSCurrPositionCURRENCY: TIntegerField;
    ODSCurrPositionOFFICAL: TStringField;
    ODSCurrPositionBALANCE: TFloatField;
    ODSCurrPositionINCOMING: TFloatField;
    ODSCurrPositionACTIVE: TFloatField;
    ODSCurrPositionPASSIVE: TFloatField;
    ODSCurrPositionRATE: TFloatField;
    ODSCurrPositionEXTRA: TFloatField;
    ODSCurrPositiontest: TStringField;
    PK_CAPITAL: TOraclePackage;
    CAPITAL_PAK: TOraclePackage;
    procedure DataModuleCreate(Sender: TObject);
    procedure DataModuleDestroy(Sender: TObject);
    procedure ODSCurrPositionCalcFields(DataSet: TDataSet);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  CPDataMod: TCPDataMod;

implementation

{$R *.DFM}

uses  sboapiDataModuleImpl;


procedure TCPDataMod.DataModuleCreate(Sender: TObject);
begin
  BankInfo.Open;
end;

procedure TCPDataMod.DataModuleDestroy(Sender: TObject);
begin
  BankInfo.CloseAll;
end;

procedure TCPDataMod.ODSCurrPositionCalcFields(DataSet: TDataSet);
begin
 with DataSet do
  FieldByName('BANKID').AsString :='0' + FieldByName('BANKID').AsString;
end;

end.
