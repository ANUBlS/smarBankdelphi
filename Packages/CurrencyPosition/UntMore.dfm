  object ODSSdv: TOracleDataSet
    SQL.Strings = (
      'select'
      '(select sum(A) from ('
      
        'Select Currency, Rate*Round(Sum(Active)) as A from  CurrencyPosi' +
        'tion_Smart Where '
      'PresentDate=:ADate and (Using = :AUsing) and (Incoming in (1,3))'
      'group by Currency, Rate'
      '))'
      '-'
      '(select sum(A) from ('
      
        'Select Currency, Rate*Round(Sum(Passive)) as A from CurrencyPosi' +
        'tion_Smart Where '
      'PresentDate=:ADate and (Using =:AUsing) and (Incoming in (2,3))'
      'group by Currency, Rate'
      ')) as  SDVSum'
      ''
      'from dual'
      ' '
      ' '
      ' ')
    Optimize = False
    Variables.Data = {
      04000000020000000C0000003A00410044004100540045000C00000000000000
      000000000E0000003A0041005500530049004E00470003000000000000000000
      0000}
    Cursor = crSQLWait
    Session = sboapiDataModule.SBSession
    Left = 158
    Top = 86
    object ODSSdvSDVSUM: TFloatField
      FieldName = 'SDVSUM'
    end
  end
