  object OracleDataSet2: TOracleDataSet
    SQL.Strings = (
      
        'Select Currency, (Rate*Round(Sum(Active))-Rate*Round(Sum(Passive' +
        '))) as SumRate from CurrencyPosition_Smart '
      ' Where '
      
        '(PresentDate=:Adate) and (Using =:AUSING)and(Currency<>0) and (I' +
        'ncoming in (1,3)) '
      'Group by Currency, Rate')
