procedure TFrmTuning.TBReportClick(Sender: TObject);
var
   V :Variant;
   TableName :String;
   SqlStr :WideString;
   SqlStrSdv :WideString;
begin

if ComBoxPresentDates.Items.Count>0 then
 begin
 if   IsEmpty  then
 begin
   TableName :=' CurrencyPosition_'+FrmCurrencyPosition.sb_GetUserName;
   SqlStr :='Select'
+' ActiveSet.ShortName as ShortName'
+',ActiveSet.Currency as Currency'
+',ActiveSet.Rate  as Rate'
+',ActiveSet.Actives as Actives'
+',ActiveSet.Pok_Actives as Pok_Actives'
+',PassiveSet.Passives as Passives'
+',PassiveSet.Pok_Passives as Pok_Passives'
+',OUTactiveset.OUTactives,OUTactiveset.OUTpok_actives'
+',OUTpassiveset.OUTpassives,OUTpassiveset.OUTpok_passives'
+',(activeset.actives + OUTactiveset.OUTactives) as SumActives'
+',(activeset.pok_actives + OUTactiveset.OUTpok_actives) as SumPokActives'
+',(passiveset.passives + OUTpassiveset.OUTpassives) as SumPassives'
+',(passiveset.pok_passives + OUTpassiveset.OUTpok_passives) as SumPokPassives '
+'From '
+'(Select '
+'Currency'
+',Max(Shortname) as ShortName'
+',Max(Rate) as Rate'
+',Round(Sum(Active)) as Actives'
+',Round(Sum(Active))*Max(Rate) as Pok_Actives '
+'From' + TableName
+' Where'
+' Currency<>0 and extra=0 and '
+' ((Incoming=1)or(Incoming=3)) and '
+' PresentDate=:ADate'
+' Group by'
+' Currency) ActiveSet,'
+'(Select'
+' Currency'
+',Max(Shortname) as ShortName'
+',Max(Rate) as Rate'
+',Round(Sum(Passive)) as Passives'
+',Round(Sum(Passive))*Max(Rate) as Pok_Passives'
+' From' + TableName
+' Where '
+'Currency<>0 and extra=0 and '
+'((Incoming=1)or(Incoming=3)) and '
+'PresentDate=:ADate '
+'Group by '
+'Currency) PassiveSet, '

//TNariman

+'(Select '
+'Currency'
+',Max(Shortname) as ShortName'
+',Max(Rate) as Rate'
+',Round(Sum(Active)) as OUTActives'
+',Round(Sum(Active))*Max(Rate) as OUTPok_Actives '
+'From' + TableName
+' Where'
+' Currency<>0 and extra=1 and '
+' ((Incoming=1)or(Incoming=3)) and '
+' PresentDate=:ADate'
+' Group by'
+' Currency) OUTActiveSet,'

+'(Select'
+' Currency'
+',Max(Shortname) as ShortName'
+',Max(Rate) as Rate'
+',Round(Sum(Passive)) as OUTPassives'
+',Round(Sum(Passive))*Max(Rate) as OUTPok_Passives'
+' From' + TableName
+' Where '
+'Currency<>0 and extra=1 and '
+'((Incoming=1)or(Incoming=3)) and '
+'PresentDate=:ADate '
+'Group by '
+'Currency) OUTPassiveSet '

//TNariman

+'Where '
+' (ActiveSet.Currency=PassiveSet.Currency)'
+' and (activeset.currency = OUTactiveset.currency(+)) '
+' and (activeset.currency = OUTpassiveset.currency(+)) ';


SqlStrSdv :=
'Select '
+'(Select Sum(A) from ('
+'Select Currency, Rate*Round(Sum(Active)) as A from '
+TableName
+' Where '
+'(PresentDate=:ADate) and (Using = :AUsing)and(Currency<>0) and (Incoming in (1,3)) '
+'Group by Currency, Rate '
+')) '
+'- '
+'(Select Sum(A) From ( '
+'Select Currency, Rate*Round(Sum(Passive)) as A from '+TableName+' Where '
+'(PresentDate=:ADate) and (Using = :AUsing)and(Currency<>0) and (Incoming in (1,3)) '
+'Group by Currency, Rate '
+')) as  SDVSum From Dual ';
//  //CPReport.ODSReport.SQL.SaveToFile('C:\cp1.txt');
  FrmCurrencyPosition.InputQueryToDataSet(CPReport.ODSReport,SqlStr);
  FrmCurrencyPosition.InputQueryToDataSet(FrmTuning.ODSSdv,SqlStrSdv);
  IsEmpty  :=False;
 end;

   try
   V :=Integer(Trunc(FrmCurrencyPosition.Dates[ComBoxPresentDates.ItemIndex]));
   OpenDataSet(CPReport.ODSReport,'ADate',V);
   IsClosed :=False;
   InitialReport;
   finally
     CPReport.ODSReport.Close;
     ODSSdv.Close;
     FrmCurrencyPosition.ODSFillFile.Close;
   end;
 end;
end;

