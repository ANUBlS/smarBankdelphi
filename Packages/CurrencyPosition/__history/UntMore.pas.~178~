procedure TFrmTuning.To_Excel;
Var
 excel,sh   :Variant;
  i:Integer;
begin
   excel:=CreateOleObject('Excel.application');
   sh:=excel.workbooks.open(GetCurrentDir+'\VALYUTA_MOVQE.xlsx');
   with CPReport.ODSReport do begin
     for i:=1 to RecordCount do
     begin
      excel.cells[I+15,2]:=FieldByName('SHORTNAME').asString;
      excel.cells[I+15,3]:=FieldByName('RATE').asString;

      excel.cells[I+15,4]:=FieldByName('ACTIVES').asString;

      if not FieldByName('OUTACTIVES').IsNull then
      excel.cells[I+15,5]:=FieldByName('OUTACTIVES').asString
      else
      excel.cells[I+15,5]:=0;

      excel.cells[I+15,6]:=FieldByName('ACTIVES').AsFloat+FieldByName('OUTACTIVES').asFloat;

      excel.cells[I+15,7]:=FieldByName('PASSIVES').asString;

       if not FieldByName('OUTPASSIVES').IsNull then
      excel.cells[I+15,8]:=FieldByName('OUTPASSIVES').asString
      else
      excel.cells[I+15,8]:=0;

      excel.cells[I+15,9]:=FieldByName('PASSIVES').AsFloat+FieldByName('OUTPASSIVES').asFloat;

      excel.cells[I+15,10]:=FieldByName('POK_ACTIVES').asString;
      excel.cells[I+15,11]:=FieldByName('POK_PASSIVES').asString;

      IF ((FieldByName('ACTIVES').AsFloat + FieldByName('OUTACTIVES').AsFloat)-(FieldByName('SdvPassiv').AsFloat + FieldByName('OUTPASSIVES').AsFloat)) > 0
      then
      excel.cells[I+15,12]:=((FieldByName('ACTIVES').AsFloat + FieldByName('OUTACTIVES').AsFloat) - (FieldByName('SdvPassiv').AsFloat + FieldByName('OUTPASSIVES').AsFloat))
      else
      excel.cells[I+15,12]:=0;

      IF ((FieldByName('POK_ACTIVES').AsFloat + FieldByName('OUTPOK_ACTIVES').AsFloat)-(FieldByName('SdvPokPassiv').AsFloat + FieldByName('OUTPOK_PASSIVES').AsFloat)) > 0
      then
      excel.cells[I+15,13]:=((FieldByName('POK_ACTIVES').AsFloat + FieldByName('OUTPOK_ACTIVES').AsFloat) - (FieldByName('SdvPokPassiv').AsFloat + FieldByName('OUTPOK_PASSIVES').AsFloat))
      else
      excel.cells[I+15,13]:=0;

      IF ((FieldByName('SdvPassiv').AsFloat + FieldByName('OUTPASSIVES').AsFloat)-(FieldByName('ACTIVES').AsFloat + FieldByName('OUTACTIVES').AsFloat)) > 0
      then
      excel.cells[I+15,14]:=((FieldByName('SdvPassiv').AsFloat + FieldByName('OUTPASSIVES').AsFloat) - (FieldByName('ACTIVES').AsFloat + FieldByName('OUTACTIVES').AsFloat))
      else
      excel.cells[I+15,14]:=0;

      IF ((FieldByName('SdvPokPassiv').AsFloat + FieldByName('OUTPOK_PASSIVES').AsFloat)-(FieldByName('POK_ACTIVES').AsFloat + FieldByName('OUTPOK_ACTIVES').AsFloat)) > 0
      then
      excel.cells[I+15,15]:=((FieldByName('SdvPokPassiv').AsFloat + FieldByName('OUTPOK_PASSIVES').AsFloat) - (FieldByName('POK_ACTIVES').AsFloat + FieldByName('OUTPOK_ACTIVES').AsFloat))
      else
      excel.cells[I+15,15]:=0;

      excel.cells[I+15,16]:=FormatFloat('0.00',
                                 FrmTuning.CalcLimit(FieldByName('POK_Actives').Value + FieldByName('OUTPOK_Actives').AsFloat,
                                 FieldByName('SdvPokPASSIV').Value + FieldByName('OUTPOK_passives').AsFloat,
                                 StrToFloat(FrmTuning.ECapital.Text)));
      next;
     end;
      excel.cells[21,13]:=CPReport.SLong.Caption;
      excel.cells[22,13]:=CPReport.OLong.Caption;
      excel.cells[23,13]:=CPReport.QRLabel36.Caption;

      excel.cells[21,15]:=CPReport.SShort.Caption;
      excel.cells[22,15]:=CPReport.OShort.Caption;
      excel.cells[23,15]:=CPReport.QRLabel37.Caption;

      excel.cells[24,13]:=CPReport.SMLong.Caption;
      excel.cells[25,13]:=CPReport.
      excel.cells[24,15]:=CPReport.
      excel.cells[25,15]:=CPReport.
      excel.cells[24,16]:=CPReport.
      excel.cells[25,16]:=CPReport.

      excel.cells[10,9]:='TARIX';
      excel.cells[12,2]:='Bankın adı: '+OracleDataSet1.FieldByName('Bank').AsString;
      excel.cells[12,6]:='Məsul şəxs: '+EManager.Text;
      excel.cells[12,10]:='Telefon: '+OracleDataSet1.FieldByName('Tel').AsString;
      excel.cells[24,2]:= 'Hesabat tarixinə bankın kapitalı '+ECapital.Text+' təşkil edir';
      excel.cells[25,2]:='Mərkəzi Bankın 16/03/2001 tarixli razılığına əsasən '+
      ECapital.Text+' mln manat məbləği passivlərdə əlavə olunur';

     // excel.cells[I+11,11]:=FormatFloat('#0.0',SVMCovering);
     excel.visible:=true;
 end;
end;

