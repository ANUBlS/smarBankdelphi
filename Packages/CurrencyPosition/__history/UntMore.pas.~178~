function  TFrmTuning.CalcLimit(Active,Passive,Capital:Extended):Extended;
begin
  Result :=(Active-Passive)*100/Capital;//;(Abs(Active-Passive)*100)/Capital;
end;

procedure  TFrmTuning.OpenDataSet(DataSet :TOracleDataSet;VarabName:String;VarabValue:TDateTime);
begin
   with  DataSet  do
   begin
     if  Active  then Close;
     SetVariable(VarabName,VarabValue);
     Open;
   end;
end;
procedure  TFrmTuning.OpenDataSet(DataSet :ToracleDataSet;VariableNames :array of const;VariableValues :array of const);
var
   NameIndex  :0..255;
   NamesCount :0..255;
   TempruaryVName :string;
   TempruaryVValue :Variant;
begin
  NamesCount :=High(VariableNames);
  with   DataSet  do
  if  Active  then  Close;
  for   NameIndex :=0   to  NamesCount  do
  begin
    TempruaryVName :=VariableNames[NameIndex].VPWideChar;
    case  VariableValues[NameIndex].VType  of
        vtVariant :TempruaryVValue :=VariableValues[NameIndex].VVariant^;
        vtInteger :TempruaryVValue :=Integer(VariableValues[NameIndex].VInteger);
      end;// case
    with   DataSet   do
    begin
      SetVariable(TempruaryVName,TempruaryVValue);
    end;
  end;
  with   DataSet  do  Open
end;
procedure  TFrmTuning.InitialReport;
var
    Delta :Extended;
    V :Integer;
    Using :Integer;
    SVMCovering :Extended;
begin
   V :=Integer(Trunc(FrmCurrencyPosition.Dates[ComBoxPresentDates.ItemIndex]));
    with   CPReport,OracleDataSet1   do
    begin
      QRLBank.Caption :='Bankın adı:'+FieldByName('Bank').AsString;
      QRLManagerName.Caption :='Məsul şəxs:   '+EManager.Text;
      QRLTelephon.Caption :='Telefon:'+FieldByName('Tel').AsString;
      QRLDate.Caption :=FormatDateTime('dd/mm/yyy',FrmCurrencyPosition.Dates[ComBoxPresentDates.ItemIndex]);
      Using  :=0;
      OpenDataSet(ODSSdv,['ADate','AUsing'],[V,Using]);
      Delta  :=ODSSdv.FieldByName('SDVSum').AsFloat;
          if   Delta>0  then
          begin
            OLong.Caption :=FormatFloat('#0',Delta);
            OShort.Caption :='0';
          end  else
          begin
            OLong.Caption :='0';
            OShort.Caption :=FormatFloat('#0',(Delta)); //Abs(Delta));  ***Modified by Hesen R. 23.08.06
          end;
          QMLong.Caption :=OLong.Caption;
          QMShort.Caption :=OShort.Caption;
          try
          Limit2.Caption :=FormatFloat('0.00',Abs(CalcLimit(0,Delta,StrToFloat(ECapital.Text))));
           except
             on E:EConvertError  do
             Limit2.Caption :='Invalid Capital';
           end;
           //SDV  - ye  Daxil olanlar
           Using :=1;
           OpenDataSet(FrmCurrencyPosition.ODSFillFile,['CurrentDate','Currency'],[V,1]);
           OpenDataSet(ODSSdv,['ADate','AUsing'],[V,Using]);
           Delta  :=ODSSdv.FieldByName('SDVSum').AsFloat
                    -OracleDataSet1.FieldByName('SVM').AsFloat*FrmCurrencyPosition.ODSFillFile.FieldByName('Rate').AsFloat;

          if   Delta>0  then
          begin
            SLong.Caption :=FormatFloat('#0',Delta);
            SShort.Caption :='0';
          end  else
          begin
            SLong.Caption :='0';
            SShort.Caption :=FormatFloat('#0',Delta); //Abs(Delta));  ***Modified by Hesen R. 23.08.06
          end;
          SMLong.Caption :=SLong.Caption;
          SMShort.Caption :=SShort.Caption;
           try
          Limit1.Caption :=FormatFloat('0.00'
                           ,Abs(CalcLimit(0,Delta,StrToFloat(ECapital.Text))));
           except
             on E:EConvertError  do
             Limit1.Caption :='Invalid Capital';
           end;
     QRLKapital.Caption :='Hesabat tarixinə bankın kapitalı  '+ECapital.Text+' manat təşkil edir';
     SVMCovering :=(OracleDataSet1.FieldByName('SVM').AsFloat*FrmCurrencyPosition.ODSFillFile.FieldByName('Rate').AsFloat)/1000000;
     QRLQeyd.Caption :='Mərkəzi Bankın 16/03/2001 tarixli razılığına əsasən '+FormatFloat('#0.0',SVMCovering)
                        +' mln manat məbləği passivlərdə əlavə olunur.';
     if PrintExcel=False then Preview
     else
     begin
     to_excel;
     printExcel:=False;
     end;
    end;
end;

