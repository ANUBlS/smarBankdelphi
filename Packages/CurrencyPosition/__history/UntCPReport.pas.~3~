{$R *.DFM}

procedure TCPReport.QRSubDetail1BeforePrint(Sender: TQRCustomBand;
  var PrintBand: Boolean);
begin
  try
   QRLlIMIT.Caption :=FormatFloat('0.00',
                                 FrmTuning.CalcLimit(ODSReport.FieldByName('POK_Actives').Value + ODSReport.FieldByName('OUTPOK_Actives').AsFloat,
                                 ODSReport.FieldByName('SdvPokPASSIV').Value + ODSReport.FieldByName('OUTPOK_passives').AsFloat,
                                 StrToFloat(FrmTuning.ECapital.Text)));
  except
     on E:EConvertError do
      QRLLimit.Caption :='Invalid Capital';
  end;
end;

procedure TCPReport.ODSReportCalcFields(DataSet: TDataSet);
begin
   with   ODSReport  do
   if  FieldByName('Currency').AsInteger=CPDataMod.BankInfo.FieldByName('svm_currencyID').AsInteger  then //?
    begin
       FieldByName('SdvPassiv').AsFloat :=FieldByName('Passives').AsFloat
       + FrmTuning.OracleDataSet1.FieldByName('SVM').AsFloat;
       FieldByName('SdvPokPassiv').AsFloat :=FieldByName('Pok_Passives').AsFloat
       + Round((FrmTuning.OracleDataSet1.FieldByName('SVM').AsFloat)*(FieldByName('Rate').AsFloat));
    end else
    begin
      FieldByName('SdvPassiv').AsFloat :=FieldByName('Passives').AsFloat;
      FieldByName('SdvPokPassiv').AsFloat :=FieldByName('Pok_Passives').AsFloat;
    end;

end;


