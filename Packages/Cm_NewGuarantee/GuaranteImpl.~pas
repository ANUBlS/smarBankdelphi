unit GuaranteImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  ComCtrls, Buttons, ExtCtrls, StdCtrls;

type
  TFrmGuarante = class(TForm)
    PageControl1: TPageControl;
    TabSheet1: TTabSheet;
    TabSheet2: TTabSheet;
    Panel1: TPanel;
    SpeedButton1: TSpeedButton;
    SpeedButton2: TSpeedButton;
    panel2: TTabControl;
    procedure FormCanResize(Sender: TObject; var NewWidth,
      NewHeight: Integer; var Resize: Boolean);
    procedure FormCreate(Sender: TObject);
    procedure SpeedButton1Click(Sender: TObject);
    procedure panel2Change(Sender: TObject);
    procedure SpeedButton2Click(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure PageControl1Change(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FrmGuarante: TFrmGuarante;
  procedure InitPlugin(s:string);export;
implementation
{$R *.DFM}
uses   CommonDecls , DmImpl;

  procedure InitPlugin(s:string);export;
begin
   FrmGuarante.ShowModal;
end;
exports
     InitPlugin;
procedure TFrmGuarante.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
resize:=false
end;

procedure TFrmGuarante.FormCreate(Sender: TObject);
begin
GurDm:=tGurDm.create(self);
end;

procedure TFrmGuarante.SpeedButton1Click(Sender: TObject);
var
 index :Integer;
begin
  //savechg;

  //OPKIP.CallProcedure ( 'ipaddnewcard', [Get_SelectedCrdID] );

  with Panel2,GurDm.MainDSet do
  begin
   Refresh;
   recno:=RecordCount;
   index:=RecordCount;
   TabIndex :=Tabs.Add(Format('Kart №%d', [Index-1]));
  end;

end;
 procedure TFrmGuarante.panel2Change(Sender: TObject);
begin
//  savechg;
  GurDm.MainDSet.RecNo := (Sender as TTabControl).TabIndex+1;
end;

procedure TFrmGuarante.SpeedButton2Click(Sender: TObject);
var
   Index:integer;
begin
//OPKIP.CallProcedure('ipdeletecard',[get_selectedcrdid, ODSIPredCARDID.AsVariant]);
GurDm.MainDSet.Refresh;
if Panel2.Tabs.Count=1 then exit;
Panel2.Tabs.Clear;
for Index := 0 to GurDm.MainDSet.RecordCount-1 do
panel2.Tabs.Add(Format('Карт №%d', [Index]));

end;

procedure TFrmGuarante.FormShow(Sender: TObject);
begin
 Panel2.TabIndex := 3;
with GurDm do
 begin
   MainDSet.close;
   MainDSet.SetVariable('CREDITID',Get_SelectedCrdID);
   MainDSet.open;
 //  Panel2.Tabs.Count:=1
end;
end;

procedure TFrmGuarante.PageControl1Change(Sender: TObject);
begin
  GurDm.MainDSet.RecNo := 1;
  Panel2.TabIndex := 1;
end;


procedure TFrmGuarante.FormKeyPress(Sender: TObject; var Key: Char);
begin
   if ORD(key) = VK_ESCAPE then close
end;

initialization
 FrmGuarante := TFrmGuarante.Create(CommonApplication);

end.

