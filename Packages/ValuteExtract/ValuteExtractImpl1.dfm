  object OraDataSetMainExell: TOracleDataSet
    SQL.Strings = (
      
        'select sel.acc_no, sel.val_name, TO_Char(sel.dat, '#39'dd/mm/yyyy'#39') ' +
        'dat, sel.name, '
      
        'Round(ABS(decode (sel.Prefix, '#39'D'#39',sel.Ammount_c, '#39'K'#39', 0) ),2) AS' +
        ' Debet,  '
      
        'Round(ABS(decode (sel.Prefix, '#39'K'#39',sel.Ammount, '#39'D'#39', 0)),2) Kredi' +
        't'
      'from ('
      
        'select acc.acc_no, val.val_name, prov.dat, prov.ammount, prov.am' +
        'mount_c, prov.name, ('#39'D'#39') as Prefix'
      'from provarch prov, account acc, avalute val'
      'where prov.debt = :acc_id'
      'and acc.id = prov.kredit'
      'and val.valute = acc.val_acc'
      'and prov.dat >= :BeginDat'
      'and prov.dat <= :EndDat'
      'union'
      
        'select acc.acc_no, val.val_name, prov.dat,  prov.ammount, prov.a' +
        'mmount_c, prov.name , ('#39'K'#39') as Prefix'
      'from provarch prov, account acc, avalute val'
      'where prov.kredit = :acc_id'
      'and acc.id = prov.debt '
      'and val.valute = prov.val_acc'
      'and prov.dat >=:BeginDat'
      'and prov.dat <= :EndDat) sel'
      'order by sel.dat, sel.prefix, sel.val_name'
      '')
    Optimize = False
    Variables.Data = {
      04000000030000000E0000003A004100430043005F0049004400040000000000
      000000000000120000003A0042004500470049004E004400410054000C000000
      00000000000000000E0000003A0045004E0044004400410054000C0000000000
      000000000000}
    QBEDefinition.QBEFieldDefs = {
      05000000060000000C0000004100430043005F004E004F000100000000001000
      0000560041004C005F004E0041004D0045000100000000000600000044004100
      5400010000000000080000004E0041004D0045000100000000000A0000004400
      45004200450054000100000000000C0000004B00520045004400490054000100
      00000000}
    Session = sboapiDataModule.SBSession
    Left = 264
    Top = 160
