  object PaymentDataSet_ol: TOracleDataSet
    SQL.Strings = (
      
        'select   sum(p_ammount) as credit ,sum(p_ammount_c) as kredit, p' +
        '_cntr_name as cuntry,p_valu_name as valname, kode as kod,repname' +
        ',e_kod,val_kod'
      ',data as data'
      ',lammount as lammount'
      ',dbal as dbal'
      ',kbal as kbal'
      ',op as op'
      ',debacno as debacno'
      ',kredacno as kredacno'
      'from'
      '(SELECT'
      
        '  a.ammount_c as p_ammount_c,  a.ammount as p_ammount, s.cntr_na' +
        'me as p_cntr_name ,v.valu_name as p_valu_name, s.CNTR_CODE as ko' +
        'de,r.name as repname,r.id as e_kod,v.valu_inter as val_kod'
      '  ,a.dat as data'
      '  ,a.lammount as lammount'
      '  ,a1.bal_cn1 as dbal'
      '  ,a2.bal_cn1 as kbal'
      '  ,u.name as op'
      '  ,a1.acc_no as debacno'
      '  ,a2.acc_no as kredacno'
      
        ' FROM provarch a,countries s,avalute_t v,reportdescs r,user$ u,a' +
        'ccount a1,account a2'
      
        '  where   a1.id=a.debt and a2.id=a.kredit and u.id= a.op_id and ' +
        'COUNTRID=s.id and'
      '        v.valute=a.val_acc and'
      '        s.id>0 and'
      '        r.id=nvl(a.reportid,0)  and'
      '        a.dat between :dat and :dat1'
      
        '        and a.debt in (select id from account where BAL_CN1 in( ' +
        'SELECT acc FROM payment_re_accs ))'
      
        '       group by    a.ammount,a.ammount_c , s.cntr_name,v.valu_na' +
        'me,s.CNTR_CODE,r.name,r.id,v.valu_inter,'
      
        '       a.dat,a.lammount,a1.bal_cn1,a2.bal_cn1,u.name,a1.acc_no,a' +
        '2.acc_no)'
      
        '       group by p_cntr_name,p_valu_name,kode,repname,e_kod,val_k' +
        'od'
      '       ,data,lammount,dbal,kbal,op ,debacno,kredacno'
      ''
      '  union'
      ''
      
        ' select sum(p_ammount) as credit ,sum(p_ammount_c) as kredit,   ' +
        'p_cntr_name as cuntry,p_valu_name as valname, kode as kod,repnam' +
        'e,e_kod,val_kod'
      ',data as data'
      ',lammount as lammount'
      ',dbal as dbal'
      ',kbal as kbal'
      ',op as op'
      ',debacno as debacno'
      ',kredacno as kredacno'
      ' from'
      '(SELECT'
      
        '        a.ammount_c as p_ammount_c,a.ammount as p_ammount ,  s.c' +
        'ntr_name as p_cntr_name ,v.valu_name as p_valu_name, s.CNTR_CODE' +
        ' as kode,r.name as repname,r.id as e_kod,v.valu_inter as val_kod'
      ''
      '   ,a.dat as data'
      '  ,a.lammount as lammount'
      '  ,a1.bal_cn1 as dbal'
      '  ,a2.bal_cn1 as kbal'
      '  ,u.name as op'
      '  ,a1.acc_no as debacno'
      '  ,a2.acc_no as kredacno'
      
        '  FROM provarch a,countries s,avalute_t v,reportdescs r,user$ u,' +
        'account a1,account a2'
      
        '  where a1.id=a.debt and a2.id=a.kredit and u.id= a.op_id and a.' +
        'COUNTRID=s.id and'
      '        v.valute=a.val_acc and'
      '       r.id=nvl(a.reportid,0)    and'
      '        s.id>0 and'
      '        a.dat between :dat and :dat1'
      
        '     and a.kredit in (select id from account where BAL_CN1 in( S' +
        'ELECT acc FROM payment_re_accs ))'
      
        '       group by  a.ammount ,a.ammount_c, s.cntr_name,v.valu_name' +
        ' ,s.CNTR_CODE,r.name,r.id,v.valu_inter'
      
        '       ,a.dat,a.lammount,a1.bal_cn1,a2.bal_cn1,u.name,a1.acc_no,' +
        'a2.acc_no)'
      
        '         group by p_cntr_name,p_valu_name,kode,repname,e_kod,val' +
        '_kod'
      '         ,data,lammount,dbal,kbal,op,debacno,kredacno'
      ' order by cuntry')
