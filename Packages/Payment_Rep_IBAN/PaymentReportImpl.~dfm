  object PaymentDataSet: TOracleDataSet
    SQL.Strings = (
      
        'SELECT u.NAME, ac1.bal_cn1 AS dbal, ac2.bal_cn1 AS kbal, a.NAME ' +
        'AS teyinat,'
      '       a.lammount AS mekv, a.dat AS DATA, a.ammount AS debit,'
      
        '       a.ammount_c AS kredit, s.cntr_name AS olke, v.valu_name A' +
        'S valute,'
      
        '       r.NAME AS repname, ac1.acc_no AS debit_hes, ac2.acc_no AS' +
        ' kredit_hes'
      '  FROM provarch a,'
      '       countries s,'
      '       avalute_t v,'
      '       reportdescs r,'
      '       ACCOUNT ac1,'
      '       ACCOUNT ac2,'
      '       user$ u'
      ' WHERE a.countrid = s.ID'
