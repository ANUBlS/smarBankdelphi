unit ExpVesterPrintUnit;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, DBGridEh, Buttons, ActnList, ImgList, WordXP, OleServer, StdCtrls,
  Mask, DBCtrlsEh, DBLookupEh, DB, OracleData;

type
  TFormExpVesterPrint = class(TForm)
    DBLookupComboboxEh1: TDBLookupComboboxEh;
    WordApplication: TWordApplication;
    WordDocument: TWordDocument;
    ImageList1: TImageList;
    ActionList1: TActionList;
    ActinPrint: TAction;
    ActnClose: TAction;
    SpeedButton1: TSpeedButton;
    SpeedButton2: TSpeedButton;
    Templates: TOracleDataSet;
    Bookmarks: TOracleDataSet;
    Fields: TOracleDataSet;
    DSRtemplates: TDataSource;
    DSRbookmarks: TDataSource;
    DSRfields: TDataSource;
    CustomerInfoDataSet: TOracleDataSet;
    procedure FormShow(Sender: TObject);
    procedure ActinPrintExecute(Sender: TObject);
    procedure ActnCloseExecute(Sender: TObject);
  private
    { Private declarations }
  public
  TemplID: Integer;
    { Public declarations }
  end;

var
  FormExpVesterPrint: TFormExpVesterPrint;

implementation
  uses sboapiDataModuleImpl;
{$R *.dfm}

procedure TFormExpVesterPrint.ActinPrintExecute(Sender: TObject);
resourcestring
  FilenotFound = 'Fayl tapılmadı';
var
  Template, Templatebool, FTemplatePath, Itemindex, OBookmarkCount, What,
     oBookMarkName: Olevariant;
  IbookmarkCount: Integer;
  tFieldName: String;
  SaveChanges, OriginalFormat, RouteDocument: Olevariant;

begin

  What := Olevariant(wdGoToBookmark);
  FTemplatePath := Templates.FieldByName('Path').AsString;
  //TemplID := Templates.FieldByName('ID').AsInteger;

  Template := EmptyParam;
  Templatebool := False;
  Itemindex := 1;

  WordApplication.Connect;

  WordApplication.Visible := True;
  WordApplication.Documents.Application.Caption := DBLookupComboboxEh1.Text;

  WordApplication.Options.CheckSpellingAsYouType := False;
  WordApplication.Options.CheckGrammarAsYouType := False;

  if FileExists(FTemplatePath) then
  begin

    WordApplication.Documents.Open(FTemplatePath, Template, Templatebool,
      Template, Template, Template, Template, Template, Template, Template,
      Template, Template, Template, Template, Template);

  end
  else
  begin

    SaveChanges := WdDoNotSaveChanges;
    OriginalFormat := UnAssigned;
    RouteDocument := UnAssigned;
    WordApplication.Quit(SaveChanges, OriginalFormat, RouteDocument);
    WordApplication.Disconnect;
    ShowMessage(FilenotFound);

  end;

  WordDocument.ConnectTo(WordApplication.Documents.Item(Itemindex));
  // WordDocument.Application.Get_ActiveWindow.Caption:=NLSLocalizer1.Caption;

  try

    with CustomerInfoDataSet, WordDocument do
      For IbookmarkCount := 1 to Bookmarks.Count do
      begin


        OBookmarkCount := IbookmarkCount;
        oBookMarkName := Bookmarks.Item(OBookmarkCount).Get_Name;
        WordApplication.Selection.GoTo_(What, EmptyParam, EmptyParam,
          oBookMarkName);
        Close;
        SetVariable('templateid', TemplID);
        Open;
        tFieldName := FieldByName('FIELDNAME').AsString;
        WordApplication.Selection.InsertAfter
         (CustomerInfoDataSet.FieldByName(tFieldName).AsString);



      end;

    WordDocument.Disconnect;
    WordApplication.Disconnect;

  except
    SaveChanges := WdDoNotSaveChanges;
    OriginalFormat := UnAssigned;
    RouteDocument := UnAssigned;
    WordApplication.Quit(SaveChanges, OriginalFormat, RouteDocument);
    WordApplication.Disconnect;
    ShowMessage(oBookMarkName + '   Bukmarklar daxil edilmeyib ');
  end;


end;

procedure TFormExpVesterPrint.ActnCloseExecute(Sender: TObject);
begin
  Close;
end;

procedure TFormExpVesterPrint.FormShow(Sender: TObject);
begin
  Templates.CloseAll;
  Bookmarks.CloseAll;
  Fields.CloseAll;
  Templates.Open;
  Bookmarks.Open;
  Fields.Open;
end;


end.
