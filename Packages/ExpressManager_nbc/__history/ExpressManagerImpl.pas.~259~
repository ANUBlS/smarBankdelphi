procedure TExpress.ActionDeleteOutExecute(Sender: TObject);
begin
//  ExpDataModule.SB_ACA.CallProcedure('CheckAdvancedObjectAccess',['EXPRESS_DELETE']);
  with ExpDataModule,ExpBatchsDataSet,EXPESSPAC do
  begin
    if recordcount=0 then exit;
    if (Fieldbyname('status').Asinteger=0) then
    case Messagedlg('Əməliyyatın silinməsinə əminsinizmi?',mtConfirmation, [mbYes, mbNo], 0) of
    mrYes:CallProcedure('Exp_batchs_delete',['v_id',ExpDataModule.ExpBatchsDataSet.Fieldbyname('id').Asinteger]) ;
    mrNo:exit;
    end
    Else

    IF (MessageDlg('Əməliyyatı ləğv etmək mümkün deyil.Yalniz əməliyyatı geri qaytaradan sonra silə bilersiz!',mtWarning,
                 [mbYes],0)=mrYes)THEN EXIT;
    Refresh;
  end;
end;

