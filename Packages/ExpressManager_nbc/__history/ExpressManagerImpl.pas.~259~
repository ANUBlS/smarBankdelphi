PROCEDURE TExpress.ActionTakeInExecute(Sender: TObject);
VAR id,status,optype,v_setid:integer;
    setir,descript:string;
BEGIN
  WITH ExpDataModule DO
  BEGIN
    IF ExpIncomingDataSet.RecordCount=0 THEN EXIT;
    status:=Repair.CallIntegerFunction('Exp_checkstatusIN',[ExpIncomingDataSet.fieldbyname('id').AsInteger]);
    IF status=1 THEN BEGIN
                       ExpIncomingDataSet.Refresh;
                       exit;
                     END;


    id:=ExpIncomingDataSet.FieldByName('id').AsInteger;
    optype:=ExpIncomingDataSet.FieldByName('optype').AsInteger;
    v_setid:=ExpIncomingDataSet.FieldByName('setid').AsInteger;
    IF (optype=1) and (status=0) THEN BEGIN
                                       //  ExpPasswordForm.EditPassword.Clear;
                                       //   ExpPasswordForm.ShowModal;
                                        TRY
                                          ExpDataModule.Repair.CallProcedure('ExpTakeTransaction',[id]);
                                          sboapiDataModule.SBSession.Commit;
                                          ExpIncomingDataSet.Refresh;
                                          ExpIncomingDataSet.Locate('ID',ID,[]);
                                        Except
                                          on E : Exception do
                                          begin
                                            descript:= E.Message;
                                            sboapiDataModule.SBSession.Rollback;
                                            ShowMessage(descript) ;
                                          end;
                                        end;
                                      END
                ELSE BEGIN
                       ExpFormNew.FForm:=2;
                       IF (optype=2) or (optype=3) or(optype=5) or (optype=6) THEN BEGIN
                                                          TRY
                                                            repair.CallProcedure('Exp_GPayKomiks_TakeTrans',[id,v_setid]);
                                                            sboapiDataModule.SBSession.Commit;
                                                          EXCEPT
                                                            ON E : Exception DO BEGIN
                                                                                  setir:= E.Message;
                                                                                  sboapiDataModule.SBSession.Rollback;
                                                                                  ShowMessage(setir) ;
                                                                                END;
                                                          END;
                                                     //     ExpIncomingDataSet.Refresh;
                                                     //     ExpIncomingDataSet.Locate('ID',ID,[]);
                                                        END;
                     END;
    IF optype=4 THEN BEGIN
                      // IF ExpIncomingDataSetBFILIAL.AsInteger<>FilialDataSet.FieldByName('id').AsInteger  THEN EXIT
                      // ELSE BEGIN
                              TRY
                                repair.CallProcedure('Exp_Consolidation_TakeTrans',[id]);
                                sboapiDataModule.SBSession.Commit;
                              EXCEPT
                                ON E : Exception DO BEGIN
                                                      setir:= E.Message;
                                                      sboapiDataModule.SBSession.Rollback;
                                                      ShowMessage(setir) ;
                                                    END;
                              END;

                      END;

     IF  optype=7 THEN BEGIN
                      // IF ExpIncomingDataSetBFILIAL.AsInteger<>FilialDataSet.FieldByName('id').AsInteger  THEN EXIT
                      // ELSE BEGIN
                              TRY
                                repair.CallProcedure('Exp_ConsolidationTTransactions',[id,v_setid]);
                                sboapiDataModule.SBSession.Commit;
                              EXCEPT
                                ON E : Exception DO BEGIN
                                                      setir:= E.Message;
                                                      sboapiDataModule.SBSession.Rollback;
                                                      ShowMessage(setir) ;
                                                    END;
                              END;
                         END;

    ExpIncomingDataSet.Refresh;
    ExpIncomingDataSet.Locate('ID',ID,[]);
  END;

END;

