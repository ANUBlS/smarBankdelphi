procedure TFormPaymentsCredit.LoadComboData(Sender: TComboBox);
begin
  with ExpDataModule.Expdescription, Sender do
  begin
    if not(Active) then
      Open
    else
    begin
      Refresh;
    end;
    if Items.Count <> RecordCount then
    begin
      Items.Clear;
      First;
      while not(EOF) do
      begin
        Items.Add(FieldByName('description').AsString);
        Next;
      end;
    end;
  end;
end;


