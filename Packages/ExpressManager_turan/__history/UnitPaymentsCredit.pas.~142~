    IF VarIsNull(KreditRestDataSet.FieldByName('interestrest').AsVariant) THEN
      CMCurrencyEdit3.Value := 0
    ELSE
      CMCurrencyEdit3.Value := KreditRestDataSet.FieldByName('interestrest').AsVariant;

  END;
end;

