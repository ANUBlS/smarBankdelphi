procedure TFormPaymentsCredit.FormShow(Sender: TObject);
begin
  ClearEdit;
  Account.Close;
  Account.Open;
  BankAccounts.Close;
  BankAccounts.Open;
  FormNominalCustomers.RH := false;
  IF FForm = 0 then
  BEGIN

    ExpSettingsType.Close;
    ExpSettingsType.SetVariable('stypeid', optype);
    ExpSettingsType.Open;

    //DBLookupComboBox2.DataSource:=DSExpSettingsType;

    IF ExpSettingsType.RecordCount = 1 THEN
      DBLookupComboBox2.KeyValue := ExpSettingsType.FieldByName('id').AsInteger
    ELSE
      DBLookupComboBox2.KeyValue := -1;

    BankAccount.KeyValue:=-1;
    BankAccountName.KeyValue:=-1;
    ClearSearch;
    FormNominalCustomers.FTip := 0;
    FormNominalCustomers.CBoxPassPlace.KeyValue := null;
    FormNominalCustomers.CbBoxClick(Sender);
  END
  ELSE
  BEGIN
    FormNominalCustomers.FTip := 1;
    FormNominalCustomers.Searchid.Clear;
    FormNominalCustomers.Searchpasspin.Clear;
    FormNominalCustomers.Searchpaspnum.Clear;
    WITH ExpDataModule DO
    BEGIN
      IF FiledIncoming THEN
        PaymentCreditUpdate(ExpIncomingDataSet);
      IF FiledBatchs THEN
        PaymentCreditUpdate(ExpBatchsDataSet);
      IF FiledIncomingArchive THEN
        PaymentCreditUpdate(ExpIncomingarchiveDataSet);
      IF FieldBatchsArchive THEN
        PaymentCreditUpdate(ExpBatchsArchiveDataSet);
    END;
    WITH ExpDataModule, SendToDataSet DO
    BEGIN
      Close;
      SQl[1] := '';
      SQl[1] := 'where id=' + FieldBKLIID;
      Open;

      Searchpasspin.Text := FieldByName('passpin').AsString;
      Searchpaspnum.Text := FieldByName('paspnum').AsString;
      Searchid.Text := FieldByName('id').AsString;
      Searchinn.Text := FieldByName('inn').AsString;
      Hcusttype := FieldByName('cust_type').AsInteger;

      FilialName.Text := FieldBFILIALNAME;
      EditName.Text := FieldByName('custname').AsString;

      PaymentsKredetDataSet.Close;
      PaymentsKredetDataSet.SetVariable('kli_id', FieldBKLIID);
      PaymentsKredetDataSet.Open;

      BankAccount.KeyValue:=FieldDebetAccid;
      BankAccountName.KeyValue:=FieldDebetAccid;
      DBLookupComboBox1.KeyValue := FieldKREDITACCID;
      Searchname.Text := DBLookupComboBox1.Text;

      KreditRestDataSet.Close;
      KreditRestDataSet.SetVariable('acc_id', FieldKREDITACCID);
      KreditRestDataSet.Open;

      CMCurrencyEdit2.Value := KreditRestDataSetREST.AsFloat;
      CMCurrencyEdit3.Value := KreditRestDataSetINTERESTREST.AsFloat;
      CMCurrencyEdit1.Text := FloatToStr(FieldAMOUNT);
      CMCurrencyEdit1Exit(Sender);
      EditDescription.Text := FieldREMIT_INF;

    END;

    IF FieldBKLIID <> FieldKLIID THEN
    BEGIN
      WITH ExpDataModule, SendDataSet DO
      BEGIN
        Close;
        SQl[1] := '';
        SQl[1] := 'where id=' + FieldKLIID;
        Open;
        WITH FormNominalCustomers, ExpressVariables DO
        BEGIN
          custid := FieldKLIID;
          Editpasspin.Text := FieldByName('passpin').AsString;
          IF Editpasspin.Text <> '' THEN
            FormNominalCustomers.RH := true;
          CBoxPassPlace.KeyValue := FieldByName('doc_type').AsInteger;
          EditLastName.Text := FieldByName('lastname').AsString;
          EditName1.Text := FieldByName('name').AsString;
          EditSoname.Text := FieldByName('soname').AsString;
          EditSerial.Text := FieldByName('passer').AsString;
          EditPassport.Text := FieldByName('paspnum').AsString;
          Issue_country.KeyValue := FieldByName('doc_country').AsVariant;
          DBCBox_DocTYPE.Text := FieldByName('paspplace').AsString;
          DateEdit.Value := FieldByName('paspdate').AsVariant;
          DateEdit1.Value := FieldByName('passexpire').AsVariant;
          DBCBox_Citizenship.KeyValue := FieldByName('citizenship').AsInteger;
          CBoxSex.KeyValue := FieldByName('sex').AsString;
          CBoxFamStatus.KeyValue := FieldByName('fam_status').AsString;
          BirthPlace.KeyValue := FieldByName('birthplace').AsString;
          EditBirthCity.KeyValue := FieldByName('birth_state').AsString;
          DateEdit2.Value := FieldByName('birthday').AsVariant;
          Adrs_State.KeyValue := FieldByName('adrs_state').AsString;
          Adrs_City.KeyValue := FieldByName('city').AsString;
          ZipQ.Text := FieldByName('reg_zip').AsString;
          EditMobil.Text := FieldByName('phone_m').AsString;
          EditPhone.Text := FieldByName('phone_h').AsString;
          EditEmail.Text := FieldByName('e_mail').AsString;
          AdressEdit.Text := FieldByName('address').AsString;

          WITH FormNominalCustomers DO
          BEGIN
            work_place.Text := FieldByName('work_place').AsString;
            Address_type.KeyValue := FieldByName('work_adrs_spec').AsVariant;
            CountryByConctType.KeyValue := FieldByName('work_cntr').AsVariant;
            CityByConctType.KeyValue := FieldByName('work_city').AsVariant;
            db_tph_state.Text := FieldByName('work_state').AsString;
            DB_tph_zip.Text := FieldByName('work_zip').AsString;
            db_tph_adress.Text := FieldByName('work_adress').AsString;
            tph_contact_type.KeyValue := FieldByName('work_phone_spec')
              .AsVariant;
            tph_communication_type.KeyValue := FieldByName('work_phconttype')
              .AsVariant;
            tph_country_prefix.KeyValue := FieldByName('work_phoppref')
              .AsVariant;
            Db_tph_number.Text := FieldByName('work_phone').AsString;
            Db_tph_extension.Text := FieldByName('work_phext').AsString;
            Db_tph_cod.Text := FieldByName('work_phcode').AsString;
          END
        END
      END
    END
    ELSE
      FormNominalCustomersClear;

    FormNominalCustomers.CbBoxClick(Sender);
    Sum := ExpDataModule.Repair.CallFloatFunction('SumNominalid',
      [ExpDataModule.ExpBatchsDataSetKLIID.AsInteger]);

    IF Sum >= 20000 THEN
    BEGIN
      FormNominalCustomers.TabSheet2.TabVisible := true;
      FormNominalCustomers.TabSheet3.TabVisible := true;
    END
    ELSE
    BEGIN
      FormNominalCustomers.TabSheet2.TabVisible := false;
      FormNominalCustomers.TabSheet3.TabVisible := false;
    END;

  END;

end;

procedure TFormPaymentsCredit.SearchpasspinKeyPress(Sender: TObject;
  var Key: Char);
VAR
  s: string;
  Accno: string;
BEGIN
  s := '';
  IF Key = #13 THEN
  BEGIN
    IF (Sender as TEdit).Text <> '' THEN
    BEGIN
      IF (Sender as TEdit).Name = 'Searchname' THEN
      BEGIN
        Accno := (Sender as TEdit).Text;
        Account.Close;
        Account.SetVariable('accno', Accno);
        Account.Open;
        IF Account.RecordCount = 0 THEN
        BEGIN
          ShowMessage('Müştəri tapılmadı');
          IF (Sender as TEdit).Name <> 'Searchpaspnum' THEN
            Searchpaspnum.Clear;
          IF (Sender as TEdit).Name <> 'Searchinn' THEN
            Searchinn.Clear;
          IF (Sender as TEdit).Name <> 'Searchid' THEN
            Searchid.Clear;
          IF (Sender as TEdit).Name <> 'Searchpasspin' THEN
            Searchpasspin.Clear;
          IF (Sender as TEdit).Name <> 'SearchName' THEN
            Searchname.Clear;
          EditName.Clear;
          FilialName.Clear;
          EditDescription.Clear;
          CMCurrencyEdit1.Text := '0.00';
          PaymentsKredetDataSet.Close;
          PaymentsKredetDataSet.SetVariable('kli_id', -1);
          PaymentsKredetDataSet.Open;
          exit;
        END;
        ExpFilialN.Close;
        ExpFilialN.SetVariable('id', Account.FieldByName('filial').AsInteger);
        ExpFilialN.Open;
        FilialName.Text := ExpFilialN.FieldByName('name').AsString;
        s := 'c.id=' + Account.FieldByName('kli_id').AsString;
      END
      ELSE
      BEGIN
        s := copy((Sender as TEdit).Name, 7, length((Sender as TEdit).Name));
        IF s = 'id' THEN
          s := 'c.' + s;
        s := '(' + s + '=' + '''' + (Sender as TEdit).Text + '''' + ')';
      END
    END;
    WITH ExpDataModule DO
    BEGIN
      SearchCustDataSet.Close;
      SearchCustDataSet.SQl[47] := s;
      SearchCustDataSet.Open;
      IF SearchCustDataSet.RecordCount = 0 THEN
      BEGIN
        ShowMessage('Müştəri tapılmadı');
        IF (Sender as TEdit).Name <> 'Searchpaspnum' THEN
          Searchpaspnum.Clear;
        IF (Sender as TEdit).Name <> 'Searchinn' THEN
          Searchinn.Clear;
        IF (Sender as TEdit).Name <> 'Searchid' THEN
          Searchid.Clear;
        IF (Sender as TEdit).Name <> 'Searchpasspin' THEN
          Searchpasspin.Clear;
        IF (Sender as TEdit).Name <> 'SearchName' THEN
          Searchname.Clear;
        EditName.Clear;
        FilialName.Clear;
        EditDescription.Clear;
        CMCurrencyEdit1.Text := '0.00';
        PaymentsKredetDataSet.Close;
        PaymentsKredetDataSet.SetVariable('kli_id', -1);
        PaymentsKredetDataSet.Open;
        exit;
      END;

      Searchpasspin.Text := SearchCustDataSetPASSPIN.AsString;
      Searchpaspnum.Text := SearchCustDataSetPASPNUM.AsString;
      Searchid.Text := SearchCustDataSetID.AsString;
      Searchinn.Text := SearchCustDataSetINN.AsString;
      Hcusttype := SearchCustDataSetCUST_TYPE.AsInteger;
      DBLookupComboBox1.KeyValue := Account.FieldByName('id').AsInteger;
      EditName.Text := SearchCustDataSetNAME.AsString;
      PaymentsKredetDataSet.Close;
      PaymentsKredetDataSet.SetVariable('kli_id',SearchCustDataSetID.AsInteger);
      PaymentsKredetDataSet.Open;

      IF PaymentsKredetDataSet.RecordCount = 1 THEN
      BEGIN
        ExpFilialN.Close;
        ExpFilialN.SetVariable('id', PaymentsKredetDataSet.FieldByName('filial').AsInteger);
        FilialDataSet.Open;
        FilialName.Text := ExpFilialN.FieldByName('name').AsString;
        DBLookupComboBox1.KeyValue := PaymentsKredetDataSet.FieldByName('id').AsInteger;
        KreditRestDataSet.Close;
        KreditRestDataSet.SetVariable('acc_id',PaymentsKredetDataSet.FieldByName('id').AsInteger);
        KreditRestDataSet.Open;
        IF VarIsNull(KreditRestDataSet.FieldByName('rest').AsVariant) THEN
          CMCurrencyEdit2.Value := 0
        ELSE
          CMCurrencyEdit2.Value := KreditRestDataSet.FieldByName('rest').AsVariant;
        IF VarIsNull(KreditRestDataSet.FieldByName('interestrest').AsVariant) THEN
          CMCurrencyEdit3.Value := 0
        ELSE
          CMCurrencyEdit3.Value := KreditRestDataSet.FieldByName('interestrest').AsVariant;
          Searchname.Text := PaymentsKredetDataSet.FieldByName('acc_no').AsString;
      END;

      ClearEdit;

    END;
  end;

END;

