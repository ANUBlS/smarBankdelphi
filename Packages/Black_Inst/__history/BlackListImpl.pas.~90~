      for i := 0 to Words.Count - 1 do
      begin
        WordText := Words[i];
        if Canvas.TextWidth(Line + ' ' + WordText) > MaxWidth then
        begin
          Canvas.Brush.Color := RowCol;
          StartY := Y + HeightUsed;
          Canvas.FillRect(Rect(X-5, StartY, X + MaxWidth + 10, StartY + LineHeight));
          Canvas.TextOut(X, StartY, Line);
          Inc(HeightUsed, LineHeight);
          Line := WordText;
        end
        else
        begin
          if Line = '' then Line := WordText
          else Line := Line + ' ' + WordText;
        end;
      end;

      if Line <> '' then
      begin
        Canvas.Brush.Color := RowCol;
        StartY := Y + HeightUsed;
        Canvas.FillRect(Rect(X-5, StartY, X + MaxWidth + 10, StartY + LineHeight));
        Canvas.TextOut(X, StartY, Line);
        Inc(HeightUsed, LineHeight);
      end;

      Canvas.Brush.Color := clWhite;
    finally
      Words.Free;
    end;
  end;

var
  RowHeight: Integer;
begin
  PDF := TPdfDocumentGDI.Create;
  try
    PDF.DefaultPageWidth  := 595;  // A4 width
    PDF.DefaultPageHeight := 842;  // A4 height

    PDF.AddPage;
    IsFirstPage := True;
    WriteHeader;

    ods_hms.First;
    while not ods_hms.Eof do
    begin
      ApplyFont;

      // fullname üçün wrap + fon rəngi və hündürlük ölçülməsi
      DrawTextWrappedWithColorFixedHeight(20, Y, 500,
        ods_hms.FieldByName('fullname').AsString,
        RowColor(ods_hms.FieldByName('main_status').AsString),
        RowHeight);

      // birthdate və status sabit Y üzərində yazılır, fon rəngi tətbiq edilir
      PDF.VCLCanvas.Brush.Color := RowColor(ods_hms.FieldByName('main_status').AsString);
      PDF.VCLCanvas.FillRect(Rect(520-5, Y, 780, Y + RowHeight));

      PDF.VCLCanvas.TextOut(520, Y, ods_hms.FieldByName('birthdate').AsString);
      PDF.VCLCanvas.TextOut(640, Y, ods_hms.FieldByName('end_status').AsString);

      Inc(Y, RowHeight + 5);

      if Y > 1350 then
      begin
        PDF.AddPage;
        ApplyFont;
        Y := 40;
        IsFirstPage := False;
      end;

      ods_hms.Next;
    end;

    TempName := GetEnvironmentVariable('TEMP') + '\dataset_export.pdf';
    PDF.SaveToFile(TempName);
    ShellExecute(0, 'open', PChar(TempName), nil, nil, SW_SHOWNORMAL);

  finally
    PDF.Free;
  end;
end;
