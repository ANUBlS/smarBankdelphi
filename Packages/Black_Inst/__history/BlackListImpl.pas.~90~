function  TBlackInst.ISOToDate(const ISODate: string): TDateTime;
var
  y, m, d: Word;
begin
  y := StrToInt(Copy(ISODate, 1, 4)); // il
  m := StrToInt(Copy(ISODate, 6, 2)); // ay
  d := StrToInt(Copy(ISODate, 9, 2)); // gün
  Result := EncodeDate(y, m, d);
end;



procedure TBlackInst.ReadRemoteXML_yerli(const AUrl: string);
var
  http: TIdHTTP;
  ssl: TIdSSLIOHandlerSocketOpenSSL;
  xmlDoc: IXMLDocument;
  xmlRoot, node,nodedat: IXMLNode;
  z,i: Integer;
  mem: TMemoryStream;
  brdat:TDateTime;
begin
  http := TIdHTTP.Create(nil);
  ssl := TIdSSLIOHandlerSocketOpenSSL.Create(nil);
  mem := TMemoryStream.Create;
  try
    http.IOHandler := ssl;
    http.Request.UserAgent := 'Delphi XE XML Reader';

    // XML yüklə
    http.Get(AUrl, mem);
    mem.Position := 0;

    // XML sənədini oxu
    xmlDoc := TXMLDocument.Create(nil);
    xmlDoc.LoadFromStream(mem);
    xmlDoc.Active := True;

    xmlRoot := xmlDoc.DocumentElement;
    if Assigned(xmlRoot) then
    begin

    //  Memo1.Lines.Add('Root: ' + xmlRoot.NodeName);
      panle_Gauge.Visible:=true;
     for i := 0 to xmlRoot.ChildNodes['INDIVIDUALS'].ChildNodes.Count-1 do
      begin
        node := xmlRoot.ChildNodes['INDIVIDUALS'].ChildNodes[i];
         //   showmessage(node.ChildNodes['INDIVIDUALS'].ChildNodes[i].ChildNodes[j].NodeName);

          for j :=0 to xmlRoot.ChildNodes['INDIVIDUALS'].ChildNodes[i].ChildNodes.Count-1 do
                            begin
           if xmlRoot.ChildNodes['INDIVIDUALS'].ChildNodes[i].ChildNodes[j].NodeName='INDIVIDUAL_DATE_OF_BIRTH' then
                            begin
              nodedat :=xmlRoot.ChildNodes['INDIVIDUALS'].ChildNodes[i].ChildNodes[j];
              brdat:=ISOToDate(nodedat.ChildNodes['DATE'].text);


                            end;

                     end;
        DmBlack.OraclePackage1.CallProcedure('add_cust_black',[
                                                      'p_adtype',1,
                                                      'p_name',node.ChildNodes['FIRST_NAME'].Text,
                                                      'p_lastname',node.ChildNodes['SECOND_NAME'].Text,
                                                      'p_middlename',node.ChildNodes['THIRD_NAME'].Text,
                                                      'p_fullname',node.ChildNodes['NAME_ORIGINAL_SCRIPT'].Text,
                                                      'p_doc_type','',
                                                      'p_doc_serie','',
                                                      'p_doc_num','',
                                                      'p_citizenship','',
                                                      'p_adrs_state','',
                                                      'p_adrs_city','',
                                                      'p_address','',
                                                      'p_doc_date',null,
                                                      'p_doc_organ','',
                                                      'p_gender','',
                                                      'p_doc_pin','' ,
                                                      'p_birthdate',brdat
                                                       ]);
       //  Memo1.Lines.Add(node.ChildNodes['FIRST_NAME'].Text);
     Application.ProcessMessages;
     Gauge.Progress := Trunc(z*102 / xmlRoot.ChildNodes['INDIVIDUALS'].ChildNodes.Count+1);
              z := z + 1;
      end;
    end;
  finally
    mem.Free;
    http.Free;
    ssl.Free;
  end;
   MessageDlg('XML fayli uğurla oxundu', mtInformation, [mbOk], 0);
    Gauge.Progress:=0;
   panle_Gauge.Visible:=false;
end;
