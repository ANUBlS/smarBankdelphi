procedure TMasterBook.BitExportClick(Sender: TObject);
var
  Selection : TRepType;
  Exc: Exception;
begin
 if CeckBoxBal.Checked then
       begin
        Selection :=  rtOne;
        if Trim(EdBalance.Text) = '' then
            begin
             MessageDlg('Hesabi daxil edin!', mtConfirmation,  [mbOk], 0);
             Exit;
            end;
       end
       else Selection :=  rtAll;
 try
   SetLastError(0);
   BitExport.Enabled := False;
   Screen.Cursor := crHourGlass;
   ApllPackUnit.ExoprtExcel( DTPMin.date, DTPMax.date, Selection, EdBalance.Text );
 finally
   BitExport.Enabled := True;
   Screen.Cursor :=crDefault;
   if GetLastError() <> 0 then RaiseLastWin32Error();
 end;
end;

procedure TMasterBook.FillBranch;
var
  BranchIndex :Integer;
begin
  with  DataSetBranch do
  try
    Open;
    SetLength(Branch,RecordCount+1);
    First;
    BranchIndex :=0;
    CBBranch.Items.Clear;
    CBBranch.Items.Add('ֱצעצם פטכטאככאנ');
    Branch[BranchIndex] :=-1;
    while not EOF do
    begin
      BranchIndex :=BranchIndex + 1;
      CBBranch.Items.Add(FieldByName('Name').AsString);
      Branch[BranchIndex] :=FieldByName('ID').AsInteger;
      Next;
    end;
  finally
    Close;
  end;
end;

procedure TMasterBook.ActiveFormCreate(Sender: TObject);
var
  CurrentDate : TDate;
begin
  MasterBook := self;
  FillBranch;
  CBBranch.ItemIndex :=0;
  with sboapiDataModule do
    CurrentDate := SBOperationDay.CallDateFunction('get_date', []);
  DTPMin.DateTime := CurrentDate;
  DTPMax.DateTime := CurrentDate;
  SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);
end;

