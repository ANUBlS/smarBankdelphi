procedure Scroll(DBGrid: TDBGrid; Delta: integer);
begin
 with DBGrid, DataSource, DataSet do
  begin
   if IsEmpty then Exit;
   if Focused then
    if Delta < 0 then
     Next
    else
     Prior;
  end;
end;

procedure TFormBalanceAnalys.MouseWheelHandler(var Message: TMessage);
begin
  inherited;
  Scroll(DBGridBalance, TCMMouseWheel(Message).WheelDelta);
  Scroll(DBGridAccount, TCMMouseWheel(Message).WheelDelta);
  Scroll(DBGridTransaction, TCMMouseWheel(Message).WheelDelta);
end;


procedure TFormBalanceAnalys.SetSysDate;
var
   i: word;
   CurrentDate: TDateTime;
begin
 with DataModulBalance.SysDat do
  begin
   Open;
   CurrentDate := FieldByName('tek_dat').AsDateTime;
   Close;
  end;
  for i :=0 to ComponentCount-1 do
   if (Components[i] is TDateTimePicker) then
    (Components[i] as TDateTimePicker).DateTime :=CurrentDate;
 BeginDate :=CurrentDate;
 EndDate :=CurrentDate;   
end;

procedure TFormBalanceAnalys.SetAddress;
begin
 if not(Assigned(OperationIDs)) then
  OperationIDs:=TStringList.Create
 else
  OperationIDs.Clear;

 if not(Assigned(CurrencyIDs)) then
  CurrencyIDs:=TStringList.Create
 else
  CurrencyIDs.Clear;

 CBBranches.Tag:=Integer(@OperationIDs);
 with DataModulBalance do
  OperationType.Execute;
end;

function TFormBalanceAnalys.GetBeginPeriod(BeginDate: TDateTime): TDateTime;
begin
 with DataModulBalance, PeriodData do
  begin
   CloseAll;
   SetVariable('BeginDate',BeginDate);
   Open;
   if FieldByName('BeginPeriod').IsNull then
    Result :=BeginDate
   else
    Result :=FieldByName('BeginPeriod').AsDateTime;
  end;
end;

function TFormBalanceAnalys.GenerateBranchFilter: string;
var
   Condition: string;
   i, icount: integer;
begin
 Condition :='';
  with CBBranches do
  begin
   icount :=CBBranches.Items.Count;
   for i :=0 to icount -1 do
   begin
    if Checked[i] then
     if Condition = '' then
      Condition :=(TStringList(Pointer(CBBranches.Tag)^).Strings[i])
     else
      Condition :=Condition + ',' + (TStringList(Pointer(CBBranches.Tag)^).Strings[i]);
   end;
 end;
 Result :=Condition;
end;

procedure TFormBalanceAnalys.BuildBalance;
var
   Condition: String;
   IsForeignBalance: Boolean;
   BalancePlane: Word;
begin
 Condition :='';
 IsForeignBalance :=(CHBCurrency.Checked) and (CBBalanceView.ItemIndex=0);
 BalancePlane :=CBBalanceReference.ItemIndex+1;

 with DataModulBalance, Balance do
  begin
   SQL.CommaText :=FBalance;
   if (WillEnabled(CBBranches) and (not IsEnabled(CBBranches))) then //If all filials are checked don't set filter;
    Condition :=' AND Ac.filial in ' +'('+GenerateBranchFilter+')';
   if CHBCurrency.Checked then
    if Condition='' then
     Condition :=' AND Ac.val_acc =' + Currency.FieldByName('valute').AsString
    else
     Condition :=Condition + ' AND Ac.val_acc =' + Currency.FieldByName('valute').AsString;
   if Trim(EditBalances.Text)<>'' then
     Condition :=Condition + ' AND ' + '(b.bal_cn in ('+Trim(EditBalances.Text)+') or b.accgroup in ('+Trim(EditBalances.Text)+'))';
    Memo1.Text := Condition;
   if IsForeignBalance then
    begin
      SQL[10] := Format(SQL[10] ,['']);
      SQL[17] := Format(SQL[17] ,['']);
      SQL[30] := Format(SQL[30] ,['']);
      SQL[31] := Format(SQL[31] ,['']);
      SQL[41] := Format(SQL[41] ,['']);
      SQL[48] := Format(SQL[48] ,['']);
    end
   else
    begin
      SQL[10] := Format(SQL[10] ,['POK_']);
      SQL[17] := Format(SQL[17] ,['POK_']);
      SQL[30] := Format(SQL[30] ,['POK_']);
      SQL[31] := Format(SQL[31] ,['POK_']);
      SQL[41] := Format(SQL[41] ,['POK_']);
      SQL[48] := Format(SQL[48] ,['POK_']);
    end;
    SQL[25] :=Condition; { Currency & Branch & Srecial Balance account}
    SQL[35] :=Condition;
    SQL[56] :=Condition;

    SQL[22] :=Format(SQL[22],[BalancePlane]); { Special Balance Plane}
    SQL[24] :=Format(SQL[24],[BalancePlane]);
    SQL[32] :=Format(SQL[32],[BalancePlane]);
    SQL[34] :=Format(SQL[34],[BalancePlane]);
    SQL[53] :=Format(SQL[53],[BalancePlane]);
    SQL[55] :=Format(SQL[55],[BalancePlane]);

   CloseAll;
    SetVariable('BeginPeriod',GetBeginPeriod(BeginDate));
    SetVariable('BeginDate',BeginDate);
    SetVariable('EndDate',EndDate);
   Open;
  end;
 ///  Memo1.Clear;
//  Memo1.Text:= DataModuleBalance.DataModulBalance.Transaction.SQL.Text;

end;

procedure TFormBalanceAnalys.BuildAccount();
var
   Condition: String;
   IsForeignBalance: Boolean;
   BalancePlane: Word;
begin
 Condition :='';
 IsForeignBalance :=(CHBCurrency.Checked) and (CBBalanceView.ItemIndex=0);
 BalancePlane :=CBBalanceReference.ItemIndex+1;

 with DataModulBalance, Account do
  begin
   SQL.CommaText :=FAccount;
   if (WillEnabled(CBBranches) and (not IsEnabled(CBBranches))) then //If all filials are checked don't set filter;
    Condition :=' RestForLastPeriod.BranchID in ' +'('+GenerateBranchFilter+') AND';
   if CHBCurrency.Checked then
    if Condition='' then
     Condition :=' RestForLastPeriod.CurrencyID =' + Currency.FieldByName('valute').AsString + ' AND '
    else
     Condition :=Condition + ' RestForLastPeriod.CurrencyID =' + Currency.FieldByName('valute').AsString + ' AND ';

   if IsForeignBalance then
    begin
      SQL[20] := Format(SQL[20] ,['']);
      SQL[26] := Format(SQL[26] ,['']);
      SQL[50] := Format(SQL[50] ,['']);
      SQL[56] := Format(SQL[56] ,['']);
      SQL[76] := Format(SQL[76] ,['']);
      SQL[77] := Format(SQL[77] ,['']);
    end
   else
    begin
      SQL[20] := Format(SQL[20] ,['POK_']);
      SQL[26] := Format(SQL[26] ,['POK_']);
      SQL[50] := Format(SQL[50] ,['POK_']);
      SQL[56] := Format(SQL[56] ,['POK_']);
      SQL[76] := Format(SQL[76] ,['POK_']);
      SQL[77] := Format(SQL[77] ,['POK_']);
    end;

    SQL[34] :=Format(SQL[34],[BalancePlane]); { Special Balance Plane}
    SQL[37] :=Format(SQL[37],[BalancePlane]);
    SQL[64] :=Format(SQL[64],[BalancePlane]);
    SQL[67] :=Format(SQL[67],[BalancePlane]);
    SQL[81] :=Format(SQL[81],[BalancePlane]);
    SQL[84] :=Format(SQL[84],[BalancePlane]);

    SQL[91] :=Condition;
   CloseAll;
    SetVariable('BeginPeriod',GetBeginPeriod(BeginDate));
    SetVariable('BeginDate',BeginDate);
    SetVariable('EndDate',EndDate);
   Open;
  end;

end;

