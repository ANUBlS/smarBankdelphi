  object TotalResult: TOracleDataSet
    SQL.Strings = (
      'SELECT'
      '   DLAMMOUNT'
      '  ,DAMMOUNT'
      '  ,DCOUNT'
      '  ,CLAMMOUNT'
      '  ,CAMMOUNT'
      '  ,CCOUNT'
