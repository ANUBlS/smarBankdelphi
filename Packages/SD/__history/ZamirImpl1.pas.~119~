                      Showmessage('Can`t saved in Excel file. It may be Protected');
                End;
    dbgrid1.OnCellClick(dbgrid1.Columns.Items[1]);
    dbgrid2.OnCellClick(dbgrid2.Columns.Items[1]);
    readbookname;
  try
    xlapp:=Unassigned;
    xlapp1.Disconnect;
    xlapp1.Quit;

  except
       showmessage('error');
  end;
end;

end;

