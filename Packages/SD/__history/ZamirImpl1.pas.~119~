Function TSDHesabat.UpdateStr(InpStr:string):string;
var
  TempString, EndString:String;
  flag,TempCount ,i, Count, Beg_Index, k : Integer;
const
  Commas='''';
  Comma=',';
  begin
    Result:= InpStr;
    if Result<>'' then
{}    begin
    TempString:= '';
    EndString:= '';
    Beg_Index:= 1;
    k:= Length(Result);
    TempCount:=0;
    flag:=1;
    for i:=1 to k do
      if Result[i] <> ' ' then
        TempString:= TempString + Result[i];
    InpStr:= TempString;
    Result:= InpStr;
    TempString:= '';
    k:= Length(Result);
    for i:=1 to k do
      begin
        if Result[i] = ',' then
          begin
            Count:= (i-1)-TempCount;
            Result:= Copy(Result, Beg_Index, Count);
            TempString:= TempString + Result+Commas+Comma+Commas;
            Result:= InpStr;
            Beg_Index:= i+1;
            TempCount:=i;
            flag:=0;
          end;
        if flag=1 then
          EndString:= EndString+Result[i]
        else
          begin
            EndString:= '';
            flag:= 1;
          end;
      end;
      Result:= Commas + TempString + EndString + Commas;

{}    end
    else
      Result:= ''' ''';
  end;

