Var
     book_cap,sheet_i,param:string;
     i:integer;
Function cell_format( var s:string): boolean;
 var i:integer;
begin
   result:=false;
   for i:=1 to length(s) do
       if    (s[i] in ['0'..'9'])
         and (s[i+1] in ['A'..'Z'])
       then  Result:=true;
end;
begin
book_cap:=oradatbook.fieldbyname('Caption').AsString;
sheet_i:=oradatsheet.fieldbyname('Sheet_id').asstring;

case un_check of
 0: begin
         i:=0;
         while i<4 do
          Begin
             param:='';
             param:=oradatcell.Fieldbyname(fields1[i]).AsString;
           //  showmessage(inttostr(i));
             if cell_format(param) then
             begin
               lblinfo.Caption:='Excel formati deyil !';
               abort;
               //exit;
            end;
         with orapak do
           Begin
               if  CallBooleanFunction('check_unique',[book_cap,sheet_i,param])=false then
                 Begin
                    Yenile(vk_f5,[]);
                  if  btncelladd.Caption='Təsdiqlə'     then    btnprovcelladd.Caption:='Əlavə Et';
                  if  btnprovcelladd.Caption='Təsdiqlə' then    btnprovcelladd.Caption:='Əlavə Et';
                      Showmessage('Daxil etdiyiniz xanadan var!');
                      Abort;
                 End;{if }
          end;{with}
         inc(i);
         end;{while}
      end;{0}
 1: Begin
          i:=0;
          while i<3 do
           Begin
            param:='';
            param:=oradatprovcell.Fieldbyname(fields2[i]).AsString;
            if cell_format(param)=false then
            begin
              showmessage('Еxcel xanasını düzgün yazın. Еxcel formatına uyğun deyil.');
              Abort;
            end;
          with orapak do
            Begin
                 if  CallBooleanFunction('check_unique',[book_cap,sheet_i,param])=false then
                  Begin
                       Yenile(vk_f5,[]);
                   if  btncelladd.Caption='Təsdiqlə'     then    btnprovcelladd.Caption:='Əlavə Et';
                   if  btnprovcelladd.Caption='Təsdiqlə' then    btnprovcelladd.Caption:='Əlavə Et';
                       showmessage('Daxil etdiyiniz xanadan var!');
                       Abort;
                  End;  {if }
          end; {with}

          inc(i);
           end;{while}
      end;   {1}
 2: Begin
         i:=0;
         while i<4 do
          Begin
             param:='';
             param:=oradatcell.Fieldbyname(fields1[i]).AsString;
          if cell_format(param)=false then
          begin
              showmessage('Еxcel xanasını düzgün yazın. Еxcel formatına uyğun deyil.');
              Exit;
          end;

         inc(i);
         end;{while}
    end;{2}
  3: begin
         i:=0;
          while i<3 do
           Begin
            param:='';
            param:=oradatprovcell.Fieldbyname(fields2[i]).AsString;


          inc(i);
           end;{while}
     end;{3}
  4: begin
           i:=0;
           while i<14 do
             begin
                   param:='';
                   param:=oradatdepcell.fieldbyname(fields3[i]).asstring;
          
               inc(i);
          end;{while end}
     end;{4 end}
  5: begin
           i:=0;
           while i<16 do
             begin
                   param:='';
                   param:=oradatkrecell.fieldbyname(fields4[i]).asstring;

               inc(i);
          end;{while end}
     end;   
 end;{case}     
end;


