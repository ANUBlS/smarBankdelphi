procedure tsdhesabat.Connect_Excel;
begin
   try
      xlapp1.Connect;
      Xlapp:=GetActiveOleObject('Excel.Application') ;
   Except
      showmessage('Komputerdə EXCEL qoşulmayıb.')
   End;
      XLApp.DisplayAlerts:=TRUE;

  try
       XLApp.WorkBooks.Open(oradatbook.FieldByName('Adress').AsString);
  Except
       beep;
       showmessage(oradatbook.FieldByName('Adress').AsString+' Ünvandakı fayl tapılmadı. ' );
       xlapp:=Unassigned;
       xlapp1.Disconnect;

       screen.Cursor:=crdefault;
       Abort;
  End;
end;
