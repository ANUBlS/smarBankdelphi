procedure TSDHesabat.btnBookAddClick(Sender: TObject);
var i,j:integer;
begin
if odialog.Execute then
 begin
  With oradatbook do
   begin
     close;
     open;
      for i:=0 to recordcount do
       Begin
         if trim(FieldByName('adress').asstring)=trim(ODialog.FileName) then
           begin
               screen.Cursor:=crdefault;
               exit;
           end;
     Next;
       end;
       if ODialog.FileName<>'' then
        Begin
          application.ProcessMessages;
          close;
          Open;
          Insert;
          FieldByName('Adress').asstring:=ODialog.FileName;
          FieldByName('Caption').asstring:=trim(ExtractFileName(copy(ODialog.FileName,1,pos('.',ODialog.FileName)-1)));
          OraDatSheet.FieldByName('Book_Caption').asstring:=FieldByName('Caption').asstring;
          Post;
       End
     else
        begin
          screen.Cursor:=crdefault;
          Exit;
        end;
  end;

      screen.Cursor:=crappstart;
      application.ProcessMessages;
      try
        xlapp1.Connect;
        Xlapp:=GetActiveOleObject('Excel.Application') ;
      Except
      showmessage('Excel export etmək mümkün deyil!');
      End;

      XLApp.DisplayAlerts:=False;
      XLApp.WorkBooks.Open(oradatbook.FieldByName('Adress').asstring);

      sheetcount:=XLApp.Worksheets.count;
       for  j:=1 to sheetcount do
          with oradatsheet do
            begin
              close;
              open;
              insert;
              Fieldbyname('Sheet_Id').asstring:=inttostr(j);
              FieldByName('Caption').asstring:=XLApp.ActiveWorkBook.Sheets[j].Name;
              FieldByName('Book_caption').asstring:=trim(oradatbook.FieldByName('Caption').asstring);
              FieldByName('Nisbat').asinteger:=strtoint('1');
              Post;
              oradatsheet.Next;
            end;
                 screen.Cursor:=crdefault;
                try
                    XLApp.ActiveWorkBook.SaveAs(oradatbook.FieldByName('adress').asstring);
