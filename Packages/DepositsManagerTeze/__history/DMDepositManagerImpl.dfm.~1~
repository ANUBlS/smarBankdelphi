  object DepositsData: TOracleDataSet
    SQL.Strings = (
      'select cont.rowid,'
      '       cont.id,'
      '       cont.contractno,'
      
        '       sbcm_stored_programs.Get_ContractAccount(acc.contractacci' +
        'd) as ContractAccNO,'
      
        '       sbcm_stored_programs.Get_ContractAccount(acc.interestacci' +
        'd) as InterestAccNO,'
      '       av.val_name,'
      
        '       sbcm_stored_programs.Get_ContractAccountName(acc.contract' +
        'accid) as CustomerName,'
      '       cont.opendate,'
      '       cont.closedate,'
      '       cont.amount,'
      '       cont.amount*tmp.ostat as ekamount,'
      
        '       sbcm_stored_programs.GetpercentCollection(cont.id) as int' +
        'erest,      '
      
        '       (select sum(facticaldebt) from sbcm_contract_state where ' +
        'id#=cont.id) as facticaldebt ,'
      
        '       (select sum(facticaldebt) from sbcm_contract_state where ' +
        'id#=cont.id) *tmp.ostat as ekfacticaldebt,'
      
        '       (select sum(facticalinterestdebt) from sbcm_contract_stat' +
        'e where id#=cont.id) as facticalinterestdebt,'
      
        '       (select sum(facticalinterestdebt) from sbcm_contract_stat' +
        'e where id#=cont.id) *tmp.ostat as ekfacticalinterestdebt,'
      
        '       (select distinct stopcalculationdate from sbcm_contract_s' +
        'tate where id#=cont.id) as stopcalculationdate,'
      '       cont.currency,'
      '       cont.personaltype,'
      '       cont.clienttype,'
      '       cont.branchid,'
      '       cont.contracttype,'
      
        '      (select distinct calculationenabled from sbcm_contract_sta' +
        'te where id#=cont.id)as status,'
      '       cont.customerid,'
      '       cont.sid# as usid'
      'from sbcm_contracts cont,'
      '     sbcm_contract_accounts acc,'
      '     avalute av,'
      '     temprate tmp'
      'where acc.id# = cont.id and'
      '      cont.currency = av.valute and'
      '      cont.currency = tmp.val_kod and '
      '      cont.type# = 3 '
      ''
      'order by :OrderField     '
      '  ')
