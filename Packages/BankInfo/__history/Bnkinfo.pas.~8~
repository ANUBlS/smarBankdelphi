unit Bnkinfo;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, ExtCtrls, StdCtrls, XFSCtrls, Buttons, Mask, DBCtrlsEh,
  sboapiDataModuleImpl, DB, OracleData;

type
  TForm21 = class(TForm)
    XFPanel1: TXFPanel;
    XFBitBtn1: TXFBitBtn;
    bnknumber: TEdit;
    bnkname: TEdit;
    bnklname: TEdit;
    bnkfname: TEdit;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    Label4: TLabel;
    ComboBox1: TComboBox;
    bnkinfo: TOracleDataSet;
    procedure ComboBox1Change(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form21: TForm21;

implementation

{$R *.dfm}

procedure TForm21.ComboBox1Change(Sender: TObject);
begin
bnkinfo.close;
bnkinfo.setvariable('inf',combobox1.text);
bnkinfo.open;

bnknumber.text:= bnkinfo.FieldByName('cn').AsString;
bnkname.text:=  bnkinfo.FieldByName('name').AsString;
bnklname.text:=  bnkinfo.FieldByName('surname').AsString;
bnkfname.text:=  bnkinfo.FieldByName('fname').AsString;

end;

end.
