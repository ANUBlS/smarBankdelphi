    Panel1: TPanel;
    bankaddinfo: TOracleDataSet;
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form23: TForm23;

implementation

{$R *.dfm}

procedure TForm23.Button1Click(Sender: TObject);
begin
form21:=tform21.create(self);


if combobox1.itemindex=0 then
begin
 bankaddinfo.close;
 bankaddinfo.setvariable('addinfo',0);
 bankaddinfo.open;
 form21.ComboBox1.Text:=bankaddinfo.FieldByName('cn').AsString;
end;

if combobox1.itemindex=1 then
begin
 bankaddinfo.close;
 bankaddinfo.setvariable('addinfo',1);
 bankaddinfo.open;
 form21.ComboBox1.Text:=bankaddinfo.FieldByName('cn').AsString;
end;

if combobox1.itemindex=2 then
begin
 bankaddinfo.close;
 bankaddinfo.setvariable('addinfo',2);
 bankaddinfo.open;
 form21.ComboBox1.Text:=bankaddinfo.FieldByName('cn').AsString;
end;


if combobox1.itemindex=3 then
begin
 bankaddinfo.close;
 bankaddinfo.setvariable('addinfo',3);
 bankaddinfo.open;
 form21.ComboBox1.Text:=bankaddinfo.FieldByName('cn').AsString;
end;

form21.ShowModal;
end;

end.
