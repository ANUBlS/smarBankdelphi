unit frminfo;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, ExtCtrls, StdCtrls, Bnkinfo, sboapiDataModuleImpl, DB, OracleData;

type
  TForm23 = class(TForm)
    ComboBox1: TComboBox;
