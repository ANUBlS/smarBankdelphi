procedure TBankInfoX.DBImage1DblClick(Sender: TObject);
 type
  TJPEGQualityRange = 1..100;
var
    CUSTSIGN: TPicture;
    Jpg: TJpegImage;
    Bmp: TBitmap;
    ExtS:String ;

begin

     jpg := TJpegImage.Create;
    bmp := TBitmap.Create;
    CUSTSIGN:=TPicture.Create;

  if OpenPictureDialog1.Execute then
   begin
      try
       ExtS := copy(AnsiUpperCase(ExtractFileExt(OpenPictureDialog1.FileName)),2,MaxLongInt);
       if ExtS = 'BMP' then
        begin

          Bmp.LoadFromFile(OpenPictureDialog1.FileName);
          Jpg.CompressionQuality := 100;
          Jpg.Assign(bmp);
          Jpg.SaveToFile(Path);
          DBImage1.Picture.LoadFromFile(Path);
           end
      else
        DBImage1.Picture.LoadFromFile(OpenPictureDialog1.FileName);
      except
      ShowMessage('Error during picture loading');
      end;
      BANKINFODataSet.Edit;
      DBImage1.Picture.SaveToFile(Path);
      TBlobField( BANKINFODataSet.FieldByName('logo')).LoadFromFile(Path);
      BANKINFODataSet.Post;

   end;

 { try
   if  not OpenPictureDialog1.Execute  then Exit;
    Logo.LoadFromFile(OpenPictureDialog1.FileName);
    DBImage1.Picture.Assign(Logo);
   finally
    Logo.Free;
   end;}
end;

procedure TBankInfoX.DBImage2DblClick(Sender: TObject);
var
   Logo:TPicture;
begin
 Logo :=TPicture.Create;
  try
   if  not OpenPictureDialog1.Execute  then Exit;
    Logo.LoadFromFile(OpenPictureDialog1.FileName);
    DBImage2.Picture.Assign(Logo);
   finally
    Logo.Free;
   end;

end;


procedure GetPath;
var
  ImagesPath: String;

begin
  ImagesPath := Format('%s\..\Env\Customers', [ExtractFilePath(ParamStr(0))]);
  Path := Format('%s\temp.jpg', [ImagesPath]);
  Path_B := Format('%s\blank.jpg', [ImagesPath]);
end;




procedure TBankInfoX.ActiveFormCreate(Sender: TObject);
begin
  CBoxBankADD;
  BANKINFODataSet.Locate('kod_fil',CBoxBank.Text,[]);
  BANKINFODataSet.Edit;
  GetPath;
 SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);
end;

procedure TBankInfoX.CBoxBankADD;
var
  i :integer;
begin
  BANKINFODataSet.First;
  for i :=1 to BANKINFODataSet.RecordCount do begin
   CBoxBank.Items.Add(BANKINFODataSet.FieldByName('kod_fil').AsString);
   BANKINFODataSet.Next;
  end; {for i :=1}
  CBoxBank.Text:=IntToStr(GetUserBranchID);
end;

function TBankInfoX.GetUserBranchId :integer;
begin
  OrDS_GetUserBranchID.Open;
  result :=OrDS_GetUserBranchID.FieldByName('FilialID').AsInteger;
end;

procedure TBankInfoX.CBoxBankChange(Sender: TObject);
begin
  BANKINFODataSet.Locate('kod_fil',CBoxBank.Text,[]);
  BANKINFODataSet.Edit;
end;

