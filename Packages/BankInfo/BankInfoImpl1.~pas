procedure TBankInfoX.DBImage1DblClick(Sender: TObject);
var
   Logo:TPicture;
begin
 Logo :=TPicture.Create;
  try
   if  not OpenPictureDialog1.Execute  then Exit;
    Logo.LoadFromFile(OpenPictureDialog1.FileName);
    DBImage1.Picture.Assign(Logo);
   finally
    Logo.Free;
   end;
end;

procedure TBankInfoX.ActiveFormCreate(Sender: TObject);
begin
  CBoxBankADD;
  BANKINFODataSet.Locate('kod_fil',1,[]);
  BANKINFODataSet.Edit;
end;

procedure TBankInfoX.CBoxBankADD;
var
  i :integer;
begin
  BANKINFODataSet.First;
  for i :=1 to BANKINFODataSet.RecordCount do begin
   CBoxBank.Items.Add(BANKINFODataSet.FieldByName('kod_fil').AsString);
   BANKINFODataSet.Next;
  end; {for i :=1}
end;

