  object full_dbbalance: TOracleDataSet
    SQL.Strings = (
      'select * from (SELECT  a.adate,'
      '       a.accountnum, a.accountname, a.active, a.passive,'
      '       a.debt_turnover, a.credit_turnover'
      '  FROM dbd_balance a order by 1,2)'
      'union all'
      'select * from ( select '
      
        '  adate,accountnum,accountname,sum(active) as active ,sum(passiv' +
        'e) as passive,sum(debt_turnover) as debt_turnover,'
      ' sum(credit_turnover) as credit_turnover'
      ' from out_dbd_balance '
      'group by accountnum,adate,accountname order by 1,2)'
      ' ')
