procedure TSBProfitClosingMainForm.DayProfitsDataCalcFields(
  DataSet: TDataSet);
var
  LAmount: Currency;
  APChar: String;
begin
  with Dataset do
  begin
    LAmount := FieldByName('POK_OSTAT').AsCurrency;
    if LAmount < 0 then
      APChar := 'A'
    else
    if LAmount > 0 then
      APChar := 'P'
    else
      APChar := 'Zero';
    FieldByName('ActivePassiveChar').AsString := APChar;
  end;
end;

procedure TSBProfitClosingMainForm.ProfitsCloseUpdate(Sender: TObject);
begin
  with Sender as TAction do
  begin
    Enabled := DayProfitsData.Active;
    if Enabled then
      Enabled := DayProfitsData.RecordCount > 0;
  end;
end;

