  object ODS_RepDT: TOracleDataSet
    SQL.Strings = (
      'select a.*,b.name from ('
      
        'select ti.transmode_code,l.dcustid as custid,sum(l.lamount) lamm' +
        'ount from mmx_transactions l,mmx_transinfo ti '
      'where l.id=ti.transid '
      'and l.transactiondate=:v_dat'
      'group by ti.transmode_code,l.dcustid'
      ''
      'union '
      ''
      
        'select ti.transmode_code,l.kcustid as custid,sum(l.lamount) lamm' +
        'ount from mmx_transactions l,mmx_transinfo ti '
      'where l.id=ti.transid'
      'and l.transactiondate=:v_dat'
      
        'group by ti.transmode_code,l.kcustid) a, customers b where  a.cu' +
        'stid=b.id and b.RELIGIOUS_ORG>0'
      ''
