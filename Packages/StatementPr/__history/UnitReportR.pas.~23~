implementation

uses unitdata, SBTranslateProc, sboapiDataModuleImpl;

{$R *.DFM}

procedure TFormRepR.QRSubDetailAfterPrint(Sender: TQRCustomBand;
  BandPrinted: Boolean);
begin

    if (DataModSTX.ODSExtractTrans.FieldByName('DEBIT').AsCurrency=0) and
               (DataModSTX.ODSExtractTrans.FieldByName('KREDIT').AsCurrency=0) then
      ChBand.Enabled:= False

    else
      if (DataModSTX.ODSExtractTrans.FieldByName('PairCurrencyid').AsInteger=0)
      and
      (DataModSTX.ODSExtractTrans.FieldByName('Currencyid').AsInteger=0) then
        ChBand.Enabled:= False
      else

        ChBand.Enabled:= True;

  if (QRExprSumDebit.Value.dblResult=0) and (QRExprSumKredit.Value.dblResult=0) then
    begin
      QRExprSumDebit.Enabled:= False;
      QRExprSumKredit.Enabled:= False
    end
  else
  if (QRExprSumLDebit.Value.dblResult=QRExprSumDebit.Value.dblResult) and (QRExprSumLKredit.Value.dblResult=QRExprSumKredit.Value.dblResult) then
    begin
      QRExprSumDebit.Enabled:= False;
      QRExprSumKredit.Enabled:= False
    end
  else
    begin
      QRExprSumDebit.Enabled:= True;
      QRExprSumKredit.Enabled:= True
    end;  



end;

procedure TFormRepR.QRBandDetailAfterPrint(Sender: TQRCustomBand;
  BandPrinted: Boolean);
begin
  QRExprSumDebit.Reset;
  QRExprSumKredit.Reset;
  QRExprSumLDebit.Reset;
  QRExprSumLKredit.Reset;
end;

procedure TFormRepR.QRBandDetailBeforePrint(Sender: TQRCustomBand;
  var PrintBand: Boolean);
begin

  if Sender.ControlCount = 0 then
    with QRBandDetail do
      While ControlCount > 0 do
        Controls[0].Parent := Sender;

        if QRD_Begin.Caption=QRD_End.Caption then
        QRD_End.Caption:='';

 QRLabelValBeg.Caption:= FormatFloat('#,##0.00',ABS(DataModSTX.ODSMainState.FieldByName('Ostat').AsCurrency));
 QRLabelValEnd.Caption:= FormatFloat('#,##0.00',ABS(DataModSTX.ODSMainState.FieldByName('EndOstat').AsCurrency));
 QRRateBeg.Caption:= FormatFloat('#,##0.0000',ABS(DataModSTX.RatesDataSetBegin.FieldByName('Ostat').AsCurrency));
 QRRateEnd.Caption:= FormatFloat('#,##0.0000',ABS(DataModSTX.RatesDataSet.FieldByName('Ostat').AsCurrency));

 if DataModSTX.ODSMainState.FieldByName('CurrencyId').AsCurrency=0 then
   begin
     QRLabelManBeg.Enabled:=false;
     QRLabelManEnd.Enabled:=false;
     QRRateBeg.Enabled:=false;
     QRRateEnd.Enabled:=false;

   end
 else
   begin
     QRLabelManBeg.Enabled:=true;
     QRLabelManEnd.Enabled:=true;
     QRRateBeg.Enabled:=true;
     QRRateEnd.Enabled:=true;


     QRLabelManBeg.Caption:= FormatFloat('#,##0.00',ABS(DataModSTX.ODSMainState.FieldByName('PokOstat').AsCurrency));
     QRLabelManEnd.Caption:= FormatFloat('#,##0.00',ABS(DataModSTX.ODSMainState.FieldByName('EndPokOstat').AsCurrency));
   end    


end;

procedure TFormRepR.QRepBeforePrint(Sender: TCustomQuickRep;
  var PrintReport: Boolean);
var i,a,tt:integer;
begin
 a := DataModSTX.SBOP.CallIntegerFunction('get_acc_no_lenght',[]);
QRLabelDebt.Left:= QRLabelDebt.Left-((28-a)*6);
QRDBTextLDebit.Left:=QRDBTextLDebit.Left-((28-a)*6);
DBTextDebit.Left:=DBTextDebit.Left-((28-a)*6);
QRLabelCredit.Left:=QRLabelCredit.Left-((28-a)*6);
QRDBTextLKredit.Left:=QRDBTextLKredit.Left-((28-a)*6);
DBTextKredit.Left:=DBTextKredit.Left-((28-a)*6);
QRLabelSpec.Left:=QRLabelSpec.Left-((28-a)*6);
QRDBTextTey.Left:=QRDBTextTey.Left-((28-a)*6);
QRDBTextTey.Width:=QRDBTextTey.Width+((28-a)*8);
QRExprSumLDebit.Left:=QRExprSumLDebit.Left-((28-a)*6);
QRExprSumLKredit.Left:=QRExprSumLKredit.Left-((28-a)*6);
QRExprSumDebit.Left:=QRExprSumDebit.Left-((28-a)*6);
QRExprSumKredit.Left:=QRExprSumKredit.Left-((28-a)*6);

tt:=DataModSTX.PG_PCustService.CallIntegerFunction('get_Modle_comp',['StatementPr','FormRepR','QRLabel2']);
   if tt=0 then  begin

                QRLabel2.Enabled:=false;
                QRDBText2.Enabled:=false ;
                QRDBText1.Enabled:=false;
                QRSubDetail.Height:=trunc(QRSubDetail.Height/2);

          end
          else
          begin
                QRLabel2.Enabled:=true ;
                QRDBText2.Enabled:=true ;
                QRDBText1.Enabled:=true;

          end;
  SBTranslateProc.TranslateAllCompQuickRep(QRep, sboapiDataModule.OrPack_SL);
end;

end.
