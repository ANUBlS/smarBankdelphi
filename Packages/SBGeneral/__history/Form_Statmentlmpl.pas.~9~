procedure TForm_Statement.ExportDataTable;
var
  v_Acc_no: string;
  v_Bal_cn: string;
  v_Cli_id: string;
  FilterTrans: string;
  FilterExt: string;
  AStrParam: string;
  BStrParam: string;
  CStrParam: string;
  i: integer;
  S: string;
   vidop :Integer;
  Index: Integer;
  WaitNextConfirm, WillRefresh: Boolean;
  accno2, accno: string;
begin
  // Screen.Cursor:=crSQLWait ;

  if CBTurnOver.Checked = True then
    Turn_and_RateDiff := 'ch_turn';
  if CBRateDiff.Checked = True then
    Turn_and_RateDiff := 'ch_rate';
  if CBTurnOver.Checked = True and CBRateDiff.Checked = True then
    Turn_and_RateDiff := 'ch_rate_and_turn';
  if CBTurnOver.Checked = False and CBRateDiff.Checked = True then
    Turn_and_RateDiff := 'ch_nothink';

  v_BDate := Integer(Trunc(DTP_Begin.DateTime));
  v_EDate := Integer(Trunc(DTP_End.DateTime));

  v_user := dblcbUser.KeyValue;
  v_val := DBLCBavalute.KeyValue;
  v_filial := DBLCBfilial.KeyValue;

  if Edit_Bal_Cn.Text = '' then
    v_Bal_cn := '-1'
  else
    v_Bal_cn := UpdateStr(Edit_Bal_Cn.Text);

  { if Edit_Acc_No.Text = '' then
    v_Acc_no:= '''-1'''
    else
    v_Acc_no:= UpdateStr(Edit_Acc_No.Text);
  }

  with XDBGrid1, SelectedRows, DataSource.DataSet, DataModule_bussProc do
  begin
    // if Count = 0 then CurrentRowSelected := True;
    for Index := 0 to Count - 1 do
    begin

      GotoBookmark(Pointer(Items[Index]));
      accno := FieldByName('acc_no').AsString;
      accno2 := accno2 + accno + ',';
    end;

    if Count = 0 then
    begin
      v_Acc_no := '''-1''';
      /// ///////////////////////////////////////
      if EditCli_Id.Text = '' then
        v_Cli_id := '-1'
      else
        v_Cli_id := EditCli_Id.Text;
      /// ///////////////////////////////  /////
    end
    else
    begin
      v_Acc_no := UpdateStr(Copy(accno2, 1, Length(accno2) - 1));
      v_Cli_id := '-1';
    end;
  end;
  // ShowMessage(v_Acc_no);


     if (CBRateDiff.Checked = False) then
        FilterTrans := ' (OperationCode<>1)  '
         else
          FilterTrans := '';

    if CBRateDiff.Checked=false  then
        vidop:=0
        else
        vidop:=1;

  CStrParam := DataModule_bussProc.SB_STATEMENT.CallStringFunction('notAccId',
    [v_BDate, v_EDate, v_Cli_id, v_Acc_no, v_Bal_cn, v_filial, v_val, v_user,
    Turn_and_RateDiff]);

  if CBTurnOver.Checked = True then
  begin
    with DataModule_bussProc.ODSNotAccId do
    begin
      close;
      sql.Clear;
      sql.Add(CStrParam);
      open;
      for i := 1 to RecordCount do
      begin
        S := S + '(accountid<>' + inttostr(FieldByName('accountid').asinteger)
          + ') and ';
        Next;
      end;
      S := Copy(S, 1, Length(S) - 4);
    end;
    FilterExt := S;
  end
  else
    FilterExt := '';

  { AStrParam:=DataModSTX.SB_STATEMENT.CallStringFunction('GetExtraction',
    [
    v_BDate,
    v_EDate,
    v_Cli_id,
    v_Acc_no,
    v_Bal_cn,
    v_filial,
    v_val,
    v_user
    ]
    ); }
  with DataModule_bussProc.ODS_GetExtractionSB do
  begin
    close;
    SetVariable('bDate', v_BDate);
    SetVariable('eDate', v_EDate);
    SetVariable('ClientID', v_Cli_id);
    SetVariable('AccountNo', v_Acc_no);
    SetVariable('BalanceNo', v_Bal_cn);
    SetVariable('BranchID', v_filial);
    SetVariable('CurrencyID', v_val);
    SetVariable('UserID', v_user);
    SetVariable('Vidop', vidop);
    open;
    AStrParam := FieldByName('str').AsString;
  end;

  { BStrParam:=DataModSTX.SB_STATEMENT.CallStringFunction('Extraction_Trans',
    [
    v_BDate,
    v_EDate,
    v_Cli_id,
    v_Acc_no,
    v_Bal_cn,
    v_filial,
    v_val,
    v_user
    ]
    ); }
  with DataModule_bussProc.ODS_ExtractionTransSB do
  begin
    close;
    SetVariable('bDate', v_BDate);
    SetVariable('eDate', v_EDate);
    SetVariable('ClientID', v_Cli_id);
    SetVariable('AccountNo', v_Acc_no);
    SetVariable('BalanceNo', v_Bal_cn);
    SetVariable('BranchID', v_filial);
    SetVariable('CurrencyID', v_val);
    SetVariable('UserID', v_user);
    SetVariable('Vidop', vidop);
    open;
    BStrParam := FieldByName('str').AsString;
  end;

  with DataModule_bussProc do
  begin

    with ODSMainStateSB do
    begin

      close;
      sql.Clear;
      sql.Add(AStrParam);
      Filtered := False;
      FilterExt := '';
      Filter := FilterExt;
      Filtered := True;

      open;
    end;

    with ODSExtractTransSB do
    begin

      close;
      sql.Clear;
      DeclareVariable('OwnAccountId', otInteger);
      sql.Add(BStrParam);
      Filtered := False;
      Filter := FilterTrans;
      Filtered := True;
      open;
    end;

    Screen.Cursor := crDefault;

  end;

end;

