procedure TFrmArchive.ToolButton1Click(Sender: TObject);
var
   deleteID: Integer;
   PaymentNumber: String;
   RecordNo: Integer;
begin
 PaymentNumber :=PaymentOrderDataMod.ODSArchive.FieldByName('PNUM').AsString;
 if MessageDlg(Format('Do you want to delete payment №%s?',[PaymentNumber]),mtConfirmation,mbYesNoCancel,0)=mrYes then
 with PaymentOrderDataMod.ODSArchive,PaymentOrderDataMod.OPPayment do
  begin
   RecordNo :=RecNo;
   deleteID :=FieldByName('ID').AsInteger;
   CallProcedure('delete_payment',[deleteID]);
   Refresh;
   RecNo :=RecordNo;
  end;
end;

procedure TFrmArchive.MouseWheelHandler(var Message: TMessage);
begin
 Inherited;
 if DBArchiveGrid.Focused then
  with TCMMouseWheel(Message), DBArchiveGrid.DataSource.DataSet do
    if WheelDelta < 0 then
      Next
    else
      Prior;
  // DBArchiveGrid.Repaint;
end;

