procedure TFrmArchive.ToolButton8Click(Sender: TObject);
var
   ID :String;
   DateTime :TDateTime;
   i,a:integer;
   s:string;
begin
 ID :=PaymentOrderDataMod.ODSArchive.FieldByName('ID').AsString;
 if RBCopy.Checked then
  begin
   try
    with QRMainReport do
     begin
      DateTime :=PaymentOrderDataMod.ODSArchive.FieldByName('PDATE').AsDateTime;
      QRDate1.caption :=Payment_order.ExtractMonth(DateTime,' ');
      QRDate2.caption :=Payment_order.ExtractMonth(DateTime,' ');
      QRNum1.Caption :='Ödəniş tapşırığı №'+PaymentOrderDataMod.ODSArchive.FieldByName('PNum').AsString;
      QRNum2.Caption :='Ödəniş tapşırığı №'+PaymentOrderDataMod.ODSArchive.FieldByName('PNum').AsString;

      QRAmmount1.caption :=FormatCurr('#,##.00',StrToCurr(PaymentOrderDataMod.ODSArchive.FieldByName('Ammount').AsString));
      QRAmmount2.caption :=FormatCurr('#,##.00',StrToCurr(PaymentOrderDataMod.ODSArchive.FieldByName('Ammount').AsString));

      QRAmmountW1.caption := Payment_order.WithCoin(PaymentOrderDataMod.ODSArchive.FieldByName('Ammount').AsString);
      QRAmmountW2.caption :=Payment_order.WithCoin(PaymentOrderDataMod.ODSArchive.FieldByName('Ammount').AsString);

  if  PaymentOrderDataMod.ODS_Acc_symbol.Active then
  PaymentOrderDataMod.ODS_Acc_symbol.close;
  PaymentOrderDataMod.ODS_Acc_symbol.SetVariable(':acc_no',PaymentOrderDataMod.ODSArchive.FieldByName('DACC_NO').AsString);
  PaymentOrderDataMod.ODS_Acc_symbol.open;
 if  PaymentOrderDataMod.ODS_Acc_symbol.FieldByName('old_acc_no').asinteger=1  then
 begin
QRDBACC_NO.Caption:= PaymentOrderDataMod.ODS_Acc_symbol.FieldByName('old').AsString;
QRDBACC_NO1.Caption:= PaymentOrderDataMod.ODS_Acc_symbol.FieldByName('old').AsString;
  end
  else
   begin


      i:=pos('_', PaymentOrderDataMod.ODSArchive.FieldByName('DACC_NO').AsString);
      a:=Length( PaymentOrderDataMod.ODSArchive.FieldByName('DACC_NO').AsString);
      s:= PaymentOrderDataMod.ODSArchive.FieldByName('DACC_NO').AsString;
      delete(s,i,a);
      QRDBACC_NO.Caption:= s;
      QRDBACC_NO1.Caption:= s;
   end;
      PaymentOrderDataMod.ODSArchive.Filter:=' ID= '+ID;
      PaymentOrderDataMod.ODSArchive.Filtered :=true;


      Preview;
     end;

   finally
     PaymentOrderDataMod.ODSArchive.Filtered :=false;
   end;
  end
 else
  begin
   try
    with QRCommonReport do
     begin
      DateTime :=PaymentOrderDataMod.ODSArchive.FieldByName('PDATE').AsDateTime;
      QRDate.caption :=Payment_order.ExtractMonth(DateTime,' ');
      QRNum.Caption :='Ödəniş tapşırığı №'+PaymentOrderDataMod.ODSArchive.FieldByName('PNum').AsString;
      QRAmmount.caption :=FormatCurr('#,##.00',StrToCurr(PaymentOrderDataMod.ODSArchive.FieldByName('Ammount').AsString));
      QRAmmountW.caption := Payment_order.WithCoin(PaymentOrderDataMod.ODSArchive.FieldByName('Ammount').AsString);

  if  PaymentOrderDataMod.ODS_Acc_symbol.Active then
  PaymentOrderDataMod.ODS_Acc_symbol.close;
  showmessage(PaymentOrderDataMod.ODSArchive.FieldByName('DACC_NO').AsString);
  PaymentOrderDataMod.ODS_Acc_symbol.SetVariable(':acc_no',PaymentOrderDataMod.ODSArchive.FieldByName('DACC_NO').AsString);
  PaymentOrderDataMod.ODS_Acc_symbol.open;
 if PaymentOrderDataMod.ODS_Acc_symbol.FieldByName('old_acc_no').asinteger=1  then

 QRDBACC_NO.Caption:= PaymentOrderDataMod.ODS_Acc_symbol.FieldByName('old').AsString

   else
   begin
      i:=pos('_', PaymentOrderDataMod.ODSArchive.FieldByName('DACC_NO').AsString);
      a:=Length( PaymentOrderDataMod.ODSArchive.FieldByName('DACC_NO').AsString);
      s:= PaymentOrderDataMod.ODSArchive.FieldByName('DACC_NO').AsString;
      delete(s,i,a);
      QRDBACC_NO.Caption:= s;

   end;
      PaymentOrderDataMod.ODSArchive.Filter:=' ID= '+ID;
      PaymentOrderDataMod.ODSArchive.Filtered :=true;


      Preview;
     end;
   finally
    PaymentOrderDataMod.ODSArchive.Filtered :=false;
   end;
  end;
 DBArchiveGrid.DataSource.DataSet.Locate('ID',ID,[]);
end;

