procedure TLawmodule.DBGrid1TitleClick(Column: TColumn);
var
   TitleName :string;
   SortPosition: word;
begin
 SortPosition :=40;
 //OrderedTitle :=Column.FieldName; //H.R. 24.06.2008
 if (DBGrid1.DataSource.DataSet.IsEmpty) or (Column.FieldName = EmptyStr) then Exit;
 Screen.Cursor :=crHandPoint;
 TitleName :=Column.FieldName;
 with DBGrid1.DataSource.DataSet do
  try

   SortPosition :=DataMod.Mainscrpt.SQL.Add('ORDER BY '+ TitleName);
   Refresh;
  finally
   DataMod.Mainscrpt.SQL[SortPosition] :=EmptyStr;
   Screen.Cursor :=crDefault;

  end;

end;

