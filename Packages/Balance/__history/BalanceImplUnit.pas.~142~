procedure TFrmBalance.FillBranch;
var
  BranchIndex: Integer;
begin
  with DataModuleMain.BranchDataSet do
    try
      OPEN;
      SetLength(Branch, RecordCount + 1);
      First;
      BranchIndex := 0;
      ChListFilial.Items.Clear;
      Branch[BranchIndex] := -1;
      while not EOF do
      begin
        BranchIndex := BranchIndex + 1;
        ChListFilial.Items.Add(FieldByName('Name').AsString);
        LBoxFilial.Items.Add(FieldByName('ID').AsString);
        ChListFilial.Checked[BranchIndex - 1] := True;
        Branch[BranchIndex] := FieldByName('ID').AsInteger;
        Next;
      end;
    finally
      // Close;
    end;
end;

procedure TFrmBalance.CrFilialStr;
var
  i: Integer;
  k: Boolean;
begin
  BranchStr := ' ';
  k := True;
  for i := 0 to (ChListFilial.Items.Count - 1) do
  begin
    if ChListFilial.Checked[i] = True then
    begin
      if k = True then
        BranchStr := BranchStr + LBoxFilial.Items[i]
      else
        BranchStr := BranchStr + ',' + LBoxFilial.Items[i];
      k := False;
    end;
  end;
end;

procedure TFrmBalance.FillCBRate;
var
  RateIndex: Byte;
begin
  with DataModuleMain.ODSRate do
  begin
    OPEN;
    RateIndex := 0;
    SetLength(Rate, RecordCount + 1);
    CmbBoxRate.Items.Clear;
    CmbBoxRate.Items.Add('Bütün valyutalar');
    Rate[RateIndex] := -1;
    First;
    while not EOF do
    begin
      INC(RateIndex);
      Rate[RateIndex] := FieldByName('Valute').AsInteger;
      CmbBoxRate.Items.Add(FieldByName('VALU_NAME').AsString);
      Next
    end;
  end;
end;

