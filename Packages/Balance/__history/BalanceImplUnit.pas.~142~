function TFrmBalance.sb_Selections(BalanceType: Byte): WideString;
var
  QueryStr: WideString;
  Balance: string[32];
  Valute: String[32];
begin
  if Rate[CmbBoxRate.ItemIndex] <> -1 then
    Valute := 'And(Ac.VAL_ACC=' + IntToStr(Rate[CmbBoxRate.ItemIndex]) + ')'
  else
    Valute := '';

  Balance := 'AC.BAL_CN' + IntToStr(BalanceType) + ' as BAL_CN';
  QueryStr := 'Select Ac.ACC_NO ,Ar.POK_OSTAT ,Ar.POK_OBR_D,Ar.POK_OBR_K , ' +
    Balance + ' From Account Ac ,Archost Ar Where  (Ar.ACC_ID=Ac.ID)And((Ar.POK_OBR_D+Ar.POK_OBR_K)<>0 OR (Ar.POK_OSTAT<>0))'
    + Valute + 'And((Ar.DatDate>=' + '''' + FormatDateTime('dd-mmm-yyyy',
    Trunc(DTPBegin.DateTime)) + '''' + ')And(Ar.DatDate<=' + '''' +
    FormatDateTime('dd-mmm-yyyy', Trunc(DTPEnd.DateTime)) + '''' + '))';
  // Edit3.Text :=QueryStr;//  ?
  Result := QueryStr;
end;

