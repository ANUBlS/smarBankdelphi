    SQL.Strings = (
      
        '/*select null id, '#39#39' acc_no, '#39#39' acc_no1,'#39#39' name,'#39#39' tipacc,'#39#39'symb' +
        ',null ostat,-1 filial,'#39#39' filial_name,null val_acc,'#39#39' val_name,nu' +
