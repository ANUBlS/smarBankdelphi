uses
sboapiDataModuleImpl,OpenAccountImpl;
{$R *.dfm}

procedure TFormNote.FormClose(Sender: TObject; var Action: TCloseAction);
begin
DBLook_notetypes.KeyValue:=-1;
DBLook_commtypes.KeyValue:=-1;
 Add.Visible:=false;
 new.Visible:=true;
MemoNote.Clear;
end;

procedure TFormNote.FormCreate(Sender: TObject);
begin

dey:=false;

Ods_notetypes.Open;
Ods_commtypes.Open;
end;

procedure TFormNote.FormShow(Sender: TObject);
begin
with ods_main do
begin
close;
SetVariable('v_id',strtoint(cust_noteid));
SetVariable('v_CONTRACTID',strtoint(contract_id));
open;
end;
   Add.Visible:=true;
 new.Visible:=false;
end;

procedure TFormNote.XDBGrid1CellDblClick(Column: TXColumn);
begin
//dey:=true;
if not ods_mainNOTETYPE.IsNull then
 begin
DBLook_notetypes.KeyValue:=ods_mainNOTETYPE.AsInteger;
 end
 else
 DBLook_notetypes.KeyValue:=-1;
 if not ods_mainCOMMTYPE.IsNull then
 begin
DBLook_commtypes.KeyValue:=ods_mainCOMMTYPE.AsInteger;
 end
 else
 DBLook_commtypes.KeyValue:=-1;
 MemoNote.Text:=ods_mainNOTE.AsString;
 Add.Visible:=false;
 new.Visible:=true;
end;

procedure TFormNote.NewClick(Sender: TObject);
begin
{ dey:=false; }
DBLook_notetypes.KeyValue:=-1;
DBLook_commtypes.KeyValue:=-1;
MemoNote.Clear;
 Add.Visible:=true;
 new.Visible:=false;

end;

