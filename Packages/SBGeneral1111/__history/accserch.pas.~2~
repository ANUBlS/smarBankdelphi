procedure TFormAccounts_PaymetOreder.XDBGridAccounts_paymetOrderDblClick(
  Sender: TObject);
begin
v_AccNo:=PaymentOrderDataMod.ODSAccounts_PyaOrder.FieldByName('ACC_NO').AsString;
  FormAccounts_PaymetOreder.Close;

end;

end.
