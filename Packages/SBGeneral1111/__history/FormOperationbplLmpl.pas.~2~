procedure TFormOperation.XDBGrid1DrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TXColumn; State: TGridDrawState);

var
  ImageIndex: Integer;
begin

  ImageIndex := -1;
  with Sender as TXDBGrid do
  begin
    if DataSource.DataSet.RecordCount <> 0 then
    begin
      case DataSource.DataSet.fieldbyname('Status').asInteger of
        tsCommited:
          ImageIndex := 0;
        tsRejected:
          ImageIndex := 1;
        tsDelayed:
          ImageIndex := 2;
      else
      end;
      if (DataCol = 0) and (ImageIndex <> -1) then
        ImageList1.Draw(Canvas, Rect.Left, Rect.Top, ImageIndex, True)
      else
        DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;
  end;
end;

