procedure TFormTransaction4.Edit_id_BKeyPress(Sender: TObject; var Key: Char);
var
  v_cust_type_id: Integer;

  begin
  if ord(Key) = 13 then
  begin
    with DataModule_bussProc.ODS_CUSTOMERS_PHYS_FS1 do
    begin
      close;
      sql[8] := ' ';
      if Edit_id_B.Text <> '' then
        sql[8] := sql[8] + ' and c.ID = ' + Edit_id_B.Text;
      open;
      if RecordCount = 0 then
      begin
       ShowMessage('Belə müştəri yoxdu  !');
        // exit;
        Edit_id_B.Clear;
      end;
      Edit_cust_name_B.Text := FieldByName('cust_name').AsString;

      with DataModule_bussProc.ODS_AccNO_B do
      begin
        close;
        SetVariable('CustID', strtoint(Edit_id_B.Text));
        open;
      end;

      v_cust_type_id := DataModule_bussProc.ODS_CUSTOMERS_PHYS_FS1.FieldByName
        ('CUST_TYPE').AsInteger;
      if v_cust_type_id in [0, 2] then
      begin
        Edit_inn_B.Visible := True;
        Edit_inn_B.Text := FieldByName('inn').AsString;
        Edit_pasp_ser_B.Visible := False;
        Edit_pasp_num_B.Visible := False;
        Label_PASPIN_INN_B.Caption := 'Vöen';
        Edit_inn_fs_B.Visible:=false;
        Label_acc_noA.Visible:=false;
      end
      else
      begin
        Edit_pasp_ser_B.Visible := True;
        Edit_pasp_num_B.Visible := True;
      end;

      if v_cust_type_id = 1 then
      begin
        Edit_pasp_ser_B.Visible := True;
        Edit_pasp_num_B.Visible := True;
        Edit_pasp_ser_B.Text := FieldByName('passport').AsString;
        Edit_pasp_num_B.Text := FieldByName('passp_number').AsString;
        Edit_inn_B.Visible := False;
        Label_PASPIN_INN_B.Caption := 'Pasport seriyasi'  ;
        Edit_inn_fs_B.Visible:=false  ;
        Label_acc_noA.Visible:=false
      end
      else if v_cust_type_id = 3 then
      begin

        Edit_pasp_ser_B.Visible := True;
        Edit_pasp_num_B.Visible := True;
        Edit_pasp_ser_B.Text := FieldByName('passport').AsString;
        Edit_pasp_num_B.Text := FieldByName('passp_number').AsString;
        Edit_inn_B.Visible := False;
        Label_PASPIN_INN_B.Caption := 'Pasport seriyasi';
        Label_acc_noA.Visible:=true;
        Edit_inn_fs_B.Visible:=true;
        Edit_inn_fs_B.Text := FieldByName('inn').AsString;

      end
      else
        Edit_inn_B.Visible := True;
    end;

    if DataModule_bussProc.ODS_AccNO_B.RecordCount <= 2 then
    begin
      DataModule_bussProc.ODS_AccNO_B.First;
       DBLookupComboboxEh_B1.KeyValue :=
        DataModule_bussProc.ODS_AccNO_B.FieldByName('symb').AsString;
    end
    else
      BEGIN DataModule_bussProc.ODS_AccNO_B.Last;
      DBLookupComboboxEh_B1.KeyValue := ' ';
  END;

     with DataModule_bussProc.ODS_AccNO_B do
  begin
    if RecordCount = 2 then
   DBCBoxAccNo_B.KeyValue :=DataModule_bussProc.ODS_AccNO_B.FieldByName
        ('acc_no').AsString
    else
   DBCBoxAccNo_B.KeyValue := ' ';
    end;

  case DataModule_bussProc.ODS_CUSTOMERS_PHYS_FS1.FieldByName('cust_type').AsInteger of
  0:begin
    RadioBu_jur_B.Checked:=true;
    RadioBu_phys_B.Enabled:=false;
    RadioBu_fs_B.Enabled:=false;
   end;

  1:begin
   RadioBu_phys_B.Checked:=true ;
   RadioBu_jur_B.Enabled:=false;
   RadioBu_fs_B.Enabled:=false;
   end;
  2:begin
  if  RadioBu_fs_B.Checked=false then
     RadioBu_fs_B.Checked:=true
     else
   RadioBu_fs_B.Checked:=true;
   RadioBu_jur_B.Enabled:=false;
   RadioBu_phys_B.Enabled:=false;
  end;
  3:begin
     RadioBu_phys_B.Checked:=false;
     RadioBu_fs_B.Checked:=false;
     RadioBu_jur_B.Enabled:=false;
  end;
 end;
 end;
 end;

