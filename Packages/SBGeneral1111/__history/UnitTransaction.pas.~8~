procedure TFormTransaction4.DBLookupComboboxEh_A1CloseUp(Sender: TObject;
  Accept: Boolean);
var
  a, b, s: string;
begin
  if (DBLookupComboboxEh_A1.KeyValue <> '') then
  begin
    with DataModule_bussProc, ODS_AccNO_A do
    begin
      s := '';
      a := DBLookupComboboxEh_A1.KeyValue; // ='hhh';
      b := inttostr(DBLookupComboboxEh_fil_A.KeyValue);
      if a <> 'hhh' then
        s := 'and  a.symb like  ''%' + a + '%''';
      if b <> '-1' then
        s := s + ' and a.filial=' + b;
      close;
      // ShowMessage(s);
      sql[13] := s;
      open;
      if RecordCount=1 then
      DBCBoxAccNo_A.KeyValue:=DataModule_bussProc.ODS_AccNO_A.FieldByName('acc_no').AsString

    else
    begin
    DBCBoxAccNo_A.KeyValue:='';
    end;
    end;
  end;

end;

