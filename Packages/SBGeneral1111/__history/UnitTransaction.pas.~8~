procedure TFormTransaction4.EditAmountKeyUp(Sender: TObject; var Key: Word;
  Shift: TShiftState);
var
  deb_rate, kred_rate: Real;
  DebitAmmount, CreditAmmount, LAmmount: Currency;
begin
  with DataModule_bussProc do
  begin
    if (ODS_AccNO_A.active) and (ODS_AccNO_A.RecordCount <> 0) and
      (not(ODS_AccNO_A.FieldByName('id').IsNull)) and (ODS_AccNO_B.active) and
      (ODS_AccNO_B.RecordCount <> 0) and
      (not(ODS_AccNO_B.FieldByName('id').IsNull)) and
      (ODS_AccNO_C.active) and
      (ODS_AccNO_C.RecordCount <> 0) and
      (not(ODS_AccNO_C.FieldByName('id').IsNull)) and
      (EditAmount.Value > 0) then
    begin

      BtnOK.Enabled := True;
    end
    else
      BtnOK.Enabled := False;
  end;

end;

