procedure TDataModule_bussProc.BusProcFilter(Dset: TOracleDataSet);
var
  x:integer;
  xy,n:string;
begin
 if  Ods_cust_proc.FieldByName('cust_type').AsInteger=4 then
 begin
   showmessage('Nominal müştərinin hesablarına baxmaq olmaz     !');
   exit;
 end;

 case Ods_cust_proc.FieldByName('cust_type').AsInteger
 {PCustServiceForm.XFRadioGroupCust_type.ItemIndex} of
 0,1,2:begin
  with Dset do
  begin
  //showmessage(inttostr(Ods_cust_proc.RecordCount) );
       xy:='in ' + inttostr(Ods_cust_proc.FieldByName('cust_type').AsInteger);
       SetVariable('custtype',xy);
      end;
  end;

  3:begin
   with Dset do
  begin

    case Ods_cust_proc.FieldByName('cust_type').AsInteger of
     -1:x:=10 ;
      0:a:= 'in 1';
      1:a:= 'in 2' ;

    end;
     if x=10 then
      begin
      n:='0,1,2,3,4'  ;
      xy:='in ('+n+')';
        SetVariable('custtype',xy);
       end else
       begin
      SetVariable('custtype',xy);
        end;
       end
      end;
      end;
       end;


