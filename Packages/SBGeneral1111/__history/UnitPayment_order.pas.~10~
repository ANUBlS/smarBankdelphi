function TPayment_order.WithCoin(Ammount :string):string;
var
  tTrunc :currency;
  tDev: Double;
begin
   tTrunc :=Trunc(StrToCurr(Ammount));
   tDev:=(Round(Frac(StrToCurr(Ammount))*100));
  // Delete(Ammount,Pos(CurrToStr(tTrunc),Ammount),Length(CurrToStr(tTrunc))+1);
  //  if Ammount ='' then Ammount :='00';
  // result :=CurrencyToHR_Azeri(tTrunc,0,[0])+' '+'='+' '+Ammount+' гяп';

  result :=CurrencyToHR_Azeri(tTrunc,0,[0])+' '+'='+' '+FloatToStr(tDev)+' qəp';
end;


