procedure TPayment_order.DBCodKeyPress(Sender: TObject; var Key: Char);
begin
 if key =#13 then
 with PaymentOrderDataMod.ODSBankInfo do
  begin
   if Locate('BANKCODE',DBCod.Text,[loCaseInsensitive, loPartialKey]) then
    begin
     DBName.Text :=FieldByName('BANK').AsString;
    // EKBCod.Text :=FieldByName('BANKCODE').AsString;
     DBInn.Text :=FieldByName('INN').AsString;
     DBCorAcc.Text :=FieldByName('KRNO').AsString;
     DBSwift.Text :=FieldByName('SWIFT').AsString;
    end;
  end;

end;
procedure TPayment_order.PustToComboID(DataSet :TOracleDataSet; Field,IDfield :String; ComboBox :TComboBox);
var
   RateIndex :Integer;
begin
 RateIndex :=0;
 if DataSet. Active=false then DataSet.Open;
  DataSet.First;
   SetLength(Rate,DataSet.RecordCount);
   ComboBox.Items.Clear;
    while not(DataSet.Eof) do
     begin
      ComboBox.Items.Add(DataSet. FieldByName(Field).AsString);
      Rate[RateIndex] :=DataSet. FieldByName(IDfield).AsInteger;
      DataSet.Next;
      Inc(RateIndex);
     end;
end;
procedure TPayment_order.PustToComboKOD(DataSet :TOracleDataSet; Field,IDfield :String; ComboBox :TComboBox);
var
   RateIndex1 :Integer;
begin
 RateIndex1 :=0;
 if DataSet. Active=false then DataSet.Open;
  DataSet.First;
   SetLength(Rate1,DataSet.RecordCount);
   ComboBox.Items.Clear;
    while not(DataSet.Eof) do
     begin
      ComboBox.Items.Add(DataSet. FieldByName(Field).AsString);
      Rate1[RateIndex1] :=DataSet. FieldByName(IDfield).AsInteger;
      DataSet.Next;
      Inc(RateIndex1);
     end;
end;
