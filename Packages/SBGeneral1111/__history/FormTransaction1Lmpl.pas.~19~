      begin
        DataModule_bussProc.Ds_hesab.SetVariable('balcn',DataModule_bussProc.ODS_BussProc.FieldByName('accbalcn_a').AsInteger);
         sql[6]:=' and  filial = '+ inttostr(DBLookupComboBo_filial.keyvalue);
        open;
        end
         else
        begin
        DataModule_bussProc.Ds_hesab.SetVariable('balcn',DataModule_bussProc.ODS_BussProc.FieldByName('accbalcn_a').AsInteger);
        sql[6]:='';
        open;

      end;
    end;
end;

