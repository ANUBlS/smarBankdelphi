procedure GetPath;
var
  ImagesPath: String;

begin
  ImagesPath := Format('%s\..\Env\Customers', [ExtractFilePath(ParamStr(0))]);
  Path := Format('%s\temp.jpg', [ImagesPath]);
  Path_B := Format('%s\blank.jpg', [ImagesPath]);
end;

procedure Fill_Edit;
   var
  F: File of byte;
  begin
  GetPath;
   if ( DataCustNom.DScustimageStamp.IsNull) then
  begin
    FormCustNom.Image2.Picture.LoadFromFile(Path_B);
    { --no record - godda empty Image1-- }
  end
  else
  begin
    DataCustNom.DScustimageStamp.SaveToFile(Path);
    AssignFile(F, Path);
    Reset(F);
    if FileSize(F) > 0 then
    begin
      CloseFile(F);
      FormCustNom.Image2.Picture.LoadFromFile(Path);

    end
    else
    begin
      CloseFile(F);
      FormCustNom.Image2.Picture.LoadFromFile(Path_B);
    end;
  end;

   if (DataCustNom.DScustimageCUSTSIGN.IsNull) then
  begin
    FormCustNom.Image1.Picture.LoadFromFile(Path_B);
   end
  else
  begin
    DataCustNom.DScustimageCUSTSIGN.SaveToFile(Path);
    AssignFile(F, Path);
    Reset(F);
    if FileSize(F) > 0 then
    begin
      CloseFile(F);
      FormCustNom.Image1.Picture.LoadFromFile(Path);
     end
    else
    begin
      CloseFile(F);
      FormCustNom.Image1.Picture.LoadFromFile(Path_B);
    end;
  end;
    if (DataCustNom.DScustimagePhoto.IsNull) then
  begin
    FormCustNom.Image3.Picture.LoadFromFile(Path_B);
   end
  else
  begin
    DataCustNom.DScustimagephoto.SaveToFile(Path);
    AssignFile(F, Path);
    Reset(F);
    if FileSize(F) > 0 then
    begin
      CloseFile(F);
      FormCustNom.Image3.Picture.LoadFromFile(Path);
    end
    else
    begin
      CloseFile(F);
      FormCustNom.Image3.Picture.LoadFromFile(Path_B);
    end;
  end;

  end;



