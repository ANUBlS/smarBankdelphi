end;

procedure TDataAcc.ODS_bal_spr_groups1AfterScroll(DataSet: TDataSet);
begin
ODS_bal_spr3.Close;
ODS_bal_spr3.SQL[2] :=  'and nvl(upper((bal_cn||'' ''|| balname)),0) like upper (''' +
ODS_bal_spr_groups1.FieldByName('part').AsString + '%'')';
ODS_bal_spr3.Open;
end;

procedure TDataAcc.ODS_bal_spr_groupsAfterScroll(DataSet: TDataSet);
begin
ODS_bal_spr2.Close;
ODS_bal_spr2.SQL[2] := 'and accgroup='+ODS_bal_spr_groups.FieldByName('grp').AsString ;
ODS_bal_spr2.Open;
end;

procedure TDataAcc.ODS_bal_spr_parts1AfterScroll(DataSet: TDataSet);
begin

if FormBalCn1.edit1.Text<>'' then
 begin

ODS_bal_spr_groups1.Close;
ODS_bal_spr_groups1.SQL[2] :=  'and nvl(upper((part||'' ''|| grpname)),0) like upper (''' +
ODS_bal_spr_parts1.FieldByName('PART').AsString + '%'')';
ODS_bal_spr_groups1.Open;
end;
end;

procedure TDataAcc.ODS_bal_spr_partsAfterScroll(DataSet: TDataSet);
begin
if FormBalCn.edit1.Text<>'' then
 begin

ODS_bal_spr_groups.Close;
ODS_bal_spr_groups.SQL[2] :=  'and nvl(upper((grp||'' ''|| grpname)),0) like upper (''' +
ODS_bal_spr_parts.FieldByName('PART').AsString + '%'')';
ODS_bal_spr_groups.Open;
end;
end;

