                     RichEdit2.Text:=RichEdit1.SelText;
                   end;
 //   ShowMessage(StMessage.Text);




   //end;
    For I := 1 To RichEdit2.Lines.Count-1 Do
    Begin
      dataset.Insert;

      if say=1 then
      begin

        StMessage:= RichEdit2.Lines[i];
        FnEndPos:=pos('code=',trim(StMessage));
        Text1:=StringReplace((copy(trim(StMessage),21,FnEndPos-21)),'"','',[rfReplaceAll]);
        dataset.FieldByName('name').AsString:=Text1;
        FnStartPos:=pos('code=',trim(StMessage))+6;
