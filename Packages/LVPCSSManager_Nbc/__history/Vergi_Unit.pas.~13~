      if say=2 then
      begin
        StMessage:= RichEdit2.Lines[i];
        FnEndPos:=pos('name=',trim(StMessage));
        Text1:=StringReplace((copy(trim(StMessage),20,FnEndPos-20)),'"','',[rfReplaceAll]);
        dataset.FieldByName('id').AsVariant:=Text1;
        FnStartPos:=pos('name=',trim(StMessage))+6;
        FnEndPos:=pos('/>',trim(StMessage));
        Text1:=StringReplace((copy(trim(StMessage),FnStartPos,FnEndPos-FnStartPos)),'"','',[rfReplaceAll]);
        dataset.FieldByName('name').AsString:=Text1;
        dataset.FieldByName('DESCRIPTION').AsString:=dataset.FieldByName('name').AsString+'-'+ dataset.FieldByName('id').AsString
     end;

     if say=3 then
      begin
        StMessage:= RichEdit2.Lines[i];
        FnEndPos:=pos('code=',trim(StMessage));
        Text1:=StringReplace((copy(trim(StMessage),13,FnEndPos-13)),'"','',[rfReplaceAll]);
        dataset.FieldByName('name').AsString:=Text1;
