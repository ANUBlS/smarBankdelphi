        Text1:=StringReplace((copy(trim(StMessage),FnStartPos,FnEndPos-FnStartPos)),'"','',[rfReplaceAll]);
        dataset.FieldByName('Tek').AsString:=Text1;
        dataset.FieldByName('DESCRIPTION').AsString:=dataset.FieldByName('id').AsString+'-'+dataset.FieldByName('name').AsString;
         ShowMessage('bb');
