   sboapiDataModule.SBSession.Commit;
   DataMod.INS.Callprocedure('xs_BatchAmount_update',[DataMod.XS_BATCHS.fieldbyname('ID').asinteger]);
   DataMod.INS.Callprocedure('xs_format_update',[DataMod.XS_BATCHS.fieldbyname('ID').asinteger,Format]);
   DataMod.Ins.callprocedure('xs_beneficiary_ChangeStatus',[DataMod.XS_BENEFICIARY.fieldbyname('ID').ASinteger,0]);
