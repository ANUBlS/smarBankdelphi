procedure TPaymentDetalsForm.Button4Click(Sender: TObject);
begin
    if CheckField = false then exit;
    IF length(Edit_Client_acc_no.text)<>28 THEN  begin
                                                   ShowMessage('Hesabın uzunluğu düzgün deyil!!!!!!');
                                                   exit;
                                                 end;

    IF DataMod.SBOP.CallIntegerFunction('check_IBAN_acc_num',[Edit_Client_acc_no.text])=0 THEN begin
                                                                                                 ShowMessage('Hesab ibana  uyğun deyil!!!!!!');
                                                                                                 exit;
