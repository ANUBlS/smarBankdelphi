Function CheckField: Boolean;
    var i : integer;
begin
    if (Trim(PaymentDetalsForm.Edit_Referens.Text) = '')or
       (PaymentDetalsForm.Edit_Amount.Value=0)or
       (Trim(PaymentDetalsForm.Edit_TransCode.Text)='')or
       (PaymentDetalsForm.Combo_BankName.ItemIndex=-1)or
       (Trim(PaymentDetalsForm.Edit_BankCode.Text)='')or
       (Trim(PaymentDetalsForm.Edit_account.Text)='')or
       (Trim(PaymentDetalsForm.Edit_Voen.Text)='')or
       (Trim(PaymentDetalsForm.Edit_Account_Sub.Text)='')or
       (Trim(PaymentDetalsForm.Edit_Bik.Text)='')or
       (Trim(PaymentDetalsForm.Edit_Client_acc_no.Text)='')or
       (Trim(PaymentDetalsForm.Edit_Client_Name.Text)='')or
       (Trim(PaymentDetalsForm.Edit_Client_Voen.Text)='')or
       (Trim(PaymentDetalsForm.Edit_tey1.Text)='') then
        begin
          Result :=  false;
          MessageDlg('Məlumat Tam deyil !',mtWarning,[mbok],0);exit;
        end
        else
          Result:=true;
        with PaymentDetalsForm do
        for i :=0 to ComponentCount-1 do
        begin
           if Components[i].ClassName =  'TEdit' then
           if ((Components[i] as TEdit).Text<>'') and(
              (Components[i].Name='Edit_tey1')  or
              (Components[i].Name='Edit_tey2')  or
              (Components[i].Name='Edit_tey3')  or
              (Components[i].Name='Edit_tey4')  or
              (Components[i].Name='Edit_inf1')  or
              (Components[i].Name='Edit_inf2')  or
              (Components[i].Name='Edit_inf3'))  then
             { if ((Components[i] as TEdit).Text[1] in ['0'..'9','A'..'Z']) then
                  Result:=true
              else
                  begin
                    Result :=  false;
                    MessageDlg('Məlumat düzgün deyil !',mtWarning,[mbok],0);
                    exit;
                  end;       }

                Case ((Components[i] as TEdit).Text[1])of
                 '0'..'9':Result:=true;
                 'A'..'H':Result:=true;
                 'J'..'Z':Result:=true;
                 'Ə':Result:=true;
                 'Ü':Result:=true;
                 'Ö':Result:=true;
                 'Ğ':Result:=true;
                 'Ş':Result:=true;
                 'Ç':Result:=true;
                 'İ':Result:=true;
                 'I':Result:=true;
                else
                  begin
                    Result :=  false;
                    MessageDlg('Məlumat düzgün deyil !',mtWarning,[mbok],0);
                    exit;
                  end;
                end;
        end;
end;

