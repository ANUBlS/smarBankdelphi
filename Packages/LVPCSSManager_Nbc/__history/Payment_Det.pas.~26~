                                                        strtofloat(Edit_TransCode.text),
                                                        edit_inf1.text+'|'+edit_inf2.text+'|'+edit_inf3.text+'|',
                                                        strtofloat(valute_id.items[combo_valute.itemindex]),
                                                        edit_referens.text,
                                                        Edit_Amount.value,
                                                        bnf_count]);
    if after_add then
    begin
      sboapiDataModule.SBSession.Commit;
      DataMod.INS.Callprocedure('xs_BatchAmount_update',[DataMod.XS_BATCHS.fieldbyname('ID').asinteger]);
      DataMod.Ins.callintegerfunction('xs_Batchs_ChangeStatus',[DataMod.XS_BATCHS.fieldbyname('ID').ASinteger,0]);
      DataMod.XS_BATCHS.RefreshRecord; //LVPCSSForm.RefreshWithPos;
      DataMod.XS_BENEFICIARY.Refresh;
    end
     else
      begin
        TransForm.Edit_BNF.Text:='\BNF\'+inttostr(PaymentDetalsForm.bnf_count);
        TransForm.Edit_Amount.text:=floattostr(TransForm.Edit_Amount.value+edit_Amount.value);
      end;
    {CLEAR EDIT}
    Combo_BankName.ItemIndex:=-1;
    Edit_BIK.Clear;
    Edit_BankCode.clear;
    Edit_account.Clear;
    Edit_account_sub.Clear;
    Edit_Voen.Clear;
    Edit_Amount.Clear;
    Edit_TransCode.Clear;
    {NEW REF NUMBER for messages}
    if Edit_Referens.Text='' then
    PaymentDetalsForm.Edit_Referens.Text := DataMod.INS.CallStringFunction('GetNewBeneficiaryReference',[]);
    Edit_Client_Name.Clear;
    Edit_Client_Code.Text:='/';
    Edit_Client_acc_no.Clear;
    Edit_Client_Voen.Clear;
    Edit_Referens.Clear;
    Edit_inf1.Clear;
    Edit_inf2.Clear;
    Edit_inf3.Clear;
    Edit_tey1.Clear;
    Edit_tey2.Clear;
    Edit_tey3.Clear;
    Edit_tey4.Clear;
    if MT then If RB_102T.Checked then RB_102.Checked:=true;
    TransForm.ButtonPost.Enabled:=true;
    PaymentDetalsForm.ButtonFinish.Enabled:=true ;
    DataMod.XS_BENEFICIARY.Last;
end;

