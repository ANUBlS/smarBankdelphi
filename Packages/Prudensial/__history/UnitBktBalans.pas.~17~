unit UnitBktBalans;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Grids, DBGrids, DBCtrls, ExtCtrls, DB, OracleData, StdCtrls,
  CMExcelExport, Menus, DBGridEh, Mask, DBCtrlsEh, DBLookupEh;

type
  TBKTBalans = class(TForm)
    BKTBalans: TOracleDataSet;
    DSBKTBalans: TDataSource;
    BKTName: TOracleDataSet;
    Panel1: TPanel;
    Panel2: TPanel;
    Button1: TButton;
    Button2: TButton;
    Button3: TButton;
    Button4: TButton;
    DBGrid1: TDBGrid;
    DSBKTName: TDataSource;
    BKTBalansBKT: TFloatField;
    BKTBalansTIP: TIntegerField;
    BKTBalansBALANS_H: TIntegerField;
    BKTBalansNAME: TWideStringField;
    BKTBalansDESCRIPTION: TWideStringField;
    BKTBalansBALANS: TIntegerField;
    CMExcelExport1: TCMExcelExport;
    Button5: TButton;
    Panel3: TPanel;
    GroupBox1: TGroupBox;
    GroupBox2: TGroupBox;
    DBLookupComboboxEh1: TDBLookupComboboxEh;
    CheckBox1: TCheckBox;
    procedure Button3Click(Sender: TObject);
    procedure Button4Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure Button1Click(Sender: TObject);
    procedure Button5Click(Sender: TObject);
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  BKTBalans: TBKTBalans;

implementation
uses sboapiDataModuleImpl, UnitBalansAdd;

{$R *.dfm}

procedure TBKTBalans.Button1Click(Sender: TObject);
begin
  FormAdd.DBLookupComboboxEh1.KeyValue:=null;
  FormAdd.DBLookupComboboxEh2.KeyValue:=-1;
  FormAdd.DBLookupComboboxEh3.KeyValue:=-1;
  FormAdd.ShowModal;
end;

procedure TBKTBalans.Button2Click(Sender: TObject);
var
  Bkttype:variant;
  Tip:variant;
  Balans:variant;
begin
  Bkttype:=DBGrid1.DataSource.DataSet.FieldByName('bkt').AsVariant;
  Tip:=DBGrid1.DataSource.DataSet.FieldByName('tip').AsVariant;
  Balans:=DBGrid1.DataSource.DataSet.FieldByName('balans_h').AsVariant;
  FormAdd.Prudensial.CallProcedure('BktDelete',[Bkttype,Tip,Balans]);
  BKTBalans.Refresh;
end;

procedure TBKTBalans.Button3Click(Sender: TObject);
begin
  BKTBalans.Refresh;
end;

procedure TBKTBalans.Button4Click(Sender: TObject);
begin
  CMExcelExport1.Connect;
  CMExcelExport1.ExportDataset(BKTBalans,'BKTBalans',true);
end;



procedure TBKTBalans.Button5Click(Sender: TObject);
begin
  if not(GroupBox1.Visible) then  begin
                                    GroupBox1.Visible:=True;
                                    DBLookupComboboxEh1.KeyValue:=-1;
                                    CheckBox1.Checked:=False;
                                  end
                            else GroupBox1.Visible:=False;
end;

procedure TBKTBalans.FormShow(Sender: TObject);
begin
  if GroupBox1.Visible then GroupBox1.Visible:=False;
end;

end.
