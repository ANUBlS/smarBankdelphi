procedure TsbCloseDayForm.SpeedButton1Click(Sender: TObject);
begin
 closingstatus.close;
 closingstatus.open;
 
  if closingstatusPERCENT_CALC.AsInteger=1 then
   begin
    ShowMessage('Artıq faizlər hesablanıb!');
    exit;
   end;
   if
    MessageDlg(
      Format(
        'Faizlər,Ehtiyatlar hesablanacaq əminsinizmi!',
        [DateToStr(Sb_GetSystemDate()), DateToStr(NewDateEdit.Date)]),
      mtConfirmation,
      [mbYes, mbCancel],
      0)
     = mrYes
  then
   begin
     SBSYSTEM.CallProcedure('calc_percent', []);
     ShowMessage('Faizlər hesablandı günü bağlaya bilərsiz');
   end;

end;

procedure TsbCloseDayForm.CloseButtonClick(Sender: TObject);
resourcestring
  Message_CloseDayWarning =
      'Are you sure to close current operation day '+
      '(current operation date is: "%s"), and open with date: "%s"';
var NewDate: tDateTime;
tBeg, tEnd: Ttime;
begin

  if ControlManagerForm.ControlButton = False then begin
   ShowMessage('Nəzarət düyməsindən istifadə etmədən davam etmək olmaz!');
   Exit;
  end;
 closingstatus.close;
 closingstatus.open;
   if closingstatusPERCENT_CALC.AsInteger=0 then
   begin
    ShowMessage('Öncə faizləri hesablayın!');
    exit;
   end;


  if
    MessageDlg(
      Format(
        Message_CloseDayWarning,
        [DateToStr(Sb_GetSystemDate()), DateToStr(NewDateEdit.Date)]),
      mtConfirmation,
      [mbYes, mbCancel],
      0)
     = mrYes
  then
   begin
  TBeg:=Time();
  NewDate := Trunc(NewDateEdit.Date);
  SBSYSTEM.CallProcedure('close_day', ['NewDate', NewDate]);
//   Sb_CloseDay(NewDateEdit.Date);
    TEnd:=Time();
    ShowMessage('Day Closed.'+#13#10+TimeToStr(TBeg)+'-'+TimeToStr(TEnd));
   end;
end;

