procedure TCustomerMainForm.ActiveFormCreate(Sender: TObject);
begin
  CustomerDataModuleImpl.Initialize;
  CustomerPropertiesForm := TCustomerPropertiesForm.Create(Self);

  CustomerDataModule.ActiveCustomerList.Open;
  with CustomerDataModule.CurrencyData do
  begin
    First;
    while not Eof do
    begin
      AccCurrencyCB.Items.Add(FieldByName('VALU_NAME').AsString);
      Next;
    end;
  end;

  AccCurrencyCB.ItemIndex := 0;
  AccOrderCB.ItemIndex := 0;
  CanRefresh:=False;
  cbOrderCus.ItemIndex:=0;
  scbFilial.ItemIndex:=0;
  CanRefresh:=True;
  RebuildAccQuery;
SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);

end;

