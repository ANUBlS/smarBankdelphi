{$R *.DFM}

uses sboapidatamoduleimpl, CustomerDataModuleImpl, CustomerInfoFormImpl;

procedure TfrmIPINFO.FormCreate(Sender: TObject);
var
  i: Integer;
begin
  for i:=0 to ComponentCount-1 do
    if (Components[i] is TOracleDataSet) and (Components[i].Tag=3) then
      (Components[i] as TOracleDataSet).Open;
  with ODSIpInfo do begin
    ClearVariables;
    Close;
    SetVariable('custid',CustomerDataModule.ActiveCustomerList.FieldByName('ID').AsVariant);
    open;
    if FieldByName('BDATE').AsString='' then begin
      cb_BDATE.Date := Date;

    end else begin
      cb_BDATE.Date := FieldByName('BDATE').AsDateTime;
    end;
    if FieldByName('INSCONTRACTDATE').AsString='' then
      cb_INSCONTRACTDATE.Date := Date
    else
      cb_INSCONTRACTDATE.Date := FieldByName('INSCONTRACTDATE').AsDateTime;

    if FieldByName('INSCONTRLASTDATE').AsString='' then
      cb_INSCONTRLASTDATE.Date := Date
    else
      cb_INSCONTRLASTDATE.Date := FieldByName('INSCONTRLASTDATE').AsDateTime;

    if FieldByName('INSCONTRACTPREIOD').AsString='' then
      cb_INSCONTRACTPREIOD.Date := Date
    else
      cb_INSCONTRACTPREIOD.Date := FieldByName('INSCONTRACTPREIOD').AsDateTime;
  end;
    SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TfrmIPINFO.DBEdit3Change(Sender: TObject);
var
  cname: String;
begin
  Button1.Enabled := True;
  if (Sender is TDateTimePicker) then begin
    cname := (Sender as TComponent).Name;
    cname := copy(cName,4,length(cname)-3);
    ODSIpInfo.FieldByName(cname).AsDateTime := (Sender as TDateTimePicker).Date;
  end;
end;

procedure TfrmIPINFO.Button1Click(Sender: TObject);
begin
  with ODSIpInfo do begin    

    if FieldByName('CUSTID').AsString = '' then
      FieldByName('CUSTID').AsInteger := CustomerDataModule.ActiveCustomerList.FieldByName('ID').AsInteger;
    if FieldByName('CARDID').AsString = '' then
      FieldByName('CARDID').AsInteger := CardID;

    FieldByName('BDATE').AsDateTime := cb_BDATE.Date;
    FieldByName('INSCONTRACTPREIOD').AsDateTime := cb_INSCONTRACTPREIOD.Date;
    FieldByName('INSCONTRACTDATE').AsDateTime := cb_INSCONTRACTDATE.Date;
    FieldByName('INSCONTRLASTDATE').AsDateTime := cb_INSCONTRLASTDATE.Date;
    Post;
    (Sender as TControl).Enabled := False;
    refresh;
    try Edit; except end;
  end;
end;

procedure TfrmIPINFO.FormShow(Sender: TObject);
begin
  with ODSIpInfo do begin
    if FieldByName('BDATE').AsString='' then begin
      cb_BDATE.Date := Date;

    end else begin
      cb_BDATE.Date := FieldByName('BDATE').AsDateTime;
    end;
    if FieldByName('INSCONTRACTDATE').AsString='' then
      cb_INSCONTRACTDATE.Date := Date
    else
