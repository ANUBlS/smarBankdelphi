type
  ERecordNotFound = class(Exception);

  TCustomerPropertiesForm = class(TForm)
    Label3: TLabel;
    Label5: TLabel;
    Label7: TLabel;
    Label9: TLabel;
    Label10: TLabel;
    Label11: TLabel;
    Label12: TLabel;
    Label13: TLabel;
    Label15: TLabel;
    Label16: TLabel;
    Label17: TLabel;
    Label18: TLabel;
    Label19: TLabel;
    Bevel1: TBevel;
    OpenDateEdit: TDateTimePicker;
    OkButton: TButton;
    CancelButton: TButton;
    NameEdit: TDBEdit;
    RelationCB: TDBLookupComboBox;
    GroupCB: TDBLookupComboBox;
    EstateTypeCB: TDBLookupComboBox;
    OrganizationTypeCB: TDBLookupComboBox;
    ActionAreaCB: TDBLookupComboBox;
    BranchCB: TDBLookupComboBox;
    ClientClosedCB: TCheckBox;
    ClientClosedPanel: TPanel;
    CloseDateEdit: TDateTimePicker;
    Label6: TLabel;
    IsNotResidentCB: TDBCheckBox;
    Label8: TLabel;
    OKPOCodeEdit: TDBEdit;
    TazAreaCB: TDBLookupComboBox;
    TaxIDEdit: TDBEdit;
    BankIDEdit: TDBEdit;
    DBEdit1: TDBEdit;
    DBEdit3: TDBEdit;
    DBEdit4: TDBEdit;
    Button1: TButton;
    ActionList1: TActionList;
    InfoView: TAction;
    IpInfoView: TAction;
    procedure CancelButtonClick(Sender: TObject);
    procedure OkButtonClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure ClientClosedCBClick(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure InfoViewExecute(Sender: TObject);
  private
    { Private declarations }
    FCustomerParams: TCustomer;
    FClientClosed: Boolean;
    FChanged: Boolean;
    procedure SetCustomerParams(Customer: TCustomer);
    property CustomerParams: TCustomer read FCustomerParams write SetCustomerParams;
    procedure SetClientClosed(Value: Boolean);
  public
    { Public declarations }
    procedure Reset;
    function New: Boolean;
    procedure Edit(ID: Integer);
    property ClientClosed: Boolean read FClientClosed write SetClientClosed;
  end;

var
  CustomerPropertiesForm: TCustomerPropertiesForm;

implementation

{$R *.DFM}

uses SBCore, CustomerDataModuleImpl, OracleData, CustomerInfoFormImpl,
  uCustomersIPInfo;

function TCustomerPropertiesForm.New: Boolean;
begin
  Reset;
  CustomerDataModule.ActiveCustomerList.Insert;
  InfoView.Visible := False;
  ShowModal;
  Result := FChanged; 
end;

procedure TCustomerPropertiesForm.Edit(ID: Integer);
var
  Customer: TCustomer;
begin
  Reset;
  CustomerDataModule.ActiveCustomerList.Edit;
  Sb_GetCustomer(ID, Customer);
  CustomerParams := Customer;
  InfoView.Visible := True;
  ShowModal;
end;

procedure TCustomerPropertiesForm.CancelButtonClick(Sender: TObject);
begin
  Close;
end;

procedure TCustomerPropertiesForm.OkButtonClick(Sender: TObject);
begin
if IsNotResidentCB.Checked
then
CustomerDataModule.ActiveCustomerList.FieldByName('NEREZIDENT').ASString:='1'
else
CustomerDataModule.ActiveCustomerList.FieldByName('NEREZIDENT').ASString:='0';

 showmessage('dtse'+CustomerDataModule.ActiveCustomerList.FieldByName('NEREZIDENT').ASString);
  showmessage('ID='+CustomerDataModule.ActiveCustomerList.FieldByName('ID').ASString);
      CustomerDataModule.ActiveCustomerList.Edit;
      CustomerDataModule.ActiveCustomerList.post;

  with CustomerDataModule.ActiveCustomerList do
  begin
    FChanged := True;
    FieldByName('OPEN_DAT').AsDateTime := OpenDateEdit.DateTime;
    Post;
    ApplyUpdates([aaInsert, aaUpdate]);
    CommitUpdates;
       end;
  Close;
end;

procedure TCustomerPropertiesForm.Reset;
begin
  FChanged := False;
  OpenDateEdit.DateTime := Sb_GetSystemDate();
  ClientClosed := False;
end;

procedure TCustomerPropertiesForm.SetCustomerParams(Customer: TCustomer);
begin
  FCustomerParams := Customer;

  with CustomerParams do
  begin
    OpenDateEdit.DateTime := OpenDate;
    CloseDateEdit.DateTime := CloseDate;
    ClientClosed := CloseDate <> NullDate;

    CustomerDataModule.Relation.DataSet.Locate('ID', RelationID, []);
  end;
end;

procedure TCustomerPropertiesForm.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  with CustomerDataModule.ActiveCustomerList do
    if State = dsInsert then
    begin
      Cancel;
      CancelUpdates;
    end;
end;

procedure TCustomerPropertiesForm.SetClientClosed(Value: Boolean);
begin
  FClientClosed := Value;
//  ClientClosedPanel.Visible := Value;
  CloseDateEdit.Enabled := Value;
  ClientClosedCB.Checked := Value;
end;

procedure TCustomerPropertiesForm.ClientClosedCBClick(Sender: TObject);
begin
  ClientClosed := (Sender as TCheckBox).Checked;
end;

procedure TCustomerPropertiesForm.FormKeyPress(Sender: TObject;
  var Key: Char);
begin
  if Ord(Key) = VK_RETURN then
    SelectNext(ActiveControl, True, True);
end;

procedure TCustomerPropertiesForm.FormKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if Key = VK_ESCAPE then
    Close;
end;

procedure TCustomerPropertiesForm.InfoViewExecute(Sender: TObject);
begin
  with TCustomerInfoForm.Create(Self) do
  try
    ViewCustInfo(CustomerDataModule.Customers.DataSet.FieldByName('ID').AsInteger);
  finally
    Release;
  end;
end;

end.
