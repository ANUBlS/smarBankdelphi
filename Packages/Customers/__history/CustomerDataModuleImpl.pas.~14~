procedure TCustomerDataModule.ActiveCustomerListCalcFields(
  DataSet: TDataSet);
{var
   Inn :string;
   fState    :Integer;
   fLength   : Integer;}
begin
{
   Inn :='';
   with  DataSet  do
   begin
       fLength := Length(FieldByName('Inn').AsString);
       if  (FLength < 9) and (FieldByName('Inn').AsString <> '')  then
        begin
         for fState :=1 to 9-Length(FieldByName('Inn').AsString) do
          Inn :=Inn +'0';
          FieldByName('RealInn').AsString :=Inn +FieldByName('Inn').AsString;
        end
       else
         FieldByName('RealInn').AsString :=FieldByName('Inn').AsString;
   end;
   }
end;

initialization
finalization
  Cleanup;
