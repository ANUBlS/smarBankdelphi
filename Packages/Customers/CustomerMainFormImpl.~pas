procedure TCustomerMainForm.CloseExecute(Sender: TObject);
begin
  if ActiveAccountList.RecordCount <> 0 then
    MessageDlg('ְךעטג שוסאבכאנû מכהףüףםהאם לצרעÿנטםט באüכאלאד לצלךצם הויטכ.', mtError, [mbOk], 0)
  else
  if MessageDlg('ּצרעÿנט באüכאםסûם?', mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
  begin
    Sb_CloseCustomer(CustomerDataModule.Customers.DataSet.FieldByName('ID').AsInteger);
    Refresh.Execute;
  end;
end;

procedure TCustomerMainForm.RefreshExecute(Sender: TObject);
var
  SavedPos: Integer;
begin
  with CustomerDataModule.ActiveCustomerList do
  begin
    SavedPos := RecNo;
    Close;
    SQL.Text := BuildCusQuery;
    Session := sboapiDataModule.SBSession;
    Open;
    if SavedPos > RecordCount then
      RecNo := RecordCount
    else
      RecNo := SavedPos;
  end;
end;

