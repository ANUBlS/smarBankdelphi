procedure TCustomerMainForm.AccCurrencyCBDrawItem(Control: TWinControl;
  Index: Integer; Rect: TRect; State: TOwnerDrawState);
begin
  with Control as TComboBox do
  begin
    Canvas.FillRect(Rect);
    if (Index = 0) and (not (odComboBoxEdit in State)) then
      if odSelected in State then
        Canvas.Font.Color := clWhite
      else
        Canvas.Font.Color := clRed;
    Canvas.TextOut(Rect.Left+2, Rect.Top+2, Items[Index]);
  end;
end;

procedure TCustomerMainForm.AccOrderCBChange(Sender: TObject);
begin
  FAccOrder := AccIndexToOrderMap[(Sender as TComboBox).ItemIndex];
  FUseAccOrder := AccOrder <> aotNoOrder;
  RebuildAccQuery;
end;

function TCustomerMainForm.BuildAccQuery: String;
begin
 Result := SGetCustomerAccsQuery;
  if AccCurrencyCB.ItemIndex <> 0 then
    Result := Format('%sAND (acc.VAL_ACC = %d)'#13#10, [
      Result,
      CustomerDataModule.CurrencyIDByIndex(AccCurrencyCB.ItemIndex)]);
  if UseAccOrder then
    Result := Format('%sORDER BY %s', [Result, AccOrderFields[AccOrder]]);
end;

procedure TCustomerMainForm.RebuildAccQuery;
begin
  with ActiveAccountList do
  begin
    Close;
    with SQL do
      Text := BuildAccQuery;
    Open;
  end;
end;

function TCustomerMainForm.BuildCusQuery: string;
begin
Result:=SGetCusQuery;

if scbFilial.ItemIndex>0 then
  Result := Format('%sAND ID in(select KLI_ID from ACCOUNT where FILIAL=%d)'#13#10, [
      Result,
      CustomerDataModule.FilialsData.FieldByName('Id').AsInteger]);

 case cbOrderCus.ItemIndex of
  2: Result:=Result+#13#10'order by C.NAME';
  3: Result:=Result+#13#10'order by C.OPEN_DAT';
 else
  Result:=Result+#13#10'order by C.ID';
 end;
end;

