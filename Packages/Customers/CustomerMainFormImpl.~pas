type
  TAccOrderIndex = 0..4;

ResourceString
  SAOAccNo        = 'acc.ACC_NO';
  SAOAccName      = 'acc.NAME';
  SAOAccCurrency  = 'acc.VAL_ACC';
  SAOAccOpenDate  = 'acc.OPEN_DAT';
  SAONoOrder      = 'unused';

const
  AccOrderFields: array[TAccOrder] of String = (SAOAccNo, SAOAccName, SAOAccCurrency, SAOAccOpenDate, SAONoOrder);
  AccOrderToIndexMap: array[TAccOrder] of Integer = (
    {aotAccNo =>        } 1,
    {aotAccName =>      } 2,
    {aotAccCurrency =>  } 4,
    {aotAccOpenDate =>  } 3,
    {aotNoOrder =>      } 0
  );

  AccIndexToOrderMap: array[TAccOrderIndex] of TAccOrder = (
    {0 => } aotNoOrder,
    {1 => } aotAccNo,
    {2 => } aotAccName,
    {3 => } aotAccOpenDate,
    {4 => } aotAccCurrency
  );

ResourceString
  { Additional expressions may be added on runtime to this query
    For example CurrencyID filter, or ORDER statement
    See BuildAccQuery function for details
  }
  SGetCustomerAccsQuery =
    'SELECT acc.ID, acc.ACC_NO as AccNo, acc.NAME as AccName, acc.OPEN_DAT as OpenDate,'#13#10+
    ' Currency.VAL_NAME as CurrencySName, T.OSTAT as Balance, T.POK_OSTAT as LBalance'#13#10+
    'FROM'#13#10+
    ' Account acc,'#13#10+
    ' AVALUTE Currency,'#13#10+
    ' tenostat t'#13#10+
    'WHERE'#13#10+
    ' (CLOSE_DAT IS NULL)'#13#10+
    ' AND (acc.KLI_ID = :ID)'#13#10+
    ' AND (Currency.VALUTE = acc.VAL_ACC)'#13#10+
    ' AND (T.ACC_ID = acc.ID)'#13#10+
    ' UNION ALL ' +
    'SELECT acc.ID, acc.ACC_NO as AccNo, acc.NAME as AccName, acc.OPEN_DAT as OpenDate,'#13#10+
    ' Currency.VAL_NAME as CurrencySName, T.OSTAT as Balance, T.POK_OSTAT as LBalance'#13#10+
    'FROM'#13#10+
    ' out_Account acc,'#13#10+
    ' AVALUTE Currency,'#13#10+
    ' out_tenostat t'#13#10+
    'WHERE'#13#10+
    ' (CLOSE_DAT IS NULL)'#13#10+
    ' AND (acc.KLI_ID = :ID)'#13#10+
    ' AND (Currency.VALUTE = acc.VAL_ACC)'#13#10+
    ' AND (T.ACC_ID = acc.ID)'#13#10;
  SGetCusQuery =
   'select C.*, C.rowid, decode(c.cust_type,null,'+''''+'huquqi'+''''+', 1, '+''''+'fiziki'+''''+', 2, '+''''+'f.s.'+''''+') tip from CUSTOMERS C'#13#10+
   'where CLOSE_DAT IS NULL'#13#10;


