procedure TSimCorp.Hamsnse1Click(Sender: TObject);
begin
with MainGrid, SelectedRows, DataSource.DataSet do
  begin
    DisableControls;
    try
      First;
      while not Eof do
       begin
        CurrentRowSelected := True;
        Next;
       end;
    finally
      EnableControls;
    end;
  end;
end;

