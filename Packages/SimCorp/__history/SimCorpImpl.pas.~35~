begin
with OracleDataSet1 do begin
    if RadioGrpCont.ItemIndex=1 then
    begin
      Close;
      SQL[1]:='';
      SQL[1]:=' and typ=0' ;
      Open;
    end;
    if RadioGrpCont.ItemIndex=2 then
    begin
      Close;
      SQL[1]:='';
      SQL[1]:=' and typ=1' ;
      Open;
    end;
    if RadioGrpCont.ItemIndex=0 then
    begin
      Close;
      SQL[1]:='';
      Open;
    end;
end;
end;

