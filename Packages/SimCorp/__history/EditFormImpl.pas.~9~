{$R *.dfm}
  uses sboapiDataModuleImpl,SimCorpImpl;
procedure TEditForm.BitBtn1Click(Sender: TObject);
begin
  with SimCorp do
  begin
  if  OracleDataSet1.FieldByName('status').AsInteger=1 then
  begin
  ShowMessage('Bu əməliyatı dəyişmək olmaz !)');
  exit;
  end;

   OraclePackage1.CallProcedure('edit_arxive',
     ['p_id' ,OracleDataSet1.FieldByName('id').AsInteger,
      'p_debitacc',CMSearchEditLoacAccs.Text,
      'p_kreditacc',CMSearchEdit1.Text,
      'p_debitamount',CurrencyEdit1.Value,
      'p_kreditamount',CurrencyEdit2.Value,
      'p_lamount',CurrencyEdit3.Value,
      'p_description',Edit1.Text,
      'p_type',OracleDataSet1.FieldByName('typ').AsInteger]);

      OracleDataSet1.Refresh;
  end;
   close;
end;

