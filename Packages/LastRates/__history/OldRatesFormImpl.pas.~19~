procedure TFrmOldCourses.ActiveFormCreate(Sender: TObject);
begin
  SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);

  DTP_BEG.DateTime :=OraclePackage.CallDateFunction('Get_Date',[]);
  DTP_END.DateTime :=OraclePackage.CallDateFunction('Get_Date',[]);

 ODSCourses.open;
