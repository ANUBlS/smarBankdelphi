  object ODSCourses: TOracleDataSet
    SQL.Strings = (
      'Select '
      '    O.val_kod,'
      '    O.ostat,'
      '    O.dat,'
      '    A.val_name '
      'From '
      '   Operkurs O,'
      '   Avalute A'
      'Where O.val_kod=A.valute and o.dat between :beg_dat and :end_dat'
      'Order by :Title_Order')
