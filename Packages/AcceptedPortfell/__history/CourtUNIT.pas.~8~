implementation

uses Datamodunit;

{$R *.dfm}

procedure TCourtFrm.Button1Click(Sender: TObject);
begin

DataMod.Maincrpt_one.Insert;
DataMod.Maincrpt_one.FieldByName('id').AsFloat:=  DataMod.maincrprt.FieldByName('prtid').AsFloat;
end;

procedure TCourtFrm.Button2Click(Sender: TObject);
begin
DataMod.Data_main_one.Edit;
end;

procedure TCourtFrm.Button3Click(Sender: TObject);
begin
close;
end;

procedure TCourtFrm.Button4Click(Sender: TObject);
begin
  DataMod.Maincrpt_one.Edit;
  DataMod.Maincrpt_one.FieldByName('id').AsFloat:=  DataMod.maincrprt.FieldByName('prtid').AsFloat;
  DataMod.Maincrpt_one.FieldByName('COURT_AMMOUNT').AsString:=DBEdit1.Text;
    DataMod.Maincrpt_one.FieldByName('COURT_STATUS').AsString:=            DBEdit2.Text;
   DataMod.Maincrpt_one.FieldByName('COURT_LASTSTAT').AsString:=         DBEdit3.Text;
   DataMod.Maincrpt_one.FieldByName('COURT_NAME').AsString:= DBEdit4.Text;
     DataMod.Maincrpt_one.FieldByName('COURT_DATE_NUM').AsString:=DBEdit5.Text;
     DataMod.Maincrpt_one.FieldByName('COURT_MEASURE').AsString:=DBEdit6.Text;
     DataMod.Maincrpt_one.FieldByName('COURT_REPLACE').AsString:=DBEdit7.Text;
     DataMod.Maincrpt_one.FieldByName('REPLACEMENT_COUNT').AsString:=DBEdit8.Text;
     DataMod.Maincrpt_one.FieldByName('INVESTIGATION_ORG').AsString:= DBEdit9.Text;
     DataMod.Maincrpt_one.FieldByName('COURT_DESC').AsString:=DBRichEdit1.Text;
      DataMod.Maincrpt_one.FieldByName('INFOS').AsString:= DBRichEdit2.Text;


      DataMod.Maincrpt_one.Post;
end;

procedure TCourtFrm.FormShow(Sender: TObject);
begin
DataMod.Maincrpt_one.Close;
DataMod.Maincrpt_one.SetVariable('prts',DataMod.maincrprt.FieldByName('prtid').AsFloat);
DataMod.Maincrpt_one.Open;

end;

end.
