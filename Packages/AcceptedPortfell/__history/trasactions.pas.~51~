procedure TTransacfrm.Button1Click(Sender: TObject);
var v_type :integer;
v_cash :integer;
begin


  if perc.Text='0' then
    v_type:=2;
  if main.Text='0' then
     v_type:=1 ;
  if (perc.Text<>'0') and (main.Text<>'0') then
     v_type:=3 ;
  if (perc.Text='0') and (main.Text='0') then
      v_type:=4 ;


     if RadioButton1.Checked then
     v_cash:=1
     else
     v_cash:=2;


DataMod.OraclePackage1.CallProcedure('add_transaction',[DataMod.maincrprt.FieldByName('prtid').Asstring,v_type,DBLookupComboBox2.KeyValue,
DBLookupComboBox1.KeyValue,main.Text,perc.Text,Description.Text,DBLookupComboBox3.KeyValue,DataMod.mainloanacc.FieldByName('val_acc').AsInteger,
DBLookupComboboxEh1.KeyValue,memo4.Text,service.Text,DBLookupComboBox5.KeyValue]);

ShowMessage('Ödəniş uğurla yaradıldı...');
datamod.maincrprt.refresh;
 close;

end;

