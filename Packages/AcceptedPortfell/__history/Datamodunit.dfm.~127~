  object main_araryis: TOracleDataSet
    SQL.Strings = (
      
        'select prtid,borrower_name,(select types from accepted_borrow_ty' +
        'pes where id=v.borrow_type   ) nov,akt1,akt1_date,akt2,akt2_date' +
        ','
      'case when restrukesas<>0 then'
      
        '(select sum(restrukesas)+sum(aznesas) from accepted_cr_portfels ' +
        'where borrower_name=v.borrower_name )'
      ''
      'else'
      
        '(select sum(aznesas)+sum(restrukesas) from accepted_cr_portfels ' +
        'where borrower_name=v.borrower_name )'
      'end as aznesascem,'
      ''
      ''
      'case when aznesas=0 then'
      ' restrukesas'
      'else'
      'aznesas'
      'end as aznesas,'
      ''
      ''
      'case when aznfaiz=0 then'
      ' restrukfaiz'
      'else'
      'aznfaiz'
      'end as aznfaiz'
      ' ,'
      ' case when restrukfaiz<>0 then'
      
        '(select sum(restrukfaiz)+sum(aznfaiz) from accepted_cr_portfels ' +
        'where borrower_name=v.borrower_name )'
      'else'
      
        '(select sum(aznfaiz)+sum(restrukfaiz) from accepted_cr_portfels ' +
        'where borrower_name=v.borrower_name )'
      'end as aznfaizcem  ,'
      
        'usdesas, (select sum(usdesas) from accepted_cr_portfels where bo' +
        'rrower_name=v.borrower_name ) usdesascem,'
      
        'usdfaiz, (select sum(usdfaiz) from accepted_cr_portfels where bo' +
        'rrower_name=v.borrower_name ) usdfaizcem,'
      
        'euresas ,(select sum(euresas) from accepted_cr_portfels where bo' +
        'rrower_name=v.borrower_name ) euresascem,'
      
        'eurfaiz,(select sum(eurfaiz) from accepted_cr_portfels where bor' +
        'rower_name=v.borrower_name ) eurfaizcem,'
      
        'ruresas,(select sum(ruresas) from accepted_cr_portfels where bor' +
        'rower_name=v.borrower_name ) ruresascem,'
      
        'rurfaiz, (select sum(rurfaiz) from accepted_cr_portfels where bo' +
        'rrower_name=v.borrower_name ) rurfaizcem,'
      
        'gelesas ,(select sum(gelesas) from accepted_cr_portfels where bo' +
        'rrower_name=v.borrower_name ) gelesascem,'
      
        'gelfaiz,(select sum(gelfaiz) from accepted_cr_portfels where bor' +
        'rower_name=v.borrower_name ) gelfaizcem,'
      
        'gbpesas ,(select sum(gbpesas) from accepted_cr_portfels where bo' +
        'rrower_name=v.borrower_name ) gbpesascem,'
      
        'gbpfaiz,(select sum(gbpfaiz) from accepted_cr_portfels where bor' +
        'rower_name=v.borrower_name ) gbpfaizcem,'
      
        'odenisesas,(select sum(odenisesas) from accepted_cr_portfels whe' +
        're borrower_name=v.borrower_name and accepted_valute=0) odenises' +
        'asazncem,'
      
        'odenisfaiz, (select sum(odenisfaiz) from accepted_cr_portfels wh' +
        'ere borrower_name=v.borrower_name and accepted_valute=0) odenisf' +
        'aizazncem,'
      
        '(select sum(odenisesas) from accepted_cr_portfels where borrower' +
        '_name=v.borrower_name and accepted_valute=1) odenisesasusdcem,'
      
        ' (select sum(odenisfaiz) from accepted_cr_portfels where borrowe' +
        'r_name=v.borrower_name and accepted_valute=1) odenisfaizusdcem,'
      
        ' (select sum(odenisesas) from accepted_cr_portfels where borrowe' +
        'r_name=v.borrower_name and accepted_valute=45) odenisesaseurcem,'
      
        ' (select sum(odenisfaiz) from accepted_cr_portfels where borrowe' +
        'r_name=v.borrower_name and accepted_valute=5) odenisfaizeurcem,'
      
        '(select sum(odenisesas) from accepted_cr_portfels where borrower' +
        '_name=v.borrower_name and accepted_valute=48) odenisesasrurcem,'
      
        ' (select sum(odenisfaiz) from accepted_cr_portfels where borrowe' +
        'r_name=v.borrower_name and accepted_valute=48) odenisfaizrurcem,'
      
        '(select sum(odenisesas) from accepted_cr_portfels where borrower' +
        '_name=v.borrower_name and accepted_valute=475) odenisesasgelcem,'
      
        ' (select sum(odenisfaiz) from accepted_cr_portfels where borrowe' +
        'r_name=v.borrower_name and accepted_valute=475) odenisfaizgelcem' +
        ','
      
        '(select sum(odenisesas) from accepted_cr_portfels where borrower' +
        '_name=v.borrower_name and accepted_valute=3) odenisesasdbpcem,'
      
        ' (select sum(odenisfaiz) from accepted_cr_portfels where borrowe' +
        'r_name=v.borrower_name and accepted_valute=3) odenisfaizdbpcem,'
      ''
      
        ' round ((select ostat from operkurs where dat=sbop.get_date and ' +
        'val_kod=1)* '
      
        ' (select sum(usdfaiz) from accepted_cr_portfels where borrower_n' +
        'ame=v.borrower_name )'
      '  +    '
      
        ' (select ostat from operkurs where dat=sbop.get_date and val_kod' +
        '=45)* '
      
        ' (select sum(eurfaiz) from accepted_cr_portfels where borrower_n' +
        'ame=v.borrower_name )'
      ' +'
      
        '  (select ostat from operkurs where dat=sbop.get_date and val_ko' +
        'd=48)* '
      
        ' (select sum(rurfaiz) from accepted_cr_portfels where borrower_n' +
        'ame=v.borrower_name )'
      ' +'
      
        '  (select ostat from operkurs where dat=sbop.get_date and val_ko' +
        'd=475)* '
      
        ' (select sum(gelfaiz) from accepted_cr_portfels where borrower_n' +
        'ame=v.borrower_name )'
