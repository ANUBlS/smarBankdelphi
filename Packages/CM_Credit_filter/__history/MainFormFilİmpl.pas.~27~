procedure TMainForm.Button1Click(Sender: TObject);
begin
CommonDBGrid.DataSource.DataSet.s
ShowMessage(BuildFilterString);
  with CommonDBGrid ,DataSource.DataSet do

  begin
  if CheckBox1.Checked then
   begin
   Filter := '';
    Filtered := False;
    SelectedRows.Clear;
    CommonDBGrid.Visible:=true;
    open;
   end else
   if BuildFilterString<>'' then
    begin
    Filter := BuildFilterString;
    Filtered := False;
    Filtered := True;
    open;
    SelectedRows.Clear;
    if RecordCount=0 then
    begin
     ShowMessage('Heç bir məlumat tapılmadı');
     CommonDBGrid.Visible:=false
    end
      else
      begin
      open;
      CommonDBGrid.Visible:=true ;
      end;
     end;
   end;
end;

procedure TMainForm.Button2Click(Sender: TObject);
begin
with CommonDBGrid, DataSource.DataSet do
  begin
    Filter := '';
    Filtered := False;
    SelectedRows.Clear;
    CommonDBGrid.Visible:=false
  end;
end;

