function TMainForm.BuildFilterString : String;
begin
 Result := '';
 if Kid.Text<>'' then
 Result:=Result+'(id='+Kid.Text+')';
 if Knum.Text<>'' then
 if Result='' then
  Result:=Result+' numberofcredit='+''''+Knum.Text+''''
  else
 Result:=Result+' and numberofcredit='+''''+Knum.Text+'''';

if Mid.Text<>'' then
if Result='' then
Result:=Result+' (BOOROWERID='+Mid.Text+')'
else
  Result:=Result+' and (BOOROWERID='+Mid.Text+')';
 if DBLookupComboboxEh1.Text<>'' then
 if Result='' then
   Result:=Result+'(BOOROWERID='+inttostr(DBLookupComboboxEh1.KeyValue)+')'
   else
  Result:=Result+' and (BOOROWERID='+inttostr(DBLookupComboboxEh1.KeyValue)+')';

if Mkod.Text<>'' then
if Result='' then
Result:=Result+'  passpin='+Mkod.Text
else
  Result:=Result+' and passpin='+Mkod.Text;

end;
