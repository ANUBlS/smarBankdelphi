procedure TBalanceRefEditX.BalanceDataSetCalcFields(DataSet: TDataSet);
begin
  Case BalanceDataSetTYPEID.AsInteger of
    1 : BalanceDataSetTYPEID_NAME.Value:= 'Aktiv';
    2 : BalanceDataSetTYPEID_NAME.Value:= 'Passiv';
    3 : BalanceDataSetTYPEID_NAME.Value:= 'Aktiv-Passiv';
  end;

  Case BalanceDataSetADDITIONALTYPEID.AsInteger of
    1 : BalanceDataSetADDITIONALTYPEID_NAME.Value:= 'Aktiv';
    2 : BalanceDataSetADDITIONALTYPEID_NAME.Value:= 'Passiv';
    3 : BalanceDataSetADDITIONALTYPEID_NAME.Value:= 'Aktiv-Passiv';
  end;

  Case BalanceDataSetRATEDIFFERENCE.AsInteger of
    0 : BalanceDataSetRATEDIFFERENCE_NAME.Value:= 'Hesablanmır';
    1 : BalanceDataSetRATEDIFFERENCE_NAME.Value:= 'Hesablanır';
  end;

  Case BalanceDataSetSALDO.AsInteger of
    0 : BalanceDataSetSALDO_NAME.Value:= 'Nəzərə alınmır';
    1 : BalanceDataSetSALDO_NAME.Value:= 'Nəzərə alınır';
  end;

  // ComboBoxTYPEID_NAME.ItemIndex := BalanceDataSetTYPEID.asinteger-1;
end;


procedure TBalanceRefEditX.BalanceDataSetAfterScroll(DataSet: TDataSet);
begin
   ComboBoxTYPEID_NAME.ItemIndex := BalanceDataSetTYPEID.asinteger-1;
   ComboBoxADDITIONALTYPEID_NAME.ItemIndex := BalanceDataSetADDITIONALTYPEID.asinteger-1;

end;

procedure TBalanceRefEditX.ComboBoxPlanChange(Sender: TObject);
begin
  Case ComboBoxPlan.ItemIndex of
   0: BalanceDataSet.SQL[1]:= 'bal_spr1 b';
   1: BalanceDataSet.SQL[1]:= 'bal_spr2 b';
   2: BalanceDataSet.SQL[1]:= 'bal_spr3 b';
   3: BalanceDataSet.SQL[1]:= 'bal_spr4 b';
   end;
   BalanceDataSet.Close;
   BalanceDataSet.Open;

end;


procedure TBalanceRefEditX.ComboBoxTYPEID_NAMEChange(Sender: TObject);
begin
 BalanceDataSet.Edit;
  BalanceDataSetTYPEID.AsInteger := ComboBoxTYPEID_NAME.ItemIndex+1;

end;

procedure TBalanceRefEditX.ComboBoxADDITIONALTYPEID_NAMEChange(
  Sender: TObject);
begin
 BalanceDataSet.Edit;
  BalanceDataSetADDITIONALTYPEID.AsInteger := ComboBoxADDITIONALTYPEID_NAME.ItemIndex+1;
end;

