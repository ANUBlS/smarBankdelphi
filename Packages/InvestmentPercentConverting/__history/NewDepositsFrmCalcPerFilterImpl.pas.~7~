function TFrmCalcPerFilter.BuildFilterString : String;

  procedure ConcatFilter(var S: String; const Prefix : String; Checked : Boolean; KeyValue : Variant);
  const
     csFormat = '(%s=%s)';
  var
    Temp : String;   
  begin

    if Checked then
    begin
      Temp := Format(csFormat,[Prefix,Keyvalue]);
      if S = '' then
        S := Temp
      else
        S :=S + 'and ' + Temp;
    end;
    
  end;  // Concat Filter

  procedure ConcatFilter2(var S: String; const Prefix : String; Checked : Boolean; KeyValue : Variant);
  const
     csFormat = '(%s=%s)';
  var
    Temp : String;
  begin

    if Checked then
    begin
      Temp := Format(csFormat,[Prefix,Keyvalue]);
      if S = '' then
        S := Temp
      else
        S :=S + ' or ' + Temp;
    end;

  end;  // Concat Filter

var
  Temp : String;
begin

  Result := '';
  Temp := '';
  
  ConcatFilter(Result,'CURRENCY',CBValute.Checked,LCBValute.KeyValue);
  ConcatFilter(Result,'BRANCHID',CBFilial.Checked,LCBFilial.KeyValue);
  ConcatFilter(Result,'PERSONALTYPE',CBPersons.Checked,LCBPersons.KeyValue);
  ConcatFilter(Result,'CLIENTTYPE',CBCategories.Checked,LCBCategories.KeyValue);
  ConcatFilter(Result,'ContractType',CBDepositTypes.Checked,LCBDepositTypes.KeyValue);
  ConcatFilter(Result,'CUSTOMERID',CBCustomer.Checked,LCBCustomer.KeyValue);

  ConcatFilter2(Temp,'STATUS',CheckBox20.Checked,-9);
  ConcatFilter2(Temp,'STATUS',CheckBox21.Checked,-11);
  ConcatFilter2(Temp,'STATUS',CheckBox22.Checked,-10);

  if Temp <> '' then
  if Result <> '' then
    Result := Result + Format(' and (%s)',[Temp])
  else
    Result := Temp;

end;


procedure TFrmCalcPerFilter.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize := False
end;

procedure TFrmCalcPerFilter.FormKeyPress(Sender: TObject; var Key: Char);
begin
   if ord(Key) = VK_ESCAPE then Close;
end;

procedure TFrmCalcPerFilter.Button1Click(Sender: TObject);
begin
   with NewDepositsFrmPercentConverting,calcPerGrid,SelectedRows do
        Clear;

   with NewDepositsDMPercentConverting,CalcedDeposits do
   begin
      Filtered := False;
      Filter := BuildFilterString;
      Filtered := True;
   end;

end;

procedure TFrmCalcPerFilter.Button2Click(Sender: TObject);
begin
   with NewDepositsDMPercentConverting,CalcedDeposits do
   begin
      Filtered := False;
      Filter := '';
   end;

end;

procedure TFrmCalcPerFilter.Button3Click(Sender: TObject);
begin
   Close
end;

end.
