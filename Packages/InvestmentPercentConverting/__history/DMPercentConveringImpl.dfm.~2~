  object CalcedDeposits: TOracleDataSet
    SQL.Strings = (
      'select '
      ' cont.id,'
      ' cont.contractno,'
      
        ' sbcm_stored_programs.Get_ContractAccount(acc.ContractAccID) as ' +
        'ContractAccNo,'
      
        ' sbcm_stored_programs.Get_ContractAccount(acc.InterestAccID) as ' +
        'InterestAccNo,'
      
        ' sbcm_stored_programs.Get_ContractAccountName(acc.contractaccid)' +
        ' as custname,'
      
        ' --sbcm_stored_programs.get_CustomerNameByID(cont.customerid) as' +
        ' custname,'
      ' cstate.facticaldebt,'
      ' cstate.facticalinterestdebt,'
      ' cint.interest,'
      'SBCM_Stored_Programs.CheckContractState(cont.ID) as  Status,'
      'av.val_name,'
      ' cont.currency,'
      ' cont.personaltype,'
      ' cont.clienttype,'
      ' cont.customerid,'
      ' cont.branchid'
      ''
      ''
      'from sbcm_contracts cont,'
      '     sbcm_contract_accounts acc,'
      '     sbcm_contract_state cstate,'
      '     sbcm_deposit_interests cint,'
      '     avalute av'
      'where cont.type# = 3'
      'and acc.id# = cont.id'
      'and cstate.id# = cont.id'
      'and cint.id# = cont.id '
      'and cont.currency = av.valute'
      'and cont.type# = 3'
      'order by :OrderField')
