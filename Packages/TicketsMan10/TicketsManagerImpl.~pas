procedure TTicketsManager.actCommitTicketsExecute(Sender: TObject);
var
  i: Integer;
  msgstr: String;
  F: TIniFile;
begin
  F := TIniFile.Create(ExtractFilePath(paramstr(0))+'tman.ini');
  if DataModuleTicketMan.ODSTicketsSTATUS.AsInteger=5 then
    msgstr := f.ReadString('tm','commithoks','Тикетляр тясдигляндикдян сонра ХЮЩКС-а ямялиййат эеэедяжяк.'+#13#10+'Яминсиниз?')
  else
    msgstr := f.ReadString('tm','committckt','Тикетляр тясдиглянсин?');
  if f.ReadString('tm','commithoks','')='' then
    f.WriteString('tm','commithoks','Тикетляр тясдигляндикдян сонра ХЮЩКС-а ямялиййат эеэедяжяк.'+#13#10+'Яминсиниз?');
  if f.ReadString('tm','committckt','')='' then
    f.WriteString('tm','committckt','Тикетляр тясдиглянсин?');
  if MessageDlg(msgstr,mtConfirmation,[mbYes,mbNo],0)=IDNO then exit;
  with grTickets, SelectedRows, DataSource.DataSet, DataModuleTicketMan, tm_manage do begin
    for i:=0 to Count-1 do begin
      GotoBookmark(TBookmark(Items[i]));
      CallProcedure('committicket',[ODSTicketsID.AsVariant]);
    end;     
    Close;
    Open;
  end;
end;

procedure TTicketsManager.actNewTicketExecute(Sender: TObject);
begin
  with frmNewTicket, DataModuleTicketMan.ODSAllTickets do begin
    edTicketDate.Date := Now;
    if not active then Open;
    Insert;
    ShowModal;
  end;
end;

procedure TTicketsManager.actEditTicketExecute(Sender: TObject);
begin
  with frmNewTicket, DataModuleTicketMan, ODSAllTickets do begin
    if active then close;       
    open;
    Locate('ID',ODSTicketsID.AsVariant,[]);
    Edit;
    ShowModal;
  end;
end;

procedure TTicketsManager.N4DrawItem(Sender: TObject; ACanvas: TCanvas;
  ARect: TRect; Selected: Boolean);
var
  LineBottom: Integer;
  SText: String;
  Bar: TRect;
begin
  with ACanvas, Sender as TMenuItem do
  begin
    with Font do
    begin
      Name := 'Azl Sans Serif';
      Charset := RUSSIAN_CHARSET;
      if Default then
        Style := [fsBold];
    end;
    if Caption = '-' then
    begin
      Pen.Color := clBlack;
      LineBottom := (ARect.Top + (ARect.Bottom - ARect.Top) div 2)-1;
      MoveTo(ARect.Left, LineBottom);
      LineTo(ARect.Right, LineBottom);
      inc(LineBottom);
      Pen.Color := clWhite;
      MoveTo(ARect.Left, LineBottom);
      LineTo(ARect.Right, LineBottom);
    end
    else
    begin
      if Selected then
      begin
        Brush.Color := clNavy;
        if Enabled then
          Font.Color := clWhite
        else
          Font.Color := clSilver;
      end
      else
      begin
        Brush.Color := clBtnFace;
        if Enabled then
          Font.Color := clBlack
        else
          Font.Color := clGrayText;
      end;
      Bar := ARect;
      Inc(Bar.Left, 22);
      FillRect(Bar);
      TextOut(ARect.Left+{17}22, ARect.Top+1, Caption);
    end;
    // draw shortcut
    SText := ShortCutToText(ShortCut);
    TextOut(ARect.Right-TextWidth(SText)-2, ARect.Top+1, SText);
    if ImageIndex <> -1 then
      with GetParentMenu do
        if Assigned(Images) then
        begin
          if Checked then
          begin
            Bar.Left := ARect.Left + 1;
            Bar.Right := Bar.Left + 16;
            Bar.Top := ARect.Top + 1;
            Bar.Bottom := Bar.Top + 16;

            ACanvas.Brush.Color := clBtnShadow;
            ACanvas.FrameRect(Bar);

            Inc(Bar.Left, 2);
            Inc(Bar.Right, 2);
            Inc(Bar.Top, 2);
            Inc(Bar.Bottom, 2);
            
            ACanvas.Brush.Color := clBtnHighlight;
            ACanvas.FrameRect(Bar);

            Dec(Bar.Left, 1);
            Dec(Bar.Right, 1);
            Dec(Bar.Top, 1);
            Dec(Bar.Bottom, 1);

            if Selected then
              ACanvas.Brush.Color := clBtnFace
            else
              ACanvas.Brush.Color := clBtnHighlight;
            ACanvas.FillRect(Bar);
          end;

          Images.Draw(ACanvas, ARect.Left, ARect.Top, ImageIndex, Enabled);
        end;
  end;
end;

