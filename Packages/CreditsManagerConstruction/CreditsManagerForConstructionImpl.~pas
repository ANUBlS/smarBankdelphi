procedure TCreditsManagerForConstruction.ActnSearchExecute(Sender: TObject);

var
  SearchField : string;
  SearchOptions : TSearchRecordOptions;
begin
  SearchOptions := [srIgnoreCase ,srPartialMatch];

  with Sender as TEdit  do
  begin
    SearchField := copy(Name,5,length(Name));
    CommonGrid.SelectedRows.Clear;
    with  TOracleDataSet(CommonGrid.DataSource.DataSet) do
    if  not SearchRecord(
                  SearchField
                 ,Text
                 ,SearchOptions + [srFromCurrent , srForward ]
                 ) then
    if MessageDlg(
              'јхтарыш сона чатды '+#13+'давам етм€к ист€йирсинизми?'
             ,mtInformation
             ,[mbNo , mbYes]
             ,0
             ) = mrYes  then
    if  not SearchRecord(
                 SearchField
                ,Text
                ,SearchOptions + [ srFromBeginning ]
                )  then
    MessageDlg('…азы тапылмады!',mtInformation,[mbOK],0);
    CommonGrid.SelectedRows.CurrentRowSelected := True;
