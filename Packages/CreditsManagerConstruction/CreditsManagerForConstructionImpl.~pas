procedure TCreditsManagerForConstruction.ActnFilterExecute(
  Sender: TObject);
  function  CheckFiltred(IsChecked :Boolean;const FilterStr :String;Args :array of const):String;
  begin
     Result :='';
     if  IsChecked  then
      Result :=Format(FilterStr,Args);
  end;

const
    CompanyFilter = '(COMPANYID=%d)';
    BuildingFilter = '(BUILDINGID=%d)';
    FlatsFilter = '(FLATID=%d)';
    FilialFilter = '(Branchid=%d)';
    UsersFilter = '(userid=%d)';
var

  CompanyF :string;
  BuildingF :string;
  FlatsF :string;
  UsersF   :string;
  FilialF   :string;

  FilterStr :string;
begin
  FilterStr :='';

  with  DatModConstruction do
  begin
    CompanyF :=CheckFiltred(
                     CheckBoxCompany.Checked
                    ,CompanyFilter
                    ,[Componies.FieldByName('ID').AsInteger]
                    );
    BuildingF :=CheckFiltred(
                     CheckBoxBuilding.Checked
                    ,BuildingFilter
                    ,[buildings.FieldByName('ID').AsInteger]
                    );
    FlatsF :=CheckFiltred(
                     CheckBoxFlats.Checked
                    ,FlatsFilter
                    ,[Flats.FieldByName('ID').AsInteger]
                    );

    UsersF :=CheckFiltred(
                     CheckboxUsers.Checked
                    ,UsersFilter
                    ,[Users.FieldByName('ID').AsInteger]
                    );

    FilialF :=CheckFiltred(
                     CheckBoxFilials.Checked
                    ,FilialFilter
                    ,[Filials.FieldByName('ID').AsInteger]
                    );


    FilterStr :=CompanyF;

    if  BuildingF<>'' then
    if  FilterStr=''  then
      FilterStr :=BuildingF
    else
      FilterStr :=FilterStr + 'AND' + BuildingF;

    if  FlatsF<>'' then
    if  FilterStr=''  then
      FilterStr :=FlatsF
    else
      FilterStr :=FilterStr + 'AND' +FlatsF;

    if  UsersF<>'' then
    if  FilterStr=''  then
      FilterStr :=UsersF
    else
      FilterStr :=FilterStr + 'AND' +UsersF;

    if  FilialF<>'' then
    if  FilterStr=''  then
      FilterStr :=FilialF
    else
      FilterStr :=FilterStr + 'AND' +FilialF;


    end;
  
  with  CommonGrid.DataSource.DataSet  do
  begin
    Filtered :=False;
    Filter :=FilterStr;
    Filtered :=True;
  end;


end;

