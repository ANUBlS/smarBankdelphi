  object flat: TOracleDataSet
    SQL.Strings = (
      
        'select rowid,code,id, bld_id, flatnumber, entrance, ffloor, room' +
        's, area, price1,'
      
        '       pricegen, buyer,userid, CC_general.get_buyername(buyer) a' +
        's Buyer_status from cc_flats'
      'where '
      '--bld_id=:bld_id  and'
      '(buyer is null) or( buyer=0) '
      'order by :title')
