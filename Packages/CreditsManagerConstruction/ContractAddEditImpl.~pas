begin

   with DatModConstruction,CreditPurpose do  begin
         //if State = (dsINSERT) then begin
         FieldByName('opendate').AsDateTime := trunc(DTPOpenDate.DateTime);
         FieldByName('expdate').AsDateTime := trunc(DTPCloseDate.DateTime);
