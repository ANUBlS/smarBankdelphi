  object Credits: TOracleDataSet
    SQL.Strings = (
      'select cont.id,'
      '       cont.contnum as contractno,'
      '       CC_GENERAL.get_BuyerName(cont.buyer) as CustName,'
      '       cont.acc_no as accno,'
      '       cont.opendate,'
      '       cont.expdate as closedate,'
      '       CC_GENERAL.gecikme(cont.id) as gecmeb,'
      '      cont.dueinterestrate'
      '      '
      'from  CC_ACTIVECONTRACTS cont '
      'WHERE  CC_GENERAL.gecgun(cont.id)>0  '
      ''
      ''
      '--order by :title    ')
