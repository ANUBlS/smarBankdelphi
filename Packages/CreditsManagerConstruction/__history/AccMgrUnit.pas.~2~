procedure TAccMgrForm.ButtonCommitClick(Sender: TObject);
var
    DDate :TDateTime;
    customerid    :  integer;
    op_id         :  integer;
    accno         :  string;
    currencyid    :  integer;
    name          :  string;
    open_dat      :  tdatetime;
    balcn         :  integer;
    ownid         :  integer;

begin
  DDate :=Trunc(DTPOpenDate.DateTime);
  customerid:=strtoint(EditCust.Text);
  accno:=EditAcc.Text;
  currencyid:=strtoint(EditValute.text);
  name:=EditAccName.Text;
  open_dat:=Integer(Trunc(DTPOpenDate.date));
  balcn:=strtoint(EditBall.text);
  ownid:=AddEditContractForm.DBLookupComboboxEh6.listSource.Dataset.FieldByName('ID').AsInteger;


  DatModConstruction.sbcm_construction.CallIntegerFunction('add_account',[
                                                        'p_CustID',customerid,
                                                        'p_AccNo', accno,
                                                        'p_Curr',currencyid,
                                                        'p_Name', name,
                                                        'p_OpenDate',open_dat,
                                                        'p_BalCn', balcn,
                                                        'p_OwnID', ownid]);



  with AddEditContractForm do   begin
      with DatModConstruction,Accounts do begin
        Close;
        SetVariable('BID',DBLookupComboboxEh6.ListSource.DataSet.FieldByName('ID').asInteger);
        Open;
      end;
     //  DBLookupComboboxEh2.DataSource.DataSet.FieldByName('LOANACCID').AsInteger := AccID;
    end;
  Close;
end;

