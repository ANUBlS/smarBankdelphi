implementation

{$R *.DFM}
uses DatModConstructionImpl,sboapiDataModuleImpl,PaymentMgrUnit,OrderPaymentRepUnit;

procedure TOrderForm.FormActivate(Sender: TObject);
begin
   DatModConstruction.PaySumDataSet.Close;
   DatModConstruction.PaySumDataSet.SetVariable('TID',DatModConstruction.Credits.FieldByName('ID').AsInteger);
   DatModConstruction.PaySumDataSet.Open;

   DatModConstruction.cc_sum_cols_payments.Close;
   DatModConstruction.cc_sum_cols_payments.SetVariable('SID',DatModConstruction.Credits.FieldByName('ID').AsInteger);
   DatModConstruction.cc_sum_cols_payments.Open;
   Edit2.Text:=DatModConstruction.cc_sum_cols_payments.FieldByName('SUM(PAYAMT)').AsString;
   Edit1.Text:=DatModConstruction.Credits.FieldByName('CREDITAMOUNT').AsString;
   Edit3.Text:=FloatToStr(DatModConstruction.Credits.FieldByName('CREDITAMOUNT').AsFloat-DatModConstruction.cc_sum_cols_payments.FieldByName('SUM(PAYAMT)').AsFloat);

   end;

procedure TOrderForm.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize := False
end;

procedure TOrderForm.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if ord(Key) = VK_ESCAPE Then close
end;

procedure TOrderForm.FormCreate(Sender: TObject);
begin
    OrderPaymentRepForm :=  TOrderPaymentRepForm.Create(Self);
end;

procedure TOrderForm.ActnAddPayExecute(Sender: TObject);
begin
   PaymentAddForm := TPaymentAddForm.Create(Self);
   PaymentAddForm.ShowModal;
   
end;

procedure TOrderForm.ActnDelPayExecute(Sender: TObject);
begin
   if MessageDlg(
       'Ödəniş ləğv olunsun?'
      ,mtWarning
      ,[mbYes,mbNo]
      ,0) = mrYes  then 
  with DatModConstruction,sbcm_construction do
       CallProcedure('deletePayment',
                      ['p_PayID',Payments.FieldByName('ID').AsInteger]);

   Payments.Refresh;                   
end;

procedure TOrderForm.ActnExportExecute(Sender: TObject);
begin
   with Payments do
   begin
      if Active then close;
      SetVariable('CrdID',DatModConstruction.Credits.FieldbyName('ID').AsInteger);
      open;
   end;
   with ozzun do begin
       Connect;
       ExportDataset(Payments,'Ödənişlər özzün',true);
       Disconnect;
   end;
end;

procedure TOrderForm.ActnReportExecute(Sender: TObject);
begin
      with cc_buyer_flats do begin
       ClearVariables;
       CloseAll;
       SetVariable('PayID',Payments.FieldByName('ID').AsInteger);
       Open;
   end;

   with ReportPayOrderData do begin
       ClearVariables;
       CloseAll;
       SetVariable('PayID',Payments.FieldByName('ID').AsInteger);
       Open;
   end;
   AboutBank.open;
   if ReportPayOrderData.RecordCount > 0 then begin

   with OrderPaymentRepForm do  begin
        ReportOrder.Preview;
   end;
   end;
end;

procedure TOrderForm.DBGridEh1DblClick(Sender: TObject);
begin
   ActnReportExecute(Sender)
end;

procedure TOrderForm.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  Cash.close;
  PayData.close;
  SysDat.close;
  Payments.Close;
end;

procedure TOrderForm.FormShow(Sender: TObject);
begin
   Cash.open;
   with PayData do
   begin
      close;
      SetVariable('CrdID',DatModConstruction.Credits.FieldbyName('ID').AsInteger);
      open;
   end;
   SysDat.open;

  with Payments do
   begin
      close;
      SetVariable('CrdID',DatModConstruction.Credits.FieldbyName('ID').AsInteger);
      open;
   end;

end;

end.
