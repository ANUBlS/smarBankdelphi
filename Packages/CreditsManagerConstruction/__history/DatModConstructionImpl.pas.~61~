procedure TDatModConstruction.CreditPurposeCalcFields(DataSet: TDataSet);

begin
   with DataSet do   begin   FieldByName('fullammount').Asfloat:=0;
        FieldByName('PeriodContracts').AsInteger
          :=trunc( sbcm_construction.CallIntegerFunction('GetPeriod',
          ['bdat',FieldByname('opendate').AsDateTime,
           'edat',FieldByname('expdate').AsDateTime ]));
         { FieldByname('expdate').AsDateTime:=sbcm_construction.CallDateFunction('GetFindExpdate',
          ['odat',FieldByname('opendate').AsDateTime,
           'mon',FieldByName('PeriodContracts').AsInteger ]); }

      FieldByName('fullammount').Asfloat:=
      FieldByName('AREA').Asfloat* FieldByName('SQUAREMETRAMOUNT').Asfloat;
    //  showmessage (FloatToStr( FieldByName('PeriodContracts').Asfloat)) ;


   if FieldByName('fullammount').Asfloat > 0 then
  FieldByName('restt').Asfloat:=(FieldByName('AREA').Asfloat-FieldByName('buyarea').Asfloat)*FieldByName('SQUAREMETRAMOUNT').Asfloat;

//  ShowMessage(floattostr((FieldByName('AREA').Asfloat-FieldByName('buyarea').Asfloat)*FieldByName('SQUAREMETRAMOUNT').Asfloat));


  if (FieldByName('INITIALAMOUNT').Asfloat>0) and (FieldByName('pricecred').Asfloat>0) then
  FieldByName('buyarea').Asfloat:=
  FieldByName('INITIALAMOUNT').Asfloat/ FieldByName('pricecred').Asfloat
  else
  FieldByName('buyarea').Asfloat:=0;


   if FieldByName('fullammount').Asfloat > 0 then
  FieldByName('restt').Asfloat:=(FieldByName('AREA').Asfloat-FieldByName('buyarea').Asfloat)*FieldByName('SQUAREMETRAMOUNT').Asfloat;

  if FieldByName('PeriodContracts').Asfloat>0 then
  begin

  FieldByName('monthspay').AsFloat:=
  FieldByName('restt').AsFloat/FieldByName('PeriodContracts').AsFloat;
  end
    else
     FieldByName('monthspay').Asfloat:=0;

end;

end;

