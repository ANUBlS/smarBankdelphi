   BldeditDataSet.close    ;
   entranceDataSet.CloseAll
end;

procedure TDatModConstruction.CreditPurposeApplyRecord(
  Sender: TOracleDataSet; Action: Char; var Applied: Boolean;
  var NewRowId: String);
var
      ContNum :String;
      Buyer:Integer;
      AccID : Integer;
      BranchID:Integer;
      contcur,FlatID :Integer;
      ContAmount:Real;
      opendate:TDATETIme;
      ExpDate :TDATETIme;
      closedate:TDATETIme;
      interestrate:integer;
      InitialAmount:Real;
      DUEINTERESTRATE :Real;
      Result: integer;
      SQUAREMETRAMOUNT :Real;
      note: integer;
      monthpay :Real;

begin
   Result :=0;
      with Sender do
      begin
      ContNum:= FieldByName('ContNum').AsString;
      Buyer:= FieldByName('Buyer').Asinteger;
      AccID:= FieldByName('AccID').Asinteger;
      BranchID:= FieldByName('BranchID').Asinteger;
      FlatID:=FieldByName('FlatID').Asinteger;
      contcur:=FieldByName('contcur').Asinteger;
      ContAmount:=FieldByName('ContAmount').AsFloat;
      opendate:= FieldByName('opendate').asdatetime;
      ExpDate:= FieldByName('ExpDate').asdatetime;
      closedate:= FieldByName('closedate').asdatetime;
      interestrate:= FieldByName('interestrate').asinteger;
      InitialAmount:=FieldByName('InitialAmount').AsFloat;
      DUEINTERESTRATE :=FieldByName('DUEINTERESTRATE').AsFloat;
      SQUAREMETRAMOUNT :=FieldByName('SQUAREMETRAMOUNT').AsFloat;
      note:=FieldByName('Note').AsInteger;
      monthpay:=FieldByName('monthspay').AsFloat;

      end;

      case Action of
          'I':Begin
             with sbcm_construction do
             Result := CallIntegerFunction('add_Contract',[
                            'p_ContNum',ContNum,
                            'p_Buyer',Buyer,
                            'p_AccID',AccID,
                            'p_BranchID',BranchID,
                            'p_FlatID',FlatID,
                            'p_contcur',contcur,
                            'p_ContAmount',ContAmount,
                            'p_opendate',opendate,
                            'p_ExpDate',ExpDate,
                            'p_closedate',closedate,
                            'p_interestrate',0,
                            'p_InitialAmount',InitialAmount,
                            'p_DUEINTERESTRATE',DUEINTERESTRATE,
                            'p_SQUAREMETRAMOUNT',SQUAREMETRAMOUNT,
                            'p_note',note,
                            'p_monthpay',monthpay
                            ]);
        Applied := True;
       end;
       'U':begin
              with sbcm_construction do
             Result := CallIntegerFunction('upd_Contracts',[
                            'p_ID',Credits.FieldByName('ID').AsInteger,
                            'p_ContNum',ContNum,
                            'p_Buyer',Buyer,
                            'p_AccID',AccID,
                            'p_BranchID',BranchID,
                            'p_FlatID',FlatID,
                            'p_contcur',contcur,
                            'p_ContAmount',ContAmount,
                            'p_opendate',opendate,
                            'p_ExpDate',ExpDate,
                            'p_closedate',closedate,
                            'p_interestrate',0,
                            'p_InitialAmount',InitialAmount,
                            'p_DUEINTERESTRATE',DUEINTERESTRATE  ,
                            'p_SQUAREMETRAMOUNT',SQUAREMETRAMOUNT,
                            'p_note',note,
                            'p_monthpay',monthpay
                            ]);
        Applied := True;
      end;
end;
  end;
