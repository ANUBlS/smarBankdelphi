       Open;
   end;
   Customers.Open;
  // CreditPurpose.Open;
   Valutes.Open;
   Filials.Open;
   with Accounts do begin
      //  SetVariable('val',0);
        SetVariable('BID',0);
        Open;
   end;
  // pledgetypes.Open;
