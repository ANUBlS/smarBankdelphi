procedure TPaymentDecree.CleanUp;
var
  CompCount: word;
begin
 for CompCount :=0 to ComponentCount-1 do
  if(Components[CompCount] is TEdit) then
     (Components[CompCount] as TEdit).Text :=''
  else
   if(Components[CompCount] is TComboBox) then
      (Components[CompCount] as TComboBox).Text :=''
end;

procedure TPaymentDecree.PustToCombo(DataSet: TOracleDataSet; Field: String; ComboBox: TComboBox);
begin
 if DataSet.Active=false then DataSet.Open;
  DataSet.First;
   ComboBox.Items.Clear;
    while not(DataSet.Eof) do
     begin
      ComboBox.Items.Add(DataSet. FieldByName(Field).AsString);
      DataSet.Next;
     end;
end;

procedure TPaymentDecree.PustToComboID(DataSet :TOracleDataSet; Field,IDfield :String; ComboBox :TComboBox);
var
   RateIndex :Integer;
begin
 RateIndex :=0;
 if DataSet. Active=false then DataSet.Open;
  DataSet.First;
   SetLength(Rate,DataSet.RecordCount);
   ComboBox.Items.Clear;
    while not(DataSet.Eof) do
     begin
      ComboBox.Items.Add(DataSet. FieldByName(Field).AsString);
      Rate[RateIndex] :=DataSet. FieldByName(IDfield).AsInteger;
      DataSet.Next;
      Inc(RateIndex);
     end;
end;
procedure TPaymentDecree.PustToComboKOD(DataSet :TOracleDataSet; Field,IDfield :String; ComboBox :TComboBox);
var
   RateIndex1 :Integer;
begin
 RateIndex1 :=0;
 if DataSet. Active=false then DataSet.Open;
  DataSet.First;
   SetLength(Rate1,DataSet.RecordCount);
   ComboBox.Items.Clear;
    while not(DataSet.Eof) do
     begin
      ComboBox.Items.Add(DataSet. FieldByName(Field).AsString);
      Rate1[RateIndex1] :=DataSet. FieldByName(IDfield).AsInteger;
      DataSet.Next;
      Inc(RateIndex1);
     end;
end;


procedure TPaymentDecree.ActiveFormCreate(Sender: TObject);
begin
 PaymentDecree :=Self;

 PaymentDataMod :=TPaymentDataMod.Create(Self);
 QRMainReport :=TQRMainReport.Create(Self);
 QRCommonReport :=TQRCommonReport.Create(Self); 

 with PaymentDataMod do
  begin
   ODSAccounts.Open;
   ODSBankInfo.Open;
   ODSBankM.Open;
   PaymentDecree.PustToComboID(ODSBankM,'NAME','ID',CBKBName);
   PaymentDecree.PustToComboKod(ODSBankInfo,'BANK','KOD_B',DBName);
   PaymentDecree.PustToCombo(ODSAccounts,'ACC_NO',CBDANum);
   DTPayment.DateTime :=OPPayment.CallDateFunction('GetCurrentDate',[]);
   CheckBox.Checked :=OPPayment.CallBooleanFunction('isAccountDetails',[]);
  end;
    SBTranslateProc.TranslateAllComponents(Self, sboapiDataModule.OrPack_SL);
end;

procedure TPaymentDecree.CBDANumChange(Sender: TObject);
begin
 with PaymentDataMod.ODSAccounts do
  begin
   Close;
    SQL.Clear;
    SQL.Text :='Select AC.*,C.Inn From Account AC,Customers C Where AC.kli_ID =C.ID and AC.acc_no= '+''''+CBDANum.Text+'''';
   Open;
   EDAName.Text :=FieldByName('NAME').AsString;
   EDAInn.Text :=FieldByName('INN').AsString;
  end;
end;

procedure TPaymentDecree.CBKBNameChange(Sender: TObject);
begin
 EKBCod.Text :='';
 EKBInn.Text :='';
 EKBCorAcc.Text :='';
 EKBSwift.Text :='';
 try
  with PaymentDataMod.ODSBankM do
   begin
    Close;
     SQL. Clear;
     SQL.Text :='Select * From BankM Where ID= '+IntToStr(Rate[CBKBName.ItemIndex]);
    Open;
    EKBCod.Text :=FieldByName('BANKCODE').AsString;
    EKBInn.Text :=FieldByName('INN').AsString;
    EKBCorAcc.Text :=FieldByName('KRNO').AsString;
    EKBSwift.Text :=FieldByName('SWIFT').AsString;
   end;
 finally
    with PaymentDataMod.ODSBankM do
    begin
     Close;
      SQL. Clear;
      SQL.Text :='Select * From BankM ';
     Open;
    end;
 end;
end;

