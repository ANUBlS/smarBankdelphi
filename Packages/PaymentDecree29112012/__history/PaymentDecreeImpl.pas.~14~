procedure TPaymentDecree.CheckBoxClick(Sender: TObject);
begin
 PaymentDataMod.OPPayment.CallProcedure('SetNewDetails',[Word((Sender as TCheckBox).Checked)]);
 case (Sender as TCheckBox).Checked of
  true :begin
         with QRMainReport, QRCommonReport do
          begin
           QRDBACCNAME1.DataField :='DACCNAME';
           QRDBACCNAME2.DataField :='DACCNAME';
           QRDBACCINN1.DataField :='DACCINN';
           QRDBACCINN2.DataField :='DACCINN';
           QRDBACCNAME.DataField :='DACCNAME';
           QRDBACCINN.DataField :='DACCINN';
          end;
        end;
  false :begin
          with QRMainReport, QRCommonReport do
           begin
            QRDBACCNAME1.DataField :='DBNAME';
            QRDBACCNAME2.DataField :='DBNAME';
            QRDBACCINN1.DataField :='DBINN';
            QRDBACCINN2.DataField :='DBINN';
            QRDBACCNAME.DataField :='DBNAME';
            QRDBACCINN.DataField :='DBINN';
           end;
         end;
 end;
end;

