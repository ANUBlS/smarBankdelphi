procedure  TP_CO_Cust_Form.ChechPasp;
var
v_custtype:String;
begin

   if label9.Visible=true then
   begin
   if (RadioButton_Rez.Checked = true) and
    ((EditSerial.Text = '') or (EditPassport.Text = '')) then
  begin

    EditSerial.Color:=clRed;
    EditPassport.Color:=clRed;
    ShowMessage('Pasport məlumatlarını daxil edin!');
    Exit;

  end;
 end
 else
  if label9.Visible=true then
  begin
  if EditPassport.Text = '' then
  begin

    EditPassport.Color:=clRed;
    ShowMessage('Pasport məlumatlarını daxil edin!');
    Exit;
  end
  end
  else
  begin

   EditSerial.Color:=clLime;
   EditPassport.Color:=clLime;
   end;

    with P_Datamodule.Pasp do
    begin
    SetVariable('pNum', EditSerial.Text + EditPassport.Text);
    if not Active then
      Open
    else
      Refresh;
    end;
  case P_Datamodule.Pasp.FieldByName('CUST_TYPE').AsInteger of
  1:v_custtype:='Fiziki';
  3:v_custtype:='Fiziki və sahibkar';
  4:v_custtype:='Nominal';
  end;

  if (AddUpd = true) and (P_Datamodule.Pasp.RecordCount<>0) then
  begin
    EditSerial.Color:=clRed;
    EditPassport.Color:=clRed;
    ShowMessage('Pasport №-si '+P_Datamodule.Pasp.FieldByName('ID').AsString+' ID-li '+
    v_custtype+ ' müştəri üçün qeydiyyatdan keçmişdir!');
    Exit;
  end
  else
  begin
    EditSerial.Color:=clLime;
    EditPassport.Color:=clLime;
  end;

  if (AddUpd = False) and (P_Datamodule.Pasp.RecordCount<>0) and
    (P_Datamodule.Pasp.FieldByName('ID').AsString <> P_Datamodule.P_Customers.FieldByName('ID').AsString) then
  begin
    EditSerial.Color:=clRed;
    EditPassport.Color:=clRed;
    ShowMessage('Pasport №-si '+P_Datamodule.Pasp.FieldByName('ID').AsString+' ID-li '+
    v_custtype+' müştəri üçün qeydiyyatdan keçmişdir!');
    Exit;
  end
  else
  begin
    EditSerial.Color:=clLime;
    EditPassport.Color:=clLime;
  end;


  with P_Datamodule.paspin do
    begin
    SetVariable('pPin', EditPINCode.Text);
    if not Active then
      Open
    else
      Refresh;
    end;
  case P_Datamodule.Paspin.FieldByName('CUST_TYPE').AsInteger of
  1:v_custtype:='Fiziki';
  3:v_custtype:='Fiziki və sahibkar';
  4:v_custtype:='Nominal';
  end;

  if (AddUpd = true) and (P_Datamodule.Paspin.RecordCount<>0) then
  begin

    EditPINCode.Color:=clRed;
    ShowMessage('Pinkod №-si '+P_Datamodule.Paspin.FieldByName('ID').AsString+' ID-li '+
    v_custtype+ ' müştəri üçün qeydiyyatdan keçmişdir!');
    Exit;
  end
  else
  begin

    EditPINCode.Color:=clLime;
  end;

  if (AddUpd = False) and (P_Datamodule.Paspin.RecordCount<>0) and
    (P_Datamodule.Paspin.FieldByName('ID').AsString <> P_Datamodule.P_Customers.FieldByName('ID').AsString) then
  begin

    EditPINCode.Color:=clRed;
    ShowMessage('Pinkod №-si '+P_Datamodule.Paspin.FieldByName('ID').AsString+' ID-li '+
    v_custtype+' müştəri üçün qeydiyyatdan keçmişdir!');
    Exit;
  end
  else
  begin

    EditPINCode.Color:=clLime;
  end;

end;

