function ShowRedMessage(const AText: string): Boolean;
var
  F: TForm;
  L: TLabel;
  BtnYes, BtnNo: TButton;
begin
  F := TForm.Create(nil);
  try
    F.Caption := 'Diqqət!';
    F.Width := 600;
    F.Height := 120;
    F.Position := poScreenCenter;
    F.BorderStyle := bsDialog;

    // --- Qırmızı xəbərdarlıq mətni ---
    L := TLabel.Create(F);
    L.Parent := F;
    L.Caption := AText;
    L.Font.Size := 12;
    L.Font.Color := clRed;
    L.Font.Style := [fsBold];
    L.AutoSize := True;
    L.Left := 30;
    L.Top := 30;

    // --- Bəli düyməsi ---
    BtnYes := TButton.Create(F);
    BtnYes.Parent := F;
    BtnYes.Caption := 'Bəli';
    BtnYes.ModalResult := mrYes;
    BtnYes.Left := 200;
    BtnYes.Top := 70;
    BtnYes.Width := 80;
    BtnYes.Height := 22;

    // --- Xeyr düyməsi ---
    BtnNo := TButton.Create(F);
    BtnNo.Parent := F;
    BtnNo.Caption := 'Xeyr';
    BtnNo.ModalResult := mrNo;
    BtnNo.Left := 300;
    BtnNo.Top := 70;
    BtnNo.Width := 80;
    BtnNo.Height := 22;

    Result := (F.ShowModal = mrYes);
  finally
    F.Free;
  end;
end;


