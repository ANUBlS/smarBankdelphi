{$R *.DFM}

procedure TAdministrationData.UsTablesDataApplyRecord(
  Sender: TOracleDataSet; Action: Char; var Applied: Boolean;
  var NewRowId: String);
begin
 if Action='L' then Applied :=false
  else Applied :=true;
end;

procedure TAdministrationData.UsTablesDataAfterScroll(DataSet: TDataSet);
begin
with AdministrationForm do
 begin
 if not(Assigned(AdministrationForm)) then Exit;
 cbInsert.Enabled:=IntToBool(DataSet.FieldByName('mod_insert').AsInteger);
 cbDelete.Enabled:=IntToBool(DataSet.FieldByName('mod_delete').AsInteger);
 cbUpdate.Enabled:=IntToBool(DataSet.FieldByName('mod_update').AsInteger);
 sbAdvancedGrants.Visible:=IntToBool(DataSet.FieldByName('advanced_grants').AsInteger);
 end;
end;

procedure CenteringObject(ParentObj,ChildObj : TObjRef);
 begin
  if (Assigned(ChildObj))and(Assigned(ParentObj)) then
   with (ChildObj^ as TWinControl) do
    begin
      SetBounds((TWinControl(ParentObj^).Width-Width) div 2,(TWinControl(ParentObj^).Height-Height) div 2,width,height);
      Beep;
    end;
  end;

procedure TAdministrationData.ModPrivsDataAfterScroll(DataSet: TDataSet);
begin
if Assigned (fmModEdit) then
fmModEdit.EnableConstrain(ModPrivsData);
end;

