procedure TFormTranslator.RBtnTranslatedClick(Sender: TObject);
begin
  with OS_SL_Translates do begin
   Filtered:=False;
   if RBtnTranslated.Checked then
    Filter:='(WRD_ENG <>'''+''') and (ID<>1)';
   Filtered:=True;
  end;{with OS_SL_Translates}
end;

procedure TFormTranslator.RBtnUntranslatedClick(Sender: TObject);
begin
 with OS_SL_Translates do begin
   Filtered:=False;
   if RBtnUntranslated.Checked then
    Filter:='(WRD_ENG ='''+''') and (ID<>1)';
   Filtered:=True;
  end;{with OS_SL_Translates}
end;

procedure TFormTranslator.RBtnAllClick(Sender: TObject);
begin
 with OS_SL_Translates do begin
   Filtered:=False;
   if RBtnAll.Checked then
    Filter:='ID<>1';
   Filtered:=True;
  end;{with OS_SL_Translates}
end;

procedure TFormTranslator.RBtnHiddenClick(Sender: TObject);
begin
 with OS_SL_Translates do begin
   Filtered:=False;
   if RBtnHidden.Checked then
    Filter:='ID=1';
   Filtered:=True;
  end;{with OS_SL_Translates}
end;

procedure TFormTranslator.BtnDelUnwishedClick(Sender: TObject);
begin
  OPack_SL.CallProcedure('DeleteUnwishedValues',[]);
  OS_SL_Translates.Refresh;
end;

procedure TFormTranslator.BtnFilterClick(Sender: TObject);
begin
  PanelFilter.Visible :=not PanelFilter.Visible;
end;

procedure TFormTranslator.DBGridSL_TranslatesTitleClick(Column: TColumn);
var
  SQLLine :word;
begin
  SQLLine :=20;
  SQLLine :=OS_SL_Translates.SQL.Add(' order by '+Column.FieldName);
  OS_SL_Translates.Refresh;
  OS_SL_Translates.SQL[SQLLine] :=EmptyStr;
end;

