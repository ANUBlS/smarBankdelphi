package SBDM_Capitalize_new;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  CMVCL50,
  DclEhlib50,
  Ehlib50,
  SBDM_Common_new,
  sboapi50,
  SBTranslate,
  vcl;

contains
  frmAddCapitalizeImpl_new in 'frmAddCapitalizeImpl_new.pas' {frmAddCapitalize_new},
  frmCapitalizeImpl_new in 'frmCapitalizeImpl_new.pas' {frmCapitalize_new};

end.
