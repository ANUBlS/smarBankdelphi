var
  frmCapitalize_new: TfrmCapitalize_new;
   procedure exportproc(S:String);export;
implementation

{$R *.dfm}
   uses sboapiDataModuleImpl,CommonDeclsImpl,frmAddCapitalizeImpl_new,SBTranslateProc;

   procedure exportproc(S:String);export;
var ContractID :Integer;
begin
   ContractID := Get_SelectedContID;

   with frmCapitalize_new do
   begin

   with DepositInfo do
   begin
      if Active then CloseAll;
      SetVariable('ContractID',ContractID);
      Open;
   end;

   with Capitals do
   begin
      if Active then CloseAll;
      SetVariable('ContractID',ContractID);
      Open;
   end;

   Caption := Get_SelectedContNo+' нюмряли депозитин кариталлашдырылмасы';
   ShowModal;

  end;

end;

exports
   exportproc;

end.
