function ExtractDesc(const AString: string): string;
var
  Index: Integer;
begin
  Result := '';
  Index := Pos('desc', AString);
  if Index > 0 then
  begin
    // Extract the substring starting from the 'desc' keyword
    Result := Trim(Copy(AString, Index, Length(AString)));
  end;
end;

