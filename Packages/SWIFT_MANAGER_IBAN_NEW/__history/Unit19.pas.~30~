procedure Tinarchiv.SearchEdit1KeyPress(Sender: TObject; var Key: Char);
begin

  if Key = #13  then
 begin
  SearchOptions := [srIgnoreCase ,srPartialMatch ];

  with Sender as TEdit  do
  begin
    SearchField :='ID';


    with  TOracleDataSet(SWDataModule.ARXIVIN) do
    if  not SearchRecord(
                  SearchField
                 ,Text
                 ,SearchOptions + [srFromCurrent , srForward ]
                 ) then

    if MessageDlg(
              'Axtarış sona çatdı.'+#13+'Əvvəldən başlansın?'
             ,mtInformation
             ,[mbNo , mbYes]
             ,0
             ) = mrYes  then

    if not SearchRecord(
                 SearchField
                ,Text
                ,SearchOptions + [ srFromBeginning ]
                )  then
    MessageDlg('Yazı tapılmadı!',mtInformation,[mbOK],0);
  end;
 end;


end;

