procedure TIn_sett.DBLookupComboBox3CloseUp(Sender: TObject);
begin
with SWDataModule do  begin

     mbacc.CloseAll;
     comm_acc.CloseAll;

     if DBLookupComboBox4.Text='AZN' then
     BEGIN
     mbacc.SetVariable('bal1',1052) ;
   //  mbacc.SetVariable('fil',DBLookupComboBox3.KeyValue);
     comm_acc.SetVariable('BAL2',6404);
     comm_acc.SetVariable('fil',DBLookupComboBox3.KeyValue);
     comm_acc.SetVariable('val',DBLookupComboBox4.KeyValue);

     END
     else
     BEGIN
     mbacc.SetVariable('bal1',1062);
   //  mbacc.SetVariable('fil',DBLookupComboBox3.KeyValue);
     comm_acc.SetVariable('BAL2',6414);
     comm_acc.SetVariable('fil',DBLookupComboBox3.KeyValue);
     comm_acc.SetVariable('val',DBLookupComboBox4.KeyValue);
     END;


       mbacc.OPEN;
       comm_acc.OPEN;

 end;

end;

