procedure TIn_sett.Edit1KeyPress(Sender: TObject; var Key: Char);
begin
if DBLookupComboBox6.Text='' then
begin
ShowMessage('Birinci Valyuta Secilməlidir!!');
edit1.Clear;
end else
begin
IF  Key=#13 THEN
        BEGIN
            with SWDataModule do
              begin
                Main_acc.Close;
                Main_acc.SetVariable('valcode',DBLookupComboBox6.KeyValue);
                Main_acc.SetVariable('bal1',strtoint(edit1.Text));
                Main_acc.Open;
              end;
        END;
end;

end;

