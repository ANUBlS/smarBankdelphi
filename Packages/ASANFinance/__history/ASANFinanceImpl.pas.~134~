procedure TASANFinanceForm.CheckAsan(Fin :String;service:String;url:String);
var    jsonToSend:TStringList;
         http:TIDHttp;
         log :integer;
         JsonToSends: TMemoryStream;
  begin
  log :=0;
     with AsanDm.IdDSet do
     begin
     if Active then
      close;
      open;
      id:=FieldByName('id').AsInteger
     end;
   //  memo3.Lines.Add('id aldi  '+timetostr(now)) ;
   if(service<>'BalanceExp')then
    with AsanDm.LogDSest do
     begin
     if Active then
      close;
       SetVariable(':pin',Fin);
       SetVariable(':service',service);
       SetVariable(':doc',PaspNum.Text);
      open;
      log:=RecordCount;
     end;
 //  memo3.Lines.Add('logu yoxladi  '+timetostr(now)) ;
 if (log>0) and (service<>'Balance') then
  with AsanDm.InsAsanLog do
  begin
  open;
   Insert;
   FieldByName('id').AsInteger:=id;
   FieldByName('pin').AsString:=Fin;
   FieldByName('service').AsString:=service;
   FieldByName('status').AsString:='duplicate';
   FieldByName('info').AsVariant:=AsanDm.LogDSest.FieldByName('info').AsVariant;
   post;
   close;
   memo1.Text := AsanDm.LogDSest.FieldByName('info').AsVariant;
//  memo3.Lines.Add('Insert eledi  '+timetostr(now)) ;
   end else
begin
try
 Screen.Cursor:= crHourGlass;
    http := TIDHttp.Create(nil);
    IdHTTP1.IOHandler := ssl;
    ssl := ssl.Create(nil);
    http.HandleRedirects := true;
    http.ReadTimeout := 3000;
   http.Request.CustomHeaders.Add('ApiKey:'+AsanDm.BankInfo.FieldByName('fond_reg_no').AsString );
  http.Request.CacheControl:='no-cache';
  http.Request.Connection := 'Keep-Alive';
  http.Request.Pragma:='no-cache';
  http.Request.ContentType := 'application/json; charset=utf-8';
  if Fin='post' then
  begin
 Label46.Caption:='Connecting to Asan...' ;
  JsonToSends := TStringStream.Create(url);
  memo1.Text := http.Post('http://prod.asanfinance.gov.az/api/v1/Info/Expenses',JsonToSends)
  end
   else
 if service='Personalinfo' then
  memo1.Text := http.get('http://prod.asanfinance.gov.az'+url+'PinAndDocNumber?pin='+Fin
  +'&docNumber='+PaspNum.Text)
 else
  memo1.Text := http.get('http://prod.asanfinance.gov.az'+url+Fin);
  Label46.Caption:='Connect to Asan...' ;
  if service<>'Balance' then
  with AsanDm.InsAsanLog do
  begin
   open;
   Insert;
   FieldByName('id').AsInteger:=id;
   FieldByName('pin').AsString:=Fin;
   FieldByName('service').AsString:=service;
   FieldByName('status').AsString:='success';
   FieldByName('info').AsVariant:=memo1.Text;
   FieldByName('DOCNUMBER').AsString:=PaspNum.Text;
   FieldByName('URL').AsString:='http://prod.asanfinance.gov.az'+url+Fin;
   post;
   close;
   end ;
 http.Destroy;
 Screen.Cursor:= crDefault;
  except on E: Exception do
  begin
    http.Destroy;
    Screen.Cursor:= crDefault;
    ShowMessage('Asan Finansa qoşulmada problem var: ' + E.Message);
    exit;
  end;

end;
end;

end;

