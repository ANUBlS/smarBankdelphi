procedure TASANFinanceForm.Button2Click(Sender: TObject);
var
  s1: string;
  LJsonObj,LJsonObjs: TJSONObject;
  respons: TJSONArray;
   Fs : TFileStream;
  S : AnsiString;
  FileName : String;
  f : TFileStream;
  graphic : TOleGraphic;
  status,i:integer;
begin
   i:=0;
 if (PIN.Text='') or (PaspNum.Text='') then
  begin
    ShowMessage('Finkodu və ya Serya No daxil edin!');
    exit;
  end;
 memo3.Lines.Add('Bashladi  '+timetostr(now)) ;
 CheckAsan(PIN.Text,'Personalinfo','/api/v1/PersonalInfo/');
 memo3.Lines.Add('Begin parsing  '+timetostr(now)) ;
  s1 := Memo1.Text;
  LJsonObj := TJSONObject.ParseJSONValue(TEncoding.UTF8.GetBytes(s1), 0) as TJSONObject;

  LJsonObjs :=TJSONObject(TJSONArray(LJsonObj.Get('Status').JsonValue));
  status:=strtoint(TJSONPair(LJsonObjs.Get('Code')).JsonValue.Value);
  if status<>0 then
  begin
   ShowMessage(TJSONPair(LJsonObjs.Get('Message')).JsonValue.Value);
   exit;
  end;
  try
    try
     LJsonObj :=TJSONObject(TJSONArray(LJsonObj.Get('Response').JsonValue));
    for i :=0 to ComponentCount-1  do
      begin
       if (Components[i].ClassType = TEdit) and ((Components[i] as TEdit).Tag=20) then

         (Components[i] as TEdit).Text:=TJSONPair(LJsonObj.Get((Components[i] as TEdit).name)).JsonValue.Value

     end;

      except on E: Exception do
  begin
   ShowMessage('Pinkod yanlışdır! '+ E.Message);
   exit;
  end;
      end ;
  memo3.Lines.Add('end parsing  '+timetostr(now)) ;
  FileName := ExtractFilePath(ParamStr(0)) + 'image.jpg';
  Fs := TFileStream.Create(FileName, fmCreate);
  Memo2.Text:=TJSONPair(LJsonObj.Get('Image')).JsonValue.Value;
  S := DecodeString( Trim(Memo2.Text) );
  Fs.Write(S[1], Length(S));
   Image1.Picture := nil;
   memo3.Lines.Add('sekil  '+timetostr(now)) ;
  finally
      FreeAndNil(Fs);

    LJsonObj.Free;
  end;
     graphic := TOleGraphic.Create;
    f := TFileStream.Create (FileName, fmOpenRead or fmShareDenyNone);
    try
      graphic.LoadFromStream(f);
      Image1.Picture.Assign(graphic);
    finally
      f.Free
    end;
end;

