unit ReportSettingImpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, CheckLst, Evanescence, ExtCtrls;

type
  TFrmRepSetting = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    Button1: TButton;
    Even: TEvanescence;
    challValute: TButton;
    unchallValute: TButton;
    Button2: TButton;
    procedure Button1Click(Sender: TObject);
    procedure challValuteClick(Sender: TObject);
    procedure unchallValuteClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FrmRepSetting: TFrmRepSetting;

implementation

uses DmBudcetImpl, ProgresImpl,ReportImpl;

{$R *.dfm}

procedure TFrmRepSetting.Button1Click(Sender: TObject);
begin
  DmBudcet.PackgSubdiv.CallProcedure('fakt_updateay',[]);
  s:=1;
  close;
end;

procedure TFrmRepSetting.challValuteClick(Sender: TObject);
begin
Even.CheckAll;
end;

procedure TFrmRepSetting.FormCreate(Sender: TObject);
var
i:integer;
begin
  for i := 0 to ComponentCount - 1 do
    if Components[i].Tag = 3112 then begin
      (Components[i] as TEvanescence).Open;
      (Components[i] as TEvanescence).CheckAll;
    end;

end;

procedure TFrmRepSetting.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if ORD(Key) = VK_ESCAPE then
    Close else
end;

procedure TFrmRepSetting.unchallValuteClick(Sender: TObject);
begin
 Even.UncheckAll;
end;

end.
