       'Faktiki məbləğ rüblük proqnoz məbləğindən çox ola bilməz! !') ;
        if Copy(E.Message,0,12)='ORA-20009: a' then
       ShowMessage('Faktiki məbləğ: '+Copy(E.Message,15,strtoint(Copy(E.Message,13,2)))+#13+
       'Faktiki məbləğ aylıq proqnoz məbləğindən çox ola bilməz! !') ;

       if Copy(E.Message,0,9)<>'ORA-20009' then
       ShowMessage(E.Message);
    DmBudcet.OracleDataSet1.Edit;
    DmBudcet.OracleDataSet3.edit;
    Abort;
     raise;
    end;


 end;
close ;
