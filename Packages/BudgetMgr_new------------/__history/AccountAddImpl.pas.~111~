procedure TAccountAddFrm.BitBtn1Click(Sender: TObject);
var
n,str :string;
begin
 try
 if DmBudcet.OracleDataSet1.FieldByName('BALANS').IsNull then
 if not DmBudcet.OracleDataSet1.FieldByName('DNTACCOUNT').IsNull then
 begin
   ShowMessage('Balans hesaları olmadan iştrak etməyən hesabları sazlamaq olmaz!');
   exit;
 end;

  DmBudcet.OracleDataSet3.post;
  str:=DmBudcet.PackgSubdiv.CallStringFunction('get_control',['p_id',pid,'cust_ids',DBMemo1.Text,'p_status',1])   ;
if str<>'' then
begin
 with DmBudcet.OracleDataSet4 do
  begin
   if active then close;
   SetVariable('id',pid);
   open;
   n:=FieldByName('name').AsString;
  end;
 ShowMessage('Bu maddəyə ancaq '+n +' balans hesabları sazlana bilər!'+#13+ str+'  Bu balans hesabları düzgün deyil');
 // DmBudcet.OracleDataSet1.FieldByName('BALANS').AsString:='';
   DmBudcet.OracleDataSet3.edit;
   str:='';
  exit;
  end;
 str:=DmBudcet.PackgSubdiv.CallStringFunction('get_control',['p_id',pid,'cust_ids',DBMemo2.Text,'p_status',2])   ;
if str<>'' then
begin
 with DmBudcet.OracleDataSet4 do
  begin
   if active then close;
   SetVariable('id',pid);
   open;
   n:=FieldByName('name').AsString;
  end;
 ShowMessage('Bu maddəyə ancaq '+n +'  hesablar sazlana bilər!'+#13+str+'  Bu hesablar düzgün deyil və ya maddənin statusuna uyğun deyil!');
   DmBudcet.OracleDataSet3.edit;
   str:='';
  exit;
  end;

  str:=DmBudcet.PackgSubdiv.CallStringFunction('get_control',['p_id',pid,'cust_ids',DBMemo2.Text,'p_status',3,'p_bal',DBMemo1.Text])   ;
if str<>'' then
begin
 ShowMessage(str+'  Bu hesab vəya hesablar artıq balans hesabı kimi daxil edilib!');
   DmBudcet.OracleDataSet3.edit;
   str:='';
  exit;
  end;

  str:=DmBudcet.PackgSubdiv.CallStringFunction('get_control',['p_id',pid,'cust_ids',DBMemo3.Text,'p_status',4,'p_bal',DBMemo1.Text])   ;
if str<>'' then
begin
with DmBudcet.OracleDataSet4 do
  begin
   if active then close;
   SetVariable('id',pid);
   open;
   n:=FieldByName('name').AsString;
  end;
 ShowMessage('Bu maddəyə ancaq '+n +'  hesablar sazlana bilər!'+#13+str+'  Bu hesab yanlışdır vəya balans hesabı kimi daxil edilibməyib !');
   DmBudcet.OracleDataSet3.edit;
   str:='';
  exit;
  end;

  DmBudcet.PackgSubdiv.CallProcedure('fakt_rest',['p_id',pid,'bal_cns',DBMemo1.Text,'accno',DBMemo2.Text,'daccno',DBMemo3.Text]);
  DmBudcet.OracleDataSet1.post;
 except
    on E: Exception do
    begin
    //AccountAddFrm.Edit3.Text:=Copy(E.Message,0,12);
     // ShowMessage((Copy(E.Message,13,2)));
       if Copy(E.Message,0,12)='ORA-20009: y' then
       ShowMessage('Faktiki məbləğ: '+Copy(E.Message,15,strtoint(Copy(E.Message,13,2)))+#13+
       'Faktiki məbləğ illik proqnoz məbləğindən çox ola bilməz! !') ;
       if Copy(E.Message,0,12)='ORA-20009: h' then
       ShowMessage('Faktiki məbləğ: '+Copy(E.Message,15,strtoint(Copy(E.Message,13,2)))+#13+
       'Faktiki məbləğ yarım illik proqnoz məbləğindən çox ola bilməz! !') ;
