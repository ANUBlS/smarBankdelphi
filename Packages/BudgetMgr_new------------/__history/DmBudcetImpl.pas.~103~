procedure TDmBudcet.BalSetPostError(DataSet: TDataSet; E: EDatabaseError;
  var Action: TDataAction);
begin
if (E is EDatabaseError) then
  if Copy(E.Message,0,12)='ORA-20009: b' then
       ShowMessage(Copy(E.Message,13,6)+'-Bu balans hesabı düzgün deyil!')
       else
       ShowMessage(e.Message);
       Abort;
end;

procedure TDmBudcet.DataModuleCreate(Sender: TObject);
begin
StructurDSet.Open;
StatusDSet.Open;
OracleDataSet5.Open ;
OracleDataSet8.Open
end;

procedure TDmBudcet.DataModuleDestroy(Sender: TObject);
begin
StructurDSet.CloseAll;
StatusDSet.CloseAll;
OracleDataSet5.CloseAll;
end;

procedure TDmBudcet.MaddeDSetApplyRecord(Sender: TOracleDataSet; Action: Char;
  var Applied: Boolean; var NewRowId: string);

begin
//  ShowMessage('sdas');
  with MaddeDSet do
    begin
       id:= FieldbyName('id').asinteger;
       pname := FieldbyName('name').AsString;
       pstatus:= FieldbyName('status').Asinteger;
       pcode:= FieldbyName('code').AsString;
    end;
     Applied := true;
  case Action of
      'I':  PackgSubdiv.CallProcedure('madde_add',['p_name',pname,'p_stat',pstatus,'p_cod',pcode]);
      'U':  PackgSubdiv.CallProcedure('madde_edit',['p_id',id,'p_name',pname,'p_stat',pstatus,'p_cod',pcode]);
      'D': begin
       PackgSubdiv.CallProcedure('madde_del',['p_id',id]);
       st:=2;
      end;
       else  Applied := false
  end ;

end;

