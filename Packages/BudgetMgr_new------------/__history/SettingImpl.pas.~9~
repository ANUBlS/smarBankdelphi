unit SettingImpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, Grids, DBGrids, Buttons;

type
  TFrmSetting = class(TForm)
    SpeedButton1: TSpeedButton;
    DBGrid1: TDBGrid;
    Edit1: TEdit;
    Edit2: TEdit;
    procedure FormCanResize(Sender: TObject; var NewWidth, NewHeight: Integer;
      var Resize: Boolean);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure SpeedButton1Click(Sender: TObject);
    procedure DBGrid1DblClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FrmSetting: TFrmSetting;

implementation

{$R *.dfm}
  uses DmBudcetImpl, BalanceImpl, fixingImpl;
procedure TFrmSetting.DBGrid1DblClick(Sender: TObject);
begin
if DBGrid1.DataSource.DataSet.FieldByName('id').AsInteger=1 then
begin
  DmBudcet.BalSet.Open;
    if not Assigned(BalanceFrm) then
      BalanceFrm:= TBalanceFrm.Create(application);
  BalanceFrm.ShowModal ;
end;
if DBGrid1.DataSource.DataSet.FieldByName('id').AsInteger=2 then
begin
  DmBudcet.FIXINGDSet.Open;
    if not Assigned(FixingFrm) then
      FixingFrm:= TFixingFrm.Create(application);
  FixingFrm.ShowModal ;
end;
end;

procedure TFrmSetting.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
resize:=false
end;

procedure TFrmSetting.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if ORD(Key) = VK_ESCAPE then
    Close else
end;

procedure TFrmSetting.SpeedButton1Click(Sender: TObject);
begin
if DBGrid1.DataSource.DataSet.FieldByName('id').AsInteger=1 then
begin
  DmBudcet.BalSet.Open;
    if not Assigned(BalanceFrm) then
      BalanceFrm:= TBalanceFrm.Create(application);
  BalanceFrm.ShowModal ;
end;
FrmSetting.Close
end;

end.
