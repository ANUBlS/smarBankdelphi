  const RejectReason: String): Longint;
begin
  with SBTransaction do
    Result := CallIntegerFunction(cs_reject_transaction,
      ['TransactionID', TransactionID, 'RejectReason', RejectReason]);
end;

procedure TTransactionDataModule.SetCommission(CommissionID, DebitID,
  CreditID: Longint; DebitAmmount, CreditAmmount: Currency;
  TransDate: TDateTime; ParentID: Integer);

  function IsCommission: Boolean;
  begin
    with TransactionManagerForm do
      Result := OperationMode = omCommission;
  end;

begin
  if IsCommission then
    with SBComplexTrans do
      CallProcedure(cs_commission_execute, ['CommisionID', CommissionID,
        'DebitID', DebitID, 'CreditID', CreditID, 'DebitAmmount', DebitAmmount,
        'CreditAmmount', CreditAmmount, 'TransDate', TransDate, 'v_ParentID',
        ParentID]);
end;

procedure TTransactionDataModule.ShowInfo;
begin
  ShowDOAInfo(sboapiDataModule.SBSession);
end;

procedure TTransactionDataModule.FullRefresh;
const
  c_err_message = ' Table or View in Dataset "%s" does not exist! ';
var
  i: Word; // Modified by TNariman at 28.04.2005
begin
  for i := 0 to ComponentCount - 1 do
    if (Components[i] is TOracleDataSet) then
      try
        (Components[i] as TOracleDataSet).Close;
        (Components[i] as TOracleDataSet).Open;
      except
        raise Exception.Create(Format(c_err_message,
          [(Components[i] as TDataSet).Name]));
      end;
end;

end.

