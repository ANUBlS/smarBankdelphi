     TransactionEditForm.Edit_DCustID.Enabled:=True;
     TransactionEditForm.Edit_DCustID.Color:=clWindow;
     NonCustMustBe:=True;
    end
    else
    begin
       TransactionEditForm.Edit_DCustID.Enabled:=False;
       TransactionEditForm.Edit_DCustID.Color:=clSilver;
       NonCustMustBe:=False;
    end;

end;
