unit UnitBuilding;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls;

type
  TFormBuilding = class(TForm)
    GroupBox1: TGroupBox;
    Label1: TLabel;
    Label2: TLabel;
    Label4: TLabel;
    Label5: TLabel;
    Label3: TLabel;
    EditName: TEdit;
    EditAdress: TEdit;
    EditEntrance: TEdit;
    EditFlat: TEdit;
    EditFloor: TEdit;
    ac_groupbox: TGroupBox;
    Editid: TEdit;
    BtnOK: TButton;
    BtnCancel: TButton;
    procedure BtnOKClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    AddUpd :integer;
  end;

var
  FormBuilding: TFormBuilding;


implementation

uses UnitDataModccBuildings;

{$R *.DFM}

procedure TFormBuilding.BtnOKClick(Sender: TObject);
var
  p_ID, p_CompID, p_Floors, p_Entrances, p_Flats :integer;
  p_BldName, p_Address :string;
begin
  if (EditName.Text ='') or (EditAdress.Text ='') then
   ShowMessage('Binanın adı yaxud ünvanı sahəsi boşdur');
  if (EditName.Text <>'') and (EditAdress.Text <>'') then
   with DataModccBuildings do begin
    p_CompID :=, p_Floors, p_Entrances, p_Flats
    p_BldName, p_Address
    if AddUpd =1 then begin
     DataModccBuildings.CC_OP.CallProcedure('add_Buildings', [StrToInt(EditID.Text),
      EditName.Text,
      EditAdress.Text,
      StrToInt(EditFloor.Text),
      StrToInt(EditEntrance.Text),
      StrToInt(EditFlat.Text)]);
    end;
    if AddUpd =2 then begin
    {DataModccBuildings.CC_OP.CallProcedure('upd_Buildings',[
                                                    p_id,
                                                    p_comp_id,
                                                   p_bld_name,
                                                   p_adress,
                                                   p_floor,
                                                   p_entrances,
                                                   p_flats]}
    end;
   DataModccBuildings.CC_building.close;
   DataModccBuildings.CC_building.open;
   Editname.Text :='';
   Editadress.text :='';
   Editentrance.text :='';
   Editflat.text :='';
   EditFloor.text :='';
   Editname.SetFocus;
  end;
end;

end.
