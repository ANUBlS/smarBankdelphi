procedure TFull_ImportImpl.ToolButton1Click(Sender: TObject);
var
  MyExcel: Variant;
  i,J,Rows, Columns: Integer;
  Columnsname:string;
begin

  MyExcel := CreateOleObject('Excel.Application');
    if not OpenDialog.Execute then Exit;
   rows:=2;
  MyExcel.WorkBooks.Open(OpenDialog.FileName);
  Rows := MyExcel.ActiveSheet.UsedRange.Rows.Count;
  Columns := MyExcel.ActiveSheet.UsedRange.Columns.Count;

  Form_column:=tForm_column.Create(self);

      for j :=1 to Columns do
       begin
        //  showmessage(MyExcel.cells[1,j]);
        Form_column.CheckListBox.Items.Add(MyExcel.cells[1,j]);

    end;
     Form_column.ShowModal;
    for I:=0 to MyExcel.sheets[1].usedrange.rows.count  do
         begin
         Form_column.OracleDataSet1.Insert;
         Form_column.OracleDataSet1.FieldByName('ab_1').AsString  := MyExcel.Sheets[1].cells[Rows,1];
         Form_column.OracleDataSet1.Post;
         Inc(Rows);
         end;


    MyExcel.Quit;



end;

