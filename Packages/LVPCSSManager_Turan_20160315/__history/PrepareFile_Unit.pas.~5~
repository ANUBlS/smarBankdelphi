   Writeln(XMLFile,'<msg_num_of_batches>'+inttostr(xs_batchs.recordcount)+'</msg_num_of_batches>');
   Writeln(XMLFile,'<msg_amount>'+ChangeDecimal(CurrencyEdit1.Value)+'</msg_amount>');
   Writeln(XMLFile,'</SWIFT_msg_fields>');
   CloseFile(XMLFile);
end;

