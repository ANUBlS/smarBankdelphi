      sum_amount:=0;
      Messages.Close;
      Messages.SQL.Clear;
      Messages.SQL.Add('select x.*, v.val_name from xs_beneficiary x, avalute v where (x.BatchId='''+xs_batchs.fieldbyname('ID').AsString+''')and (x.val_cod=v.valute)');
      Messages.Open;
      Messages.First;
      while not messages.eof do
      begin
