   Writeln(XMLFile,'</body>');
//   ShowMessage(MessageBody);
   Writeln(XMLFile,'<sign>'+SetSign('','',MessageBody)+'</sign>');
   {----------------------------------------------------------}
   {*-*-*-*-*-*   MODIFIED BY l-CHIN CHECK KEY FILE*-*-*-*-*-*}
    {--------------------------------------------------------}
     {------------------------------------------------------}
      L_CHIN:='<sign>'+SetSign('','',MessageBody)+'</sign>';
      IF length(L_CHIN)<>301 THEN
