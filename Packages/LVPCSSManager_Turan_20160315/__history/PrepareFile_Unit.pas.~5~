         MessageDlg('DEFAULT KEY SEÇİLMƏYİB'+CHR(13)+'LÜTFƏN DEFAULT KEY-i'+CHR(13)+'KEY MANAGER PROGRAMI İLƏ FLOPPY DİSKDƏN SEÇİN!',mtWarning,[mbok],0);
      END;
     {------------------------------------------------------}
    {--------------------------------------------------------}
   {*-*-*-*-*-*   MODIFIED BY l-CHIN CHECK KEY FILE*-*-*-*-*-*}
