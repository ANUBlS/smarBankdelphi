      STmessage:=xs_batchs.fieldbyname('CLIENT_CODE').AsString;

      AddStr(MessageBody,xs_batchs.fieldbyname('CLIENT_INN').asstring+'/',true);
      STmessage:='';

      {SEL From Acount FIND INN}
      DataTemp.Close;
      DataTemp.SQL.Clear;
      DataTemp.SQL.Add('select a.filial as Branch, c.inn from account a,customers c where (a.kli_ID=c.id)and(a.id='''+xs_batchs.fieldbyname('acc_id').AsString+''')');
      DataTemp.Open;
