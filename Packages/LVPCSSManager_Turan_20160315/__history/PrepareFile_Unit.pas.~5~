   Writeln(XMLFile,'<SWIFT_msg_fields>');
   Writeln(XMLFile,' <msg_format>S</msg_format>');
   Writeln(XMLFile,' <msg_sub_format>I</msg_sub_format>');
   Writeln(XMLFile,' <msg_sender>'+Edit_sender.text+'</msg_sender>');
