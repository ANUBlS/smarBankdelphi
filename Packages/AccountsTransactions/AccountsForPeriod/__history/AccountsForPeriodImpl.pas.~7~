procedure TAccountsForPeriodForm.MouseWheelHandler(var Message: TMessage);
begin
    with  AccountsViewer do
    if Focused then
    begin
    SelectedRows.Clear;
    with TCMMouseWheel(Message) , DataSource.DataSet do
    begin
      if WheelDelta < 0 then
          Next
       else
          Prior;
    end;
  end;
end;

procedure TAccountsForPeriodForm.ActiveFormCreate(Sender: TObject);
begin
  FPADataMod := TFPADataMod.Create(Self);
  with FPADataMod do
  begin
    SYSDAT.Open;
    Branches.Open;
    DTPFirstDate.DateTime := SYSDAT.FieldByName('TEK_DAT').AsDateTime;
    DTPLastDate.DateTime := SYSDAT.FieldByName('TEK_DAT').AsDateTime;
    SYSDAT.CloseAll;
    FAccountsDataSQL := AccountsData.SQL.CommaText;
    SysUsers.Open;   
  end;
  BranchesCB.ItemIndex := 0;
  UsersCB.ItemIndex := 0;
 SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);
end;

procedure TAccountsForPeriodForm.SBExecuteClick(Sender: TObject);

  procedure BuildAccSelections(BranchID : Integer;AccsList : WideString;UserID : Integer;simvollist:WideString);
  begin
    with FPADataMod.AccountsData do
    begin
      SQL.CommaText := FAccountsDataSQL;
      if BranchID = -1 then
        SQL[16] := '' else
        SQL[16] := Format(SQL[16] ,[BranchID]);
      if Trim(AccsList) = '' then
        SQL[17] := '' else
        SQL[17] := Format(SQL[17] ,[AccsList]);

      if UserID = -1 then
        SQL[18] := '' else
        SQL[18] :=Format(SQL[18] ,[UserID]);

       if Trim(simvolList) = '' then
        SQL[19] := '' else
        SQL[19] := Format(SQL[19] ,[''''+simvolList+'''']);

    end;
  end;
var
  FirstDate,LastDate : TDateTime;
  BranchID : Integer;
  AccsList : WideString;
  UserID : Integer;
  Simvollist:WideString;
begin
  FirstDate := Integer(Trunc(DTPFirstDate.DateTime));
  LastDate := Integer(Trunc(DTPLastDate.DateTime));
  with BranchesCB do
  if ItemIndex = 0 then
    BranchID := -1 else
    BranchID := DataSource.DataSet.FieldByName('ID').AsInteger;

  with AccountsListEdit do
    AccsList := Text;

  with simvoledit do
  simvollist:=text;

  with UsersCB do
  if ItemIndex = 0 then
    UserID := -1 else
    UserID := DataSource.DataSet.FieldByName('ID').AsInteger;

  BuildAccSelections(BranchID ,AccsList,UserID,simvollist);
  Screen.Cursor := crSQLWait;
  with FPADataMod.AccountsData do
  try
    if Active then CloseAll;
    SetVariable('FirstDate',FirstDate);
    SetVariable('LastDate',LastDate);
   // memo1.text:=sql.Text;
    Open
  finally
    Screen.Cursor := crDefault;
  end;
end;

