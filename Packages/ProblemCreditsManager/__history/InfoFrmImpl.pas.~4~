unit InfoFrmImpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, ExtCtrls;

type
  TInfoFrm = class(TForm)
    ScrollBox1: TScrollBox;
    Panel1: TPanel;
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  InfoFrm: TInfoFrm;

implementation

uses DataMPrCrImpl;
{$R *.dfm}

procedure TInfoFrm.FormShow(Sender: TObject);
var
 tp, lft ,t: integer;
begin
    tp:=20;
    lft:=5;
    t:=0;
  with DataMPrCredit.PrViewDSet do
  begin
    if Active then
      close;
    open;
    First;
    while not EOF do
    begin
      with (TLabeledEdit.create(InfoFrm)) do begin
         Parent:=ScrollBox1;
         EditLabel.Caption:=FieldByName('comments').AsString ;
               Top := tp;
          left := lft;
          width := 200;

          lft:=lft+206;
           t:=t+1;
          if t>2 then
          begin
          tp := tp + 40;
           lft := 5;
           t:=0;
          end;

      end;
    next;
    end;

  end;

end;

end.
