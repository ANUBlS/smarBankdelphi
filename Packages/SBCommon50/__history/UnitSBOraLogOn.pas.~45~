function TfmOraSBLogOn.CheckControls():boolean;
begin
  result := false;
  try
   if CheckData( edUserName.Text ) then raise TCheckDataErr.Create('Enter your username!');
   if CheckData( edPassword.Text ) then raise TCheckDataErr.Create('Enter your password');
   if CheckData( cbDatabase.Text ) then raise TCheckDataErr.Create('Enter database!');
   result := true;
  except
