end;


  function ScanImage(pScanner : pointer) : pointer;
var
  pImage : pointer;
  expressQuality : integer;
  res : integer;
begin
  expressQuality := 0;
  pImage := nil;
  while (expressQuality < 20) do begin
      if (pImage <> nil) then
          BSDK_Destroy_Object(pImage);

      //acquiring image from the scanner
      res := Bsdk_Scanner_AcquireImage(pScanner, pImage);
      CheckResult(res);

      //getting image quality
      expressQuality := Bsdk_Image_GetExpressQuality(pImage, 8);
  end;

  Result := pImage;
end;

function Initialize(): Pointer;
var
  res: integer;
  pDeviceList: pointer;
  pDeviceDescriptorPtr: pointer;
  pScanner: pointer;
begin
  //creating License object
  res := bsdk_License_Create(BSDK_LICENSE_TYPE_ALL);
  CheckResult(res);

  //creating the list of devices
  res := BSDK_DeviceList_Create(pDeviceList, Bsdk_Device_Type_Scanner_Any);
  CheckResult(res);
  if (BSDK_DeviceList_GetSize(pDeviceList)= 0) then
    raise Exception.Create('Scanner was not found');

  //selecting first found device
  pDeviceDescriptorPtr := BSDK_DeviceList_GetDeviceDescriptor(pDeviceList, 0);
  //creating Scanner object
  res := Bsdk_Scanner_Create(pScanner, pDeviceDescriptorPtr);
  CheckResult(res);

  Result := pScanner;
end;


procedure TfmOraSBLogOn.GetTNSNames;
var
  i,k: integer;
  n:Pchar;
  Mem : TStringList;

    procedure GetTNSFile;
     const
       Cval = '\NETWORK\ADMIN\tnsnames.ora';
    var
      Reg : TRegistry;
      Value : String;
    begin
      reg := TRegistry.Create;
      Reg.Access := KEY_READ;
      with reg do
        begin
          RootKey := HKEY_LOCAL_MACHINE;
          OpenKey('SOFTWARE\ORACLE\KEY_OraDb11g_home1',False);
          value := ReadString('ORACLE_HOME');
          if FileExists(value+cval) then
          Mem.LoadFromFile(value+cval)// Add(value+cval)
        else
          ShowMessage('File Not Exists!');
        end;
    end;

begin
 mem :=  TStringList.Create;
 GetTNSFile;

  with Mem do
    begin
     for i:=0 to  Count-1 do
        begin
          n:= PChar(mem[i]);
          if (n[0] <> '#') and (n[0]<>'') and (n[0]<>' ') then
           begin
             k:= Pos('=',mem[i]);
             cbDatabase.items.add(copy(mem[i],0,k-2));
           end;
        end;
    end;

end;


