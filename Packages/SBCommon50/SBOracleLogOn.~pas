function TSBOracleLogOn.CheckForExpire(Sender : TpfmOraSBLogOn):TAskResult;
var
  newPass : String;
begin
  Result := arError;
    if Assigned(FSession) then
     with FSession do
     try
       LogonUsername := Sender^.LogonUsername;
       LogonPassword := GeneratePassword(Sender^.LogonPassword);
       LogonDatabase := Sender^.LogonDatabase;
       AssignParams(TpfmOraSBLogOn(Sender));
       ChaingePassword(LogonDatabase, LogonUsername, LogonPassword, 'ss');
       LogOn;
       LogOff;
       Result := arSuccess;
     except
{       on E:Exception do
          if pos('ORA-28001', E.Message)>0 then
          begin }
        on E: EOracleError do
          if E.ErrorCode = 28001 then begin
            Result := arSuccess;
            if PasswordChangeExecute(newPass) then
               if Assigned(FSession) then  FSession.SetPassword (newPass);//FSession.LogonPassword := newPass;
          end
          else MessageDlg('px3'+E.Message, mtError, [mbOK], 0);
     end;
end;

procedure TSBOracleLogOn.AssignParams(Sender : TpfmOraSBLogOn);
begin
   LogonUsername := Sender^.LogonUsername;
   LogonPassword := Sender^.LogonPassword;
   LogonDatabase := Sender^.LogonDatabase;
end;

function TSBOracleLogOn.AskForLogOn():TAskResult;
var
  fmLogOn : TfmOraSBLogOn;
begin
  result := arError;
  try
   fmLogOn := TfmOraSBLogOn.Create(nil);
   fmLogOn.Caption := FCaption;
   fmLogOn.LogonUsername := LogonUsername;
   fmLogOn.LogonPassword := LogonPassword;
   fmLogOn.LogonDatabase := LogonDatabase;
   case fmLogOn.ShowModal of
     mrOk : result := CheckForExpire(@fmLogOn);
     mrCancel : result := arCancel;
   end;
  finally
   fmLogOn.Free;
  end;
end;



function TSBOracleLogOn.Execute : TAskResult;
var
  i : integer;
  liblink : String;
begin
 Result := arError;
 i := 1;
 try
//  if not getOCILibrary(liblink)  then
//     raise TOCILibError.Create(liblink+'-- '+'Can not load oci library');
//  if not InitOCI(liblink) then
//     raise TOCIInitializeError.Create('Can not initialize oci library');

 while FRetries >= i do
  begin
   Result := AskForLogOn;
   if Result in [arSuccess, arCancel] then break;
   inc(i);
  end;


 finally
 //  CloseDll;
 end;

end;


procedure TSBOracleLogOn.CloseDll;
begin
 OCISessionEnd(mysvchp,dberrhp,myusrhp,OCI_DEFAULT);
 OCIServerDetach(mysrvhp,dberrhp,OCI_DEFAULT);
 OCIHandleFree(mysrvhp,OCI_HTYPE_SERVER);
 OCIHandleFree(mysvchp,OCI_HTYPE_SVCCTX);
 OCIHandleFree(myusrhp,OCI_HTYPE_SESSION);
 OCIHandleFree(dberrhp,OCI_HTYPE_ERROR);
 OCIHandleFree(myenvhp,OCI_HTYPE_ENV);

 FreeLibrary(hDll);
end;

constructor TSBOracleLogOn.Create(AOwner: TComponent);
begin
   inherited Create(AOwner);
   FRetries := 3;
end;

destructor TSBOracleLogOn.Destroy;
begin
   inherited Destroy;
end;

