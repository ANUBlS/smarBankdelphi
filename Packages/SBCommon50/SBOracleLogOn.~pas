function TSBOracleLogOn.TestError(where:string;ex:sword):sword;
var errcode:sb4;
    errbuf:array[0..511] of char;
begin
 Result:=ex;
 try
 case ex of
  OCI_SUCCESS: exit;
  OCI_SUCCESS_WITH_INFO: raise EDatabaseError.Create(sOraErrSuccessWithInfo);
  OCI_NEED_DATA: raise EDatabaseError.Create(sOraErrNeedData);
  OCI_NO_DATA: raise EDatabaseError.Create(sOraErrNoData);
  OCI_ERROR: begin
              OCIErrorGet(dberrhp,1,nil,errcode,errbuf,sizeof(errbuf),OCI_HTYPE_ERROR);
              raise EDatabaseError.Create('Oracle error #'+inttostr(errcode)+': '+strpas(errbuf));
             end;
  OCI_INVALID_HANDLE: raise EDatabaseError.Create(where+sOraErrInvalidHandle);
  OCI_STILL_EXECUTING: raise EDatabaseError.Create(sOraErrStillExecute);
  else raise EDatabaseError.Create(sOraErrUNKNOWN);
 end;
 except
   on E:Exception do
    MessageDlg('px2'+where+E.Message, mtError, [mbOK], 0);
 end;
end;

function TSBOracleLogOn.InitOCI(libaddrss : String) : Boolean;
begin
  result := false;
  if not FileExists(libaddrss) then exit else result := true;

  hDll:=LoadLibrary(PChar(libaddrss));

    @OCIEnvCreate:=GetProcAddress(hDll,'OCIEnvCreate');
    @OCIInitialize:=GetProcAddress(hDll,'OCIInitialize');
    @OCIEnvInit:=GetProcAddress(hDll,'OCIEnvInit');
    @OCIHandleAlloc:=GetProcAddress(hDll,'OCIHandleAlloc');
    @OCIServerAttach:=GetProcAddress(hDll,'OCIServerAttach');
    @OCIAttrSet:=GetProcAddress(hDll,'OCIAttrSet');
    @OCISessionBegin:=GetProcAddress(hDll,'OCISessionBegin');
    @OCIErrorGet:=GetProcAddress(hDll,'OCIErrorGet');
    @OCIPasswordChange:=GetProcAddress(hDll,'OCIPasswordChange');
    @OCISessionEnd:=GetProcAddress(hDll,'OCISessionEnd');
    @OCIServerDetach:=GetProcAddress(hDll,'OCIServerDetach');
    @OCIHandleFree:=GetProcAddress(hDll,'OCIHandleFree');

    if @OCIEnvCreate = nil then begin
     TestError('OCIInitialize ', OCIInitialize(OCI_DEFAULT , nil, nil, nil, nil));
     TestError('OCIEnvInit ',    OCIEnvInit(myenvhp, OCI_DEFAULT, 0, nil));
    end else
    TestError('OCIEnvCreate',   OCIEnvCreate(myenvhp, OCI_DEFAULT, nil, nil, nil, nil, 0, nil));

    TestError('OCIHandleAlloc ', OCIHandleAlloc(myenvhp, mysrvhp, OCI_HTYPE_SERVER, 0, nil));
    TestError('OCIHandleAlloc ', OCIHandleAlloc(myenvhp, dberrhp, OCI_HTYPE_ERROR,  0, nil));
    TestError('OCIHandleAlloc ', OCIHandleAlloc(myenvhp, mysvchp, OCI_HTYPE_SVCCTX, 0, nil));
end;

function TSBOracleLogOn.ChaingePassword(server,usern, oldpass, newpass : String; chngstatus : boolean = false):Boolean;
var
  pserver, pname, poldpass, pnewpass: array[0..31] of char ;
  ConnAs:array[TOraConnectAs] of integer;
  FConnectAs : TOraConnectAs;
begin
   Result := false;

   ConnAs[caNormal]  := OCI_DEFAULT;
   ConnAs[caSYSDBA]  := OCI_SYSDBA;
   ConnAs[caSYSOPER] := OCI_SYSOPER;
   FConnectAs:=caNormal;
      
   strpcopy(pserver, server);
   strpcopy(pname, usern);
   strpcopy(poldpass, oldpass);
   strpcopy(pnewpass, newpass);


   OCIServerAttach(mysrvhp, dberrhp, @pserver, strlen(pserver), OCI_DEFAULT);
   OCIAttrSet(mysvchp, OCI_HTYPE_SVCCTX, mysrvhp, 0, OCI_ATTR_SERVER, dberrhp);
   OCIHandleAlloc(myenvhp, myusrhp, OCI_HTYPE_SESSION, 0, nil);
   TestError('OCIAttrSet ',     OCIAttrSet(myusrhp, OCI_HTYPE_SESSION, @pname, strlen(pname), OCI_ATTR_USERNAME, dberrhp));
   TestError('OCIAttrSet ',      OCIAttrSet(myusrhp, OCI_HTYPE_SESSION, @poldpass, strlen(poldpass), OCI_ATTR_PASSWORD, dberrhp));

 //TestError('OCISessionBegin ', OCISessionBegin(mysvchp, dberrhp, myusrhp, OCI_CRED_RDBMS, ConnAs[FConnectAs]));
  OCISessionBegin(mysvchp, dberrhp, myusrhp, OCI_CRED_RDBMS, ConnAs[FConnectAs]);
  TestError('OCIAttrSet ',      OCIAttrSet(mysvchp, OCI_HTYPE_SVCCTX, myusrhp, 0, OCI_ATTR_SESSION, dberrhp));
  if chngstatus then
  TestError('OCIPasswordChange ', OCIPasswordChange (mysvchp, dberrhp,
                                                      pname,
                                                      strlen(pname),
                                                      poldpass,
                                                      strlen(poldpass),
                                                      pnewpass,
                                                      strlen(pnewpass),
                                                      OCI_DEFAULT));
  Result := true;
end;

function getOCILibrary(var libpath : String):Boolean;
var
  Reg: TRegistry;
  ora_home : String;
begin
  result := false;
  Reg := TRegistry.Create;
  Reg.Access := KEY_READ;
  try
    Reg.RootKey := HKEY_LOCAL_MACHINE;
    if Reg.OpenKey('\SOFTWARE\ORACLE\KEY_OraDb10g_home1', False)
    then ora_home := Reg.ReadString('ORACLE_HOME');
  finally
    Reg.CloseKey;
    Reg.Free;
  end;
  if Length(ora_home) > 0 then
    begin
     libpath := ora_home + '\bin\oci.dll';
     result := true;
    end;
end;

function GeneratePassword(value : String):String;
var
   passICECrt : TICECrypt;
begin
  result := '';
  passICECrt := TICECrypt.Create(nil);
  try
   passICECrt.Text := value;
   result := 's'+passICECrt.GetCrypted();
  finally
   passICECrt.Free;
  end;
end;

