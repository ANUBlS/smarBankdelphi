procedure TTransactionDataModule.SetCommission(CommissionID, DebitID, CreditID: Longint; DebitAmmount, CreditAmmount: Currency; TransDate: TDateTime; ParentID: Integer);

  function IsCommission: Boolean;
  begin
   with TransactionManagerForm do
    Result :=OperationMode = omCommission;
  end;

begin
 if IsCommission then
  with SBComplexTrans do
   CallProcedure(
             cs_commission_execute,[
             'CommisionID', CommissionID,
             'DebitID', DebitID,
             'CreditID', CreditID,
             'DebitAmmount', DebitAmmount,
             'CreditAmmount', CreditAmmount,
             'TransDate', TransDate,
             'v_ParentID', ParentID]);
end;

