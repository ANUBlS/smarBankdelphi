 crt:='';
with TransactionEditForm,dss do
  begin
    close;
   SetVariable('v_id',TransactionDataModule.ODS_Account.FieldByName('KLI_ID').AsInteger);
   SetVariable('v_acc_no',TransactionDataModule.ODS_Account.FieldByName('ACC_NO').AsString);
   open;
     dscoun.Close;
   dscoun.SetVariable('v_contid',dssCITIZENSHIP.AsInteger);
