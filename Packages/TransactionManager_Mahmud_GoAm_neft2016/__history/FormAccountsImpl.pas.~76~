procedure TFormAccounts.XDBGridAccountsTitleClick(Column: TXColumn);

begin
  with TransactionDataModule,ODS_Account do
  begin
    Close;
    if Column.Title.MarkerIndex=2 then SetVariable('title',Column.FieldName+' '+'ASC')
    else SetVariable('title',Column.FieldName+' '+'DESC');
    open;
  end;
end;

