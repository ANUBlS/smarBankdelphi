procedure TFormAccounts.CloseFormExecute(Sender: TObject);
begin
  FormAccounts.Close;
end;

procedure TFormAccounts.ActionSpeedSearchExecute(
  Sender: TObject);
var
  SearchField : string;
  SearchOptions : TSearchRecordOptions;
begin
  SearchOptions := [srIgnoreCase ,srPartialMatch ];

  with Sender as TEdit  do
  begin
    SearchField := copy(Name,5,length(Name));
    with  TOracleDataSet(XDBGridAccounts.DataSource.DataSet) do
    if  not SearchRecord(
                  SearchField
                 ,Text
                 ,SearchOptions + [srFromCurrent , srForward ]
                 ) then
  {  if MessageDlg(
              'Axtarış sona çatdı.'+#13+'Əvvəldən başlansın?'
             ,mtInformation
             ,[mbNo , mbYes]
             ,0
             ) = mrYes  then   }
    if not SearchRecord(
                 SearchField
                ,Text
                ,SearchOptions + [ srFromBeginning ]
                )  then
    MessageDlg('Yazı tapılmayıb!',mtInformation,[mbOK],0);
 end;

end;

procedure TFormAccounts.Button1Click(Sender: TObject);
begin
  v_AccNo:=TransactionDataModule.ODS_Account.FieldByName('ACC_NO').AsString;
  v_KliID:=TransactionDataModule.ODS_Account.FieldByName('KLI_ID').AsInteger;
  FormAccounts.Close;
end;

procedure TFormAccounts.EditACC_NOKeyPress(Sender: TObject; var Key: Char);
begin
if key=#13  then ActionSpeedSearchExecute(Sender);
end;

procedure TFormAccounts.EditACC_NO_SEARCHKeyPress(Sender: TObject;
  var Key: Char);
begin
if key=#13  then ActionSpeedSearchExecute(Sender);

end;

procedure TFormAccounts.EditNameKeyPress(Sender: TObject; var Key: Char);
begin
if key=#13  then ActionSpeedSearchExecute(Sender);
end;

procedure TFormAccounts.FormClose(Sender: TObject; var Action: TCloseAction);
 var
key:char;

begin
EditACC_NO_SEARCH.Clear;
EditACC_NO.Clear;
EditName.Clear;
if v_reoprt_code=true then
 begin
 id1:=TransactionDataModule.ODS_Account.FieldByName('ID').AsInteger ;
 kli_id1 :=TransactionDataModule.ODS_Account.FieldByName('KLI_ID').AsInteger;

 end;
 if v_reoprt_code=false then
 begin
 id2:=TransactionDataModule.ODS_Account.FieldByName('ID').AsInteger ;
  kli_id2 :=TransactionDataModule.ODS_Account.FieldByName('KLI_ID').AsInteger;

 end;
  ReportCode(sender);

end;

procedure TFormAccounts.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if (key=VK_INSERT) then
   begin
    v_AccNo:=TransactionDataModule.ODS_Account.FieldByName('ACC_NO').AsString;
    v_KliID:=TransactionDataModule.ODS_Account.FieldByName('KLI_ID').AsInteger;
    FormAccounts.Close;
   end;
//then VK_RETURN showmessage('salam');
     //
end;

procedure TFormAccounts.FormKeyPress(Sender: TObject; var Key: Char);
begin
if key=#27 then FormAccounts.Close;
end;

