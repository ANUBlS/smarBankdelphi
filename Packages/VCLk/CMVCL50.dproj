			<DCC_Platform>x86</DCC_Platform>
			<DCC_WriteableConstants>true</DCC_WriteableConstants>
			<DCC_N>true</DCC_N>
			<DCC_K>false</DCC_K>
			<GenDll>true</GenDll>
			<DCC_S>false</DCC_S>
