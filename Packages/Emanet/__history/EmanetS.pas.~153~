 TmpBal: Integer;
begin
TmpBal:=StrToIntDef(Text,0);
if TmpBal=0 then Exit;
if OracleDataSet1.Active  then
begin
  if PageControl1.ActivePageIndex=0 then OraclePackage1.CallProcedure('Insert_Balans',[IntToStr(TmpBal),0]);
  if PageControl1.ActivePageIndex=1 then OraclePackage1.CallProcedure('Insert_Balans',[IntToStr(TmpBal),1]);
  if PageControl1.ActivePageIndex=2 then OraclePackage1.CallProcedure('Insert_Balans',[IntToStr(TmpBal),2]);
end;
