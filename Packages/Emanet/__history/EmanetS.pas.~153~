var
  I: Integer;
  k: integer;
begin
  k:=0;
  for I := 0 to Evanescence1.KeyItems.Count-1 do
  begin
    if  Evanescence1.Checked[i]=False  then
    begin
      Fk:=True;
      CheckBox1.Checked:=False;
      Fk:=False;
