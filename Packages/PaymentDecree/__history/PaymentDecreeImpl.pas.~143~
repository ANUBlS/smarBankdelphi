procedure TPaymentDecree.PustToCombo(DataSet: TOracleDataSet; Field: String; ComboBox: TComboBox);
begin
 if DataSet.Active=false then DataSet.Open;
  DataSet.First;
   ComboBox.Items.Clear;
    while not(DataSet.Eof) do
     begin
      ComboBox.Items.Add(DataSet. FieldByName(Field).AsString);
      DataSet.Next;
     end;
end;

procedure TPaymentDecree.PustToComboID(DataSet :TOracleDataSet; Field,IDfield :String; ComboBox :TComboBox);
var
   RateIndex :Integer;
begin
 RateIndex :=0;
 if DataSet. Active=false then DataSet.Open;
  DataSet.First;
   SetLength(Rate,DataSet.RecordCount);
   ComboBox.Items.Clear;
    while not(DataSet.Eof) do
     begin
      ComboBox.Items.Add(DataSet. FieldByName(Field).AsString);
      Rate[RateIndex] :=DataSet. FieldByName(IDfield).AsInteger;
      DataSet.Next;
      Inc(RateIndex);
     end;
end;
procedure TPaymentDecree.PustToComboKOD(DataSet :TOracleDataSet; Field,IDfield :String; ComboBox :TComboBox);
var
   RateIndex1 :Integer;
begin
 RateIndex1 :=0;
 if DataSet. Active=false then DataSet.Open;
  DataSet.First;
   SetLength(Rate1,DataSet.RecordCount);
   ComboBox.Items.Clear;
    while not(DataSet.Eof) do
     begin
      ComboBox.Items.Add(DataSet. FieldByName(Field).AsString);
      Rate1[RateIndex1] :=DataSet. FieldByName(IDfield).AsInteger;
      DataSet.Next;
      Inc(RateIndex1);
     end;
end;


