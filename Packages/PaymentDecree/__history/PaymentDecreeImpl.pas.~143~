procedure TPaymentDecree.CBKBNameChange(Sender: TObject);
begin
 EKBCod.Text :='';
 EKBInn.Text :='';
 EKBCorAcc.Text :='';
 EKBSwift.Text :='';
 try
  with PaymentDataMod.ODSBankM do
   begin
    Close;
     SQL. Clear;
     SQL.Text :='Select * From BankM Where ID= '+IntToStr(Rate[CBKBName.ItemIndex])+'order by name';
    Open;
    EKBCod.Text :=FieldByName('BANKCODE').AsString;
    EKBInn.Text :=FieldByName('INN').AsString;
    EKBCorAcc.Text :=FieldByName('KRNO').AsString;
    EKBSwift.Text :=FieldByName('SWIFT').AsString;
   end;
 finally
    with PaymentDataMod.ODSBankM do
    begin
     Close;
      SQL. Clear;
      SQL.Text :='Select * From BankM  order by name';
     Open;
    end;
 end;
end;

