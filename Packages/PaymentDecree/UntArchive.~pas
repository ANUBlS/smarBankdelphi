procedure TFrmArchive.ToolButton1Click(Sender: TObject);
var
   deleteID: Integer;
   PaymentNumber: String;
   RecordNo: Integer;
begin
 PaymentNumber :=PaymentDataMod.ODSArchive.FieldByName('PNUM').AsString;
 if MessageDlg(Format('Do you want to delete payment ¹%s?',[PaymentNumber]),mtConfirmation,mbYesNoCancel,0)=mrYes then
 with PaymentDataMod.ODSArchive,PaymentDataMod.OPPayment do
  begin
   RecordNo :=RecNo;
   deleteID :=FieldByName('ID').AsInteger;
   CallProcedure('delete_payment',[deleteID]);
   Refresh;
   RecNo :=RecordNo;
  end;
end;

procedure TFrmArchive.MouseWheelHandler(var Message: TMessage);
begin
 Inherited;
