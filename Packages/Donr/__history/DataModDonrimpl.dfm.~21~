  object CredDset: TOracleDataSet
    SQL.Strings = (
      
        'select p.numberofcredit,v.val_name,get_donr (p.id) as donrname,f' +
        '.name ,b.name as customer,'
      
        'p.dateofconclusion,p.duedatefirstcontract,p.duedatelastcontract,' +
        'pr.descripion,vi.name mnovu,cr.name Bsektor, a.description Bfali' +
        'yyet '
      
        ',ca.description Bfaliyetnovu ,t.description tip,p.creditlineamou' +
        'nt ,(p.creditlineamount*o.ostat) amountek,'
      
        '(select percent from cm_reserve_types where id=h.reserveid ) adi' +
        ' ,(select percent from cm_reserve_types where id=h.duereserveid)' +
        ' meq,'
      
        '(select sum(donorammount) from cm_donor where creditid=p.id) don' +
        'ves,(select sum(donorammount) from cm_donor where creditid=p.id)' +
        '*o.ostat donvesek,'
      
        'h.rest,h.rest*o.ostat restek,h.interestrest,h.interestrest*o.ost' +
        'at interestrestek,(select percent from cm_reserve_types where id' +
        '=h.reserveid )*h.rest adimeb'
      
        ',(select percent from cm_reserve_types where id=h.duereserveid)*' +
        'h.rest meqmeb,h.duerest,h.duerest*o.ostat duerestek,h.dueinteres' +
        'trest,'
      
        'h.dueinterestrest*o.ostat dueinterestrestek,(select name from cm' +
        '_expert where id=p.expertid) mutexesis,d.donid'
      'from '
      'cm_active_credits p,'
      'avalute_t v,'
      'filial f,'
      'cm_boorowerinfo b,'
      'cm_credittypes t,'
      'cm_vid_sob vi,'
      'cm_activities a,cm_creditcat cr,'
      'cm_categories ca,cm_persons pr,operkurs o,'
      'cm_history h ,cm_donor d'
