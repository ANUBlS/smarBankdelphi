function Texdonr.BuildFilterString : String;

  procedure ConcatFilter(var S: String; const Prefix : String; Checked : Boolean; KeyValue : Variant);
  const
     csFormat = '(%s=%s)';
  var
    Temp : String;
  begin

    if Checked then
    begin
      Temp := Format(csFormat,[Prefix,Keyvalue]);
      if S = '' then
        S := Temp
      else
        S :=S + 'and ' + Temp;
    end;

  end;  // Concat Filter

begin

  Result := '';
  ConcatFilter(Result,'cont.id',CheckBox1.Checked,DBLookupComboBox1.KeyValue);
  ConcatFilter(Result,'cont.BRANCHID',CheckBox3.Checked,DBLookupComboBox3.KeyValue);
 ConcatFilter(Result,'cont.currency',CheckBox4.Checked,DBLookupComboBox4.KeyValue)
end;



