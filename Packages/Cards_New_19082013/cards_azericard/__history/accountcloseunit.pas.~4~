procedure Taccountclose.SELECTALL1Click(Sender: TObject);
begin
 with dbgrid1, SelectedRows, DataSource.DataSet do
  begin
    DisableControls;
    try
      First;
      while not Eof do
       begin
        CurrentRowSelected := True;
        Next;
       end;
    finally
