procedure Taccountclose.isertbtnClick(Sender: TObject);
const
    c_info = '%d record is imported!';
var
   V,Sheet,Sheets  :Variant;
   cell,row,i,j    :Integer;
begin
DataMod_CARDS.mainpacket.CallProcedure('accdelet',[]);
  if OpenDialogCards.Execute then begin
//**********************


  DataMod_CARDS.acclose.Open;
    

  //DataMod_CARDS.YENICARD1.Open;
  V:=ExcelApplication1.Application;
  ExcelApplication1.Connect;
  V.Workbooks.Open( OpenDialogCards.FileName);
  Sheet := V.Workbooks[1].Worksheets['CARDS'];
  Sheets := V.Sheets;

  DataMod_CARDS.acclose.First;
  //for j:=10 to RecCount do
  j:=2;
  repeat
   //begin
   cell :=1;
   DataMod_CARDS.acclose.Insert ;
    for i:=0  to DataMod_CARDS.acclose.FieldCount-3 do
     begin
      Application.ProcessMessages;
       
      DataMod_CARDS.acclose.Fields[i].AsString :=trim(Sheet.cells[j,cell]);
      cell:=cell+1;
     end;
    DataMod_CARDS.acclose.Post;
    DataMod_CARDS.acclose.Next;
    j:=j+1;
  until (Sheet.cells[j,1].Text = '') and (Sheet.cells[j,2].Text = '');
//   end;

  V :=null;
  Application.ProcessMessages;
  ExcelApplication1.Quit;
  ExcelApplication1.Disconnect;
  Application.ProcessMessages;
  DataMod_CARDS.acclose.session.Commit;
     DataMod_CARDS.mainpacket.CallProcedure('accupdate',[]);
  DataMod_CARDS.acclose.Refresh;
  DataMod_CARDS.acclose2.Refresh;
  ShowMessage(Format(c_info, [j-2]));
//**********************
  end; {if OpenDialogCards.Execute}

  end;



