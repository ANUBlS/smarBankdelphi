procedure TAboutBanks.SpeedButton2Click(Sender: TObject);
var
   IdHTTP : TIdHTTP;
  Id_HandlerSocket : TIdSSLIOHandlerSocketOpenSSL;
  ss: TStringStream;
  ms: TMemoryStream;
  aa:TStringList;
  tt:string;
  i, bi,i_f,fi:integer;


   MainNode, CustomerNode, Basofis ,HiderBasofis,BankBas,BranchOffices,Bankfil: IXMLNode;


begin
    IdHTTP := TIdHTTP.Create(Nil);
    ms:=TMemoryStream.Create;
    aa:=TStringList.Create;

  Id_HandlerSocket := TIdSSLIOHandlerSocketOpenSSL.Create(IdHTTP);
  Try

      tt:=('https://www.cbar.az/bankinfonew/banks.xml' );

    TEncoding.UTF8.ToString;
    aa.LoadFromStream(ms,TENCODING.UTF8);
    ss := TStringStream.Create('', TEncoding.UTF8);
    IdHTTP.Request.ContentType := 'application/xml; charset=utf-8';
    IdHTTP.Request.BasicAuthentication := false;
    IdHTTP.Request.UserAgent := 'Mozilla/5.0 (Windows NT 6.1; WOW64; rv:12.0) Gecko/20100101 Firefox/12.0';
    Id_HandlerSocket.SSLOptions.Mode := sslmClient;
    Id_HandlerSocket.SSLOptions.Method:=sslvSSLv23;
    IdHTTP.IOHandler:=Id_HandlerSocket;
       ////////////////memo///////
      // IdHTTP.get(tt,ss);
      // memo1.Text:= ss.DataString;
      //////////////////////////

      IdHTTP.get(tt,ms);
      XMLDocument1.LoadFromStream( ms);

        MainNode := XMLDocument1.DocumentElement;

      HiderBasofis:=  MainNode.ChildNodes['HeadOffices'].ChildNodes['Operations'];

     for i:=0 to HiderBasofis.ChildNodes.Count-1 do
       begin
      BankBas := HiderBasofis.ChildNodes[i];

      //showmessage(inttostr(BankBas.ChildNodes.Count));
        //  showmessage(inttostr(ii)) ;

     p_CorAccountAZN:='';
     p_valAZN:='';
     p_CorAccountUSD:='';
     p_valUSD:='';
     p_CorAccountEUR:='';
     p_valEUR:='';
     p_CorAccountGBP:='';
     p_valGBP:='';
     p_code:='';

     for BI :=0 to BankBas.ChildNodes.Count-1 do
     begin

      if BankBas.ChildNodes[bi].NodeName='Code' then
       begin
       p_code:=BankBas.ChildNodes[bi].Text;
       end;

        if BankBas.ChildNodes[bi].NodeName='SWIFTBIC' then
       begin
       p_SWIFTBI:=BankBas.ChildNodes[bi].Text;
       end;

       if BankBas.ChildNodes[bi].NodeName='Name' then
       begin
       p_name:=BankBas.ChildNodes[bi].Text;
       end;
       if BankBas.ChildNodes[bi].NodeName='TaxNumber' then
       begin
       p_TaxNumber:=BankBas.ChildNodes[bi].Text;
       end;
      // if Bank.ChildNodes[bi].NodeName='CorAccount' and concat(bank.ChildNodes[bi].Text then

   if  BankBas.ChildNodes[bi].NodeName='CorAccount' then   begin
    if  BankBas.ChildNodes[bi].Attributes['Currency']='AZN'then
     begin
       p_CorAccountAZN:=BankBas.ChildNodes[bi].Text ;
       p_valAZN:='AZN';
       end;
     if  BankBas.ChildNodes[bi].Attributes['Currency']='USD'then
     begin

       p_CorAccountUSD:=BankBas.ChildNodes[bi].Text ;
       p_valUSD:='USD';
     end;
     if  BankBas.ChildNodes[bi].Attributes['Currency']='EUR'then
     begin
       p_CorAccountEUR:=BankBas.ChildNodes[bi].Text ;
       p_valEUR:='EUR';
     end;
     if  BankBas.ChildNodes[bi].Attributes['Currency']='GBP'then
     begin
       p_CorAccountGBP:=BankBas.ChildNodes[bi].Text ;
       p_valGBP:='GBP';

     end;

   end ;
   if  BankBas.ChildNodes[bi].NodeName='SubCorAccount' then   begin
    if  BankBas.ChildNodes[bi].Attributes['System']='LVPCSS'then
    begin
       p_SubCorAccountLVPCSS:=BankBas.ChildNodes[bi].Text ;
    end;
    if  BankBas.ChildNodes[bi].Attributes['System']='IPS'then
    begin
