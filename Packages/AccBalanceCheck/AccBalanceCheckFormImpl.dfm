  object Accs: TOracleDataSet
    SQL.Strings = (
      'select'
      '  acc.ID, acc.ACC_NO as AccountNo, acc.Name as AccName,'
      
        '  t.ostat as Amount, t.pok_ostat as LAmount, t.obr_d as DebitTur' +
        'nover,'
      
        '  t.pok_obr_d as DebitLTurnover, t.obr_k as CreditTurnover, t.po' +
        'k_obr_k as CreditLTurnover'
      'from'
      '  account acc,'
      '  tenostat t'
      'where'
      '  t.acc_id = acc.ID')
    ReadBuffer = 25
    Optimize = True
    Debug = False
    StringFieldsOnly = False
    SequenceField.ApplyMoment = amOnPost
    OracleDictionary.EnforceConstraints = False
    OracleDictionary.UseMessageTable = False
    OracleDictionary.DefaultValues = False
