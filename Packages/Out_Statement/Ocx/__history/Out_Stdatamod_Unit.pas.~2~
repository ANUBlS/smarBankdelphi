var
  Out_Stdatamod: TOut_Stdatamod;

implementation
  USes sboapiDataModuleImpl;
{$R *.DFM}

procedure TOut_Stdatamod.DataModuleCreate(Sender: TObject);
begin
   RatesDataSet.Open;
   RatesDataSetBegin.Open;
end;

