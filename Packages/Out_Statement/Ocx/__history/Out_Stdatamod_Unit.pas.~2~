    FloatField1: TFloatField;
    ODSNotAccId: TOracleDataSet;
    ODSCurrency: TOracleDataSet;
    DSCurrency: TDataSource;
    ODSFilial: TOracleDataSet;
    DSFilial: TDataSource;
    ODSUsers: TOracleDataSet;
    DSUsers: TDataSource;
    ODSLogo: TOracleDataSet;
