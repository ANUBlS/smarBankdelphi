    count:=1
    else
    count:=1;//ods_gold.FieldByName('cardid').AsInteger+1 ;

DataMGuarante.OraclePackage1.CallProcedure('Guarantee_AddGold' ,
                              [guarid,
                               count,
                               DBEditEh1.Text,
                               DBLookupComboboxEh1.Value,
                               edit1.Text,
                               Edit2.Text,
                               DBEditEh6.Text,
                               DBEditEh3.Text,
                               DBEditEh8.Text,
                               DBEditEh4.Text,
                               DBEditEh5.Text,
                               DBEditEh10.Text,
                               DBEditEh7.Text,
                               Memo1.Text,
                               Edit3.Text]);

ods_gold.Close;
ods_gold.SetVariable('v_crid',guarid);
ods_gold.SetVariable('v_cardid',count);
ods_gold.Open;
 ods_sum.Close;
 ods_sum.SetVariable('v_crid',guarid);
 ods_sum.Close;
 FormGuarAdd.DBNumberEditEh5.Value:= ods_sumBAZ.AsFloat;
 FormGuarAdd.DBNumberEditEh1.Value:= ods_sumLIK.AsFloat;
              FormClear(Sender);

end;

