procedure TFormGuarAdd.Button2Click(Sender: TObject);
var
  guarid: Integer;
begin

  if VarIsNull(DBLookupComboboxEh1.KeyValue) then
  begin
    ShowMessage('Girovun tipi sahəsini seçin !');
    DBLookupComboboxEh1.SetFocus;
    Exit;
  end
  else
    p_pledgeid := DBLookupComboboxEh1.KeyValue;

  if VarIsNull(DBLookupComboboxEh2.KeyValue) then
  begin
    ShowMessage('Girovun Çeşidi sahəsini seçin !');
    DBLookupComboboxEh2.SetFocus;
    Exit;
  end
  else
    p_pledgsorts := DBLookupComboboxEh2.KeyValue;

  if Trim(DBEditEh8.Text) = '' then
  begin
    ShowMessage('Girovun adı sahəsini doldurun !');
    DBEditEh8.SetFocus;
    Exit;
  end
  else
    p_pledgename := DBEditEh8.Text;

  if VarIsNull(DBNumberEditEh5.Value) or (DBNumberEditEh5.Value = 0) then
  begin
    ShowMessage('Girovun bazar dəyərini doldurun!');
    DBNumberEditEh5.SetFocus;
    Exit;
  end
  else
    p_pledgeprice := DBNumberEditEh5.Value;

  if VarIsNull(DBNumberEditEh1.Value) then
  begin
    ShowMessage('Girovun likvid dəyəri doldurun !');
    DBNumberEditEh1.SetFocus;
    Exit;
  end
  else
    p_likvid := DBNumberEditEh1.Value;

   if VarIsNull(DBLookupComboboxEh6.KeyValue) then
    p_registryagency := ''
  else
    p_registryagency := DBLookupComboboxEh6.KeyValue;

  p_reyster := DBEditEh3.Text;
  p_holdername := DBEditEh1.Text;
  p_seryamh := DBEditEh4.Text;
  p_registryno := DBEditEh2.Text;

  if VarIsNull(DBDateTimeEditEh3.Value) then
    p_registrydate := Null
  else
    p_registrydate := DBDateTimeEditEh3.Value;

  p_anyinfotodisting := DBEditEh10.Text;

  if VarIsNull(DBEditCompany.KeyValue) then
    p_company := -1
  else
    p_company := DBEditCompany.Value;

  if VarIsNull(DBDateTimeEditEh4.Value) then
    p_companydat := Null
  else
    p_companydat := DBDateTimeEditEh4.Value;

  p_companyexpert := DBEditEh13.Text;

  // p_pledgename təkrar mənimsədilməsi silindi!
  p_gqpaspyer := DBEditEh7.Text;
  p_gqpaspnum := DBEditEh6.Text;

  if VarIsNull(DBDateTimeEditEh1.Value) then
    p_gqpaspdate := Null
  else
    p_gqpaspdate := DBDateTimeEditEh1.Value;

  p_fin := DBEditEh9.Text;

  if VarIsNull(DBLookupComboboxEh3.Value) then
    p_gqcity := -1
  else
    p_gqcity := DBLookupComboboxEh3.Value;

  if VarIsNull(DBLookupComboboxEh4.Value) then
    p_gqvillage := -1
  else
    p_gqvillage := DBLookupComboboxEh4.Value;

  p_gqadres := DBEditEh16.Text;
  p_gqtelmob := DBEditEh11.Text;
  p_gqtelhome := DBEditEh14.Text;
  p_gqtelwork := DBEditEh15.Text;




  guarid :=
    DataMGuarante.OraclePackage1.CallIntegerFunction
    ('add_Guar', [
    p_pledgeprice,      p_likvid,           p_numberofgur,      p_pledgeid,
    p_pledgename,       p_holdername,       p_holderaddress,    p_anyinfotodisting,
    p_registryno,       p_registryagency,   p_registrydate,     p_pledgeinsurant,
    p_insuranceagency,  p_insuranceamount,  p_insuranceright,   p_insurancedate,
    p_gqname,           p_gqpaspnum,        p_gqpaspyer,        p_gqpaspdate,
    p_gqcity,           p_gqvillage,        p_gqadres,          p_gqtelmob,
    p_gqtelhome,        p_gqtelwork,        p_reyster,          p_seryamh,
    p_pledgsorts,       p_company,          p_companydat,       p_companyexpert,
    p_brance,           p_dat,              p_generalarea,      p_livingarea,
    p_buildingsoilarea, p_soilarea,         p_adress,           p_inforegion,
    p_infovilg,         p_custid,           p_avto_q_s_no,      p_avto_maka,
    p_avto_tip,         p_avto_no,          p_avto_reng,        p_avto_il,
    p_avto_muher_no,    p_avto_muher_hecm,  p_AVTO_REGSTR_DAT,  p_avto_ban
  ]);


  if guarid > 0 then
    begin
      with DataMGuarante.DataSetGuarantee do
    begin
      DisableControls;
      try
        Close;
        Open;
        Locate('ID', guarid, []);
      finally
        EnableControls;
      end;

    ShowMessage('Məlumat uğurla əlavə edildi!');


    end;
  end;
end;

