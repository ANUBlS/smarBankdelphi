package CM_Analysofcustomers;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  Vcldb,
  doa41dxe,
  Ehlib50,
  sboapi50,
  CM_COMMON;

contains
  CustAnalysDataModuleImpl in 'CustAnalysDataModuleImpl.pas' {CustAnalysDataModule: TDataModule},
  CustAnalyseLoader in 'CustAnalyseLoader.pas',
  DateintervalUnit in 'DateintervalUnit.pas' {DateintervalForm},
  PaymentsUnit in 'PaymentsUnit.pas' {PaymentsForm},
  CreditUnit in 'CreditUnit.pas' {CreditForm},
  FilterUnit in 'FilterUnit.pas' {FilterForm},
  CreditsinDateUnit in 'CreditsinDateUnit.pas' {CreditinDateForm},
  CustanalysUnit in 'CustanalysUnit.pas' {CustanalysForm};

end.
