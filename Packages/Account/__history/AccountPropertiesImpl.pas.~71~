procedure TAccountPropertiesForm.FormCreate(Sender: TObject);
var
  a:string;
begin
  SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
  AccDataModule.DSsettings.Open;
  AccDataModule.ODS_AccNoLength.Open;
  OracleDataSet1.Open;
  if not AccDataModule.Customers.Active then AccDataModule.Customers.Open;
  a :=AccDataModule.DSsettings.FieldByName('VALUE').AsString;
  if a='0' then DBEditAccNo.ReadOnly:=true
   else DBEditAccNo.ReadOnly:=false;
  DBEditAccNo.MaxLength :=AccDataModule.ODS_AccNoLength.FieldByName('VALUE').AsInteger;
end;

