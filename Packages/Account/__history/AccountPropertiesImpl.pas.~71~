procedure TAccountPropertiesForm.ButtonCommitClick(Sender: TObject);
var acc_number :string  ;
begin
   if DBLookupCurr.Text='' then
   begin
   ShowMessage('Valyuta seçimini düzgün edin');
   Exit;
   end;

   if DBLookupBalance1.Text='' then
   begin
   ShowMessage('Balans hesabı seçimini düzgün edin');
   Exit;
   end;
   if Bal_CN2.Visible=true then
     begin
   if DBLookupBalance2.Text='' then
   begin
   ShowMessage('Balans hesabı yeni seçimini düzgün edin');
   Exit;
   end;
     end;

   if DBLookupCust.Text='' then
   begin
   ShowMessage('Müştəri seçimini düzgün edin');
   Exit;
   end;


  if DBEditAccNo.Text<>'' then
   begin
    if MessageDlg('Dəyişikliklər yadda saxlansın?',mtWarning, [mbYes, mbNo],0)=idyes then
     with AccDataModule.Account do
      if State in [dsInsert, dsEdit] then begin


        FieldByName('open_dat').AsDateTime :=Int(DTPOpenDate.DateTime);

        FieldByName('procuration_dat').AsVariant :=DBDateTimeEditEh1.Value ;

        if DBLookupComboBoxBranchName.Text='' then begin
         ShowMessage('Filial seçimi edin');
         Exit;
        end; {if DBLookupComboBoxBranchName.Text=''}
        Post;
      end; {if State in [dsInsert, dsEdit]}
    Close;

  acc_number :=DBEditAccNo.Text;
  with AccDataModule.Account do
 begin

  CloseAll;
  Open;
  Locate('ACC_NO', acc_number, []);
 end;

   end
   else ShowMessage('Hesab № yaradılmayıb!!');
end;

procedure TAccountPropertiesForm.CBPairLookUpClick(Sender: TObject);
