  else
    FilterStr :=FilterStr + BooleanPrefix + Tipacc;

  if   CBBal_Cn.Checked //Balance <> ''
  then
  if  FilterStr=''  then
    FilterStr :=Balance
  else
    FilterStr :=FilterStr + BooleanPrefix + Balance;

  if ChBoxSimOtcet.Checked then
   if FilterStr='' then FilterStr := RepSymb
    else FilterStr :=FilterStr + BooleanPrefix + RepSymb;

  if CheckBoxCust.Checked then
   if FilterStr='' then FilterStr := kli_id
    else FilterStr :=FilterStr + BooleanPrefix + kli_id;

  with AccDataModule.Account do begin
   SQL[6]:=' where '+ FilterStr;
   SQL.Text :=Stringreplace(SQL.Text,'Status','DECODE (close_dat, NULL, 1, 2)', [rfReplaceAll, rfIgnoreCase]);
   //Memo1.Text :=SQL.Text;
   Close;
   Open;
  end;
end;

