procedure TMemorial_project.OpenOracleDataSet;
const
     cGetUserName='GetUserName';
var
     TableName:string;
begin
  with  memorial_datamodule.ODSMain do
    if  Active  then Close;

  with  memorial_datamodule.OraclePackage do begin
    TableName :='Memorial_'+CallStringFunction(cGetUserName,[]);
  end;
  with  memorial_datamodule.ODSMain.SQL do begin
    Clear;
    Add('Select  *  From  '+TableName);
    Add(OrderString);
  end;

  with  memorial_datamodule.ODSMain do  Open;
  with  memorial_datamodule.ODSMain do  Refresh;
end;
