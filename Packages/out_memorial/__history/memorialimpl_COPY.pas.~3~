procedure Tmemorial_project.BitBtnRunClick(Sender: TObject);
var
    DebtKred :Integer;
    //DefaultValue:string;
    BalanceType:1..4;
begin
 try
    DebtKred :=0;
    ProgressBar1.StepBy(10);
  case CmbBoxForm.ItemIndex of
    0:
      begin  //Butun Emelyattlar.
        Screen.Cursor :=crSQLWait;
        sb_Memorial(Trunc(DTPBegin.DateTime),Trunc(DTPEnd.DateTime),Rate[RateIndex],1,0,'',Word(CheckBoxDifference.Checked),-1,Word(CBUseBalance.Checked),RGTransMode.ItemIndex);
        ProgressBar1.StepBy(30);
        OpenOracleDataSet(OrderBy);
        ProgressBar1.StepBy(20);
        Screen.Cursor :=crDefault;

      end;
    1:
      begin
         with  Filter do
         if  ShowModal<>mrOk then
          Abort;
         Screen.Cursor :=crSQLWait;
         with  Filter do begin
         if  (CBDebt.Checked) then
           DebtKred :=0;
         if  (CBKred.Checked) then
           DebtKred :=1;
         if  (CBDebt.Checked) and (CBKred.Checked) then
           DebtKred :=2;
         if ((not(CBDebt.Checked))and(not(CBKred.Checked))) then
           DebtKred :=-1;
         end;
         if   Filter.ComboBoxPlan.Enabled then
         BalanceType:=Filter.ComboBoxPlan.ItemIndex+1 else
         BalanceType :=1;
         sb_Memorial(Trunc(DTPBegin.DateTime),Trunc(DTPEnd.DateTime),Rate[RateIndex],BalanceType,Word(Filter.CheckBoxBalance.Checked),Filter.EditBalList.Text,Word(CheckBoxDifference.Checked),DebtKred,Word(CBUseBalance.Checked),RGTransMode.ItemIndex);
         ProgressBar1.StepBy(30);
         OpenOracleDataSet(OrderBy);
         ProgressBar1.StepBy(20);
         Screen.Cursor :=crDefault;
      end;
    2:;{begin
        IDs :='';
        with DataMod.ODSMain do
        for   Idx :=0 to  DBGrid1.SelectedRows.Count-1 do
        begin
           GotoBookmark(Pointer(DBGrid1.SelectedRows.Items[Idx]));
           if  IDs = '' then
            IDs :=FieldByName('ID').AsString
           else
            IDs :=IDs+','+FieldByName('ID').AsString;
        end;
        //ShowMessage(IDs);
        Screen.Cursor :=crSQLWait;
        try
          if IDs<>''  then
            IDs :='Where (ID in ('+IDs+'))';
          OpenOracleDataSet(IDs+OrderBy);
          ProgressBar1.StepBy(50);
         finally
           Screen.Cursor :=crDefault;
         end
      end;}
    3:begin
        Screen.Cursor :=crSQLWait;
        sb_Memorial(Trunc(DTPBegin.DateTime),Trunc(DTPEnd.DateTime),Rate[RateIndex],1,0,'',Word(CheckBoxDifference.Checked),-1,Word(CBUseBalance.Checked),RGTransMode.ItemIndex,1);
        ProgressBar1.StepBy(30);
        OpenOracleDataSet(OrderBy);
        ProgressBar1.StepBy(20);
        Screen.Cursor :=crDefault;
      end;
  end;//Case
  //ShowMessage(IntToStr(Word((Rate[RateIndex]<>0)and(CmbBoxForm.ItemIndex=3))));
  if   CBReport.Checked   then
    InitalizeRpt(Word((Rate[RateIndex]<>0)),ComboBoxPrintMode.ItemIndex);//(Rate[RateIndex]<>-1)and(CmbBoxForm.ItemIndex=3)

  ProgressBar1.StepBy(40);
  ProgressBar1.Position:=0;
//  OpenOracleDataSet(oRDERbY);
  except
    ProgressBar1.Position :=0;
    Screen.Cursor :=crDefault;
    Raise;
   end;
end;
