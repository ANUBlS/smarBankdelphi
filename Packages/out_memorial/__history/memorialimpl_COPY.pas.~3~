procedure TMemorial_project.sb_Memorial;
const  cMemorial='MEMORIAL';
begin

  if BranchesSC.ItemIndex >0 then
    FilialMode := BranchesSC.DataSource.DataSet.FieldByName('ID').AsInteger
  else
    FilialMode := -1;

   with memorial_datamodule.OraclePackage do
    CallProcedure(cMemorial,[begDate,endDate,Valute,BalType,BalOrAcc,Balance,RateDiff,KredDebt,UseBalance,MultyCurrency,TransactionMode,FilialMode]);
end;
