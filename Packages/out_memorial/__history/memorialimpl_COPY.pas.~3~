procedure Tmemorial_project.miPrintSelectedClick(Sender: TObject);
var
  IDs : WideString;
  IDX : Integer;
  RCount : Integer;
  SavePlace : TBookmark;
begin
    IDs :='';
    RCount := DBGrid1.SelectedRows.Count - 1;
    SavePlace := memorial_DataModule.ODSMain.GetBookmark;
    with memorial_DataModule.ODSMain do
    for   Idx :=0 to  RCount do
    begin
       GotoBookmark(Pointer(DBGrid1.SelectedRows.Items[Idx]));
       if  IDs = '' then
        IDs :=FieldByName('ID').AsString
       else
        IDs :=IDs+','+FieldByName('ID').AsString;
    end;
    Screen.Cursor :=crSQLWait;
    try
      if IDs<>''  then
        IDs :='Where (ID in ('+IDs+'))';
      OpenOracleDataSet(IDs+OrderBy);
      ProgressBar1.StepBy(50);
      Screen.Cursor :=crDefault;
      InitalizeRpt(Word((Rate[RateIndex]<>0)),ComboBoxPrintMode.ItemIndex);
     finally
       ProgressBar1.Position := 0;
       Screen.Cursor :=crDefault;
       OpenOracleDataSet(oRDERbY);
       memorial_DataModule.ODSMain.GotoBookmark(saveplace);
       memorial_DataModule.ODSMain.FreeBookmark(SavePlace);
     end;
end;


