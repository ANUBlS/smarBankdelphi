procedure TMemorial_project.InitalizeRpt;
var
    BankName,BankInn :String;
begin
   GetBankInfo(BankName,BankInn);

  if   CBCount.Checked  then
  begin

  if  RGBlanck.ItemIndex=0 then
     if  PrintOrShow=0 then
          //if True then

      with Memorial_Rpt2 do
        Preview else
      with Memorial_Rpt2 do
        Print


   else

   if  PrintOrShow=0 then

      with Memorial_Rpt1 do  begin
      if ordercount.Checked=false then

        QRExpr1.Enabled:=false
        else
        QRExpr1.Enabled:=true;
        Preview ;
        end else

      with Memorial_Rpt1 do
        Print
  end


  else
  Case   Index of
   0:
   begin
     Memorial_Rpt4.QRLBank.Caption :=BankName;
     Memorial_Rpt4.QRLVoin.Caption :=BankInn;
     Memorial_Rpt4.QRLDate1.Caption:=FormatDateTime('dd-mm-yyyy',DTPBegin.DateTime);
     Memorial_Rpt4.QRLDate2.Caption:=FormatDateTime('dd-mm-yyyy',DTPEnd.DateTime);
     Memorial_Rpt4.QRLDate2.Enabled:=(DTPBegin.Date<>DTPEnd.Date);
     if  CmbBoxForm.ItemIndex<>3 then
       Memorial_Rpt4.CurrencyLongName.Caption :=CmbBoxRate.Text
      else
       Memorial_Rpt4.CurrencyLongName.Caption :='Multi valyuta əməliyyatları ';

     if  PrintOrShow=0 then
      with Memorial_Rpt4 do
        Preview else
      with Memorial_Rpt4 do
        Print;
   end;
  1:
   begin
     Memorial_Rpt3.QRLBank.Caption :=BankName;
     Memorial_Rpt3.QRLVoin.Caption :=BankInn;
     Memorial_Rpt3.QRLDate1.Caption:=FormatDateTime('dd-mm-yyyy',DTPBegin.DateTime);
     Memorial_Rpt3.QRLDate2.Caption:=FormatDateTime('dd-mm-yyyy',DTPEnd.DateTime);
     Memorial_Rpt3.QRLDate2.Enabled:=(DTPBegin.Date<>DTPEnd.Date);
     if  CmbBoxForm.ItemIndex<>3 then
       Memorial_Rpt3.CurrencyLongName.Caption :=CmbBoxRate.Text
      else
       Memorial_Rpt3.CurrencyLongName.Caption :='Multi valyuta əməliyyatlar ';

       Memorial_Rpt3.QRLabel4.Enabled := CmbBoxForm.ItemIndex=3;
       Memorial_Rpt3.QRDBText8.Enabled := CmbBoxForm.ItemIndex=3;
       Memorial_Rpt3.QRShape3.Enabled := CmbBoxForm.ItemIndex=3;

      try
       with memorial_datamodule do
         IF (Copy(ODSMainVAL_ACC.ASString,1,2) ='AZ') and (Copy(ODSMainCURRENCYID_C.ASString,1,2) ='AZ') then
           Memorial_Rpt3.QRLXV.Caption:='Manatla'
         else
          Memorial_Rpt3.QRLXV.Caption:='Xarici valyutada';
      except
        on E: Exception do
          Memorial_Rpt3.QRLXV.Caption:='Xarici valyutada';
      end;

     if  PrintOrShow=0 then
      with Memorial_Rpt3 do
        Preview  else
      with Memorial_Rpt3 do
        Print;
   end;
   end;//case
end;
