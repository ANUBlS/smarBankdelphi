procedure TDMBudget.ArticlesDSTApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: String);
 var
  pname:string;
  numberofarticle:string;
   pstatus:integer;
begin
  with ArticlesDST do
    begin
       pname := FieldbyName('name').AsString;
       pstatus:= FieldbyName('status').Asinteger;
       numberofarticle := FieldbyName('numberofarticle').AsString;
    end;

     Applied := true;
  case Action of
      'I': ArticleID := ArticlesPkg.CallIntegerFunction('add_art',[pstatus,pname]);
     //'U': ArticlesPkg.callprocedure('edit_art', [ArticlesDST.Fieldbyname('id').asInteger,status,pname]) ;

       else  Applied := false
  end ;                         
  end;

