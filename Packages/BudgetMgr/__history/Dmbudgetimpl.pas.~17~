procedure TDMBudget.AddArtApplyRecord(Sender: TOracleDataSet; Action: Char;
  var Applied: Boolean; var NewRowId: String);
  var
  pname:string;
  numberofarticle:string;

begin
  with AddArt do
    begin
       pname := FieldbyName('name').AsString;
       numberofarticle := FieldbyName('numberofarticle').AsString;
    end;

     Applied := true;
  case Action of
      'I': ArticleID := ArticlesPkg.CallIntegerFunction('add_art',[status,pname]);
     // 'U': ArticlesPkg.callprocedure('edit_art', [ArticlesDST.Fieldbyname('id').asInteger,status,pname]) ;

       else  Applied := false
  end ;

   end;


