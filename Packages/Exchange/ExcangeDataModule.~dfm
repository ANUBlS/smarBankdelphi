  object Convertation: TOracleDataSet
    SQL.Strings = (
      'select * from'
      '('
      'select'
      '   dat'
      '  ,debitcurrency as currency'
      '  ,cID'
      '  ,max(fullpath) as fullpath'
      '  ,sum(debitrate)/count(*)  as AverageRate'
      '  ,sum(debitamount) as AverageAmount'
      '  ,max(status) as status'
      'from'
      '  convertation'
      'where'
      '  status = '#39'BUY'#39
      'group by'
      '   dat, debitcurrency, cID'
      ''
      'UNION'
      ''
      'select'
      '   dat'
      '  ,creditcurrency as currency'
      '  ,cID'
      '  ,max(fullpath) as fullpath'
      '  ,sum(creditrate)/count(*) as AverageRate'
      '  ,sum(creditamount) as AverageAmount'
      '  ,max(status) as status'
      'from'
      '  convertation'
      'where'
      '  status = '#39'SELL'#39
      'group by'
      '   dat, creditcurrency, cID'
      ''
      'Order by'
      '  dat, status)'
      'where'
      ' dat between :BeginDate and :EndDate'
      '    and status =:status'
      'Order by'
