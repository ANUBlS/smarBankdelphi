procedure TFrmExchange.ToolButton13Click(Sender: TObject);
var
   FirstDate,LastDate:variant;
begin
 if ExchangeViewer.CanFocus then
  ExchangeViewer.SetFocus;
 Screen.Cursor:=crHourGlass;
 ProgressBar.Show;
 ProgressBar.Position :=0;
 try
  ProgressBar.StepBy(30);
  FirstDate:=integer(trunc(DateTimePicker1.DateTime));
  LastDate:=integer(trunc(DateTimePicker2.DateTime));
  ProgressBar.StepBy(30);
 with ExchangeDataMod do
  begin
   Exchange.Close;
   Exchange.SetVariable('BeginDate',FirstDate);
   Exchange.SetVariable('EndDate',LastDate);
   ProgressBar.StepBy(40);
   Exchange.Open;
  end;
 finally
  Screen.Cursor:=crDefault;
  ProgressBar.Hide;
 end;
end;

