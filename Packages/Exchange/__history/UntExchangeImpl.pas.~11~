  ExchangeViewer.SetFocus;
 Screen.Cursor:=crHourGlass;
 ProgressBar.Show;
 ProgressBar.Position :=0;
 try
  ProgressBar.StepBy(30);
  FirstDate:=integer(trunc(DateTimePicker1.DateTime));
  LastDate:=integer(trunc(DateTimePicker2.DateTime));
