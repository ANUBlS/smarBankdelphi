procedure TFrmExchange.MouseWheelHandler(var Message: TMessage);
begin
 Inherited;
 if (ExchangeViewer.Focused) and not(ExchangeViewer.DataSource.DataSet.IsEmpty) then
  begin
   with TCMMouseWheel(Message), ExchangeViewer.DataSource.DataSet do
    if WheelDelta < 0 then
      Next
    else
      Prior;
   ExchangeViewer.Repaint;
  end
 else
  begin
   if (ConvertationViewer.Focused) and not(ConvertationViewer.DataSource.DataSet.IsEmpty) then
    with TCMMouseWheel(Message), ConvertationViewer.DataSource.DataSet do
     if WheelDelta< 0 then
       Next
     else
       Prior;
    ConvertationViewer.Repaint;
  end;
end;

procedure TFrmExchange.ActiveFormCreate(Sender: TObject);
begin
  FrmExchange :=Self;
  //*
  ExchangeDataMod :=TExchangeDataMod.Create(self);
  ExchangeRep :=TExchangeRep.Create(self);
  QRExchangeView :=TQRExchangeView.Create(self);
  QRDetConvert :=TQRDetConvert.Create(self);
  DefaultReport :=TQuickRep.Create(Self);
  DefaultReport :=QRDetConvert;
  DefaultDataSet :=TOracleDataSet(DefaultReport.DataSet);
  //*
  FrmAddExchange :=TFrmAddExchange.Create(Self);
  FrmAddAccount :=TFrmAddAccount.Create(Self);
  FrmPrint :=TFrmPrint.Create(self);
  ExchangeDataMod.ViewGrid.Active :=True;
  ExchangeDataMod.ODSTooling.Open;
  ExchangeDataMod.Grid2.Active :=True;
  DateTimePicker1.Date :=getBankDay;
  DateTimePicker2.Date :=getBankDay;
  DTPCBeginDate.Date :=getBankDay;
  DTPCEndDate.Date :=getBankDay;
  RateIndex :=0;
   with   FrmAddAccount.Combobox1.Items  do
     Clear;
   with  ExchangeDataMod.ForMoney  do
  begin
    Open;
    SetLength(Rate,RecordCount);
    First;
    while  not EOF  do
    begin
      Rate[RateIndex] :=FieldByName('Valute').AsInteger;
      FrmAddAccount.combobox1.Items.Add(FieldByName('Valu_Name').AsString);
      Inc(RateIndex);
      Next;
    end;
  end;
  ProgBar.Hide;
  ProgressBar.Hide;
 SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);
end;




