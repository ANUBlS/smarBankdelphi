procedure TFrmExchange.ActionFileExecute(Sender: TObject);
var
   DBaseName,TblName:String;
   Path  :String;
   lpExistingFileName :array [0..255] of Char;
   lpNewFileName :array [0..255] of Char;
begin
 if PageControl.ActivePage.Name <>'TabSheetExchange' then Exit;

 Path :=ExtractFilePath(Application.ExeName)+'EXCH122.dbf';
 StrPCopy(lpExistingFileName,Path);
 StrPCopy(lpNewFileName,Edit1.Text);
TRY
 if  FileExists(Edit1.Text) then
   if  MessageDlg(
           Format('Overrite the Existing File ?'+#13+' %s  ',[Edit1.Text])
           ,mtConfirmation
           ,MBYESNOCANCEL,0
        )<>mrYes  then  Exit;
   //ShowMessage('www.Smart.az');
   if not CopyFile(lpExistingFileName,lpNewFileName,False) then
   begin
     ShowMessage('File Creation UnSuccesful Terminated!');
     Exit;
   end;
   DBaseName :=ExtractFileDir(Edit1.Text);
   TblName  :=ExtractFileName(Edit1.Text);

with   TblExchange  do
 Begin
  if  Active  then  Close;
  DatabaseName :=DBaseName;
  TableName :=TblName;
  TblExchange.Open;
  if not ExchangeDataMod.Exchange.Active then
   ExchangeDataMod.Exchange.Open;
  ExchangeDataMod.Exchange.First;
  ExchangeDataMod.ODSBankCode.Open;
  While not(ExchangeDataMod.Exchange.Eof) do
  begin
   with ExchangeDataMod do
   begin
   Insert;
   // FieldByName('MANAT1').AsInteger :=Exchange.FieldByName('SellEquivalent').AsInteger;

    FieldByName('WHEN').AsDateTime :=Exchange.FieldByName('Dat').AsDateTime;
    FieldByName('BANK_CODE').AsString :=ODSBankCode.FieldByName('NB').AsString;
    FieldByName('VALUTE').AsString :=Exchange.FieldByName('InterCode').AsString;
    FieldByName('RATE1').AsString :=Exchange.FieldByName('SellRate').AsString;
    FieldByName('TOTAL1').AsInteger :=Exchange.FieldByName('SellAmmount').AsInteger;
    FieldByName('MANAT1').ASString :=Exchange.FieldByName('SellEquivalent').AsString;
    FieldByName('RATE2').AsString :=Exchange.FieldByName('BuyRate').AsString;
    FieldByName('TOTAL2').AsInteger :=Exchange.FieldByName('BuyAmmount').AsInteger;
    FieldByName('MANAT2').AsString :=Exchange.FieldByName('BuyEquivalent').AsString;
   Post;
   Exchange.Next;
   end;
 end;
 ShowMessage('Creating  file was succesful!');
 ExchangeDataMod.ODSBankCode.Close;
 End;
EXCEPT
 //ShowMessage('Creating  file Unsuccesful terminated!');
 Raise;
END;
end;

