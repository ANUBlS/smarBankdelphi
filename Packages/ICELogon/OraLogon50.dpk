package OraLogon50;

{$R *.RES}
{$R 'ICEOralogon.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Oracle Logon'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  Vcldb50,
  DOA40d5,
  Crypt50;

contains
  ICEOralogon in 'ICEOralogon.pas',
  uLogonImpl in 'uLogonImpl.pas' {frmLogon};

end.
