procedure TMemorial.BitBtnRunClick(Sender: TObject);
var
    DebtKred :Integer;
    BalanceType:1..4;
begin
 try
    DebtKred :=0;
    ProgressBar.StepBy(10);
  case CmbBoxForm.ItemIndex of
    0:
      begin  
        Screen.Cursor :=crSQLWait;
        sb_Memorial(Trunc(DTPBegin.DateTime),Trunc(DTPEnd.DateTime),Rate[RateIndex],1,0,'',Word(CheckBoxDifference.Checked),-1,Word(CBUseBalance.Checked),RGTransMode.ItemIndex);
        ProgressBar.StepBy(30);
        OpenOracleDataSet(OrderBy);
        ProgressBar.StepBy(20);
        Screen.Cursor :=crDefault;
      end;
    1:
      begin
         with  FormFilter do
         if  ShowModal<>mrOk then
          Abort;
         Screen.Cursor :=crSQLWait;
         with  FormFilter do begin
         if  (CBDebt.Checked) then
           DebtKred :=0;
         if  (CBKred.Checked) then
           DebtKred :=1;
         if  (CBDebt.Checked) and (CBKred.Checked) then
           DebtKred :=2;
         if ((not(CBDebt.Checked))and(not(CBKred.Checked))) then
           DebtKred :=-1;
         end;
         if   FormFilter.ComboBoxPlan.Enabled then
         BalanceType:=FormFilter.ComboBoxPlan.ItemIndex+1 else
         BalanceType :=1;
         sb_Memorial(Trunc(DTPBegin.DateTime),Trunc(DTPEnd.DateTime),Rate[RateIndex],BalanceType,Word(FormFilter.CheckBoxBalance.Checked),FormFilter.EditBalList.Text,Word(CheckBoxDifference.Checked),DebtKred,Word(CBUseBalance.Checked),RGTransMode.ItemIndex);
         ProgressBar.StepBy(30);
         OpenOracleDataSet(OrderBy);
         ProgressBar.StepBy(20);
         Screen.Cursor :=crDefault;
      end;

    2:begin
        Screen.Cursor :=crSQLWait;
        sb_Memorial(Trunc(DTPBegin.DateTime),Trunc(DTPEnd.DateTime),Rate[RateIndex],1,0,'',Word(CheckBoxDifference.Checked),-1,Word(CBUseBalance.Checked),RGTransMode.ItemIndex,1);
        ProgressBar.StepBy(30);
        OpenOracleDataSet(OrderBy);
        ProgressBar.StepBy(20);
        Screen.Cursor :=crDefault;
      end;
  end;

  if   CBReport.Checked   then
    InitalizeRpt(Word((Rate[RateIndex]<>0)),ComboBoxPrintMode.ItemIndex);

  ProgressBar.StepBy(40);
  ProgressBar.Position:=0;

