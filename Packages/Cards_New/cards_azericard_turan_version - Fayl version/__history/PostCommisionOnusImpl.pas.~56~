procedure TPostCommisionOnus.Sil1Click(Sender: TObject);
var
   Index , countafte, countbefo:Integer;
   WaitNextConfirm, WillRefresh: Boolean;
   TID :Integer;
begin


  WaitNextConfirm :=True;
  WillRefresh :=False;
  if DBGrid2.CanFocus then
  DBGrid2.SetFocus;

  //Focus;
  countbefo:=DBGrid2.DataSource.DataSet.RecordCount;
  with  DBGrid2, SelectedRows, DataSource.DataSet, DataMod_CARDS do
  try
    if Count = 0 then CurrentRowSelected := True;



    for  Index :=0 to  Count - 1 do
    begin
      GotoBookmark(Pointer(Items[Index]));
      TID :=FieldbyName('ID').AsInteger;

      if  WaitNextConfirm  then
      {case MessageDlg(
        Format('Məlumatı silinsin? ',[TID])
       ,mtConfirmation
       ,[mbYes, mbNo ,mbCancel ,mbYesToAll]
       ,0
       )   of
        mrNo       : begin Continue;  end;
        mrCancel   : begin Break; end;
        mrYesToAll :  }
          if MessageDlg(Format('%d  sayda  əməliyyat silinsinmi?', [Count - Index]), mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
           WaitNextConfirm :=False
          else
           Continue;
      //end;
      Application.ProcessMessages;
      //------------------------------------------------------------------------------------create prows

                DataMod_CARDS.card_commission_our_pos_onus.CallProcedure('del_card_messages_comm_commit',[TID]) ;


      WillRefresh :=True;


    end;
  finally
   if WillRefresh then


   begin

                          DBGrid1.DataSource.DataSet.Refresh;
                          DBGrid2.DataSource.DataSet.Refresh;
                          countafte:=DBGrid2.DataSource.DataSet.RecordCount;
                          if countafte<0 then
                          begin
                            countafte:=countafte*(-1);
                          end;
                          countafte:=countbefo-countafte;
                          ShowMessage(inttostr(countafte)+' sayda seçilmiş əməliyyat silindi!');




   end; //else Excel.Workbooks.close;

  end;


end;

