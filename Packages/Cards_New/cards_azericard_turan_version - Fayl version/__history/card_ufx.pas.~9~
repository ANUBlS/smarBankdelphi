unit card_ufx;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Grids, DBGrids,unit18, ImgList, StdCtrls, ExtCtrls;

type
  TUFXFORM = class(TForm)
    DBGrid1: TDBGrid;
    Panel1: TPanel;
    Button1: TButton;
    ImageList1: TImageList;
    Button2: TButton;
    procedure FormShow(Sender: TObject);
    procedure DBGrid1DrawColumnCell(Sender: TObject; const Rect: TRect;
      DataCol: Integer; Column: TColumn; State: TGridDrawState);
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  UFXFORM: TUFXFORM;

implementation

uses arxivufx;

{$R *.dfm}

procedure TUFXFORM.Button1Click(Sender: TObject);
begin
 with  DataMod_CARDS.Card_inn do begin
       refresh;
 end;
end;

procedure TUFXFORM.Button2Click(Sender: TObject);
begin
UFX_ARXIV:=TUFX_ARXIV.create(self)  ;
UFX_ARXIV.ShowModal;
end;

procedure TUFXFORM.DBGrid1DrawColumnCell(Sender: TObject; const Rect: TRect;
  DataCol: Integer; Column: TColumn; State: TGridDrawState);
  var ImageIndex:integer;
begin
with Sender as TDBGrid do
  begin
    if DataSource.DataSet.RecordCount <> 0 then
    begin
      case DataSource.DataSet.FieldByName('STATUS').AsInteger of
      0 :
        ImageIndex := 13;
      1 :
        ImageIndex := 29;
      2 :
        ImageIndex := 3;
      3:
        ImageIndex :=0;

      else
      end;
      if (DataCol = 1) and (ImageIndex <> -1) then
        ImageList1.Draw(Canvas, Rect.Left, Rect.Top, ImageIndex, True)
      else
        DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;
  end;

  {if dbgrid1.DataSource.DataSet.FieldByName('info').AsString='Succes' then
       begin
         dbgrid1.Canvas.Brush.Color:=Clred;
         dbgrid1.DefaultDrawColumnCell(rect,datacol,column,state);
       end;    }

end;

procedure TUFXFORM.FormShow(Sender: TObject);
begin
DataMod_CARDS.Card_inn.Close;
DataMod_CARDS.Card_inn.open;
DataMod_CARDS.Card_inn.Active:=true;
end;

end.
