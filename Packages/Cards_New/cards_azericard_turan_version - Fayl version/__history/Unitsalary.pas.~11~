procedure TSalary.ToolButton3Click(Sender: TObject);
var  transamount,v_transamount:real;
ij :integer;


   vcardtype,resp,RespText,ufxrrn,pcardnumber,valyutaname,descript,cardnumber,cardtype,descp,valyuta:string;
begin

for ij:= 0 to DataMod_CARDS.salarybase2.RecordCount-1 do
begin


 if DataMod_CARDS.card.CallIntegerFunction('CardCheck',[DataMod_CARDS.salarybase2.fieldbyName('id').asinteger,9])>0 then
         begin
             if DataMod_CARDS.card.CallFloatFunction('UfxCheck',[DataMod_CARDS.salarybase2.fieldbyName('id').asinteger])=0 then
            begin    //ufxsend;
             DataMod_CARDS.card.CallProcedure('Ufx_send',[DataMod_CARDS.salarybase2.fieldbyName('id').asinteger,9,vcardtype,pcardnumber,valyutaname,transamount,descript]) ;
             v_transamount:=DataMod_CARDS.card.GetParameter(5);
             cardnumber:= DataMod_CARDS.card.GetParameter(3);
             cardtype:=  DataMod_CARDS.card.GetParameter(2);
             descp:= DataMod_CARDS.card.GetParameter(6);
             valyuta:=DataMod_CARDS.card.GetParameter(4) ;

              //  resp:='qqwqw#Successfully processed';
             // ShowMessage('y');
             resp:=UFX71.GetUFX7.fundstransfer(cardnumber,cardtype,FormatDateTime('YYYY-MM-DD hh:mm:ss',now),descp,valyuta,floattostr(v_transamount)) ;


             ufxrrn:=copy (resp,0,pos('#',resp));

             RespText:= copy (resp,pos('#',resp)+1,length(resp));
               // ShowMessage(  resp);
                DataMod_CARDS.card.callprocedure('UfxResponse',[DataMod_CARDS.salarybase2.fieldbyName('id').asinteger,9,RespText,v_transamount,resp]) ;

                 if UPPERCASE(RespText)=UPPERCASE('Successfully processed')
             then
               begin
               DataMod_CARDS.card.callprocedure('ufxsucces',[DataMod_CARDS.salarybase2.fieldbyName('id').asinteger]) ;

               //  ShowMessage('Əməliyyat uğurla keçdi!!!');
            {  SwDataModule.sw_in_insert.CallProcedure('add_in_transactions2',[fieldbyName('id').asinteger,
                                                                  fieldbyName('bic').AsString,
                                                                  fieldbyName('ACOUNT').AsString,
                                                                  fieldbyName('valu').AsFloat,
                                                                  fieldbyName('description').asstring,
                                                                  fieldbyName('description2').asstring,
                                                                  fieldbyName('TAX').asstring]);   }
               end
             else
               begin
                 //ShowMessage('Əməliyyat keçmədi!!!'+','+'Səhvin adı:'+RespText);
                 DataMod_CARDS.card.callprocedure('ufxerror',[DataMod_CARDS.salarybase2.fieldbyName('id').asinteger]) ;


                // Exit;
               end;
            end
            else
              begin
              DataMod_CARDS.salarybase2.Refresh;
              {  SwDataModule.sw_in_insert.CallProcedure('add_in_transactions2',[fieldbyName('id').asinteger,
                                                                  fieldbyName('bic').AsString,
                                                                  fieldbyName('ACOUNT').AsString,
                                                                  fieldbyName('valu').AsFloat,
                                                                  fieldbyName('description').asstring,
                                                                  fieldbyName('description2').asstring,
                                                                  fieldbyName('TAX').asstring]);   }
              end;
          end
          else
       begin

       end;
    DataMod_CARDS.salarybase2.Next
end;
end;

