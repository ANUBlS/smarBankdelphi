function otherdate(otherd:tdate;tip:boolean):string;
var  str:String;
begin
if tip then
begin
   case strtoint(formatdatetime('mm',date)) of
        1: str:='JAN';
        2: str:='FEB';
        3: str:='MAR';
        4: str:='APR';
        5: str:='MAY';
        6: str:='JUN';
        7: str:='JLY';
        8: str:='AUG';
        9: str:='SEP';
        10: str:='OCT';
        11: str:='NOV';
        12: str:='DEC';
        end;
   Result:= FormatDateTime('dd ',otherd)+str+FormatDateTime(' yy',otherd);
end else
begin
   Result:=FormatDateTime('dd',otherd)+'/'+FormatDateTime('mm',otherd)+'/'+FormatDateTime('yy',otherd);
end;
end;

function MonthIntNum(MonthStr:String):Integer;
var IntNum :Integer;
begin
  if MonthStr = 'JAN' then IntNum :=1;
  if MonthStr = 'FEB' then IntNum :=2;
  if MonthStr = 'MAR' then IntNum :=3;
  if MonthStr = 'APR' then IntNum :=4;
  if MonthStr = 'MAY' then IntNum :=5;
  if MonthStr = 'JUN' then IntNum :=6;
  if MonthStr = 'JUL' then IntNum :=7;
  if MonthStr = 'AUG' then IntNum :=8;
  if MonthStr = 'SEP' then IntNum :=9;
  if MonthStr = 'OCT' then IntNum :=10;
  if MonthStr = 'NOV' then IntNum :=11;
  if MonthStr = 'DEC' then IntNum :=12;
  Result :=IntNum;
end;









