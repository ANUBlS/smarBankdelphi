procedure Tverification.Button2Click(Sender: TObject);
begin

if MessageDlg('Seçilmiş sütunu verifikasiya etmək istəyirsinizmi?',mtInformation,[mbYes,mbNo],0)=mryes then
DataMod_CARDS.mainpacket.CallProcedure('verifi',[DBGrid1.DataSource.DataSet.fieldbyname('id').asinteger]);
DBGrid1.DataSource.DataSet.Refresh;
end;

procedure Tverification.Button5Click(Sender: TObject);
begin
if MessageDlg('Seçilmiş sütunu verifikasiya etmək istəyirsinizmi?',mtInformation,[mbYes,mbNo],0)=mryes then
DataMod_CARDS.mainpacket.CallProcedure('verifi',[DBGrid2.DataSource.DataSet.fieldbyname('id').asinteger]);
DBGrid2.DataSource.DataSet.Refresh;
end;

procedure Tverification.FormActivate(Sender: TObject);
begin
DataMod_CARDS.urgent2.Open;
DataMod_CARDS.simple2.Open;
end;

procedure Tverification.FormCreate(Sender: TObject);
begin
SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure Tverification.Button1Click(Sender: TObject);
begin
DataMod_CARDS.urgent2.Close;
DataMod_CARDS.urgent2.SetVariable('dat1',integer(trunc(DateTimePicker1.DateTime)));
DataMod_CARDS.urgent2.open;
DataMod_CARDS.simple2.Close;
DataMod_CARDS.simple2.SetVariable('dat1',integer(trunc(DateTimePicker1.DateTime)));
DataMod_CARDS.simple2.open;
end;

procedure Tverification.FormShow(Sender: TObject);
begin
DateTimePicker1.DateTime:=date;
DataMod_CARDS.urgent2.Close;
DataMod_CARDS.urgent2.SetVariable('dat1',integer(trunc(DateTimePicker1.DateTime)));
DataMod_CARDS.simple2.Close;
DataMod_CARDS.simple2.SetVariable('dat1',integer(trunc(DateTimePicker1.DateTime)));
DataMod_CARDS.urgent2.open;
DataMod_CARDS.simple2.open;
Button6.Click;
Button7.Click;
end;

procedure Tverification.Button3Click(Sender: TObject);
begin
  if not CMExcelExport1.Connected then CMExcelExport1.Connect;
  CMExcelExport1.ExportDataset(DataMod_CARDS.urgent2,'Verification',true);
  CMExcelExport1.Disconnect;
end;

procedure Tverification.Button4Click(Sender: TObject);
begin
  if not CMExcelExport1.Connected then CMExcelExport1.Connect;
  CMExcelExport1.ExportDataset(DataMod_CARDS.simple2,'Verification',true);
  CMExcelExport1.Disconnect;
end;

end.
