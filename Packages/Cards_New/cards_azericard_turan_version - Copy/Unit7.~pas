procedure TFormSearch.ButtonCICardClick(Sender: TObject);
var I:integer;
    strsql: String;
begin
   if ButtonCICard.Down then
   begin
     Datamod_cards.ClienList.Active:=false;
     Datamod_cards.ClienList.sql.clear;
     strsql:='Select clients.rowid, clients.* from cardmanager.clients where (clients.messtype<3) ORDER BY length(RefInteger),RefInteger';
     Datamod_cards.ClienList.sql.Add(StrSql);
     Datamod_cards.ClienList.Active:=true;
     ComCIType.items.Clear;
     ComCIType.Items.Add('ALL');
     Datamod_cards.ClientSearch.Active:=false;
     Datamod_cards.ClientSearch.sql.Clear;
     Datamod_cards.ClientSearch.sql.Add('Select distinct(name) from cardmanager.cards');
     Datamod_cards.ClientSearch.Active:=true;
     if Datamod_cards.ClientSearch.RecordCount > 0 then
     begin
        Datamod_cards.ClientSearch.First;
        while not Datamod_cards.ClientSearch.Eof do
        begin
          ComCIType.Items.Add(Datamod_cards.ClientSearch.fieldbyname('name').AsString);
          Datamod_cards.ClientSearch.Next;
        end;
     end;
     Datamod_cards.ClientSearch.Active:=false;
     Datamod_cards.ClientSearch.sql.Clear;
     Datamod_cards.ClientSearch.sql.Add('Select distinct(cardtype) from cardmanager.clients where (messtype=1)or(messtype=2)');
     Datamod_cards.ClientSearch.Active:=true;
     if Datamod_cards.ClientSearch.RecordCount > 0 then
     begin
        Datamod_cards.ClientSearch.First;
        while not Datamod_cards.ClientSearch.Eof do
        begin
          if ComCIType.Items.IndexOf(Datamod_cards.ClientSearch.fieldbyname('cardtype').AsString) = -1 then
          ComCIType.Items.Add(Datamod_cards.ClientSearch.fieldbyname('cardtype').AsString);
          Datamod_cards.ClientSearch.Next;
        end;
     end;
   ComCIType.ItemIndex:=0;
   ComboCISearch.ItemIndex:=0;
   for i:=2 to 27 do  DBGridMainCard.Columns[i].Visible:=true;
   for i:=28 to 30 do DBGridMainCard.Columns[i].Visible:=false;
  end;
end;

