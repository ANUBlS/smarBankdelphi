        ', z.kod AS kod,'
      '       m.val_name AS valyuta, TO_CHAR (z.accid28) AS hesab_28,'
      
        '       TO_CHAR (z.accid48) AS hesab_48, NULL AS hesab_64, z.dili' +
        'ng_gelir,'
