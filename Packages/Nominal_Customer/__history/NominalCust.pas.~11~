{$R *.dfm}

 procedure GetPath;
var
  ImagesPath: String;

begin
  ImagesPath := Format('%s\..\Env\Customers', [ExtractFilePath(ParamStr(0))]);
  Path := Format('%s\temp.jpg', [ImagesPath]);
  Path_B := Format('%s\blank.jpg', [ImagesPath]);
end;

  procedure Fill_Edit;
   var
  F: File of byte;
  begin
  GetPath;
   if ( CustNomData.DScustimageStamp.IsNull) then
  begin
    NomCust.Image2.Picture.LoadFromFile(Path_B);
    { --no record - godda empty Image1-- }
  end
  else
  begin
    CustNomData.DScustimageStamp.SaveToFile(Path);
    AssignFile(F, Path);
    Reset(F);
    if FileSize(F) > 0 then
    begin
      CloseFile(F);
      NomCust.Image2.Picture.LoadFromFile(Path);

    end
    else
    begin
      CloseFile(F);
      NomCust.Image2.Picture.LoadFromFile(Path_B);
    end;
  end;

   if (CustNomData.DScustimageCUSTSIGN.IsNull) then
  begin
    NomCust.Image1.Picture.LoadFromFile(Path_B);
   end
  else
  begin
    CustNomData.DScustimageCUSTSIGN.SaveToFile(Path);
    AssignFile(F, Path);
    Reset(F);
    if FileSize(F) > 0 then
    begin
      CloseFile(F);
      NomCust.Image1.Picture.LoadFromFile(Path);
     end
    else
    begin
      CloseFile(F);
      NomCust.Image1.Picture.LoadFromFile(Path_B);
    end;
  end;

  end;


