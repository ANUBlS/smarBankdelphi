  ReserveAccounts.Text := ReserveAccounts.DataSource.DataSet.FieldByName('Acc_No').AsString;
end;

procedure TOrderForm.Button1Click(Sender: TObject);
  function  ReportDataAsStr : WideString;
  const
    N1 = ' є ли щесаблашма щесабындан ';
    N2 = ' - жи ил тарихин€ кими кредит€ щесабланмыш фаиз€ сил€синиз ';
    N3 = ' ж€рим€ санксийасына сил€синиз. ';
  var
    ResultStr : WideString;
    CName ,CSName : String;
    a1,a2,a3,a4 : WideString;
    ca1,ca2,ca3,ca4 : WideString;
    MainDebt,Interest,Reserve,Penalty : WideString;
  begin
    CName :=  '  ' + CBCurrencys.ListSource.DataSet.FieldByName('Valu_name').AsString + '  ';
    CSName := '  ' + CBCurrencys.ListSource.DataSet.FieldByName('Valu_Bala').AsString + '  ';
    ResultStr :='';

    if RBUserType.ItemIndex <> -1 then
      ResultStr := RBUserType.Items[RBUserType.ItemIndex]+'  ';

    ResultStr := ResultStr + ContractAccounts.DataSource.DataSet.FieldByName('Name').AsString + ' '
         + ContractAccounts.DataSource.DataSet.FieldByName('Acc_No').AsString + ' ' + N1;
    MainDebt :='';
    Interest :='';
    Reserve :='';
    Penalty :='';
    if  CBF.Checked then
    begin

      if Trim(FacticalDebtEdit.Text) <> '' then
      begin
       MainDebt := FacticalDebtEdit.Text ;
       a1 := ' ('+CurrencyToHR_Azeri(StrToInt(FacticalDebtEdit.Text),0,[]) + ' ' + CName ;
      end else
       a1 := ' (';

      if Trim(C1.Text) <> '' then
      begin
       MainDebt := MainDebt + S1.Text + C1.Text;
       ca1 := CurrencyToHR_Azeri(StrToInt(c1.Text),0,[]) + ' ' + CSName + ')';
      end else
       ca1 :=')';

      MainDebt := MainDebt + a1 + ca1 + ' ' + RGDescription.Items[RGDescription.ItemIndex] ;

    end;//cbf

    if  CBI.Checked then
    begin

      if Trim(InterestDebtEdit.Text) <> '' then
      begin
       Interest := InterestDebtEdit.Text ;
       a2 := ' ('+CurrencyToHR_Azeri(StrToInt(InterestDebtEdit.Text),0,[]) + ' ' + CName ;
      end else
       a2 := ' (';

      if Trim(C2.Text) <> '' then
      begin
       Interest := Interest + S2.Text + C2.Text;
       ca2 := CurrencyToHR_Azeri(StrToInt(c2.Text),0,[]) + ' ' + CSName + ')';
      end else
       ca2 :=') ';

      Interest := Interest + a2 + ca2 + ' ' + FormatDateTime('dd/mm/yyyy',DTPSysdate.Date) + N2;

    end;//cbf

    if  CBP.Checked then
    begin

      if Trim(PenaltyEdit.Text) <> '' then
      begin
       Penalty := PenaltyEdit.Text ;
       a4 := ' ('+CurrencyToHR_Azeri(StrToInt(PenaltyEdit.Text),0,[]) + ' ' + CName ;
      end else
       a4 := ' (';

      if Trim(C4.Text) <> '' then
      begin
       Penalty := Penalty + S4.Text + C4.Text;
       ca4 := CurrencyToHR_Azeri(StrToInt(c4.Text),0,[]) + ' ' + CSName + ')';
      end else
       ca4 :=')';

      Penalty := ' в€ ' + Penalty + a4 + ca4 + ' ' + N3;

    end;//cbf

    if  CBR.Checked then
    begin

      if Trim(ReserveDebtEdit.Text) <> '' then
      begin
       Reserve := ReserveDebtEdit.Text ;
       a3 := ' ('+CurrencyToHR_Azeri(StrToInt(ReserveDebtEdit.Text),0,[]) + ' ' + CName ;
      end else
       a3 := ' (';

      if Trim(C3.Text) <> '' then
      begin
       Reserve := Reserve + S3.Text + C3.Text;
       ca3 := CurrencyToHR_Azeri(StrToInt(c3.Text),0,[]) + ' ' + CSName + ')';
      end else
       ca3 :=')';

      Reserve := Reserve + a3 + ca3+ ' (' + ReserveAccounts.DataSource.DataSet.FieldByName('Acc_No').AsString
                + ') '+ RGReserveDescription.Items[RGReserveDescription.ItemIndex] ;

    end;//cbf


    ResultStr := ResultStr + MainDebt + ',' + Interest + Reserve  + Penalty ;
    
    Result := ResultStr;
  end;
begin
  with OrderRpt do
  begin
    QRMemo.Lines.Text :=ReportDataAsStr;
    QRLContractNum.Caption := ContractNumEdit.Text;
    Chef.Caption := Edit1.Text;
    CreditChef.Caption := Edit2.Text;
    Manager.Caption := Edit3.Text;
    QRLDate.Caption := FormatDateTime('dd/mm/yyyy',DTPSysdate.Date);
    Preview
  end;
end;

procedure TOrderForm.CBCurrencysChange(Sender: TObject);
begin
  ContractAccounts.Text :='';
  ReserveAccounts.Text :='';
end;

procedure TOrderForm.ContractAccountsKeyPress(Sender: TObject;
  var Key: Char);
var
  ID : integer;
begin
  if Key = #13 then
  begin
    ID := (Sender as TSearchEdit).DataSource.DataSet.FieldByName('KLI_ID').AsInteger;
    ReserveAccounts.DataSource.DataSet.Locate('KLI_ID',ID,[]);
    ReserveAccounts.Text := ReserveAccounts.DataSource.DataSet.FieldByName('ACC_NO').AsString;
  end;
end;

