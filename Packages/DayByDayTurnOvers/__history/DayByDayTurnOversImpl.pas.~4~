procedure TfrmDayByDayTurnOvers.ActiveFormCreate(Sender: TObject);
begin
  DataModuleMain := TDataModuleMain.Create(Self);
  DateTimePicker1.DateTime := DataModuleMain.BankDate.FieldByName('TEK_DAT').AsDateTime;
  DateTimePicker2.DateTime := DataModuleMain.BankDate.FieldByName('TEK_DAT').AsDateTime;
  SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);
end;

procedure TfrmDayByDayTurnOvers.Button1Click(Sender: TObject);
begin
  Screen.Cursor := crSQLWait;
  try
    with DataModuleMain.TurnOvers do
    begin
      if Active then CloseAll;
      ClearVariables;
      SetVariable('FirstDate',Integer(Trunc(DateTimePicker1.DateTime)));
      SetVariable('LastDate',Integer(Trunc(DateTimePicker2.DateTime)));
      Open;
      ExpTurnOvers.Connect;
      ExpTurnOvers.ExportDataset(DataModuleMain.TurnOvers,'TurnOvers',True);
    end;
  finally
    Screen.Cursor := crDefault 
  end;
end;

