        '        not EXISTS(select SUSER from sba_userman where MUSER=uid' +
        ' and (type#=1 or type#=0)))'
      '        or'
      
        '        (P.OP_ID in(select SUSER from sba_userman where MUSER=ui' +
        'd and (type#=1 or type#=0))))'
