procedure TP_Customers_Form.N6Click(Sender: TObject);
var
  ValuteName, withManat, NoManat, WithCoin: string;
  ManatPosition, i: Integer;
  CustName, CustInn: string;
  TransactionID: string;
begin
  { CO_DataMod.Transactions.open;
    id :=CO_DataMod.Transactions.FieldByName('id').asstring;
    try
    with CO_Report,CO_DataMod.Transactions do
    begin
    Filter:=' id= '+id;
    Filtered :=true;
    Preview; }
  If P_DataModule.Transactions.IsEmpty then
  begin
    ShowMessage(no_selected_trans);
    Exit;
  end
  else
  begin
    NoManat := '';
    try
      with P_DataModule.Transactions do
      begin
        GetCustomerInfo(FieldByName('creditid').asInteger, CustName, CustInn);
        TransactionID := FieldByName('ID').asstring;
        Filter := ' ID=' + TransactionID;
        Filtered := True;
      end;
      with P_DataModule, ODSValuteName do
      begin
        Close;
        SetVariable('valute',
          Transactions.FieldByName('debitcurrencyid').Value);
        ODSValuteName.Open;
        ValuteName := AnsiLowerCase(FieldByName('Valu_name').asstring);
      end;

      withManat := CurrencyToHR_Azeri
        (trunc(P_DataModule.Transactions.FieldByName('creditamount')
        .AsFloat), 0, [0]);
      ManatPosition := POS('manat', withManat);
      if ManatPosition > 0 then
        for i := 1 to ManatPosition - 1 do
          NoManat := NoManat + withManat[i];

      WithCoin := FloatToStr
        (Frac(StrToFloat(P_DataModule.Transactions.FieldByName('creditamount')
        .asstring)));
      if WithCoin <> '0' then
      begin
        Delete(WithCoin, 1, 2);
        if Length(WithCoin) < 2 then
          WithCoin := WithCoin + '0'
        else if Length(WithCoin) > 2 then
          Delete(WithCoin, 3, Length(WithCoin));
        WithCoin := WithCoin + ' ' + P_DataModule.ODSValuteName.FieldByName
          ('valu_bala').asstring;
      end { if WithCoin<>'0' }
      else
        WithCoin := '';

      ValuteName := AnsiLowerCase(P_DataModule.ODSValuteName.FieldByName
        ('Valu_name').asstring + '  ' + WithCoin);

      if NoManat = EmptyStr then
        NoManat := '0 ';
      if not Assigned(P_CO_Report) then
        P_CO_Report := TP_CO_Report.Create(Self);
      P_CO_Report.ODSBank.Open;
      P_CO_Report.QRAMMOUNT1.Caption := NoManat + ValuteName;
      P_CO_Report.QRAMMOUNT2.Caption := NoManat + ValuteName;
      P_CO_Report.Preview;
    finally
      with P_DataModule.Transactions do
        Filtered := False;
      P_CO_Report.ODSBank.Close;

    end;
  end;
end;


