    QuickReportORDER.QRLabel52.Enabled := True;
  end;

  // ------------------------------------------Modified by for AZNEQ.BANK on 17.08.2006
  if trim(P_DataModule.settings.FieldByName('controller_out').asstring)
    = '1' then
  begin
    QuickReportORDER.QRShape91.Enabled := True;
    QuickReportORDER.QRLabel90.Enabled := True;
    QuickReportORDER.QRShape93.Enabled := True;
    QuickReportORDER.QRLabel92.Enabled := True;
    QuickReportORDER.QRShape95.Enabled := True;
    QuickReportORDER.QRLabel94.Enabled := True;
  end;
  if trim(P_DataModule.settings.FieldByName('controller_out').asstring)
    = '0' then
  begin
    QuickReportORDER.QRShape91.Enabled := False;
    QuickReportORDER.QRLabel90.Enabled := False;
    QuickReportORDER.QRShape93.Enabled := False;
    QuickReportORDER.QRLabel92.Enabled := False;
    QuickReportORDER.QRShape95.Enabled := False;
    QuickReportORDER.QRLabel94.Enabled := False;

  end;
  try
    P_DataModule.ODSLogo.Open;
    with P_DataModule.Transactions do
    begin
      TransactionID := FieldByName('ID').asstring;
      Filter := ' ID=' + TransactionID;
      Filtered := True;
      if IOCheck(FieldByName('debitbalance').asInteger) then
        CreateOrderRpt(False, P_DataModule.customers.FieldByName('ID')
          .asInteger)
      else
        CreateOrderRpt(True, P_DataModule.customers.FieldByName('ID').asInteger)
    end;

  finally
    P_DataModule.Transactions.GotoBookmark(Pointer(SavePlace));
    P_DataModule.Transactions.Filtered := False;
    P_DataModule.ODSLogo.Close;
    P_DataModule.settings.Close;
    // showmessage(P_DataModule.ODSTransactionsViewer.FieldByName('issued_by').AsString);
  end;
end;

function TP_Customers_Form.IOCheck(Reference: Integer): Boolean;
begin
  with P_DataModule.OPCash do
    Result := CallBooleanFunction('CheckOICome', [Reference]);
end;

procedure TP_Customers_Form.GetBankInfo(var BankName, BankInn: String);
begin
  with P_DataModule.OPCash do
  begin
    CallProcedure('GetBankInfo', [BankName, BankInn]);
    BankName := GetParameter(0);
    BankInn := GetParameter(1);
  end;
end;

procedure TP_Customers_Form.CreateOrderRpt(IOCome: Boolean; CustID: Longint);
var
  BankName, BankInn: String;
  CustName, CustInn: String;
  V: Variant;
  withManat, WithCoin: String;
  ManatPosition, i: Word;
  ValuteName, NoManat: String;
begin
  V := Integer(trunc(P_DataModule.Transactions.FieldByName('TRANSACTIONDATE')
    .AsDateTime));
  NoManat := '';
  GetBankInfo(BankName, BankInn);
  GetCustomerInfo(CustID, CustName, CustInn);
  // ****************************
  if not IOCome then
    withManat := CurrencyToHR_Azeri
      (trunc(P_DataModule.Transactions.FieldByName('creditamount')
      .AsFloat), 0, [0])
  else
    withManat := CurrencyToHR_Azeri
      (trunc(P_DataModule.Transactions.FieldByName('debitamount')
      .AsFloat), 0, [0]);

  ManatPosition := POS('manat', withManat);
  if ManatPosition > 0 then
    for i := 1 to ManatPosition - 1 do
      NoManat := NoManat + '' + withManat[i];

  if NoManat = EmptyStr then
    NoManat := '0 ';

  with P_DataModule do
  begin
    ODSValuteName.Close;
    ODSValuteName.SetVariable('valute',
      Transactions.FieldByName('DEBITCURRENCYID').Value);
    ODSValuteName.Open;
    WithCoin := CurrToStr
      (Frac(StrToFloat(P_DataModule.Transactions.FieldByName('DEBITAMOUNT')
      .asstring)));
    if WithCoin <> '0' then
    begin
      Delete(WithCoin, 1, 2);
      if Length(WithCoin) < 2 then
        WithCoin := WithCoin + '0'
      else if Length(WithCoin) > 2 then
        Delete(WithCoin, 3, Length(WithCoin));
      ValuteName := (ODSValuteName.FieldByName('Valu_name').asstring + ' ' +
        WithCoin + ' ' + ODSValuteName.FieldByName('valu_bala').asstring);
    end
    else
      ValuteName := (ODSValuteName.FieldByName('Valu_name').asstring);
  end;
  // //*****************************************

  if not IOCome then
  begin
    with PQRep_Order do
    begin
      P_DataModule.ODSCashInfo.Refresh;
      P_DataModule.Transactions.Refresh;
      QRLBankName.Caption := BankName;
      QRLBankName1.Caption := BankName;
      QRLBankName2.Caption := BankName;
      QRLBankInn.Caption := BankInn;
      QRLBankInn1.Caption := BankInn;
      QRLBankInn2.Caption := BankInn;
      QRInn.Enabled := False;
      QRInn1.Enabled := False;
      QRInn2.Enabled := False;
      // QRInn.Caption :=CustInn;
      // QRInn1.Caption :=CustInn;
      // QRInn2.Caption :=CustInn;
      QRLAmount.Caption := NoManat + '' + ValuteName;
      QRLAmount1.Caption := NoManat + '' + ValuteName;
      QRLAmount2.Caption := NoManat + '' + ValuteName;
      Preview;
    end
  end
  else
  begin
    with QuickReportORDER do
    begin
      P_DataModule.ODSCashInfo.Refresh;
      P_DataModule.Transactions.Refresh;
      QRLBankInn.Caption := BankInn;
      QRLBankInn1.Caption := BankInn;
      QRLBankInn2.Caption := BankInn;
      QRLBankName.Caption := BankName;
      QRLBankName1.Caption := BankName;
      QRLBankName2.Caption := BankName;
      QRInn1.Enabled := False;
      QRInn2.Enabled := False;
      QRInn3.Enabled := False;
      // QRInn1.Caption :=CustInn;
      // QRInn2.Caption :=CustInn;
      // QRInn3.Caption :=CustInn;
      QRLAmmount.Caption := NoManat + '' + ValuteName;
      QRLAmmount1.Caption := NoManat + '' + ValuteName;
      QRLAmmount2.Caption := NoManat + '' + ValuteName;
      Preview;
    end
  end;

end;

