procedure TP_Customers_Form.ActionCommitExecute(Sender: TObject);

var
  i: Integer;
  IDs: WideString;
  Status, TrCount: Word;
begin

  IDs := '';
  TrCount := 0;
  with DBGridTransactions, SelectedRows, DataSource.DataSet do
    if Count = 0 then
    begin
      inc(TrCount);
      IDs := FieldByName('ID').asstring;
    end
    else
    begin
      DisableControls;
      try
        for i := 0 to Count - 1 do
        begin
          GotoBookmark(TBookmark(Items[i]));
          Status := FieldByName('Status').asInteger;
          if Status in [tsDelayed, tsRejected] then
          begin
            inc(TrCount);
            IDs := IDs + ',' + FieldByName('ID').asstring;
          end;
        end;
        System.Delete(IDs, 1, 1);
      finally
        EnableControls;
      end;
    end;
  if MessageDlg(Format('%d sayda əməliyyat təsdiqlənsin?', [TrCount]),
    mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
    with P_DataModule do
    begin
      CommitTransactions(IDs);
      SBCommit();

    end;
end;

procedure TP_Customers_Form.ActionStepCommitExecute(Sender: TObject);

var
  i: Integer;
  ID: Longint;
  WillRefresh: Boolean;
  Status, CommitedCount, ErrorCount: Word;
  LastErrorMessage: String;
  qaccid, qtrid: Integer;
begin
  If P_DataModule.Transactions.IsEmpty then
  begin
    ShowMessage(no_selected_trans);
    Exit;
  end
  else
  begin

    CommitedCount := 0;
    ErrorCount := 0;
    WillRefresh := False;
    begin

      with P_DataModule, DBGridTransactions, SelectedRows, DataSource.DataSet do
        if P_DataModule.Transactions.FieldByName('Status').asInteger = 2 then
          ShowMessage('Əməliyyat artıq təsdiqlənib')
        else
        begin

          if MessageDlg('Əməliyyatlar təsdiqlənsin?', mtConfirmation,
            [mbYes, mbCancel], 0) = mrYes then
          begin
            DisableControls;
            try
              Application.ProcessMessages;
              if Count = 0 then
                CurrentRowSelected := True;
              for i := 0 to Count - 1 do
                try
                  GotoBookmark(TBookmark(Items[i]));
                  Status := FieldByName('Status').asInteger;
                  if Status in [tsDelayed, tsRejected] then
                  begin
                    ID := FieldByName('ID').asInteger;
                    CommitTransaction(ID);
                    WillRefresh := True;
                    inc(CommitedCount);
                    SBCommit();
                  end;
                except
                  on E: Exception do
                  begin
                    LastErrorMessage := E.Message;
                    inc(ErrorCount);
                    Continue;
                  end;
                end;
            finally
              if ErrorCount > 0 then
                if ErrorCount = 1 then
                  MessageDlg(LastErrorMessage, mtConfirmation, [mbOk], 0)
                else
                  MessageDlg(Format(cs_CommitInformation,
                    [CommitedCount + ErrorCount, CommitedCount, ErrorCount]),
                    mtConfirmation, [mbOk], 0);

              EnableControls;

              if WillRefresh then
              begin
                TransactionState := tsCommit;
                qaccid := P_DataModule.Account.FieldByName('ID').asInteger;
                qtrid := P_DataModule.TransactionsID.asInteger;
                P_DataModule.Transactions.Close;
                P_DataModule.Transactions.Open;
                P_DataModule.Account.Close;
                P_DataModule.Account.Open;
                P_DataModule.Account.Locate('id', qaccid, []);
                P_DataModule.Transactions.Locate('id', qtrid, []);
              end;

            end;
          end;
        end;
    end;
  end;
end;

