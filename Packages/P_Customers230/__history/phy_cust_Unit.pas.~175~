procedure TP_Customers_Form.mzanmumsininap1Click(Sender: TObject);
var
  cust_id, acc_id: Integer;
  tarix: TDateTime;
begin
  if P_DataModule.Account.IsEmpty then
  begin
    ShowMessage(no_selected_account);
    Exit;
  end
  else
  begin

    if not Assigned(P_CO_ImzaNumReport) then
      P_CO_ImzaNumReport := TP_CO_ImzaNumReport.Create(Self);
    if not P_CO_ImzaNumReport.Bankinfo.Active then
      P_CO_ImzaNumReport.Bankinfo.Open
    else
      P_CO_ImzaNumReport.Bankinfo.Refresh;

    cust_id := P_DataModule.Account.FieldByName('custID').asInteger;
    acc_id := P_DataModule.Account.FieldByName('ID').asInteger;
    P_CO_ImzaNumReport.DSCustomer_Info.Close;
    P_CO_ImzaNumReport.DSCustomer_Info.SetVariable('CUST_ID', cust_id);
    P_CO_ImzaNumReport.DSCustomer_Info.SetVariable('Acc_id', acc_id);
    P_CO_ImzaNumReport.DSCustomer_Info.Open;

    P_CO_ImzaNumReport.PreviewModal;
  end;

end;

