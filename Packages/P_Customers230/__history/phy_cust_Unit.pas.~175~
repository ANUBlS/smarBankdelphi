procedure TP_Customers_Form.N17Click(Sender: TObject);
var
  Index: Integer;
  WaitNextConfirm, WillRefresh: Boolean;
  TransactionID: Integer;
  qaccid, qtrid: Integer;
begin
  P_DataModule.SB_ACA.CallProcedure('CheckObjectAccess',
    ['Transaction', 'delete']);
  WaitNextConfirm := True;
  WillRefresh := False;

  with DBGridTransactions, SelectedRows, DataSource.DataSet, P_DataModule do
    try
      if Count = 0 then
        CurrentRowSelected := True;
      for Index := 0 to Count - 1 do
      begin
        GotoBookmark(Pointer(Items[Index]));
        TransactionID := FieldByName('ID').asInteger;

        if WaitNextConfirm then
          case MessageDlg(Format('Əməliyyat #%d Silinsin?', [TransactionID]),
            mtConfirmation, [mbYes, mbNo, mbCancel, mbYesToAll], 0) of
            mrNo:
              Continue;
            mrCancel:
              Break;
            mrYesToAll:
              if MessageDlg(Format('%d sayda əməliyyat silinsin?',
                [Count - Index]), mtConfirmation, [mbYes, mbCancel], 0)
                = mrYes then
                WaitNextConfirm := False
              else
                Continue;
          end;
        Application.ProcessMessages;

        with ODS_VidOPTrDel do
        begin { H.R. 05.10.2010 }
          Close;
          SetVariable('v_ID', DBGridTransactions.DataSource.DataSet.FieldByName
            ('OperationCode').asInteger);
          Open;
        end;
        if ODS_VidOPTrDel.FieldByName('Cnt').asInteger = 1 then
        begin
          ShowMessage('Bu tip əməliyyatı bu moduldan silmək olmaz');
          Continue;
        end; { *** H.R. 05.10.2010 }

        if DBGridTransactions.SelectedRows.Count > 1 then
        begin { H.R. 17.03.2011 }
          try
            DeleteTransaction(TransactionID);
          except
          end;
        end
        else
          DeleteTransaction(TransactionID);

        WillRefresh := True;
        SBCommit;
        TransactionState := tsDelete;
      end;
    finally
    end;
  qaccid := P_DataModule.Account.FieldByName('ID').asInteger;
  qtrid := P_DataModule.TransactionsID.asInteger;
  P_DataModule.Transactions.Close;
  P_DataModule.Transactions.Open;
  P_DataModule.Account.Close;
  P_DataModule.Account.Open;
  P_DataModule.Account.Locate('ID', qaccid, []);
  P_DataModule.Transactions.Locate('ID', qtrid, []);
end;

