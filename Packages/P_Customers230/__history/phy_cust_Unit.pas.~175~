procedure TP_Customers_Form.TransDebitClick(Sender: TObject);
begin
  RichEdit1.Text := P_DataModule.Account.FieldByName('TipAcc').asstring;
  if P_DataModule.Account.IsEmpty then
  begin
    ShowMessage(no_selected_account);
    Exit;
  end
  else if RichEdit1.FindText('D', 0, Length(RichEdit1.Text), []) <> -1 then
  begin
    ShowMessage(DebetArest_On_Account);
    Exit;
  end
  else
  begin
    if not Assigned(P_Transaction) then
      P_Transaction := TP_Transaction.Create(Self);
    with P_Transaction { , CO_DataMod } do
    begin
      TransTypeIncOutDC := 3;
      ShowModal;
    end;
  end;

end;

