procedure TP_CO_Account_Form.ButtonCommitClick(Sender: TObject);

var
  DDate: TDateTime;

begin

  if CheckParams(Sender) then
    showmessage('Melumat tam deyil')

  else
  begin
    DDate := Trunc(DTPOpenDate.DateTime);
    P_DataModule.PHYS_FS_CUSTOMERS.CallIntegerFunction('open_Account',
      [EditAcc.Text, EditValute.Text, EditBall.Text, EditCust.Text, DDate,
      DBEditLimit.Text, dbrepsymb.KeyValue, EditFil.Text, TipAcc.Text,
      EditAccName.Text, custid.Text,editball2.Text]);
    P_DataModule.Account.close;
    P_DataModule.Account.Open;
    close;
  end;


end;

procedure TP_CO_Account_Form.FormActivate(Sender: TObject);
begin
  EditValute.Text := '0';
  DBEdit1.Text := '';
  DBEdit2.Text := '';
  DBEdit3.Text := '';
  DBEdit4.Text := '';
  DBEdit5.Text := '';
  P_DataModule.Sysdat.Open;
  P_DataModule.AccSettings.Open;
  DTPOpenDate.Date := P_DataModule.Sysdat.FieldByName('tek_dat').asdatetime;
  EditValute.Text := P_DataModule.AccSettings.FieldByName('val_code').asstring;
  DBEdit1.Text := P_DataModule.AccSettings.FieldByName('val_name').asstring;
  EditBall.Text := P_DataModule.AccSettings.FieldByName('bal_cn1').asstring;
  DBEdit2.Text := P_DataModule.AccSettings.FieldByName('bal_name').asstring;
  EditCust.Text := P_DataModule.P_Customers.FieldByName('id').asstring;
  DBEdit3.Text := P_DataModule.AccSettings.FieldByName('cust_name').asstring;
  // DTPOpenDate.date :=Datamod_Buyers.CC_Settings.fieldbyname('open_date').asdatetime);
  DBEditLimit.Text := P_DataModule.AccSettings.FieldByName('limit').asstring;
  EditFil.Text := P_DataModule.AccSettings.FieldByName('branch_id').asstring;
  DBEdit5.Text := P_DataModule.AccSettings.FieldByName('branch_name').asstring;
  EditAccName.Text := P_DataModule.P_Customers.FieldByName('cust_name')
    .asstring;
  dbrepsymb.ListSource.DataSet.First;
  dbrepsymb.KeyValue := dbrepsymb.ListSource.DataSet.Fields[0].AsVariant;
  symboledit_.Text := dbrepsymb.ListSource.DataSet.Fields[1].asstring;
end;

