procedure TFormCashSettings.FormCreate(Sender: TObject);
begin
  FormPhoto :=TFormPhoto.Create(Self); 
  Chck1.checked :=true;
  Chck2.checked :=true;
  Chck3.checked :=true;
  Chck4.checked :=true;
  Chck5.checked :=true;
  Chck6.checked :=true;
  Chck7.checked :=true;
  Chck8.checked :=true;
  Chck9.checked :=true;
  Chk5.checked :=true;
  Chk_82.checked :=true;
  with CashDataMod.Settings do begin
   if not Active then Active :=true;

   if trim(FieldByName('HANDOVER').AsString)='0' then
      chck1.checked :=false;

   if trim(FieldByName('Chief').AsString)='0' then
      chck2.checked :=false;

   if trim(FieldByName('Operator').AsString)='0' then
      chck3.checked :=false;

   if trim(FieldByName('Cashier').AsString)='0' then
      chck4.checked :=false;

   if trim(FieldByName('Amount').AsString)='0' then
      chck5.checked :=false;

   if trim(FieldByName('Chief_out').AsString)='0' then
      chck6.checked :=false;

   if trim(FieldByName('Accountant').AsString)='0' then
      chck7.checked :=false;

   if trim(FieldByName('Operator_out').AsString)='0' then
      chck8.checked :=false;

   if trim(FieldByName('Cashier_out').AsString)='0' then
      chck9.checked :=false;

   if trim(FieldByName('Controller').AsString)='0' then
      chk5.checked :=false;

   if trim(FieldByName('Controller_out').AsString)='0' then
      chk_82.checked :=false;
  end;
  SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

