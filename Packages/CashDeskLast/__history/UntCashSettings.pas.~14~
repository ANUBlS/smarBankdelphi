procedure TFormCashSettings.CommitButtonClick(Sender: TObject);
begin
  CashDataMod.OPCash.CallProcedure('update_cashsettings',
                                 [NatBalance.text
                                 ,ForBalance.text
                                 ,DescriptionAz.text
                                 ,DescriptionEng.text
                                 ,signatyre.text
