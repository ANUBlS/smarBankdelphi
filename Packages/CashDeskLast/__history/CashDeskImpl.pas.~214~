function TFrmCashDesk.GetCurrencyAz(Ammount :Extended) :String;
var
   WithManat, NoManat: string;
   ManatPosition, i: integer;
begin
 NoManat :='';
 WithManat :=CurrencyToHR_Azeri(AMMOUNT,0,[1]);

 ManatPosition :=POS('manat',WithManat);
if ManatPosition>0 then
 for i:=1 to ManatPosition-1 do
  NoManat :=NoManat + WithManat[i] ;

  if NoManat=EmptyStr then NoManat:='0 ';

 result :=NoManat;
 end;

procedure TFrmCashDesk.FillFilial(List :TComboBox; var DynArray :TDynamicArray);
var
    RateIndex :Integer;
begin
 RateIndex:=0;
 with   List.Items  do
  begin
   Clear;
   Add('Bütün filiallar')
  end;
 with  CashDataMod.Filials  do
  begin
    Open;
    SetLength(DynArray,RecordCount);
    First;
    while  not EOF  do
    begin
      DynArray[RateIndex] :=FieldByName('ID').AsInteger;
      List.Items.Add(FieldByName('Name').AsString);
      Inc(RateIndex);
      Next;
    end;
  end;
end;

procedure TFrmCashDesk.FillCashSymbol;
begin
 with CBCashSymbol.Items  do
  begin
   Clear;
   Add('Bütün')
  end;
 with  CashDataMod.CashSymbols  do
  begin
    Open;
    First;
    while  not EOF  do
    begin
      CBCashSymbol.Items.Add(FieldByName('Symbol').AsString);
      Next;
    end;
  end;
end;

procedure TFrmCashDesk.CreateOrderRpt(IOCome :Boolean;CustID :LongInt);
var
   BankName,BankInn      :String;
   CustName, CustInn     :String;
   V                     :Variant;
   WithManat,WithCoin    :String;
   ManatPosition,i       :Word;
   ValuteName,NoManat    :String;
begin
   V :=Integer(Trunc(CashDataMod.ODSTransactionsViewer2.FieldByName('DAT').AsDateTime));
   NoManat:='';
   OpenDataSet(CashDataMod.ODSRates,['ADate','Currency'],[V,Rate[CmbBoxCurrency.ItemIndex-1]]);
   GetBankInfo(BankName,BankInn);
   GetCustomerInfo(CustID,CustName,CustInn);
   //****************************
   if not IOCome then
     WithManat :=CurrencyToHR_Azeri(Trunc(CashDataMod.ODSTransactionsViewer2.FieldByName('ammount').AsFloat),0,[0])
   else
     WithManat :=CurrencyToHR_Azeri(Trunc(CashDataMod.ODSTransactionsViewer2.FieldByName('ammount_c').AsFloat),0,[0]);

    ManatPosition :=POS('manat',WithManat);
    if ManatPosition>0 then
    for i:=1 to ManatPosition-1 do
     NoManat :=NoManat +''+WithManat[i] ;
     if NoManat=EmptyStr then NoManat:='0 ';

  with CashDataMod do begin
   if ODSTransactionsViewer2.FieldByName('DCurrency').Value=ODSTransactionsViewer2.FieldByName('CCurrency').Value then begin
    ODSValuteName.Close;
    ODSValuteName.SetVariable('valute',ODSTransactionsViewer2.FieldByName('DCurrency').Value);
    ODSValuteName.Open;
    WithCoin :=CurrToStr(Frac(StrToFloat(CashDataMod.ODSTransactionsViewer2.FieldByName('ammount').Asstring)));
    if WithCoin<>'0' then begin
     Delete(WithCoin,1,2);
     if length(WithCoin) < 2 then WithCoin :=WithCoin+'0'
      else
       if length(WithCoin) > 2 then Delete(WithCoin,3,length(WithCoin));
      ValuteName :=(ODSValuteName.FieldByname('Valu_name').Asstring+' '+WithCoin+' '+ODSValuteName. FieldByName('valu_bala').AsString);
    end {if WithCoin<>'0'}
    else ValuteName :=(ODSValuteName.FieldByname('Valu_name').Asstring);
   end {if ODSTransactionsViewer.FieldByName('DCurrency').Value=ODSTransactionsViewer.FieldByName('KCurrency').Value}
   else
    if IOCome{ODSTransactionsViewer.FieldByName('DCurrency').Value=0} then begin
     ODSValuteName.Close;
     ODSValuteName.SetVariable('valute',ODSTransactionsViewer2.FieldByName('CCurrency').Value);
     ODSValuteName.Open;
     WithCoin :=FloatToStr(Frac(CashDataMod.ODSTransactionsViewer2.FieldByName('ammount_c').AsFloat));
     if WithCoin<>'0' then begin
      Delete(WithCoin,1,2);
      ValuteName :=(ODSValuteName.FieldByname('Valu_name').Asstring+' '+WithCoin+' '+ODSValuteName. FieldByName('valu_bala').AsString);
     end {if WithCoin<>'0'}
     else ValuteName :=(ODSValuteName.FieldByname('Valu_name').Asstring);
    end {if ODSTransactionsViewer.FieldByName('DCurrency').Value=0}
    else begin
     ODSValuteName.Close;
     ODSValuteName.SetVariable('valute',ODSTransactionsViewer2.FieldByName('DCurrency').Value);
     ODSValuteName.Open;
     WithCoin :=FloatToStr(Frac(CashDataMod.ODSTransactionsViewer2.FieldByName('ammount').AsFloat));
     if WithCoin<>'0' then begin
      Delete(WithCoin,1,2);
      ValuteName :=(ODSValuteName.FieldByname('Valu_name').Asstring+' '+WithCoin+' '+ODSValuteName. FieldByName('valu_bala').AsString);
     end {if WithCoin<>'0'}
     else ValuteName :=(ODSValuteName.FieldByname('Valu_name').Asstring);
    end; {else}
   end;
     // //*****************************************
   if  CmbBoxCurrency.ItemIndex = 0  then
    if  not IOCome  then
     begin
      with QRPTReceiptOrder do
       begin
        QRLBankName.Caption :=BankName;
        QRLBankName1.Caption :=BankName;
        QRLBankName2.Caption :=BankName;
        QRLBankInn.Caption :=BankInn;
        QRLBankInn1.Caption :=BankInn;
        QRLBankInn2.Caption :=BankInn;
        QRInn.Caption :=CustInn;
        QRInn1.Caption :=CustInn;
        QRInn2.Caption :=CustInn;
        QRLAmount.Caption := NoManat + '' +ValuteName;
        QRLAmount1.Caption := NoManat + '' +ValuteName;
        QRLAmount2.Caption := NoManat + '' +ValuteName;
        Preview;
        CashDataMod.ODSTransactionsViewer2.Filtered:=false;
       end;
     end
    else
    with   QuickRptOrder  do
     begin
      CashDataMod.ODSCashInfo.Open;
      QRLBankInn.Caption :=BankInn;
      QRLBankInn1.Caption :=BankInn;
      QRLBankInn2.Caption :=BankInn;
      QRLBankName.Caption :=BankName;
      QRLBankName1.Caption :=BankName;
