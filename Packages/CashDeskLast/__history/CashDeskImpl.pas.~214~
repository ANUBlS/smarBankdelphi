procedure TFrmCashDesk.ActionSymbolReportExecute(Sender: TObject);
var
   FirstDate,LastDate: Variant;
   CurrencyID:         String[5];
   RefIndex:           String[1];
   DebetFilial:        String;
   CreditFilial:       String;
   FilialRest:         String;
begin
 Screen.Cursor :=crHourGlass;
 ProgBar.Show;
 ProgBar.Position :=0;
 try

  if CBDebetFilial.ItemIndex = 0 then
     DebetFilial :=' '
  else
     DebetFilial :=' and (AC.filial = ' + IntToStr(DebetFilialArray[CBDebetFilial.ItemIndex-1])+')';

  if CBCreditFilial.ItemIndex = 0 then
     CreditFilial :=' '
  else
     CreditFilial :=' and (AC.filial = ' + IntToStr(CreditFilialArray[CBCreditFilial.ItemIndex-1])+')';

  if (CBDebetFilial.ItemIndex<>0) and (CBDebetFilial.ItemIndex = CBCreditFilial.ItemIndex) then
   FilialRest :=' and (AC.filial = ' + IntToStr(DebetFilialArray[CBDebetFilial.ItemIndex-1])+')'
  else
   FilialRest :=' ';

  try
   ProgBar.StepBy(17);
   RefIndex :=IntTostr(CmbBoxReference.ItemIndex+1);
   FirstDate :=Integer(Trunc(DTPBegin.DateTime));
   LastDate  :=Integer(Trunc(DTPEnd.DateTime));
   if   CmbBoxCurrency.ItemIndex <> 0 then
   begin
    CurrencyId :=IntToStr(Rate[CmbBoxCurrency.ItemIndex-1]);
    CashDataMod.ODSCashReport.SQL[10] :='  AND ((PR.VAL_ACC='+CurrencyId+')OR(PR.CURRENCYID_C='+CurrencyId+'))';
   end else
    CashDataMod.ODSCashReport.SQL[10] :='';
   CashDataMod.ODSCashReport.SQL[11]:=' AND((DEBT IN (SELECT AC.ID FROM ACCOUNT AC,BAL_SPR'+RefIndex+' B WHERE B.BAL_CN=AC.BAL_CN'+RefIndex+' AND B.CASHINCOMING=1'
   +DebetFilial+'))';
   CashDataMod.ODSCashReport.SQL[13]:='(KREDIT IN (SELECT AC.ID FROM ACCOUNT AC,BAL_SPR'+RefIndex+' B WHERE B.BAL_CN=AC.BAL_CN'+RefIndex+' AND B.CASHINCOMING=1'
   +CreditFilial+')))';
   CashDataMod.ODSCashReport.SQL[32]:=' and ac.val_acc=0' + FilialRest;
   CashDataMod.ODSCashReport.SQL[49]:=' and ac.val_acc=0' + FilialRest;
   ProgBar.StepBy(23);
   OpenDataSet(CashDataMod.ODSCashReport,['FirstDate','LastDate'],[FirstDate,LastDate]);
   ProgBar.StepBy(60);
   Screen.Cursor :=crDefault;
   InitateReport((Sender as TComponent).Tag);
  except
   raise;
  end;
 finally
   Screen.Cursor :=crDefault;
   ProgBar.Hide;
 end;
end;

