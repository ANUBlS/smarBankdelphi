function  TFrmCashDesk.IOCheck(Reference :Integer):Boolean;
begin
  with  CashDataMod.OPCash  do
    Result :=CallBooleanFunction('CheckOICome',[Reference]);

  if CmbBoxCurrency.ItemIndex>0 then begin
    if  CashDataMod.ODSTransactionsViewer2.FieldByName('DCurrency').AsInteger = Rate[CmbBoxCurrency.ItemIndex-1] then Result := Result
    else Result := not Result;
  end;
end;

procedure TFrmCashDesk.MouseWheelHandler(var Message: TMessage);
begin
 Inherited;
 if (CashViewer.Focused) and not(CashViewer.DataSource.DataSet.IsEmpty) then
  with TCMMouseWheel(Message), CashViewer.DataSource.DataSet do
    if WheelDelta < 0 then
      Next
    else
      Prior;
   CashViewer.Repaint;
end;

function TFrmCashDesk.GenerateFilialFilter :string;
var
   DebetFilial, CreditFilial :String;
   BoolPrefix :String;
begin
 if (CBDebetFilial.ItemIndex <> 0) then
   if (CBCreditFilial.ItemIndex = 0) then
    BoolPrefix :=' '
   else
    BoolPrefix :=' AND '
 else
   BoolPrefix :=' ';

 if CBDebetFilial.ItemIndex = 0 then
   DebetFilial :=' '
 else
   DebetFilial :=' (DebetFilial = ' + IntToStr(DebetFilialArray[CBDebetFilial.ItemIndex-1])+')';

 if CBCreditFilial.ItemIndex = 0 then
   CreditFilial :=' '
 else
   CreditFilial :=' (CreditFilial = ' + IntToStr(CreditFilialArray[CBCreditFilial.ItemIndex-1])+')';

   Result :=DebetFilial + BoolPrefix + CreditFilial;
end;

function TFrmCashDesk.GenerateCurrencyFilter :string;
const
   CurrencyFilter ='((DCurrency=%d)OR(KCurrency=%d))';
var
   Currency :integer;
begin
 with CmbBoxCurrency do
  begin
   Currency :=Rate[ItemIndex-1];
   if ItemIndex = 0 then
     Result :=' '
   else
     Result :=Format(CurrencyFilter,[Currency,Currency]);
  end;
end;

