   begin
   CurrencySql:='and ((pr.VAL_ACC='+inttostr(Rate[CmbBoxCurrency.ItemIndex-1])+' AND CASHORNOT(PR.DEBT)=1 ) OR (pr.CURRENCYID_C='+
