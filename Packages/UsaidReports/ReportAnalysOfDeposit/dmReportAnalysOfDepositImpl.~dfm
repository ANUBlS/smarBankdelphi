        '  round(sum(h.FACTICALDEBT*o.ostat*intr.interest)/*:GenFACTICALD' +
        'EBT*/,4)*100 as RoundInt,'
      '  p.branchid'
      'from sbcm_contracts p,'
      '     sbcm_contract_history h,'
      #9' sbcm_interests intr,'
      #9' operkurs o ,sbcm_accounts ac'
