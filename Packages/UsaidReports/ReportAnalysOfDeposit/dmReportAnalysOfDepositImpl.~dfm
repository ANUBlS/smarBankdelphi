    SQL.Strings = (
      'select '
      '    f.name as sector,f.id as sectorid,'
      '    d.*'
      'from '
      '   filial f,'
      '(select'
      '   sum(DpCount) as DpCount,'
      '   round(sum(DpCount)/(:GenCount),4)*100 as CeofCount,'
