unit frmDetailImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, NLSDialogs,
  ExtCtrls, StdCtrls, Grids, DBGridEh, ComCtrls, Mask, DBCtrlsEh,ORACLE,ORACLEDATA,
  ActnList, Buttons, CMExcelExport;

type
  TfrmDetail = class(TForm)
    Panel1: TPanel;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    Label4: TLabel;
    Label5: TLabel;
    Label6: TLabel;
    SearchPanel: TGroupBox;
    Panel4: TPanel;
    StaticText1: TStaticText;
    EditNUMBEROFCREDIT: TEdit;
    Panel7: TPanel;
    StaticText2: TStaticText;
    EditACC_NO: TEdit;
    Panel8: TPanel;
    StaticText3: TStaticText;
    EditCUSTNAME: TEdit;
    Panel10: TPanel;
    StaticText5: TStaticText;
    EditANNUALYINTERESTRATE: TEdit;
    Panel11: TPanel;
    StaticText6: TStaticText;
    EditCREDITLINEAMOUNT: TEdit;
    MainGriddetail: TDBGridEh;
    DBEditEh1: TDBEditEh;
    DBEditEh2: TDBEditEh;
    DBEditEh3: TDBEditEh;
    DTP: TDateTimePicker;
    ActionList1: TActionList;
    ActnSearch: TAction;
    BitBtnexp: TBitBtn;
    expdetails: TCMExcelExport;
    procedure ActnSearchExecute(Sender: TObject);
    procedure EditNUMBEROFCREDITKeyPress(Sender: TObject; var Key: Char);
