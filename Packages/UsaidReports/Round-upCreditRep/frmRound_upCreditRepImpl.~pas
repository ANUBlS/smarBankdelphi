procedure TfrmRound_upCreditRep.OKClick(Sender: TObject);

resourcestring rs_gencount = 'select count(p.id) as cnt from cm_portfolio p where id in (select creditid from cm_history where hdate =:dat and rest+duerest >0)';
resourcestring rs_geninitialamt = 'select round(sum(p.initialamount*o.ostat),2) as geninitialamount from cm_portfolio p,operkurs o where p.currency = o.val_kod and p.id in (select creditid from cm_history where hdate =:dat and rest+duerest >0)';
resourcestring rs_genrest = 'select round(sum(rest*o.ostat+duerest*o.ostat),2) as genrest from cm_portfolio p,cm_history h,operkurs o where h.creditid=p.id and p.currency = o.val_kod';

var
     gencount,geninitialamt,genrest,
     smrest,smintrest,smroundint ,
     smThisCnt,smThistramt,a,z:Real;
     FSt,s_genrest,s_gencount,s_geninitialamt :String;

begin

  RepDat := integer(trunc(DTPRepdat.DateTime));
  FilterStr := '';
  FSt := '';
  gencount := 0;
  geninitialamt := 0;
  genrest := 0;
  smrest := 0;
  smintrest := 0;
  smroundint := 0;
  smThisCnt:=0;
  smThistramt:=0;

  if lfilial.GetCheckedKeyList.Count = 0 then begin ShowMessage('ян азы бир филиал сечилм€лидир!'); Exit; end;
  if lcredittypes.GetCheckedKeyList.Count = 0 then begin ShowMessage('ян азы бир кредит типи сечилм€лидир!'); Exit; end;
  if lvalute.GetCheckedKeyList.Count = 0 then begin ShowMessage('ян азы бир валйута сечилм€лидир!'); Exit; end;



 // if (lfilial.GetCheckedKeyList.Count<>lfilial.Items.Count) then begin
  if  FilterStr <> '' then
  FilterStr := FilterStr + ' and  p.branchid in ('
                              +lfilial.GetCheckedKeyList.CommaText +')'
  else  begin
    FSt := 'branchid in ('
                              +lfilial.GetCheckedKeyList.CommaText +')';
    FilterStr := '  p.branchid in ('
                              +lfilial.GetCheckedKeyList.CommaText +')';  end;
 // end;

  if (lcredittypes.GetCheckedKeyList.Count<>lcredittypes.Items.Count) then begin
  if   FilterStr <> '' then
  FilterStr := FilterStr + ' and p.credittype in  ('
                              +lcredittypes.GetCheckedKeyList.CommaText +')' else
  FilterStr := '  p.credittype in  ('
                              +lcredittypes.GetCheckedKeyList.CommaText +')';

  end;

  if (lvalute.GetCheckedKeyList.Count<>lvalute.Items.Count) then begin
  if FilterStr <> '' then
  FilterStr := FilterStr + ' and p.currency in ('
                              +lvalute.GetCheckedKeyList.CommaText +')' else
    FilterStr := '  p.currency in ('
                              +lvalute.GetCheckedKeyList.CommaText +')';
  end;

  Screen.Cursor := crSqlWait;
  //showmessage(FilterStr);

  with dmRound_upCreditRep do begin //1

       s_gencount := rs_gencount;
       if FilterStr <> '' then s_gencount := s_gencount + ' and  '+FilterStr;

       with Queries do begin //2
       DeleteVariables;
       DeclareVariable('dat',otDate);
       SetVariable('dat',repdat);
       if Active then CloseAll;
       sql.Clear;
       sql.Add(s_gencount);
       Open;
       gencount := FieldByName('cnt').AsFloat;


       s_geninitialamt := rs_geninitialamt;
       s_geninitialamt := s_geninitialamt + ' and o.dat = ' + QuotedStr(FormatdateTime('dd-mmm-yyyy',RepDat));
       if FilterStr <> '' then s_geninitialamt := s_geninitialamt + ' and '+FilterStr;

       CloseAll;
       DeleteVariables;
       DeclareVariable('dat',otDate);
       SetVariable('dat',repdat);
       sql.Clear;
       sql.Add(s_geninitialamt);
       Open;
       geninitialamt := FieldByName('geninitialamount').AsFloat;
       

       s_genrest:= rs_genrest + ' and h.hdate = '+QuotedStr(FormatdateTime('dd-mmm-yyyy',RepDat))+' and o.dat = '+QuotedStr(FormatdateTime('dd-mmm-yyyy',RepDat));
       if FilterStr <> '' then s_genrest := s_genrest + ' and '+FilterStr;
       CloseAll;
       DeleteVariables;
       sql.Clear;
       sql.Add(s_genrest);
       Open;
       genrest := FieldByName('genrest').AsFloat;
       end; //2

       with ODSmain do
       begin
          if Active then CloseAll;
          SetVariable('dat',RepDat);
          if gencount = 0 then gencount := 1;
          SetVariable('GENERALCOUNT',gencount);
          if geninitialamt = 0 then geninitialamt := 1;
          SetVariable('GENERALINITIALAMT',geninitialamt);
          SetVariable('ffilter',FSt);
          if genrest = 0 then genrest := 1;
          SetVariable('grest',genrest);
          SetVariable('OrderField','ID');
          if FilterStr <> '' then  begin
          sql[26] := ' and ' + '('+FilterStr+')';
          sql[35] := ' and  ' + '('+FilterStr+')';
          sql[43] := ' and  ' + '('+FilterStr+')';
          sql[54] := ' and ' + '('+FilterStr+')';
          sql[61] := ' and ' + '('+FilterStr+')'; end
          else begin
            sql[26] := '';
            sql[35] := '';
            sql[43] := '';
            sql[54] := '';
            sql[61] := '';
          end;
          //memo1.text := SQL.text;
          open;

          
          DisableControls;
          while not eof do begin   //*
           smrest := smrest + FieldByName('REST').asFloat;
           smintrest := smintrest + FieldByName('interestrest').asFloat;
           smroundint := smroundint + FieldByName('ROUNDINT').asFloat*FieldByName('REST').asFloat;
          next;
          end; //*
          EnableControls;

       end;

       with ThisMonTranched do begin
            if Active then CloseAll;
            SetVariable('dat',RepDat);
            if FilterStr <> '' then  sql[8] := ' and ' + '('+FilterStr+')' else sql[8] := '';
            open;

          while not eof do begin   //*
           smThisCnt := smThisCnt + 1{FieldByName('CNT').asFloat};
           smthisTRAMT := smThistramt + FieldByName('TRAMT').asFloat;
           //smroundint := smroundint + FieldByName('ROUNDINT').asFloat;
          next;
          end; //*
         edThisAmt.text := FloatToStr(smthisTRAMT);
         edThisCnt.text := FloatToStr(smThisCnt);
       end;

  end;   //1

  //edgenrest.text := FloatToStr(genrest);
  //edgencount.text := FloatToStr(gencount);
  //edgenintamt.text := FloatToStr(geninitialamt);
  edcrdcnt.text := FloatToStr(gencount);
  edcrdamt.text := FloatToStr(geninitialamt);
  edrest.text := FloatToStr(smrest);
  edintrest.text := FloatToStr(smintrest);
  if smrest = 0 then smrest := 1;
  a:= smroundint/smrest;
  a := trunc(a) + round((a-trunc(a))*100)/100;
  edroundint.text := FloatToStr((a))+'%';

  Screen.Cursor := crDefault;

end;

