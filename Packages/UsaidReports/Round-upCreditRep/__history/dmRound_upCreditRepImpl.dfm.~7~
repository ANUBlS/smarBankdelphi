  object ODSmain: TOracleDataSet
    SQL.Strings = (
      'select '
      '     crdtypes.description,crdtypes.id,'
      '     creditcounts.countcrd,'
      '     creditcounts.ceofcountcrd as ceofcountcrd,'
      '     crdinitialamt.initialamount,'
      
        '     round(crdinitialamt.ceofinitialamt,4)*100 as ceofinitialamt' +
        ','
      
        '     round(crdrests.rest,2) as rest, round(crdrests.rest/:grest,' +
        '4)*100 as ceofrest,'
      '     round(crdrests.interestrest,2) as interestrest,'
      '      case when genrest.smrest=0 then 0'
      '     else'
      
        '     round(roundannint.roundint/genrest.smrest,4)end as roundint' +
        ','
      
        '     USAID_REPORT.GetProgForR(crdtypes.id,1,:ffilter)  as progno' +
        'z,'
      
        '     round(decode(crdrests.rest/USAID_REPORT.GetProgForR(crdtype' +
        's.id,1,:ffilter,1),crdrests.rest,0,crdrests.rest/USAID_REPORT.Ge' +
        'tProgForR(crdtypes.id,1,:ffilter,1)),4)*100 as delta'
      'from '
      '    cm_credittypes crdtypes ,    '
      '   (select'
      '   sum(rest*o.ostat+duerest*o.ostat) as rest,'
      
        '   sum(interestrest*o.ostat+dueinterestrest*o.ostat) as interest' +
        'rest,'
      '   p.credittype'
      'from cm_history h,'
      '     cm_portfolio p,'
      '     operkurs o'
      'where h.hdate = :dat and'
      '      h.creditid = p.id and'
      '      p.currency = o.val_kod and'
      '      o.dat = :dat'
      ''
      'group by p.credittype) crdrests ,'
      ''
      ''
      '    (select '
      ' count(id) as countcrd,'
      ' trunc(count(id)*100/:generalcount,2) as ceofcountcrd,'
      ' p.credittype  from '
      
        ' cm_portfolio p where id in (select creditid from cm_history whe' +
        're hdate =:dat and rest+duerest >0)'
      ''
      'group by p.credittype) creditcounts,'
      ''
      '(select '
      ' sum(p.initialamount*o.ostat) as initialamount,'
      
        ' sum(p.initialamount*o.ostat/:generalinitialamt) as ceofinitiala' +
        'mt,'
      ' p.credittype  from '
      
        ' cm_portfolio p,operkurs o where p.id in (select creditid from c' +
        'm_history where hdate =:dat and rest+duerest >0) and p.currency=' +
        'o.val_kod and o.dat=:dat'
      ''
      'group by p.credittype) crdinitialamt,'
      ''
      '(select '
      
        ' sum(p.annualyinterestrate*((c.rest+c.duerest)*o.ostat)) /*:gene' +
        'relrest */ as roundint,'
      ' p.credittype  from '
      'cm_portfolio p,cm_history c ,operkurs o '
      'where p.id = c.creditid and '
      'c.hdate =:dat and '
      'o.dat= :dat and '
      'p.currency = o.val_kod '
      ''
      'group by p.credittype) roundannint,'
      ''
      '(select round(sum((c.rest+c.duerest)*o.ostat),2) as smrest,'
      '       p.credittype'
      'from cm_portfolio p,cm_history h, operkurs o'
      
        'where p.id = h.creditid and h.hdate = :dat and p.currency = o.va' +
        'l_kod and o.dat=:dat'
      ''
      'group by p.credittype) genrest'
      ''
      'where '
      '   crdrests.credittype = creditcounts.credittype and'
      '   crdrests.credittype = crdinitialamt.credittype and'
      '   crdrests.credittype =roundannint.credittype  and'
      '   crdrests.credittype = genrest.credittype  and '
      '   crdtypes.id = crdrests.credittype  '
      ''
      ''
      ''
      ''
      'order by :OrderField'
      ''
      ''
      ''
      '')
