  object SumMDT: TOracleDataSet
    SQL.Strings = (
      
        'select sum(BCOUNTDEP) as BCOUNTDEP, round(sum(BEGINREST),2) as B' +
        'EGINREST,round(sum(BEGININTREST),2) as BEGININTREST,round(sum(nv' +
        'l(TRCOUNTDEP,0)),2) as TRCOUNTDEP,round(sum(nvl(TRAMOUNT,0)),2) ' +
        'as TRAMOUNT,round(sum(nvl(CAPAMOUNT,0) ),2)as CAPAMOUNT,round(su' +
        'm(nvl(PAYCOUNTDEP,0) ),2) as PAYCOUNTDEP ,round(sum(nvl(MAINPAY,' +
        '0) ),2) as MAINPAY,round(sum(nvl(INTPAY,0) ),2) as INTPAY,round(' +
        'sum(nvl(ECOUNTDEP,0) ),2) as ECOUNTDEP,round(sum(nvl(ENDREST,0) ' +
        '),2) as ENDREST,round(sum(nvl(ENDINTREST,0) ),2) as ENDINTREST f' +
        'rom '
      
        '(select id,name,nvl(BCOUNTDEP,0) as BCOUNTDEP, nvl(BEGINREST,0) ' +
        'as BEGINREST,nvl(BEGININTREST,0) as BEGININTREST,nvl(TRCOUNTDEP,' +
        '0) as TRCOUNTDEP,nvl(TRAMOUNT,0) as TRAMOUNT,nvl(CAPAMOUNT,0) as' +
