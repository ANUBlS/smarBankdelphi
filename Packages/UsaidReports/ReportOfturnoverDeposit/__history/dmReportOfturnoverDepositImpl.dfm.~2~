  object MainMDT: TOracleDataSet
    SQL.Strings = (
      
        'select id,name,nvl(BCOUNTDEP,0) as BCOUNTDEP, nvl(BEGINREST,0) a' +
        's BEGINREST,nvl(BEGININTREST,0) as BEGININTREST,nvl(TRCOUNTDEP,0' +
        ') as TRCOUNTDEP,nvl(TRAMOUNT,0) as TRAMOUNT,nvl(CAPAMOUNT,0) as ' +
        'CAPAMOUNT,nvl(PAYCOUNTDEP,0) as PAYCOUNTDEP ,nvl(MAINPAY,0) as M' +
        'AINPAY,nvl(INTPAY,0) as INTPAY,nvl(ECOUNTDEP,0) as ECOUNTDEP,nvl' +
        '(ENDREST,0) as ENDREST,nvl(ENDINTREST,0) as ENDINTREST'
      ''
      'from '
      ' uaod_source src,'
      ' '
      ' (select '
      ' sum(BcountDep) as BcountDep,'
      ' sum(beginRest) as beginRest,'
      ' sum(beginIntRest) as beginIntRest,'
      ' SourceID'
      ' from '
      ' (select '
      '   count(p.id) as BcountDep,'
      '   round(sum(h.facticaldebt*o.ostat),4) as beginRest,'
      '   round(sum(h.facticalinterestdebt*o.ostat),4) as beginIntRest,'
      '   src.SourceID'
      'from '
      '  sbcm_contracts p,'
      '  sbcm_contract_history h,'
      '  operkurs o,'
      '  sbcm_accounts ac,uaod_source_bal src'
      'where'
      'p.type# in (3,4) and src.bal_cn = ac.bal_cn1 and'
      'p.id = h.id# and h.hdate = :bdat1 and h.facticaldebt <> 0 and'
      'p.currency = o.val_kod and o.dat = :bdat1 and'
      'ac.id# = p.id'
      ''
      'group by src.SourceID'
      ''
      'union all'
      ''
      'select'
      '  count(ac.id) as BcountDep,'
      '  sum(abs(ar.pok_ostat)) as beginRest,'
      '  0 as beginIntRest,'
      '  src.SourceID'
      'from account ac ,archost ar,uaod_source_bal src'
      'where ac.id = ar.acc_id and ac.bal_cn1 = src.bal_cn and'
      'ar.datdate = :bdat1 and ar.ostat <> 0'
      ''
      'group by src.SourceID '
      ') '
      'group by SourceID'
      ')BRest ,'
      ''
      '('
      'select '
      '  sum(TrcountDep) as TrcountDep,'
      '  sum(TrAmount) as TrAmount,'
      '  sum(CapAmount) as CapAmount,'
      '  SourceID'
      'from (  '
      '/*select'
      '   count(p.id) as TrcountDep,'
      '   round(sum(tr.total*o.ostat),4) as TrAmount,'
      
        '   round(sum(usaid_report.get_CaptAmt(p.id,:bdat,:edat)*o.ostat)' +
        ',4) as CapAmount,'
      '   src.SourceID'
      'from '
      '  sbcm_contracts p,'
      '  sbcm_tranches tr,'
      '  --sbcm_capitalization c,'
      '  operkurs o,'
      '  sbcm_accounts ac,uaod_source_bal src'
      'where p.type# in (3,4) and src.bal_cn=ac.bal_cn1 and'
      'p.id = tr.id#  and p.id = ac.id# and'
      'p.currency = o.val_kod and o.dat = tr.hdate and'
      'tr.hdate between :bdat and :edat'
      ''
      'group by src.SourceID*/'
      ''
      'select '
      '   count(ac1.id) as TrcountDep,'
      '   sum(abs(ar.pok_obr_k)) as TrAmount,'
      '   0 as CapAmount,'
      '   src.SourceID'
      'from'
      
        '  account ac1, archost ar,uaod_source_bal src,sbcm_contracts p,s' +
        'bcm_accounts ac'
      
        'where ac1.id = ar.acc_id and (ar.datdate between :bdat and :edat' +
        ') and /*ar.ostat <> 0 and*/ ac1.bal_cn1=src.bal_cn  and'
      
        '      p.type# in (3,4) and p.id = ac.id# and ac.BAL_CN1 = src.ba' +
        'l_cn and ac.contractaccid = ac1.id'
      ''
      'group by src.SourceID'
      ''
      'union all'
      ''
      'select '
      '   count(ac.id) as TrcountDep,'
      '   sum(abs(ar.pok_obr_k)) as TrAmount,'
      '   0 as CapAmount,'
      '   src.SourceID'
      'from'
      '  account ac, archost ar,uaod_source_bal src'
      'where'
      
        '  ac.id = ar.acc_id and (ar.datdate between :bdat and :edat) and' +
        ' /*ar.ostat <> 0 and*/ ac.bal_cn1=src.bal_cn '
      ''
      'group by src.SourceID'
      ') '
      'group by SourceID'
      ')Tranches,'
      ''
      '('
      'select '
      ' sum(PaycountDep) as PaycountDep,'
      ' sum(MainPay) as MainPay,'
      ' sum(IntPay) as IntPay,'
      ' SourceID'
      ' from'
      ' ('
      '/*select'
      '   count(p.id) as PaycountDep,'
      '   round(sum(pay.facticaldebt*o.ostat),4) as MainPay,'
      '   round(sum(pay.interestdebt*o.ostat),4) as IntPay,'
      '   src.SourceID'
      'from'
      '   sbcm_contracts p,'
      '   sbcm_payments pay,'
      '   operkurs o,'
      '   sbcm_accounts ac,uaod_source_bal src'
      'where  '
      'p.type# in (3,4) and ac.bal_cn1=src.bal_cn and'
      'p.id = pay.id# and'
      '(pay.hdate between :bdat and :edat) and'
      'p.currency = o.val_kod and o.dat = pay.hdate and'
      'p.id = ac.id#'
      ''
      'group by src.SourceID*/'
      ''
      'select '
      '   count(*) as PaycountDep,'
      '   sum(abs(ar1.pok_obr_d)) as MainPay,'
      '   sum(abs(ar2.pok_obr_d)) as IntPay,'
      '   src.SourceID'
      'from'
      '  sbcm_contract_accounts ac1,  '
      '  sbcm_contract_accounts ac2,'
      '  archost ar1,'
      '  archost ar2,'
      '  uaod_source_bal src,'
      '  sbcm_contracts p,'
      '  sbcm_accounts ac'
      
        'where ac1.contractaccid = ar1.acc_id and (ar1.datdate between :b' +
        'dat and :edat) and --ar1.pok_obr_d <> 0 and '
      
        '      ac2.interestaccid = ar2.acc_id and (ar2.datdate between :b' +
        'dat and :edat) and --ar2.pok_obr_d <> 0 and '
      
        '      p.type# in (3,4) and p.id = ac.id# and ac.BAL_CN1 = src.ba' +
        'l_cn and ac.contractaccid = ac1.contractaccid and ac.contractacc' +
        'id = ac2.contractaccid'
      '      and p.id = ac2.id# and  p.id = ac1.id# '
      ''
      'group by src.SourceID'
      ''
      'union all'
      ''
      'select '
      '   count(ac.id) as PaycountDep,'
      '   sum(abs(ar.pok_obr_d)) as MainPay,'
      '   0 as IntPay,'
      '   src.SourceID'
      'from'
      '  account ac, archost ar,uaod_source_bal src'
      'where'
      
        '  ac.id = ar.acc_id and (ar.datdate between :bdat and :edat) /*a' +
        'nd ar.pok_obr_d <> 0*/ and src.bal_cn=ac.bal_cn1 '
      ''
      'group by src.SourceID'
      ''
      ')'
      'group by SourceID'
      ')'
      'payments ,  '
      ''
      ''
      '('
      'select '
      'sum(EcountDep) as EcountDep,'
      'sum(endRest) as endRest,'
      'sum(endIntRest) as endIntRest,'
      'SourceID'
      'from ('
      'select '
      '   count(p.id) as EcountDep,'
      '   round(sum(h.facticaldebt*o.ostat),4) as endRest,'
      '   round(sum(h.facticalinterestdebt*o.ostat),4) as endIntRest,'
      '   src.SourceID'
      'from '
      '  sbcm_contracts p,'
      '  sbcm_contract_history h,'
      '  operkurs o,'
      '  sbcm_accounts ac,uaod_source_bal src'
      'where'
      'p.type# in (3,4) and src.bal_cn = ac.bal_cn1 and '
      'p.id = h.id# and h.hdate = :edat and h.facticaldebt <> 0 and'
      'p.currency = o.val_kod and o.dat = :edat and'
      'ac.id# = p.id '
      ''
      'group by src.SourceID'
      ''
      'union all'
      ''
      'select'
      '  count(ac.id) as EcountDep,'
      '  sum(abs(ar.pok_ostat)) as endRest,'
      '  0 as endIntRest,'
      '  src.SourceID'
      'from account ac ,archost ar,uaod_source_bal src'
      'where ac.id = ar.acc_id and '
      'ar.datdate = :edat and ar.ostat <> 0 and src.bal_cn=ac.bal_cn1 '
      ''
      'group by src.SourceID '
      ') '
      'group by SourceID'
      ')'
      'ERest'
      ''
      ''
      ''
      'where'
      ''
      ''
      'src.id =  BRest.sourceID(+) and'
      'src.id =  Tranches.sourceID(+) and'
      'src.id =  Payments.sourceID(+) and'
      'src.id =  ERest.sourceID(+)'
      ''
      '--order by :OrderField'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      '')
