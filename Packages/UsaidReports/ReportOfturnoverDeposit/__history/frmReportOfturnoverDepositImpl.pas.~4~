procedure TfrmReportOfturnoverDeposit.MainGridMDRDblClick(Sender: TObject);
var fstr,fstrB,SpecStr,SpecStrB{,gbstr }:String;
begin
   SpecStr := '';
   SpecStrB := '';
   //gbstr := '  ( ac.bal_cn1 in(SELECT  bal_cn   FROM uaod_source_bal union SELECT    bal_cn  FROM uaod_person_bal union SELECT bal_cn   FROM uaod_type_bal ))' ;

   fstr := FilterStr+' and '+'('+gdepbalspr+')';
   fstrB := FilterStrB;
   fstrB := fstrB +' and '+'('+genStrBal+')';//ShowMessage(fstrB);
   with dmReportOfturnoverDeposit do
        SpecStr := 'src.id = '+IntToStr(MainMDT.FieldByName('ID').AsInteger);

  if fstr = '' then fstr := SpecStr
  else fstr := fstr + ' and ('+ SpecStr+')';

   if fstrB = '' then fstrB := SpecStr
  else fstrB := fstrB + ' and ('+ SpecStr+')';

   with dmReportOfturnoverDeposit,DetailTO do begin
        if Active then CloseAll;
        SetVariable('bdat',brepdat);
        SetVariable('edat',brepdat);
        SetVariable('OrderField','acc_no');
        if fstr <> '' then  SQL[33] :=   fstr
        else SQL[33] := ''; //showmessage(fstrb);
        if fstrB <> '' then  SQL[68] :=   fstrB
        else SQL[68] := ''; //showmessage(fstrb);
        Memo1.Text := sql.Text;
       open;
   end;

    with frmDetailTurnOverDeposit do
     ShowModal;

end;

