procedure TfrmReportAnalysOfPortfel.OKClick(Sender: TObject);

resourcestring rs_gencount = 'select count(p.id) as cnt from cm_portfolio p where p.id in (select creditid from cm_history where hdate=:dat and rest+duerest>0)';
resourcestring rs_geninitialamt = 'select round(sum(p.initialamount*o.ostat),2) as geninitialamount from cm_portfolio p,operkurs o,cm_history h where p.currency = o.val_kod and p.id = h.creditid and hdate =:dat and h.rest+duerest>0';
resourcestring rs_genrest = 'select round(sum(rest*o.ostat+duerest*o.ostat),2) as genrest ,round(sum(p.annualyinterestrate*(h.rest*o.ostat)),2) as roundint from cm_portfolio p,cm_history h,operkurs o where p.id = h.creditid and p.currency = o.val_kod and o.dat =:dat and h.hdate=:dat';
resourcestring r_expires =' p.id in (select psh.creditid from cm_payment_schedule psh ,cm_curr_state cs where  psh.rest < (cs.rest+cs.duerest) and (cs.duerest+cs.rest - psh.rest >= 2) and psh.creditid = cs.creditid and psh.paymentdate <=:dat group by psh.creditid  ';
resourcestring rs_notexpires =' p.id not in (select psh.creditid from cm_payment_schedule psh ,cm_curr_state cs where  psh.rest < (cs.rest+cs.duerest) and (cs.duerest+cs.rest - psh.rest >= 2) and psh.creditid = cs.creditid and psh.paymentdate <=:dat group by psh.creditid) ';
resourcestring r_e = 'having cm_utils.bankdaysbetween (MIN (psh.paymentdate),:dat)>0)';
var
  fst,rs_expires,s_gencount,s_geninitialamt,s_genrest:String;

  gencount,geninitialamt,genrest,roundint :real;

begin
   rs_expires := r_expires+ r_e;
  RepDat := integer(trunc(DTPRAP.DateTime));
  if lfilial.GetCheckedKeyList.Count = 0 then begin ShowMessage('Ən azı bir filial seçilməlidir!'); Exit; end;
  if lcredittypes.GetCheckedKeyList.Count = 0 then begin ShowMessage('Ən azı bir kredit tipi seçilməlidir!'); Exit; end;
  if lvalute.GetCheckedKeyList.Count = 0 then begin ShowMessage('Ən azı bir valyuta seçilməlidir!'); Exit; end;


  FSt := '';
  FilterStr :='';
  gencount := 0;
  geninitialamt:= 0;
  genrest:= 0;
  roundint:= 0;

  //if (lfilial.GetCheckedKeyList.Count<>lfilial.Items.Count) then begin
  if  FilterStr <> '' then
  FilterStr := FilterStr + ' and  p.branchid in ('
                              +lfilial.GetCheckedKeyList.CommaText +')' else begin
   FSt := 'branchid in ('
                              +lfilial.GetCheckedKeyList.CommaText +')';
    FilterStr := '  p.branchid in ('
                              +lfilial.GetCheckedKeyList.CommaText +')';
                              end;
 // end;

  if (lcredittypes.GetCheckedKeyList.Count<>lcredittypes.Items.Count) then begin
  if   FilterStr <> '' then
  FilterStr := FilterStr + ' and p.credittype in  ('
                              +lcredittypes.GetCheckedKeyList.CommaText +')' else
  FilterStr := '  p.credittype in  ('
                              +lcredittypes.GetCheckedKeyList.CommaText +')';

  end;

  if (lvalute.GetCheckedKeyList.Count<>lvalute.Items.Count) then begin
  if FilterStr <> '' then
  FilterStr := FilterStr + ' and p.currency in ('
                              +lvalute.GetCheckedKeyList.CommaText +')' else
    FilterStr := '  p.currency in ('
                              +lvalute.GetCheckedKeyList.CommaText +')';
  end;


  case cbStatusofPort.ItemIndex of
      // -1:FilterStr
       1:begin if FilterStr <> '' then FilterStr := FilterStr + ' and ' + rs_notexpires
         else  FilterStr :=  rs_notexpires;end;
       2:begin if FilterStr <> '' then FilterStr := FilterStr + ' and ' + rs_expires
         else  FilterStr :=  rs_expires;end;
  end;

  with  dmReportAnalysOfPortfel do begin //1

       s_gencount := rs_gencount;
       if FilterStr <> '' then s_gencount := s_gencount + ' and   '+FilterStr;

       with Queries do begin //2
       DeleteVariables;
       DeclareVariable('dat',otDate);
       SetVariable('dat',repdat);
       if Active then CloseAll;
       sql.Clear;
       sql.Add(s_gencount);  //Memo1.text := sql.text;
       Open;
       gencount := FieldByName('cnt').AsFloat;
       if gencount = 0 then gencount := 1;


       s_geninitialamt := rs_geninitialamt;
       s_geninitialamt := s_geninitialamt + ' and o.dat = ' + QuotedStr(FormatdateTime('dd-mmm-yyyy',RepDat));
       if FilterStr <> '' then s_geninitialamt := s_geninitialamt + ' and '+FilterStr;

       CloseAll;
       DeleteVariables;
       DeclareVariable('dat',otDate);
       SetVariable('dat',repdat);
       sql.Clear;
       sql.Add(s_geninitialamt);
       Open;
       geninitialamt := FieldByName('geninitialamount').AsFloat;
       if geninitialamt = 0 then geninitialamt := 1;



       s_genrest := rs_genrest;
       s_genrest := s_genrest + ' and o.dat = ' + QuotedStr(FormatdateTime('dd-mmm-yyyy',RepDat));
       if FilterStr <> '' then s_genrest := s_genrest + ' and '+FilterStr;

       CloseAll;
       DeleteVariables;
       DeclareVariable('dat',otDate);
       SetVariable('dat',repdat);
       sql.Clear;
       sql.Add(s_genrest);
       //Memo1.text := sql.text;
       Open;
       genrest := FieldByName('genrest').AsFloat;
       if genrest = 0 then genrest := 1;
       roundint := FieldByName('roundint').AsFloat/genrest;
       roundint := trunc(roundint) + round((roundint-trunc(roundint))*100)/100;

       end; //2

       case RgrSum.ItemIndex of
           0:GetInitData(CategoriesSumds,gencount,genrest,repdat,FilterStr,20,false,'',FSt);
           1:GetInitData(PersonsSumds,gencount,genrest,repdat,FilterStr,20,false,'',FSt);
           2:GetInitData(PledgsPledgsSumds,gencount,genrest,repdat,FilterStr,21,false,'',FSt);
           3:GetInitData(ValutesSumds,gencount,genrest,repdat,FilterStr,20,false,'',FSt);
           4:GetInitData(RegionsSumds,gencount,genrest,repdat,FilterStr,23,false,'',FSt);
           //5:GetInitData(CountriesSumds,gencount,genrest,repdat,FilterStr,22,false);
           //6:GetInitData(CalcMethodsSumDs,gencount,genrest,repdat,FilterStr,21,false);
           5:GetInitData(ReservesSumds,gencount,genrest,repdat,FilterStr,22,true,'',FSt);
           6:GetInitData(AnnualIntSumds,gencount,genrest,repdat,FilterStr,46,false,'d.sectorID',FSt);
           7:GetInitData(PeriodsSumds,gencount,genrest,repdat,FilterStr,52,false,'d.sectorID',FSt);
       end;

       end;//1

       EdRest.text := FloatToStr(genrest);
       EdCrdCount.text := FloatToStr(gencount);
       edThisAmt.text := FloatToStr(geninitialamt);
       EdRoundInt.text := FloatToStr(roundint)+'%';

end;

procedure TfrmReportAnalysOfPortfel.GetInitData( v_ds :TDataSource; v_count :real;
                                                 v_initamt :Real; v_dat :TDateTime;
                                                 v_FStr:String; v_sqlcnt :integer;v_def :boolean;
                                                 v_ord:String;v_f :string);
begin

   with  v_ds.DataSet as TOracleDataSet do begin
         if Active then CloseAll;
         SetVariable('dat',v_dat);
         SetVariable('GENCOUNT',v_count);
         SetVariable('GENINITAMT',v_initamt);
         SetVariable('ffilter',v_f);
         if (not v_def) and (v_ord='') then
         SetVariable('OrderField','sector')
         else
         SetVariable('OrderField','c.percent');

         if v_ord <> '' then
         SetVariable('OrderField',v_ord);

         if v_FStr <> '' then SQL[v_sqlcnt] := ' and '+v_FStr
         else SQL[v_sqlcnt] := '';
         //Memo1.text := sql.text;
         Open;
   end;
   
   MainGrid.DataSource := v_ds;
   
end;

