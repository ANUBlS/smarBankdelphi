procedure TfrmReportAnalysOfPortfel.MainGridDblClick(Sender: TObject);

var fstr,SpecStr :String;

begin
   SpecStr := '';

   fstr := FilterStr;
with dmReportAnalysOfPortfel do
   case RgrSum.ItemIndex of
        0: SpecStr := 'p.customertype = '+IntToStr(CategoriesSum.FieldbyName('CUSTOMERTYPE').AsInteger);
        1: SpecStr := 'p.personaltype = '+IntToStr(PersonsSum.FieldbyName('personaltype').AsInteger);
        2: SpecStr := 'p.id in (select creditid from cm_guarantee where PLEDGEID = '+IntToStr(PledgsSum.FieldbyName('PLEDGEID').AsInteger)+')';
        3: SpecStr := 'p.currency = '+IntToStr(ValutesSum.FieldbyName('currency').AsInteger);
        4: SpecStr := 'p.id in (select creditid from creditsmgr.cm_business_plan where villageid in (select id from agro_village where depend_id = '+IntToStr(RegionsSum.FieldbyName('DEPEND_ID').AsInteger) +'))  ';
        5: SpecStr := 'h.reserveid = '+IntToStr(ReservesSum.FieldbyName('RESERVEID').AsInteger);
        6: SpecStr := 'p.ANNUALYINTERESTRATE between '+IntToStr(AnnualIntSum.FieldbyName('bper').AsInteger) +' and '+IntToStr(AnnualIntSum.FieldbyName('eper').AsInteger);
        7: SpecStr := 'cm_utils.BankDaysBetween(p.DATEOFCONCLUSION,p.DUEDATEFIRSTCONTRACT) between '+IntToStr(PeriodsSum.FieldbyName('bper').AsInteger) +' and '+IntToStr(PeriodsSum.FieldbyName('eper').AsInteger);
   end;

  if fstr = '' then fstr := SpecStr
  else fstr := fstr + ' and ('+ SpecStr+')';
  //if FilterStr <> '' then fstr := FilterStr;
   with dmReportAnalysOfPortfel,ODSDetail do begin
        if Active then CloseAll;
        SetVariable('dat',RepDat);
        SetVariable('OrderField','numberofcredit');
        if fstr <> '' then  SQL[40] := ' and  ' + fstr
        else SQL[40] := ''; //showmessage(fstr);
        open;
   end;
    with frmDetailRepAnalisOfPort do begin
     MainGriddetail.DataSource := dmReportAnalysOfPortfel.ODSDetailds;
     DBEditEh1.DataSource := dmReportAnalysOfPortfel.ODSDetailds;
     DBEditEh2.DataSource := dmReportAnalysOfPortfel.ODSDetailds;
     DBEditEh3.DataSource := dmReportAnalysOfPortfel.ODSDetailds;
     DTP.DateTime := RepDat;
     ShowModal;
    end;

end;

