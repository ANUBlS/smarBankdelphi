procedure TfrmReportAnalysOfPortfel.MainGridTitleBtnClick(Sender: TObject;
  ACol: Integer; Column: TColumnEh);
var
  SortField ,cname: String;
begin
  cname := (Sender as TDBGridEh).DataSource.DataSet.Name;
  if (Sender as TDBGridEh).DataSource.DataSet.active then   begin
  SortField := Column.FieldName;

  if  ((cname = 'AnnualIntSum') or (cname= 'PeriodsSum')) and
  (not (Sender as TDBGridEh).DataSource.DataSet.FieldByName(SortField).Calculated ) then
     SortField :=  'd.sectorID';

  if (Sender as TDBGridEh).DataSource.DataSet.FieldByName(Column.FieldName).Calculated then
  SortField := copy(Column.FieldName,5,length(Column.FieldName)) ;
  if Column.Title.SortMarker = smDownEh then
    SortField := SortField + ' DESC';
  with Sender as TDBGridEh , TOracleDataSet(DataSource.DataSet) do
  begin
   // ClearVariables;
    Screen.Cursor := crSQLWait;
    SetVariable('OrderField',SortField);
    RefResh;
    Screen.Cursor := crDefault;
   end;
    end;
end;

