      'union'
      
        'select 4 as ID,'#39'180<=360'#39' as sector,181 as bper ,360 as eper fro' +
        'm dual'
      'union'
      
        'select 5 as ID,'#39'360<=720'#39' as sector,361 as bper ,720 as eper fro' +
        'm dual'
      'union'
      
        'select 6 as ID,'#39'720<=1080'#39' as sector,721 as bper ,1080 as eper f' +
