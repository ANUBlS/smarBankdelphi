   if Trim(EditAcc_no.Text)  <> '' //and (Bal_sprEdit.Text = '')
     then  GetBySubAccout(EditAcc_no.Text, True ,BeginDTPicker.Date, EndDTPicker.Date)
     else
     if Trim(Bal_sprEdit.Text) <> ''
       then
         GetByBal(Bal_sprEdit.Text, BeginDTPicker.Date, EndDTPicker.Date)
       else
         GetAll(BeginDTPicker.Date, EndDTPicker.Date);
//         Flag := False;
   FinishPosition := 0;
   ShowSheet;
  finally
   Screen.Cursor := crDefault;
   DestroySheet;
//   if not Flag then ClearLogInfo;
//   Flag := True;
  end;
end;

