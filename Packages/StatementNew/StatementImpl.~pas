procedure TStatementX.PrepareReportTable;
var
  a_name, v_EditClientID, v_EditAcc_no, v_Bal_spr : string;
  v_EditVal, v_SpeciesBalAccount : integer;
  d1, d2: TDateTime;
  v_user, v_filial: integer;
  TurnYesNo,RateDif : Integer;

  begin
{}
 v_user:=dblcbUser.KeyValue;
 v_filial:=dblcbfilial.KeyValue;
 v_EditVal:=DBLCBavalute.KeyValue;
  if ComboBoxBalance.ItemIndex=-1 then
    v_SpeciesBalAccount:= 1
  else
    v_SpeciesBalAccount:= ComboBoxBalance.ItemIndex + 1;

  if EditClientID.Text = '' then
    v_EditClientID:= '-1'
  else
    v_EditClientID:= EditClientID.Text;

  if EditAcc_no.Text = '' then
    v_EditAcc_no:= '-1'
  else
    v_EditAcc_no:= EditAcc_no.Text;

  if Bal_sprEdit.Text = '' then
    v_Bal_spr:= '-1'
  else
    v_Bal_spr:= UpdateStr(Bal_sprEdit.Text);

  d1 := Int(BeginDTPicker.DateTime);
  d2 := Int(EndDTPicker.DateTime);

{создание таблиц  Extraction_smart}

 TurnYesNo:=CBTurnOver.Tag;
 RateDif:=CBRateDiff.Tag;

  with StatementDataModNew.P_Extraction_OP do
    CallProcedure('getextraction', [
      v_user,
      v_filial,
      v_SpeciesBalAccount,
      v_EditVal,
      v_EditClientID,
      UpdateStr(v_EditAcc_no),
      v_Bal_spr,
      d1,
      d2,
      RateDif,
      TurnYesNo
      ]);
  with StatementDataModNew.P_Extraction_OP do
    a_name := CallStringFunction('GetUserName', []);

  with StatementDataModNew.Extraction_ODSt do begin
    Close;
    with SQL do begin
      Clear;
//      Add('select * from EXTRACTION_'+a_name +' order by accountnumber ');
      Add('select * from SMART.EXTRACTION order by accountnumber ');
    end;
    Active:= true;
  end;

  with StatementDataModNew.ExtractionTrans_ODSt do begin
    CloseAll;
    with SQL do begin
      Clear;
//      Add('select * from EXTRACTIONTRANS_'+a_name);
      Add('select * from SMART.EXTRACTIONTRANS');
      Add(' where (OwnAccountID = :OwnAccountID) ');
      Add(' order by dat, debit, kredit');
    end;
    Active:= true;
  end;
end;


