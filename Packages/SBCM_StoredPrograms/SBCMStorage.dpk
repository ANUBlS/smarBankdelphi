package SBCMStorage;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart Contract Menegment :Stored Programs'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  sboapi50,
  doa40d5;

contains
  StoredProgramsUnit in 'StoredProgramsUnit.pas',
  DataModuleStoredPrograms in 'DataModuleStoredPrograms.pas' {DataModuleRefer: TDataModule};

end.
