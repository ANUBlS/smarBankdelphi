procedure TQueryExporterForm.ActiveFormCreate(Sender: TObject);
begin
  QueryExporterForm := Self;
  ResultForm := TResultForm.Create(Self);
  Queries.Open;
  dtOpDatEnd.DateTime:=now;
  dtpOpDat.DateTime:=now;
dtpOpDat.MaxDate:=dtOpDatEnd.DateTime;
dtOpDatEnd.MinDate:=dtpOpDat.DateTime;
end;

procedure TQueryExporterForm.ActiveFormDestroy(Sender: TObject);
begin
  Queries.CloseAll
end;

procedure TQueryExporterForm.RunSelectedQuery1Click(Sender: TObject);
begin
  Screen.Cursor := crSQLWait;
  with ResultForm.ResultQuery do
  try
    SQL.Text := Queries.FieldByName('Query').AsString;
    Open;
    Screen.Cursor := crDefault;
    ResultForm.ShowModal;
  finally
    Screen.Cursor := crDefault;
    CloseAll;
  end;
end;

