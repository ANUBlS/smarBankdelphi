  procedure TQueryExporterForm.InputBoxSetPasswordChar(var Msg: TMessage);
var
   hInputForm, hEdit, hButton: HWND;
begin
   hInputForm := Screen.Forms[0].Handle;
   if (hInputForm <> 0) then
   begin
     hEdit := FindWindowEx(hInputForm, 0, 'TEdit', nil);
     SendMessage(hEdit, EM_SETPASSWORDCHAR, Ord('*'), 0);  {}
   end;
end;

procedure TQueryExporterForm.Button1Click(Sender: TObject);
var
  InputString: string;
begin


 {*****************Sabuhi .M 27.02.2020*****************}

  DBMemo1.Visible:=false;
  PostMessage(Handle, InputBoxMessage, 0, 0);
  InputString := InputBox('Autentifikasiya', 'Parolu daxil edin', '');

  if InputString='SMART' then
    DBMemo1.Visible:= not DBMemo1.Visible
  else
    ShowMessage('Düzgün parol daxil edilməyib və ya bu bölmə sizin üçün aktiv deyil');



end;

procedure TQueryExporterForm.RunSelectedQuery1Click(Sender: TObject);
begin
  Screen.Cursor := crSQLWait;
  with ResultForm.ResultQuery do
{*****************Sabuhi .M 27.02.2020*****************}
  try
    SQL.Text := Queries.FieldByName('Query').AsString;
    DeleteVariables;
   if  ContainsText(Queries.FieldByName('Query').AsString, ':begindat')     then
   begin
    DeclareVariable('begindat',otdate);
    SetVariable('begindat',trunc(dtpOpDat.DateTime));
     { ShowMessage(booltostr(ContainsText(Queries.FieldByName('Query').AsString, ':begindat') ));
    ShowMessage(GetVariable(0));    }
     if ContainsText(Queries.FieldByName('Query').AsString, ':enddat') then
       begin
           DeclareVariable('enddat',otdate);
            SetVariable('enddat',trunc(dtOpDatEnd.DateTime));
       {ShowMessage(booltostr(ContainsText(Queries.FieldByName('Query').AsString, ':enddat') ));
      ShowMessage(GetVariable(1));     }
       end;
     Open;
    Screen.Cursor := crDefault;
    ResultForm.ShowModal;
   end
   else
   begin
      Open;
    Screen.Cursor := crDefault;
    ResultForm.ShowModal;
   end;
  finally
    Screen.Cursor := crDefault;
    CloseAll;
  end;




end;

