procedure TTAXS.ap1Click(Sender: TObject);
var
a,i:integer;
v_coll_num,v_bank_text,v_limit_text :string;
begin
OracleDataSet1.close;
OracleDataSet1.open;
if (ods_inFLEG.AsString='GA')or (ods_inFLEG.AsString='GD')or (ods_inFLEG.AsString='GAI')or (ods_inFLEG.AsString='GDI')
                             or (ods_inFLEG.AsString='GAS')or (ods_inFLEG.AsString='GDS')  then
 begin

 showmessage('  Geriçağrılma olanlrı çapa vermək olmaz  ! ');
    Exit
    end
    else
  begin

v_coll_num:=ods_inCOLL_NUM.AsString;
v_bank_text:=ods_inBANK_TEXT.AsString+'/';
v_limit_text:=ods_inLIMIT_TESXT.AsString;

OraclePackage2.CallProcedure('report_tax',[v_coll_num,v_bank_text]) ;
OracleDataSet1.Open;
OracleDataSet1.Refresh;
//showmessage(v_limit_text);
OraclePackage1.CallProcedure('get_vergul_tax',[v_coll_num,v_limit_text]) ;


if not assigned(rep) then rep:=trep.Create(self);
   with rep do
   begin
for I := 0 to OracleDataSet1.RecordCount do
  begin


        for a :=0 to rep.ComponentCount- 1 do begin
          if (rep.Components[a].ClassType = TQRLabel) then
            begin

          if rep.Components[a].Name=OracleDataSet1COLUM.AsString then
            (rep.Components[a] as TQRLabel).Caption:= OracleDataSet1TEXT.AsString

          end;
        end;
    OracleDataSet1.Next;

  end;
   end;
   rep.ods_a.close;
   rep.ods_a.open;
   rep.QRLabel30.Caption:= v_coll_num;
   rep.Preview;
   rep.ods_a.Session.Commit;


  end;
end;

