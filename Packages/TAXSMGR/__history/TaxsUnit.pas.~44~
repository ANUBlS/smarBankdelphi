procedure TTAXS.EditSearchKeyPress(Sender: TObject; var Key: Char);
begin
if Length(EditSearch.Text)<>0 then
  begin
  ods_in.Close;
  case CBSearch.ItemIndex of
  0:ods_in.SQL[12]:='and c.id like '''+EditSearch.Text+'%''';
  1:ods_in.SQL[12]:='and t.coll_num  like '''+EditSearch.Text+'%''';
  2:ods_in.SQL[12]:='and upper(c.name) like upper(''%'+EditSearch.Text+'%'')';
  3:ods_in.SQL[12]:='and upper(a.acc_no) like upper(''%'+EditSearch.Text+'%'')';

   end;
  //SHOWMESSAGE(ods_main.Fields[CBSearch.ItemIndex].FieldName+'---'+EditSearch.Text);
  ods_in.Open;
  end
  else
  begin
  ods_in.Close;
  ods_in.SQL[12]:='';
  ods_in.Open;
  end;
end;

