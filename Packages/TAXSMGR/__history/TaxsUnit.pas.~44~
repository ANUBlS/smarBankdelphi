procedure TTAXS.ToolButton1Click(Sender: TObject);
var
begin_dat,end_dat,text_net,text,text1,text2,text3,text4,text5,text6,text7,text8,text9,text10,text11,sqt_text,sert:string;
begin
begin_dat:= formatdatetime('DD/MM/YYYY',DateTimePicker3.DateTime);
end_dat:= formatdatetime('DD/MM/YYYY',DateTimePicker2.DateTime);
 sert:='and';
with ods_in do
begin
  close;
 SetVariable('begin_dat',begin_dat);
 SetVariable('end_dat',end_dat);

 if XFCheckBox1.Checked then
 text:=' fleg like'+'''A'''
 else
 text:='';

 if XFCheckBox2.Checked then
 text1:='or fleg like'+'''D'''
 else
 text1:='';

 if XFCheckBox5.Checked then
 text4:='or fleg like'+'''AI'''
 else
 text4:='';
 if XFCheckBox8.Checked then
 text5:='or fleg like'+'''DI'''
 else
 text5:='';

 if XFCheckBox6.Checked then
 text6:='or fleg like'+'''AS'''
 else
 text6:='';
 if XFCheckBox7.Checked then
 text7:='or fleg like'+'''DS'''
 else
 text7:='';

  if XFCheckBox9.Checked then
 text8:='or fleg like'+'''GAI'''
 else
 text8:='';
 if XFCheckBox10.Checked then
 text9:='or fleg like'+'''GDI'''
 else
 text9:='';

   if XFCheckBox11.Checked then
 text10:='or fleg like'+'''GAS'''
 else
 text10:='';
 if XFCheckBox12.Checked then
 text11:='or fleg like'+'''GDS'''
 else
 text11:='';

 if XFCheckBox3.Checked then
 text2:='or fleg like'+'''GA'''
 else
 text2:='';

 if XFCheckBox4.Checked then
 text3:='or fleg like'+'''GD'''
 else
 text3:='';
  if (text='') and (text1='') and (text2='') and (text3='')and (text4='') and (text5='')and (text6='')
               and (text7='') and (text8='') and (text9='')and (text10='')and (text11='') then
    begin
    showmessage('  Heç bir tip seçilməyib    !');
    exit
    end
    else begin
 if text<>'' then
   begin
 sqt_text:= text+ ' '+text1+' '+text2+' '+text3+' '+text4+' '+text5+' '+text6+' '+text7+' '+text8+' '+text9+' '+text10+' '+text11;
    end
   else
   begin
   text_net:=text1+''+text2+''+text3+' '+text4+' '+text5+' '+text6+' '+text7+' '+text8+' '+text9+' '+text10+' '+text11;
   sqt_text:=copy(text_net,ansipos('or',text_net)+length('or'),length(text_net) );
   end;
  ods_in.SQL[20]:=sert+' ' +'('+sqt_text+')';
  open;
 end;
end;

end;

