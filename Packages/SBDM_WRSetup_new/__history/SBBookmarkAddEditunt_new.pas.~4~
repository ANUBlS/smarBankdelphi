unit SBBookmarkAddEditunt_new;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
   ActnList, DBCtrlsEh, DBLookupEh, StdCtrls, Mask, DBCtrls;

type
  TSBBookmarkAddEditForm_new = class(TForm)
    ActionList1: TActionList;
    ActnAccept: TAction;
    ActnReject: TAction;
    Button1: TButton;
    Button2: TButton;
    DBEdit3: TDBEdit;
    DBLookupComboboxEh1: TDBLookupComboboxEh;
    Label1: TLabel;
    Label4: TLabel;
    procedure ActnAcceptExecute(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  SBBookmarkAddEditForm_new: TSBBookmarkAddEditForm_new;

implementation
    uses SBWRSetupDataModImpl_new,SBWRBookmarksTuning_new,SBTranslateProc,sboapiDataModuleimpl;
{$R *.dfm}

procedure TSBBookmarkAddEditForm_new.ActnAcceptExecute(Sender: TObject);

resourcestring
     BookmarkNameEmptyMsg='Bukmakın adı  daxil edilməyib';
     descriptionNameEmptyMsg='Тяйинаты  даxил eдилмяйиб';
   begin

     if  (DBLookupComboboxEh1.Text<>'') and (DBEdit3.Text<>'') then
     begin
       with SBWRSetupDataMod.SBWRBookmarksDSet do
            Post;
            ModalResult := mrOk;
     end else
     begin
       if DBLookupComboboxEh1.Text='' then Showmessage('Тяйинаты  даxил eдилмяйиб');
       if DBEdit3.Text='' then Showmessage('Букмаркын ады  даxил eдилмяйиб');
       with SBWRSetupDataMod.SBWRBookmarksDSet do
            Cancel;
    end;
end;

end.
