{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  vcl,
  CMVCL50,
  DclEhlib50,
  Ehlib50,
  sboapi50,
  DOA41dxe,
  SBTranslate,
  SBDM_Common_new,
  rtl;

contains
