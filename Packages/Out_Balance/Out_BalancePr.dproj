			<Base>true</Base>
		</PropertyGroup>
		<PropertyGroup Condition="'$(Base)'!=''">
			<DCC_ImageBase>00400000</DCC_ImageBase>
			<DCC_UsePackage>Vcl;SBCommon50;sbplg50;doa41dXE;sboapi50;Vcldb;Dclbde;SBTranslate;QR5RunDXE;SBExcelExporter</DCC_UsePackage>
