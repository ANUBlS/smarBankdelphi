procedure TOut_Balance.BitBtn1Click(Sender: TObject);
Var
  Get_Balance: WideString;
begin
  Screen.Cursor := crSQLWait;
  try
    ProgressBar.StepBy(10);
    ProgressBar.StepBy(47);
    CrFilialStr;
    Get_Balance := (sb_GetBalance(Trunc(DTPBegin.DateTime),
      Trunc(DTPEnd.DateTime), ComboBoxPlan.ItemIndex + 1,
      Rate[CmbBoxRate.ItemIndex], CmbBoxFormat.ItemIndex, BranchStr));

    sb_OpenDataSet(Formout_DataModuleMain.ODSMain, 'AStrParam', Get_Balance);

    ProgressBar.StepBy(33);
    Screen.Cursor := crDefault;

    if (Sender as TBitBtn).Tag = 1 then
      sb_InitRpt(ComboBoxFont.ItemIndex)
    else
      with ExportForm do
        ShowModal;

    ProgressBar.StepBy(10);
    ProgressBar.Position := 0;
  except
    Screen.Cursor := crDefault;
    ProgressBar.Position := 0;
    raise;
  end;

end;

