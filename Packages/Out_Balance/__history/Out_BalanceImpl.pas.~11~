procedure TOut_Balance.BtnCreateFileClick(Sender: TObject);
var
  DBaseName, TblName: String;
  Path: String;
  lpExistingFileName: array [0 .. 255] of Char;
  lpNewFileName: array [0 .. 255] of Char;
  Diversity: Integer;
begin
  Path := ExtractFilePath(Application.ExeName) + 'F600ta.dbf';
  StrPCopy(lpExistingFileName, Path);
  StrPCopy(lpNewFileName, PathEdit.Text);

  if FileExists(PathEdit.Text) then
    if MessageDlg(Format('Overrite the Existing File ?' + #13 + ' %s  ',
      [PathEdit.Text]), mtConfirmation, MBYESNOCANCEL, 0) <> mrYes then
      Exit;

  if not CopyFile(lpExistingFileName, lpNewFileName, False) then
  begin
    showmessage('File Creation UnSuccesful Terminated!');
    Exit;
  end;

  DBaseName := ExtractFileDir(PathEdit.Text);
  TblName := ExtractFileName(PathEdit.Text);

  Diversity := StrToInt(DivisorEdit.Text);

  Screen.Cursor := crSQLWait;
  ProgressBar.Position := 0;

  try
    sb_OpenDataSet(Formout_DataModuleMain.ODSMain, 'AStrParam',
      sb_GetBalance(Trunc(DTPBegin.DateTime), Trunc(DTPEnd.DateTime),
      ComboBoxPlan.ItemIndex + 1, Rate[0], 0 { CmbBoxFormat.ItemIndex } ));
    with Formout_DataModuleMain.ODSMain do
    begin
      Filter := '(LastActive<>0)or(LastPassive<>0)';
      Filtered := True;
    end;
    ProgressBar.StepBy(60);
    with MBBalance do
      try
        DatabaseName := DBaseName;
        TableName := TblName;
        OPEN;
        ProgressBar.StepBy(100);
        ProgressBar.Position := 0;
        ProgressBar.Max := Formout_DataModuleMain.ODSMain.RecordCount;
        Formout_DataModuleMain.ODSMain.First;
        while not Formout_DataModuleMain.ODSMain.EOF do
        begin
          Insert;
          FieldByName('NB').Value := ODSBankInfo.FieldByName('NB').Value;
          FieldByName('NF').Value := ODSBankInfo.FieldByName('BF').Value;
          FieldByName('NB1').Value := Formout_DataModuleMain.ODSMain.FieldByName
            ('Bal_CN').Value;
          FieldByName('Sum1').Value := Formout_DataModuleMain.ODSMain.FieldByName
            ('LastActive').Value * Diversity;
          FieldByName('Sum2').Value := Formout_DataModuleMain.ODSMain.FieldByName
            ('LastPassive').Value * Diversity;
          Post;

          Formout_DataModuleMain.ODSMain.Next;
          ProgressBar.StepIt;
        end;
      finally
        Close;
        showmessage(Format('Creating %s ' + #13 +
          'Balance File successfully completed!', [PathEdit.Text]));
      end;
  finally
    Screen.Cursor := crDefault;
    ProgressBar.Position := 0;
  end;

end;

