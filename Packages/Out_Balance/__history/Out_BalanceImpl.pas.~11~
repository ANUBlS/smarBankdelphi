 procedure TOut_Balance.CrFilialStr;
var
  i: Integer;
  k: Boolean;
begin
  BranchStr := ' ';
  k := True;
  for i := 0 to (ChListFilial.Items.Count - 1) do
  begin
    if ChListFilial.Checked[i] = True then
    begin
      if k = True then
        BranchStr := BranchStr + LBoxFilial.Items[i]
      else
        BranchStr := BranchStr + ',' + LBoxFilial.Items[i];
      k := False;
    end;
  end;
end;
