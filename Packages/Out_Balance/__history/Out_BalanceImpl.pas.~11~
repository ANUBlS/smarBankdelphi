procedure TOut_Balance.FillCBRate;
var
  RateIndex: Byte;
begin
  with Formout_DataModuleMain.ODSRate do
  begin
    OPEN;
    RateIndex := 0;
    SetLength(Rate, RecordCount + 1);
    CmbBoxRate.Items.Clear;
    CmbBoxRate.Items.Add('Bütün valyutalar');
    Rate[RateIndex] := -1;
    First;
    while not EOF do
    begin
      INC(RateIndex);
      Rate[RateIndex] := FieldByName('Valute').AsInteger;
      CmbBoxRate.Items.Add(FieldByName('VALU_NAME').AsString);
      Next
    end;
  end;
end;

procedure TOut_Balance.FillBranch;
var
  BranchIndex: Integer;
begin
  with Formout_DataModuleMain.BranchDataSet do
    try
      OPEN;
      SetLength(Branch, RecordCount + 1);
      First;
      BranchIndex := 0;
      ChListFilial.Items.Clear;
      Branch[BranchIndex] := -1;
      while not EOF do
      begin
        BranchIndex := BranchIndex + 1;
        ChListFilial.Items.Add(FieldByName('Name').AsString);
        LBoxFilial.Items.Add(FieldByName('ID').AsString);
        ChListFilial.Checked[BranchIndex - 1] := True;
        Branch[BranchIndex] := FieldByName('ID').AsInteger;
        Next;
      end;
    finally
      // Close;
    end;
end;
procedure TOut_Balance.ActiveFormCreate(Sender: TObject);
begin
  out_Balance := Self;
  Formout_DataModuleMain := TFormout_DataModuleMain.Create(Self);
  FrmAnaliz := TFrmAnaliz.Create(Self);
  ExportForm := TExportForm.Create(Self);
  BalanceRpt1 := TBalanceRpt1.Create(Self);
  BalanceRpt2 := TBalanceRpt2.Create(Self);
  BalanceRpt3 := TBalanceRpt3.Create(Self);
  BalanceRpt4 := TBalanceRpt4.Create(Self);
  InterBalance := TInterBalance.Create(Self);
  InterBalance2 := TInterBalance2.Create(Self);
  QRBalance := TQRBalance.Create(Self);
  Screen.Cursor := crSQLWait;
  Modified := True;
  try
    DTPBegin.DateTime := sb_GetBankDate;
    DTPEnd.DateTime := sb_GetBankDate;
    FillCBRate;
    FillBranch;
    ODSBankInfo.OPEN;
    Formout_DataModuleMain.ODS_SETTINGS.OPEN;
    if Formout_DataModuleMain.ODS_SETTINGS.FieldByName('Value').AsInteger = 2 then
    begin
      // BitBtnOk.Visible :=false;
      BtnCompBalance.Visible := True;
      BtnCompBalanceSettings.Visible := True;
    end;
    CmbBoxRate.ItemIndex := 0;
    ComboBoxPlan.ItemIndex := 0;
    CmbBoxFormat.ItemIndex := 0;
    ComboBoxFont.ItemIndex := 0;

    Screen.Cursor := crDefault;
  except
    Screen.Cursor := crDefault;
    raise;
  end;

  TranslateAllComponents(Self, Formout_DataModuleMain.OPack_SL);
end;
