procedure TTranceTransaction.Button3Click(Sender: TObject);
var
   i: Integer;
   ID: Longint;
   f,WillRefresh: Boolean;
   Status, CommitedCount, ErrorCount: Word;
   LastErrorMessage: String;
   vidop :integer;
begin
{f:=TransactionDataModule.SB_ACA.CallBooleanFunction('checkadvancedobjectaccess',['COMMITSTATUS']);
 if  f =false then
 begin
  showmessage('Əməliyyatı təsdiqləmək hüquqnuz  yoxdur  !');
 exit;
 end; }

 CommitedCount :=0;
 ErrorCount :=0;

 with TrData, GridTransactions, SelectedRows, DataSource.DataSet do
  if MessageDlg('Əməliyyatlar təsdiqlənsin?', mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
  begin
   DisableControls;
   try
    Application.ProcessMessages;
    if Count = 0 then CurrentRowSelected :=True;
    for i :=0 to Count -1 do
    try
     GotoBookmark(TBookmark(Items[i]));
     Status :=FieldByname('Status').AsInteger;
     if Status in [tsDelayed, tsRejected] then
     begin
      ID := FieldByName('ID').AsInteger;
      vidop:= FieldByName('vid_op').AsInteger;

      if vidop=99 then
      begin
      ods_m10_chek.close;
      ods_m10_chek.SetVariable('trid',id);
      ods_m10_chek.open;


     webservispkg.CallProcedure('call_services',[ods_m10_chekPHONE_H.AsString,
                                                 ods_m10_chekAMMOUNT.AsFloat,
                                                 ods_m10_chekID.AsString,
                                                 ods_m10_chekPASSPIN.AsString
                                               ]);
        ods_payout_chek.Close;
        ods_payout_chek.SetVariable('dat',Trunc( DTPCurrentDate_pro.DateTime));
        ods_payout_chek.SetVariable('v_creditid',id);
        ods_payout_chek.Open;
        if ods_payout_chekOPERATION_STATUS_1.AsString='SUCCESS' then
          begin
            tranche.CallProcedure('tranche_commit',[ID]);
            CommitTransaction(ID);
            Inc(CommitedCount);
            SBCommit();
          end;

      end;
     if vidop=86 then
      begin
      tranche.CallProcedure('tranche_commit',[ID]);
      CommitTransaction(ID);
      Inc(CommitedCount);
      SBCommit();
        end;

     end;
     except
     on E: Exception do
      begin
       LastErrorMessage :=E.Message;
       Inc(ErrorCount);
       Continue;
      end;
    end;
   finally
    if ErrorCount > 0 then
     if ErrorCount = 1 then
      MessageDlg(LastErrorMessage, mtConfirmation, [mbOk], 0)
     else
      MessageDlg(Format(cs_CommitInformation, [CommitedCount + ErrorCount, CommitedCount, ErrorCount]), mtConfirmation, [mbOk], 0);

    EnableControls;

TrData.Transactions_lazytr.Refresh;

   end;
  end;
 GridTransactions.DataSource.DataSet.Locate('ID',ID,[loCaseInsensitive,loPartialKey]);


end;

