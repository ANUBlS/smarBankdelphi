package cu_Schedule;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Adding And Editing Contract'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  sboapi50,
  CMVCL50,
  CU_COMMON,
  doa41dxe,
  dclbde,
  QR5RunDXE,SBtranslate;

contains
  cuScheduleDataModuleImpl in 'cuScheduleDataModuleImpl.pas' {ScheduleDataModule: TDataModule},
  cuScheduleMainFormImpl in 'cuScheduleMainFormImpl.pas' {ScheduleForm},
  cuSheduleAddUnt in 'cuSheduleAddUnt.pas' {AddEditForm},
  cuScheduleLoaderImpl in 'cuScheduleLoaderImpl.pas',
  cuTrancheScheduleImpl in 'cuTrancheScheduleImpl.pas' {TrancheScheduleForm},
  cuTrancheScheduleDataModuleImpl in 'cuTrancheScheduleDataModuleImpl.pas' {TrancheSheduleDataMod: TDataModule},
  cuAnnutyPaymentFormImpl in 'cuAnnutyPaymentFormImpl.pas' {AnnutyForm},
  cuTrSchedUpdImpl in 'cuTrSchedUpdImpl.pas' {frmUpdTrSched},
  cuTrSchedAddImpl in 'cuTrSchedAddImpl.pas' {frmAddTrSched},
  cufrmReportTypeImpl in 'cufrmReportTypeImpl.pas' {frmReportType},
  cuReportImpl in 'cuReportImpl.pas' {ReportForm},
  cuChangeScheduleImpl in 'cuChangeScheduleImpl.pas' {FrmChangeSchedule};

end.
