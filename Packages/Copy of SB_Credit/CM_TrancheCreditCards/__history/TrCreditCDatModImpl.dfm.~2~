  object Transactions: TOracleDataSet
    SQL.Strings = (
      'SELECT'
      '   A.ACC_NO as DebitAccNo, '
      '   D.VAL_NAME as DebitCurrency, '
      '   C.ACC_NO as CreditAccNo, '
      '   T.Ostat,'
      '   E.VAL_NAME  as CreditCurrency,'
      '   B.TRDATE ,'
      '   B.CANPROCESS , '
      '   B.INBALANCECHAR , '
      '   B.FLAGS , '
      '   B.DEBITAMOUNT , '
      '   B.CREDITAMOUNT , '
      '   B.NATAMOUNT ,'
      '   B.TrDescription'
      'FROM'
      '   SB_ACCOUNT A'
      ' , SB_AVALUTE D'
      ' , CM_TRANSACTIONS B'
      ' , SB_ACCOUNT C'
      ' , SB_AVALUTE E'
      ' ,SB_TENOSTAT T'
      'WHERE'
      '     (B.DEBITACCID = A.ID)'
      ' AND (D.VALUTE = A.VAL_ACC)'
      ' AND (B.CREDITACCID = C.ID)'
      ' AND (C.VAL_ACC = E.VALUTE)'
      ' and (T.ACC_ID = B.CREDITACCID)'
      ''
      ''
      'union '
      ''
      'SELECT'
      '   A.ACC_NO as DebitAccNo, '
      '   D.VAL_NAME as DebitCurrency, '
      '   C.ACC_NO as CreditAccNo, '
      '   T.Ostat,'
      '   E.VAL_NAME  as CreditCurrency,'
      '   B.TRDATE ,'
      '   B.CANPROCESS , '
      '   B.INBALANCECHAR , '
      '   B.FLAGS , '
      '   B.DEBITAMOUNT , '
      '   B.CREDITAMOUNT , '
      '   B.NATAMOUNT ,'
      '   B.TrDescription'
      'FROM'
      '   SBOUT_ACCOUNT A'
      ' , SB_AVALUTE D'
      ' , CM_TRANSACTIONS B'
      ' , SBOUT_ACCOUNT C'
      ' , SB_AVALUTE E'
      ' ,smart.out_TENOSTAT T'
      'WHERE'
      '     (B.DEBITACCID = A.ID)'
      ' AND (D.VALUTE = A.VAL_ACC)'
      ' AND (B.CREDITACCID = C.ID)'
      ' AND (C.VAL_ACC = E.VALUTE)'
      ' and (T.ACC_ID = B.CREDITACCID)'
      ''
      ''
      '')
    Optimize = False
    Cursor = crSQLWait
