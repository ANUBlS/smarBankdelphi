procedure GetPath;
var
  ImagesPath: String;
begin
  ImagesPath := Format('%s\..\Env\Customers', [ExtractFilePath(ParamStr(0))]);
  Path := Format('%s\temp.jpg', [ImagesPath]);
  Path_B := Format('%s\blank.jpg', [ImagesPath]);
end;

procedure TCustomerInfoForm.ViewCustInfo(CustomerID: Integer);
begin
  with CustInfoData do
  Begin

    if RecordCount = 0 then
      ToolButton2.Click;
    GetPath;
    ShowModal;
  End;
end;

procedure TCustomerInfoForm.CustInfoDataAfterOpen(DataSet: TDataSet);
var
  Index: Integer;
begin
  CustInfoData.FieldByName('IDCust').AsInteger :=
    P_DataModule.Customers.FieldByName('ID').AsInteger;
  with DataSet, TabControl do
  begin
    Tabs.Clear;
    for Index := 0 to RecordCount - 1 do
      Tabs.Add(Format('Kart N-%d', [Index]));
    First;
  end;

end;

procedure TCustomerInfoForm.TabControlChange(Sender: TObject);
begin
  // ShowMessage(IntToStr(CustInfoData.RecNo));
  ToolButton6.Click; // saving
  // ShowMessage(IntToStr(CustInfoData.RecNo));
  CustInfoData.RecNo := (Sender as TTabControl).TabIndex + 1; // jumping
  // ShowMessage(IntToStr(CustInfoData.RecNo));
  Fill_Edit.Click; // loading
  // ShowMessage(IntToStr(CustInfoData.RecNo));
end;

procedure TCustomerInfoForm.CustInfoDataApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: String);
var
  Info: TCustomerInfo;
begin
  case Action of
    'I':
      begin
        with Sender, Info do
        begin
          Name := FieldByName('Name').AsString;
          LastName := FieldByName('LastName').AsString;
          SurName := FieldByName('SoName').AsString;
          BirthDate := Trunc(FieldByName('BirthDay').AsDateTime);
          BirthPlace := FieldByName('BirthPlace').AsString;
          Address := FieldByName('Address').AsString;
          City := FieldByName('City').AsString;
          WorkPlace := FieldByName('WorkPlace').AsString;
          PhoneWork := FieldByName('Phone_W').AsString;
          PhoneHome := FieldByName('Phone_H').AsString;
          PhoneCelular := FieldByName('Phone_M').AsString;
          Email := FieldByName('E_Mail').AsString;
          Url := FieldByName('Url').AsString;
        end;
        Sb_AddCustomerInfo(Sender.FieldByName('ID').AsInteger, Info);
        Applied := True;
      end;
  end;
end;

procedure TCustomerInfoForm.ToolButton2Click(Sender: TObject);
var
  index: Integer;
begin
  ToolButton6Click(ToolButton6);
  sb_custInfo.CallProcedure('add_custinfo',
    ['vidcust', P_DataModule.Customers.FieldByName('ID').AsInteger]);

  with TabControl, CustInfoData do
  begin
    Refresh;
    RecNo := RecordCount;
    index := RecordCount;
    TabIndex := Tabs.Add(Format('Kart N-%d', [Index]));
  end;

  Fill_Edit.Click;
end;

procedure TCustomerInfoForm.ToolButton4Click(Sender: TObject);
var
  Index: Integer;
begin
  sb_custInfo.CallProcedure('del_custinfo',
    ['v_id', CustInfoData.FieldByName('ID').AsInteger]);
  CustInfoData.Refresh;
  TabControl.Tabs.Clear;
  for Index := 0 to CustInfoData.RecordCount - 1 do
    TabControl.Tabs.Add(Format('Kart N-%d', [Index]));
  Fill_Edit.Click;
end;

procedure TCustomerInfoForm.ToolButton6Click(Sender: TObject);
begin
  if CustInfoData.RecordCount <> 0 then
  begin
    Edit4.Text := datetostr(TDEdit4.Date);
    Edit18.Text := datetostr(TDEdit18.Date);
    sb_custInfo.CallProcedure('upd_custinfo',
      ['vid', CustInfoData.FieldByName('ID').AsInteger, 'vidcust',
      CustInfoData.FieldByName('IDCust').AsInteger, 'vName', Edit1.Text,
      'vLastName', Edit2.Text, 'vSoName', Edit3.Text, 'vBirthDay', Edit4.Text,
      'vBirthPlace', Edit5.Text, 'vAddress', Edit6.Text, 'vCity', Edit7.Text,
      'vWorkPlace', Edit8.Text, 'vWork', Edit9.Text, 'vPhone_w', Edit12.Text,
      'vPhone_h', Edit11.Text, 'vPhone_m', Edit10.Text, 've_mail', Edit13.Text,
      'vurl', Edit14.Text, 'vGaranted', Edit15.Text, 'vPasSer', Edit16.Text,
      'vPaspNum', Edit17.Text, 'vPaspDate', Edit18.Text, 'vPaspPlace',
      Edit19.Text, 'vNote', Memo1.Text]);

    ODSCustImages.Edit;

    try
      Image1.Picture.SaveToFile(Path);
      TBlobField(ODSCustImages.FieldByName('PHOTO')).LoadFromFile(Path);
      Image2.Picture.SaveToFile(Path);
      TBlobField(ODSCustImages.FieldByName('CUSTSIGN')).LoadFromFile(Path);
      Image3.Picture.SaveToFile(Path);
      TBlobField(ODSCustImages.FieldByName('STAMP')).LoadFromFile(Path);
    except
      ShowMessage('Error during BlobOperation');
    end;

    CustInfoData.Refresh;
  end;
  Close;
end;

