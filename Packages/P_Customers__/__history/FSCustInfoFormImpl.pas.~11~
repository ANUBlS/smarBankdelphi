  Edit17.Text := CustInfoData.FieldByName('PaspNum').AsString;
  Edit18.Text := CustInfoData.FieldByName('PaspDate').AsString;
  Edit19.keyvalue := CustInfoData.FieldByName('PaspPlace').AsString;
  Memo1.Text := CustInfoData.FieldByName('Note').AsString;

  try
    TDEdit4.Date := strtodate(Edit4.Text);
    TDEdit18.Date := strtodate(Edit18.Text);
  except
    TDEdit4.Date := Date;
    TDEdit18.Date := Date;
  end;

  GetPath;

  if (ODSCustImagesPHOTO.IsNull) then
  begin
    Image1.Picture.LoadFromFile(Path_B);
    { --no record - godda empty Image1-- }
  end
  else
  begin
    ODSCustImagesPHOTO.SaveToFile(Path);
    AssignFile(F, Path);
    Reset(F);
    if FileSize(F) > 0 then
    begin
      CloseFile(F);
      Image1.Picture.LoadFromFile(Path);
      // Image1.Picture.Graphic.Height := Image1.Picture.Height div ((Image1.Picture.Graphic.Width div Image1.Width) * Image1.Height);
      // Image1.Picture.Graphic.Width := Image1.Width;
      { --JPEG Error #41-- }
    end
    else
    begin
      CloseFile(F);
      Image1.Picture.LoadFromFile(Path_B);
    end;
  end;

  if (ODSCustImagesCUSTSIGN.IsNull) then
  begin
    Image2.Picture.LoadFromFile(Path_B);
    { --no record - godda empty Image1-- }
  end
  else
  begin
    ODSCustImagesCUSTSIGN.SaveToFile(Path);
    AssignFile(F, Path);
    Reset(F);
    if FileSize(F) > 0 then
    begin
      CloseFile(F);
      Image2.Picture.LoadFromFile(Path);
      { --JPEG Error #41-- }
    end
    else
    begin
      CloseFile(F);
      Image2.Picture.LoadFromFile(Path_B);
    end;
  end;

  if (ODSCustImagesSTAMP.IsNull) then
  begin
    Image3.Picture.LoadFromFile(Path_B);
    { --no record - godda empty Image1-- }
  end
  else
  begin
    ODSCustImagesSTAMP.SaveToFile(Path);
    AssignFile(F, Path);
    Reset(F);
    if FileSize(F) > 0 then
    begin
      CloseFile(F);
      Image3.Picture.LoadFromFile(Path);
      { --JPEG Error #41-- }
    end
    else
