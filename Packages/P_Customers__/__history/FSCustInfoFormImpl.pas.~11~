procedure TCustomerInfoForm.BitBtn4Click(Sender: TObject);
type
  TJPEGQualityRange = 1 .. 100;
var
  Bmp: TBitmap;
  Jpg: TJpegImage;
  ExtS: String[4];
begin
  Bmp := TBitmap.create;
  Jpg := TJpegImage.create;

  ODSCustImages.Edit;
  if OpenPictureDlg.Execute then
  begin
    try
      { --Bmp to Jpeg Conertion -- }
      ExtS := copy(AnsiUpperCase(ExtractFileExt(OpenPictureDlg.FileName)), 2,
        MaxLongInt);
      if ExtS = 'BMP' then
      begin
        Bmp.LoadFromFile(OpenPictureDlg.FileName);
        Jpg.CompressionQuality := 100;
        Jpg.Assign(Bmp);
        Jpg.SaveToFile(Path);
        Image1.Picture.LoadFromFile(Path);
      end
      else
        Image1.Picture.LoadFromFile(OpenPictureDlg.FileName);
      { --End of Convertion -- }
    except
      ShowMessage('Error during picture loading');
    end;
  end;
end;

