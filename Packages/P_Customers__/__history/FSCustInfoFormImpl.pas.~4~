procedure TFSCustomerInfoForm.ToolButton6Click(Sender: TObject);
begin
  if CustInfoData.RecordCount <> 0 then
  begin
    edit4.Text := datetostr(TDEdit4.Date);
    edit18.Text := datetostr(TDEdit18.Date);
    sb_CustInfo.CallProcedure( 'upd_custinfo', [
       'vid'        ,CustInfoData.FieldByName('ID').AsInteger
      ,'vidcust'    ,CustInfoData.FieldByName('IDCust').AsInteger
      ,'vName'      , edit1.text
      ,'vLastName'  , edit2.text
      ,'vSoName'    , edit3.text
      ,'vBirthDay'  , edit4.text
      ,'vBirthPlace', edit5.text
      ,'vAddress'   , edit6.text
      ,'vCity'      , edit7.text
      ,'vWorkPlace' , edit8.text
      ,'vWork'      , edit9.text
      ,'vPhone_w'   , edit12.text
      ,'vPhone_h'   , edit11.text
      ,'vPhone_m'   , edit10.text
      ,'ve_mail'    , edit13.text
      ,'vurl'       , edit14.text
      ,'vGaranted'  , edit15.text
      ,'vPasSer'    , edit16.text
      ,'vPaspNum'   , edit17.text
      ,'vPaspDate'  , edit18.text
      ,'vPaspPlace' , edit19.text
      ,'vNote'      , Memo1.text
      ]
    );

    ODSCustImages.Edit;

    try
      Image1.Picture.SaveToFile(Path);
      TBlobField(ODSCustImages.FieldByName('PHOTO')).LoadFromFile(Path);
      Image2.Picture.SaveToFile(Path);
      TBlobField(ODSCustImages.FieldByName('CUSTSIGN')).LoadFromFile(Path);
      Image3.Picture.SaveToFile(Path);
      TBlobField(ODSCustImages.FieldByName('STAMP')).LoadFromFile(Path);
    except
      ShowMessage('Error during BlobOperation');
    end;

    CustInfoData.Refresh;
  end;
  Close;
end;

