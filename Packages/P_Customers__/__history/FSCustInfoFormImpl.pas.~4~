procedure TFSCustomerInfoForm.CustInfoDataAfterOpen(DataSet: TDataSet);
var
  Index: Integer;
begin
  CustInfoData.FieldByName('IDCust').AsInteger := P_DataModule.Customers.FieldByName('ID').AsInteger;
  with DataSet, TabControl do
  begin
    Tabs.Clear;
    for Index := 0 to RecordCount-1 do
      Tabs.Add(Format('Kart N-%d', [Index]));
    First;
  end;

end;

