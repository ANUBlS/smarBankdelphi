procedure TP_Transaction.ButtonApplyClick(Sender: TObject);
var
  TransID, ComissionID: Integer;
begin
  if (DebitAccData.FieldByName('fromTrans').AsInteger = 1) or
    (CreditAccData.FieldByName('fromTrans').AsInteger = 1) then
  begin { H.R. 12.01.2011 }
    ShowMessage
      ('Bu balans hesab(lar)ı ilə bu moduldan əməliyyat aparmaq olmaz');
    Exit;
  end; { *** H.R. 12.01.2011 }

  TransID := P_DataModule.SB_TRANSACTION.CallIntegerFunction('Transaction_Add',
    ['DebitID', DebitAccData.FieldByName('ID').AsInteger, 'CreditID',
    CreditAccData.FieldByName('ID').AsInteger, 'DebitAmount', DebtValue.Value,
    'CreditAmount', CreditValue.Value, 'Lamount', Ekv.Value, 'DebitRate',
    EditDebtRate.Text, 'CreditRate', EditCredRate.Text, 'TrName',
    DBEditTransName.Text, 'pReportID', ReportIDLookUp.KeyValue, 'pCountrID',
    CountrIDLookUp.KeyValue, 'InBalanceChar', CashSymbolLookUp.KeyValue,
    'OutBalanceChar', ConvertationSymbolLookUp.KeyValue]);
  if (TransTypeIncOutDC = 1) or (TransTypeIncOutDC = 2) then
  begin
    if P_DataModule.Account.FieldByName('TYPEID').AsInteger = 1 then
      ComissionID := P_DataModule.CO_Out.FieldByName('ID').AsInteger
    else
      ComissionID := P_DataModule.CO_In.FieldByName('ID').AsInteger;
    P_DataModule.OSCT.CallProcedure('SetTransactions',
      [ComissionID, DebitAccData.FieldByName('ID').AsInteger,
      CreditAccData.FieldByName('ID').AsInteger, DebtValue.Value,
      CreditValue.Value, null, TransID]);
  end;
  if TransTypeIncOutDC = 3 then
  begin
    CreditAccSearchEdit.Text := '';
    DBEditCredAccName.Text := '';
    DBEditCredAccNO.Text := '';
  end;
  if TransTypeIncOutDC = 4 then
  begin
    DebtAccSearchEdit.Text := '';
    DBEditDebtAccNo.Text := '';
    DBEditDebtAccName.Text := '';
  end;
  DebtValue.Text := '';
  CreditValue.Text := '';
  Ekv.Text := '';
  TrDest.Text := '';
  P_DataModule.Transactions.Refresh;
  P_Transaction.Close;
end;

