procedure TP_AccSettings.EditValuteChange(Sender: TObject);
begin
  if (Sender as TEdit).Text <> '' then
    DBLookupCurr.KeyValue := StrToInt((Sender as TEdit).Text)
  else
    DBLookupCurr.KeyValue := null;

end;

procedure TP_AccSettings.DBLookupCurrClick(Sender: TObject);
begin
  EditValute.Text := IntToStr(DBLookupCurr.ListSource.DataSet.FieldByName
    ('VALUTE').AsInTeger);

end;

