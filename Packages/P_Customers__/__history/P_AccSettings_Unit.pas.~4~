procedure TP_AccSettings.Button1Click(Sender: TObject);

var
  DDate: TDateTime;

begin
  DDate := Trunc(DTPOpenDate.DateTime);

  P_Datamodule.phys_fs_customers.CallProcedure('ins_cc_repairing',
    [EditValute.Text, DBEdit1.Text, EditBall.Text, DBEdit2.Text, EditCust.Text,
    DBEdit3.Text, DDate, 0, symboledit.Text, DBEditLimit.Text, EditFil.Text,
    DBEdit5.Text]);
  P_Datamodule.AccSettings.Close;
  P_Datamodule.AccSettings.Open;

  Close;
end;

procedure TP_AccSettings.Button2Click(Sender: TObject);
