procedure TFormADIF.Button4Click(Sender: TObject);
var filename,dir:string;
  value1,value2 : string;

begin

InputQuery('Xml Fayl', 'XML FAylın adını daxil edin', value1)  ;
if not DirectoryExists('C:\ADIF\REPORT\') then
                    MKDIR('C:\ADIF\REPORT\');

dir:='C:\ADIF\REPORT\';
FileName:=dir+value1+'.xml' ;

    AssignFile(f,filename);
   Rewrite(f);
Writeln(f,'<?xml version="1.0" encoding="UTF-8" ?>');
Writeln(f,'<BANK_CODE>'+Adif_Data.bankmain.FieldByName('kod_bfil').AsString+'</BANK_CODE>');

Writeln(f,'<BANK_NAME>'+UTF8String(Adif_Data.bankmain.FieldByName('az_name').AsString)+'</BANK_NAME>');

Writeln(f,'<BANK_CITY>'+UTF8String(Adif_Data.bankmain.FieldByName('seher').AsString)+'</BANK_CITY>');

Writeln(f,'<BANK_ADRESS>'+UTF8String(Adif_Data.bankmain.FieldByName('adress').AsString)+'</BANK_ADRESS>');

Writeln(f,'<BANK_ZIP_CODE>'+Adif_Data.bankmain.FieldByName('post_in').AsString+'</BANK_ZIP_CODE>');

Writeln(f,'<BANK_LICENSE_NO>'+Adif_Data.bankmain.FieldByName('license_no').AsString+'</BANK_LICENSE_NO>');

Writeln(f,'<BANK_LICENSE_DATE>'+Adif_Data.bankmain.FieldByName('license_date').AsString+'</BANK_LICENSE_DATE>');

Writeln(f,'<BANK_PHONE>'+Adif_Data.bankmain.FieldByName('tel').AsString+'</BANK_PHONE>');
Writeln(f,'<BANK_FAX>'+Adif_Data.bankmain.FieldByName('fax').AsString+'</BANK_FAX>');
Writeln(f,'<BANK_Email>'+Adif_Data.bankmain.FieldByName('email').AsString+'</BANK_Email>');
Writeln(f,'<BANK_WEBSITE>'+Adif_Data.bankmain.FieldByName('link').AsString+'</BANK_WEBSITE>');

 Adif_Data.bankdata.CloseAll;
Adif_Data.bankdata.SQL.Add('select * from bankinfo_adif where kod_b=1');
 Adif_Data.bankdata.open;

Writeln(f,'<EXECUTOR_CN>'+Adif_Data.bankdata.FieldByName('cn').AsString+'</EXECUTOR_CN>');
Writeln(f,'<EXECUTOR_NAME>'+UTF8String(Adif_Data.bankdata.FieldByName('name').AsString)+'</EXECUTOR_NAME>');
Writeln(f,'<EXECUTOR_SURNAME>'+UTF8String(Adif_Data.bankdata.FieldByName('surname').AsString)+'</EXECUTOR_SURNAME>');
Writeln(f,'<EXECUTOR_FATHERS_NAME>'+UTF8String(Adif_Data.bankdata.FieldByName('fname').AsString)+'</EXECUTOR_FATHERS_NAME>');

Writeln(f,'<OWNERS>');


 Adif_Data.bankdata.CloseAll;
  Adif_Data.bankdata.sql.clear;
Adif_Data.bankdata.SQL.Add('select * from bankinfo_adif where kod_b=2');
 Adif_Data.bankdata.open;
 Adif_Data.bankdata.First;
while not Adif_Data.bankdata.Eof do begin
Writeln(f,'<BANK_OWNERS_CN>'+Adif_Data.bankdata.FieldByName('cn').AsString+'</BANK_OWNERS_CN>');
Writeln(f,'<BANK_OWNERS_NAME>'+UTF8String(Adif_Data.bankdata.FieldByName('name').AsString)+'</BANK_OWNERS_NAME>');
Writeln(f,'<BANK_OWNERS_SURNAME>'+UTF8String(Adif_Data.bankdata.FieldByName('surname').AsString)+'</BANK_OWNERS_SURNAME>');
Writeln(f,'<BANK_OWNERS_FATHERS_NAME>'+UTF8String(Adif_Data.bankdata.FieldByName('fname').AsString)+'</BANK_OWNERS_FATHERS_NAME>');

Adif_Data.bankdata.Next;
end;


Writeln(f,'</OWNERS>');


   CloseFile(f);




end;

