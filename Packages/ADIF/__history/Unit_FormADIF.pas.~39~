procedure WriteString(S: string);
begin

  AssignFile(f, FilePAth); { Assigns the Filename }
  Append(f); { Opens the file for editing }
  Write(f, UTF8Encode(StringReplace(S, #13 + #10, '', [rfReplaceAll])));
  Closefile(f);
end;

