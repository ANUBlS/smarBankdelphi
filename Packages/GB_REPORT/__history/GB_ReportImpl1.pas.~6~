procedure TGB_Report.ToolButton1Click(Sender: TObject);
begin
   if DBLookupComboBox1.Text='' then
   begin
      ShowMessage('Щяр щансы бир ямялиййат сечин');
   end else
   begin
      Screen.Cursor:=crSQLWait;
      Begin_Date:=FormatDateTime('dd.MM.yyyy',DTP_GB_BEGIN.Date);
      End_Date:=FormatDateTime('dd.MM.yyyy',DTP_GB_END.Date);

      DataMod_GBReport.OracleDataSet_GB.SetVariable('BEGDATE',Begin_Date);
      DataMod_GBReport.OracleDataSet_GB.SetVariable('ENDDATE',End_Date);

      DataMod_GBReport.OracleDataSet_GB.Close;
      with DataMod_GBReport.OracleDataSet_GB.SQL do
      begin
         Clear;
         Add(DBLookupComboBox1.KeyValue);
      end;
      DataMod_GBReport.OracleDataSet_GB.Open;
      Screen.Cursor:=crDefault;
   End;     
end;

