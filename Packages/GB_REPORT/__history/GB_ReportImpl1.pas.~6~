procedure TGB_Report.ToExcel;
const
 StartRow = 1;
var
  Mas ,V :Variant;
  r,c,i,j  :Integer;
  XLWB : ExcelWorkbook;
  XLWS : ExcelWorkSheet;
begin
   if DBLookupComboBox1.Text<>'' then
   begin
      Screen.Cursor:=crSQLWait;
     //----------------------------prepare--------------------------------
      try
         R := DataMod_GBReport.DataSource_GB.DataSet.RecordCount+1;
         C := DataMod_GBReport.DataSource_GB.DataSet.FieldCount;

         Mas := VarArrayCreate([0,(R - 1),0,(C-1)],varVariant);
         VarArrayLock(Mas);
         I := 0;

         with  DataMod_GBReport.DataSource_GB.DataSet do
            try
               DisableControls;
               First;
               for J := 0  to C - 1 do
                  Mas[I,J] := Fields[J].DisplayLabel;
                  INC(I);
                  while not DataMod_GBReport.DataSource_GB.DataSet.Eof do
                  begin
                     for J := 0 to C - 1 do
                        Mas[I,J] := Fields[J].AsVariant;
                        INC(I);
                        Next;
                     end;
            finally
            EnableControls
        end;

//------------------------------Working with Excel---------------------

    V :=ExcelApplication1.Application;

    try
      ExcelApplication1.Connect;
    except
      raise EExcelNotInstalled.Create(ExcelNotInstalledMsg);
    end;


     //---------------Новый создать-->>---------
      ExcelApplication1.Workbooks.Add(Emptyparam,LCID);
      ExcelApplication1.SheetsinNewWorkBook[LCID];
      ExcelApplication1.Sheets.Add(
                           ExcelApplication1.Sheets[1],     //Before
                           EmptyParam,                  //After
                           EmptyParam,                  //Count
                           EmptyParam,                  //Type
                           LCID                         //lcid
                           );
      //-------------<<--Новый создать-----------


    //---------------Открыть существующий--->>--------
    //  V.Workbooks.Open(ExtractFilePath(ExtractFilePath(ParamStr(0)))+ 'Test.xls');
    //-------------<<--Открыть существующий-----------

      XLWB:=ExcelApplication1.ActiveWorkbook as ExcelWorkbook;
      XLWS := ExcelApplication1.Sheets[1] as ExcelWorkSheet;
      XLWS.Activate(LCID);
     with XLWS.Range['A'+IntToStr(StartRow),XLWS.Cells.Item[R+StartRow-1,C]] do
     begin
      //AutoFormat(1, 0, true, 0, 0, 0, 1);
          Borders.LineStyle:=Abs(xlContinuous);;
          Font.Name :='Azl Sans Serif'; //'LitNusx';
          Font.Size := 8;
          Font.Color :=clBlack;
         // EntireColumn.Autofit;
          ColumnWidth:=15;
        end;
      with XLWS do
     //  Range['A'+IntToStr(StartRow),XLWS.Cells.Item[R+StartRow-1,C]].Value:=Mas;
       XLWS.Range['A'+IntToStr(StartRow),'CA'+IntToStr(StartRow)].Font.Bold := True;
       XLWS.Range['A'+IntToStr(StartRow),'CA'+IntToStr(StartRow)].Font.Name := 'Tahoma';
      // XLWS.Cells.Range_['A'+IntToStr(StartRow),XLWS.Cells.Item[R+StartRow-1,C]].NumberFormat :='@';
       ExcelApplication1.Visible[LCID] := True;

       finally
          VarArrayUnlock(Mas);
          ExcelApplication1.Disconnect;
       end;


       Screen.Cursor:=crDefault;
    end
end;


