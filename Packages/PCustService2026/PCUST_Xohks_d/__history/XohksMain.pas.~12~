procedure TFormXohks.Edit_ReferensKeyPress(Sender: TObject; var Key: Char);
begin
if ((not (key in ['0'..'9','a'..'z','A'..'Z','/','-',':','(',')','.',',','''','+','{','}',' ',#8]))
       or(TEdit(Sender).Text = '/'))
       and(key <> #8)
   then
   Begin
     key:=#0;
   end;
end;

