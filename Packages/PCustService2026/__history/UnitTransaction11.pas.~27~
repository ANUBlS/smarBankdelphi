procedure TFormTransaction11.Button1Click(Sender: TObject);
var

trdate:TDateTime;
ammount:variant;
ceki:variant;
begin

if Length(edit1.Text)<8 then
begin
  showmessage( 'Qaimənin Kodu  8 rəqəmdən ola bilməz !'  );
  exit;
end;

if CurrencyEdit1.Text='' then
  begin
  ShowMessage('  Tarif sahesi seçilmeyib   !');
  exit;
  end;
if CurrencyEdit2.Value=0 then
begin
 ShowMessage('   Yükün çəkisi sahəsi boşdur   !');
  exit;
end;
  with oracledataset1 do
  begin
if (Active) and (RecordCount <> 0) then
    begin

  procid:=FieldByName('id').AsInteger ;
    end
  else
procid:=DataModPCustService.ODS_BusProc.FieldByName  ('id').AsInteger;
  end;
trdate:=DateTimePicker1.DateTime;
  with oracledataset3 do
  begin
if v_truefalse=false then
    begin
   acc_id:=FieldByName('id').AsInteger ;
  kli_id:=FieldByName('kli_id').AsInteger ;
    end
  else  begin
acc_id:=DataModPCustService.Ods_closAccount.FieldByName('id').AsInteger;
kli_id:=DataModPCustService.Ods_closAccount.FieldByName('kli_id').AsInteger;
  end;
  end;

ceki:=CurrencyEdit1.Value;
if EditAmount.Value>0 then
begin

      DataModPCustService.OPG_BusProc.CallProcedure('insert_invoices',
                                                           [procid,
                                                            acc_id,
                                                            EditAmount.Value,
                                                            Edit7.Text,
                                                            Edit11.Text+''+edit1.Text,
                                                            DateTimePicker1.DateTime,
                                                            edit8.Text,
                                                            edit4.Text,
                                                            edit2.Text,
                                                            edit3.Text,
                                                            edit5.Text,
                                                            edit9.Text,
                                                            edit6.Text,
                                                            ceki,
                                                            DBLookupComboboxEh4.Text,
                                                            DBLookupComboboxEh4.Value,
                                                            CurrencyEdit2.Value,
                                                            kli_id,
                                                            DataModPCustService.ODS_BusProcCLASSID.AsInteger
                                                           ]);



clear(Sender);
end;
end;

