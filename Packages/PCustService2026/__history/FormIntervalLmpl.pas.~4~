unit FormIntervalLmpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, XFSCtrls, ExtCtrls, ComCtrls;

type
  TFormInterval = class(TForm)
    XFPanel1: TXFPanel;
    XFPanel2: TXFPanel;
    XFGroupBox1: TXFGroupBox;
    XFLabel1: TXFLabel;
    XFLabel2: TXFLabel;
    XFButton1: TXFButton;
    XFButton2: TXFButton;
    DateTimePicker1: TDateTimePicker;
    DateTimePicker2: TDateTimePicker;
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormInterval: TFormInterval;

implementation
uses UnitDataModPCustService ;
{$R *.dfm}

procedure TFormInterval.FormCreate(Sender: TObject);
begin
DateTimePicker1.DateTime:=DataModPCustService.ODS_SYSDATE.fieldbyname('tek_dat').asdatetime;
DateTimePicker2.DateTime:=DataModPCustService.ODS_SYSDATE.fieldbyname('tek_dat').asdatetime;
end;

procedure TFormInterval.FormKeyPress(Sender: TObject; var Key: Char);
begin
if ord(Key) = 27 then
    Close;
end;

end.
