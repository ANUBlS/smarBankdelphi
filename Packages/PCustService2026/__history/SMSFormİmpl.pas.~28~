 procedure TSMSForm.WriteLnString(S: string);
begin

  AssignFile(f, FilePAth); { Assigns the Filename }
  Append(f); { Opens the file for editing }
  Writeln(f, UTF8Encode(StringReplace(S, #13 + #10, '', [rfReplaceAll])));
  memo1.Lines.Add(UTF8Encode(StringReplace(S, #13 + #10, '', [rfReplaceAll])))  ;
  Closefile(f);
end;
procedure TSMSForm.WriteString(S: string);
begin

  AssignFile(f, FilePAth); { Assigns the Filename }
  Append(f); { Opens the file for editing }
