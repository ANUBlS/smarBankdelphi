procedure TFormTransaction2.SetCashSymbol;
begin
 with DataModPCustService, CashSymbolLookUp do
 begin

  if (ODS_AccNO_A.FieldByName('IsCacheAccount').AsInteger = 1) and (ODS_AccNO_A.FieldByName('val_acc').AsInteger = 0) then
   ListSource.DataSet.Filter :='Mediocrity = 0'
  else
  if (ODS_AccNO_B.FieldByName('IsCacheAccount').AsInteger = 1) and (ODS_AccNO_B.FieldByName('val_acc').AsInteger = 0) then
   ListSource.DataSet.Filter :='Mediocrity = 1'
  else
  ListSource.DataSet.Filter :='Mediocrity = -1';
  ListSource.DataSet.Filtered :=False;
  ListSource.DataSet.Filtered :=True;
 end;

end;

