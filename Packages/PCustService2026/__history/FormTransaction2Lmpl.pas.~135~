    XFBitBtn3.Enabled := False
end;

procedure TFormTransaction2.DBCBoxAccNo_ACloseUp(Sender: TObject;
  Accept: Boolean);
begin
 if  DataModPCustService.ODS_AccNO_A.FieldByName('symb').IsNull then
  begin
  DataModPCustService.ODS_account_symbols_A.first;
   DBLookupComboboxEh_A.KeyValue:=DataModPCustService.ODS_account_symbols_A.FieldByName('symbol').AsString;
  end
  else
  DBLookupComboboxEh_A.KeyValue := DataModPCustService.ODS_AccNO_A.FieldByName('symb').AsString;

   end;



procedure TFormTransaction2.DBLookupComboboxEh_ACloseUp(Sender: TObject;
  Accept: Boolean);
var
  a, s: string;
begin
  if (DBLookupComboboxEh_A.KeyValue <> '') then
  begin
    with DataModPCustService, ODS_AccNO_A do
    begin
      s := '';
      a := DBLookupComboboxEh_A.KeyValue; // ='hhh';

      if a <> 'hhh' then
        s := 'and  a.symb like  ''%' + a + '%''';
      close;
      // ShowMessage(s);
      sql[13] := s;
      open;
      if RecordCount=1 then
      DBCBoxAccNo_A.KeyValue:=DataModPCustService.ODS_AccNO_A.FieldByName('acc_no').AsString

    else
        begin
        DBCBoxAccNo_A.KeyValue:='';
      //  DBLookupComboboxEh3.text:=''; }

        end;
    end;
  end;

end;

