procedure TFormTransaction2.DBCBoxAccNo_AChange(Sender: TObject);
begin
 with DataModPCustService do
begin
 Ods_Tenostat_A.Close;
 Ods_Tenostat_A.SetVariable('id',ODS_AccNO_A.FieldByName('id').AsInteger );
 Ods_Tenostat_A.Open;
 Edit_ostatA.Text:= Ods_Tenostat_A.FieldByName('ostat').AsString;
end;
  Edit_AccName.Text := DataModPCustService.ODS_AccNO_A.FieldByName
    ('name').AsString;
  if (DBCBoxAccNo_A.KeyValue <> '') and (CurrencyEdit1.Value > 0) and
    (not DataModPCustService.ODS_AccNO_A.FieldByName('ID').IsNull) then
  begin
    v_ostat := DataModPCustService.PG_PCustService.CallFloatFunction('get_rate',
