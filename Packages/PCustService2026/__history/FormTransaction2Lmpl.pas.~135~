procedure TFormTransaction2.FormShow(Sender: TObject);
var
  SPos:integer;
  a, s: string;
begin

  SPos := DataModPCustService.SBOP.CallIntegerFunction('get_acc_no_sub',[]);
  DataModPCustService.ODS_AccNO_A.SetVariable('ACCSRCHPOS', SPos);
  DBLookupCEh_contrsName2.KeyValue:=1;
  { if DBCBoxAccNo_A.ListFieldIndex = 0 then }

  if DataModPCustService.ODS_BusProcID.AsInteger in[2,3]then
  begin
     Label_xez.Visible:=true;
     Edit_xez.Visible:=true;
     CashSymbolLookUp.Visible:=true;
     end
     else
     begin
       label_xez.Visible:=false;
     Edit_xez.Visible:=false;
     CashSymbolLookUp.Visible:=false;

  end;
  with DataModPCustService.ODS_AccNO_A do
  begin
    if RecordCount = 2 then
      DBCBoxAccNo_A.KeyValue := FieldByName('acc_no').AsString
    else
      DBCBoxAccNo_A.KeyValue := '';
  end;

  Edit1.Text := DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName
    ('id').AsString;
  Edit3.Text := DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName
    ('cust_name').AsString;

  if DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName('cust_type').AsInteger in[0,2] then
  begin
    Edit5.Visible := True;
    Edit5.Text := DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName
      ('inn').AsString;
    Edit4.Visible := False;
    Edit6.Visible := False;
    Label10.Caption := 'VÖEN';
    end
    else
    begin
    Edit4.Visible := True;
    Edit6.Visible := True;
    Edit4.Text := DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName
      ('passport').AsString;
    Edit6.Text := DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName
      ('passp_number').AsString;
    Edit5.Visible := False;
    Label10.Caption := 'Pasport seriyasi'
  end;
  if DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName('cust_type').AsInteger=3 then
  begin
  if PCustServiceForm.XFRadioGroup1.ItemIndex=1   then
  begin
    Edit5.Visible := True;
    Edit5.Text := DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName
      ('inn').AsString;
    Edit4.Visible := False;
    Edit6.Visible := False;
    Label10.Caption := 'VÖEN';
    end
    else
    begin
    Edit4.Visible := True;
    Edit6.Visible := True;
    Edit4.Text := DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName
      ('passport').AsString;
    Edit6.Text := DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName
      ('passp_number').AsString;
    Edit5.Visible := False;
    Label10.Caption := 'Pasport seriyasi'
  end;

  end;

  CurrencyEdit1.Clear;
  CurrencyEdit2.Clear;
  EditDescription.Clear;

  DBLookupComboboxEh_A.KeyValue := 'hhh';

  if (DBLookupComboboxEh_A.KeyValue <> '') then
  begin
    with DataModPCustService, ODS_AccNO_A do
    begin
      s := '';
      a := DBLookupComboboxEh_A.KeyValue; // ='hhh';

      if a <> 'hhh' then
        s := 'and  a.symb like  ''%' + a + '%''';
      close;
      sql[13] := s;
      open;
      if RecordCount=1 then
      DBCBoxAccNo_A.KeyValue:=DataModPCustService.ODS_AccNO_A.FieldByName('acc_no').AsString

      else
        begin
        DBCBoxAccNo_A.KeyValue:='';
     end;
    end;
  end;

