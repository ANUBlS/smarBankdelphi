procedure TFormTransaction1.CurrencyEdit1Change(Sender: TObject);
var
  v_ostat: Real;
begin
  with DataModPCustService do
  begin
    if CurrencyEdit1.Value > 0 then
   { begin
      v_ostat := StrToFloat(PG_PCustService.CallFloatFunction('get_rate',
        [ODS_BusProc.FieldByname('ID').AsInteger, -1, -1, -1, -1]));
      XFBitBtn1.Enabled := true;
    end
    else   }
      XFBitBtn1.Enabled := true;
  end;
 // CurrencyEdit2.Value := (CurrencyEdit1.Value) * v_ostat;
end;

procedure TFormTransaction1.CurrencyEdit1Click(Sender: TObject);
begin
  CurrencyEdit1.Text := '';
end;

procedure TFormTransaction1.CurrencyEdit1KeyPress(Sender: TObject;
  var Key: Char);
begin
 { if (upcase(Key) < '0') or (upcase(Key) > '9') then
  if (ord(Key) <> 8) then
  Key := #0;   }
  if (not (Key in ['0'..'9',#46,Chr(8)])) then Key:=#0;
end;

procedure TFormTransaction1.CurrencyEdit2Click(Sender: TObject);
begin
  CurrencyEdit2.Text := '';
end;

procedure TFormTransaction1.CurrencyEdit2KeyPress(Sender: TObject;
  var Key: Char);
begin
  if (upcase(Key) < '0') or (upcase(Key) > '9') then
    if (ord(Key) <> 8) then
      Key := #0;
end;

procedure TFormTransaction1.FormCanResize(Sender: TObject;
  var NewWidth, NewHeight: Integer; var Resize: Boolean);
