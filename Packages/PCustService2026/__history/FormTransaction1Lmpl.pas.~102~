end;

procedure TFormTransaction1.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
DBLookupComboBo_filial.KeyValue:=-1;
XFBitBtn1.Enabled:=false;

end;

procedure TFormTransaction1.FormCreate(Sender: TObject);
begin
 DataModPCustService.ODS_contrs3.open;
 SBTranslateProc.TranslateAllCompForms(Self, sboapiDataModule.OrPack_SL);
end;

procedure TFormTransaction1.FormKeyPress(Sender: TObject; var Key: Char);

begin
  if ord(Key) = 27 then
    Close;
end;

procedure TFormTransaction1.FormShow(Sender: TObject);
begin
DBLookupCEh_contrsName1.KeyValue:=1;
  CurrencyEdit1.Clear;
  CurrencyEdit2.Clear;
  EditDescription.Clear;
end;

procedure TFormTransaction1.XFBitBtn1Click(Sender: TObject);
var
  busp_id: integer;
  v_ammount, v_lammount: Real;
begin
  { busp_id := DataModPCustService.ODS_BusProcID.AsInteger;
    v_ammount := CurrencyEdit1.Value;
    v_lammount := CurrencyEdit2.Value;
    DataModPCustService.PG_SAMIR_CUST.CallProcedure('add_transaction1',
    [busp_id, v_ammount, v_lammount]);
    FormTransaction1.Close; }
    if CurrencyEdit1.Value=0.00 then
    begin
      showmessage('Məbləğ daxil edilməyib  !');
      exit;
    end;
  DataModPCustService.OPG_BusProc.CallProcedure('ExecBProcess',
    [DataModPCustService.ODS_BusProcID.AsInteger, 0 { custid } , 0, 0, 0,
    CurrencyEdit1.Value, CurrencyEdit1.Value, CurrencyEdit2.Value, '0', 0,
    EditDescription.Text, 0, DBLookupCEh_contrsName1.KeyValue, 0, 0, 0,DBLookupComboBo_filial.KeyValue]);
  // showmessage( floattostr(CurrencyEdit2.Value));
  FormTransaction1.Close;

end;

