unit Unit_Other;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, DB, OracleData, Grids, XDBGrids, ExtCtrls, XFSCtrls, StdCtrls,
  DBGridEhGrouping, GridsEh, DBGridEh, HintBox;

type
  TForm_other = class(TForm)
    XFPanel2: TXFPanel;
    XFPanel3: TXFPanel;
    XDBGrid1: TXDBGrid;
    OracleDataSet1: TOracleDataSet;
    OracleDataSet2: TOracleDataSet;
    DataSource1: TDataSource;
    DataSource2: TDataSource;
    XFButton1: TXFButton;
    OracleDataSet2ID: TFloatField;
    OracleDataSet2CUSTID: TFloatField;
    OracleDataSet2NAME: TWideStringField;
    OracleDataSet2DESCRIPTION: TWideStringField;
    Memo1: TMemo;
    procedure FormShow(Sender: TObject);
    procedure XFButton1Click(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure XDBGrid1CellClick(Column: TXColumn);
    function InsertLineBreaksEveryN(const Text: string; N: Integer): string;
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form_other: TForm_other;

implementation
   uses sboapiDataModuleImpl, UnitDataModPCustService, UnitForm_other_change;
{$R *.dfm}

procedure TForm_other.FormCreate(Sender: TObject);
begin
Form_other_change:=TForm_other_change.create(self);
end;

procedure TForm_other.FormShow(Sender: TObject);
var
c_custid :integer;
begin

c_custid:=DataModPCustService.ODS_CUSTOMERS_PHYS_FS.FieldByName('id').AsInteger;

DataModPCustService.PG_PCustService.CallProcedure
                                                ('cust_other_info_add',
                                                 [c_custid]);
                                                 OracleDataSet2.Close;
                                                 OracleDataSet2.SetVariable('v_id',c_custid);
                                                 OracleDataSet2.Open

end;

function TForm_other.InsertLineBreaksEveryN(const Text: string; N: Integer): string;
var
  i: Integer;
begin
  Result := Text;
  i := N;
  while i < Length(Result) do
  begin
    Insert(#13#10, Result, i + 1); // Yeni sətir əlavə et
    Inc(i, N + 2); // N + 2: #13#10-un uzunluğu qədər irəli get
  end;
end;

procedure TForm_other.XDBGrid1CellClick(Column: TXColumn);

var
  OriginalText, FormattedText: string;
begin
  OriginalText := XDBGrid1.DataSource.DataSet.FieldByName('name').AsString;
  FormattedText := InsertLineBreaksEveryN(OriginalText, 130);
  Memo1.Text := FormattedText;

  with Form_other_change , OracleDataSet1 do
  begin
    close;
      SetVariable('v_id',XDBGrid1.DataSource.DataSet.FieldByName('id').AsInteger);
    open;


if RecordCount>0 then
 begin

     XDBGrid1.Columns[2].ReadOnly:=true;
     Form_other_change.ShowModal;

    OracleDataSet2.Edit ;

    if   Form_other_change.v_name<>''  then
     begin

    OracleDataSet2DESCRIPTION.asstring:=Form_other_change.v_name ;

     end;
     Form_other_change.v_name:='';
//    OracleDataSet2.Post;
//    OracleDataSet2.Refresh;

end
  else

   XDBGrid1.Columns[2].ReadOnly:=false;

  end;

end;

procedure TForm_other.XFButton1Click(Sender: TObject);
begin
OracleDataSet2.Post;
end;

end.
