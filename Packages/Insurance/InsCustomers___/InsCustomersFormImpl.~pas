procedure TInsCustomersForm.DBGridContractsTitleClick(Column: TColumn);
var
   TitleName :string;
   SortPosition: word;
begin
 SortPosition :=100;
 if (InsDataMod.ODSContracts.IsEmpty) or (Column.FieldName = EmptyStr) then Exit;
 Screen.Cursor :=crHourGlass;
 TitleName :=Column.FieldName;
 with InsDataMod, ODSContracts do
  try
   SortPosition :=SQL.Add('ORDER BY '+ TitleName);
   Refresh;
  finally
   SQL[SortPosition] :=EmptyStr;
   Screen.Cursor :=crDefault;
  end;
end;

procedure TInsCustomersForm.DBGridContractsDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
var
  ImageIndex: Integer;
begin
  with Sender as TDBGrid do
  begin
    if DataSource.DataSet.RecordCount <> 0 then
    begin
      ImageIndex := DataSource.DataSet.FieldByName('state').AsInteger;
      if (DataCol = 0) and (ImageIndex <> -1) then begin
        Canvas.brush.Style := bsSolid;
        Canvas.FillRect(Rect);
        ImageList2.Draw(Canvas, Rect.Left, Rect.Top, ImageIndex, True); end
      else
        DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;
  end;


end;

procedure TInsCustomersForm.aCommitExecute(Sender: TObject);
var
  funcname : String;
begin
 with InsDataMod, ODSContracts do
   case fieldbyname('state').asInteger of
    0 : funcname := 'commitblank';
    2:  funcname := 'commitsuggestion';
    4 : funcname := 'commitpolicy';
    else exit;
   end;   

 with InsDataMod, OPCOMMON do
  if CallBooleanFunction(funcname, [ODSContracts.fieldbyname('ID').asInteger]) then begin
    MessageDlg('Testiq olundu.', mtInformation, [mbok], 0);
    ODSContracts.RefreshRecord;
