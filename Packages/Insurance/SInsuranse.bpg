PMFSuggestion.ocx: MFSuggestion\PMFSuggestion.dpr
  $(DCC)

PMFPolicy.ocx: MFPolicy\PMFPolicy.dpr
  $(DCC)

RefEdit.ocx: ..\Packages\RefEdit\RefEdit.dpr
