#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = InsVCL50.bpl Insurances.ocx sboapi50.bpl InsCustomers.ocx \
  MKBlank.ocx sbplg50.bpl MKSuggestion.ocx MKPolicy.ocx PMFBlank.ocx \
  PMFSuggestion.ocx PMFPolicy.ocx RefEdit.ocx PConstructionMain.ocx \
  PConstractiondpr.ocx PConstructionSuggest.ocx PConstructionPolicy.ocx \
  InsMotorKasco.ocx MEDBlank.ocx MEDPolicy.ocx MEDSuggestion.ocx InsMedical.ocx \
  PPAccidentBlank.ocx PMainPersonalAcc.ocx PPAccidentSuggest.ocx PPAccPolicy.ocx \
  PCPropertyBlank.ocx InsPayments.ocx PMainCProperty.ocx PCPropertySuggest.ocx \
  PCPropertyPolicy.ocx PPMFMain.ocx AutoDict.ocx DictChilde.ocx \
  SBExcelExporter.bpl PAccountState.ocx PAccountDoc.ocx PInsKorporativBlank.ocx
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

InsVCL50.bpl: InsVCL50\InsVCL50.dpk
  $(DCC)

Insurances.ocx: Insurances\Insurances.dpr
  $(DCC)

sboapi50.bpl: ..\Packages\sboapi50\sboapi50.dpk
  $(DCC)

