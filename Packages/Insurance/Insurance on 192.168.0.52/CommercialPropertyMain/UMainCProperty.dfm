  object ODSCProperty: TOracleDataSet
    SQL.Strings = (
      
        'select PINS_FullMotor.returnName(cp.kli_id) as name,cp.rowid,cp.' +
        '*,ic.begin_date,ic.end_date from ins_commercialproperty cp,ins_c' +
        'ontracts ic where ic.blank_id=cp.id and cp.close_prefix=0 order ' +
        'by cp.:title')
    Variables.Data = {
      0300000001000000060000003A5449544C450100000003000000696400000000
      00}
    QBEDefinition.QBEFieldDefs = {
      0400000037000000020000004944010000000000060000004B4C495F49440100
