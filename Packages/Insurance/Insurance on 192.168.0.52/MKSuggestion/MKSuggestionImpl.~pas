procedure TfmMKSuggestion.btRisksAddClick(Sender: TObject);
begin
  ODSRisktypes.Open;
  with TfmRiskTypes.Create(Self) do
    ShowModal;
  if memRisk.Text <> '' then
  cbRisks.State := cbChecked;
  ODSRisktypes.Close;
end;

function TfmMKSuggestion.SaveData():Boolean;
begin
  Result := False;
  //----------Save new risk----------------
  if   cbRisks.State = cbChecked then
  with ODSRisks do begin
    Insert;
    FieldByName('name').asString := memRisk.Text;
    Post;
    RefreshRecord;
    memRisk.Text := '';
  end;

  //----------Save new franshiz----------------
  if   memFrashize.Text <> ''  then
  with ODSFranshiz do begin
    Insert;
    FieldByName('name').asString := memFrashize.Text;
    Post;
    RefreshRecord;
    memFrashize.Text := '';
  end;

  //----------Save new conditions----------------
  if   memConditions.Text <> '' then
  with ODSConditions do begin
    Insert;
    FieldByName('name').asString := memConditions.Text;
    Post;
    RefreshRecord;
    memConditions.Text := '';
  end;

  with ODSMK do
  if State in [dsEdit, dsInsert] then begin
    FieldByName('mk_id').AsFloat := id;
    FieldByName('rsk_id').AsFloat := ODSRisks.FieldByName('id').asFloat;
    FieldByName('frz_id').AsFloat := ODSFranshiz.FieldByName('id').asFloat;
    FieldByName('cndt_id').AsFloat := ODSConditions.FieldByName('id').asFloat;
    FieldByName('enddate').AsDateTime := DTPContractDate.DateTime;
    if ckMonth.Checked then
     FieldByName('ITSPEC').asString := 'M';
    if ckYear.Checked then
     FieldByName('ITSPEC').asString := 'Y';

    Post;
    RefreshRecord();
  end;
  
  with ODSContracts do
  if State in [dsEdit, dsInsert] then begin
     Edit;
     FieldByName('sugg_id').AsFloat := ODSMK.FieldByName('id').asFloat;
     FieldByName('ins_date').AsDateTime := DTPContractDate.DateTime;
     Post;
     RefreshRecord;
  end;


    IsSaved := True;
    result := True;
    
end;

