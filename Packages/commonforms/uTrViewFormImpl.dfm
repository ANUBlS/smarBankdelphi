    OnClick = Button1Click
  end
  object odsTr: TOracleDataSet
    SQL.Strings = (
      
        'select p.id, d.acc_no debt, c.acc_no kredit, vd.valu_name val_ac' +
        'c,'
      '       vc.valu_name currencyid_c, ammount, lammount, ammount_c,'
      '       p.userinsert/*sb_aca.getuserbyid (p.op_id)*/ usname,'
      '       p.usercommit as  usrcommit,'
      
        '      /* sb_aca.getuserbyid (commit_opid) comusname,*/ tim, comm' +
        'ittime,'
      
        '       b.name kassa_b, z.fullpath kassa_z, rate_d, rate_c, p.nam' +
        'e,'
      '       r.name reportid, t.cntr_name countrid'
      '  from provdoc p,'
      '       account d,'
      '       account c,'
      '       avalute vd,'
      '       avalute vc,'
      '       reportdescs r,'
      '       countries t,'
      '       kassa_b b,'
      '       convert_assignments z'
      ' where debt = d.id'
      '   and p.kredit = c.id'
      '   and p.val_acc = vd.valute'
      '   and currencyid_c = vc.valute'
      '   and reportid = r.id(+)'
      '   and countrid = t.id(+)'
      '   and kassa_b = b.symbol(+)'
      '   and kassa_z = z.id(+)'
      '   and p.id = :TRID'
      'union all'
      
        'select p.id, d.acc_no debt, c.acc_no kredit, vd.valu_name val_ac' +
        'c,'
      '       vc.valu_name currencyid_c, ammount, lammount, ammount_c,'
      '      p.userinsert/*sb_aca.getuserbyid (p.op_id)*/ usname,'
      '       p.usercommit as  usrcommit,'
      '       /* '#39#39' comusname,*/ tim,'
      
        '       null committime, b.name kassa_b, z.fullpath kassa_z, rate' +
        '_d, rate_c,'
      '       p.name, r.name reportid, t.cntr_name countrid'
      '  from lazytransaction p,'
      '       account d,'
      '       account c,'
      '       avalute vd,'
      '       avalute vc,'
      '       reportdescs r,'
      '       countries t,'
      '       kassa_b b,'
      '       convert_assignments z'
      ' where debt = d.id'
      '   and p.kredit = c.id'
      '   and p.val_acc = vd.valute'
      '   and currencyid_c = vc.valute'
      '   and reportid = r.id(+)'
      '   and countrid = t.id(+)'
      '   and kassa_b = b.symbol(+)'
      '   and kassa_z = z.id(+)'
      ' '
      ''
      '   and p.id = :trid'
      '   and dat = (select tek_dat'
      '                from sysdat)'
      '')
    Optimize = False
    Variables.Data = {
      04000000010000000A0000003A00540052004900440003000000000000000000
      0000}
    QBEDefinition.QBEFieldDefs = {
      05000000130000000400000049004400010000000000080000004E0041004D00
      4500010000000000100000005200450050004F00520054004900440001000000
      00001000000043004F0055004E00540052004900440001000000000008000000
      44004500420054000100000000000C0000004B00520045004400490054000100
      000000000E000000560041004C005F0041004300430001000000000018000000
      430055005200520045004E0043005900490044005F0043000100000000000E00
      000041004D004D004F0055004E005400010000000000100000004C0041004D00
      4D004F0055004E0054000100000000001200000041004D004D004F0055004E00
      54005F0043000100000000000C000000550053004E0041004D00450001000000
      000006000000540049004D000100000000001400000043004F004D004D004900
      5400540049004D0045000100000000000E0000004B0041005300530041005F00
      42000100000000000E0000004B0041005300530041005F005A00010000000000
      0C00000052004100540045005F0044000100000000000C000000520041005400
      45005F0043000100000000001200000055005300520043004F004D004D004900
      5400010000000000}
    Session = sboapiDataModule.SBSession
