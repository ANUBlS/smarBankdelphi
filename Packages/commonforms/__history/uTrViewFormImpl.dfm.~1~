  object odsTr: TOracleDataSet
    SQL.Strings = (
      
        'select p.id, d.acc_no debt, c.acc_no kredit, vd.valu_name val_ac' +
        'c,'
      '       vc.valu_name currencyid_c, ammount, lammount, ammount_c,'
      '       sb_aca.getuserbyid (p.op_id) usname,'
      
        '       sb_aca.getuserbyid (commit_opid) comusname, tim, committi' +
        'me,'
      
        '       b.name kassa_b, z.fullpath kassa_z, rate_d, rate_c, p.nam' +
        'e,'
      '       r.name reportid, t.cntr_name countrid'
      '  from provdoc p,'
      '       account d,'
      '       account c,'
      '       avalute vd,'
      '       avalute vc,'
      '       reportdescs r,'
      '       countries t,'
      '       kassa_b b,'
      '       convert_assignments z'
      ' where debt = d.id'
      '   and p.kredit = c.id'
      '   and p.val_acc = vd.valute'
      '   and currencyid_c = vc.valute'
      '   and reportid = r.id(+)'
      '   and countrid = t.id(+)'
      '   and kassa_b = b.symbol(+)'
      '   and kassa_z = z.id(+)'
      '   and p.id = :trid'
      'union all'
      
        'select p.id, d.acc_no debt, c.acc_no kredit, vd.valu_name val_ac' +
        'c,'
      '       vc.valu_name currencyid_c, ammount, lammount, ammount_c,'
      '       sb_aca.getuserbyid (p.op_id) usname, '#39#39' comusname, tim,'
      
        '       null committime, b.name kassa_b, z.fullpath kassa_z, rate' +
        '_d, rate_c,'
      '       p.name, r.name reportid, t.cntr_name countrid'
      '  from lazytransaction p,'
      '       account d,'
      '       account c,'
      '       avalute vd,'
      '       avalute vc,'
      '       reportdescs r,'
      '       countries t,'
      '       kassa_b b,'
      '       convert_assignments z'
      ' where debt = d.id'
      '   and p.kredit = c.id'
      '   and p.val_acc = vd.valute'
