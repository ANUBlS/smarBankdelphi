unit CC_AccState_Unit;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  ExcelExporter, Db, OracleData, Grids, DBGrids, ComCtrls, StdCtrls,
  Buttons, ExtCtrls, NLSLocalizer;

type
  TFormAccState = class(TForm)
    Panel1: TPanel;
    SpeedButton1: TSpeedButton;
    CloseButton: TButton;
    PageControl1: TPageControl;
    AccAmountSheet: TTabSheet;
    DBGridAccState: TDBGrid;
    AccTurnoverSheet: TTabSheet;
    DBGrid2: TDBGrid;
    TabSheet1: TTabSheet;
    DBGrid1: TDBGrid;
    AccState: TDataSource;
    AccStateData: TOracleDataSet;
    AccStateDataACCID: TFloatField;
    AccStateDataAMOUNT: TFloatField;
    AccStateDataLAMOUNT: TFloatField;
    AccStateDataDEBITTURNOVER: TFloatField;
    AccStateDataDEBITLTURNOVER: TFloatField;
    AccStateDataCREDITTURNOVER: TFloatField;
    AccStateDataCREDITLTURNOVER: TFloatField;
    AccStateDataARCHIVEDATE: TDateTimeField;
    AccStateExporter: TExcelExporter;
    NLSLocalizer1: TNLSLocalizer;
    procedure FormCreate(Sender: TObject);
    procedure SpeedButton1Click(Sender: TObject);
    procedure CloseButtonClick(Sender: TObject);
    procedure FormActivate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    procedure WMNCACTIVATE(var message:TWMNCActivate);
    procedure WMNCPaint(var message: TWMNCPaint);
  end;

var
  FormAccState: TFormAccState;
   AccountNumber: String;
    PriorAccountID, AccountID: Longint;
implementation

uses sboapiDataModuleImpl, UnitData;
{$R *.DFM}

procedure TFormAccState.WMNCACTIVATE(var message:TWMNCActivate);
var
 S:TWMNCPaint;
begin
inherited;
WMNCPaint(s);
end;

procedure TFormAccState.WMNCPaint(var message: TWMNCPaint);
const Capt = 'Ùוסאבûם דאכûדכאנû';
var dc : hDc;
begin
inherited;
Caption:='';
dc := GetWindowDC(Handle);
        SetBkMode(dc,Transparent);
        SetTextColor(dc,clWhite);
        SelectObject(dc, Font.Handle);
        TextOut(dc, 23,6,Capt,Length(Capt));
end;

procedure TFormAccState.FormCreate(Sender: TObject);
begin
 PriorAccountID :=-1;
end;

procedure TFormAccState.SpeedButton1Click(Sender: TObject);
begin
with AccStateExporter do
  if
    ExportSource.DataSet.Active and
    (ExportSource.DataSet.RecordCount > 0) then
    begin
     ExportSource.DataSet.Last;
     ExportSource.DataSet.First;
     Report;
    end;
end;


procedure TFormAccState.CloseButtonClick(Sender: TObject);
begin
close;
end;

procedure TFormAccState.FormActivate(Sender: TObject);
begin

 with DataMod_Buyers.Accno do
 begin
  AccountID :=FieldByName('ID').AsInteger;
  AccountNumber :=FieldByName('accno').AsString;
 end;



 if AccountID <> PriorAccountID then
  with AccStateData do
  begin
   CloseAll;
   SetVariable('AccID', AccountID);
   Open;
  end;

 PriorAccountID :=AccountID;

end;


end.
