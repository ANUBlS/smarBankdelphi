procedure TFormAccBuyers.ButtonCommitClick(Sender: TObject);
var
    DDate :TDateTime;
    customerid    :  integer;
    op_id         :  integer;
    accno         :  string;
    currencyid    :  integer;
    name          :  string;
    open_dat      :  tdatetime;
    balcn         :  integer;
    ownid         :  integer;

begin
  DDate :=Trunc(DTPOpenDate.DateTime);
  customerid:=strtoint(EditCust.Text);
  accno:=EditAcc.Text;
  currencyid:=strtoint(EditValute.text);
  name:=EditAccName.Text;
  open_dat:=Integer(Trunc(DTPOpenDate.date));
  balcn:=strtoint(EditBall.text);
  ownid:=Datamod_Buyers.ODSBuyers.fieldbyname('ID').asinteger;


  DataMod_Buyers.CC_GENERAL.CallIntegerFunction('add_account',[customerid,
                                                         accno,
                                                         currencyid,
                                                         name,
                                                         open_dat,
                                                         balcn,
                                                         ownid]);
                                                        DataMod_Buyers.Accno.Close;
                                                        DataMod_Buyers.Accno.Open;
                                                        Close;


end;
