procedure TDatModConstr.CopyOfCreditPurposeCalcFields(DataSet: TDataSet);

begin
   with DataSet do   begin   FieldByName('fullammount').Asfloat:=0;
        FieldByName('PeriodContracts').AsInteger
          :=trunc( CC_GENERAL.CallIntegerFunction('GetPeriod',
          ['bdat',FieldByname('opendate').AsDateTime,
           'edat',FieldByname('expdate').AsDateTime ]));
         { FieldByname('expdate').AsDateTime:=sbcm_construction.CallDateFunction('GetFindExpdate',
          ['odat',FieldByname('opendate').AsDateTime,
           'mon',FieldByName('PeriodContracts').AsInteger ]); }

      FieldByName('fullammount').Asfloat:=
      FieldByName('AREA').Asfloat* FieldByName('SQUAREMETRAMOUNT').Asfloat;
    //  showmessage (FloatToStr( FieldByName('PeriodContracts').Asfloat)) ;


   if FieldByName('fullammount').Asfloat > 0 then
  FieldByName('restt').Asfloat:=
  FieldByName('fullammount').Asfloat- FieldByName('INITIALAMOUNT').Asfloat  ;

  if (FieldByName('INITIALAMOUNT').Asfloat>0) and (FieldByName('price1').Asfloat>0) then
  FieldByName('buyarea').Asfloat:=
  FieldByName('INITIALAMOUNT').Asfloat/ FieldByName('price1').Asfloat
  else
  FieldByName('buyarea').Asfloat:=0;


  if FieldByName('PeriodContracts').Asfloat>0 then
  begin

  FieldByName('monthspay').AsFloat:=
  FieldByName('restt').AsFloat/FieldByName('PeriodContracts').AsFloat;
  end
    else
     FieldByName('monthspay').Asfloat:=0;

end;
end;

procedure TDatModConstr.CreditPurpose555ApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: string);
var
      ContNum :String;
      Buyer:Integer;
      AccID : Integer;
      BranchID:Integer;
      contcur,FlatID :Integer;
      ContAmount:Real;
      opendate:TDATETIme;
      ExpDate :TDATETIme;
      closedate:TDATETIme;
      interestrate:integer;
      InitialAmount:Real;
      DUEINTERESTRATE :Real;
      Result: integer;
      SQUAREMETRAMOUNT :Real;
      note: integer;
      monthpay :Real;

begin
   Result :=0;
      with Sender do
      begin
      ContNum:= FieldByName('ContNum').AsString;
      Buyer:= FieldByName('Buyer').Asinteger;
      AccID:= FieldByName('AccID').Asinteger;
      BranchID:= FieldByName('BranchID').Asinteger;
      FlatID:=FieldByName('FlatID').Asinteger;
      contcur:=FieldByName('contcur').Asinteger;
      ContAmount:=FieldByName('ContAmount').AsFloat;
      opendate:= FieldByName('opendate').asdatetime;
      ExpDate:= FieldByName('ExpDate').asdatetime;
      closedate:= FieldByName('closedate').asdatetime;
      interestrate:= FieldByName('interestrate').asinteger;
      InitialAmount:=FieldByName('InitialAmount').AsFloat;
      DUEINTERESTRATE :=FieldByName('DUEINTERESTRATE').AsFloat;
      SQUAREMETRAMOUNT :=FieldByName('SQUAREMETRAMOUNT').AsFloat;
      note:=FieldByName('Note').AsInteger;
      monthpay:=FieldByName('monthspay').AsFloat;

      end;

      case Action of
          'I':Begin
             with CC_GENERAL do
             Result := CallIntegerFunction('add_Contract',[
                            'p_ContNum',ContNum,
                            'p_Buyer',Buyer,
                            'p_AccID',AccID,
                            'p_BranchID',BranchID,
                            'p_FlatID',FlatID,
                            'p_contcur',contcur,
                            'p_ContAmount',ContAmount,
                            'p_opendate',opendate,
                            'p_ExpDate',ExpDate,
                            'p_closedate',closedate,
                            'p_interestrate',0,
                            'p_InitialAmount',InitialAmount,
                            'p_DUEINTERESTRATE',DUEINTERESTRATE,
                            'p_SQUAREMETRAMOUNT',SQUAREMETRAMOUNT,
                            'p_note',note,
                            'p_monthpay',monthpay
                            ]);
        Applied := True;
       end;
       'U':begin
              with CC_GENERAL do
             Result := CallIntegerFunction('upd_Contracts',[
                            'p_ID',Credits.FieldByName('ID').AsInteger,
                            'p_ContNum',ContNum,
                            'p_Buyer',Buyer,
                            'p_AccID',AccID,
                            'p_BranchID',BranchID,
                            'p_FlatID',FlatID,
                            'p_contcur',contcur,
                            'p_ContAmount',ContAmount,
                            'p_opendate',opendate,
                            'p_ExpDate',ExpDate,
                            'p_closedate',closedate,
                            'p_interestrate',0,
                            'p_InitialAmount',InitialAmount,
                            'p_DUEINTERESTRATE',DUEINTERESTRATE  ,
                            'p_SQUAREMETRAMOUNT',SQUAREMETRAMOUNT,
                            'p_note',note,
                            'p_monthpay',monthpay
                            ]);
        Applied := True;
      end;
end;
end;

