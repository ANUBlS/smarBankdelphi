   end
   else begin
    DataMod_Buyers.Sysdat.Open;
    with FormInterval do begin
     StartDateEdit.DateTime :=DataMod_Buyers.Sysdat.FieldByName('tek_dat').AsDateTime;
     EndDateEdit.DateTime :=StartDateEdit.DateTime;
     if ShowModal = mrOK then begin
      AStartDate :=StartDateEdit.DateTime;
      AEndDate :=EndDateEdit.DateTime;
      with FormAccTransaction do begin
       OpenDataControls(AStartDate, AEndDate);
       ShowModal;
      end;
     end;
    end;
   end;
end;

