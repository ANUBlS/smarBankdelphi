unit TransactionsViewFormImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, ExtCtrls,  Db, OracleData, Grids, DBGridEh,
  ImgList, Mask, DBCtrlsEh;

type
  TTransactionsViewForm = class(TForm)
    DBGridTransactions: TDBGridEh;
    DataSrcTransactions: TDataSource;
    Panel1: TPanel;
    ButtonCommit: TButton;
    ButtonDismis: TButton;
    DBEditEh1: TDBEditEh;
    StatusImages: TImageList;
    Transactions: TOracleDataSet;
    TransactionsDEBITACCNO: TWideStringField;
    TransactionsDEBITCURRENCY: TWideStringField;
    TransactionsCREDITACCNO: TWideStringField;
    TransactionsCREDITCURRENCY: TWideStringField;
    TransactionsTRDATE: TDateTimeField;
    TransactionsINBALANCECHAR: TWideStringField;
    TransactionsFLAGS: TFloatField;
    TransactionsDEBITAMOUNT: TFloatField;
    TransactionsCREDITAMOUNT: TFloatField;
    TransactionsNATAMOUNT: TFloatField;
    TransactionsTRDESCRIPTION: TWideStringField;
    TransactionsCANPROCESS: TFloatField;
    TransactionsTrAmount: TFloatField;
    procedure FormCanResize(Sender: TObject; var NewWidth,
      NewHeight: Integer; var Resize: Boolean);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormCloseQuery(Sender: TObject; var CanClose: Boolean);
    procedure FormDestroy(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormShow(Sender: TObject);
    procedure DBGridTransactionsDrawColumnCell(Sender: TObject;
      const Rect: TRect; DataCol: Integer; Column: TColumnEh;
      State: TGridDrawState);
    procedure ButtonCommitClick(Sender: TObject);
    procedure TransactionsCalcFields(DataSet: TDataSet);
    procedure FormCreate(Sender: TObject);
  private
     FCommitTransactions : Boolean;
    { Private declarations }
  public
    { Public declarations }
  end;

var
  TransactionsViewForm: TTransactionsViewForm;

implementation
uses sboapiDataModuleImpl,SBTranslateProc;
{$R *.DFM}

procedure TTransactionsViewForm.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize :=False;
end;

procedure TTransactionsViewForm.FormClose(Sender: TObject; var Action: TCloseAction);
begin
Update
end;

procedure TTransactionsViewForm.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
resourcestring
  SCancelTransactions = 'Əmliyyat aparılmayacaq! Əminsinizmi?';
begin
  CanClose := FCommitTransactions or
    (MessageDlg(
       SCancelTransactions
      ,mtWarning
      ,[mbYes,mbNo]
      ,0) = mrYes)

end;

procedure TTransactionsViewForm.FormDestroy(Sender: TObject);
begin
Transactions.CloseAll;
end;

procedure TTransactionsViewForm.FormKeyPress(Sender: TObject; var Key: Char);
begin
 if ord(Key) =VK_ESCAPE then Close;
end;

procedure TTransactionsViewForm.FormShow(Sender: TObject);
begin
  Transactions.Open;
  FCommitTransactions := False;
end;

procedure TTransactionsViewForm.DBGridTransactionsDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumnEh;
  State: TGridDrawState);
const
  DataColIndex = 1;
begin
  // Drawing Transaction Status Image
  with Sender as TDBGridEh do
  begin
    if DataSource.DataSet.RecordCount <> 0 then
    begin
      if (DataCol = DataColIndex) then
      begin
       Canvas.Brush.Color := clSilver;
       StatusImages.Draw(Canvas, Rect.Left, Rect.Top, DataSource.DataSet.FieldByName('CANPROCESS').AsInteger , True)
      end
      else
       DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;
  end;

end;

procedure TTransactionsViewForm.ButtonCommitClick(Sender: TObject);
begin
  FCommitTransactions := True;
  ModalResult := mrOk;
end;

procedure TTransactionsViewForm.TransactionsCalcFields(DataSet: TDataSet);
begin
  with DataSet do
  if not FieldByName('DEBITAMOUNT').IsNull then
    FieldByName('TrAmount').AsFloat := FieldByName('DEBITAMOUNT').AsFloat
  else
    FieldByName('TrAmount').AsFloat := FieldByName('CREDITAMOUNT').AsFloat
end;

procedure TTransactionsViewForm.FormCreate(Sender: TObject);
begin
// SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

end.
