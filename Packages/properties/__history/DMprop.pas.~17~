procedure TDMproperties.DataSetPropInsApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: String);
{var
 p_TIPID,p_id,p_clientaccid,p_accno,p_BRANCHID:integer;
 p_DESCRIPTION,p_name,p_CONTRACTNUM:string;
 p_bdate : TDateTime;
 p_value:real;  }
begin
 {  // Applied := True;
  with (Sender as TOracleDataSet) do  begin
  //p_value:=FieldbyName('v').Asfloat;
 // p_prop_count:=FieldbyName('prop_count').Asinteger;
  p_DESCRIPTION:=FieldbyName('DESCRIPTION').Asstring;
  p_name:= FieldbyName('name').asstring;
  p_CONTRACTNUM:= FieldbyName('CONTRACTNUM').asstring;
  p_bdate:=FieldbyName('bdate').AsDateTime ;
  p_id:=FieldbyName('id').Asinteger;
 // p_clientaccid:=FieldbyName('clientaccid').Asinteger;
  p_accno:=FieldbyName('accno').Asinteger;
  p_BRANCHID:=FieldbyName('BRANCHID').Asinteger;
  p_TIPID:=FieldbyName('TIPID').Asinteger;
  end;
  {  with OraclePackage1 do
    //Applied := true;
      case Action of
       'I': begin
       CallProcedure('insert_prop',[p_value,p_name,p_DESCRIPTION,p_bdate,p_CONTRACTNUM,p_accno,p_BRANCHID,p_TIPID]);
        Applied := true;
        end;
       'U':  begin
        CallProcedure('edit_prop',[p_id,p_value,p_name,p_DESCRIPTION,p_bdate,p_CONTRACTNUM,p_accno,p_BRANCHID,p_TIPID]);
        Applied := true;
         end ;
   else  Applied := false
end;  }
  end;
