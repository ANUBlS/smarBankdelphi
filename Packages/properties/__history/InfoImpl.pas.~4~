unit InfoImpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Grids, DBGrids, Buttons, ExtDlgs,OracleData,db, ExtCtrls,
  OracleNavigator;

type
  TInfoFrm = class(TForm)
    DBGrid1: TDBGrid;
    SpeedButton14: TSpeedButton;
    SpeedButton15: TSpeedButton;
    OpenPictureDialog2: TOpenPictureDialog;
    OracleNavigator3: TOracleNavigator;
    procedure SpeedButton14Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  InfoFrm: TInfoFrm;

implementation

{$R *.dfm}
 uses DMprop;
procedure TInfoFrm.SpeedButton14Click(Sender: TObject);
var fileName,Path:String;
DataSet: TOracleDataSet;
begin

 DataSet:= DMproperties.Info;

with DataSet do
 begin
  Edit;
  if OpenPictureDialog2.Execute then
    TBlobField(DataSet.FieldByName('name')).LoadFromFile(OpenPictureDialog2.FileName)
  else
    begin
    exit;
    DataSet.cancel;
    end;
  DataSet.FieldByName('info').Value:=ExtractFileName( OpenPictureDialog2.FileName);
  DataSet.Post;
 end;

end;

end.
