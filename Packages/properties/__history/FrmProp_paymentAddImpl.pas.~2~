procedure TFrmProp_paymentAdd.SpeedButton1Click(Sender: TObject);
resourcestring
  rsTransactionsWillProcessed = 'Əməliyyat ...';
var
propid,Debitaccid,Sinvol,p_pille:  integer ;
sell_value,PROP_COUNT   :real;
CommitTranchePay : Boolean;
description:string;

begin

if  ComboBox1.Text ='' then
begin
ShowMessage('Satış növü seçilməyib') ;
exit;
end  ;
 if CheckBox1.Checked=true then
 p_pille:=1
 else
 p_pille:=0    ;

Debitaccid := DBLookupComboBox2.ListSource.DataSet.FieldByName('ID').AsInteger;
 propid:=Get_SelectedContID;
 sell_value:=strtofloat(edit1.text) ;
 Sinvol:= DBLookupComboBox1.ListSource.DataSet.FieldByName('SYMBOL').AsInteger;
 // ShowMessage(inttostr(Sinvol));
 //PROP_COUNT:=strtoint(PROP_COUNTE.text) ;
 // description:=descriptionE.text;
 //ShowMessage(floattostr(value));
 // ShowMessage(inttostr(Debitaccid));
 DMproperties.OraclePackage2.CallProcedure('AddPayment',[ 'p_propid',propid,
                                                          'P_Debitaccid',Debitaccid,
                                                          'P_sell_value',sell_value,
                                                          'P_description',description,
                                                          'P_Sinvol',Sinvol ,
                                                          'p_pille',p_pille,
                                                          'p_sat',ComboBox1.itemindex

                                                         ]) ;
  try

    CommitTranchePay := TrDelayed_Show(Self,rsTransactionsWillProcessed);

    Update;
    
    DMproperties.OraclePackage2.CallProcedure('CommitTranchePay',['DoCommit',
       CommitTranchePay
    ]);

    if CommitTranchePay then
    Self.ModalResult := mrOk;
    Self.Update;
  except


   DMproperties.OraclePackage2.CallProcedure('CommitTranchePay',['DoCommit',
        False
    ]);

    raise;
  end;
// DMproperties.DataSetProp_take.refresh;
// close
end;


