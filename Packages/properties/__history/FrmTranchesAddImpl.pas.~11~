procedure TFrmTranchesAdd.BitBtn1Click(Sender: TObject);
resourcestring
  rsTransactionsWillProcessed = 'Tranş ...';
var
propid,Debitaccid ,propcount:  integer ;
propnumetofcredit: string;
value   :real;
CommitTranche : Boolean;
date:string;
begin
 date:=FormatDateTime('dd-mmm-yyyy', Trunc(DateTimePicker1.Date))  ;
 Debitaccid := DBLookupComboboxEh2.ListSource.DataSet.FieldByName('ID').AsInteger;
 propnumetofcredit:= DBLookupComboboxEh1.ListSource.DataSet.FieldByName('NUMBEROFCREDIT').Asstring;
 propid:=Get_SelectedContID;
 value:=strtofloat(Edit3.text) ;
// propcount:=strtoint(edit2.text);
  //ShowMessage(floattostr(value));
 // ShowMessage(inttostr(Debitaccid));
 DMproperties.OraclePackage2.CallProcedure('AddTranche',['p_propid',propid,
                                                         'p_propnumetofcredit',propnumetofcredit,
                                                         'p_Debitaccid',Debitaccid,
                                                         'p_value',value,
                                                         'p_date',date
                                                         ]) ;
  try

    CommitTranche := TrDelayed_Show(Self,rsTransactionsWillProcessed);
    Update;
    if CommitTranche then
    DMproperties.OraclePackage2.CallProcedure('CommitTranche',['DoCommit', CommitTranche])
 else
   DMproperties.DataSetProp_take.Session.Rollback  ;
    if CommitTranche then
    Self.ModalResult := mrOk;
    Self.Update;
  except

   DMproperties.OraclePackage2.CallProcedure('CommitTranche',['DoCommit',
        False
    ]);

    raise;
  end;
// DMproperties.DataSetProp_take.refresh;
// close
