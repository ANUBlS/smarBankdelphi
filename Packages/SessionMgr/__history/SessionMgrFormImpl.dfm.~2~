  object SessionsData: TOracleDataSet
    SQL.Strings = (
      'select'
      '  SID,'
      '  Serial#,'
      '  AudSID,'
      '  user#,'
      '  UserName,'
      '  Status,'
      '  OSUser,'
      '  Process,'
      '  Machine,'
      '  Terminal,'
      '  Program,'
      '  Logon_Time,'
      '  decode(UserEnv('#39'SESSIONID'#39'), AudSID, 1, 0) as IsCurrentUser'
      'from sys.v_$session'
      'where'
      '  (Type = '#39'USER'#39')'
      '  and (UserName is not null)'
      '  and (Program = ('
      '    select program '
      '      from sys.v_$session '
      '    where AudSID = UserEnv('#39'SESSIONID'#39')'
      '    )'
      '  )'
      '  and (Status <> '#39'KILLED'#39')'
      ''
