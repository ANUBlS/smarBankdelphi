procedure TSessionMgrForm.RefreshTimerTimer(Sender: TObject);
var
  LastSID: Integer;
begin
  with SessionsData do
    if Session.Connected then
    begin
      if Active then
        LastSID := FieldByName('SID').AsInteger
      else
        LastSID := -1;
      Close;
      Open;
      if LastSID <> -1 then
        Locate('SID', LastSID, []);
    end;
end;

procedure TSessionMgrForm.ActiveFormCreate(Sender: TObject);
begin
  RefreshTimer.OnTimer(RefreshTimer);
 SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);

end;

procedure TSessionMgrForm.RestrictLoginsExecute(Sender: TObject);
begin
  with Sender as TAction do
  begin
    Checked := not Checked;
//    RestrictModeButton.Down := Checked;
    if Checked then
      EnterRestrictedModeQuery.Execute
    else
      LeaveRestrictedModeQuery.Execute;
  end;
end;

procedure TSessionMgrForm.KillUserExecute(Sender: TObject);

  function Replace(const Text: String; const SourceChar, TargetChar: Char): String;
  var
    I: Integer;
  begin
    Result := Text;
    for I := 0 to Length(Result) do
      if Result[I] = SourceChar then
        Result[I] := TargetChar;
  end;

var
  Message: String;
const
  Timeout = 10;
begin
  Message := Format('Immediate shutdown in %d seconds. Save your work and exit program', [Timeout]);
  with SessionsData do
    if
      InputQuery(
        'Confirm user killing',
        'Enter text message to be sent to user: ',
        Message)
    then
      Sb_KillSession(
        FieldByName('SID').AsString,
        FieldByName('Serial#').AsString,
        Replace(Message, ' ', '_'),
        Timeout,
        Timeout + 5);
end;

procedure TSessionMgrForm.DBGrid1DrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  if DataCol = 1 then
    if Column.Grid.DataSource.DataSet.FieldByName('IsCurrentUser').AsInteger = 1 then
      ImageList1.Draw(DBGrid1.Canvas, Rect.Left+1, Rect.Top, 1);
end;

procedure TSessionMgrForm.KillUserUpdate(Sender: TObject);
begin
  with Sender as TAction do
    Enabled := SessionsData.FieldByName('IsCurrentUser').AsInteger = 0;
end;

procedure TSessionMgrForm.KillAllExecute(Sender: TObject);
var
  Message: String;
begin
  if
    MessageDlg(
      'Kill all users?',
      mtConfirmation,
      [mbYes, mbCancel],
      0
    ) = mrYes
  then
    if InputQuery('Enter message to be sent to users', 'Message:', Message) then
      Sb_KillAll('%', Message, 15);
end;

procedure TSessionMgrForm.KillUserHint(var HintStr: String;
  var CanShow: Boolean);
ResourceString
  SKillUserHint = 'Kill current user';
  SKillHimselfHint = 'You can not kill himself';
begin
  with KillUser do
    if Enabled then
      HintStr := SKillUserHint
    else
      HintStr := SKillHimselfHint;
end;

procedure TSessionMgrForm.SendMessageExecute(Sender: TObject);
var
  Message: String;
begin
  if InputQuery('Enter message', 'Text:', Message) then
    Sb_SendMessage(SessionsData.FieldByName('SID').AsString, Message);
end;

procedure TSessionMgrForm.SendMessageToAllExecute(Sender: TObject);
var
  Message: String;
begin
  if InputQuery('Enter message', 'Text:', Message) then
    Sb_SendMessage(SessionsData.FieldByName('SID').AsString, Message, MsgName_MessageBroadcast);
end;

procedure TSessionMgrForm.actSettingsMsgExecute(Sender: TObject);
begin
  if not assigned(frmMsgSettings) then
    frmMsgSettings := TfrmMsgSettings.Create(Self);
  with frmMsgSettings do begin
    ShowModal;
  end;
end;

