unit Unit22;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, NLSDialogs,
  Grids, DBGrids, StdCtrls, ExtCtrls;

type
  TForm2 = class(TForm)
    DBGrid2: TDBGrid;
    Panel2: TPanel;
    GroupBox1: TGroupBox;
    GroupBox2: TGroupBox;
    DBGrid1: TDBGrid;
    Edit1: TEdit;
    Edit2: TEdit;
    Button2: TButton;
    DBGrid3: TDBGrid;
    Button1: TButton;
    Button3: TButton;
    Button4: TButton;
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure Button3Click(Sender: TObject);
    procedure Button4Click(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form2: TForm2;

implementation
uses UnitData,sboapiDataModuleImpl, SBTranslateProc;

{$R *.DFM}

procedure TForm2.Button1Click(Sender: TObject);
var vv:string;
begin
//ShowMessage('a');
vv:=Edit1.text;
//ShowMessage('bs');

DataModWares.SalaryPackage.CallProcedure('WA_INS',[vv]);
DataModWares.OracleDataSet9.Refresh;

ShowMessage('Усер дахил едилди');
Edit1.text:='';
end;

procedure TForm2.Button2Click(Sender: TObject);
var vv:string;
begin
//ShowMessage('a');
vv:=Edit2.text;
//ShowMessage('bs');
DataModWares.SalaryPackage.CallProcedure('WA_INS1',[vv]);
DataModWares.OracleDataSet10.Refresh;
ShowMessage('Шюбя дахил едилди');
Edit2.text:='';
end;

procedure TForm2.Button3Click(Sender: TObject);
var v_id : integer;
begin
v_id:=DataModWares.OracleDataSet9.fieldbyname('id').asinteger;
DataModWares.SalaryPackage.CallProcedure('WA_DEL',[v_id]);
DataModWares.OracleDataSet9.Refresh;
ShowMessage('Silindi');

end;

procedure TForm2.Button4Click(Sender: TObject);
var v_id1 : integer;
begin
v_id1:=DataModWares.OracleDataSet10.fieldbyname('id').asinteger;
DataModWares.SalaryPackage.CallProcedure('WA_DEL1',[v_id1]);
DataModWares.OracleDataSet10.Refresh;
ShowMessage('Silindi');
end;

procedure TForm2.FormClose(Sender: TObject; var Action: TCloseAction);
begin
DataModWares.OracleDataSet9.Edit;
DataModWares.OracleDataSet9.post;
DataModWares.OracleDataSet10.Edit;
DataModWares.OracleDataSet10.post;

end;

procedure TForm2.FormCreate(Sender: TObject);
begin

SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

end.
