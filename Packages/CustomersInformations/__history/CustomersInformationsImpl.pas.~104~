procedure TCustomersInformations.OrDSCustomersBeforeOpen(
  DataSet: TDataSet);
begin
  with OrDSCustomers do begin
   Close;
   SQL.Clear;


  { SQL.Add(' select c.ID, c.Name, c.INN, c.Open_Dat, c.Close_Dat, c.Cust_TYPE,c.op_id,');
   SQL.Add('(select name from user$ where id=c.op_id) as USER_NAME,');
   SQL.Add('(select filialid from sba_objinf where obj=(select name from user$ where id=c.op_id)) filial_id,');
   SQL.Add('(select name from filial_t where id=(select filialid from sba_objinf where obj=(select name from user$ where id=c.op_id))) filial_name');
   SQL.Add(' from Customers c where');  }
   //SQL.Add(', '''+OrDSFilials.FieldByName('Name').AsWideString+''' Filial from Customers c where');
    SQL.Add(Memo2.Text);

   if (RBtnCust.Checked=false) and (OrDSAccount.RecordCount<>0) then
      SQL.Add(' c.ID='+OrDSAccountKLI_ID.AsString+' and');
   if SearchCFilial.ItemIndex<>0 then
     // SQL.Add(' (ID in (select KLI_ID from Account where'+
             // ' Filial='+OrDSFilialsID.AsString+')) and');
   SQL.Add(' (select filialid from sba_objinf where obj=(select name from user$ where id=c.op_id)) ='+OrDSFilialsID.AsString+' and');

   if (CBoxOpenCust.Checked=true) and (CBoxCloseCust.Checked=false)  then
      SQL.Add(' c.close_dat is null and');
   if (CBoxOpenCust.Checked=false) and (CBoxCloseCust.Checked=true) then
      SQL.Add(' c.close_dat is not null and');
   if RGrCustDates.ItemIndex=0 then
      SQL.Add(' (c.open_dat between (:BegDate) and (:EndDate))');
   if RGrCustDates.ItemIndex=1 then
      SQL.Add(' (c.close_dat between (:BegDate) and (:EndDate))');
   //SQL.Add(' order by ID ' );
   SQL.Add(' and upper(c.name) like :pName ');
   SQL.Add(' and (NVL(c.cust_type,0) in (:P_CUSTTYPE)) ');
   SQL.Add(' order by c.'+DBGridCustomers.Columns[CTitle].FieldName);
case ComboBox1.ItemIndex of
0: begin OrDSCustomers.SetVariable('P_CUSTTYPE','0,1,2,3'); end;
1: begin OrDSCustomers.SetVariable('P_CUSTTYPE','0'); end;
2: begin OrDSCustomers.SetVariable('P_CUSTTYPE','1'); end;
3: begin OrDSCustomers.SetVariable('P_CUSTTYPE','2'); end;
4: begin OrDSCustomers.SetVariable('P_CUSTTYPE','3'); end;
end;
   SetVariable('BegDate',Integer(trunc(BegDateCust.Date)));
   SetVariable('EndDate',Integer(trunc(EndDateCust.Date)));
   SetVariable('pName','%%');
 //  memo1.text:=Sql.Text;
 end;{with OrDSCustomers}
end;

