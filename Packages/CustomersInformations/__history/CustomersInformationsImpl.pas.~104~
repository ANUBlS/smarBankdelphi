procedure TCustomersInformations.OrDSDocsBeforeOpen(DataSet: TDataSet);
begin
  with OrDSDocs do begin
  Close;
  SQL.Clear;
  SQL.Add(' select p.dat,a1.acc_no as Debit,a1.Name as DName,a2.acc_no as Credit,a2.Name as CName,'+
  'p.ammount,p.lammount,p.ammount_c,p.name, a1.tipacc as d_symbol, a2.tipacc as c_symbol'+
  ' from provarch p, account a1, account a2 ');
  SQL.Add(' where (dat between (:BegDate) and (:EndDate))');
  if (RBtnDocs.Checked=false) and (OrDSAccount.RecordCount<>0) then begin
  if ChListDocs.Checked[0]=true and ChListDocs.Checked[1]=true then
    SQL.Add(' and (p.debt in (select id from account where acc_no='+''''+
      OrDSAccountACC_NO.AsString+''''+')'+
      ' or p.kredit in (select id from account where acc_no='+''''+
      OrDSAccountACC_NO.AsString+''''+'))')
      else begin
      if ChListDocs.Checked[0]=true then
         SQL.Add(' and (p.debt in (select id from account where acc_no='+''''+
         OrDSAccountACC_NO.AsString+''''+'))');
      if ChListDocs.Checked[1]=true then
         SQL.Add(' and (p.kredit in (select id from account where acc_no='+''''+
         OrDSAccountACC_NO.AsString+''''+'))');
      end;{else}
  end{if RBtnDocs.Checked=false}
  else begin
   if SearchCFilial.ItemIndex<>0 then
    SQL.Add(' and (a1.Filial='+OrDSFilialsID.AsString+
            ' or a2.Filial=' +OrDSFilialsID.AsString+')');
  end;{else}
  SQL.Add(' and (p.debt=a1.id and p.kredit=a2.id)');
  SQL.Add(' order by '+DBGridDocs.Columns[DTitle].FieldName);


//   SetVariable('Acc_NO',OrDSAccountACC_NO.AsString);
   SetVariable('BegDate',Integer(trunc(BegDateDocs.Date)));
   SetVariable('EndDate',Integer(trunc(EndDateDocs.Date)));
  end;{with OrDSDocs}
end;

