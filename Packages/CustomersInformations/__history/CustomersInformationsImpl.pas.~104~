  end;

end;

procedure TCustomersInformations.OrDSAccountBeforeOpen(DataSet: TDataSet);
begin
 with OrDSAccount do begin
  Close;
  SQL.Clear;
  SQL.Add(' select ac.id,ac.ACC_NO,ac.Name,val.Val_Name,ac.Open_Dat,ac.Close_Dat,'+
          'ac.Kli_ID,abs(ten.Ostat),abs(ten.Pok_Ostat),ten.datdate as Tarix ,'+
          'ac.tipacc as symbol, f.Name as Filial, cu.name as cust_name,ac.bal_cn1,cu.inn as cust_voen,ct.name as cust_type'+
          ' from Account ac, Avalute val, Archost ten, Filial f, customers cu,cust_types ct'+
          ' where ten.Datdate=:BalDate and f.ID=ac.filial and cu.id=ac.kli_id and ct.id=cu.cust_type and');
  if (RBtnCust.Checked=true) and (OrDSCustomers.RecordCount<>0) then
     SQL.Add(' ac.Kli_ID='+OrDSCustomersID.AsString+' and');
  if RBtnDocs.Checked =true then
     SQL.Add(' (ac.ACC_NO='+''''+OrDSDocsDEBIT.AsString+''''+
             ' or ac.ACC_NO='+''''+OrDSDocsCREDIT.AsString+''''+') and');
  SQL.Add(' ac.Val_Acc=val.Valute and ac.ID=ten.Acc_ID');
  if SearchCFilial.ItemIndex<>0 then
     SQL.Add(' and ac.Filial='+OrDSFilialsID.AsString);
  if SearchCAvaluteAcc.ItemIndex<>0 then
     SQL.Add(' and (ac.Val_Acc='+OrDSAvaluteVALUTE.AsString+')');
  if EditOstatMin.Text<>'' then
     if RBtnOstatAZM.Checked=true then
     SQL.Add(' and abs(ten.Pok_ostat)>='+EditOstatMin.Text)
     else SQL.Add(' and abs(ten.Ostat)>='+EditOstatMin.Text);
  if EditOstatMax.Text<>'' then
     if RBtnOstatAZM.Checked=true then
     SQL.Add(' and abs(ten.Pok_ostat)<='+EditOstatMax.Text)
     else SQL.Add(' and abs(ten.Ostat)<='+EditOstatMax.Text);
  if (CBoxOpenAccs.Checked=true) and (CBoxCloseAccs.Checked=false) then
     SQL.Add(' and  (ac.Close_Dat is null)');
  if (CBoxOpenAccs.Checked=false) and (CBoxCloseAccs.Checked=true) then
     SQL.Add(' and (ac.Close_Dat is not null)');
  if RGrAccDates.ItemIndex=0 then
      SQL.Add(' and (ac.open_dat between (:BegDate) and (:EndDate))');
  if RGrAccDates.ItemIndex=1 then
      SQL.Add(' and (ac.close_dat between (:BegDate) and (:EndDate))');

  SQL.Add(' and upper(ac.name) like :pName ');
