  OrderKind :string;
begin
   if Column.Index = 1 then Exit;
   OrderKind := Column.Field.FieldName;
   Screen.Cursor := crHourGlass;
   try
       with TOracleDataSet(CRADBGrid.DataSource.DataSet) do
       begin
         if  Active  then  CloseAll;
         SetVariable('OrderClause',OrderKind);
         Open
       end;
    finally
      Screen.Cursor := crDefault;
    end;
end;

