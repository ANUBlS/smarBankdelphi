procedure TCRAMainForm.CRADBGridDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
const
    DataColIndex = 1;
var
    ImageIndex :Integer;
begin
  ImageIndex :=-1;
  with Sender as TDBGrid do
  begin
    if DataSource.DataSet.RecordCount <> 0 then
    begin
      case DataSource.DataSet.FieldByName('Status').AsInteger of
      csUnknown:
        ImageIndex := 0;
      csCalculated:
        ImageIndex := 1;
      csDisabled:
        ImageIndex := 2;
      end;   //Case
      if   (DataCol = 1)   then
        StatusImages.Draw(Canvas, Rect.Left, Rect.Top, ImageIndex, True)
      else
        DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;
  end;

end;

procedure TCRAMainForm.ActnCalcExecute(Sender: TObject);
const
   NoErrorTitle         = ' Faizlər hesablandı.';
   ResulTitle           = ' Faizlərin  hesablanmasında səhvlər var! ';

var SelRowsCount,ContID,SelRowIndex ,Aborted:integer;
begin
    with CRADBGrid,SelectedRows,DataSource.DataSet  do
    begin
      ContID :=FieldByName('ID').AsInteger;
      SelRowsCount :=Count;
      if   MessageDlg('Faizlər hesablanır əminisinizmi?'
              ,mtConfirmation
              ,[mbYes,mbNo],0
              )<>mrYes then Abort;

      with  FormCRAProgress,ProgressBar  do
      begin
        Max :=SelRowsCount;
        Position :=0;
        FormCRAProgress.Show;
      end;
      Application.ProcessMessages;
    try
    Aborted:=0;
      for  SelRowIndex :=0  to  SelRowsCount-1 do
      try
        ContID :=FieldByName('ID').AsInteger;
        GotoBookmark(Pointer(Items[SelRowIndex]));
        FormCRAProgress.ProgressBar.StepIt;
        FormCRAProgress.StaticTextContNo.Caption :=FieldByName('ContractNo').AsString;

        with CRADatMod,CRA_CONTRACT do
           CallProcedure('calcrapercent',['p_contid',ContID]);

        except
        on E:EOracleError do
        begin

        // ErrMessage := copy(ErrMessage,0,Pos('^',ErrMessage));
          FormCRAProgress.MemoD.Lines.Add(' #'
                                +FieldByName('ContractNo').AsString +' << ' + E.Message + ' >> '
                              );
          FormCRAProgress.MemoD.Lines.Add('');
          Inc(Aborted);
          Continue;
        end;
      end;
    finally
         with FormCRAProgress do begin
           ProgressBar.Position :=0;
           if Aborted <> 0 then
           begin
             LblResult.Font.Color := clRed;
             LblResult.Caption :=IntToStr(Aborted)+ResulTitle
           end
           else
           begin
             LblResult.Font.Color := clGreen;
             LblResult.Caption := NoErrorTitle;
           end;

          end;
         CRADatMod.Contracts.Refresh;;
      end;
   end;

end;

