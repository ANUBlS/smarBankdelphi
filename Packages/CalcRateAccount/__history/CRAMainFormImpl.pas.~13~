      FieldByName('BRANCHID').AsInteger:=CRADatMod.BranchKod.FieldByName('KOD_FIL').AsInteger;
      FieldByName('OPENDATE').AsDateTime:=CRADatMod.BankDate.FieldByName('TEK_DAT').AsDateTime;
      FieldByName('CLOSEDATE').AsDateTime:=CRADatMod.BankDate.FieldByName('TEK_DAT').AsDateTime;
   end;
   with FormAddEditContract do
   begin
      CMSearchEdit2.Text:='';
      CMSearchEdit1.Text:='';
      ShowModal;
   end;
end;

