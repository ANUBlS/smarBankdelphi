     and (DataSource.DataSet.FieldByName(DataField).AsInteger <> 0) then
    begin
      KeyValue := Null;
      KeyValue := ListSource.DataSet.FieldByName(KeyField).AsInteger;
    end;
  end;

begin
       CRADatMod.SB_ACA.CallProcedure('CheckObjectAccess',['CALCRATEFORACCOUNT','Update']);
   with CRADatMod,Purpose do
   begin
      if Active then CloseAll;
      SetVariable('ContID',CRADatMod.Contracts.FieldByName('ID').AsInteger);
