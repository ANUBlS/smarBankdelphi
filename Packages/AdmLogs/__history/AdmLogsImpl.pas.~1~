              'and to_date(MODTIME)>='''+FormatDateTime('dd-mmm-yyyy',dtpB.Date)+''' '+
              'and to_date(MODTIME)<='''+FormatDateTime('dd-mmm-yyyy',dtpE.Date)+'''';
    ODSUserGrantsLogs.Open;
    ODSUserGrantsLogs.SQL[4] := '';
  end;
