procedure TAdmLogs.Button1Click(Sender: TObject);

begin
with DataModAL,ExcelExport do begin
  Connect;
  case pgcMain.ActivePageIndex of
  0:begin
    ExportDataset(ODSUserGrantsLogs,'Sheet', True);
  end;
  1:begin
    ExportDataset(ODSModuleLogs,'Sheet', True);
  end;
  2:begin
    ExportDataset(ODSUsersLogs,'Sheet', True);
  end;
  3:begin
    ExportDataset(OdsGroupsLogs,'Sheet', True);
  end;
  4:begin
    ExportDataset(ODSClassesLogs,'Sheet', True);
  end;
  5:begin
    ExportDataset(ODSGroupManLogs,'Sheet', True);
  end;
  end;
end;

end;

procedure TAdmLogs.ActiveFormCreate(Sender: TObject);
begin
  DataModAL := TDataModAL.Create(Self);
  pgcMain.ActivePageIndex := 0;
  dtpB.DateTime:=Date;
  dtpE.DateTime:=Date;
  Button4.Click;
end;

procedure RefreshDataSet(DSet: TOracleDataSet);
begin
  DSet.Close;
  DSet.Open;
end;

procedure DelRowsDS(DSet: TOracleDataSet);
var
  i: integer;
begin
  DSet.First;
  for i := 0 to dset.RecordCount-1 do begin
    DataModAL.SB_ADM.CallProcedure('dellog',[DSet.Fields[0].AsVariant]);
    DSet.Next;
  end;
  RefreshDataSet(DSet);
end;

