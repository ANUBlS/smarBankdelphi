      '          FROM cm_payments'
      '         WHERE creditid = p.id)'
      '           opdtarix,          '
      '       (SELECT SUM ('
      '                     payedamt'
      '                   + payedintamt'
      '                   + payeddueamt'
      '                   + payeddueintamt'
      '                   + payedpenaltyamt)'
      '                   pay'
      '          FROM cm_payments'
      '         WHERE     paydate = (SELECT MAX (paydate)'
      '                                FROM cm_payments'
      '                               WHERE creditid = p.id)'
      '               AND creditid = p.id)'
      '           odmeb,'
      '      '
      '       h.dueday,'
      '       h.dueday dueday1,'
      '       e1.percent,'
      '       ROUND (h.reserverest) reserverest,'
      '       e2.percent percent1,'
      '       ROUND (h.reserveintrest) reserveintrest,'
      '       DECODE ( (SELECT COUNT (*)'
