      '                '#39'Shaki'#39
      '        END)'
      '           ff1,'
      '       '#39#39' ff2,'
      '       '#39#39' ff3,'
      '       '#39#39' ff4,'
      '       '#39#39' ff5,'
      '       '#39#39' ff6,'
      '       '#39#39' ff7,'
