      '           ELSE'
      '               '#39'0'#39
      '       END'
      '           tip,'
      '       '#39#39' transaction_xet,'
      
        '       TO_CHAR (p.dateofconclusion, '#39'YYYY-MM-DD'#39') dateofconclusi' +
        'on,'
      
        '       TO_CHAR (p.dateofconclusion, '#39'YYYY-MM-DD'#39') dateofconclusi' +
        'on1,'
      
        '       TO_CHAR (p.duedatelastcontract, '#39'YYYY-MM-DD'#39') duedatelast' +
