{$R *.DFM}
uses
sboapiDataModuleImpl;
procedure Tcardexpire.CheckBox1Click(Sender: TObject);
begin
if CheckBox1.Checked then
DateTimePicker1.Enabled:=true else DateTimePicker1.Enabled:=False;
end;

procedure Tcardexpire.CheckBox2Click(Sender: TObject);
begin
if CheckBox2.Checked then
DateTimePicker2.Enabled:=true else DateTimePicker2.Enabled:=False;
end;

procedure Tcardexpire.ToolButton1Click(Sender: TObject);
begin
if (CheckBox1.Checked) and  (CheckBox2.Checked)   then
begin
 OracleDataSet1.close;
 OracleDataSet1.SQL[4]:=' ';
 OracleDataSet1.SQL[4]:='where expiry between '+''''+Formatdatetime('dd-mmm-yyyy',datetimepicker1.datetime)+''''+' and '+''''+FormatDateTime('dd-mmm-yyyy',datetimepicker2.datetime)+'''';
 // ShowMessage('where expiry between '+''''+datetostr(datetimepicker1.datetime)+''''+' and '+''''+datetostr(datetimepicker2.datetime)+'''');
 OracleDataSet1.open;
 end
    else

if CheckBox1.Checked then
begin
 OracleDataSet1.close;
 OracleDataSet1.SQL[4]:=' ';
 OracleDataSet1.SQL[4]:='where expiry >= '+''''+Formatdatetime('dd-mmm-yyyy',datetimepicker1.datetime)+'''';
 OracleDataSet1.open;

end
   else
if  CheckBox2.Checked  then
begin
  OracleDataSet1.close;
 OracleDataSet1.SQL[4]:=' ';
 OracleDataSet1.SQL[4]:='where expiry <= '+''''+Formatdatetime('dd-mmm-yyyy',datetimepicker2.datetime)+'''';
 OracleDataSet1.open;
end
else

begin
 ShowMessage('tarixlerin en azi biri secilmelidir!');
end;

end;

procedure Tcardexpire.ToolButton14Click(Sender: TObject);
begin
OracleDataSet1.close;
end;

procedure Tcardexpire.ToolButton6Click(Sender: TObject);
begin
  if not CMExcelExport1.Connected then CMExcelExport1.Connect;
  CMExcelExport1.ExportDataset(dbgrid1.datasource.dataset,'Expiry',true,true);
  CMExcelExport1.Disconnect;
end;

procedure Tcardexpire.FormShow(Sender: TObject);
begin
DateTimePicker1.DateTime:=date;
DateTimePicker2.DateTime:=date;
end;

end.
