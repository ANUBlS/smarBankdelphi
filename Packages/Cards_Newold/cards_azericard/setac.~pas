procedure TForm10.Edit1Change(Sender: TObject);
begin
  with DataMod_CARDS.sazlamalar do begin
   Filter := 'id = '''+edit1.Text+('*')+'''';
  end;
end;

procedure TForm10.Edit2Change(Sender: TObject);
