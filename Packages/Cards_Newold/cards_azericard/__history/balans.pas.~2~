 Function when2Str(wday:integer): string;
  var
  wd: string;

 begin
  wd:=InttoStr(wday);
  case length(wd) of
                    1: wd:='00'+wd;
                    2: wd:='0'+wd;
  end;
  when2Str:=wd;
 end;


     function whenday2(dat:tdatetime):integer;
  const yan=31;mar=31;apr=30;may=31;jun=30;jul=31;avg=31;seb=30;okt=31;nov=30;dec=31;
  var   wday,feb:integer;
 begin
  wday:=0;
  if IsLeapYear(strtoint(FormatDateTime('yyyy',dat))) then feb:=29 else feb:=28;
  case strtoint(FormatDateTime('mm',dat)) of
                                              1:wday:=StrToInt(FormatDateTime('dd',dat));
                                              2:wday:=yan+StrToInt(FormatDateTime('dd',dat));
                                              3:wday:=yan+feb+StrToInt(FormatDateTime('dd',dat));
                                              4:wday:=yan+feb+mar+StrToInt(FormatDateTime('dd',dat));
                                              5:wday:=yan+feb+mar+apr+StrToInt(FormatDateTime('dd',dat));
                                              6:wday:=yan+feb+mar+apr+may+StrToInt(FormatDateTime('dd',dat));
                                              7:wday:=yan+feb+mar+apr+may+jun+StrToInt(FormatDateTime('dd',dat));
                                              8:wday:=yan+feb+mar+apr+may+jun+jul+StrToInt(FormatDateTime('dd',dat));
                                              9:wday:=yan+feb+mar+apr+may+jun+jul+avg+StrToInt(FormatDateTime('dd',dat));
                                             10:wday:=yan+feb+mar+apr+may+jun+jul+avg+seb+StrToInt(FormatDateTime('dd',dat));
                                             11:wday:=yan+feb+mar+apr+may+jun+jul+avg+seb+okt+StrToInt(FormatDateTime('dd',dat));
                                             12:wday:=yan+feb+mar+apr+may+jun+jul+avg+seb+okt+nov+StrToInt(FormatDateTime('dd',dat));
  end;
  Result:=wday;
 end;



    function whenday:integer;
  const yan=31;mar=31;apr=30;may=31;jun=30;jul=31;avg=31;seb=30;okt=31;nov=30;dec=31;
  var   wday,feb:integer;
 begin
  wday:=0;
  if IsLeapYear(strtoint(FormatDateTime('yyyy',date))) then feb:=29 else feb:=28;
  case strtoint(FormatDateTime('mm',date)) of
                                              1:wday:=StrToInt(FormatDateTime('dd',date));
                                              2:wday:=yan+StrToInt(FormatDateTime('dd',date));
                                              3:wday:=yan+feb+StrToInt(FormatDateTime('dd',date));
                                              4:wday:=yan+feb+mar+StrToInt(FormatDateTime('dd',date));
                                              5:wday:=yan+feb+mar+apr+StrToInt(FormatDateTime('dd',date));
                                              6:wday:=yan+feb+mar+apr+may+StrToInt(FormatDateTime('dd',date));
                                              7:wday:=yan+feb+mar+apr+may+jun+StrToInt(FormatDateTime('dd',date));
                                              8:wday:=yan+feb+mar+apr+may+jun+jul+StrToInt(FormatDateTime('dd',date));
                                              9:wday:=yan+feb+mar+apr+may+jun+jul+avg+StrToInt(FormatDateTime('dd',date));
                                             10:wday:=yan+feb+mar+apr+may+jun+jul+avg+seb+StrToInt(FormatDateTime('dd',date));
                                             11:wday:=yan+feb+mar+apr+may+jun+jul+avg+seb+okt+StrToInt(FormatDateTime('dd',date));
                                             12:wday:=yan+feb+mar+apr+may+jun+jul+avg+seb+okt+nov+StrToInt(FormatDateTime('dd',date));
  end;
  Result:=wday;
 end;

 function ViewBalanceSign(Balance : real):String;
begin
       if balance = 0 then result:='N';
       if balance > 0 then result:='C';
       if balance < 0 then result:='D';
end;
   function insertzero(acc:real):string ;
var modpart,s:string;
    dempos:integer;
begin
       result:='';
       result:=inttostr(trunc(acc));
       s:=FloatToStr(acc);
       dempos:=pos(DecimalSeparator,s);
       if dempos = 0 then  modpart:='00' else
       begin
          if length(copy(s,dempos+1,length(s)-dempos)) = 1 then
          modpart:= copy(s,dempos+1,length(s)-dempos)+'0' else
          if length(copy(s,dempos+1,length(s)-dempos)) = 2 then
          modpart:=copy(s,dempos+1,length(s)-dempos);
       end;
       Result:=Result+modpart;
end;
 function DirectoryExists(const Name: string): Boolean;
var
  Code: Integer;
begin
  Code := GetFileAttributes(PChar(Name));
  Result := (Code <> -1) and (FILE_ATTRIBUTE_DIRECTORY and Code <> 0);
end;
