    q_e_f_sonlugu                                                                       : string;
    q_e_f_bashligi                                                                      : string;
    adidir,familidir                                                                    : String;
    duzdurmu            : Boolean;
    i_ad                : Integer;


begin
Qebul_edilen_fayl:=filename;
q_e_f_sonlugu:=copy(Qebul_edilen_fayl,(length(Qebul_edilen_fayl)-2),3);
q_e_f_bashligi:=copy(Qebul_edilen_fayl,1,3);
   AssignFile(Qebul_edilen_F,Qebul_edilen_fayl);
