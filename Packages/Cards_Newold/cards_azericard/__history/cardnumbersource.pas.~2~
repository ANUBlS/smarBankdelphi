procedure TCARDNUMBER.ToolButton2Click(Sender: TObject);
var

   
   Index :Integer;
   WaitNextConfirm, WillRefresh: Boolean;
   TransactionID :Integer;
begin


  WaitNextConfirm :=True;
  WillRefresh :=False;
  if DBGrid1.CanFocus then
  DBGrid1.SetFocus;


  with  DBGrid1, SelectedRows, DataSource.DataSet, DataMod_CARDS do
  try
    if Count = 0 then CurrentRowSelected := True;



    for  Index :=0 to  Count - 1 do
    begin
      GotoBookmark(Pointer(Items[Index]));
      TransactionID :=FieldbyName('ID').AsInteger;

      if  WaitNextConfirm  then
      case MessageDlg(
        Format('Сечилмиш сятир силинсин? ',[TransactionID])
       ,mtConfirmation
       ,[mbYes, mbNo ,mbCancel ,mbYesToAll]
       ,0
       )   of
        mrNo       : begin Continue;  end;
        mrCancel   : begin Break; end;
        mrYesToAll :
          if MessageDlg(Format('%d  сайда сятир силинсин?', [Count - Index]), mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
           WaitNextConfirm :=False
          else
           Continue;
      end;
      Application.ProcessMessages;
      //------------------------------------------------------------------------------------delete

                DataMod_CARDS.mainpacket.CallProcedure('cardnumdelete',[TransactionID]) ;

      //--------------------------------------------end delete



      WillRefresh :=True;


    end;
  finally
   if WillRefresh then


   begin


                          DBGrid1.DataSource.DataSet.Refresh;
                          DBGrid2.DataSource.DataSet.Refresh;
                          ShowMessage('Сятирляр силинди!');




   end;

  end;
end;


