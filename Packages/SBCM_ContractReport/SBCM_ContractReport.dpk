package SBCM_ContractReport;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Credits Managment Common Declarations, Functions Classes'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  sboapi50,
  SBDMDataModule,
  SBDM_Common,
  Qrpt50;

contains
  UnitContractReport in 'UnitContractReport.pas' {frmContractReport},
  UnitDepozitMoneyReport in 'UnitDepozitMoneyReport.pas' {frmDepozitMoneyReport},
  UnitWithDrawReoprt in 'UnitWithDrawReoprt.pas' {frmWithDrawReoprt};

end.
