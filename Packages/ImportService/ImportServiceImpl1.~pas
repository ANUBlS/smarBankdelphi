procedure TFormImportService.BtnImportClick(Sender: TObject);
const
  c_info = '%d yazi idxal olundu!';
var
   V,Sheet,Sheets  :Variant;
   cell,i,j    :Integer;
begin
  if OpenDialog.Execute then begin
   EditFilePath.Text :=OpenDialog.FileName;
   OrDSXLS_SalaryMessages.Open;
   V:=ExcelApplication1.Application;
   ExcelApplication1.Connect;
   V.Workbooks.Open(OpenDialog.FileName);
   Sheet := V.Workbooks[1].Worksheets['MESSAGES'];
   Sheets := V.Sheets;

   OrDSXLS_SalaryMessages.First;
   j:=5;

   repeat
    cell :=1;
    OrDSXLS_SalaryMessages.Insert ;
    for i:=0  to OrDSXLS_SalaryMessages.FieldCount-1 do
     begin
      Application.ProcessMessages;
      OrDSXLS_SalaryMessages.Fields[i].AsString :=Sheet.cells[j,cell];
      cell:=cell+1;
     end;
    OrDSXLS_SalaryMessages.Post;
    OrDSXLS_SalaryMessages.Next;
    j:=j+1;
   until (Sheet.cells[j,1].Text = '') and (Sheet.cells[j,2].Text = '') and (Sheet.cells[j,3].Text = '');

  V :=null;
  Application.ProcessMessages;
  ExcelApplication1.Quit;
  ExcelApplication1.Disconnect;
  Application.ProcessMessages;
  OrDSXLS_SalaryMessages.Refresh;
  ShowMessage(Format(c_info, [j-5]));
  end; {if OpenDialog.Execute}

end;

procedure TFormImportService.BtnEmptyClick(Sender: TObject);
begin
  if MessageDlg('Cedvelin temizlenmesini isteyirsinizmi?',mtConfirmation, [mbYes, mbNo], 0) = mrYes then
  begin
   OrPackXLS_PROCESSES.CallProcedure('EmptyXLS_SalaryMessages',[]);
   OrDSXLS_SalaryMessages.Refresh;
  end; {if MessageDlg}

end;

procedure TFormImportService.BtnProcessClick(Sender: TObject);
begin
  OrPackXLS_PROCESSES.CallProcedure('GetTransaction',
   [OrDSXLS_OperationTypes.FieldByName('Debit').AsString,
    OrDSXLS_OperationTypes.FieldByName('Credit').AsString,
    OrDSXLS_OperationTypes.FieldByName('Purpose').AsString]);
  OrDSXLS_SalaryMessages.Refresh;
  if OrDSXLS_SalaryMessages.RecordCount>0 then
   ShowMessage('Bezi emeliyyatlar yerine yetirilmedi');

end;

procedure TFormImportService.BtnHelpClick(Sender: TObject);
begin
  OrDSXLS_Example_File.Open;
  with ExcelExporter do
   begin
    if not Connected then Connect;
     ExportDataset(OrDSXLS_Example_File,'MESSAGES',True);
     Disconnect;
   end;
end;

procedure TFormImportService.EditFilePathKeyUp(Sender: TObject;
  var Key: Word; Shift: TShiftState);
