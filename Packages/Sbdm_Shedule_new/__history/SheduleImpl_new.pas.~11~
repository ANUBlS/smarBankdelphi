{$R *.dfm}
   procedure exportproc(S:String);export;
  const
    rsScheludeCaption = '%s № ли мцгавиля цчцн юдямя планы.';
  begin
  form1.Caption := Format(rsScheludeCaption,[Get_SelectedContNo]);
   depositid:=Get_SelectedContID;
   with ScheduleDataModule_new.sbdm_customers do
   begin
     close;
     ClearVariables;
     SetVariable('ID',depositid);
     Open;
   end;
    with ScheduleDataModule_new.OracleDataSet1 do
    begin
     close;
     ClearVariables;
     SetVariable('ID',depositid);
     Open;
   end;
   with  ScheduleDataModule_new.OracleDataSet2 do
   begin
     close;
     ClearVariables;
     SetVariable('id',depositid);
