  function TPCustServiceForm.ExtractMainStatus(const S: string): string;
begin
  if SameText(Copy(S, 1, 5), 'Match') then
    Result := 'Match'
  else if SameText(Copy(S, 1, 5), 'Close') then
    Result := 'Close'
  else if SameText(Copy(S, 1, 8), 'No Match') then
    Result := 'No Match'
  else
    Result := S;
end;


