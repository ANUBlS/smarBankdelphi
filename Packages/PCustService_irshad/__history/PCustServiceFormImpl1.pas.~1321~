  F: TForm;
  L: TLabel;
  BtnYes, BtnNo: TButton;
begin
  F := TForm.Create(nil);
  try
    F.Caption := 'Diqqət!';
    F.Width := 660;
    F.Height := 80;
    F.Position := poScreenCenter;
    F.BorderStyle := bsDialog;

    // --- Qırmızı xəbərdarlıq mətni ---
    L := TLabel.Create(F);
    L.Parent := F;
    L.Caption := AText;
    L.Font.Size := 10;
    L.Font.Color := clRed;
    L.Font.Style := [fsBold];
    L.AutoSize := True;
    L.Left := 30;
    L.Top := 5;

    // --- Bəli düyməsi ---
    BtnYes := TButton.Create(F);
    BtnYes.Parent := F;
    BtnYes.Caption := 'Bəli';
    BtnYes.ModalResult := mrYes;
    BtnYes.Left := 220;
    BtnYes.Top := 30;
    BtnYes.Width := 80;
    BtnYes.Height := 22;

    // --- Xeyr düyməsi ---
    BtnNo := TButton.Create(F);
    BtnNo.Parent := F;
    BtnNo.Caption := 'Xeyr';
    BtnNo.ModalResult := mrNo;
    BtnNo.Left := 320;
    BtnNo.Top := 30;
    BtnNo.Width := 80;
    BtnNo.Height := 22;

    Result := (F.ShowModal = mrYes);
  finally
    F.Free;
  end;
end;

