procedure TFormTransaction3.CurrencyEdit1KeyUp(Sender: TObject; var Key: Word;
  Shift: TShiftState);
var
  deb_rate, kred_rate: Real;
  DebitAmmount, CreditAmmount, LAmmount: Currency;
begin
  with DataModPCustService do
  begin
    if (ODS_AccNO_A.active) and (ODS_AccNO_A.RecordCount <> 0) and
      (not(ODS_AccNO_A.FieldByName('id').IsNull)) and (ODS_AccNO_B.active) and
      (ODS_AccNO_B.RecordCount <> 0) and
      (not(ODS_AccNO_B.FieldByName('id').IsNull)) and
      (CurrencyEdit1.Value > 0) then
    begin
      v_ostat := PG_PCustService.CallFloatFunction('get_rate',
        [-1, ODS_AccNO_A.FieldByName('ID').AsInteger,
        ODS_AccNO_B.FieldByName('ID').AsInteger, '-1', '-1']);
      XFBitBtn5.Enabled := True;

      deb_rate := PG_PCustService.GetParameter(3);
      kred_rate := PG_PCustService.GetParameter(4);

      CurrencyEdit3.Value := (CurrencyEdit1.Value) * deb_rate;
      if deb_rate = kred_rate then
        CurrencyEdit2.Value := CurrencyEdit1.Value
      else
        CurrencyEdit2.Value := (CurrencyEdit3.Value) / kred_rate;
    end
    else
      XFBitBtn5.Enabled := False;
  end;
end;

