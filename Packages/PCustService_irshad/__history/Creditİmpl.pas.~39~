end;

procedure TCreditFrm.XFButton3Click(Sender: TObject);
begin

 LoadPlugin('CU_Paymentcompany.bpl','');

end;

procedure TCreditFrm.XFButton4Click(Sender: TObject);
begin

Paymentcompany:=TPaymentcompany.Create(self);

   Paymentcompany.clientname.Text:=maingrid.DataSource.DataSet.FieldByName('name').AsString;
   Paymentcompany.mainrest.Text:=inttostr(maingrid.DataSource.DataSet.FieldByName('rest').AsInteger);
   Paymentcompany.penaltyam.Text:=inttostr(maingrid.DataSource.DataSet.FieldByName('PENALTYREST').AsInteger);
   Paymentcompany.edit4.Text:=inttostr(maingrid.DataSource.DataSet.FieldByName('gecgun').AsInteger);
   Paymentcompany.edit1.Text:=inttostr(maingrid.DataSource.DataSet.FieldByName('id').AsInteger);
   if maingrid.DataSource.DataSet.FieldByName('prin').AsInteger<>0 then
    Paymentcompany.edit5.Text:=inttostr(maingrid.DataSource.DataSet.FieldByName('prin').AsInteger);

    Paymentcompany.showmodal;



end;

procedure TCreditFrm.XFButton5Click(Sender: TObject);
begin
LoadPlugin('CU_WReport.bpl','AGREE');
end;

procedure TCreditFrm.ReturngoodsClick(Sender: TObject);
begin
  DataModPCustService.SB_ACA.CallProcedure('CheckObjectAccess', ['PCUSTSERVICE','RETURING']);

 DataModPCustService.returng_good.CallProcedure('returng_good',
 [DataModPCustService.CreditDSet.FieldByName('boorowerid').AsInteger,DataModPCustService.CreditDSet.FieldByName('numberofcredit').AsInteger]);

 ShowMessage('Əməliyyat Uğurla Geri qaytarıldı!!!');


