 case ODS_CUSTOMERS_PHYS_FS.FieldByName('cust_type').AsInteger
 {PCustServiceForm.XFRadioGroupCust_type.ItemIndex} of
 0,1,2:begin
  with Dset do
  begin
     a:='in ' + inttostr(PCustServiceForm.XFRadioGroupCust_type.ItemIndex);
       SetVariable('custtype',a);
      end;
  end;

  3:begin
   with Dset do
  begin
    case PCustServiceForm.XFRadioGroup1.ItemIndex of
     -1:x:=10 ;
      0:a:= 'in 1';
      1:a:= 'in 2' ;

    end;
     if x=10 then
      begin
      n:='0,1,2,3,4'  ;
      a:='in ('+n+')';
        SetVariable('custtype',a);
       end else
       begin
      SetVariable('custtype',a);
        end;
       end
      end;
      end;
       end;



