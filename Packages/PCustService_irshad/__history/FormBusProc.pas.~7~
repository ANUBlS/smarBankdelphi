      DataModPCustService.DS_BusProc.DataSet.Locate('ID', Edit2.Text,
        [loPartialKey]);
end;

procedure TForm_busnesProc.Edit2Click(Sender: TObject);
begin
Edit3.Text := '';
end;

procedure TForm_busnesProc.Edit2KeyPress(Sender: TObject; var Key: Char);
begin
if (upcase(Key) < '0') or (upcase(Key) > '9') then
    if (ord(Key) <> 8) then
      Key := #0;
end;

procedure TForm_busnesProc.Edit3Change(Sender: TObject);
