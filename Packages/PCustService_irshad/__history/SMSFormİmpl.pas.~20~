 procedure TSMSForm.createfiles;
var
  formattedDateTime, dir: String;

begin

  if not DirectoryExists(ODS_FilesPathDESCRIPTION.AsWideString) then
    MkDir(ODS_FilesPathDESCRIPTION.AsWideString);

  DateTimeToString(formattedDateTime, 'yyyyddmm', DTP1.Date);
  dir := ODS_FilesPathDESCRIPTION.AsWideString +
    formattedDateTime + '\';

  if not DirectoryExists(dir) then
    MkDir(dir);

  DateTimeToString(formattedDateTime, 'yyyyddmm', DTP1.Date);
  FilePAth := dir+ '.txt';

  AssignFile(f, FilePAth);
  Rewrite(f);
  Closefile(f);
  CreateXmlFile;

end;
