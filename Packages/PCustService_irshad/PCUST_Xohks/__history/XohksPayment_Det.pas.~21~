Function CheckField: Boolean;
    var i : integer;
begin
    if (Trim(FormPayment_Det.Edit_Referens.Text) = '')or
       (FormPayment_Det.Edit_Amount.Value=0)or
       (Trim(FormPayment_Det.Edit_TransCode.Text)='')or
       (FormPayment_Det.Combo_BankName.ItemIndex=-1)or
       (Trim(FormPayment_Det.Edit_BankCode.Text)='')or
       (Trim(FormPayment_Det.Edit_account.Text)='')or
       (Trim(FormPayment_Det.Edit_Voen.Text)='')or
       (Trim(FormPayment_Det.Edit_Account_Sub.Text)='')or
       (Trim(FormPayment_Det.Edit_Bik.Text)='')or
       (Trim(FormPayment_Det.Edit_Client_acc_no.Text)='')or
       (Trim(FormPayment_Det.Edit_Client_Name.Text)='')or
       (Trim(FormPayment_Det.Edit_Client_Voen.Text)='')or
       (Trim(FormPayment_Det.Edit_tey1.Text)='') then begin Result :=  false;MessageDlg('Melumat Tam deyil !',mtWarning,[mbok],0);exit;end else Result:=true;
        with FormPayment_Det do
        for i :=0 to ComponentCount-1 do
        begin
           if Components[i].ClassName =  'TEdit' then
           if ((Components[i] as TEdit).Text<>'') and(
              (Components[i].Name='Edit_tey1')  or
              (Components[i].Name='Edit_tey2')  or
              (Components[i].Name='Edit_tey3')  or
              (Components[i].Name='Edit_tey4')  or
              (Components[i].Name='Edit_inf1')  or
              (Components[i].Name='Edit_inf2')  or
              (Components[i].Name='Edit_inf3'))  then
              if ((Components[i] as TEdit).Text[1] in ['0'..'9','A'..'Z']) then
                  Result:=true
              else
                  begin
                    Result :=  false;
                    MessageDlg('Melumat duzgun deyil !',mtWarning,[mbok],0);
                    exit;
                  end;
        end;
end;

procedure TFormPayment_Det.ButtonFinishClick(Sender: TObject);
var Format:string;
begin
    IF mess_edit then
    begin
    if RB_102T.Checked then Format:='MT102T';
    if RB_102.Checked  then Format:='MT102';
    if (checkfield = false)or(DataModXhoks.XS_BENEFICIARY.fieldbyname('status').AsInteger=2) then exit;
    DataModXhoks.INS.Callprocedure('xs_Beneficiary_update',[    DataModXhoks.XS_BENEFICIARY.fieldbyname('ID').AsInteger,
                                                           strtofloat(Bank_ID.Items[Combo_BankName.itemindex]),
                                                           Edit_Account_Sub.text,
                                                           Edit_Client_acc_no.text,
                                                           edit_client_name.text,
                                                           edit_client_code.text,
                                                           Edit_Client_Voen.text,
                                                           edit_tey1.text+'|'+edit_tey2.text+'|'+edit_tey3.text+'|'+Edit_tey4.Text+'|',
                                                           strtofloat(Edit_TransCode.text),
                                                           edit_inf1.text+'|'+edit_inf2.text+'|'+edit_inf3.text+'|',
                                                           strtofloat(valute_id.items[combo_valute.itemindex]),
                                                           edit_referens.text,
                                                           Edit_Amount.value,
                                                           bnf_count]);
   sboapiDataModule.SBSession.Commit;
   DataModXhoks.INS.Callprocedure('xs_BatchAmount_update',[DataModXhoks.XS_BATCHS.fieldbyname('ID').asinteger]);
   DataModXhoks.INS.Callprocedure('xs_format_update',[DataModXhoks.XS_BATCHS.fieldbyname('ID').asinteger,Format]);
   DataModXhoks.Ins.callprocedure('xs_beneficiary_ChangeStatus',[DataModXhoks.XS_BENEFICIARY.fieldbyname('ID').ASinteger,0]);
   DataModXhoks.Ins.callintegerfunction('xs_Batchs_ChangeStatus',[DataModXhoks.XS_BATCHS.fieldbyname('ID').ASinteger,0]);
   //ButtonFinish.Enabled:=false;
   DataModXhoks.XS_BENEFICIARY.RefreshRecord;
   DataModXhoks.XS_BATCHS.RefreshRecord;
   end
   else
   begin
    if CheckField = false then exit;
    XFBitBtn4.Click;
   end;
   close;

end;

