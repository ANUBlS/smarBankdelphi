               end
            else
              begin
               if DataSource.DataSet.RecordCount <> 0 then
                begin
                Font.Color:=clblack;
                TextOut(Rect.Right-2-
                  Canvas.TextWidth('MT102'),
                  Rect.Top+2,'MT102');
               end;
             end;
          end;
      end;

