 procedure PrepareTrans(BnfCount: integer;EditBeneficiary : Boolean);
 var
 DD:integer;
begin
    {OPEN DATA}
    with DataModXhoks do
    begin
      if XS_CONFIG.Active = false then XS_CONFIG.Open;
     // if DataAccount.Active = false
     // then
     // begin
        DataAccount.close;
       //--- showmessage(inttostr(Tcust_id));
        DataAccount.SetVariable('acc_id',Tcust_id);
       //---- showmessage(DataAccount.SQL.text);
        DataAccount.Open;
    //  end;
     if DataSetFilial.Active = false then DataSetFilial.Open;
    end;
    {VARS}
    FormPayment_Det.bnf_count:=bnfcount;
    {SELF BANK INFO}
    DataModXhoks.DataBankInfo.Close;
    DataModXhoks.DataBankInfo.SQL.Clear;
    DataModXhoks.DataBankInfo.SQL.Add('Select * from BankInfo');
    DataModXhoks.DataBankInfo.Open;
