       FormXohks.Button_add.Enabled:=true;
       Batchs_Edit:=false;
    end else
    begin
       DataModXhoks.DataAccount.Locate('id',DataModXhoks.XS_BATCHS.fieldbyname('acc_id').AsInteger,[]);
       //---FormXohks.AccSearch.Text:=DataModXhoks.DataAccount.fieldbyname('acc_no').AsString;
