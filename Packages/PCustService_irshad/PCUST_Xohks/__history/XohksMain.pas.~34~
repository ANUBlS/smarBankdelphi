 function GetUseDate : TDateTime;
begin
    if DataModXhoks.XS_CONFIG.FieldByName('USEBANKDATE').AsInteger = 1 then
       Result := Trunc(DataModXhoks.GetSysDate.CallDateFunction('GET_DATE',[]))
    else
       Result := Trunc(Date);
end;

function CheckField(all : Boolean): Boolean;
begin
       DataModXhoks.DataCheck.Close;
       DataModXhoks.DataCheck.SQL.Clear;
       DataModXhoks.DataCheck.SQL.Add('Select * from account where acc_no = '''+FormXohks.DBLookupComboBox1.Text+'''');
       DataModXhoks.DataCheck.Open;
    if (Trim(FormXohks.DBLookupComboBox1.Text) = '')    or
       //(Length(TransForm.AccSearch.Text)<16)    or
       (FormXohks.Edit_Client_voen.Text='')     or
       (FormXohks.DBLookupComboBox1.Color=clred)        or
       (Trim(FormXohks.Edit_clientName.Text)='')or
       (DataModXhoks.DataCheck.RecordCount = 0)       then begin Result :=  false;MessageDlg('Melumat Tam deyil !',mtWarning,[mbok],0);end else Result:=true;
       if all then
       if (FormXohks.Edit_Amount.Text='0')      then
       begin
       Result :=  false;
       MessageDlg('Məlumat Tam deyil !',mtWarning,[mbok],0);
       end;

end;


function FindFilialID : Integer;
   var Filial_ID: Integer;
begin
 with FormXohks do
     if DataModXhoks.DataAccount.FieldByName('Filial').AsInteger > 0 then
    begin
       Filial_Id:=DataModXhoks.DataAccount.FieldByName('Filial').AsInteger;
       DataModXhoks.DataSetFilial.SetVariable('FilialID',Filial_Id);
       DataModXhoks.DataSetFilial.Refresh;
       LabelFilialName.Caption:='FİLİAL - '+DataModXhoks.DataSetFilial.fieldbyname('Name').AsString;
       Result:=DataModXhoks.DataSetFilial.fieldbyname('id').AsInteger;
    end
      else
      begin
         LabelFilialName.Caption:='"MƏRKƏZİ OFİS"';
         Result:=0;
      end;
end;

