  SBTranslateProc.TranslateAllComponents(Self,sboapiDataModule.OrPack_SL);
end;

procedure TTransactionReports.Button1Click(Sender: TObject);
const
  sqlvar = 'select p.* from all_provs p where dat=''%s''';
begin
  with DataModuleTrRep, odsRep do begin
    close;
    sql.text := format(sqlvar, [formatdatetime('dd-mmm-yyyy', dtpRep.DateTime)]);
    Filtered := True;
    Filter := '(1=1)';
    if (not cb0.Checked) then Filter := Filter + ' and (optype<>0)';
    if (not cb1.Checked) then Filter := Filter + ' and (optype<>1)';
    if (not cb2.Checked) then Filter := Filter + ' and (optype<>2)';
    //showmessage(Filter);
    open;
    if rgRepType.ItemIndex = 1 then
      qrp1.preview
    else begin
      ExcelExport.Connect;
      ExcelExport.ExportDataset(odsRep,'Rep', True);
    end;
  end;
end;

