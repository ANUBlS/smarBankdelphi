procedure TBalanceRefEditX.BalanceDataSetCalcFields(DataSet: TDataSet);
begin
  Case BalanceDataSetTYPEID.AsInteger of
    1 : BalanceDataSetTYPEID_NAME.Value:= 'Aktiv';
    2 : BalanceDataSetTYPEID_NAME.Value:= 'Passiv';
    3 : BalanceDataSetTYPEID_NAME.Value:= 'Aktiv-Passiv';
  end;

  Case BalanceDataSetADDITIONALTYPEID.AsInteger of
    1 : BalanceDataSetADDITIONALTYPEID_NAME.Value:= 'Aktiv';
    2 : BalanceDataSetADDITIONALTYPEID_NAME.Value:= 'Passiv';
    3 : BalanceDataSetADDITIONALTYPEID_NAME.Value:= 'Aktiv-Passiv';
  end;

  Case BalanceDataSetRATEDIFFERENCE.AsInteger of
    0 : BalanceDataSetRATEDIFFERENCE_NAME.Value:= 'Hesablanmır';
    1 : BalanceDataSetRATEDIFFERENCE_NAME.Value:= 'Hesablanır';
  end;

  Case BalanceDataSetSALDO.AsInteger of
    0 : BalanceDataSetSALDO_NAME.Value:= 'Nəzərə alınmır';
    1 : BalanceDataSetSALDO_NAME.Value:= 'Nəzərə alınır';
  end;

  case BalanceDataSetCURRENCYPOSITION.AsInteger of
      0:BalanceDataSetCURRENCYPOSITION_NAME.Value:= 'Heç birində';
      1:BalanceDataSetCURRENCYPOSITION_NAME.Value:= 'Aktivlərdə';
      2:BalanceDataSetCURRENCYPOSITION_NAME.Value:= 'Passivlərdə';
      3:BalanceDataSetCURRENCYPOSITION_NAME.Value:= 'Hər birində';
  end;

  Case BalanceDataSetCUST_TYPE.AsInteger of
    0 : BalanceDataSetCUST_TYPE_NAME.Value:= 'Hüquqi şəxslər';
    1 : BalanceDataSetCUST_TYPE_NAME.Value:= 'Fiziki şəxslər';
    2 : BalanceDataSetCUST_TYPE_NAME.Value:= 'Fiziki sahibkarlar';
    3 : BalanceDataSetCUST_TYPE_NAME.Value:= 'Fiziki şəxs və sahibkar';
    5 : BalanceDataSetCUST_TYPE_NAME.Value:= 'Bütün';

  end;

  Case BalanceDataSetINTER_VALUTE.AsInteger of
    0 : BalanceDataSetInter_Val_Name.Value:= 'Milli valyuta';
    1 : BalanceDataSetInter_Val_Name.Value:= 'Xarici valyuta';
    2 : BalanceDataSetInter_Val_Name.Value:= 'Qiymətli metallar';
  end;

  Case BalanceDataSetRESIDENT.AsInteger of
    0 : BalanceDataSetRESIDENT_Name.Value:= 'Qeyri Rezident';
    1 : BalanceDataSetRESIDENT_Name.Value:= 'Rezident';

  end;

  Case BalanceDataSetGOVERNMENT.AsInteger of
    0 : BalanceDataSetGOVERNMENT_Name.Value:= 'Dövlət';
    1 : BalanceDataSetGOVERNMENT_Name.Value:= 'Özəl';
  end;

  case BalanceDataSetPERIOD.AsInteger of

  1:   BalanceDataSetcr_period.Value:='Uzun müddətli kredit';
  2:   BalanceDataSetcr_period.Value:='Qısa müddətli kredit';
  else
   BalanceDataSetcr_period.Value:='yox';
  end;



// ComboBoxTYPEID_NAME.ItemIndex := BalanceDataSetTYPEID.asinteger-1;
end;

