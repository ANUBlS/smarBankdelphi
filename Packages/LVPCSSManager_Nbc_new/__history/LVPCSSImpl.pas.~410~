procedure TLVPCSSForm.DeletingExecute(Sender: TObject);
var
   Index :Integer;
   WaitNextConfirm, WillRefresh: Boolean;
   TransactionID :Integer;
begin


  WaitNextConfirm :=True;
  WillRefresh :=False;
  if bngrid.CanFocus then
  bngrid.SetFocus;

  //Focus;
  with  bngrid, SelectedRows, DataSource.DataSet, DataMod do
  try
    if Count = 0 then CurrentRowSelected := True;
    for  Index :=0 to  Count - 1 do
    begin
      GotoBookmark(Pointer(Items[Index]));
      TransactionID :=FieldbyName('ID').AsInteger;

      if  WaitNextConfirm  then
      case MessageDlg(
        Format('Əməliyyatlar #%d silinsinmi?',[TransactionID])
       ,mtConfirmation
       ,[mbYes, mbNo ,mbCancel ,mbYesToAll]
       ,0
       )   of
        mrNo       : Continue;
        mrCancel   : Break;
        mrYesToAll :
          if MessageDlg(Format('%d  sayda əməliyyat silinsinmi ?', [Count - Index]), mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
           WaitNextConfirm :=False
          else
           Continue;
      end;
      Application.ProcessMessages;
      //DeleteTransaction(TransactionID);
      datamod.bn_package.CallProcedure('bn_delete',[bngrid.DataSource.DataSet.fieldbyName('id').asinteger]);
      WillRefresh :=True;


    end;
  finally
   if WillRefresh then
   bngrid.DataSource.DataSet.refresh;
    //ActionRefreshExecute(Sender);
  end;
  sboapiDataModule.SBSession.Commit;
end;



