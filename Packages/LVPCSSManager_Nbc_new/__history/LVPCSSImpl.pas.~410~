procedure TLVPCSSForm.bngridKeyUp(Sender: TObject; var Key: Word;
  Shift: TShiftState);
  var c:string;
  begin
 begin
if ssCtrl in Shift then begin
    C:= LowerCase(Char(Key));
    if C = 'a' then begin
     with bngrid.datasource.dataset do
     begin
        disableControls;
        first;
        while not(eof) do
           begin
            bngrid.SelectedRows.CurrentRowSelected:=true;
            next;
           end;
        enableControls;
     end;

    end;
    end;

  end;




end;

