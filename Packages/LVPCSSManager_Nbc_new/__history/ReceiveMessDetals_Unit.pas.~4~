{$R *.DFM}

procedure TRecMessDet_Form.FormShow(Sender: TObject);
begin
  edit1.Clear;
  SearchEdit1.Clear;
  SearchEdit2.Clear;
  DBEdit3.Clear;
  DBEdit8.Clear;
  SearchEdit1.SetFocus;



end;

procedure TRecMessDet_Form.Button2Click(Sender: TObject);
begin
   close;
end;

procedure TRecMessDet_Form.Edit1Change(Sender: TObject);
begin

 DataMod.DataAccount.close;
 DataMod.DataAccount.SetVariable('acc',edit1.Text);
   DataMod.DataAccount.open;


end;

procedure TRecMessDet_Form.Button1Click(Sender: TObject);
begin
  if (trim(SearchEdit1.Text)='')or(SearchEdit2.Color=clred) then exit;
  if  (DataMod.XS_IncomingView.fieldbyname('trans_date').AsDateTime <> GetUseDate)and
      (DataMod.XS_IncomingView.fieldbyname('trans_date').AsDateTime <> DataMod.GetSysDate.CallDateFunction('Get_Date',[]))
  then
  begin
    MessageDlg(Format('Əməliyyat #%d deyişdirilə bilməz!',[DataMod.XS_IncomingView.fieldbyname('id').AsInteger]), mtWarning,[mbOk], 0);
    Exit;
  end;

  {CHECK VALUTE}
  case MessageDlg('Əməliyyat #'+DataMod.XS_IncomingView.fieldbyname('id').AsString+' dəyişdirilsinmi ?', mtConfirmation,[mbyes,mbno], 0) of

       mryes :begin DataMod.INS.CallProcedure('xs_Incoming_update',
                                                 [
                                                 DataMod.XS_IncomingView.fieldbyname('id').asinteger,
                                                 DataMod.DataAccount.fieldbyname('id').asinteger,
                                                 DataMod.DataAccount.fieldbyname('acc_no').asstring
                                                 ]);
              DataMod.Ins.callprocedure('xs_incoming_ChangeStatus',[DataMod.XS_IncomingView.fieldbyname('ID').ASinteger,0]);
              //LVPCSSForm.RefreshMessinWithPos;
              DataMod.XS_IncomingView.Refresh;
              close;
              end;
       mrno :Exit;
  end;
end;

procedure TRecMessDet_Form.FormKeyUp(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
   if key = Vk_escape then close;
end;

procedure TRecMessDet_Form.FormConstrainedResize(Sender: TObject;
  var MinWidth, MinHeight, MaxWidth, MaxHeight: Integer);
begin
   MinWidth:=630;
   MinHeight:=310;
end;

