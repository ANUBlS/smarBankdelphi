procedure Tverify.Button1Click(Sender: TObject);
var RespText,cardtype,descp,valyuta,cardnumber,vcardtype,pcardnumber,valyutaname,descript,resp,ufxrrn  :string;
v_transamount,transamount :integer;
begin

if DataMod.XS_BATCHS.fieldbyname('format').AsString<>'MT996' then
begin
IF (DataMod.XS_BATCHS.fieldbyname('status').AsInteger=1) or
(DataMod.XS_BATCHS.fieldbyname('status').AsInteger=8)

    THEN
 BEGIN
 edit3.Enabled:=false;
 edit3.Text:='0';
 //ShowMessage(DBEdit4.Text);
 //showmessage(edit2.Text);

       if edit1.Text=Edit2.Text then
     begin
      //ShowMessage('noa');


        if DataMod.card.CallIntegerFunction('CardCheck',[dbedit4.Text,0])>0 then
         begin
             if DataMod.card.CallFloatFunction('UfxCheck',[dbedit4.Text])=0 then
            begin    //ufxsend;
             DataMod.card.CallProcedure('Ufx_send',[dbedit4.Text,0,vcardtype,pcardnumber,valyutaname,transamount,descript]) ;
             v_transamount:=DataMod.card.GetParameter(5);
             cardnumber:= DataMod.card.GetParameter(3);
             cardtype:=  DataMod.card.GetParameter(2);
             descp:= DataMod.card.GetParameter(6);
             valyuta:=DataMod.card.GetParameter(4) ;

               // resp:='wewe232323#Successfully processed';
             // ShowMessage('y');
             resp:=UFX71.GetUFX7.fundstransfer(cardnumber,cardtype,FormatDateTime('YYYY-MM-DD hh:mm:ss',now),descp,valyuta,inttostr(v_transamount)) ;


             ufxrrn:=copy (resp,0,pos('#',resp));

             RespText:= copy (resp,pos('#',resp)+1,length(resp));
               // ShowMessage(  resp);
                DataMod.card.callprocedure('UfxResponse',[dbedit4.Text,0,RespText,v_transamount,resp]) ;

                 if UPPERCASE(VarToStr(RespText))=UPPERCASE('Successfully processed')
             then
               begin
                 ShowMessage('Əməliyyat uğurla keçdi!!!');
                 DataMod.Ins.CallProcedure('xs_Batchs_VerifStatus',[dbedit4.Text]);
                 DataMod.Ins.CallProcedure('xs_beneficiary_VerifStatus',[dbedit4.Text]);
               end
             else
               begin
                 ShowMessage('Əməliyyat keçmədi!!!'+','+'Səhvin adı:'+VarToStr(RespText));
                 Exit;
               end;

            end
            else
            begin
              DataMod.Ins.CallProcedure('xs_Batchs_VerifStatus',[dbedit4.Text]);
             DataMod.Ins.CallProcedure('xs_beneficiary_VerifStatus',[dbedit4.Text]);
            end;
          end
          else
          begin
            DataMod.Ins.CallProcedure('xs_Batchs_VerifStatus',[dbedit4.Text]);
            DataMod.Ins.CallProcedure('xs_beneficiary_VerifStatus',[dbedit4.Text]);
          end;

      DataMod.XS_BATCHS.RefreshRecord;
         DataMod.XS_BENEFICIARY.Refresh;
       //  DataMod.XS_BATCHS.Locate('ID',DataMod.XS_BATCHS.fieldbyname('id').AsInteger,[])  ;
     END
   else
  begin
      // ShowMessage('aa');
       DataMod.Ins.CallProcedure('xs_batchs_error',[dbedit4.Text]);
       DataMod.XS_BATCHS.RefreshRecord;
         DataMod.XS_BENEFICIARY.Refresh;
     //   DataMod.XS_BATCHS.Locate('ID',dbedit4.Text,[])
  end;
       close;

 end;


end else begin
  IF (DataMod.XS_BATCHS.fieldbyname('status').AsInteger=1) or
(DataMod.XS_BATCHS.fieldbyname('status').AsInteger=8)

    THEN
 BEGIN

 //ShowMessage(edit1.Text);
 //showmessage(edit2.Text);

       if (edit1.Text=Edit2.Text)  and (edit3.Text=edit4.Text)then
     begin
      //ShowMessage('noa');
       DataMod.Ins.CallProcedure('xs_Batchs_VerifStatus',[dbedit4.Text]);
        DataMod.Ins.CallProcedure('xs_beneficiary_VerifStatus',[dbedit4.Text]);
      DataMod.XS_BATCHS.RefreshRecord;
         DataMod.XS_BENEFICIARY.Refresh;
       // DataMod.XS_BATCHS.Locate('ID',dbedit4.Text,[])
     END
   else
  begin
      // ShowMessage('aa');
       DataMod.Ins.CallProcedure('xs_batchs_error',[dbedit4.Text]);
       DataMod.XS_BATCHS.RefreshRecord;
         DataMod.XS_BENEFICIARY.Refresh;
      //  DataMod.XS_BATCHS.Locate('ID',dbedit4.Text,[])
  end;
       close;
 end;


end;




end;

