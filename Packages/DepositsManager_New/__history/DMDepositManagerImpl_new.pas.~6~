implementation

{$R *.dfm}
  uses sboapiDataModuleImpl;
procedure TDMDepositsManager_new.DataModuleCreate(Sender: TObject);
begin
  with  DepositsData do
  begin
    SetVariable('OrderField','cont.id');
    Open;
  end;

   BankDate.Open;
   FilialID.Open;
   Valutes.Open;
   Filials.Open;
   DepositTypes.Open;
   Categories.Open;
   persons.Open;
   users.Open;
   Tranches.Open;
end;

procedure TDMDepositsManager_new.DataModuleDestroy(Sender: TObject);
begin
   DepositsData.CloseAll;
   BankDate.Open;
   FilialID.Open;
   Valutes.CloseAll;
   Filials.CloseAll;
   DepositTypes.CloseAll;
   Categories.CloseAll;
   persons.CloseAll;
   users.CloseAll;
   Tranches.CloseAll;
end;

procedure TDMDepositsManager_new.DepositsDataBeforePost(DataSet: TDataSet);
begin
DMDepositsManager_new.DepositsData.Cancel;
end;

end.
