		</PropertyGroup>
		<PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_2)'!=''">
			<Cfg_2>true</Cfg_2>
			<CfgParent>Base</CfgParent>
			<Base>true</Base>
		</PropertyGroup>
		<PropertyGroup Condition="'$(Base)'!=''">
			<DCC_ImageBase>00400000</DCC_ImageBase>
			<DCC_DependencyCheckOutputName>..\..\..\Bin\MFTransactions.bpl</DCC_DependencyCheckOutputName>
			<DCC_WriteableConstants>true</DCC_WriteableConstants>
			<DCC_UsePackage>Vcl50;Vclx50;VclSmp50;Vcldb50;vclado50;ibevnt50;Vclbde50;vcldbx50;Qrpt50;TeeUI50;TeeDB50;Tee50;Dss50;TeeQR50;VCLIB50;Vclmid50;vclie50;Inetdb50;Inet50;NMFast50;webmid50;dclocx50;dclaxserver50</DCC_UsePackage>
			<RuntimeOnlyPackage>true</RuntimeOnlyPackage>
			<DCC_UnitAlias>WinTypes=Windows;WinProcs=Windows;DbiTypes=BDE;DbiProcs=BDE;DbiErrs=BDE;WinTypes=Windows;WinProcs=Windows;$(DCC_UnitAlias)</DCC_UnitAlias>
			<DCC_BplOutput>\Smart-Bank\Bin</DCC_BplOutput>
			<DCC_UnitSearchPath>$(DELPHI)\Source\Toolsapi;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
			<DCC_Platform>x86</DCC_Platform>
			<DCC_S>false</DCC_S>
			<DCC_N>true</DCC_N>
			<GenDll>true</GenDll>
			<DCC_OutputNeverBuildDcps>true</DCC_OutputNeverBuildDcps>
			<DCC_K>false</DCC_K>
			<DCC_DcuOutput>$(DELPHI)\lib</DCC_DcuOutput>
			<GenPackage>true</GenPackage>
			<DCC_F>false</DCC_F>
			<DCC_E>false</DCC_E>
		</PropertyGroup>
		<PropertyGroup Condition="'$(Cfg_1)'!=''">
			<DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
			<DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
			<DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
			<DCC_DebugInformation>false</DCC_DebugInformation>
		</PropertyGroup>
		<PropertyGroup Condition="'$(Cfg_2)'!=''">
			<DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
		</PropertyGroup>
		<ItemGroup>
			<DelphiCompile Include="MFTransactions.dpk">
				<MainSource>MainSource</MainSource>
			</DelphiCompile>
			<DCCReference Include="vcl.dcp"/>
			<DCCReference Include="Vcldb.dcp"/>
			<DCCReference Include="doa41dXE.dcp"/>
			<DCCReference Include="sboapi50.dcp"/>
			<DCCReference Include="UntMainTransactions.pas">
				<Form>FrmTransactions</Form>
			</DCCReference>
			<BuildConfiguration Include="Debug">
				<Key>Cfg_2</Key>
				<CfgParent>Base</CfgParent>
