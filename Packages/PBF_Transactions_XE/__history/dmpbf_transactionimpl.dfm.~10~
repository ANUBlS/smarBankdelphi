  object PBFTransactions: TOracleDataSet
    SQL.Strings = (
      'SELECT'
      
        '  po.id as num,po.name as opname,po.fromfilialtofilial as fromfi' +
        'ltofil,po.paymentno,'
      '  p.ID,po.username,po.clientaccid,PO.operationtype AS optype,'
      '  p.dat as TransactionDate,'
      '  ad.ACC_NO as DebitAccNo,ad.filial as debitfilial,'
      '  dc.val_name as DebitCurrencySName,'
      '  ac.ACC_NO as CreditAccNo,ac.filial as creditfilial,'
      '  cc.val_name as CreditCurrencySName,'
      '  p.ammount as DebitAmount,'
      '  p.Ammount_C as CreditAmount,'
      '  p.LAmmount as LAmount,'
      '  p.Name,p.VAL_ACC,'
      '  0 as status'
      'FROM'
      '    account ad,'
      '    account ac,'
      '    avalute dc,'
      '    avalute cc,'
      '    LAZYTRANSACTION p,'
      '    pbf_operations po,'
      '    pbf_transactions pt'
      'where'
      '    p.dat =:TransactionDate'
      '    and (ad.ID = p.DEBT)'
      '    and (ac.ID = p.KREDIT)'
      '    and (ad.val_acc = p.val_acc)'
      '    and (ac.val_acc = p.CurrencyID_C)'
      '    and (dc.VALUTE = p.val_acc)'
      '    and (cc.VALUTE = p.CurrencyID_C)'
      '    and ((P.OP_ID<>-1 and'
      
        '          not EXISTS(select SUSER from sba_userman where MUSER=u' +
        'id and (type#=1 or type#=0)))'
      '          or'
      
        '          (P.OP_ID in(select SUSER from sba_userman where MUSER=' +
        'uid and (type#=1 or type#=0))))'
      '    and po.id = pt.operid '
      '    and p.id = pt.TRANSACTIONID '
      '    and pt.hdate = :TransactionDate'
      ''
      'union'
      ''
      ''
      'SELECT'
      
        '  po.id as num,po.name as opname,po.fromfilialtofilial as fromfi' +
        'ltofil,po.paymentno,'
      '  p.ID,po.username,po.clientaccid,PO.operationtype AS optype,'
      '  p.dat as TransactionDate,'
      '  ad.ACC_NO as DebitAccNo,ad.filial as debitfilial,'
      '  dc.val_name as DebitCurrencySName,'
      '  ac.ACC_NO as CreditAccNo,ac.filial as creditfilial,'
      '  cc.val_name as CreditCurrencySName,'
      '  p.ammount as DebitAmount,'
      '  p.Ammount_C as CreditAmount,'
      '  p.LAmmount as LAmount,'
      '  p.Name,p.VAL_ACC,'
      '  1 as status'
      'FROM'
      '    account ad,'
      '    account ac,'
      '    avalute dc,'
      '    avalute cc,'
      '    provarch p,'
      '    pbf_operations po,'
      '    pbf_transactions pt'
      'where'
      '    p.dat =:TransactionDate'
      '    and (ad.ID = p.DEBT)'
      '    and (ac.ID = p.KREDIT)'
      '    and (ad.val_acc = p.val_acc)'
      '    and (ac.val_acc = p.CurrencyID_C)'
      '    and (dc.VALUTE = p.val_acc)'
      '    and (cc.VALUTE = p.CurrencyID_C)'
      '    and ((P.OP_ID<>-1 and'
      
        '          not EXISTS(select SUSER from sba_userman where MUSER=u' +
        'id and (type#=1 or type#=0)))'
      '          or'
      
        '          (P.OP_ID in(select SUSER from sba_userman where MUSER=' +
        'uid and (type#=1 or type#=0))))'
      '    and po.id = pt.operid '
      '    and p.id = pt.TRANSACTIONID '
      '    and pt.hdate = :TransactionDate'
      ''
      '--order by :orderfield'
      '')
    Optimize = False
