unit FrmpbfFilialsUsersImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  ExtCtrls, DBCtrls, ComCtrls, Grids, DBGridEh, Db, OracleData;

type
  TFrmpbfFilialsUsers = class(TForm)
    pbfusersds: TDataSource;
    DBGridEh1: TDBGridEh;
    StatusBar1: TStatusBar;
    DBNavigator1: TDBNavigator;
    pbfusers: TOracleDataSet;
    pbfusersID: TFloatField;
    pbfusersFILIAL: TFloatField;
    pbfusersUSERID: TWideStringField;
    allF: TOracleDataSet;
    allu: TOracleDataSet;
    allFID: TFloatField;
    allFNAME: TWideStringField;
    alluID: TFloatField;
    alluNAME: TWideStringField;
    pbfusersfilialname: TWideStringField;
    pbfusersusername: TWideStringField;
    procedure FormCanResize(Sender: TObject; var NewWidth,
      NewHeight: Integer; var Resize: Boolean);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FrmpbfFilialsUsers: TFrmpbfFilialsUsers;

implementation

{$R *.DFM}
uses sboapiDataModuleImpl,sboapiDataModuleImpl;

procedure TFrmpbfFilialsUsers.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize := false
end;

procedure TFrmpbfFilialsUsers.FormKeyPress(Sender: TObject; var Key: Char);
begin
   if ord(key) =  vk_escape then close
end;

procedure TFrmpbfFilialsUsers.FormCreate(Sender: TObject);
begin
   allF.open;
   allu.open;
   pbfusers.open;
   SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

end.
