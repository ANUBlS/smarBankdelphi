package NewDepositsContract;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  CMVCL50,
  DclEhlib150,
  sboapi50,
  SBTranslate,
  vcl,
  doa41dXE,
  NewDepositsCommon,
  VCLXFiles150;

contains
  NewContractCommonDecls in 'NewContractCommonDecls.pas',
  NewDepositsContractImpl in 'NewDepositsContractImpl.pas' {NewDataModDepositsContract: TDataModule},
  NewFormDepositContractImpl in 'NewFormDepositContractImpl.pas' {NewFormDepositContract};

end.
