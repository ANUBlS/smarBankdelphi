procedure Tfrmpbf_transaction.MainGridPBFDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumnEh;
  State: TGridDrawState);
var
  ImageIndex: Integer;
begin
 ImageIndex := -1;
  with (Sender as TDBGridEh) do
  begin
    if DataSource.DataSet.RecordCount <> 0 then
    begin
      case DataSource.DataSet.FieldByName('Status').AsInteger of
      1:
        ImageIndex := 0;
      0:
        ImageIndex := 1;
      else
      end;
      if (DataCol = 1) and (ImageIndex <> -1) then
        ImageList1.Draw(Canvas, Rect.Left, Rect.Top, ImageIndex, True)
      else
        DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;
  end;
end;

