procedure Tfrmpbf_transaction.ActnPrintExecute(Sender: TObject);
var AType,AType1,Desc ,Str,str1,str2 :String;
begin
  //frmpbfPayRepNum.showmodal;
   with dmpbf_transaction,PBFReportDs do
   begin
      
      if PBFTransactions.fieldbyname('optype').AsString = 'KREDIT' then
      begin
      str1 := '(select BANK as re_BANK,KOD_B as re_KOD_B,INN as re_inn,to_char(KRNO) as re_KRNO,SWIFT as re_SWIFT, null as rc_inn';
      str2:=' ,PBF_TRANSACTION.get_rcname(:clientaccid) as rc_name,PBF_TRANSACTION.get_rcaccno(:clientaccid,:acctype) as rc_account  from filialinfo b where kod_fil = PBF_TRANSACTION.get_filialCode(:clientaccid,null) )b,';
      end
      else
      begin
      str1 := '(SELECT  a.re_bank, a.re_kod_b, a.re_inn, a.re_krno,a.re_swift, a.rc_name, decode(PBF_TRANSACTION.get_filialCode(null,:usr),0,a.rc_account1,a.rc_account) as rc_account, a.rc_inn  FROM ';
      str2 := ' pbf_beneficiars a where OPERTYPE = '+''''+PBFTransactions.fieldbyname('optype').AsString+''''+'),';
      end;

      str := str1 + str2;
      if Active then CloseAll;

      DeleteVariables;
      //DeleteVariable('ACCTYPE');
      //DeleteVariable('ACCTYPE1');

      DeclareVariable('clientaccid',otinteger);
      DeclareVariable('opid',otinteger);
      DeclareVariable('usr',otString);
      SetVariable('opid',PBFTransactions.fieldbyname('num').AsInteger);
      SetVariable('clientaccid',PBFTransactions.fieldbyname('clientaccid').AsInteger);
      SetVariable('usr',PBFTransactions.fieldbyname('username').AsString);
      AType := '45'+PBFTransactions.fieldbyname('optype').AsString+'ACC';
      if PBFTransactions.fieldbyname('optype').AsString = 'KREDIT' then AType1 := '45ACCOUNT' else atype1 := AType;
      if PBFTransactions.fieldbyname('optype').AsString = 'KREDIT' then begin
      DeclareVariable('ACCTYPE',otString);
      SetVariable('ACCTYPE',AType);
      DeclareVariable('ACCTYPE1',otString);
      SetVariable('acctype1',AType1);
      end;
      if PBFTransactions.fieldbyname('optype').AsString <> 'KREDIT' then  begin
      DeclareVariable('ACCTYPE1',otString);
      SetVariable('acctype1',AType1);
      end;
      sql[11] := str; Memo1.text := sql.text;
      memo2.text := 'AType1 = '+AType1+' clientaccid  = '+PBFTransactions.fieldbyname('clientaccid').Asstring+' opid='+PBFTransactions.fieldbyname('num').Asstring;
      open;

      if  PBFTransactions.fieldbyname('optype').AsString = 'KREDIT' then Desc := 'Kredit ödənişi' ;
      if  PBFTransactions.fieldbyname('optype').AsString = 'GAS' then desc := 'Qaz ödənişi';
      if  PBFTransactions.fieldbyname('optype').AsString = 'AZERCELL' then desc := 'AZERCELL ödənişi';
      if  PBFTransactions.fieldbyname('optype').AsString = 'BAKCELL' then desc :=  'BAKCELL ödənişi';
      if  PBFTransactions.fieldbyname('optype').AsString = 'NAR' then desc :=  'NAR ödənişi';
      if  PBFTransactions.fieldbyname('optype').AsString = 'WATER' then desc :=  'Su ödənişi';
      if  PBFTransactions.fieldbyname('optype').AsString = 'LIGHT' then desc :=  'Elektrik ödənişi';
      if  PBFTransactions.fieldbyname('optype').AsString = 'SUMLIGHT' then desc :=  'Sumqayıt elektrik ödənişi';

      PBFDesc.CloseAll;
      PBFDesc.SetVariable('n',PBFTransactions.fieldbyname('optype').AsString);
      PBFDesc.open;
      desc := PBFDesc.fieldbyname('description').AsString;

      if PBFTransactions.fieldbyname('optype').AsString = 'KREDIT' then
      desc := PBFTransactions.fieldbyname('TRANSACTIONDATE').AsString+' -tarixində '+
      PBFTransactions.fieldbyname('FROMFILTOFIL').AsString +' '+ desc;

      if PBFTransactions.fieldbyname('optype').AsString <> 'KREDIT' then
      desc := PBFTransactions.fieldbyname('TRANSACTIONDATE').AsString+' -тарихиндя '+desc;

      with frmpbfReport do begin
      QRLabel1.caption := Desc;
      QRAmmountW.Caption := WithCoin(PBFTransactions.fieldbyname('DEBITAMOUNT').AsString,fieldbyname('VALUTE').asString);
      QRAmmount.Caption := PBFTransactions.fieldbyname('DEBITAMOUNT').AsString;
      QRDate.Caption := FormatDateTime('dd-mmm-yyyy', DTPCurrentDate.DateTime);
      QRLabel3.Caption := PBFTransactions.fieldbyname('opname').AsString;
      Preview;
      end;

   end;
