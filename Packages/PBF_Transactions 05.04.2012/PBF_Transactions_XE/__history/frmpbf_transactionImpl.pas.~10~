procedure Tfrmpbf_transaction.EditPBFOPExecute(Sender: TObject);
var c,i :integer;
begin
   with dmpbf_transaction,PBFOperations do begin
        if active then CloseAll;
        SetVariable('OID',PBFTransactions.FieldByName('num').AsInteger);
        Open;
        EDIT;
        if PBFTransactions.fieldbyname('optype').AsString = 'KREDIT' then
        frmAddEditTr.ShowModal else begin
        with frmOtherOperations do
        for i := 0 to ComboBox1.Items.Count-1 do
        if frmOtherOperations.ComboBox1.Items[i] = PBFTransactions.fieldbyname('OPNAME').AsString
        then frmOtherOperations.ComboBox1.ItemIndex :=i;
        
        frmOtherOperations.ShowModal;
        end;
        RefreshPBFOPExecute(Sender);
   end;
end;

procedure Tfrmpbf_transaction.RefreshPBFOPExecute(Sender: TObject);
var
    SaveID :Integer;
    Dat :TdateTime;
begin

   MainGridPBF.SelectedRows.Clear;
   dat := integer(trunc(DTPCurrentDate.DateTime));
   with dmpbf_transaction,PBFTransactions do
   begin
      SaveID := FieldbyName('ID').AsInteger;
      close;
      SetVariable('TransactionDate',dat);
      SetVariable('orderfield','id');
      open;
      Locate('ID',SaveID,[]);
   end;
end;

