unit frmOtherOperationsImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, Mask, DBCtrlsEh, Buttons, ComCtrls, Db, OracleData;

type
  TfrmOtherOperations = class(TForm)
    Label1: TLabel;
    Label2: TLabel;
    ComboBox1: TComboBox;
    DBEditEh1: TDBEditEh;
    BitBtn1: TBitBtn;
    BitBtn2: TBitBtn;
    Label4: TLabel;
    DateTimePicker1: TDateTimePicker;
    OPTypes: TOracleDataSet;
    OPTypesNAME: TStringField;
    procedure ComboBox1Change(Sender: TObject);
    procedure BitBtn1Click(Sender: TObject);
    procedure BitBtn2Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmOtherOperations: TfrmOtherOperations;

implementation

uses dmpbf_transactionimpl, sboapiDataModuleImpl;;

{$R *.DFM}

procedure TfrmOtherOperations.ComboBox1Change(Sender: TObject);
begin
   with dmpbf_transaction,PBFOperations do
        fieldbyname('name').asString := ComboBox1.text;
end;

procedure TfrmOtherOperations.BitBtn1Click(Sender: TObject);
begin
   with dmpbf_transaction,PBFOperations do
        Post;
        Close;

end;

procedure TfrmOtherOperations.BitBtn2Click(Sender: TObject);
begin
   with dmpbf_transaction,PBFOperations do
        Cancel;
end;

end.
