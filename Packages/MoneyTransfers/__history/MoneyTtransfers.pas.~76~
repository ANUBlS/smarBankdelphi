procedure TMoneyTransfers.Button1Click(Sender: TObject);
begin
  With ODSMoneyTransfer do
  begin
    Close;
    SetVariable('bdat',Bdate.DateTime);
    SetVariable('edat',Edate.DateTime);
    if not(CheckBox1.Checked and Evanescence1.Checked[0] and Evanescence1.Checked[1]) then begin SQL[110] :='WHERE Transfertypeid = -1'; end;
    if not(CheckBox1.Checked) and Evanescence1.Checked[0] then begin SQL[110] :='WHERE Transfertypeid = 133'; end;
    if not(CheckBox1.Checked) and Evanescence1.Checked[1] then begin SQL[110] :='WHERE Transfertypeid = 78'; end;
    if CheckBox1.Checked and Evanescence1.Checked[0] and Evanescence1.Checked[1] then begin SQL[110]:='WHERE Transfertypeid in(78,133)'; end;
    Open;
  end;
end;

procedure TMoneyTransfers.CheckBox1Click(Sender: TObject);
