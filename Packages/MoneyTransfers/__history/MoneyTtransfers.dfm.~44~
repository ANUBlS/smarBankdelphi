  object ODSMoneyTransfer: TOracleDataSet
    SQL.Strings = (
      'select * from ('
      'SELECT '
      '  '#39'M'#399'DAX'#304'L'#39' operationtype,'
      '  '#39'Xarici '#214'lk'#601'd'#601'n M'#601'daxil'#39' name,   '
      '   C.NEREZIDENT,      '
      '   133 id,'
      
        '  (CASE WHEN C.CUST_TYPE in(1,4)      THEN '#39'F'#304'Z'#304'K'#304#39' ELSE '#39'H'#220'QUQ'#304 +
        #39' END) AS custtype,'
      
        '  (CASE WHEN C.CUST_TYPE in(1,4)      THEN 1 ELSE 0 END) AS cust' +
        'typeid,'
      
        '  (CASE WHEN C.NEREZIDENT=1           THEN '#39'REZIDENT'#39' ELSE '#39'QEYR' +
        #304'REZIDENT'#39' END) AS rezident,'
      
        '  (CASE WHEN E.id in(1,2)             THEN '#39'Mallar'#305'n ixrac'#305' '#252'zr'#601 +
        #39' ELSE E.NAME END) AS Transfertype,'
      
        '  (CASE WHEN E.id in(1,2)             THEN -1  ELSE E.id END) AS' +
        ' Transfertypeid,'
      
        '  sum (CASE WHEN T.VAL_COD=0          THEN T.AMOUNT  ELSE 0 END)' +
        ' AS AZN,'
      
        '  sum (CASE WHEN T.VAL_COD=1          THEN T.AMOUNT  ELSE 0 END)' +
        ' AS USD,'
      
        '  sum (CASE WHEN T.VAL_COD=1          THEN round(T.AMOUNT*O.osta' +
        't,2)  ELSE 0 END) AS USDEKV,'
      
        '  sum (CASE WHEN T.VAL_COD=45         THEN T.AMOUNT  ELSE 0 END)' +
        ' AS EUR,'
      
        '  sum (CASE WHEN T.VAL_COD=45         THEN round(T.AMOUNT*O.osta' +
        't,2)  ELSE 0 END) AS EUREKV,'
      
        '  sum (CASE WHEN T.VAL_COD=50         THEN T.AMOUNT  ELSE 0 END)' +
        ' AS GBP,'
      
        '  sum (CASE WHEN T.VAL_COD=50         THEN round(T.AMOUNT*O.osta' +
        't,2)  ELSE 0 END) AS GBPEKV,'
      
        '  sum (CASE WHEN T.VAL_COD=792        THEN T.AMOUNT  ELSE 0 END)' +
        ' AS TRY,'
      
        '  sum (CASE WHEN T.VAL_COD=792        THEN round(T.AMOUNT*O.osta' +
        't,2) ELSE 0 END) AS TRYEKV, '
      
        '  sum (CASE WHEN T.VAL_COD=48         THEN T.AMOUNT  ELSE 0 END)' +
        ' AS RUR,'
      
        '  sum (CASE WHEN T.VAL_COD=48         THEN round(T.AMOUNT*O.osta' +
        't,2)  ELSE 0 END) AS RUREKV,'
      
        '  sum (CASE WHEN T.VAL_COD=981        THEN T.AMOUNT  ELSE 0 END)' +
        ' AS GEL,'
      
        '  sum (CASE WHEN T.VAL_COD=981        THEN round(T.AMOUNT*O.osta' +
        't,2) ELSE 0 END) AS GELEKV,'
      
        '  sum (CASE WHEN T.VAL_COD=784        THEN T.AMOUNT  ELSE 0 END)' +
        ' AS AED,'
      
        '  sum (CASE WHEN T.VAL_COD=784        THEN round(T.AMOUNT*O.osta' +
        't,2)  ELSE 0 END) AS AEDEKV,'
      
        '  sum (CASE WHEN T.VAL_COD= 16        THEN T.AMOUNT  ELSE 0 END)' +
        ' AS YEN,'
      
        '  sum (CASE WHEN T.VAL_COD= 16        THEN round(T.AMOUNT*O.osta' +
        't,2) ELSE 0 END) AS YENEKV'
      '  FROM exp_incomingreport T,customers C,exp_report E,operkurs O'
      ' Where     '
      '        T.optype IN (4,8)'
      '       AND '
      '       T.setid IN (70,71,72,73,74,133)'
      
        '       AND T.reportid IN (SELECT id FROM exp_report WHERE settyp' +
        'eid =133)'
      '       AND T.senddate >=:bdat'
      '       AND T.senddate <=:edat       '
      '       AND T.kliid=C.id'
      '       AND C.cust_type in(0,1,2,3)'
      '       AND T.status = 1'
      '       AND T.reportid=E.id'
      '       AND E.type=0'
      '       AND T.val_cod=O.val_kod'
      '       AND O.dat=:edat'
      
        '       AND T.sendtransid in(select id from provarch where dat>=:' +
        'bdat and dat<=:edat)'
      '       group by '
      
        '       (CASE WHEN C.CUST_TYPE in(1,4)  THEN '#39'F'#304'Z'#304'K'#304#39' ELSE '#39'H'#220'QUQ' +
        #304#39' END) ,'
      '       (CASE WHEN C.CUST_TYPE in(1,4)  THEN 1 ELSE 0 END) , '
      
        '       (CASE WHEN C.NEREZIDENT=1       THEN '#39'REZIDENT'#39' ELSE '#39'QEY' +
        'R'#304'REZIDENT'#39' END),'
      
        '       (CASE WHEN E.id in(1,2)         THEN '#39'Mallar'#305'n ixrac'#305' '#252'zr' +
        #601#39' ELSE E.NAME END),'
      '       (CASE WHEN E.id in(1,2)         THEN -1  ELSE E.id END),'
      '        C.NEREZIDENT'
      '            '
      '    union        '
      '            '
      'SELECT '
      '  '#39'M'#399'XAR'#304'C'#39' operationtype,'
      '  '#39'Xarici Valyuta(K'#246#231#252'rm'#601')'#39' name,   '
      '   C.NEREZIDENT,      '
      '   78 id,'
      
        '  (CASE WHEN C.CUST_TYPE in(1,4)      THEN '#39'F'#304'Z'#304'K'#304#39' ELSE '#39'H'#220'QUQ'#304 +
        #39' END) AS custtype,'
      
        '  (CASE WHEN C.CUST_TYPE in(1,4)      THEN 1 ELSE 0 END) AS cust' +
        'typeid,'
      
        '  (CASE WHEN C.NEREZIDENT=1           THEN '#39'REZIDENT'#39' ELSE '#39'QEYR' +
        #304'REZIDENT'#39' END) AS rezident,'
      
        '  (CASE WHEN E.id in(14,26)           THEN '#39'Mallar'#305'n idxal'#305' '#252'zr'#601 +
        #39' ELSE E.NAME END) AS Transfertype,'
      
        '  (CASE WHEN E.id in(14,26)           THEN 0  ELSE E.id END) AS ' +
        'Transfertypeid,'
      
        '  sum (CASE WHEN T.VAL_COD=0          THEN T.AMOUNT  ELSE 0 END)' +
        ' AS AZN,'
      
        '  sum (CASE WHEN T.VAL_COD=1          THEN T.AMOUNT  ELSE 0 END)' +
        ' AS USD,'
      
        '  sum (CASE WHEN T.VAL_COD=1          THEN round(T.AMOUNT*O.osta' +
        't,2)  ELSE 0 END) AS USDEKV,'
      
        '  sum (CASE WHEN T.VAL_COD=45         THEN T.AMOUNT  ELSE 0 END)' +
        ' AS EUR,'
      
        '  sum (CASE WHEN T.VAL_COD=45         THEN round(T.AMOUNT*O.osta' +
        't,2)  ELSE 0 END) AS EUREKV,'
      
        '  sum (CASE WHEN T.VAL_COD=50         THEN T.AMOUNT  ELSE 0 END)' +
        ' AS GBP,'
      
        '  sum (CASE WHEN T.VAL_COD=50         THEN round(T.AMOUNT*O.osta' +
        't,2)  ELSE 0 END) AS GBPEKV,'
      
        '  sum (CASE WHEN T.VAL_COD=792        THEN T.AMOUNT  ELSE 0 END)' +
        ' AS TRY,'
      
        '  sum (CASE WHEN T.VAL_COD=792        THEN round(T.AMOUNT*O.osta' +
        't,2) ELSE 0 END) AS TRYEKV, '
      
        '  sum (CASE WHEN T.VAL_COD=48         THEN T.AMOUNT  ELSE 0 END)' +
        ' AS RUR,'
      
        '  sum (CASE WHEN T.VAL_COD=48         THEN round(T.AMOUNT*O.osta' +
        't,2)  ELSE 0 END) AS RUREKV,'
      
        '  sum (CASE WHEN T.VAL_COD=981        THEN T.AMOUNT  ELSE 0 END)' +
        ' AS GEL,'
      
        '  sum (CASE WHEN T.VAL_COD=981        THEN round(T.AMOUNT*O.osta' +
        't,2) ELSE 0 END) AS GELEKV,'
      
        '  sum (CASE WHEN T.VAL_COD=784        THEN T.AMOUNT  ELSE 0 END)' +
        ' AS AED,'
      
        '  sum (CASE WHEN T.VAL_COD=784        THEN round(T.AMOUNT*O.osta' +
        't,2)  ELSE 0 END) AS AEDEKV,'
      
        '  sum (CASE WHEN T.VAL_COD= 16        THEN T.AMOUNT  ELSE 0 END)' +
        ' AS YEN,'
      
        '  sum (CASE WHEN T.VAL_COD= 16        THEN round(T.AMOUNT*O.osta' +
        't,2) ELSE 0 END) AS YENEKV'
      '  FROM exp_batchs T,customers C,exp_report E,operkurs O'
      ' Where     '
      '        T.optype IN (4,8)'
      '       AND '
      '       T.setid IN (70,71,72,73,74,78)'
      '       AND T.reportid IN (SELECT id'
      '                          FROM exp_report'
      '                         WHERE settypeid = 78)'
      '       AND T.senddate >=:bdat'
      '       AND T.senddate <=:edat         '
      '       AND T.kliid=C.id'
      '       AND C.cust_type in(0,1,2,3)'
      '       AND T.status = 1'
      '       AND T.reportid=E.id'
      '       AND E.type=0'
      '       AND T.val_cod=O.val_kod'
      '       AND O.dat=:edat'
      
        '       AND T.sendtransid in(select id from provarch where dat>=:' +
        'bdat and dat<=:edat) '
      '       group by '
      
        '       (CASE WHEN C.CUST_TYPE in(1,4)  THEN '#39'F'#304'Z'#304'K'#304#39' ELSE '#39'H'#220'QUQ' +
        #304#39' END) ,'
      '       (CASE WHEN C.CUST_TYPE in(1,4)  THEN 1 ELSE 0 END) , '
      
        '       (CASE WHEN C.NEREZIDENT=1       THEN '#39'REZIDENT'#39' ELSE '#39'QEY' +
        'R'#304'REZIDENT'#39' END),'
      
        '       (CASE WHEN E.id in(14,26)       THEN '#39'Mallar'#305'n idxal'#305' '#252'zr' +
        #601#39' ELSE E.NAME END),'
      '       (CASE WHEN E.id in(14,26)       THEN 0  ELSE E.id END),'
      '        C.NEREZIDENT            '
      '        order by operationtype,Transfertypeid )'
      ''
      ''
      ''
      ''
      ''
      '')
