  object OracleDataSet1: TOracleDataSet
    SQL.Strings = (
      'SELECT CASE WHEN T4.ID=78 THEN '#39'MEXARIC'#39
      '            WHEN T4.ID=133 THEN '#39'MEDAXIL'#39' END AS operationtype,'
      '    T4.NAME ,'
      '    T4.ID,'
      '    T2.nerezident,'
      
        '    (CASE WHEN T2.CUST_TYPE=1  THEN '#39'F'#304'Z'#304'K'#304#39' ELSE '#39'H'#220'QUQ'#304#39' END) ' +
        'AS custtype,'
      
        '    (CASE WHEN T2.CUST_TYPE=1  THEN 1 ELSE 0 END) AS custtypeid,' +
        ' '
      
        '    (CASE WHEN T2.NEREZIDENT=1 THEN '#39'REZIDENT'#39' ELSE '#39'QEYR'#304'REZIDE' +
        'NT'#39' END) AS rezident,'
      
        '    (CASE WHEN T3.id in(14,26)  THEN '#39'Mallar'#305'n idxal'#305' '#252'zr'#601#39' ELSE' +
        ' T3.NAME END) AS Transfertype,'
      
        '    (CASE WHEN T3.id in(14,26)  THEN 0  ELSE T3.id END) AS Trans' +
        'fertypeid,                               '
      '      '
      
        '    SUM(CASE WHEN T1.VAL_COD=0    THEN T1.AMOUNT  ELSE 0 END) AS' +
        ' AZN,'
      
