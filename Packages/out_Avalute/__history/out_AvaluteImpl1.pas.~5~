procedure Tout_AvaluteForm.AvaluteDataSetApplyRecord(
  Sender: TOracleDataSet; Action: Char; var Applied: Boolean;
  var NewRowId: String);
begin
case Action of
  'I':
      begin
       with P_avalute, Sender do
        CallProcedure('add_avalute', [
            'v_VALUTE',FieldByName('VALUTE').AsString
          , 'v_VAL_NAME',FieldByName('VAL_NAME').AsString
          , 'v_VALU_NAME',FieldByName('VALU_NAME').AsString
          , 'v_VALU_SHORT',FieldByName('VALU_SHORT').AsString
          , 'v_USTORG',FieldByName('USTORG').AsString
          , 'v_USTPOK',FieldByName('USTPOK').AsString
          , 'v_VALU_GEN',FieldByName('VALU_GEN').AsString
          , 'v_VALU_AZ',FieldByName('VALU_AZ').AsString
          , 'v_USING',FieldByName('USING').AsString
          , 'v_VALU_OTHER',FieldByName('VALU_OTHER').AsString
          , 'v_VALU_INTER',FieldByName('VALU_INTER').AsString
          , 'v_VALU_BALA',FieldByName('VALU_BALA').AsString
          , 'v_PRISTAVKA',FieldByName('PRISTAVKA').AsString
          , 'v_COUNTRY',FieldByName('COUNTRY').AsString
          , 'v_UST_POK1',FieldByName('UST_POK1').AsString
          , 'v_OFFICAL',FieldByName('OFFICAL').AsString
          , 'v_LIMIT',FieldByName('LIMIT').AsString
          , 'v_DEBET',FieldByName('DEBET').AsString
          , 'v_KREDIT',FieldByName('KREDIT').AsString
          , 'v_F5501P',FieldByName('F5501P').AsString
          , 'v_F5501V',FieldByName('F5501V').AsString
          , 'v_SDEBET',FieldByName('SDEBET').AsString
          , 'v_SCREDIT',FieldByName('SCREDIT').AsString

        ]);
        Applied :=True;
      end;
    'L','R','C':
      Applied := True
 else

  Applied :=False;
  end;
end;

procedure Tout_AvaluteForm.OrDS_Avalute_TAfterScroll(DataSet: TDataSet);
begin
 with OrDS_ValuteSettings do begin
   Close;
   SetVariable('Val', OrDS_Avalute_T.FieldByName('Valute').AsInteger);
   Open;
  end;
end;

procedure Tout_AvaluteForm.BtnOKClick(Sender: TObject);
