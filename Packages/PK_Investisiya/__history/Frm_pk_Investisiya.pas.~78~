procedure TFrm_Investisiya.DBGrid1DrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn; State: TGridDrawState);

var
  ImageIndex: Integer;
begin
  with Sender as TDBGrid do
  begin
    if DataSource.DataSet.RecordCount <> 0 then
    begin
      ImageIndex := DataSource.DataSet.FieldByName('status').AsInteger ;
      if (DataCol = 2) and (ImageIndex= 0) then begin
 ImageList.Draw(Canvas, Rect.Left, Rect.Top,6, True) ;
      end;
  if (DataCol = 2) and (ImageIndex=1) then begin
 ImageList.Draw(Canvas, Rect.Left, Rect.Top,16, True)
      end;
       if (DataCol = 2) and (ImageIndex=2) then begin
 ImageList.Draw(Canvas, Rect.Left, Rect.Top,8, True)
      end;

  end;
  end;

end;

procedure TFrm_Investisiya.DBGrid1TitleClick(Column: TColumn);

var
   TitleName :string;
   SortPosition: word;
begin
 SortPosition :=100;
 if (Dm_Pk_investisiya.DsMain_Contracts.IsEmpty) or (Column.FieldName = EmptyStr) then Exit;
 Screen.Cursor :=crHourGlass;
 TitleName :=Column.FieldName;
 with  Dm_Pk_investisiya.DsMain_Contracts do
  try
   SortPosition :=SQL.Add('ORDER BY '+ TitleName + ' desc');
   Refresh;
  finally
   SQL[SortPosition] :=EmptyStr;
   Screen.Cursor :=crDefault;
  end;

end;

