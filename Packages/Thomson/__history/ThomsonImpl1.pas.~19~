procedure TThomson.ToolButton1Click(Sender: TObject);
const RootCell = 2;
var
    V, Sheet, Sheets  :Variant;
    i,j: Integer;
    a,VAL_NAME:string;
    F:boolean;
    //i:char;
    say,k:integer;
begin
  if not OpenDialog1.Execute then Exit;
  V:=ExcelApplication1.Application;
  ExcelApplication1.Connect;
   try
     V.Workbooks.Open(OpenDialog1.FileName);
     Sheet := V.Workbooks[1].Worksheets['Sheet1'];
     Sheets := V.Sheets;
     OracleDataSet1.First;
     OracleDataSet2.Active:=True;
     with OracleDataSet1 do
     begin
       for i:=3 to Sheet.Cells.CurrentRegion.Rows.Count do
       begin
         Insert;
         FieldByName('HDATE').AsDateTime:=Sheet.cells[i,2];
         FieldByName('DEBITCURRENCY').AsString:=Sheet.cells[i,3];
         FieldByName('DEBIT').AsString:=Sheet.cells[i,4];
         FieldByName('CREDITCURRENCY').AsString:=Sheet.cells[i,5];
         FieldByName('CREDIT').AsString:=Sheet.cells[i,6];
         FieldByName('DEBITAMOUNT').AsFloat:=Sheet.cells[i,7];
         FieldByName('CREDITAMOUNT').AsFloat:=Sheet.cells[i,8];
         FieldByName('DESCRIPTION').AsString:=Sheet.cells[i,9];
         FieldByName('USERNAME').AsString:=OracleDataSet3.FieldByName('USER').AsString;
         FieldByName('STATUS').AsInteger:=0;
         Post;
       end;
       Next;
     end;
   finally
     ExcelApplication1.Quit;
     ExcelApplication1.Disconnect;
   end;
   oracledataset1.refresh;
end;

procedure TThomson.ToolButton3Click(Sender: TObject);
var id,i,j,status:integer;
    F:boolean;
begin
  if XDBGridThomson.DataSource.DataSet.RecordCount=0 then exit;
  XDBGridThomson.SetFocus;
  XDBGridThomson.SelectedRows.CurrentRowSelected:=XDBGridThomson.DataSource.DataSet.RecordCount<>0;
   for i:=0 to XDBGridThomson.SelectedRows.Count-1 do
   begin
      XDBGridThomson.DataSource.DataSet.GotoBookmark(pointer(XDBGridThomson.SelectedRows.items[i]));
      id:=XDBGridThomson.DataSource.DataSet.fieldbyname('ID').asinteger;
      case MessageDlg(format('Əməliyyat təsdiqlənsinmi #%d ?',[id]), mtConfirmation,[mbyes,mbno,mbcancel,mball], 0) of
           mryes :begin
                    status:=XDBGridThomson.DataSource.DataSet.fieldbyname('status').asinteger;
                    if status=0 then
                    begin
                      OraclePackage1.CallProcedure('sb_thomson',[id]);
                      sboapiDataModule.SBSession.Commit;
                      XDBGridThomson.DataSource.DataSet.Refresh;
                      if XDBGridThomson.SelectedRows.Count=1 then XDBGridThomson.SelectedRows.Clear;
                    end;
                  end;
           mrno  : exit;
           mrcancel : Break;
           mrall : begin
                     case MessageDlg(inttostr(XDBGridThomson.SelectedRows.Count)+' sayda əməliyyat təsdiqlənsinmi ?', mtConfirmation,[mbyes,mbno], 0) of
                     mryes: begin
                              for j:=0 to XDBGridThomson.SelectedRows.Count-1 do
                              begin
                                XDBGridThomson.DataSource.DataSet.GotoBookmark(pointer(XDBGridThomson.SelectedRows.items[j]));
                                id:=XDBGridThomson.DataSource.DataSet.fieldbyname('ID').asinteger;
                                status:=XDBGridThomson.DataSource.DataSet.fieldbyname('status').asinteger;
                                if status=0 then
                                begin
                                   OraclePackage1.CallProcedure('sb_thomson',[id]);
                                   sboapiDataModule.SBSession.Commit;
                                end;
                              end;
                              XDBGridThomson.DataSource.DataSet.Refresh;
                              XDBGridThomson.SelectedRows.Clear;
                              Break;
                            end;
                     mrno : exit;
                     end;
                   end;
      end;

   end;
end;


