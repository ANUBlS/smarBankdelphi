procedure TThomson.Button1Click(Sender: TObject);
const RootCell = 2;
var
    V, Sheet, Sheets  :Variant;
    Row: Integer;
    a,VAL_NAME:string;
    F:boolean;
    i:char;
    say,k:integer;
begin
  if not OpenDialog1.Execute then Exit;
  V:=ExcelApplication1.Application;
  ExcelApplication1.Connect;
   try
     V.Workbooks.Open(OpenDialog1.FileName);
     Sheet := V.Workbooks[1].Worksheets['ILENTRIES'];
     Sheets := V.Sheets;

     OracleDataSet2.close;
     OracleDataSet2.Open;
     OracleDataSet1.Open;
     OracleDataSet1.First;
     with OracleDataSet1 do
     begin
       say:=1;
       for Row:=4 to Sheet.cells.CurrentRegion.Rows.Count do
       begin
         F:=False;
         a:=Sheet.cells[Row,1];
         for i:='0' to '9' do
         if a[1]=i then F:=true;
         if F then
         begin
           Insert;
           Val_Name:=Sheet.cells[Row,7];
           FieldByName('TRANS').AsInteger                := Sheet.cells[Row,1];
           FieldByName('ACCNUM').Asstring                := Sheet.cells[Row,2];
           FieldByName('ACCNUM').Asstring:=FieldByName('ACCNUM').Asstring+VAL_NAME;
           FieldByName('DEBIT').AsString                 := Sheet.cells[Row,3];
           FieldByName('TRADE').AsDateTime               := Sheet.cells[Row,4];
           FieldByName('SETTLEDAT').AsDateTime           := Sheet.cells[Row,5];
           FieldByName('POSTING').AsDateTime             := Sheet.cells[Row,6];
           FieldByName('SECURITY').AsString              := Sheet.cells[Row,7];
           FieldByName('POSTEDAMT').AsFloat              := Sheet.cells[Row,8];
           FieldByName('REPORT1').AsString               := Sheet.cells[Row,9];
           FieldByName('POSTEDAMT1').AsFloat             := Sheet.cells[Row,10];
           FieldByName('SECRPT1').AsFloat                := Sheet.cells[Row,11];
           FieldByName('TRANSACTION_REMARKS').AsString   := Sheet.cells[Row,12];
           FieldByName('ID').AsInteger                   :=say;

           Post;
           inc(say);
         end;
       end;
       Next;
     end;
     OracleDataSet3.Close;
     OracleDataSet3.Open;
     for k:=1 to OracleDataSet3.RecordCount do
       begin
         OraclePackage2.CallProcedure('loops',[OracleDataSet3.FieldByName('TRANS').AsInteger]);
         OracleDataSet3.Next;
       end;
     oracledataset1.refresh;
   finally
     ExcelApplication1.Quit;
     ExcelApplication1.Disconnect;
   end;
end;



