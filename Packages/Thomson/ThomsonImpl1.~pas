procedure TThomson.Button2Click(Sender: TObject);
var a:integer;
begin
  while not OracleDataSet1.Eof do
  begin
    if a<> OracleDataSet1.FieldByName('ID_NUMBER').AsInteger then
    begin
      OraclePackage1.CallProcedure('SetThomsonTransaction',[OracleDataSet1.FieldByName('TRANS').AsInteger,OracleDataSet1.FieldByName('ID_NUMBER').AsInteger]);
      a:=OracleDataSet1.FieldByName('ID_NUMBER').AsInteger;
    end;
    OracleDataSet1.next;
  end;
 ShowMessage('Emeliyyatlar gunun senedlerine gonderildi');
end;

