ions/><Scripts><ExecuteScripts><Execute>DROP INDEX CREDITSMGR.PK_CM_PORTFOLIO</Execute><Comment>/* DROP reductant index */</Comment></ExecuteScripts><UndoScripts><Execute>CREATE UNIQUE INDEX "CREDITSMGR"."PK_CM_PORTFOLIO"
ON "CREDITSMGR"."CM_PORTFOLIO"(ID)
