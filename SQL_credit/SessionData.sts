ON "CREDITSMGR"."CM_PORTFOLIO"(ID)
    -- Make sure indices and tables exist on     -- different tablespaces and different physical devices   -- to avoid contention   tablespace /*&lt;TS*/Please enter a tablespace/*TS&gt;*/   STORAGE(INITIAL	114688         NEXT	 )</Execute></UndoScripts></Scripts></Advice><Advice id="2003" help_id="2003" rank="40" type="text" subtype="" category="Best Practice"><Title_h>Index CREDITSMGR.IDX_FULL_PORTFOLIO page fragmentation &amp;gt; 10</Title_h><Description_h>Index CREDITSMGR.IDX_FULL_PORTFOLIO page fragmentation &amp;gt; 10</Description_h><Explanations><Explanation_h>Index CREDITSMGR.IDX_FULL_PORTFOLIO has more than 10 extents. You should consider rebuild or re-create it.</Explanation_h></Explanations><Children/><DbObjects/><Exclusions/><Scripts><ExecuteScripts><Comment></Comment></ExecuteScripts><UndoScripts/></Scripts></Advice><Advice id="2004" help_id="2004" rank="40" type="DDL" subtype="CREATE INDEX" category="Best Practice"><Title_h>Index CREDITSMGR.IDX_FULL_PORTFOLIO tablespace is the same as table CREDITSMGR.CM_PORTFOLIO tablespace</Title_h><Description_h>Index CREDITSMGR.IDX_FULL_PORTFOLIO tablespace is the same as table CREDITSMGR.CM_PORTFOLIO tablespace</Description_h><Explanations><Explanation_h>The index CREDITSMGR.IDX_FULL_PORTFOLIO resides in the same tablespace with table CREDITSMGR.CM_PORTFOLIO.</Explanation_h></Explanations><Children/><DbObjects/><Exclusions/><Scripts><ExecuteScripts><Execute>DROP INDEX CREDITSMGR.IDX_FULL_PORTFOLIO;</Execute><Execute>CREATE UNIQUE INDEX "CREDITSMGR"."IDX_FULL_PORTFOLIO"
