	<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
		<PropertyGroup>
			<ProjectGuid>{787651A6-A6D8-4701-9A5D-AECF4E7DABBC}</ProjectGuid>
		</PropertyGroup>
		<ItemGroup>
			<Projects Include="Packages\sboapi50\sboapi50.dproj">
				<Dependencies/>
			</Projects>
			<Projects Include="Packages\SB_Credit\Sm_creditsmgr\Creditsmgr.dproj">
				<Dependencies/>
			</Projects>
			<Projects Include="Programs\SmartBank\SmartBank.dproj">
				<Dependencies/>
			</Projects>
		</ItemGroup>
		<ProjectExtensions>
			<Borland.Personality>Default.Personality.12</Borland.Personality>
			<Borland.ProjectType/>
			<BorlandProject>
				<Default.Personality/>
			</BorlandProject>
		</ProjectExtensions>
		<Target Name="sboapi50">
			<MSBuild Projects="Packages\sboapi50\sboapi50.dproj"/>
		</Target>
		<Target Name="sboapi50:Clean">
			<MSBuild Projects="Packages\sboapi50\sboapi50.dproj" Targets="Clean"/>
		</Target>
		<Target Name="sboapi50:Make">
			<MSBuild Projects="Packages\sboapi50\sboapi50.dproj" Targets="Make"/>
		</Target>
		<Target Name="Creditsmgr">
			<MSBuild Projects="Packages\SB_Credit\Sm_creditsmgr\Creditsmgr.dproj"/>
