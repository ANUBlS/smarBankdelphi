Function StringToStream(const AString: string): TStream;
var utf8: utf8string;
begin
  utf8:= utf8encode(AString);
  Result:= TStringStream.Create(utf8);
end;



function TMethods.convertingjson (querytext :String;session:string;var k:string):string ;
 Var
field_name,nameColunm,valueColunm,rt: String;
I: Integer;
LJSONObject:TJsonObject;
begin
      login('','',session);
        Query.Active:=false;

      Query.sql.Clear;
      Query.SQL.Text := querytext;
      Query.Active := True;
      Query.First;
         // jsonitems:=TJSONObject.Create;
      while (not Query.EOF) do
      begin

        rt := rt+'{';
        for I := 0 to Query.FieldDefs.Count-1 do
        begin
          nameColunm  := Query.FieldDefs[I].Name;
          valueColunm := Query.FieldByName(nameColunm).AsString;
          rt := rt+'"'+LowerCase(nameColunm)+'":"'+(valueColunm)+'",';

        end;
        Delete(rt, Length(rt), 1);
        rt := rt+'},';
        Query.Next;
      end;
      Query.Refresh;
      Delete(rt, Length(rt), 1);

      result:='['+rt+']';

    end;








