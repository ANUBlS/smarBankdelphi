package smtool;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart - Common Components, Functions and Classes'}
{$IMPLICITBUILD OFF}

requires
  vcl50;

contains
  DockSite in 'DockSite.pas',
  SMToolDecls in 'SMToolDecls.pas',
  SMToolReg in 'SMToolReg.pas',
  RtFloatWindow in 'RtFloatWindow.pas',
  DtFloatWindow in 'DtFloatWindow.pas',
  FloatWindow in 'FloatWindow.pas';

end.
