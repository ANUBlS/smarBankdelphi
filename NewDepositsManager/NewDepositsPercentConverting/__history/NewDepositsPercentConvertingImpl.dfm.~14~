      ' dm_stored_programs.CheckContractState(cont.ID) as  Status,'
      ' av.val_name,'
      ' cont.currency,'
      ' cont.personaltype,'
      ' cont.clienttype,'
      ' cont.customerid,'
      ' cont.branchid,'
      '(select type from dm_types where id=clienttype) as contype,'
      
        '(case when dm_stored_programs.GetDepType(capitalperid)='#39'WITHDRAW' +
        #39' '
      'then'
      
        '  (select  description||'#39'(Hesaba K'#246#231#252'r)'#39' from dm_depcapitalperio' +
