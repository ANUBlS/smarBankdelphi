procedure TNewDepositsFrmReport.BitBtn1Click(Sender: TObject);
var Dat :TDateTime;
begin
   Dat := Integer(Trunc(DTPReport.DateTime));
   with NewDepositsDmReport,ReportData do
   begin
      if Active then CloseAll;
      SQL[48] := ' and '+BuildFilterString;
      SetVariable('Dat',Dat);
      Open;
   end;
   if NewDepositsDmReport.ReportData.RecordCount>0 then
   begin
     with EExport do
     begin
      Connect;
      ExportDataset(NewDepositsDmReport.ReportData,'Mis hesabatı',true);
     end;
   end;

end;

