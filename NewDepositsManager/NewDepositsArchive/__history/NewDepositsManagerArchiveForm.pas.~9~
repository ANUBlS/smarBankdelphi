end;

procedure TNewDepositsManagerArchiveFormImpl.ActnFilterExecute(Sender: TObject);
begin
   with MainGrid,SelectedRows do
        Clear;
   with MainGrid,DataSource.DataSet do
   begin
      Cursor := crSqlWait;
      Filtered := False;
      Filter := BuildFilterString;
      Filtered := true;
      Cursor := crDefault;
   end;
end;

