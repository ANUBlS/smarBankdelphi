      DBLookupComboboxEh2.KeyValue := Filials.fieldByName('id').AsInteger;
      DBLookupComboboxEh3.KeyValue := dm_types.fieldByName('id').AsInteger;
      DBLookupComboboxEh4.KeyValue := dm_categories.fieldByName('id').AsInteger;
      DBLookupComboboxEh5.KeyValue := dm_persons.fieldByName('id').AsInteger;
      //LCBUsers.KeyValue := users.fieldByName('id').AsInteger;
      LCBStatus.ItemIndex := 0;
   end;
end;

