package NewDEpositsPeriodReport;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CMVCL50,
  DclEhlib150,
  Ehlib150,
  NewDepositsCommon,
  SBTranslate,
  QR5RunDXE,
  rtl;

contains
  dmPeriodReportImpl_new in 'dmPeriodReportImpl_new.pas' {NewDepositsDmPeriodReport: TDataModule},
  NewDepositsFrmPeriodReportImpl in 'NewDepositsFrmPeriodReportImpl.pas' {NewDepositsFrmPeriodReport},
  frmQrptReportImpl_new in 'frmQrptReportImpl_new.pas' {frmQrptReport_new};

end.
