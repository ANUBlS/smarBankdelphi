unit NewDepositsFrmAddProlongationImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, NLSDialogs,
   ComCtrls, StdCtrls, Buttons;

type
  TNewDepositsFrmAddProlongation = class(TForm)
    BitBtnClose: TBitBtn;
    BitBtnOk: TBitBtn;
    GroupBox1: TGroupBox;
    DTPLast: TDateTimePicker;
    GroupBox2: TGroupBox;
    DTPNew: TDateTimePicker;
    procedure FormCanResize(Sender: TObject; var NewWidth, NewHeight: Integer;
      var Resize: Boolean);
    procedure FormCreate(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure BitBtnCloseClick(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure BitBtnOkClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  NewDepositsFrmAddProlongation: TNewDepositsFrmAddProlongation;

implementation

{$R *.dfm}
  uses NewDepositsFrmProlongationImpl,NewCommonDeclsImpl,SBTranslateProc,sboapiDataModuleimpl;
procedure TNewDepositsFrmAddProlongation.BitBtnCloseClick(Sender: TObject);
begin
Close
end;

procedure TNewDepositsFrmAddProlongation.BitBtnOkClick(Sender: TObject);
const
  rsInvalidDate = 'Тарихи дцзэцн  дахил един !';
var
  CloseDate, ProlongDate : TDateTime;
  ContractID : Integer;

begin

  ProlongDate := Integer(Trunc(DTPNew.DateTime));
  CloseDate := NewDepositsFrmProlongation.DepositInf.FieldByName('CloseDate').AsDateTime;
  ContractID := Get_SelectedContID;

  if ProlongDate <= CloseDate then
    MessageDlg(rsInvalidDate, mtWarning, [mbOK],0)
  else
  begin
      with NewDepositsFrmProlongation,sbcm_prolongation do
      begin
      CallProcedure('AddProlongation',[
       ContractID ,
       Get_BankDate ,
       ProlongDate
      ]);

       prolongations.Refresh;
       DepositInf.Refresh;
      end;

      ModalResult := mrOk;

   end;

end;



procedure TNewDepositsFrmAddProlongation.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
Resize := False;
end;

procedure TNewDepositsFrmAddProlongation.FormCreate(Sender: TObject);
begin
SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TNewDepositsFrmAddProlongation.FormKeyPress(Sender: TObject; var Key: Char);
begin
   if Ord(Key) = VK_ESCAPE then close
end;

procedure TNewDepositsFrmAddProlongation.FormShow(Sender: TObject);
begin
   DTPNew.DateTime :=  Get_BankDate;
   DTPLast.DateTime := NewDepositsFrmProlongation.DepositInf.FieldByName('CloseDate').AsDateTime;
end;

end.
