package NewDepositsContractReport;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CMVCL50,
  DclEhlib150,
  DOA41dXE,
  Ehlib150,
  SBDM_Common,
  QR5RunDXE,
  SBTranslate;

contains
  UnitNewDepositsContractReport in 'UnitNewDepositsContractReport.pas' {NewDepositsFrmContractReport},
  UnitNewDepositsDepozitMoneyReport in 'UnitNewDepositsDepozitMoneyReport.pas' {NewDepositsfrmDepozitMoneyReport},
  UnitNewDepositsWithDrawReoprt in 'UnitNewDepositsWithDrawReoprt.pas' {NewDepositsFrmWithDrawReoprt};

end.
