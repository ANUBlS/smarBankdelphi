unit UnitNewDepositsContractReport;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, Buttons, Db, OracleData, NLSLocalizer;

type
  TNewDepositsFrmContractReport = class(TForm)
    BitBtn1: TBitBtn;
    GroupBox1: TGroupBox;
    RadioButton1: TRadioButton;
    RadioButton2: TRadioButton;
    ODSDepozitWithDraw: TOracleDataSet;
    ODSDepozitMoney: TOracleDataSet;
    BitBtn2: TBitBtn;
    Label1: TLabel;
    ODSContarcts: TOracleDataSet;
    procedure BitBtn1Click(Sender: TObject);
    procedure BitBtn2Click(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure FormCanResize(Sender: TObject; var NewWidth,
      NewHeight: Integer; var Resize: Boolean);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
  FContractID:Longint;
    RefreshAfterClose :Boolean;
    { Public declarations }
  end;

var
  NewDepositsFrmContractReport: TNewDepositsFrmContractReport;

  procedure exportproc(S :String);export;

implementation

uses SBTranslateProc,sboapiDataModuleImpl, UnitDepozitMoneyReport,
  UnitWithDrawReoprt,CommonDeclsImpl;
{$R *.DFM}


procedure exportproc(S :String);export;
begin
   frmContractReport.ShowModal;
end;

exports
   exportproc;

procedure TNewDepositsFrmContractReport.BitBtn1Click(Sender: TObject);
var ContractID:Integer;
begin
ContractID:= Get_SelectedContID;
      with ODSContarcts do
       begin
          if Active then CloseAll;
          SetVariable('CONTID',ContractID);
          Open;
       end;
if RadioButton1.Checked=True then
begin
     with ODSDepozitMoney do
       begin
          if Active then CloseAll;
          SetVariable('CONTID',ContractID);
          Open;
       end;
frmDepozitMoneyReport :=TfrmDepozitMoneyReport.Create(Self);
frmDepozitMoneyReport.QRPDepozitMoney.Preview;
end
else
begin
     with ODSDepozitWithDraw do
       begin
          if Active then CloseAll;
          SetVariable('CONTID',ContractID);
          Open;
       end;
frmWithDrawReoprt :=TfrmWithDrawReoprt.Create(Self);
frmWithDrawReoprt.QRPWithDraw.Preview;
end;
end;

procedure TNewDepositsFrmContractReport.BitBtn2Click(Sender: TObject);
begin
close;
end;

procedure TNewDepositsFrmContractReport.FormDestroy(Sender: TObject);
begin
ODSDepozitMoney.close;
ODSDepozitWithDraw.close;
end;

  procedure TNewDepositsFrmContractReport.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize := False;
end;

procedure TNewDepositsFrmContractReport.FormCreate(Sender: TObject);
begin
  SBTranslateProc.TranslateAllCompForms(self,sboapiDataModule.OrPack_SL);
end;

procedure TNewDepositsFrmContractReport.FormKeyPress(Sender: TObject; var Key: Char);
begin
   if ord(Key) = VK_ESCAPE then close; 
end;

initialization
      frmContractReport := TNewDepositsFrmContractReport.Create(CommonApplication);

end.
