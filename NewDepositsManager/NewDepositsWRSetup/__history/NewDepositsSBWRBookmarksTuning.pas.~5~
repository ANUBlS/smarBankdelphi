procedure TNewDepositsSBWRBookmarkSetup.ActionAddTemplareExecute(Sender: TObject);

resourcestring
      rsTemplateCaption = 'Éåíè øàáëîí';
var
    i:integer;
begin

      with NewDepositsSBWRSetupDataMod.SBWRTemplatesDSet do
