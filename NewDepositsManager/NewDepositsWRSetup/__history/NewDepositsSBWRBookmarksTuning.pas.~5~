      NewDepositsSBWRSetupDataMod.SBWRTemplatesDSet.CloseAll;
      NewDepositsSBWRSetupDataMod.SBWRBookmarksDSet.CloseAll;
      NewDepositsSBWRSetupDataMod.SBOracleDSetTamplates.CloseAll;
      NewDepositsSBBookmarkAddEditForm.Free;
      NewDepositsSBTemplAddEditForm.Free;
      NewDepositsSBWRSetupDataMod.Free;
end;

