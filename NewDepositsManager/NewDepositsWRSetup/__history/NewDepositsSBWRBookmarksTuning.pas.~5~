procedure TNewDepositsSBWRBookmarkSetup.FormCreate(Sender: TObject);

var ContractID:integer;
begin
     ContractID := Get_SelectedContID;

      NewDepositsSBWRSetupDataMod := TNewDepositsSBWRSetupDataMod.Create(Self);
      NewDepositsSBBookmarkAddEditForm := TNewDepositsSBBookmarkAddEditForm.create(self);
      NewDepositsSBTemplAddEditForm := TNewDepositsSBTemplAddEditForm.Create(Self);
      NewDepositsSBWRSetupDataMod.SBWRFieldsDSet.Open;
      NewDepositsSBWRSetupDataMod.SBWRBookmarksDSet.Open;
      NewDepositsSBWRSetupDataMod.SBOracleDSetTamplates.Open;
      NewDepositsSBWRSetupDataMod.SBWRTemplatesDSet.Open;
