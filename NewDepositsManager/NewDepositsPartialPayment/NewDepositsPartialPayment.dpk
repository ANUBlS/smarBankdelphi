package NewDepositsPartialPayment;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CMVCL50,
  DclEhlib150,
  doa41dxe,
  Ehlib150,
  NewDepositsCommon,
  SBTranslate,
  VCLXFiles150;

contains
  NewDepositsFrmPartialPaymentImpl in 'NewDepositsFrmPartialPaymentImpl.pas' {NewDepositsFrmPartialPayment},
  NewDepositsDataModPartialPaymentImpl in 'NewDepositsDataModPartialPaymentImpl.pas' {NewDepositsDataModPartialPayment: TDataModule},
  NewDepositsFrmPaymentAddImpl in 'NewDepositsFrmPaymentAddImpl.pas' {NewDepositsFrmPaymentAdd};

end.
