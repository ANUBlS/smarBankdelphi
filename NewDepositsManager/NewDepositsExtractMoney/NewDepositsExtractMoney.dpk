package NewDepositsExtractMoney;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  CMVCL50,
  DclEhlib150,
  Ehlib150,
  sboapi50,
  SBTranslate,
  doa41dXE,
  vcl,
  NewDepositsCommon;

contains
  NewDepositsDMExtractMoneyImpl in 'NewDepositsDMExtractMoneyImpl.pas' {NewDepositsDMExtractMoney: TDataModule},
  NewDepositsFrmAddExtractMoneyImpl in 'NewDepositsFrmAddExtractMoneyImpl.pas' {NewDepositsFrmAddExtractMoney},
  NewDepositsFrmExtractMoneyImpl in 'NewDepositsFrmExtractMoneyImpl.pas' {NewDepositsFrmExtractMoney};

end.
