procedure TfrmExtractMoney_new.ActnAddExecute(Sender: TObject);
begin
   if frmAddExtractMoney_new.ShowModal = mrOk then
   begin
      RefreshAfterOperation := True;
      DMExtractMoney_new.Payments.Refresh;
   end;
end;

procedure TfrmExtractMoney_new.ActnDelExecute(Sender: TObject);
begin

    if MessageDlg('Silinməsinə əminsinizmi?',
             mtConfirmation, [mbYes, mbNo], 0) = mrNo
    then Exit;

    with DMExtractMoney_new,Payments,sbcm_payment do
    begin
         CallProcedure('DeleteWithDrawMoney',['P_DepWMoneyID',FieldByName('ID').AsInteger]);
         Refresh;
    end;

end;

procedure TfrmExtractMoney_new.ActnExprtExecute(Sender: TObject);
begin
   with ExcelExport do
   begin
      Connect;
      ExportDataset(DMExtractMoney_new.Payments,'Ödənilmiş əməliyyat',True,false);
      Disconnect;
   end;
end;

procedure TfrmExtractMoney_new.ActnDelUpdate(Sender: TObject);
begin    with (Sender as TAction) do
          Enabled := DMExtractMoney_new.Payments.RecordCount > 0
end;

initialization
    frmExtractMoney_new := TfrmExtractMoney_new.Create(CommonApplication);
end.
