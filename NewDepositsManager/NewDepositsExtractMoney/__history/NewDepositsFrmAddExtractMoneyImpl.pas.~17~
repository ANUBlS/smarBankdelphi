procedure TNewDepositsFrmAddExtractMoney.ActiontrExecute(Sender: TObject);
resourcestring
  rsTransactionsWillProcessed = 'Depozitin ödənilməsi ...';
Var p_accid :Integer;
    CommitExtractMoney :Boolean;

begin
   p_accid  := NewDepositsDMExtractMoney.CustAcc.FieldByName('CLIENTACCID').AsInteger;

    with NewDepositsDMExtractMoney,dm_payment do
     CallProcedure('WithDrawMoney',['ContractID',Get_SelectedContID,
                                    'P_AccID',p_accid,
                                    'HDate',Get_BankDate,
                                    'FacticalDebtWithdraw',EdMainDebit.Value,
                                    'InterestDebtWithdraw',EdIntDebit.value,
                                    'ClientDebtWithdraw',EdClientDebit.Value,
                                    'showTransaction',3]);

    try
    CommitExtractMoney := TrDelayed_Show(Self,rsTransactionsWillProcessed);

    Update;

    NewDepositsDMExtractMoney.DM_PAYMENT.CallProcedure('CommitWithDrawMoney',[
       'DoCommit',CommitExtractMoney
    ]);

    if CommitExtractMoney then
    Self.ModalResult := mrOk;
    Self.Update;
  except


    NewDepositsDMExtractMoney.DM_PAYMENT.CallProcedure('CommitWithDrawMoney',['DoCommit',
        False
    ]);

    raise;

  end;

  end;

  procedure TNewDepositsFrmAddExtractMoney.ActiontrUpdate(Sender: TObject);
begin
   with (Sender as TAction) do
         Enabled := (EdMainDebit.Value + EdIntDebit.Value) > 0
end;
end.
