package NewDepositsPercentConverting;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  CMVCL50,
  DclEhlib150,
  Ehlib150,
  NewDepositsCommon,
  sboapi50,
  SBTranslate,
  doa41dXE,
  vcl;

contains
  DMPercentConveringImpl_new in '..\SBDM_PercentConverting_new\DMPercentConveringImpl_new.pas' {DMPercentConvering_new: TDataModule},
  frmCalcPerFilterImpl_new in '..\SBDM_PercentConverting_new\frmCalcPerFilterImpl_new.pas' {frmCalcPerFilter_new},
  frmCalcPerProgressImpl_new in '..\SBDM_PercentConverting_new\frmCalcPerProgressImpl_new.pas' {frmCalcPerProgress_new},
  frmPercentConveringImpl_new in '..\SBDM_PercentConverting_new\frmPercentConveringImpl_new.pas' {NewDepositsFrmPercentConvering};

end.
