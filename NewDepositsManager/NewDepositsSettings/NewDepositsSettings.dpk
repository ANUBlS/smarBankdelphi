package NewDepositsSettings;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CMVCL50,
  DclEhlib150,
  DOA41dxe,
  Ehlib150,
  SBTranslate,
  NewDepositsCommon,
  rtl;

contains
  NewDepositsDMReferences in 'NewDepositsDMReferences.pas' {NewDepositsDataModReferences: TDataModule},
  NewDepositsFrmAccGroupsImpl in 'NewDepositsFrmAccGroupsImpl.pas' {NewDepositsFrmAccGroups},
  NewDepositsFrmAccountTurningImpl in 'NewDepositsFrmAccountTurningImpl.pas' {NewDepositsFrmAccountTurning},
  NewDepositsFrmAddEditAccTurningImpl in 'NewDepositsFrmAddEditAccTurningImpl.pas' {NewDepositsFrmAddEditAccTurning},
  NewDepositsFrmAddEditDepositTypesImpl in 'NewDepositsFrmAddEditDepositTypesImpl.pas' {NewDepositsFrmAddEditDepositTypes},
  NewDepositsFrmCategoriesImpl in 'NewDepositsFrmCategoriesImpl.pas' {NewDepositsFrmCategories},
  NewDepositsFrmDepositTypesImpl in 'NewDepositsFrmDepositTypesImpl.pas' {NewDepositsFrmDepositTypes},
  NewDepositsFrmReferencesImpl in 'NewDepositsFrmReferencesImpl.pas' {NewDepositsFrmReferences},
  NewDepositsReferLoader in 'NewDepositsReferLoader.pas',
  NewDepositsFormAccNameImpl in 'NewDepositsFormAccNameImpl.pas' {NewDepositsFormAccName};

end.
