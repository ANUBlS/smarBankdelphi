unit NewDepositsFrmAccountTurningImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, NLSDialogs,
  ComCtrls, ToolWin, ExtCtrls,  ImgList, Grids, DBGridEh, Db,
  OracleData, Oracle, ActnList, XDBGrids, XFSCtrls;


type
  TNewDepositsFrmAccountTurning = class(TForm)
    sbcm_ds: TOraclePackage;
    ImageList1: TImageList;
    ActionList1: TActionList;
    ActnAdd: TAction;
    ActnEdit: TAction;
    ActnDel: TAction;
    settings: TOracleDataSet;
    settingsDatSrc: TDataSource;
    XFPanel1: TXFPanel;
    XFPanel2: TXFPanel;
    XDBGrid1: TXDBGrid;
    ToolBar2: TToolBar;
    BtnCust: TToolButton;
    ToolButton10: TToolButton;
    ToolButton11: TToolButton;
    ToolButton12: TToolButton;
    Köçermeler: TToolButton;
    Əməliyyat: TToolButton;
    ToolButton13: TToolButton;
    Məhsullar: TToolButton;
    ToolButton14: TToolButton;
    ToolButton1: TToolButton;
    ToolButton2: TToolButton;
    settingsID: TFloatField;
    settingsPARENTID: TFloatField;
    settingsCURRENCYID: TFloatField;
    settingsACCID: TFloatField;
    settingsBRANCHID: TFloatField;
    settingsCATEGORY: TWideStringField;
    settingsVALNAME: TWideStringField;
