    procedure MəhsullarClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  NewDepositsFrmAccountTurning: TNewDepositsFrmAccountTurning;

implementation

{$R *.dfm}
   uses  sboapiDataModuleImpl,NewDepositsFrmAddEditAccTurningImpl,SBTranslateProc;
procedure TNewDepositsFrmAccountTurning.ActnAddExecute(Sender: TObject);
begin
   with settings do
         Insert;

    with NewDepositsFrmAddEditAccTurning do
    begin
       Caption := 'Yeni';
       ShowModal;
    end;

   with settings do
         Refresh;
end;

procedure TNewDepositsFrmAccountTurning.ActnDelExecute(Sender: TObject);
begin
      if   MessageDlg('Silinməsinə əminsinizmi?'
              ,mtConfirmation
              ,[mbYes,mbNo],0
              )<>mrYes then Exit;

   with settings do
   begin
      Delete;
      Refresh;
   end;
end;

procedure TNewDepositsFrmAccountTurning.ActnDelUpdate(Sender: TObject);
begin
   with (Sender as TAction) do
        Enabled := settings.RecordCount > 0
end;

procedure TNewDepositsFrmAccountTurning.ActnEditExecute(Sender: TObject);
begin
   with settings do
         Edit;

    with NewDepositsFrmAddEditAccTurning do
    begin
       Caption := 'Redaktə';
       ShowModal;
    end;

   with settings do
         Refresh;
end;

procedure TNewDepositsFrmAccountTurning.ActnEditUpdate(Sender: TObject);
begin
   with (Sender as TAction) do
        Enabled := settings.RecordCount > 0
end;

procedure TNewDepositsFrmAccountTurning.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize := false
end;

procedure TNewDepositsFrmAccountTurning.FormCreate(Sender: TObject);
begin
     //Categories.Open;
     //Accounts.Open;
     //Filials.Open;
    // Valute.Open;
     //movie_names.Open;
     settings.Open;
     NewDepositsFrmAddEditAccTurning:= TNewDepositsFrmAddEditAccTurning.Create(Self);
     SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TNewDepositsFrmAccountTurning.FormDestroy(Sender: TObject);
begin
     //Categories.CloseAll;
     //Accounts.CloseAll;
   //  Filials.CloseAll;
   //  Valute.CloseAll;
     //movie_names.CloseAll;
     settings.CloseAll;
     NewDepositsFrmAddEditAccTurning.Free;
end;

procedure TNewDepositsFrmAccountTurning.FormKeyPress(Sender: TObject; var Key: Char);
begin
   if Ord(Key) = VK_ESCAPE then Close;
end;

procedure TNewDepositsFrmAccountTurning.MəhsullarClick(Sender: TObject);
begin
  Close
end;

procedure TNewDepositsFrmAccountTurning.settingsApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: string);

var
    p_id ,p_PARENTID,p_CurrencyID,
    p_AccID,p_branchid :Integer;

begin
     with settings do begin
        p_id := fieldbyname('ID').AsInteger;
        p_PARENTID := fieldbyname('PARENTID').AsInteger;
        p_CurrencyID := fieldbyname('CurrencyID').AsInteger;
        p_AccID := fieldbyname('AccID').AsInteger;
        p_branchid := fieldbyname('branchid').AsInteger;
     end;

    { with sbcm_ds do begin
     case Action of
        'I':CallProcedure('InsSettings',[p_PARENTID,p_CurrencyID,p_AccID,p_branchid]);
        'U':CallProcedure('UpdSettings',[p_id,p_PARENTID,p_CurrencyID,p_AccID,p_branchid]);

     end;
     Applied := True;
     end;}
end;


procedure TNewDepositsFrmAccountTurning.ƏməliyyatClick(Sender: TObject);
begin
     //Categories.Refresh;
     //Accounts.Refresh;
     //movie_names.Refresh;
     settings.Refresh;
end;

end.
