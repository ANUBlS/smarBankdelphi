unit NewDepositsFrmAddEditAccTurningImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, Mask, DBCtrlsEh, DBLookupEh, DBCtrls, DBGridEh, XFSCtrls, Buttons,
  ExtCtrls, DB, OracleData;

type
  TNewDepositsFrmAddEditAccTurning = class(TForm)
    XFPanel1: TXFPanel;
    XFPanel2: TXFPanel;
    XFPanel3: TXFPanel;
    XFPanel4: TXFPanel;
    XFPanel5: TXFPanel;
    XFPanel6: TXFPanel;
    XFStaticText1: TXFStaticText;
    XFPanel7: TXFPanel;
    XFPanel8: TXFPanel;
    XFStaticText2: TXFStaticText;
    XFPanel9: TXFPanel;
    XFPanel10: TXFPanel;
    XFStaticText3: TXFStaticText;
    XFPanel11: TXFPanel;
    EditAccno: TEdit;
    XFButton: TXFSpeedButton;
    XFButton1: TXFButton;
    XFButton2: TXFButton;
    DBCustType: TDBLookupComboBox;
    Categories: TOracleDataSet;
    CategoriesID: TFloatField;
    CategoriesCATEGORY: TWideStringField;
    CategoriesNewDatSrc: TDataSource;
    EditMoveName: TEdit;
    MoveNames: TOracleDataSet;
    MoveNamesDatSrc: TDataSource;
    MoveNamesID: TIntegerField;
    MoveNamesTYPEID: TIntegerField;
    MoveNamesNAME: TWideStringField;
    MoveNamesDESCRIPTION: TWideStringField;
    CategoriesCUSTATEGORY: TFloatField;
    CategoriesREZCATEGORY: TFloatField;
    CategoriesVALCATEGORY: TFloatField;
    procedure FormCanResize(Sender: TObject; var NewWidth, NewHeight: Integer;
      var Resize: Boolean);
    procedure FormCreate(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure XFButton1Click(Sender: TObject);
    procedure XFButton2Click(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure XFButtonClick(Sender: TObject);
    procedure DBCustTypeClick(Sender: TObject);
  private
    { Private declarations }
  public
    categoryid:integer;
    parentid:integer;
    pvalkod:integer;
    paccid:integer;
    pfilial:integer;
  end;

var
  NewDepositsFrmAddEditAccTurning: TNewDepositsFrmAddEditAccTurning;

implementation

{$R *.dfm}
uses NewDepositsFrmAccountTurningImpl,SBTranslateProc,sboapiDataModuleimpl,
  NewDepositsFormAccNameImpl;
procedure TNewDepositsFrmAddEditAccTurning.DBCustTypeClick(Sender: TObject);
begin
  categoryid:=DBCustType.DataSource.DataSet.FieldByName('id').AsInteger;
  With MoveNames do
  begin
    Close;
    SetVariable('typeid',categoryid);
    Open;
    EditMoveName.Text:=MoveNamesNAME.AsString;
    parentid:=MoveNamesID.AsInteger;
  end;
end;

procedure TNewDepositsFrmAddEditAccTurning.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize := False;
end;

procedure TNewDepositsFrmAddEditAccTurning.FormCreate(Sender: TObject);
begin
  NewDepositsFormAccName:=TNewDepositsFormAccName.Create(Self);
  SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TNewDepositsFrmAddEditAccTurning.FormKeyPress(Sender: TObject;
  var Key: Char);
begin
 if Ord(Key) = VK_ESCAPE then Close;
end;

procedure TNewDepositsFrmAddEditAccTurning.FormShow(Sender: TObject);
begin
  Categories.Close;
  Categories.Open;
  DBCustType.KeyValue:=-1;
  EditMoveName.Text:='';
  EditAccno.Text:='';
end;

procedure TNewDepositsFrmAddEditAccTurning.XFButton1Click(Sender: TObject);
begin
  if DBCustType.KeyValue=-1 then begin
                                   ShowMessage('Müştərinin tipiini seçin!!!');
                                   exit;
                                 end;

  if EditAccno.Text='' then  begin
                               ShowMessage('Hesabı daxil edin!!!');
                               exit;
                             end;


  NewDepositsFrmAccountTurning.DM_RPDEPOSITORY.CallProcedure('InsSettings',[parentid,pvalkod,paccid,pfilial]);
  Close;
  NewDepositsFrmAccountTurning.settings.Refresh;
end;

procedure TNewDepositsFrmAddEditAccTurning.XFButton2Click(Sender: TObject);
begin
  Close;
end;

procedure TNewDepositsFrmAddEditAccTurning.XFButtonClick(Sender: TObject);
begin
  NewDepositsFormAccName.ShowModal;
end;

end.
