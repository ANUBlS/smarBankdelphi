procedure TNewDepositsFrmAddEditDepositTypes.FormShow(Sender: TObject);
var Ch:integer;
begin
  Ch:=0;
  if NewDepositsFrmDepositTypes.FIns=0 then  begin
                                               DBEditEh1.Text:='';
                                               GroupType.Checked:=0;
                                             end
                                       else
                                         With NewDepositsFrmDepositTypes,DepositTypes do
                                         begin
                                           if FieldByName('nonetype').AsString           =GroupType.Items[0] then Ch:=Ch+1;
