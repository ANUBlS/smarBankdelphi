  begin
    pvalkod:=XDBGrid1.DataSource.DataSet.FieldByName('id').AsInteger;
    paccid:=XDBGrid1.DataSource.DataSet.FieldByName('val_acc').AsInteger;
    pfilial:=XDBGrid1.DataSource.DataSet.FieldByName('filialid').AsInteger;
    EditAccno.Text:=XDBGrid1.DataSource.DataSet.FieldByName('acc_no').AsString;
  end;
  close;
end;

procedure TNewDepositsFormAccName.XFBitBtn1Click(Sender: TObject);
begin
  Close;
end;

procedure TNewDepositsFormAccName.ActionSpeedSearchExecute(Sender: TObject);
resourcestring
  rsRecordRecachedEOF = 'Axtarış cərgənin sonuna çatıb .';
  rsContinueFromTop   = 'Əvvəldən axtarmaqla davam etmək istəyirsiniz?';
  rsRecordNotFound    = 'Yazı Tapılmadı.';
var
  SearchField, v_name :string;
  SearchOptions :TSearchRecordOptions;
  Result :boolean;
begin
  SearchOptions := [srIgnoreCase ,srPartialMatch ];

  with Sender as TEdit  do
  begin
   v_name:=Name;
   if UpperCase(Name) = UpperCase('EditAcc_No_Search') then v_name :='EditACC_NO';

   name:=v_Name;

   SearchOptions := [srIgnoreCase ,srPartialMatch ];

   with Sender as TEdit  do
   begin
    SearchField := copy(Name,5,length(Name));

    with Accounts do begin
     if (UpperCase(SearchField) ='ACC_NO') or (UpperCase(SearchField) ='NAME1')
      or (UpperCase(SearchField) ='OLD_ACC_NO')
      then
      begin
        SQL[17]:=(' and lower('+SearchField+') like '''+LowerCase(Text)+'%''');
      end
      else if (UpperCase(SearchField) ='OPEN_DAT') or (UpperCase(SearchField) ='CLOSE_DAT')
       or (UpperCase(SearchField) ='USERINSERT')
       then begin
        SQL[17] := (':pSearch');
        SetVariable('pSearch', ' and lower('+SearchField+') = '''+LowerCase(Text)+'''');
       end
      else begin
       SQL[17] := (':pSearch');
       SetVariable('pSearch', ' and lower('+SearchField+') = '+LowerCase(Text));
      end;
     if Trim(Text)='' then SetVariable('pSearch', '');
     Refresh;
    end;
   end;
  end;
end;


end.
