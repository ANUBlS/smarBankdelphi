package NewDepositsProlongation;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CMVCL50,
  DclEhlib150,
  Ehlib150,
  SBTranslate,
  NewDepositsCommon,
  rtl;

contains
  NewDepositsFrmAddProlongationImpl in 'NewDepositsFrmAddProlongationImpl.pas' {NewDepositsFrmAddProlongation},
  NewDepositsFrmProlongationImpl in 'NewDepositsFrmProlongationImpl.pas' {NewDepositsFrmProlongation};

end.
