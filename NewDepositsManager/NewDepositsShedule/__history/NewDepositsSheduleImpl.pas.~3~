  implementation

 uses NewCommonDeclsImpl,NewDepositsScheduleDataModuleImpl, NewDepositsPaymentSheduleimpl,SBTranslateProc,sboapiDataModuleimpl;

{$R *.dfm}
   procedure exportproc(S:String);export;
  const
    rsScheludeCaption = '%s № li müqavilə üçün ödəmə planı.';
  begin
  NewDepositsFrmSheduleImpl.Caption := Format(rsScheludeCaption,[Get_SelectedContNo]);
   depositid:=Get_SelectedContID;
   with NewDepositsScheduleDataModule.sbdm_customers do
   begin
     close;
     ClearVariables;
     SetVariable('ID',depositid);
     Open;
   end;
    with NewDepositsScheduleDataModule.OracleDataSet1 do
    begin
     close;
     ClearVariables;
     SetVariable('ID',depositid);
     Open;
   end;
   with  NewDepositsScheduleDataModule.OracleDataSet2 do
   begin
     close;
     ClearVariables;
     SetVariable('id',depositid);
     Open;
   end;
   with  NewDepositsScheduleDataModule.OracleDataSet3 do
   begin
     close;
     ClearVariables;
     SetVariable('v_id',depositid);
     Open;
   end;
   NewDepositsFrmShedule.ShowModal;
end;

