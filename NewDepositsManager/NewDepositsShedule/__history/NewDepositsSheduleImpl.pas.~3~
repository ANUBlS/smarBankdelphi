procedure TNewDepositsFrmShedule.ToolButton14Click(Sender: TObject);

resourcestring rs_DelshedulePayments = ' Silinməsinə Əminsinizmi? ';
var
  I : Integer;
begin

 if MessageDlg(rs_DelshedulePayments,
      mtConfirmation, [mbYes, mbNo], 0) = mrNO then  Exit;

  with SchduleGrid do
  for I := SelectedRows.Count - 1 downto 0 do
  begin
    DataSource.DataSet.GotoBookmark(Pointer(SelectedRows[I]));
    DataSource.DataSet.Delete;
  end;
end;

procedure TNewDepositsFrmShedule.ToolButton18Click(Sender: TObject);

var interval:variant;
begin
  NewDepositsPaymentShedule:=TNewDepositsPaymentShedule.Create(Self);
  with NewDepositsPaymentShedule,
       NewDepositsScheduleDataModule,
       sbcm_percent_converting do
  begin
    //DateTimePicker1.DateTime:=Sbcm_date_new.CallDateFunction('get_date',[]);
    interval:=CallIntegerFunction('getdateinterval',[strtodate(DBEdit3.text),strtodate(DBEdit4.text)]);
    CMCurrencyEdit1.Value:=CallIntegerFunction('getconverteddebt',[interval,strtofloat(DBEdit1.text),strtofloat(DBEdit2.text)]);
    Edit1.Text:=OracleDataSet3DATEINTERVAL.AsString;
    ToolButton1.Enabled:=true;
    ToolButton14.Enabled:=true;
    ShowModal;
  end;
end;

procedure TNewDepositsFrmShedule.ToolButton1Click(Sender: TObject);
begin
   with NewDepositsScheduleDataModule, OracleDataSet2.Session do
  begin
    ApplyUpdates([OracleDataSet2],True);
    Commit;
    ToolButton1.Enabled:=FALSE;
  end;
end;

initialization

    NewDepositsFrmShedule := TNewDepositsFrmShedule.Create(CommonApplication);
    NewDepositsScheduleDataModule:=TNewDepositsScheduleDataModule.Create(CommonApplication);
end.
