{$R *.dfm}

uses sboapiDataModuleImpl;

procedure TNewDepsitDataModule.DataModuleCreate(Sender: TObject);
begin
  with  DmDataSet do
  begin
    SetVariable('OrderField','cont.id');
    Open;
  end;

   BankDate.Open;
   FilialID.Open;
   Valutes.Open;
   Filials.Open;
   DepositTypes.Open;
   Categories.Open;
   persons.Open;
   users.Open;
end;

procedure TNewDepsitDataModule.DataModuleDestroy(Sender: TObject);
begin
  DmDataSet.CloseAll;
  BankDate.Open;
  FilialID.Open;
  Valutes.CloseAll;
  Filials.CloseAll;
  DepositTypes.CloseAll;
  Categories.CloseAll;
  persons.CloseAll;
  users.CloseAll;
end;

