    DmDataSetCUSTOMERNAME: TWideStringField;
    DmDataSetOPENDATE: TDateTimeField;
    DmDataSetCLOSEDATE: TDateTimeField;
    DmDataSetAMOUNT: TFloatField;
    DmDataSetINTEREST: TFloatField;
    DmDataSetFACTICALDEBT: TFloatField;
    DmDataSetFACTICALINTERESTDEBT: TFloatField;
    DmDataSetCURRENCY: TFloatField;
    DmDataSetPERSONALTYPE: TFloatField;
    DmDataSetCLIENTTYPE: TFloatField;
    DmDataSetBRANCHID: TFloatField;
    DmDataSetCONTRACTTYPE: TIntegerField;
