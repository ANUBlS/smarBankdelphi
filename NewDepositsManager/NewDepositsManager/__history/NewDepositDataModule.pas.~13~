var
  NewDepsitDataModule: TNewDepsitDataModule;

implementation

{$R *.dfm}

uses sboapiDataModuleImpl;

procedure TNewDepsitDataModule.DataModuleCreate(Sender: TObject);
begin
  with  DmDataSet do
  begin
    SetVariable('OrderField','cont.id');
    Open;
  end;

   BankDate.Open;
   FilialID.Open;
   Valutes.Open;
   Filials.Open;
   dm_types.Open;
   dm_categories.Open;
   dm_persons.Open;
   users.Open;
end;

procedure TNewDepsitDataModule.DataModuleDestroy(Sender: TObject);
begin
  DmDataSet.CloseAll;
  BankDate.Open;
  FilialID.Open;
  Valutes.CloseAll;
  Filials.CloseAll;
  dm_types.CloseAll;
  dm_categories.CloseAll;
  dm_persons.CloseAll;
  users.CloseAll;
end;

end.
