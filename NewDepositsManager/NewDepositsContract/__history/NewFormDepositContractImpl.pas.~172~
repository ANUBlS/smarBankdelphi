function TNewFormDepositContract.New:integer;
resourcestring
   rs_NewContract = 'Müqavilənin  əlavə olunması';
begin
   FInserted := True;
   AddContract;
   Caption := rs_NewContract;
   Lbluser.Visible := false;
   Label13.Visible := false;
   ComboBoxPrize.ItemIndex:=0;
   ComboBoxCard.ItemIndex:=0;
   Result := ShowModal;
end;

function TNewFormDepositContract.Edit:Integer;
resourcestring
   rs_EditContract = '%s № li müqavilənin redaktə olunması';
var FContractNo :String;
begin

   FContractNo := Get_SelectedContNo;
   EditContract;
   Caption := Format(rs_EditContract,[FContractNo]);
   Lbluser.Visible := true;
   Label13.Visible := true;
   Lbluser.Caption := NewDataModDepositsContract.DepositPorps.FieldByName('username').AsString;
