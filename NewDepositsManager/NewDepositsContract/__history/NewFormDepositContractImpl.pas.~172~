procedure exportproc(S:String);export;
const
   csAddContract = 'InsertContract';
   csEditContract = 'EditContract';
   csLookContract = 'LookContract';
Var ResultOp : Integer;
begin
   if S = csAddContract then
   begin
     NewFormDepositContract.PanelInsertVizible;
     NewFormDepositContract.XFBitBtn1.Visible:=True;
     NewFormDepositContract.XFBitBtn2.Visible:=True;
     With NewDataModDepositsContract,Filals do
      begin
        Filtered:=False;
        Filter:='';
      end;

     ResultOp := NewFormDepositContract.New;
   end;

   if S = csEditContract then
   begin
     NewFormDepositContract.PanelUpdateVizible;
     NewFormDepositContract.XFBitBtn1.Visible:=True;
     NewFormDepositContract.XFBitBtn2.Visible:=True;
     ResultOp := NewFormDepositContract.Edit;
   end;
   if S=csLookContract then
   begin
     NewFormDepositContract.PanelUpdateVizible;
     NewFormDepositContract.XFBitBtn1.Visible:=False;
     NewFormDepositContract.XFBitBtn2.Visible:=False;
     ResultOp := NewFormDepositContract.Edit;
   end;

end;

