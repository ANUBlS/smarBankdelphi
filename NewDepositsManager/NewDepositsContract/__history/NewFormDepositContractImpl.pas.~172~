procedure TNewFormDepositContract.SaveState(Save :Boolean);
begin
  with NewDataModDepositsContract,DepositPorps do
  begin
    if  Save then
        Post else
        Cancel;

    if  FInserted then
    begin
       if Save then
       begin
         AddAccount;
      //   RefreshAllDeposits;
         AddContract;
       end
       else
       Cancel;
       DBLCBFilial.SetFocus;
    end else
    Self.Close;

  end;
end;

