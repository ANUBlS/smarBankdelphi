procedure TNewFormDepositContract.PanelInsertVizible;
var
  i,j:integer;
begin
  NewDataModDepositsContract.DmContractType.Close;
  NewDataModDepositsContract.DmContractType.Open;
  NewDataModDepositsContract.DmContractType.First;
  With NewDataModDepositsContract do
  begin
    for i:=0 to DmContractType.RecordCount-1 do
    begin
      for j:=0 to NewFormDepositContract.ComponentCount-1 do
      begin
        if NewFormDepositContract.Components[j] is TXFPanel then
        begin
          if ((NewFormDepositContract.Components[j] as TXFPanel).Name=DmContractTypeNAME.AsString) then
          begin
            if DmContractTypePANELTYPE.AsInteger=1 then
             begin
              (NewFormDepositContract.Components[j] as TXFPanel).Visible:=True;
              (NewFormDepositContract.Components[j] as TXFPanel).Top:=DmContractTypeTOPID.AsInteger;
             end
            else  (NewFormDepositContract.Components[j] as TXFPanel).Visible:=False;
          end;
        end;
      end;
      DmContractType.Next;
    end;
  end;
   NewFormDepositContract.Height:=ClientHeight;
   NewFormDepositContract.Position:=poScreenCenter;
end;
procedure TNewFormDepositContract.PanelUpdateVizible;
var
  i,j,k,n:integer;
  S:string;
begin
  NewDataModDepositsContract.DmContractType.Close;
  NewDataModDepositsContract.DmContractType.Open;
  NewDataModDepositsContract.DmContractType.First;
  n:=NewFormDepositContract.ComponentCount-1;
 // ShowMessage('aaa');
  With NewDataModDepositsContract do
  begin
    for i := 0 to DmContractType.RecordCount-1 do
    begin
      for j:=n downto 0 do
      begin
        IF NewFormDepositContract.Components[j] is TXFPanel THEN
        IF ((NewFormDepositContract.Components[j] as TXFPanel).Name=DmContractTypeNAME.AsString) THEN
        IF (NewFormDepositContract.Components[j] as TXFPanel).Name <>'ThirdPersonNamePanel' THEN
        begin
          (NewFormDepositContract.Components[j] as TXFPanel).Align:=alNone;
          (NewFormDepositContract.Components[j] as TXFPanel).Visible:=True;
          (NewFormDepositContract.Components[j] as TXFPanel).Top:=DmContractTypeTOPID.AsInteger;
          (NewFormDepositContract.Components[j] as TXFPanel).Align:=alTop;
          DmContractType.Next;
        end;
        IF (NewFormDepositContract.Components[j] is TXFLabel) THEN
        begin
          IF ((NewFormDepositContract.Components[j] as TXFLabel).Name ='XFLU1') or
             ((NewFormDepositContract.Components[j] as TXFLabel).Name ='XFLU2') or
             ((NewFormDepositContract.Components[j] as TXFLabel).Name ='XFLU3') or
             ((NewFormDepositContract.Components[j] as TXFLabel).Name ='XFLU4') or
             ((NewFormDepositContract.Components[j] as TXFLabel).Name ='XFLU5') or
             ((NewFormDepositContract.Components[j] as TXFLabel).Name ='XFLU6') or
             ((NewFormDepositContract.Components[j] as TXFLabel).Name ='XFLU7') or
             ((NewFormDepositContract.Components[j] as TXFLabel).Name ='XFLU8')
          THEN (NewFormDepositContract.Components[j]  as TXFLabel).Left:=3
          ELSE (NewFormDepositContract.Components[j]  as TXFLabel).Left:=12
        end;
        IF (NewFormDepositContract.Components[j] is TDBDateTimeEditEh) THEN
        begin
          (NewFormDepositContract.Components[j]  as TDBDateTimeEditEh).Left:=193;
        end;
        IF NewFormDepositContract.Components[j]  is TDBEditEh THEN
        begin
          (NewFormDepositContract.Components[j]  as TDBEditEh).Left:=193;
        end;
        IF NewFormDepositContract.Components[j]  is TDBLookupComboboxEh THEN
        begin
          (NewFormDepositContract.Components[j]  as TDBLookupComboboxEh).Left:=193;
        end;
        IF NewFormDepositContract.Components[j]  is TDBNumberEditEh THEN
        begin
          (NewFormDepositContract.Components[j]  as TDBNumberEditEh).Left:=193;
        end;

      end;
    end;
  end;
  NewFormDepositContract.Height:=ClientHeight;
  NewFormDepositContract.Position:=poScreenCenter;
end;

procedure TNewFormDepositContract.LCBCapPerChange(Sender: TObject);

var period:integer;
begin
//  LCBPeriodsChange(Sender);
  With NewDataModDepositsContract,SaveDeposit,DepositPorps,Dm_Contract do
  begin
    IF Active
    THEN
      BEGIN
        period       := LCBPeriods.ListSource.DataSet.FieldByName('period').AsInteger;
        periodtype   := LCBPeriods.ListSource.DataSet.FieldByName('period_type').AsString;
        depid        := ContractTypes.ListSource.DataSet.FieldByName('id').AsInteger;
        periodid     := LCBPeriods.ListSource.DataSet.FieldByName('id').AsInteger;
        capitalperid := LCBCapPer.ListSource.DataSet.FieldByName('id').AsInteger;
        currency     := DBLCBValutes.ListSource.DataSet.FieldByName('valute').AsInteger;

        if not VarIsNull(DBNumberEditeh.Value) then amount := StrToFloat(VarToStr(DBNumberEditeh.Value))
                                               else amount :=0.00;

        if periodtype='İL'  then  DepositPorpsCloseDate.AsDateTime := IncYear(DepositPorpsOpenDate.AsDateTime,period);
        if periodtype='AY'  then  DepositPorpsCloseDate.AsDateTime := IncMonth(DepositPorpsOpenDate.AsDateTime,period);
        if periodtype='GÜN' then  DepositPorpsCloseDate.AsDateTime := DepositPorpsOpenDate.AsDateTime + period;

        if period = 0 then DtClose.Enabled := False
                      else DtClose.Enabled := True;

        DmDepositPerSettings.Close;
        DmDepositPerSettings.SetVariable('depid',depid);
        DmDepositPerSettings.SetVariable('periodid',periodid);
        DmDepositPerSettings.SetVariable('capitalid',capitalperid);
        DmDepositPerSettings.SetVariable('currencyid',currency);
        DmDepositPerSettings.SetVariable('amount',amount);
        DmDepositPerSettings.Open;

        if FInserted then
        begin
          DbEditPercent.Value   :=DmDepositPerSettingsInterestRate.AsFloat;
          DbDuePercent.Value    :=DmDepositPerSettingsDueIntRate.AsFloat;
          DbOverDuePercent.Value:=DmDepositPerSettingsBefoIntRate.AsFloat;
        end
        else
        begin
          DbEditPercent.Value   :=DepositPorpsINTEREST.AsFloat;
          DbDuePercent.Value    :=DepositPorpsDUEINTEREST.AsFloat;
          DbOverDuePercent.Value:=DepositPorpsOVERDUEINTEREST.AsFloat;
        end;

        FDepPerSetid          :=DmDepositPerSettingsID.AsInteger;

        DmProlanqasiya.Close;
        DmProlanqasiya.Open;
        ChAutopr.KeyValue  :=FieldByName('prolanid').AsInteger;
      END;
  period := LCBCapPer.ListSource.DataSet.FieldByName('period').AsInteger;
  IF period>0 then
   with NewDataModDepositsContract,DepositPorps do
   FieldByName('FIRSTINTERESTPAYDAT').AsDateTime := IncMonth(FieldByName('OpenDate').AsDateTime,period div 30)
  ELSE
   with NewDataModDepositsContract,DepositPorps do
   FieldByName('FIRSTINTERESTPAYDAT').AsDateTime := IncMonth(FieldByName('OpenDate').AsDateTime,period)
  end;


end;

