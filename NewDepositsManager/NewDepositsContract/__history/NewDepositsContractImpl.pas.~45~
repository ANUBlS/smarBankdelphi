  ClientTypes.CloseAll;
  Persons.CloseAll;
  Customers.CloseAll;
  DmContractType.CloseAll;
  ODSAccno.CloseAll;
end;

procedure TNewDataModDepositsContract.DepositPorpsApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: string);
begin
 with SaveDeposit,dm_contract do
   begin
      case Action of
      'I': begin
            CallProcedure('dmaddcontract',[
            'p_ContractID',contractid
           ,'p_Type',TypeD
           ,'p_OpenDate',OpenDate
           ,'p_CloseDate' ,CloseDate
           ,'p_Amount',Amount
           ,'p_ContractNo',ContractNo
           ,'p_ContractType', ContractType
           ,'p_ClientType' ,ClientType
           ,'p_Percent',Interest
           ,'p_OverduePercent',overdueinterest
           ,'p_DuePercent',dueinterest
           ,'p_personaltype',personaltype
           ,'p_currency',currency
           ,'p_branchid',branchid
           ,'p_customerid',Customerid
           ,'p_stopCalcdate',FirstPayDateforInt
           ,'p_PeriodID',PeriodID
           ,'p_capitalperid',capitalperid
           ,'p_autopr',autopr
           ,'p_tocard',tocard
           ,'p_agentid',agentid
           ]);
        Applied := True;
        end;

      'U': begin
            CallProcedure('dmupdatecontract',[
            'p_ContractID',Get_SelectedContID
           ,'p_Type',TypeD
           ,'p_OpenDate',OpenDate
           ,'p_CloseDate' ,CloseDate
           ,'p_Amount',Amount
           ,'p_ContractNo',ContractNo
           ,'p_ContractType', ContractType
           ,'p_ClientType' ,ClientType
           ,'p_Percent',Interest
           ,'p_OverduePercent',overdueinterest
           ,'p_DuePercent',dueinterest
           ,'p_personaltype',personaltype
           ,'p_currency',currency
           ,'p_branchid',branchid
           ,'p_customerid',Customerid
           ,'p_stopCalcdate',FirstPayDateforInt
           ,'p_PeriodID',PeriodID
           ,'p_capitalperid',capitalperid
           ,'p_autopr',autopr
           ,'p_tocard',tocard
           ,'p_agentid',agentid
            ]);

        Applied := True;

        end;
      end;
   end;

           end;

procedure TNewDataModDepositsContract.DepositPorpsCalcFields(DataSet: TDataSet);
begin
   with DataSet do
        FieldByName('PeriodContracts').AsInteger
          := dm_contract.CallIntegerFunction('GetPeriod',
          ['bdat',FieldByname('opendate').AsDateTime,
           'edat',FieldByname('closedate').AsDateTime ]);
end;

procedure TNewDataModDepositsContract.DepositPorpsCUSTOMERIDChange(
  Sender: TField);
begin
   with NewFormDepositContract do
        ShowAccounts;
end;



