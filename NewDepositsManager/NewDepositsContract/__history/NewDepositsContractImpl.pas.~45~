  Filals.Open;
  DepositTypes.Open;
  ClientTypes.Open;
  Persons.Open;
  Customers.Open;
  DmContractType.Open;
  ODSAccno.Open;
end;

procedure TNewDataModDepositsContract.DataModuleDestroy(Sender: TObject);
