  SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TNewDepositsFrmAddCapitalize.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if Ord(Key) = VK_ESCAPE then Close
end;

procedure TNewDepositsFrmAddCapitalize.FormShow(Sender: TObject);
var ClientFact:Real;
begin
   NewDepositsFrmCapitalize.DepositInfo.Refresh;
   DTPOperation.DateTime := Get_BankDate;
   ClientFact:=NewDepositsFrmCapitalize.dm_payment.CallFloatFunction('SetResiduaryAmount',['ContractID',Get_SelectedContID,
                                                                                            'Wdate',Get_BankDate]);
   EdIntDebit.Value := 0;
   EdClientDebit.Value:=ClientFact;
end;

procedure TNewDepositsFrmAddCapitalize.XFButton2Click(Sender: TObject);
begin
 Close
end;

procedure TNewDepositsFrmAddCapitalize.ActnTransExecute(Sender: TObject);

resourcestring
  rsTransactionsWillProcessed = 'Kapitallaşdırma ...';
var
    CommitCapitalize :Boolean;

begin

    with NewDepositsFrmCapitalize,dm_payment do
     CallProcedure('Capitalization',['ContractID',Get_SelectedContID,
                                    'HDate',Get_BankDate,
                                    'InterestDebtWithdraw',EdIntDebit.value,
                                    'ClientDebtWithdraw',EdClientDebit.Value,
                                    'showTransaction',5]);

    try
    CommitCapitalize := TrDelayed_Show(Self,rsTransactionsWillProcessed);

    Update;

    NewDepositsFrmCapitalize.dm_payment.CallProcedure('CommitWithDrawMoney',[
       'DoCommit',CommitCapitalize
    ]);

    if CommitCapitalize then
    Self.ModalResult := mrOk;
    Self.Update;
  except


    NewDepositsFrmCapitalize.dm_payment.CallProcedure('CommitWithDrawMoney',['DoCommit',
        False
    ]);

    raise;

  end;


end;
  procedure TNewDepositsFrmAddCapitalize.ActnTransUpdate(Sender: TObject);
begin
   with (Sender as TAction) do
         Enabled := (EdIntDebit.Value+EdClientDebit.Value) > 0
end;
end.
