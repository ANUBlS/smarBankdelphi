package InsVCL50;

{$R *.res}
{$R 'Packages\Insurance\InsVCL50\INSWordExporter.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart Insurence Visual Components Library'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sbplg50,
  dclofficexp;

contains
  FlatSpeed in 'Packages\Insurance\InsVCL50\FlatSpeed.pas',
  PanelSpeed in 'Packages\Insurance\InsVCL50\PanelSpeed.pas',
  MDIChildPanel in 'Packages\Insurance\InsVCL50\MDIChildPanel.pas',
  UIMDIMainCaller in 'Packages\Insurance\InsVCL50\UIMDIMainCaller.pas',
  UPlgContainer in 'Packages\Insurance\InsVCL50\UPlgContainer.pas' {fmContainer},
  PlgModalContainer in 'Packages\Insurance\InsVCL50\PlgModalContainer.pas',
  INSWordExporter in 'Packages\Insurance\InsVCL50\INSWordExporter.pas';

end.
