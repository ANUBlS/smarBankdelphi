# ---- Database ---------------------------------------------------------------
# mock  = run without Oracle (fixtures in api/fixtures)   oracle = real database
DB_MODE=mock
# Exactly one database per deployment (login page asks only username + password)
ORACLE_HOST=oradb.example.local
ORACLE_PORT=1521
ORACLE_SERVICE=SB-CURRENT
# Optional: full DSN / Easy Connect string; overrides host/port/service
# ORACLE_DSN=oradb.example.local:1521/SB-CURRENT
# No DB user/password here: every user logs on with their own Oracle account (like the Delphi app).

# ---- Application -----------------------------------------------------------
PRODUCT_NAME=SmartBank
SYSTEM_INI_NAME=SmartBankIni
TREE_INI_SECTION=Tree
PLUGIN_INI_SECTION=PluginManager
HIDE_DENIED_NODES=false
DEFAULT_LANG=en
WEB_PORT=8080

# ---- Security ----------------------------------------------------------------
SESSION_IDLE_MINUTES=45      # auto sign-out after inactivity (server closes the Oracle session)
MAX_LOGON_RETRY=3            # Delphi rule: 3 attempts per login dialog ...
LOGIN_LOCK_SECONDS=300       # ... then this cooldown (web equivalent of the app closing)
LOGIN_MAX_FAILED=5           # consecutive failures -> username locked app-side until an admin unlocks
COOKIE_SECURE=false          # set true behind HTTPS
# AZIPS file generation (part 3): Delphi Writeln writes in the client's Windows ANSI code page; decimal separator of that PC;
# optional server folder that receives a copy of every generated file (Delphi wrote to sw_settings.path_out)
AZIPS_FILE_CODEPAGE=cp1254
AZIPS_DECIMAL_SEPARATOR=,
AZIPS_OUT_DIR=
# XÖHKS file preparation (PrepareFile CreateFile): code page of the Writeln lines (the MessageBody is UTF-8 as in Delphi),
# optional server folder for a copy of every file (Delphi wrote XS_CONFIG.out_dir\<ref>.xml), signer none | mock
XOHKS_FILE_CODEPAGE=cp1254
XOHKS_OUT_DIR=
# Line break width inside the hidden RichEdit1 for the IN file parser: cr (Delphi XE RichEdit 2.0, default) or crlf (RichEdit 1.0)
XOHKS_RICHEDIT_BREAK=cr
XOHKS_SIGNER=none
# Cards Application 'FAYL YARAT' (applicationpas.pas cr_file1/cr_file2): code page and decimal separator of the Delphi client;
# optional server folder standing for C:\AZCARD\OUT (files go to <dir>/<DDMMYY>/ and count for the next file number)
CARDS_FILE_CODEPAGE=cp1254
CARDS_DECIMAL_SEPARATOR=,
CARDS_OUT_DIR=

# AZIPS UFX card credit (UFX71.pas fundstransfer SOAP service). mock = canned responses, never calls the network
# (default when DB_MODE=mock); real = POST to UFX_URL (Delphi default below).
UFX_MODE=mock
# Test address (UFX71.pas defURL). TODO production: replace with the production UFX URL.
UFX_URL=http://10.0.11.96:8080/UFXFundsTransfer/UFX7
UFX_TIMEOUT=60
# TODO production (https only): CA bundle and client certificate/key paths. Empty = not used.
UFX_CA_FILE=
UFX_CLIENT_CERT=
UFX_CLIENT_KEY=

# Exchange "Fayla yaz" (DBF exports): folder with the bank's EXCH122.dbf and $MB12212.dbf templates (from the Delphi
# client folder). Default: api/templates (Oracle mode) / api/fixtures/dbf (mock mode, test templates).
# DBF_TEMPLATE_DIR=/app/templates
# DBF_ENCODING=cp1251
# DBF_DECIMAL_SEPARATOR=,

# ExchangeMGR account set-up (UnitExAccModify FormActivate): the balance accounts read from the Delphi client's local
# ExchangeBalance.ini [DefaultBalance] Bal_Manat / Bal_Valuta / Bal_Gelir / Bal_Zerer and Exchange.ini [DefaultBalance]
# Balance_Main_Debt / Balance_Main_Cred. Empty -> '-1' (as in Delphi: the account lists stay empty).
EM_BAL_MANAT=
EM_BAL_VALUTA=
EM_BAL_GELIR=
EM_BAL_ZERER=
EM_BALANCE_MAIN_DEBT=
EM_BALANCE_MAIN_CRED=
