const
   csAddContract = 'InsertContract';
   csEditContract = 'EditContract';
Var ResultOp : Integer;
begin
   if S = csAddContract then
      ResultOp := frmDepositContract.New;

   if S = csEditContract then
      ResultOp := frmDepositContract.Edit;

end;

exports
   exportproc;


procedure TfrmDepositContract.AddContract;
var i,k:integer;
begin
   with dmDepositContract,DepositPorps do
   begin
      if Active then CloseAll;
      SetVariable('CONTRACTID',0);
      Open;
      Insert;
      FieldByName('CURRENCY').AsInteger := 0;
      FieldByName('Branchid').AsInteger := Get_FilialID;
      FieldByName('OpenDate').AsDateTime := Get_BankDate;
      FieldByName('Closedate').AsDateTime := Get_BankDate;
      FieldByName('FIRSTINTERESTPAYDAT').AsDateTime := Get_BankDate;
     // FieldByName('Amount').AsVariant:='0.00';
     // FieldByName('interest').AsVariant:='0.00';
     // FieldByName('overdueinterest').AsVariant:='0.00';
     // FieldByName('dueinterest').AsVariant:='0.00';
      With dmDepositContract do
      begin
        ContractTypes.Items.Clear;
        DepositTypes.Close;
        DepositTypes.Open;
        DepositTypes.First;
        for i:=0 to DepositTypes.RecordCount-1 do
        begin
          ContractTypes.Items.Add(DepositTypes.FieldByName('type').AsString);
          DepositTypes.Next;
        end;
        ContractTypes.Text:='';
      end;
      With dmDepositContract do
      begin
        CBCategories.Items.Clear;
        DepositTypes.Close;
        DepositTypes.Open;
        ClientTypes.First;
        for k:=0 to ClientTypes.RecordCount-1 do
        begin
          CBCategories.Items.Add(ClientTypes.FieldByName('category').AsString);
          ClientTypes.Next;
        end;
        CBCategories.Text:='';
      end;

   end;

end;

procedure TfrmDepositContract.EditContract;
  procedure LocateAccounts(LookupControl : TDBLookupComboboxEh);
  begin
    with LookupControl do
    if (not VarIsNull(DataSource.DataSet.FieldByName(DataField).AsVariant))
     and (DataSource.DataSet.FieldByName(DataField).AsInteger <> 0) then
    begin
      KeyValue := Null;
      KeyValue := ListSource.DataSet.FieldByName(KeyField).AsInteger;
    end;
  end;

var contid:integer;
    i,k:integer;
begin
   FInserted := False;
   with dmDepositContract,DepositPorps do
   begin
      contid:=Get_SelectedContID;
      if Active then CloseAll;
      SetVariable('CONTRACTID',Get_SelectedContID);
      Open;
      Edit;

      With dmDepositContract do
      begin
        ContractTypes.Items.Clear;
        DepositTypes.Close;
        DepositTypes.Open;
        DepositTypes.First;
        for i:=0 to DepositTypes.RecordCount-1 do
        begin
          ContractTypes.Items.Add(DepositTypes.FieldByName('type').AsString);
          DepositTypes.Next;
        end;
      end;

      With dmDepositContract do
      begin
        CBCategories.Items.Clear;
        ClientTypes.Close;
        ClientTypes.Open;
        ClientTypes.First;
        for k:=0 to ClientTypes.RecordCount-1 do
        begin
          CBCategories.Items.Add(ClientTypes.FieldByName('category').AsString);
          ClientTypes.Next;
        end;


      end;



      with DepositTypes1 do
      begin
        Close;
        SetVariable('vid',DepositPorps.FieldByName('contracttype').AsInteger);
        Open;
        ContractTypes.ItemIndex:=ContractTypes.Items.IndexOf(FieldByName('type').AsString);
      end;

      with ClientTypes1 do
      begin
        Close;
        SetVariable('vid',DepositPorps.FieldByName('clienttype').AsInteger);
        Open;
        CBCategories.ItemIndex:=CBCategories.Items.IndexOf(FieldByName('category').AsString);
      end;


      ShowAccounts;
      FEdited := True;
   end;

end;

  procedure TfrmDepositContract.ShowAccounts;
  var CustomerID,CONTRACTACCID,
      InterestAccID,ClientAccID :Integer;

  begin
    with   dmDepositContract do
    begin
      with DepositPorps do
      begin
        CustomerID := FieldByName('CustomerID').AsInteger;
        CONTRACTACCID := FieldByName('CONTRACTACCID').AsInteger;
        InterestAccID := FieldByName('InterestAccID').AsInteger;
        ClientAccID := FieldByName('ClientAccID').AsInteger;
      end;
      with DepositAccs do
      begin
        if Active then CloseAll;
        SetVariable('CustID',CustomerID);
        Open;
      end;


      with InterestsAccs do
      begin
        if Active then CloseAll;
        SetVariable('CustID',CustomerID);
        Open;
      end;

    end;

   with DBLookupComboboxEh9,DataSource.DataSet do
         KeyValue := CONTRACTACCID;

   with DBLookupComboboxEh10,DataSource.DataSet do
         KeyValue := ClientAccID;

   with DBLookupComboboxEh11,DataSource.DataSet do
         KeyValue := InterestAccID;



end;




