  object Deposits: TOracleDataSet
    SQL.Strings = (
      'Select'
      '  ContrCorrect.RowID'
      ' ,ContrCorrect.*'
      '  From '
      '   SBCM_Contract_Correction ContrCorrect'
      ' Where '
      '    ('
      '      ContrCorrect.Type#=('
      '      Select  ID'
      '        From  SBCM_Contract_Types'
      '         Where upper(Name)= '#39'DEPOSIT'#39')'
      '     )'
      '--order by :OrderKind'
      ' ')
