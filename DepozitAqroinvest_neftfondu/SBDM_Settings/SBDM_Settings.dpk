package SBDM_Settings;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  sboapi50,
  CMVCL50,
  DclEhlib150,
  DOA41dxe,
  Ehlib150,
  SBDM_Common;

contains
  DMReferences in 'DMReferences.pas' {DataModReferences: TDataModule},
  frmReferencesImpl in 'frmReferencesImpl.pas' {FrmReferences},
  ReferLoader in 'ReferLoader.pas',
  frmAccGroupsImpl in 'frmAccGroupsImpl.pas' {frmAccGroups},
  frmCategoriesImpl in 'frmCategoriesImpl.pas' {frmCategories},
  frmDepositTypesImpl in 'frmDepositTypesImpl.pas' {frmDepositTypes},
  frmAddEditDepositTypesImpl in 'frmAddEditDepositTypesImpl.pas' {frmAddEditDepositTypes},
  frmAccountTurningImpl in 'frmAccountTurningImpl.pas' {frmAccountTurning},
  frmAddEditAccTurningImpl in 'frmAddEditAccTurningImpl.pas' {frmAddEditAccTurning};

end.
