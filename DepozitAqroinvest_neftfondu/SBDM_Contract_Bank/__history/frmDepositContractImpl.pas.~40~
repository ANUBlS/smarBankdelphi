procedure TfrmDepositContract.SaveState(Save :Boolean);
begin
  with dmDepositContract,DepositPorps do
  begin
    if  Save then
        Post else
        Cancel;

    if  FInserted then
    begin
       if Save then
       AddContract else
       Cancel;
       DBLCBFilial.SetFocus;
    end else
    Self.Close;

  end;
end;

