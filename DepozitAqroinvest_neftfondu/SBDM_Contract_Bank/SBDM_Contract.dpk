package SBDM_Contract;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  DclEhlib150,
  doa41dxe,
  Ehlib150,
  sboapi50,
  CMVCL50,
  SBDM_Common;

contains
  dmDepositContractImpl in 'dmDepositContractImpl.pas' {dmDepositContract: TDataModule},
  frmDepositContractImpl in 'frmDepositContractImpl.pas' {frmDepositContract},
  ContractCommonDecls in 'ContractCommonDecls.pas';

end.
