unit SbdmReportUnit;


interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, Buttons, ExtCtrls;

type
  TFormReport = class(TForm)
    RGReport: TRadioGroup;
    BitBtn2: TBitBtn;
    BitBtn1: TBitBtn;
    procedure BitBtn2Click(Sender: TObject);
  private
    procedure exportreport;
    procedure exportexel;
  public
    { Public declarations }
  end;

var
  FormReport: TFormReport;

implementation

uses SbdmScheduleDataModuleImpl;

{$R *.dfm}

procedure TFormReport.BitBtn2Click(Sender: TObject);
begin
  with RGReport
  do
   case ItemIndex of
    0:exportreport;
    1:exportexel;
   end;
  end;

procedure TFormReport.exportexel;
begin
   with SbdmScheduleDataModule,ExportData do begin
   if Active then close;
   setvariable('Creditid',Get_SelectedCrdID);
   open;
   with ExcelExport do
   begin
   connect;
   ExportDataset(ExportData,'Ödəmə planı',true,false);
   Disconnect;
   end;
   end;
end;



end.
