procedure TForm1.ActionAddExecute(Sender: TObject);
 function PlaneInsert() : Boolean;
  begin
    with SbdmScheduleDataModule.OracleDataSet2 do
    begin
      Insert;
      FieldByName('id#').AsInteger := depositid;
    end;
    Result := SbdmAddEditForm.ShowModal = mrOk;
  end;

  function PlaneEdit() : Boolean;
  begin
    with SbdmScheduleDataModule.OracleDataSet2 do
      Edit;
    Result := SbdmAddEditForm.ShowModal = mrOk;
  end;

var
  SavePlace : TBookmark;
begin
  if (Sender as TAction).Tag = 1 then
  begin
    with SbdmScheduleDataModule.OracleDataSet2 do
    if PlaneInsert then
    begin
      Post;
      SavePlace := GetBookmark;
      Refresh;
      if BookmarkValid(SavePlace) then
        GotoBookmark(SavePlace);
      FreeBookmark(SavePlace);
    end
    else Cancel
  end else
  begin
    with SbdmScheduleDataModule.OracleDataSet2 do
    if PlaneEdit then
    begin
      Post;
      SavePlace := GetBookmark;
      Refresh;
      if BookmarkValid(SavePlace) then
        GotoBookmark(SavePlace);
      FreeBookmark(SavePlace);
    end else Cancel
  end;

end;


