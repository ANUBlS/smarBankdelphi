procedure TForm1.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  with SbdmScheduleDataModule do
  begin
    with OracleDataSet2.Session do
    Rollback;
    OracleDataSet1.CloseAll;
    OracleDataSet2.CloseAll;
    OracleDataSet3.CloseAll;
  end;
end;

