unit frmAccountTurningImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  ComCtrls, ToolWin, ExtCtrls, ImgList, Grids, DBGridEh, Db,
  OracleData, Oracle, ActnList;

type
  TfrmAccountTurning = class(TForm)
    ImageList1: TImageList;
    Panel2: TPanel;
    ToolBar1: TToolBar;
    ToolButton1: TToolButton;
    ToolButton2: TToolButton;
    ToolButton3: TToolButton;
    ToolButton4: TToolButton;
    ToolButton5: TToolButton;
    ToolButton9: TToolButton;
    ToolButton8: TToolButton;
    ToolButton7: TToolButton;
    ToolButton6: TToolButton;
    Panel1: TPanel;
    DBGridEh1: TDBGridEh;
    Panel3: TPanel;
    DBGridEh2: TDBGridEh;
    Panel4: TPanel;
    DBGridEh3: TDBGridEh;
    CategoriesDatSrc: TDataSource;
    Categories: TOracleDataSet;
    CategoriesID: TFloatField;
    movie_namesDatSrc: TDataSource;
    movie_names: TOracleDataSet;
    settings: TOracleDataSet;
    settingsDatSrc: TDataSource;
    Accounts: TOracleDataSet;
    AccountsDatSrc: TDataSource;
    Filials: TOracleDataSet;
    FilialsDatSrc: TDataSource;
    FilialsID: TFloatField;
    ValutesDatSrc: TDataSource;
    ActionList1: TActionList;
    ActnAdd: TAction;
    ActnEdit: TAction;
    ActnDel: TAction;
    sbcm_ds: TOraclePackage;
    valute: TOracleDataSet;
    CategoriesCATEGORY: TWideStringField;
    AccountsID: TFloatField;
    AccountsACC_NO: TWideStringField;
    AccountsNAME: TWideStringField;
    AccountsVAL_ACC: TIntegerField;
    FilialsNAME: TWideStringField;
    valuteVALUTE: TIntegerField;
    valuteVAL_NAME: TWideStringField;
    valuteVALU_NAME: TWideStringField;
    movie_namesID: TIntegerField;
    movie_namesTYPEID: TIntegerField;
    movie_namesDESCRIPTION: TWideStringField;
    settingsID: TFloatField;
    settingsPARENTID: TFloatField;
    settingsCURRENCYID: TFloatField;
    settingsACCID: TFloatField;
    settingsBRANCHID: TFloatField;
    settingscurrencyname: TWideStringField;
    settingsFILIALNAME: TWideStringField;
    settingsaccountnumber: TStringField;
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure ToolButton8Click(Sender: TObject);
    procedure ActnAddExecute(Sender: TObject);
    procedure ActnEditExecute(Sender: TObject);
    procedure ActnDelExecute(Sender: TObject);
    procedure ToolButton7Click(Sender: TObject);
    procedure ActnEditUpdate(Sender: TObject);
    procedure FormCanResize(Sender: TObject; var NewWidth,
      NewHeight: Integer; var Resize: Boolean);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure settingsApplyRecord(Sender: TOracleDataSet; Action: Char;
      var Applied: Boolean; var NewRowId: String);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmAccountTurning: TfrmAccountTurning;

implementation

{$R *.DFM}

uses  sboapiDataModuleImpl,frmAddEditAccTurningImpl;

procedure TfrmAccountTurning.FormCreate(Sender: TObject);
begin
     Categories.Open;
     Accounts.Open;
     Filials.Open;
     Valute.Open;
     movie_names.Open;
     settings.Open;
     frmAddEditAccTurning := TfrmAddEditAccTurning.Create(Self);
end;

procedure TfrmAccountTurning.FormDestroy(Sender: TObject);
begin
     Categories.CloseAll;
     Accounts.CloseAll;
     Filials.CloseAll;
     Valute.CloseAll;
     movie_names.CloseAll;
     settings.CloseAll;
     frmAddEditAccTurning.Free;
end;

procedure TfrmAccountTurning.ToolButton8Click(Sender: TObject);
begin
     Categories.Refresh;
     Accounts.Refresh;
     movie_names.Refresh;
     settings.Refresh;
end;

procedure TfrmAccountTurning.ActnAddExecute(Sender: TObject);
begin
   with settings do
         Insert;

    with frmAddEditAccTurning do
    begin
       Caption := 'Yeni';
       ShowModal;
    end;

   with settings do
         Refresh;

end;

procedure TfrmAccountTurning.ActnEditExecute(Sender: TObject);
begin
   with settings do
         Edit;

    with frmAddEditAccTurning do
    begin
       Caption := 'Redaktə';
       ShowModal;
    end;

   with settings do
         Refresh;

end;

procedure TfrmAccountTurning.ActnDelExecute(Sender: TObject);
begin
      if   MessageDlg('Silinməsinə  əminsiniz?'
              ,mtConfirmation
              ,[mbYes,mbNo],0
              )<>mrYes then Exit;

   with settings do
   begin
      Delete;
      Refresh;
   end;

end;

procedure TfrmAccountTurning.ToolButton7Click(Sender: TObject);
begin
  Close
end;

procedure TfrmAccountTurning.ActnEditUpdate(Sender: TObject);
begin
   with (Sender as TAction) do
        Enabled := settings.RecordCount > 0
end;

procedure TfrmAccountTurning.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize := false
end;

procedure TfrmAccountTurning.FormKeyPress(Sender: TObject; var Key: Char);
begin
   if Ord(Key) = VK_ESCAPE then Close;
end;

procedure TfrmAccountTurning.settingsApplyRecord(Sender: TOracleDataSet;
  Action: Char; var Applied: Boolean; var NewRowId: String);

  var
    p_id ,p_PARENTID,p_CurrencyID,
    p_AccID,p_branchid :Integer;

begin
     with settings do begin
        p_id := fieldbyname('ID').AsInteger;
        p_PARENTID := fieldbyname('PARENTID').AsInteger;
        p_CurrencyID := fieldbyname('CurrencyID').AsInteger;
        p_AccID := fieldbyname('AccID').AsInteger;
        p_branchid := fieldbyname('branchid').AsInteger;
     end;

    { with sbcm_ds do begin
     case Action of
        'I':CallProcedure('InsSettings',[p_PARENTID,p_CurrencyID,p_AccID,p_branchid]);
        'U':CallProcedure('UpdSettings',[p_id,p_PARENTID,p_CurrencyID,p_AccID,p_branchid]);

     end;
     Applied := True;
     end;}
end;

end.
