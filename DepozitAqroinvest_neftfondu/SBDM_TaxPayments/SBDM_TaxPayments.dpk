package SBDM_TaxPayments;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  sboapi50,
  CMVCL50,
  doa41dXE,
  vclxfiles150,
  SBDM_Common;

contains
  UnitDataMod in 'UnitDataMod.pas' {DataModuleTax: TDataModule},
  UnitTaxPayments in 'UnitTaxPayments.pas' {FormTaxPayments},
  UnitSearch in 'UnitSearch.pas' {FormSearch},
  UnitTransactions in 'UnitTransactions.pas' {FormTransactions};

end.
