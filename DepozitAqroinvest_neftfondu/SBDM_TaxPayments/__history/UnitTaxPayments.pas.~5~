implementation
uses sboapiDataModuleImpl, UnitSearch;
{$R *.dfm}

procedure TFormTaxPayments.ToolButton2Click(Sender: TObject);
begin
  if ODSTaxPayment.RecordCount = 0 then exit;
  FormSearch.DbGr := XDBGrid1;
  FormSearch.ShowModal;
end;

procedure TFormTaxPayments.ToolButton3Click(Sender: TObject);
begin
  if ODSTaxPayment.RecordCount=0 then exit;
  with ExcelExport do
  begin
    Connect;
    ExportDataset(ODSTaxPayment,'Vergi',true,true);
    Disconnect;
  end;
end;

