unit UnitTaxPayments;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, ExtCtrls, DB, OracleData, ImgList, CMExcelExport, Grids, XDBGrids,
  ComCtrls, ToolWin, StdCtrls, Mask, DBCtrls;

type
  TFormTaxPayments = class(TForm)
    Panel1: TPanel;
    CoolBar1: TCoolBar;
    ToolBar1: TToolBar;
    ToolButton1: TToolButton;
    XDBGrid1: TXDBGrid;
    ExcelExport: TCMExcelExport;
    ImageList1: TImageList;
    ToolButton2: TToolButton;
    ToolButton3: TToolButton;
    ToolButton4: TToolButton;
    ToolButton5: TToolButton;
    ToolButton6: TToolButton;
    ToolButton7: TToolButton;
    ToolButton8: TToolButton;
    procedure ToolButton2Click(Sender: TObject);
    procedure ToolButton3Click(Sender: TObject);
    procedure ToolButton4Click(Sender: TObject);
    procedure XDBGrid1TitleClick(Column: TXColumn);
    procedure FormCanResize(Sender: TObject; var NewWidth, NewHeight: Integer;
      var Resize: Boolean);
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormTaxPayments: TFormTaxPayments;
  procedure exportproc(S :String);export;

implementation

{$R *.dfm}
uses sboapiDataModuleImpl, UnitSearch, UnitTransactions,CommonDeclsImpl,
  UnitDataMod;

procedure exportproc(S :String);export;
begin
  FormTaxPayments.ShowModal;
end;


exports
  exportproc;

procedure TFormTaxPayments.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
  Resize := False;
end;

procedure TFormTaxPayments.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  DataModuleTax.ODSTaxPayment.CloseAll;
  DataModuleTax.ODSFields.CloseAll;
end;

procedure TFormTaxPayments.FormCreate(Sender: TObject);
begin
  DataModuleTax:=TDataModuleTax.Create(Self);
  FormSearch:=TFormSearch.Create(Self);
  FormTransactions:=TFormTransactions.Create(Self);
end;

procedure TFormTaxPayments.FormDestroy(Sender: TObject);
begin
  FormTaxPayments.Free;
  FormSearch.Free;
  FormTransactions.Free;
end;

procedure TFormTaxPayments.FormShow(Sender: TObject);
begin
//
  DataModuleTax.ODSTaxPayment.Close;
  DataModuleTax.ODSTaxPayment.Open;
  DataModuleTax.ODSFields.close;
  DataModuleTax.ODSFields.Open;
  //DataModuleTax.OracleDataSet1.Close;
  //DataModuleTax.OracleDataSet1.Open;
 // ShowMessage();
end;

procedure TFormTaxPayments.ToolButton2Click(Sender: TObject);
begin
  if DataModuleTax.ODSTaxPayment.RecordCount = 0 then exit;
  FormSearch.DbGr := XDBGrid1;
  FormSearch.ShowModal;
end;

procedure TFormTaxPayments.ToolButton3Click(Sender: TObject);
begin
  if DataModuleTax.ODSTaxPayment.RecordCount=0 then exit;
  with ExcelExport do
  begin
    Connect;
    ExportDataset(DataModuleTax.ODSTaxPayment,'Vergi',true,true);
    Disconnect;
  end;
end;

procedure TFormTaxPayments.ToolButton4Click(Sender: TObject);
begin
  Close;
end;

procedure TFormTaxPayments.XDBGrid1TitleClick(Column: TXColumn);
begin
 IF Column.FieldName = '' THEN
    exit;
  with DataModuleTax,ODSTaxPayment do
  begin
    close;
    if Column.Title.MarkerIndex = 2 then
      SetVariable('title', Column.FieldName + ' ' + 'ASC')
    else
      SetVariable('title', Column.FieldName + ' ' + 'DESC');
    open;
  end;
end;

initialization
   FormTaxPayments := TFormTaxPayments.Create(CommonApplication);

end.
