package SBDM_WRSetup;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Credits Managment Common Declarations, Functions Classes'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  DOA41dxe,
  Ehlib150,
  sboapi50,
  CMVCL50,
  DclEhlib150,
  SBDM_Common;

contains
  SBBookmarkAddEditunt in 'SBBookmarkAddEditunt.pas' {SBBookmarkAddEditForm},
  SBTemplateAddEditUnt in 'SBTemplateAddEditUnt.pas' {SBTemplAddEditForm},
  SBWRBookmarksTuning in 'SBWRBookmarksTuning.pas' {SBWRBookmarkSetup},
  SBWRSetupDataModImpl in 'SBWRSetupDataModImpl.pas' {SBWRSetupDataMod: TDataModule},
  SBWRTemplatesTuning in 'SBWRTemplatesTuning.pas' {SBWRTemplateSetup},
  SBWRSetupLoader in 'SBWRSetupLoader.pas';

end.
