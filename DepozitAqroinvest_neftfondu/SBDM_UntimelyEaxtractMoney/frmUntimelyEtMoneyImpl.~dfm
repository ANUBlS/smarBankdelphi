  object DepositInfo: TOracleDataSet
    SQL.Strings = (
      'select cust.name,'
      '       cont.opendate,'
      '       cont.closedate,'
      '       sbcm_stored_programs.getpercent(Cont.ID) as annualInt,'
      
        '      sbcm_stored_programs.getoverduepercent(Cont.ID) As OverDue' +
        'AnnualInt,'
      
        '      sbcm_stored_programs.Get_ContractAccount(Acc.ContractAccID' +
        ') as ContractAccNo,'
      
        '      sbcm_stored_programs.Get_ContractAccount(Acc.ClientAccID) ' +
        'as ClientAccNo,'
      
        '      sbcm_stored_programs.Get_ContractAccount(Acc.InterestAccID' +
        ') as InterestAccNo,'
      '      cstate.FACTICALDEBT,'
      '      cstate.FACTICALINTERESTDEBT'
      'from sbcm_contracts cont,'
      '     sbcm_contract_accounts acc,'
      '     sbcm_contract_state cstate,'
      'customers cust'
      'where '
      'Cont.ID = :ContractID and'
      'cust.id = Cont.customerID and'
      'acc.id# = :ContractID and'
      'cstate.id# = :ContractID'
      ' ')
    Variables.Data = {
