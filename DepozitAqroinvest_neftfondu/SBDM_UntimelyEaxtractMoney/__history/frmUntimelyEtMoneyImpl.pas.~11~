implementation

{$R *.DFM}
uses sboapiDataModuleImpl,CommonDeclsImpl;

procedure exportproc(S :String);export;
var ContractID :Integer;
begin
   ContractID := Get_SelectedContID;

   with frmUntimelyEtMoney do
   begin

      with DepositInfo do
      begin
         if Active then Close;
         SetVariable ('ContractID',ContractID);
         Open;
      end;

      with CreditAccs do
      begin
         SetVariable('P_CATEGORYID',DepositInfoCLIENTTYPE.AsInteger);
         SetVariable('P_CURRENCYID',DepositInfoCURRENCY.AsInteger);
         SetVariable('P_BRANCHID',DepositInfoBRANCHID.AsInteger);
         Open;
      //   AccountListCB.KeyValue := FieldByName('ID').AsInteger;
      end;

      Caption := Get_SelectedContNo+' nömrəli depozitin vaxtından əvvəl ödənilməsi';
      EditPercent.Text:=DepositInfoOVERDUEANNUALINT.AsVariant;

      ShowModal;
   end;
end;
exports
   exportproc;

procedure TfrmUntimelyEtMoney.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize := False;
end;

procedure TfrmUntimelyEtMoney.FormKeyPress(Sender: TObject; var Key: Char);
begin
   if ord(Key) = VK_ESCAPE then Close
end;

procedure TfrmUntimelyEtMoney.Button1Click(Sender: TObject);
resourcestring
  rsTransactionsWillProcessed = 'Depozitin vaxtından əvvəl ödənilməsi ...';
var
    CommitUntimeExtMoney :Boolean;
    CalcPercentDate : TDateTime;
    CreditAccID : Integer;
    
begin

    CalcPercentDate := integer(trunc(DTPCalcPercent.DateTime));
    CreditAccID := CreditAccs.FieldByName('ID').AsInteger;
    
    with sbcm_payment do
     CallProcedure('UntimeWithDrawMoney',['ContractID',Get_SelectedContID,
                                           'p_CalcPercentDate',CalcPercentDate,
                                           'p_CreditAccID',CreditAccID]);


    try
    CommitUntimeExtMoney := TrDelayed_Show(Self,rsTransactionsWillProcessed);

    Update;

    SBCM_PAYMENT.CallProcedure('CommitWithDrawMoney',[
       'DoCommit',CommitUntimeExtMoney
    ]);

    if CommitUntimeExtMoney then
    Self.ModalResult := mrOk;
    Self.Update;
  except


    SBCM_PAYMENT.CallProcedure('CommitWithDrawMoney',['DoCommit',
        False
    ]);

    raise;

  end;


end;

procedure TfrmUntimelyEtMoney.FormShow(Sender: TObject);
begin
   DTPCalcPercent.DateTime := DepositInfo.FieldByName('OpenDate').AsDateTime;
   DTPBankDate.DateTime := Get_BankDate;
end;

procedure TfrmUntimelyEtMoney.Button2Click(Sender: TObject);
begin
   sbcm_payment.Session.Rollback;
   Close;
end;

initialization
   frmUntimelyEtMoney := TfrmUntimelyEtMoney.Create(CommonApplication);

end.
