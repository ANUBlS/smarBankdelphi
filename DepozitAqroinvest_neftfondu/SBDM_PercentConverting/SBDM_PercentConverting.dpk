package SBDM_PercentConverting;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sboapi50,
  CMVCL50,
  DclEhlib150,
  DOA41dxe,
  Ehlib150,
  SBDM_Common;

contains
  DMPercentConveringImpl in 'DMPercentConveringImpl.pas' {DMPercentConvering: TDataModule},
  frmPercentConveringImpl in 'frmPercentConveringImpl.pas' {frmPercentConvering},
  frmCalcPerProgressImpl in 'frmCalcPerProgressImpl.pas' {frmCalcPerProgress},
  frmCalcPerFilterImpl in 'frmCalcPerFilterImpl.pas' {frmCalcPerFilter};

end.
