unit frmApplyMoneyImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, NLSDialogs,
  NLSLocalizer, Grids, DBGridEh, ComCtrls, ToolWin, ActnList,
  CMExcelExport, ImgList, StdCtrls, Mask, DBCtrls, ExtCtrls, Menus;

type
  TFrmApplyMoney = class(TForm)
    NLSDepositMoney: TNLSLocalizer;
    GroupBox1: TGroupBox;
    Panel3: TPanel;
    DBEdit2: TDBEdit;
    StaticText2: TStaticText;
    ImageList1: TImageList;
    ExcelExport: TCMExcelExport;
    Panel4: TPanel;
    ToolBar1: TToolBar;
    ToolButton1: TToolButton;
    ToolButton2: TToolButton;
    ToolButton3: TToolButton;
    ToolButton4: TToolButton;
    ToolButton5: TToolButton;
    ToolButton6: TToolButton;
    ToolButton7: TToolButton;
    StatusBar1: TStatusBar;
    DBGridEh1: TDBGridEh;
    ActionList1: TActionList;
    ActnAdd: TAction;
    ActnDel: TAction;
    ActnExport: TAction;
    PMShowTr: TPopupMenu;
    N1: TMenuItem;
    procedure FormCanResize(Sender: TObject; var NewWidth,
      NewHeight: Integer; var Resize: Boolean);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure ToolButton7Click(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure ActnAddExecute(Sender: TObject);
    procedure ActnDelExecute(Sender: TObject);
    procedure ActnExportExecute(Sender: TObject);
    procedure ActnDelUpdate(Sender: TObject);
    procedure N1Click(Sender: TObject);
    procedure N1DrawItem(Sender: TObject; ACanvas: TCanvas; ARect: TRect;
      Selected: Boolean);
  private
    { Private declarations }
  public
     CanRefReshDeposit :Boolean;
  end;

var
  FrmApplyMoney: TFrmApplyMoney;

  procedure exportproc(S :String);export;

implementation

{$R *.DFM}

uses DMApplyMoneyImpl,frmAddMoneyImpl,CommonDeclsImpl;

procedure exportproc(S :String);export;
var ContractID,
    CustAccID,CustID:Integer;

begin
   FrmApplyMoney.NLSDepositMoney.Caption := Get_SelectedContNo+' нюмряли мцгавилянин йатрымлары';
   ContractID := Get_SelectedContID;
   with DMApplyMoney do
   begin
       with Tranches do
       begin
          SetVariable('ContractID',ContractID);
          Open;
       end;

       with DepositInfo do
       begin
          SetVariable('ContractID',ContractID);
          CustID := FieldByName('CustomerID').AsInteger;
          Open;
       end;

       with CustAcc do
       begin
          SetVariable('ContractID',ContractID);
          Open;
          CustAccID := FieldByName('ClientACCID').AsInteger;
       end;

       with DebitAccs do
       begin
        if not Active then
          //SetVariable('kliID',CustID);
          Open;
        if Locate('ID',CustAccID,[]) then
        frmAddMoney.AccountListCB.KeyValue := CustAccID;
       end;

      FrmApplyMoney.ShowModal;
   end;
end;

exports
  exportproc;

procedure TFrmApplyMoney.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize := False;
end;

procedure TFrmApplyMoney.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if ord(Key) = VK_ESCAPE then close;
end;

procedure TFrmApplyMoney.FormCreate(Sender: TObject);
begin
   DMApplyMoney := TDMApplyMoney.Create(Self);
   frmAddMoney := TfrmAddMoney.Create(Self);
end;

procedure TFrmApplyMoney.FormDestroy(Sender: TObject);
begin
   frmAddMoney.Free;
   DMApplyMoney.Free;
end;

procedure TFrmApplyMoney.ToolButton7Click(Sender: TObject);
begin
   Close
end;

procedure TFrmApplyMoney.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
   if CanRefReshDeposit then
      RefreshWithSavely(True);
    with DMApplyMoney do
    begin
       Tranches.CloseAll;
      // DebitAccs.CloseAll;
       DepositInfo.CloseAll;
       CustAcc.CloseAll;
    end;  
end;

procedure TFrmApplyMoney.ActnAddExecute(Sender: TObject);
begin
   if frmAddMoney.ShowModal = mrOk then
   begin
      CanRefReshDeposit := True;
      DMApplyMoney.Tranches.Refresh;
   end;

end;

procedure TFrmApplyMoney.ActnDelExecute(Sender: TObject);
begin

    if MessageDlg('Силинмясиня яминсинизми?',
             mtConfirmation, [mbYes, mbNo], 0) = mrNo
    then Exit;

    with DMApplyMoney,Tranches,sbcm_tranches do begin
         CallProcedure('DeleteDepositMoney',['P_DepMoneyID',FieldByName('ID').AsInteger]);
          refresh;
         end;

end;

procedure TFrmApplyMoney.ActnExportExecute(Sender: TObject);
begin
   with ExcelExport do
   begin
      Connect;
      ExportDataset(DMApplyMoney.Tranches,'Депозит йатрымлары',True,false);
      Disconnect;
   end;

end;

procedure TFrmApplyMoney.ActnDelUpdate(Sender: TObject);
begin
   with (Sender as TAction) do
        Enabled := DMApplyMoney.Tranches.RecordCount > 0;
end;

procedure TFrmApplyMoney.N1Click(Sender: TObject);
var TrID :String;
begin
   TrID := IntToStr(DMApplyMoney.Tranches.FieldByname('TrID').AsInteger);
   LoadPlugin('SBDM_TransactionViewer.bpl',TrID);
end;

procedure TFrmApplyMoney.N1DrawItem(Sender: TObject; ACanvas: TCanvas;
  ARect: TRect; Selected: Boolean);
var
  LineBottom: Integer;
  SText: String;
  Bar: TRect;
begin
  with ACanvas, Sender as TMenuItem do
  begin
    with ACanvas.Font do
    begin
      Charset := DEFAULT_CHARSET;
      Name := 'Azl Sans Serif';
      if Default then
        Style := [fsBold];
    end;
    if Caption = '-' then
    begin
      Pen.Color := clBlack;
      LineBottom := (ARect.Top + (ARect.Bottom - ARect.Top) div 2)-1;
      MoveTo(ARect.Left, LineBottom);
      LineTo(ARect.Right, LineBottom);
      inc(LineBottom);
      Pen.Color := clWhite;
      MoveTo(ARect.Left, LineBottom);
      LineTo(ARect.Right, LineBottom);
    end
    else
    begin
      if Selected then
      begin
        Brush.Color := clNavy;
        if Enabled then
          Font.Color := clWhite
        else
          Font.Color := clSilver;
      end
      else
      begin
        Brush.Color := clBtnFace;
        if Enabled then
          Font.Color := clBlack
        else
          Font.Color := clGrayText;
      end;
      Bar := ARect;
      Inc(Bar.Left, 22);
      FillRect(Bar);
      TextOut(ARect.Left+{17}22, ARect.Top+1, Caption);
    end;
    // draw shortcut
    SText := ShortCutToText(ShortCut);
    TextOut(ARect.Right-TextWidth(SText)-7, ARect.Top+1, SText);
    if ImageIndex <> -1 then
      with GetParentMenu do
        if Assigned(Images) then
        begin
          if Checked then
          begin
            Bar.Left := ARect.Left + 1;
            Bar.Right := Bar.Left + 16;
            Bar.Top := ARect.Top + 1;
            Bar.Bottom := Bar.Top + 16;

            ACanvas.Brush.Color := clBtnShadow;
            ACanvas.FrameRect(Bar);

            Inc(Bar.Left, 2);
            Inc(Bar.Right, 2);
            Inc(Bar.Top, 2);
            Inc(Bar.Bottom, 2);

            ACanvas.Brush.Color := clBtnHighlight;
            ACanvas.FrameRect(Bar);

            Dec(Bar.Left, 1);
            Dec(Bar.Right, 1);
            Dec(Bar.Top, 1);
            Dec(Bar.Bottom, 1);

            if Selected then
              ACanvas.Brush.Color := clBtnFace
            else
              ACanvas.Brush.Color := clBtnHighlight;
            ACanvas.FillRect(Bar);
          end;

          Images.Draw(ACanvas, ARect.Left, ARect.Top, ImageIndex, Enabled);
        end;
  end;

end;

initialization
   FrmApplyMoney := TFrmApplyMoney.Create(CommonApplication);

end.
