  $(DCC)

SBDM_ApplyMoney.bpl: Packages\DepositsManager\SBDM_ApplyMoney\SBDM_ApplyMoney.dpk
  $(DCC)

SBDM_ExtractMoney.bpl: Packages\DepositsManager\SBDM_ExtractMoney\SBDM_ExtractMoney.dpk
  $(DCC)

SBDM_Capitalize.bpl: Packages\DepositsManager\SBDM_Capitalize\SBDM_Capitalize.dpk
  $(DCC)

SBDM_UntimelyEtMoney.bpl: Packages\DepositsManager\SBDM_UntimelyEaxtractMoney\SBDM_UntimelyEtMoney.dpk
  $(DCC)

SBDM_PercentConverting.bpl: Packages\DepositsManager\SBDM_PercentConverting\SBDM_PercentConverting.dpk
  $(DCC)

SBDM_Settings.bpl: Packages\DepositsManager\SBDM_Settings\SBDM_Settings.dpk
  $(DCC)

SBDM_ContractReport.bpl: Packages\DepositsManager\SBDM_ContractReport\SBDM_ContractReport.dpk
  $(DCC)

SBDM_WRSetup.bpl: Packages\DepositsManager\SBDM_WRSetup\SBDM_WRSetup.dpk
  $(DCC)

SBDM_WReport.bpl: Packages\DepositsManager\SBDM_WReport\SBDM_WReport.dpk
  $(DCC)

SBDM_PercentSettings.bpl: Packages\DepositsManager\SBDM_PercentSettings\SBDM_PercentSettings.dpk
