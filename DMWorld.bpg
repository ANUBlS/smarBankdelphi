SBDM_Report.bpl: Packages\DepositsManager\SBDM_Report\SBDM_Report.dpk
  $(DCC)

SBDM_TransactionViewer.bpl: Packages\DepositsManager\SBDM_TransactionViewer\SBDM_TransactionViewer.dpk
