#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = SBAxCommon50.ocx sboapi50.bpl SBCommon50.bpl sbovcl50.bpl \
  SBExcelExporter.bpl sbplg50.bpl CMVCL50.bpl DclEhlib50.bpl Ehlib50.bpl \
  SBDM_Common.bpl SBDM_Contract.bpl SBDM_ApplyMoney.bpl SBDM_ExtractMoney.bpl \
  SBDM_Capitalize.bpl SBDM_UntimelyEtMoney.bpl SBDM_PercentConverting.bpl \
  SBDM_Settings.bpl SBDM_ContractReport.bpl SBDM_WRSetup.bpl SBDM_WReport.bpl \
  SBDM_PercentSettings.bpl SBDM_PeriodReport.bpl SBDM_Prolongation.bpl \
  SBDM_Filter.bpl SBDM_Report.bpl SBDM_TransactionViewer.bpl \
  SBDM_ReportofBalance.bpl DepositsManager.ocx DepositsArchive.ocx \
  SBTranslate.bpl SearchCB.bpl SmartBank.exe
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

SBAxCommon50.ocx: Packages\SBCommon50\ActiveX\SBAxCommon50.dpr
  $(DCC)

sboapi50.bpl: Packages\sboapi50\sboapi50.dpk
  $(DCC)

SBCommon50.bpl: Packages\SBCommon50\SBCommon50.dpk
  $(DCC)

sbovcl50.bpl: Packages\sbovcl50\sbovcl50.dpk
  $(DCC)

SBExcelExporter.bpl: Packages\SBExcelExporter\SBExcelExporter.dpk
  $(DCC)

SmartBank.exe: Programs\SmartBank\SmartBank.dpr
  $(DCC)

sbplg50.bpl: Packages\sbplg50\sbplg50.dpk
  $(DCC)

CMVCL50.bpl: Packages\DepositsManager\VCL\CMVCL50.dpk
  $(DCC)

DclEhlib50.bpl: Packages\DepositsManager\EhLib\DclEhlib50.dpk
  $(DCC)

Ehlib50.bpl: Packages\DepositsManager\EhLib\Ehlib50.dpk
  $(DCC)

SBDM_Common.bpl: Packages\DepositsManager\SBDM_COMMON\SBDM_Common.dpk
  $(DCC)

SBDM_Contract.bpl: Packages\DepositsManager\SBDM_Contract\SBDM_Contract.dpk
