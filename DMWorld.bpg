SBDM_Prolongation.bpl: Packages\DepositsManager\SBDM_Prolongation\SBDM_Prolongation.dpk
  $(DCC)

SBDM_Filter.bpl: Packages\DepositsManager\SBDM_Filter\SBDM_Filter.dpk
