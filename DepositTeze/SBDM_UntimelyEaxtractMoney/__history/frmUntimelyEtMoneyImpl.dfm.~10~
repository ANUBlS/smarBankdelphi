  object DepositInfo: TOracleDataSet
    SQL.Strings = (
      'select cust.name,'
      '       sbcm_stored_programs.SbcmOpenDate(Cont.ID) as opendate,'
      
        '       sbcm_stored_programs.SBCMGetOldDate(Cont.ID) as closedate' +
        ','
      
        '       sbcm_stored_programs.GetpercentCollection(Cont.ID) as ann' +
        'ualInt,'
      
        '       sbcm_stored_programs.getoverduepercent(Cont.ID) As OverDu' +
        'eAnnualInt,'
      
        '       -- sbcm_stored_programs.GetOverduePercentType(Cont.ID) As' +
        ' OverDueAnnualInt,'
      
        '        sbcm_stored_programs.Get_ContractAccount(Acc.ContractAcc' +
        'ID) as ContractAccNo,'
      
        '      sbcm_stored_programs.Get_ContractAccount(Acc.ClientAccID) ' +
