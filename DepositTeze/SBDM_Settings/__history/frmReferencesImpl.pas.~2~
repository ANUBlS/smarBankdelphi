unit frmReferencesImpl;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,OracleData,
  Db, ComCtrls,Oracle, StdCtrls, Grids, DBGrids, DBCtrls, ExtCtrls,
  NLSLocalizer;

type
  TFrmReferences = class(TForm)
    StatusBar: TStatusBar;
    GroupBox1: TGroupBox;
    ValuesComboBox: TComboBox;
    ValuesEdit: TEdit;
    BtnApply: TButton;
    GroupBox2: TGroupBox;
    TV: TTreeView;
    NLSLocalizer1: TNLSLocalizer;
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure TVChange(Sender: TObject; Node: TTreeNode);
    procedure BtnApplyClick(Sender: TObject);
    procedure FormCanResize(Sender: TObject; var NewWidth,
      NewHeight: Integer; var Resize: Boolean);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
  private
    procedure TVBuild;
    procedure TVAddNode(Node :TTreeNode;ID :Integer);
    { Private declarations }
  public
    TreeItems :TList;
    { Public declarations }
  end;

var
  FrmReferences: TFrmReferences;

implementation

uses DMReferences,SBTranslateProc,sboapiDataModuleimpl;

{$R *.DFM}
procedure TFrmReferences.TVBuild;
begin
   TV.Items.Clear;
   TVAddNode(nil,-1);
   DataModReferences.ReferLink.Refresh;
end;
procedure TFrmReferences.TVAddNode(Node :TTreeNode;ID :Integer);
begin
    with  TOracleDataSet.Create(nil)  do
    try
      Session :=DataModReferences.TVSubItems.Session;
      SQL.Assign(DataModReferences.TVSubItems.SQL);
      DeclareVariable('ParentID',otInteger);
      SetVariable('ParentID',ID);
      Open;
      First;
      while  not EOF  do
      begin
        TreeItems.Add(Pointer(FieldByName('ID').AsInteger));
        TVAddNode(TV.Items.AddChild(Node,FieldByName('LName').AsString),FieldByName('ID').AsInteger);
        Next;
      end;
    finally
      Free;
    end;
end;
procedure TFrmReferences.FormCreate(Sender: TObject);
begin
   DataModReferences :=TDataModReferences.Create(Self);
   TreeItems :=TList.Create;
   SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;
procedure TFrmReferences.FormDestroy(Sender: TObject);
begin
  TreeItems.Free;
end;
procedure TFrmReferences.FormShow(Sender: TObject);
begin
   TVBuild;
   ValuesComboBox.Enabled :=False;
   ValuesEdit.Enabled :=False;
end;

procedure TFrmReferences.TVChange(Sender: TObject; Node: TTreeNode);
  procedure  ExpandItems(SourceList :TStrings;const Value :WideString);
  var
     Index :Integer;
     Data :WideString;
  begin
     SourceList.Clear;
     Data :=Value;
     Index :=Pos(';',Data);
     while  Index <> 0  do
     begin
        SourceList.Add(Copy(Data,1,Index-1));
        Delete(Data,1,Index);
        Index :=Pos(';',Data);
     end;
     SourceList.Add(Data);
  end;
var
  TargetItemID :Integer;
begin
  TargetItemID :=Integer(TreeItems.Items[Node.AbsoluteIndex]);
  with  DataModReferences do
  with  ReferLink  do
  begin
    Locate('ID',TargetItemID,[]);
    if not FieldByName('Value').IsNull then
    begin
      if FieldByName('SourceList').IsNull then
      begin
         ValuesComboBox.Enabled :=False;
         ValuesEdit.Enabled :=True;
         ValuesEdit.Text :=FieldByName('Value').AsString;
      end
      else
      begin
        ValuesComboBox.Enabled :=True;
        ValuesEdit.Enabled :=False;
        ExpandItems(ValuesComboBox.Items,FieldByName('SourceList').AsString);
        ValuesComboBox.ItemIndex :=ValuesComboBox.Items.IndexOf(FieldByName('Value').AsString);
      end;
    end else
    begin
      ValuesComboBox.Enabled :=False;
      ValuesEdit.Enabled :=False;
    end;
  end;
  BtnApply.Enabled :=ValuesComboBox.Enabled or ValuesEdit.Enabled;
end;

procedure TFrmReferences.BtnApplyClick(Sender: TObject);
var
  NewValue :String;
begin
   if ValuesComboBox.Enabled then
     NewValue :=ValuesComboBox.Items.Strings[ValuesComboBox.ItemIndex]
   else
     NewValue :=ValuesEdit.Text;

      with DataModReferences do
      with ReferLink,ReferPackage do
      begin
      CallProcedure('UPD_SBCM_REFERENCES',[
                      FieldByName('ID').Value,
                      FieldByName('Name').Value,
                      FieldByName('LName').Value,
                      FieldByName('ParentID').Value,
                      NewValue,
                      FieldByName('SourceList').Value
                    ]); 
        Refresh;
      end;  

end;

procedure TFrmReferences.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize := False;
end;

procedure TFrmReferences.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if Ord(Key) = VK_ESCAPE then Close;
end;

end.
