procedure TSBWRBookmarkSetup.ActionDeleteTemplateExecute(Sender: TObject);
   resourcestring
        TempdeleteMsg='Ñèëèíìÿñèíÿ ÿìèíñèíèçìè?';
    begin

      if MessageDlg(
                   TempdeleteMsg,
                   mtConfirmation,
                   [mbYes,
                   mbNo],
                    0) = mrYes then
       begin
         with SBWRSetupDataMod.SBWRTemplatesDSet do
               Delete;
        end;

    end;

procedure TSBWRBookmarkSetup.ActionRfreshTemplateExecute(Sender: TObject);
begin

       with SBWRSetupDataMod.SBWRTemplatesDSet do
            Refresh;

end;

procedure TSBWRBookmarkSetup.ActnAddBookmarkExecute(Sender: TObject);   //-
resourcestring
           rsBookmarkCaption = 'Éåíè';
begin

       with SBWRSetupDataMod.SBWRBookmarksDSet do
            Insert;
            i:= SBBookmarkAddEditForm.ShowModal;
            SBBookmarkAddEditForm.Caption := rsBookmarkCaption;
            if i=mrOK then
            begin
              SBWRSetupDataMod.SBWRBookmarksDSet.Refresh;
            end;
end;

