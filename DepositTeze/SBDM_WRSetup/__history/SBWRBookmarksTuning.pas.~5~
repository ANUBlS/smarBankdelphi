procedure TSBWRBookmarkSetup.ActnCloseExecute(Sender: TObject);
begin
Close;
end;

procedure TSBWRBookmarkSetup.FormCanResize(Sender: TObject; var NewWidth,
  NewHeight: Integer; var Resize: Boolean);
begin
   Resize:=false;
end;

procedure TSBWRBookmarkSetup.FormCreate(Sender: TObject);
var ContractID:integer;
begin
     ContractID := Get_SelectedContID;

      SBWRSetupDataMod := TSBWRSetupDataMod.Create(Self);
      SBBookmarkAddEditForm := TSBBookmarkAddEditForm.create(self);
      SBTemplAddEditForm := TSBTemplAddEditForm.Create(Self);
      SBWRSetupDataMod.SBWRFieldsDSet.Open;
      SBWRSetupDataMod.SBWRBookmarksDSet.Open;
      SBWRSetupDataMod.SBOracleDSetTamplates.Open;
      SBWRSetupDataMod.SBWRTemplatesDSet.Open;
      SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TSBWRBookmarkSetup.FormDestroy(Sender: TObject);
begin
      SBWRSetupDataMod.SBWRFieldsDSet.CloseAll;
      SBWRSetupDataMod.SBWRTemplatesDSet.CloseAll;
      SBWRSetupDataMod.SBWRBookmarksDSet.CloseAll;
      SBWRSetupDataMod.SBOracleDSetTamplates.CloseAll;
      SBBookmarkAddEditForm.Free;
      SBTemplAddEditForm.Free;
      SBWRSetupDataMod.Free;
end;

procedure TSBWRBookmarkSetup.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if Ord(Key) = VK_ESCAPE then Close;
end;

procedure TSBWRBookmarkSetup.BitBtn1Click(Sender: TObject);
begin
   Close;
end;

procedure TSBWRBookmarkSetup.ActionEditTemplateUpdate(Sender: TObject);
begin
   With (Sender as TAction) do
         Enabled := SBWRSetupDataMod.SBWRTemplatesDSet.RecordCount > 0
end;

procedure TSBWRBookmarkSetup.ActnDeleteBookmarkUpdate(Sender: TObject);
begin
   With (Sender as TAction),SBWRSetupDataMod do
         Enabled := (SBWRBookmarksDSet.RecordCount > 0 ) and  (SBWRTemplatesDSet.RecordCount > 0)
end;

end.
