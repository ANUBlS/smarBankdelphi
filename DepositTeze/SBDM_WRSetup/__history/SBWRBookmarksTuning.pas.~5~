procedure TSBWRBookmarkSetup.ActionAddTemplareExecute(Sender: TObject);
resourcestring
      rsTemplateCaption = 'Éåíè øàáëîí';
var
    i:integer;
begin

      with SBWRSetupDataMod.SBWRTemplatesDSet do
           Insert;
           SBTemplAddEditForm.Caption:= rsTemplateCaption;
           i:=SBTemplAddEditForm.ShowModal;
           if i=mrOK then
           begin
             with SBWRSetupDataMod.SBWRTemplatesDSet do
                  Refresh;
           end;
end;


