                    'AZN'               ,
                    'AZN'               ,
                    feeKreditAccNo      ,
                    DebitAccno          ,
                    ABS(feeDebitAmount) ,
                    ABS(feeDebitAmount) ,
                    1                   ,
                    1                   ,
                    feeTrName_L
                   )

               else
                        Insertprovarch(
                        'AZN'           ,
                        'AZN'           ,
                        DebitAccno      ,
                        feeDebitAccNo   ,
                        feeDebitAmount  ,
                        feeDebitAmount  ,
                        1               ,
                        1               ,
                        feeTrName
                      );




           END;
       end;
  DebitAccId  :=sb_transaction.CallIntegerFunction('Get_Acc_Id',[DebitAccno]);
  KreditAccId :=sb_transaction.CallIntegerFunction('Get_Acc_Id',[KreditAccNo]);
  a_Flags     :=false;
  UserID      := OPExchMgr.CallIntegerFunction('ReturnUserId',[UpperCase(OPExchMgr.Session.LogonUsername)]);

  if trim(FloatToStr( DebitRate))<>'1' then
                         begin
                           if status=1 then
                           s := sb_transaction.CallIntegerFunction('ex_transaction',

                                                                        [
                                                                          DebitAccId,            { K }
                                                                          KreditAccId,
                                                                          DebitAmount,
                                                                          CreditAmount,          { N }
                                                                          LAmount,
                                                                          DebitRate,
                                                                          KreditRate,            { N }
                                                                          TrName,
                                                                          a_Flags,
                                                                          UserID
                                                                        ]
                                                                        )
                           else     begin
                           s := sb_transaction.CallIntegerFunction('ex_transaction_additional',

                                                                        [
                                                                          DebitAccId,             { K }
                                                                          KreditAccId,
                                                                          DebitAmount,
                                                                          CreditAmount,           { N }
                                                                          LAmount,
                                                                          DebitRate,
                                                                          KreditRate,             { N }
                                                                          TrName,
                                                                          a_Flags,
                                                                          UserID
                                                                        ]
                                                                        )

                                      end;
                     end;
               DataModExch.OPExchMgr.CallProcedure('trans_close',[DataModExch.ODSExchProvarchTrans.FieldByName('id').AsInteger,dat ]);
               DataModExch.ODSExchProvarch.Refresh;


end
