procedure TExchangeMGR_X.DBGridEhTransDrawColumnCell2(Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumnEh; State: TGridDrawState);
begin
with DBGridEhTrans,DataModExch do
    begin
    IF (DataCol=1) THEN
      begin
       case ODSExchProvarch.FieldByName('status').AsInteger of
        1:
          begin
               ImageList.Draw(Canvas,Rect.left+2,Rect.top,23,true);
          end;
        2:
          begin
              ImageList.Draw(Canvas,Rect.left+2,Rect.top,24,true);
          end;

        3:
          begin
               ImageList.Draw(Canvas,Rect.left+2,Rect.top,25,true);
          end;
       end;


        END;
      IF (DataCol=10) THEN
       BEGIN
           case ODSExchProvarch.FieldByName('trans_close').AsInteger of
                 0:
                   begin
                    ImageList.Draw(Canvas,Rect.left+2,Rect.top,27,true);
                   end;
                 1:
                   begin
                    ImageList.Draw(Canvas,Rect.left+2,Rect.top,28,true);
                   end;

           end;
       END;
        if ODSExchProvarch.RecordCount=0 then
          begin
             DefaultDrawColumnCell(Rect, DataCol, Column, State);
          end;
      end;


end;

