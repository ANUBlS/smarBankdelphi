procedure TFormSelling.Edit_Selling_AmountChange(Sender: TObject);
const
      selling_status=' курсла сатышы ';
var
       Ekv,Fee :real;
begin

if Edit_Selling_Amount.Text<>'' then
 begin

   Edit_Setting.Text:=SumNumToFull(StrToFloat(Edit_Selling_Amount.Text))
    +
    ' '
    +
     DBLC_Currency.ListSource.DataSet.FieldByName('val_name').AsString
    +
    ' -nin '
    +
    Edit_selling_course.Text
    +
    selling_status;

  Ekv:=StrToFloat(Edit_Selling_Amount.Text)*StrToFloat(Edit_selling_course.Text);
  Fee:=//ABS
           (
           (StrToFloat(Edit_Selling_Amount.Text)*StrToFloat(Edit_selling_course.Text))
           -
           (StrToFloat(Edit_Selling_Amount.Text)*StrToFloat(Edit_nb_course.Text))
           );

      Edit_Ekv_Amount.Text:=FormatFloat('#.##',Ekv);
      Edit_Fee_Amount.Text:=FormatFloat('#.##',Fee);

 end
   else
     begin
      Edit_Setting.Text:=EmptyStr;
      Edit_Ekv_Amount.Text:=EmptyStr;
      Edit_Fee_Amount.Text:=EmptyStr;
    end;


 end;

