               (Components[i].Name='tph_communication_type')or
               (Components[i].Name='tph_country_prefix')) then
              begin
                Result :=  false;
                IF (Components[i].Name='CBoxPassPlace')         THEN   text:='sənədin növü';
                IF (Components[i].Name='CBoxSex')               THEN   text:='cinsi';
                IF (Components[i].Name='CBoxFamStatus')         THEN   text:='ailə vəziyyəti';
                IF (Components[i].Name='BirthPlace')            THEN   text:='doğulduğu ölkə';
                IF (Components[i].Name='EditBirthCity')         THEN   text:='doğulduğu şəhər(rayon)';
                IF (Components[i].Name='issue_country')         THEN   text:='verildiyi ölkə';
                IF (Components[i].Name='DBCBox_DocTYPE')        THEN   text:='verən orqan';
                IF (Components[i].Name='DBCBox_Citizenship')    THEN   text:='vətəndaşlığı';
                IF (Components[i].Name='Adrs_State')            THEN   text:='qeydiyyatda olduğu ölkə';
