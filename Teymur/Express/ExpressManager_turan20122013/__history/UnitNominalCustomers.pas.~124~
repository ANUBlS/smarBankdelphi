Function CheckField(Sum:real): Boolean;
    var i,j,k,z : integer;
        text:string;
begin
   text:='';
   with FormNominalCustomers do
        for i :=0 to ComponentCount-1 do
        begin
          if Sum>=20000 then
           BEGIN
           if Components[i].ClassName ='TEdit' then
           if ((Components[i] as TEdit).Text='') and(
              (Components[i].Name='Editpasspin') or
              (Components[i].Name='EditLastName')or
              (Components[i].Name='EditName1')   or
              (Components[i].Name='EditSoname')  or
              (Components[i].Name='EditSerial')  or
              (Components[i].Name='EditPassport')or
              //(Components[i].Name='ZipQ')        or
              (Components[i].Name='AdressEdit')  or
              (Components[i].Name='EditMobil')   or
              (Components[i].Name='EditPhone')   or
             // (Components[i].Name='EditEmail')   or
              (Components[i].Name='Work_Place')  or
             // (Components[i].Name='db_tph_state')or
             // (Components[i].Name='DB_tph_zip')  or
              (Components[i].Name='db_tph_adress')or
              (Components[i].Name='Db_tph_cod')   or
              (Components[i].Name='Db_tph_number')or
              (Components[i].Name='Db_tph_extension')) then

              begin
                Result :=  false;
                IF (Components[i].Name='Editpasspin') THEN   text:='pinkod';
                IF (Components[i].Name='EditLastName')THEN   text:='soyadı';
                IF(Components[i].Name='EditName1')    THEN   text:='adı';
                IF(Components[i].Name='EditSoname')   THEN   text:='atasının adı';
                IF(Components[i].Name='EditSerial')   THEN   text:='seriya';
                IF(Components[i].Name='EditPassport') THEN   text:='nömrə';
               // IF(Components[i].Name='ZipQ')         THEN   text:='';
                IF(Components[i].Name='AdressEdit')   THEN   text:='qeydiyyat ünvanı';
                IF(Components[i].Name='EditMobil')    THEN   text:='mobil telefon';
                IF(Components[i].Name='EditPhone')    THEN   text:='ev telefon';
               // IF(Components[i].Name='EditEmail')    THEN   text:='';
                IF(Components[i].Name='Work_Place')   THEN   text:='iş yerinin adı';
               // IF(Components[i].Name='db_tph_state') THEN   text:='';
               // IF(Components[i].Name='DB_tph_zip')   THEN   text:='';
                IF(Components[i].Name='db_tph_adress')THEN   text:='iş yerinin ünvanı';
                IF(Components[i].Name='Db_tph_cod')   THEN   text:='iş telefonun kodu';
                IF(Components[i].Name='Db_tph_number')THEN   text:='iş telefonun nömrəsi';
                IF(Components[i].Name='Db_tph_extension') THEN   text:='iş telefonun daxili nömrə';
                MessageDlg('Göndərən şəxsin'+' '+ text+' '+'sahəsi doldurulmayıb !',mtWarning,[mbok],0);exit;
              end
              ELSE
                Result :=true;

           if Components[i].ClassName ='TDBLookupComboBox' then
           if ((Components[i] as TDBLookupComboBox).Text='') and(
               (Components[i].Name='CBoxPassPlace')or
               (Components[i].Name='CBoxSex')or
               (Components[i].Name='CBoxFamStatus')or
               (Components[i].Name='BirthPlace')or
               (Components[i].Name='EditBirthCity')or
