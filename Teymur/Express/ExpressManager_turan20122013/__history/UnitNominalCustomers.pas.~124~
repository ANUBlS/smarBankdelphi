                MessageDlg('Göndərən şəxsin'+' '+ text+' '+'sahəsi seçilməyib !',mtWarning,[mbok],0);exit;
              end
              ELSE
                Result :=true;

           if Components[i].ClassName ='TDBDateTimeEditEh' then
           if (VarIsNull((Components[i] as TDBDateTimeEditEh).Value)) and(
               (Components[i].Name='DateEdit2')or
               (Components[i].Name='DateEdit') or
               (Components[i].Name='DateEdit1'))then
           begin
                Result :=  false;
                IF (Components[i].Name='DateEdit2')         THEN   text:='dogulduğu tarix';
                IF (Components[i].Name='DateEdit')          THEN   text:='verildiyi tarix';
                IF (Components[i].Name='DateEdit1')         THEN   text:='etibarlıq müddəti';
                MessageDlg('Göndərən şəxsin'+' '+ text+' '+'sahəsi seçilməyib !',mtWarning,[mbok],0);exit;
              end
              ELSE
                Result :=true;


         end

         ELSE BEGIN
              if Components[i].ClassName ='TEdit' then
              if ((Components[i] as TEdit).Text='') and(
              (Components[i].Name='Editpasspin') or
              (Components[i].Name='EditLastName')or
              (Components[i].Name='EditName1')   or
              (Components[i].Name='EditSoname')  or
              (Components[i].Name='EditSerial')  or
              (Components[i].Name='EditPassport')) THEN
               BEGIN
                Result :=  false;
                IF (Components[i].Name='Editpasspin') THEN   text:='pinkod';
                IF (Components[i].Name='EditLastName')THEN   text:='soyadı';
                IF(Components[i].Name='EditName1')    THEN   text:='adı';
                IF(Components[i].Name='EditSoname')   THEN   text:='atasının adı';
                IF(Components[i].Name='EditSerial')   THEN   text:='seriya';
                IF(Components[i].Name='EditPassport') THEN   text:='nömrə';
                MessageDlg('Göndərən şəxsin'+' '+ text+' '+'sahəsi doldurulmayıb !',mtWarning,[mbok],0);exit;
               END
               ELSE
                   Result :=true;
              if Components[i].ClassName ='TDBLookupComboBox' then
              if ((Components[i] as TDBLookupComboBox).Text='') and(
                 (Components[i].Name='CBoxPassPlace'))THEN
                 BEGIN
                   Result :=  false;
                   IF (Components[i].Name='CBoxPassPlace') THEN   text:='sənədin növü';
                   MessageDlg('Göndərən şəxsin'+' '+ text+' '+'sahəsi seçilməyib !',mtWarning,[mbok],0);exit;
                 END
                 ELSE
                   Result :=true;
              END;

        end;


end;

