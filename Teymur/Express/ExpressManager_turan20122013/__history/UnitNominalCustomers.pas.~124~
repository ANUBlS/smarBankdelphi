                IF (Components[i].Name='Address_type')          THEN   text:='iş yerinin ünvanın təyinatı';
                IF (Components[i].Name='CountryByConctType')    THEN   text:='iş yerinin olduğu ölkə';
                IF (Components[i].Name='CityByConctType')       THEN   text:='iş yerinin olduğu şəhər';
                IF (Components[i].Name='tph_contact_type')      THEN   text:='iş yerinin telefon nömrəsinin təyinatı';
                IF (Components[i].Name='tph_communication_type')THEN   text:='iş yerinin telefon əlaqə vasitəsi';
