unit ExpParameterUnit;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, LDialogs,
  ExtCtrls, Grids, DBGrids, StdCtrls, DBViewComboBox, SearchEdit,
  NLSLocalizer, Buttons;

type
  TExpParameter = class(TForm)
    Panel1: TPanel;
    DBGrid1: TDBGrid;
    DBGrid2: TDBGrid;
    SearchEdit1: TSearchEdit;
    DBViewComboBox1: TDBViewComboBox;
    DBViewComboBox2: TDBViewComboBox;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    SpeedButton1: TSpeedButton;
    SpeedButton2: TSpeedButton;
    Label4: TLabel;
    Label5: TLabel;
    NLSLocalizer1: TNLSLocalizer;
    SearchEdit2: TSearchEdit;
    procedure SpeedButton1Click(Sender: TObject);
    procedure SpeedButton2Click(Sender: TObject);
    procedure DBGrid1DblClick(Sender: TObject);
    procedure DBGrid2DblClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  ExpParameter: TExpParameter;

implementation
uses ExpDataModuleUnit;

{$R *.DFM}

procedure TExpParameter.SpeedButton1Click(Sender: TObject);
begin
  if SearchEdit1.Text = '' then exit;
   begin
     with ExpDataModule do
     begin
       Repair.CallProcedure('Exp_accounts_add',[ValyutaDataSet.fieldbyname('VALUTE').asinteger,
                                                AccountDataSet.fieldbyname('id').asinteger,
                                                FilialDataSet.fieldbyname('id').asinteger]);
       SearchEdit1.clear;
       ExpAccDataSet.Refresh;
     end;
   end;
end;

procedure TExpParameter.SpeedButton2Click(Sender: TObject);
begin
  if SearchEdit2.Text = '' then exit;
  begin
    with ExpDataModule do
     begin
       Repair.CallProcedure('Exp_branchaccount_add',[ValyutaDataSet.fieldbyname('VALUTE').asinteger,
                                                     AccountDataSet.fieldbyname('id').asinteger,
                                                     FilialDataSet.fieldbyname('id').asinteger]);
       SearchEdit2.clear;
       BranchDataSet.Refresh;
     end;
   end;
  end;


procedure TExpParameter.DBGrid1DblClick(Sender: TObject);
begin
  with  ExpDataModule do
  begin
    Repair.CallProcedure('Exp_Accounts_Del',[ExpAccDataSet.FieldByName('id').AsInteger]);
    ExpAccDataSet.Refresh;
  end;
end;

procedure TExpParameter.DBGrid2DblClick(Sender: TObject);
begin
  with  ExpDataModule do
  begin
    Repair.CallProcedure('Exp_branchaccount_Del',[BranchDataSet.FieldByName('id').AsInteger]);
    BranchDataSet.Refresh;
  end;
end;


end.
