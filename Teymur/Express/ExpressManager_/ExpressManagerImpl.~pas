procedure TExpress.ActionAcceptExecute(Sender: TObject);
var id,status:integer;
begin
  try
     with  ExpDataModule,ExpBatchsDataSet do
     begin
       SB_ACA.CallProcedure('CheckAdvancedObjectAccess',['EXPRESS_COMMITEDIT']);
       status:=Repair.CallIntegerFunction('Exp_checkstatus',[fieldbyname('id').AsInteger]);
       id:=fieldbyname('id').AsInteger;
       if  status=1 then
       begin
         ExpBatchsDataSet.Refresh;
         exit;
       end;
       Repair.CallProcedure('Exp_batchs_SetTransaction',[ExpBatchsDataSetID.asinteger]);
       Repair.CallProcedure('Exp_batchs_archive',[ExpBatchsDataSetID.asinteger]);
       sboapiDataModule.SBSession.Commit;
       ExpBatchsDataSet.Refresh;
       Locate('id',id,[]);
     end;
      Except
           on E : Exception do
           begin
             sboapiDataModule.SBSession.Rollback;
             ShowMessage( E.Message);
           end;
   end;

end;

