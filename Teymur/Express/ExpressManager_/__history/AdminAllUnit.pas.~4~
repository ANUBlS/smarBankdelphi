unit AdminAllUnit;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Grids, XDBGrids, ExtCtrls, DB, OracleData;

type
  TExpAdminAll = class(TForm)
    Panel1: TPanel;
    XDBGrid1: TXDBGrid;
    Panel2: TPanel;
    XDBGrid2: TXDBGrid;
    XDBGrid3: TXDBGrid;
    AdminUserDataSet: TOracleDataSet;
    AdminUserDataSource: TDataSource;
    ExpAdminDataSet: TOracleDataSet;
    ExpAdminDataSource: TDataSource;
    procedure XDBGrid2DblClick(Sender: TObject);
    procedure XDBGrid2KeyPress(Sender: TObject; var Key: Char);
    procedure XDBGrid3KeyPress(Sender: TObject; var Key: Char);
    procedure XDBGrid3DblClick(Sender: TObject);
    procedure XDBGrid3KeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure XDBGrid1KeyPress(Sender: TObject; var Key: Char);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  ExpAdminAll: TExpAdminAll;

implementation
uses ExpDataModuleUnit;

{$R *.dfm}

procedure TExpAdminAll.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  AdminUserDataSet.Close;
  ExpAdminDataSet.Close;
end;

procedure TExpAdminAll.FormCreate(Sender: TObject);
begin
  AdminUserDataSet.Open;
  ExpAdminDataSet.Open;
end;

procedure TExpAdminAll.XDBGrid1KeyPress(Sender: TObject; var Key: Char);
begin
   if key=#27 then
   begin
      Close;
      key:=#0;
   end;
end;

procedure TExpAdminAll.XDBGrid2DblClick(Sender: TObject);
begin
  with ExpDataModule do
  begin
    Repair.CallProcedure('ExpAdmin_add',[ AdminUserDataSet.FieldByName('ID').AsInteger
                                         ,AllFilialDataSet.FieldByName('ID').AsInteger
                                         ,AdminUserDataSet.FieldByName('NAME').AsString
                                         ,AllFilialDataSet.FieldByName('NAME').AsString]);
    ExpAdminDataSet.Refresh;
  end;
end;

procedure TExpAdminAll.XDBGrid2KeyPress(Sender: TObject; var Key: Char);
begin
   if key=#13 then
      XDBGrid2DblClick(Sender);
   if key=#27 then
   begin
      Close;
      key:=#0;
   end;
end;

procedure TExpAdminAll.XDBGrid3DblClick(Sender: TObject);
begin
  with ExpDataModule do
  begin
    Repair.CallProcedure('ExpAdmin_del',[ ExpAdminDataSet.FieldByName('USER_ID').AsInteger
                                         ,ExpAdminDataSet.FieldByName('FILIAL_ID').AsInteger
                                         ,ExpAdminDataSet.FieldByName('USER_NAME').AsString
                                         ,ExpAdminDataSet.FieldByName('FILIAL_NAME').AsString]);
    ExpAdminDataSet.Refresh;
  end;
end;

procedure TExpAdminAll.XDBGrid3KeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key=46 then
   begin
      XDBGrid3DblClick(Sender);
      key:=0;
   end;
end;

procedure TExpAdminAll.XDBGrid3KeyPress(Sender: TObject; var Key: Char);
begin
  if key=#27 then
   begin
      Close;
      key:=#0;
   end;
end;

end.
