                                     exit
                                   end
  else begin
         CMCurrencyEdit2.Value:=ExpDataModule.Repair.CallFloatFunction('Exp_comissionoperation',[ExpDataModule.ExpTypeDataSet.fieldbyname('id').asinteger,CMCurrencyEdit.Value]);
         CMCurrencyEdit3.Value:=CMCurrencyEdit.Value+CMCurrencyEdit2.Value;
         Edit15.Text:=Mani(CMCurrencyEdit.Value);
       end;
end;


