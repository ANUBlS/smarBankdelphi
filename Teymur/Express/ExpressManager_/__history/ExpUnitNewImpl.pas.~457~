procedure TExpFormNew.FormShow(Sender: TObject);
begin
  Case FForm of
      0:begin
          RBoolean:=false;
          if not(TabSheet1.TabVisible)then TabSheet1.TabVisible:=true;
          if not(TabSheet2.TabVisible)then TabSheet2.TabVisible:=true;
          If TabSheet3.TabVisible     then TabSheet3.TabVisible:=False;
          EditDate.Text:=DateToStr(trunc(StrToDateTime(ExpDataModule.SysdateDataSet.fieldbyname('dat').AsString)));
          EditTime.Text:=TimeToStr(time);
          RadioGroup1Add;
          RadioGroup2Add;
          RadioGroup1Click(sender);
          RadioGroup2Click(sender);
          with ExpDataModule do
          begin
            FilialDataSet.Close;
            FilialDataSet.SQL[1]:='';
            FilialDataSet.SQL[1]:='where id=(select filialid from sba_objinf where sysuserid=uid)';
            FilialDataSet.Open;
          end;
          clearAll;
        end;
      1:begin
          If TabSheet3.TabVisible then
          begin
            TabSheet3.TabVisible:=False;
            TabSheet1.TabVisible:=True;
            TabSheet2.TabVisible:=True;
          end;
          RadioGroup1Add;
          RadioGroup2Add;
          ClearAll;
          Expedit;
        end;
      2:begin
          TabSheet1.TabVisible:=False;
          TabSheet2.TabVisible:=False;
          TabSheet3.TabVisible:=true;
          RadioGroup3Add;
          clear;
