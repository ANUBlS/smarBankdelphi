procedure TExpFormNew.clearall;
var i,j,k:integer;
BEGIN
   WITH  TabSheet1 DO
      BEGIN
        FOR i:=0 TO ControlCount-1 DO
        BEGIN
          WITH (Controls[i] as TPanel)DO
          BEGIN
            FOR j:=0 TO ControlCount-1 DO
            BEGIN
              IF (Controls[j] is TGroupBox)THEN
              WITH (Controls[j]as TGroupBox)DO
              BEGIN
                FOR k:= 0 TO ControlCount-1 DO
                BEGIN
                  IF (Controls[k] is TEdit)             THEN (Controls[k] as TEdit).Clear;
                  IF (Controls[k] is TDBLookupComboBox) THEN
                  IF (Controls[k] as TDBLookupComboBox).Name='FilialName'
                  THEN
                     (Controls[k] as TDBLookupComboBox).KeyValue:=ExpDataModule.FilialDataSet.FieldByName('id').AsInteger
                  ELSE
                     (Controls[k] as TDBLookupComboBox).KeyValue:=-1;
                  IF (Controls[k] is TDBDateTimeEditEh) THEN (Controls[k] as TDBDateTimeEditEh).Clear;
                  IF (Controls[k] is TCMCurrencyEdit)   THEN (Controls[k] as TCMCurrencyEdit).Value:=0.00;
                END;
              END;
              IF (Controls[j] is TRadioGroup) and RBoolean THEN (Controls[j] as TRadioGroup).ItemIndex:=-1;
            END;
          END;
        END;
      END;
    WITH  TabSheet2 DO
      BEGIN
        FOR i:=0 TO ControlCount-1 DO
        BEGIN
          WITH (Controls[i] as TPanel)DO
          BEGIN
            FOR j:= 0 TO ControlCount-1 DO
            BEGIN
              IF (Controls[j] is TGroupBox)THEN
              WITH (Controls[j]as TGroupBox)DO
              BEGIN
                FOR k:= 0 TO ControlCount-1 DO
                BEGIN
                  IF (Controls[k] is TEdit)                  THEN
                  IF (Controls[k] as TEdit).Name<>'EditDate' THEN (Controls[k] as TEdit).Clear;
                  IF (Controls[k] is TMaskEdit)         THEN  (Controls[k] as TMaskEdit).Clear;
                  IF (Controls[k] is TDBLookupComboBox) THEN (Controls[k] as TDBLookupComboBox).KeyValue:=-1;
                  IF (Controls[k] is TDBDateTimeEditEh) THEN (Controls[k] as TDBDateTimeEditEh).Clear;
                  IF (Controls[k] is TMemo)             THEN (Controls[k] as TMemo).Clear;
                END;
              END;
              IF (Controls[j] is TRadioGroup) and RBoolean THEN   (Controls[j] as TRadioGroup).ItemIndex:=-1;
            END;
          END;
        END;
      END;


END;
