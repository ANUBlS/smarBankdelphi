function TExpFormNew.Mani(CurrencyEdit:variant):string;
var sr,ET:string;
    s :integer;
    st:real;

begin
  sr:=CurrencyToHR_Azeri(trunc(CurrencyEdit),0,[0]);
  S:=pos('manat',sr);
  delete(sr,s,5);
  st:=round(frac(CurrencyEdit)*100);

  if CurrencyEdit>=1 then begin
  if st>0 then begin
  ET:=sr+''+ExpDataModule.ValyutaDataSet.fieldbyname('VALU_NAME').AsString+' '+FloatToStr(st)+' '+ExpDataModule.ValyutaDataSet.fieldbyname('Valu_Bala').AsString
  end
  else ET:=sr+''+ExpDataModule.ValyutaDataSet.fieldbyname('VALU_NAME').AsString;  end
  else ET:=FloatToStr(st)+' '+ExpDataModule.ValyutaDataSet.fieldbyname('Valu_Bala').AsString;
  mani:=ET;

end;




