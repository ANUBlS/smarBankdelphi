unit ExpPasswordUnit;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, ExtCtrls, CMHintBox;

type
  TExpPasswordForm = class(TForm)
    GroupBox1: TGroupBox;
    Button1: TButton;
    Button2: TButton;
    EditPassword: TEdit;
    CMHintBox1: TCMHintBox;
    procedure Button2Click(Sender: TObject);
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  ExpPasswordForm: TExpPasswordForm;

implementation
uses ExpDataModuleUnit, ExpUnitImpl, ExpUnitNewImpl;

{$R *.dfm}

procedure TExpPasswordForm.Button1Click(Sender: TObject);
var s:string;
begin
  with ExpDataModule,ExpBatchsDataSet do
  begin
    s:=fieldbyname('password').AsString;
  end;
  if s=EditPassword.Text
  then begin
         ExpFormNew.PageControl1.ActivePageIndex:=2;
         ExpFormNew.ShowModal;
       end

  else begin
         CMHintBox1.Hint:='Şifrə düzgün deyil!';
         EditPassword.clear;
       end;

end;

procedure TExpPasswordForm.Button2Click(Sender: TObject);
begin
  close;
end;

end.
