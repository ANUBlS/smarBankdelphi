unit UnitPayments;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, ExtCtrls, CMCurrencyEdit, DBCtrls, CMDBSearchEdit,
  SearchEdit;

type
  TFormPayments = class(TForm)
    Panel1: TPanel;
    EditPayments: TEdit;
    Button1: TButton;
    Button2: TButton;
    Label1: TLabel;
    CMCurrencyEdit1: TCMCurrencyEdit;
    Label4: TLabel;
    DBLookupComboBox2: TDBLookupComboBox;
    Label5: TLabel;
    FilialName: TEdit;
    Label6: TLabel;
    procedure FormShow(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure SearchEdit1Change(Sender: TObject);
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
     var exid:integer;
         FForm:integer;

  end;

var
  FormPayments: TFormPayments;

implementation
uses ExpDataModuleUnit,ExpCustomersTypeUnit;

{$R *.dfm}

procedure TFormPayments.Button1Click(Sender: TObject);
var
    val_cod    :Integer;
    accid      :Variant;
    amount     :real;
    paymentname:string;
    filname    :string;
    v_id       :Integer;


begin
  v_id:=0;
  IF not(SearchEdit1.Enabled)
  THEN
    accid  :=null
  ELSE
    accid  :=ExpDataModule.AccDataSet.FieldByName('id').AsInteger;


  val_cod:=DBLookupComboBox2.KeyValue;
  amount :=CMCurrencyEdit1.Value;
  paymentname:=EditPayments.Text;
  filname    :=FilialName.Text;
 

  IF FForm=0 THEN
  BEGIN
    ExpDataModule.EXPESSPAC.CallProcedure('exp_payments_insert',
                                        [ 'batchid'      ,v_id
                                         ,'v_exid'       ,exid
                                         ,'v_paymentname',paymentname
                                         ,'v_accid'      ,accid
                                         ,'v_val_cod'    ,val_cod
                                         ,'v_amount'     ,amount
                                         ,'v_filname'    ,filname] );

   v_id:=ExpDataModule.EXPESSPAC.GetParameter(0);
  END

  ELSE
    BEGIN
      v_id:=ExpDataModule.ExpBatchsDataSet.FieldByName('id').AsInteger;
      ExpDataModule.EXPESSPAC.CallProcedure('exp_payments_update',
                                           ['batchid'      ,v_id
                                           ,'v_paymentname',paymentname
                                           ,'v_accid'      ,accid
                                           ,'v_val_cod'    ,val_cod
                                           ,'v_amount'     ,amount] ) ;

    END;

  FormPayments.Close;
  ExpCustomersType.Close;

  ExpDataModule.ExpBatchsDataSet.Refresh;
  ExpDataModule.ExpBatchsDataSet.Locate('ID',V_ID,[]);
end;

procedure TFormPayments.Button2Click(Sender: TObject);
begin
  Close;
end;

procedure TFormPayments.FormShow(Sender: TObject);
begin
  case FForm of
  0:begin
      SearchEdit1.Clear;
      DBLookupComboBox1.KeyValue:=-1;
      DBLookupComboBox2.KeyValue:=-1;
      CMCurrencyEdit1.Value:=0.00;

      FilialName.Text  :=ExpDataModule.FilialDataSet.FieldByName('name').AsString;
      EditPayments.Text:=ExpCustomersType.typetext;
      if (EditPayments.Text='KÖMİS') or ((EditPayments.Text='Golden Pay')) then
      begin
        SearchEdit1.Enabled:=False;
        SearchEdit1.Color:=clSilver;
        DBLookupComboBox1.Enabled:=false;
        DBLookupComboBox1.Color:=clSilver;
     end;
     if (EditPayments.Text='Kredit') then
     begin
       SearchEdit1.Enabled:=True;
       SearchEdit1.Color:=clWhite;
       DBLookupComboBox1.Enabled:=True;
       DBLookupComboBox1.Color:=clWhite;
     end;
    end;
  1:begin
      with ExpDataModule do
      begin
        ExpSetDataSet.close;
        ExpSetDataSet.SetVariable('id',ExpBatchsDataSet.FieldByName('optype').AsInteger);
        ExpSetDataSet.open;
        FilialName.Text           :=ExpDataModule.FilialDataSet.FieldByName('name').AsString;
        EditPayments.Text         :=ExpSetDataSet.FieldByName('name').AsString;
        DBLookupComboBox2.KeyValue:=ExpBatchsDataSet.FieldByName('val_cod').AsInteger;
        CMCurrencyEdit1.Value     :=ExpBatchsDataSet.FieldByName('amount').AsInteger;


        IF  (EditPayments.Text='KÖMİS') or ((EditPayments.Text='Golden Pay'))
        THEN
          begin
            SearchEdit1.Text          :='';
            DBLookupComboBox1.KeyValue:=null;
            SearchEdit1.Enabled:=False;
            SearchEdit1.Color:=clSilver;
            DBLookupComboBox1.Enabled:=false;
            DBLookupComboBox1.Color:=clSilver;
          end;

      if (EditPayments.Text='Kredit') then
      begin
       AccountDataSet.close;
       AccountDataSet.SetVariable('kli_id',ExpBatchsDataSet.FieldByName('bkliid').AsInteger);
       AccountDataSet.Open;
       SearchEdit1.Enabled:=True;
       SearchEdit1.Color:=clWhite;
       DBLookupComboBox1.Enabled:=True;
       DBLookupComboBox1.Color:=clWhite;
       SearchEdit1.Text:=AccountDataSet.FieldByName('acc_no').AsString;
       DBLookupComboBox1.KeyValue:=ExpBatchsDataSet.FieldByName('bkliid').AsInteger;

      end;

      end;
    end;

  end;




end;

procedure TFormPayments.SearchEdit1Change(Sender: TObject);
begin
  if (SearchEdit1.Color <>clred) and(SearchEdit1.Text<>'') then
   begin
     DBLookupComboBox1.KeyValue :=ExpDataModule.AccDataSet.fieldbyname('NAME').AsString;
     DBLookupComboBox2.KeyValue :=ExpDataModule.AccDataSet.fieldbyname('val_acc').AsString;
   end;
end;

end.
