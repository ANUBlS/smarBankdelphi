procedure TExpCustomersType.FormShow(Sender: TObject);
var   MyTreeNode1, MyTreeNode2: TTreeNode;
begin
  TreeView1.Items.Clear;
  with ExpDataModule do
  begin
     ExpTypeDataSet.First;
    while not ExpTypeDataSet.Eof do
    begin
      MyTreeNode1:=TreeView1.Items.AddChild(nil,ExpTypeDataSet.FieldByName('name').AsString);
      MyTreeNode1.ImageIndex:=0;
      MyTreeNode1.SelectedIndex:=1;

      begin
        ExpSettingsDataSet.First;
        while not ExpSettingsDataSet.Eof do
        begin
          MyTreeNode2:=TreeView1.Items.AddChild(MyTreeNode1,ExpSettingsDataSet.FieldByName('name').AsString);
          MyTreeNode2.ImageIndex:=2;
          MyTreeNode2.SelectedIndex:=2;
          ExpSettingsDataSet.Next;
        end;
        end;
    ExpTypeDataSet.Next;
    end;
 end;
     TreeView1.FullExpand;
end;

procedure TExpCustomersType.TreeView1Change(Sender: TObject; Node: TTreeNode);
begin
   typecode:=Node.ImageIndex;
   typetext:=Node.Text;
end;

procedure TExpCustomersType.TreeView1DblClick(Sender: TObject);
var v_groups:integer;
begin
  if typecode=2 then
  begin
    with ExpDataModule,ExpGroupsDataset do
    begin
      close;
      SetVariable('name',typetext);
      Open;
      v_groups:=FieldByName('groups').AsInteger;
    end;

   case v_groups of
    1: begin
         exit;
         ExpFormNew.PageControl1.ActivePageIndex:=0;
         ExpFormNew.expid:=1;
         ExpFormNew.FForm:=0;
         ExpFormNew.Button1.Visible:=True;
         ExpFormNew.ShowModal;
       end;
    2:begin
        Formpayments.exid:=2;
        Formpayments.FForm:=0;
         with ExpDataModule do
          begin
            ExpSetDataSet.Filter:='name='+QUOTEDSTR(typetext);
            ExpSetDataSet.Filtered:=true;
          end;
        if typetext='Cari Hesaba Mədaxil' then FormPaymentsCredit.ShowModal
                             else  Formpayments.ShowModal;
      end;

    end;

  end;

end;

