procedure TExpress.ActionDeleteOutExecute(Sender: TObject);
begin
//  ExpDataModule.SB_ACA.CallProcedure('CheckAdvancedObjectAccess',['EXPRESS_DELETE']);
  with ExpDataModule,ExpBatchsDataSet,EXPESSPAC do
  begin
    if recordcount=0 then exit;
    if (Fieldbyname('status').Asinteger=0) then
    case Messagedlg('Əməliyyatın silinməsinə əminsinizmi?',mtConfirmation, [mbYes, mbNo], 0) of
    mrYes:CallProcedure('Exp_batchs_delete',['v_id',ExpDataModule.ExpBatchsDataSet.Fieldbyname('id').Asinteger]) ;
    mrNo:exit;
    end
    Else

    IF (MessageDlg('Əməliyyatı ləğv etmək mümkün deyil.Yalniz əməliyyatı geri qaytaradan sonra silə bilersiz!',mtWarning,
                 [mbYes],0)=mrYes)THEN EXIT;
    Refresh;
  end;
end;

procedure TExpress.ActionEditOutExecute(Sender: TObject);
var v_expid,v_optype,id:integer;
begin
//  ExpDataModule.SB_ACA.CallProcedure('CheckAdvancedObjectAccess',['EXPRESS_EDIT']);
  v_expid:=ExpDataModule.ExpBatchsDataSet.FieldByName('expid').AsInteger;
  if (ExpDataModule.ExpBatchsDataSet.FieldByName('status').AsInteger=1) or(ExpDataModule.ExpBatchsDataSet.FieldByName('status').AsInteger=3) then exit;
  case v_expid of
  1:begin

      ExpFormNew.PageControl1.ActivePageIndex:=0;
      ExpFormNew.FForm:=1;
      ExpFormNew.Button1.Visible:=True;
      ExpFormNew.ShowModal;
    end;
  2:begin

      FormPayments.FForm:=1;
      v_optype:=ExpDataModule.ExpBatchsDataSet.FieldByName('optype').AsInteger;
      if v_optype=4 then begin
                           FormPaymentsCredit.FForm:=1;
                           FormPaymentsCredit.ShowModal;
                         end
                    else FormPayments.ShowModal;
    end;
  end;


end;

