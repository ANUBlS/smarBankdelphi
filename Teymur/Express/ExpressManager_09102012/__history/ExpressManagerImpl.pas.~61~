procedure TExpress.ActionTakeInExecute(Sender: TObject);
var id,status,optype:integer;
    setir:string;
begin
  optype:=ExpDataModule.ExpIncomingDataSet.FieldByName('optype').AsInteger;
  id:=ExpDataModule.ExpIncomingDataSet.FieldByName('id').AsInteger;
  if status=1 then
    begin
      ExpDataModule.ExpIncomingDataSet.Refresh;
      exit;
    end;

  with ExpDataModule do
        begin
          FilialDataSet.Close;
          FilialDataSet.SQL[1]:='';
          FilialDataSet.SQL[1]:='where id=(select filialid from sba_objinf where sysuserid=uid)';
          FilialDataSet.Open;
        end;

  IF optype=1
  THEN
    BEGIN
      ExpPasswordForm.EditPassword.Clear;
      ExpPasswordForm.ShowModal;
    END
  ELSE
    BEGIN
      //ExpFormNew.FForm:=2;
      //IF optype=1 then ExpFormNew.ShowModal;
      IF optype=4 then
      begin
        IF ExpDataModule.ExpIncomingDataSetBFILIAL.AsInteger<>ExpDataModule.FilialDataSet.FieldByName('id').AsInteger  THEN EXIT
        ELSE
          BEGIN
            with ExpDataModule do
            begin
              try
                repair.CallProcedure('Exp_Payments_TakeTransactions',[id]);
                sboapiDataModule.SBSession.Commit;
              Except
                on E : Exception do
                begin
                  setir:= E.Message;
                  sboapiDataModule.SBSession.Rollback;
                  ShowMessage(setir) ;
                end;
              end;
             ExpIncomingDataSet.Refresh;
             ExpIncomingDataSet.Locate('ID',ID,[]);
          END;

      end;

    END;
    END;



end;

