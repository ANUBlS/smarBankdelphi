procedure TFormNominalCustomers.parametr;
begin
  with FormPaymentsCredit do
  begin

  doc_type     :=CBoxPassPlace.KeyValue;
  passpin      :=Editpasspin.Text;
  passer       :=EditSerial.Text;
  paspnum      :=EditPassport.Text;
  doc_country  :=issue_country.KeyValue;
  paspplace    :=DBCBox_DocTYPE.Text;


  if VarIsNull(DateEdit.Value) then  paspdate:=Null
                               else  paspdate:=DateEdit.Value;

   if VarIsNull(DateEdit1.Value) then  passexpire:=Null
                                 else  passexpire:=DateEdit1.Value;




  if VarIsNull(DBCBox_Citizenship.KeyValue) then citizenship:=-1
                                            else citizenship  :=DBCBox_Citizenship.KeyValue;


  lastname     :=EditLastName.Text;
  soname       :=EditSoname.Text;
  name         :=EditName1.Text;
  sex          :=CBoxSex.KeyValue;
  fam_status   :=CBoxFamStatus.KeyValue;
  bbirthplace  :=birthplace.text;
  birth_state  :=EditBirthCity.Text;



  if VarIsNull(DateEdit2.Value) then  birthday:=Null
                                else  birthday:=DateEdit2.Value;

  aadrs_state  :=adrs_state.Text;
  city         :=Adrs_City.Text;
  reg_zip      :=ZipQ.Text;
  address      :=AdressEdit.Text;
  phone_m      :=EditMobil.Text;
  phone_h      :=EditPhone.Text;
  e_mail       :=EditEmail.Text;


  work_place     :=FormNominalCustomers.Work_Place.Text;
  work_adrs_spec :=FormNominalCustomers.Address_type.KeyValue;
  work_cntr      :=FormNominalCustomers.CountryByConctType.KeyValue;
  work_city      :=FormNominalCustomers.CityByConctType.KeyValue;
  work_state     :=FormNominalCustomers.db_tph_state.Text;
  work_zip       :=FormNominalCustomers.DB_tph_zip.Text;
  work_adress    :=FormNominalCustomers.db_tph_adress.Text;
  work_phone_spec:=FormNominalCustomers.tph_contact_type.KeyValue;
  work_phconttype:=FormNominalCustomers.tph_communication_type.KeyValue;
  work_phoppref  :=FormNominalCustomers.tph_country_prefix.KeyValue;
  work_phone     :=FormNominalCustomers.Db_tph_number.Text;
  work_phext     :=FormNominalCustomers.Db_tph_extension.Text;
  work_phcode    :=FormNominalCustomers.Db_tph_cod.Text;







  if  RadioButton1.Checked  then v_nerezident :=1
                            else v_nerezident :=0;



 end;

end;



