procedure TFormNominalCustomers.CBoxPassPlaceCloseUp(Sender: TObject);
begin
    Case CBoxPassPlace.KeyValue of
    1:begin
        EditSerial.Text:=ExpDataModule.DocTypesDataSet.FieldByName('series').AsString;
        EditSerial.ReadOnly:=true;
        EditPassport.MaxLength:=8;
        EditPassport.Clear;
      end;
    2:begin
        EditSerial.Text:=ExpDataModule.DocTypesDataSet.FieldByName('series').AsString;
        EditSerial.ReadOnly:=true;
        EditPassport.MaxLength:=8;
        EditPassport.Clear;
      end;
    3:begin
        EditSerial.Text:=ExpDataModule.DocTypesDataSet.FieldByName('series').AsString;
        EditSerial.ReadOnly:=false;
        EditPassport.MaxLength:=0;
        EditPassport.Clear;
      end;
    4:begin
        EditSerial.Text:=ExpDataModule.DocTypesDataSet.FieldByName('series').AsString;
        EditSerial.ReadOnly:=false;
        EditPassport.MaxLength:=0;
        EditPassport.Clear;
      end;
  end;

end;

procedure TFormNominalCustomers.DateEdit1Change(Sender: TObject);
 var F:boolean;

begin
  F:=ExpDataModule.Repair.CallBooleanFunction('Date_Difference',[DateEdit1.Value]);
  IF F then begin
                 ShowMessage('Etibarlıq müddəti sistem tarixindən kiçik və ya bərabər ola bilməz!..........');
                 DateEdit1.Clear;
                 exit;
               end;
end;

procedure TFormNominalCustomers.EditpasspinKeyPress(Sender: TObject;
  var Key: Char);
VAR S:string;
    Sum:real;
BEGIN
  IF not(ExpFormNew.Rk) THEN
  BEGIN

  Sum:=0;
  S:='';
  IF Key=#13 THEN
  begin
  IF (Sender as TEdit).Text<>'' THEN
  BEGIN
    S:=copy((Sender as TEdit).name,5,length((Sender as TEdit).name));
    S:='('+S+'='+''''+(Sender as TEdit).text+''''+')';
   // S:=S+' ' + 'and (Cust_type=4)';
  END;
  WITH ExpDataModule,SearchCustDataSet DO
    BEGIN
      Filter:='';
      Filter:=S;
      Filtered:=true;
      IF RecordCount=0 THEN
      BEGIN
            ShowMessage('Müştəri tapılmadı');
            RadioButton1.Checked :=true;
            EditLastName.Clear;
            EditName1.Clear;
            EditSoname.Clear;
            CBoxPassPlace.KeyValue:=-1;
            EditSerial.Clear;
            EditPassport.Clear;
            Issue_country.KeyValue:=-1;
            DBCBox_DocTYPE.KeyValue:=-1;
            DateEdit.Clear;
            DateEdit1.Clear;
