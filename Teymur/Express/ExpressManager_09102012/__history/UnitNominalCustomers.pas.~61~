procedure TFormNominalCustomers.FormShow(Sender: TObject);
begin
  IF not(ExpFormNew.Rk)
  THEN
  Begin
  IF ((FormPaymentsCredit.FForm=0) and (RH=False)) then
  begin
    ExpFormNew.Rk:=False;
    NominalClear(ExpFormNew.Rk);
    EditLastName.Enabled :=True;
    EditLastName.Color   :=clWhite;
    EditName1.Enabled    :=True;
    EditName1.Color      :=clWhite;
    EditSoname.Enabled   :=True;
    EditSoName.Color     :=clWhite;
    Editpasspin.Enabled  :=True;
    Editpasspin.Color    :=clWhite;
    CBoxPassPlace.Enabled:=True;
    CBoxPassPlace.Color  :=clWhite;
    EditSerial.Enabled   :=True;
    EditSerial.Color     :=clWhite;
    EditPassport.Enabled :=True;
    EditPassport.Color   :=clWhite;
