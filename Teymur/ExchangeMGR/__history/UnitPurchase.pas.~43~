  Edit_nb_course.Text :=DataModExch.ODSExchAcc.FieldByName('val_nb_course').AsString;

  Edit_Purchase_Amount.Enabled:=(Edit_purchase_course.Text<>'');
  Edit_Ekv_Amount.Enabled:=(Edit_purchase_course.Text<>'');
