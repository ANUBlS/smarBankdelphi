procedure TFormPurchase.Edit_Purchase_AmountChange(Sender: TObject);
const
      purchase_status=' KURSLA ALIŞI ';
var
       Ekv,Fee :Extended;

begin

 if Edit_Purchase_Amount.Text<>'' then
  begin
   Edit_Setting.Text:=SumNumToFull(StrToFloat(Edit_Purchase_Amount.Text))
    +
    ' '
    +
     DBLC_Currency.ListSource.DataSet.FieldByName('val_name').AsString
    +
    ' -nin '
    +
    Edit_purchase_course.Text
    +
    purchase_status;

  Ekv:=StrToFloat(Edit_Purchase_Amount.Text)*StrToFloat(Edit_purchase_course.Text);
  Fee:=//ABS
          -(
            roundto((StrToFloat(Edit_Purchase_Amount.Text)*StrToFloat(Edit_purchase_course.Text)),-2)
           -
            roundto((StrToFloat(Edit_Purchase_Amount.Text)*StrToFloat(Edit_nb_course.Text)),-2)
            );
    //  ShowMessage(FloatToStr(ekv));
      Edit_Ekv_Amount.Text:=FloatToStr(RoundTo(Ekv,-2));

      Edit_Fee_Amount.Text:=FloatToStr(RoundTo(Fee,-2));
      //FormatFloat('#.##',Fee);

  end
 else
   begin
      Edit_Setting.Text:=EmptyStr;
      Edit_Ekv_Amount.Text:=EmptyStr;
      Edit_Fee_Amount.Text:=EmptyStr;
   end;

end;
