procedure TFormPurchase.FormActivate(Sender: TObject);
Var Delta:boolean;
begin
           DBLC_Country.KeyValue:=-1;
           DBLC_Cust_Confirm.KeyValue:=-1;
           DBLC_Father.KeyValue:=-1;
           DBLC_First_Name.KeyValue:=-1;
           DBLC_Giving_Member.KeyValue:=-1;
           DBLC_Last_Name.KeyValue:=-1;

    DTP_Date.Date:=Date;
    DTP_System_Time.Time:=Time;

  DataModExch.OPExchMgr.CallProcedure('Ex_CourseDifference',[DataModExch.ODSExchOfficeEX_NO.AsInteger]);

  {if not(Delta) then begin
                  FormRate.SetExchangeRate(DataModExch.ODSExchOfficeEX_NO.AsInteger);
                  FormRate.BtnOkClick(Sender);
                end;  }



 with DataModExch.ODSExchProvarch do
   begin
     case StatusExchange  of
        sePurchaseInsert: begin
                           ClearEdit;
                           Edit_Purchase_Amount.Enabled:=false;
                          end;





 sePurchaseEdit:
      begin
                Edit_Purchase_Amount.Enabled:=true;
                DTP_Date.Date:=Int(FieldByName('dat').AsDateTime);
                DBLC_Currency.KeyValue:=DataModExch.ODSExchProvarch.FieldByName('val_id').AsInteger;
                Edit_purchase_course.Text:=FloatToStr(FieldByName('op_course').AsFloat);
                Edit_nb_course.Text:=FloatToStr(FieldByName('val_nb_course').AsFloat);
                Edit_Purchase_Amount.Text:=FloatToStr(FieldByName('debitamount').AsFloat);
                Edit_Ekv_Amount.Text:=FloatToStr(FieldByName('lamount').AsFloat);
                Edit_Fee_Amount.Text:=FloatToStr(FieldByName('fee_amount').AsFloat);
                Edit_Setting.Text:=FieldByName('oper_name').AsString;
                Edit_First_Name.Text:=FieldByName('cust_name').AsString;
                Edit_Last_Name.Text:=FieldByName('cust_lname').AsString;
                Edit_Pasport.Text:=FieldByName('cust_passport').AsString;
                Edit_Father.Text:=FieldByName('cust_father').AsString;
                Edit_Cust_Date.Text:=FieldByName('cust_date').AsString;
                Edit_Cust_Confirm.Text:=FieldByName('cust_confirm').AsString;
                Edit_Giving_Member.Text:=FieldByName('cust_giving_member').AsString;
                Edit_Val_Changed.Tag:=1;
                Edit_Country.Text:= FieldByName('cust_country').AsString;
                Edit_AZE.Text:= FieldByName('country').AsString;
       end;

    end;

  end;

end;

