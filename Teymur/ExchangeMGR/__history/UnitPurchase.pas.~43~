procedure TFormPurchase.BtnRunClick(Sender: TObject);
const
       ex_status=1;
var
v_id,s   :integer;
a_Flags :boolean;
DebitAccId   :Integer;
KreditAccId  :Integer;
CashAccId    :Integer;
PurAccId    :Integer;
KreditAccNo:string;
DebitAccno:string;
CashAccno:string;
PurAccno:string;
A,B:real;
C:Integer;
sysdate:TDateTime;
dat:TDateTime;

begin
//DataModExch.SBA_ACA.CallProcedure('checkadvancedobjectaccess',['EXCH_TRANS']);
a_Flags     :=false;
sysdate:=Integer(Trunc(DataModExch.SBOPDate.CallDateFunction('get_date',[])));
dat:=Integer(Trunc(DTP_Date.DateTime));

if sysdate<dat then a_Flags:=True;

if DBLC_Currency.Text<>'AZN' then
 begin
     try
          Screen.Cursor:=crSQLWait;

 with DataModExch do
  begin
        v_id                      :=  ODSExchProvarch.FieldByName('id').AsInteger;
        Trans.status              :=  ex_status;
        Trans.operator_id         :=  OPExchMgr.CallIntegerFunction('UserID',[]);
        Trans.trans_date          :=  Integer(Trunc(DTP_Date.DateTime));
        Trans.debit_amount        :=  StrToFloat(Edit_Purchase_Amount.Text);
        Trans.l_amount            :=  StrToFloat(Edit_Ekv_Amount.Text);
        Trans.fee_amount          :=  StrToFloat(Edit_Fee_Amount.Text);
        Trans.val_course          :=  StrToFloat(Edit_purchase_course.Text);
        Trans.trans_name          :=  Edit_Setting.Text;
        Trans.cust_name           :=  Edit_First_Name.Text;
        Trans.cust_lname          :=  Edit_Last_Name.Text;
        Trans.cust_passport       :=  Edit_Pasport.Text;
        Trans.exch_name           :=  Edit_Exch.Text;
        Trans.val_id              :=  DBLC_Currency.KeyValue;
        Trans.ex_id               :=  ODSExchOffice.FieldByName('ex_no').AsInteger;
        Trans.cust_father         :=  Edit_Father.Text;
        Trans.cust_date           :=  Edit_Cust_Date.Text;
        Trans.cust_confirm        :=  Edit_Cust_Confirm.Text;
        Trans.cust_giving_member  :=  Edit_Giving_Member.Text;
        Trans.val_nb_course       :=  StrToFloat(Edit_nb_course.Text);
        Trans.op_time             :=  DTP_System_Time.DateTime;
        Trans.val_name            :=  DBLC_Currency.Text;
        Trans.val_changed_name    :=  Edit_Val_Changed.Text;
        Trans.val_changed_id      :=  Edit_Val_Changed.Tag;
        Trans.val_changed_course  :=  1;
        Trans.cust_country        :=  Edit_Country.Text;
        Trans.country             :=  Edit_AZE.Text;
        Trans.SessionName         :=  DataModExch.OPExchMgr.Session.LogonUserName;

case StatusExchange of

sePurchaseInsert:
begin
  with OPTrans do  begin
   resultID:=
       CallIntegerFunction('add_ex_prov_trans',[
                                                'status',             Trans.status,
                                                'operator_id',        Trans.operator_id,
		                                            'trans_date',         Trans.trans_date,
		                                            'debit_amount',       Trans.debit_amount,
	                                              'l_amount',           Trans.l_amount,
	                                              'fee_amount',         Trans.fee_amount,
		                                            'val_course',         Trans.val_course,
		                                            'trans_name',         Trans.trans_name,
		                                            'cust_name',          Trans.cust_name,
                                                'cust_lname',         Trans.cust_lname,
                                                'cust_passport',      Trans.cust_passport,
                                                'exch_name',          Trans.exch_name,
                                                'val_id',             Trans.val_id,
                                                'ex_id',              Trans.ex_id,
                                                'cust_father',        Trans.cust_father,
                                                'cust_date',          Trans.cust_date,
                                                'cust_confirm',       Trans.cust_confirm,
                                                'cust_giving_member', Trans.cust_giving_member,
                                                'val_nb_course',      Trans.val_nb_course,
                                                'op_time',            Trans.op_time,
                                                'val_name',           Trans.val_name,
                                                'val_changed_name',   'AZN',
                                                'val_changed_id',     Trans.val_changed_id,
                                                'val_changed_course', Trans.val_changed_course,
                                                'cust_country',       Trans.cust_country,
                                                'country',            Trans.country,
                                                'SessionName',        Trans.SessionName
                                                  ]);
                CallProcedure('ex_constants_add',[
                                                   'a_ex_id',              Trans.ex_id,
                                                   'a_cust_name',          Trans.cust_name,
                                                   'a_cust_lname',         Trans.cust_lname,
                                                   'a_cust_passport',      Trans.cust_passport,
                                                   'a_cust_father',        Trans.cust_father,
                                                   'a_cust_date',          Trans.cust_date,
                                                   'a_cust_confirm',       Trans.cust_confirm,
                                                   'a_cust_giving_member', Trans.cust_giving_member,
                                                   'a_cust_country',       Trans.cust_country,
                                                   'a_country',            Trans.country
                                                   ]);
                          end;
                    open_cust_data_sets;


              KreditAccNo:=OPExchMgr.CallStringFunction('get_purchase_no',
                                                           [Trans.ex_id,
                                                            Trans.val_id]
                                                          );
              DebitAccno :=OPExchMgr.CallStringFunction('get_selling_no',
                                                            [Trans.ex_id,
                                                             Trans.val_id]
                                                          );

              CashAccno :=OPExchMgr.CallStringFunction('get_cash_acc_no',
                                                            [Trans.ex_id,
                                                             Trans.val_id]
                                                          );
              PurAccno :=OPExchMgr.CallStringFunction('get_pur_acc_no',
                                                            [Trans.ex_id,
                                                             Trans.val_id]
                                                          );


              DebitAccId  :=sb_transaction.CallIntegerFunction('Get_Acc_Id',[DebitAccno]);
              KreditAccId :=sb_transaction.CallIntegerFunction('Get_Acc_Id',[KreditAccNo]);
              CashAccId   :=sb_transaction.CallIntegerFunction('Get_Acc_Id',[CashAccno]);
              PurAccId    :=sb_transaction.CallIntegerFunction('Get_Acc_Id',[PurAccno]);

            A:=StrToFloat(Edit_purchase_course.Text);
           // B:=trunc(DataModExch.ODSExchAcc.FieldByName('val_purchase_course').AsFloat*1000000);
           // C:=(A-B);
          //  ShowMessage(IntToStr(C));
            C:=OPExchMgr.CallIntegerFunction('Ex_CourseRates',[resultID,A]);
            IF C=0
             THEN
             BEGIN

           // if trim(FloatToStr( Trans.val_course))<>'1' then
             s := sb_transaction.CallIntegerFunction('ex_transaction',

                                                                        [ resultID,
                                                                          DebitAccId,               { K }
                                                                          KreditAccId,
                                                                          CashAccId,
                                                                          PurAccId,
                                                                          Trans.ex_id,
                                                                          Trans.debit_amount,
                                                                          Trans.debit_amount,       { N }
                                                                          Trans.l_amount,
                                                                          Trans.val_course,
                                                                          Trans.val_changed_course, { N }
                                                                          Trans.val_nb_course,
                                                                          Trans.trans_name,
                                                                          a_Flags,
                                                                          Trans.operator_id
                                                                        ]
                                                                        );




           END;
           sboapiDataModule.SBSession.Commit;
           with DataModExch.ODSExchProvarch do Refresh;
           with DataModExch.ODSExchRate do Refresh;


    end;{case -1-}

sePurchaseEdit:
begin
  with OPTrans do

       CallProcedure('ex_provarch_edit',[
                                                'v_id',               v_id,
                                                'status',             Trans.status,
                                                'operator_id',        Trans.operator_id,
		                                            'trans_date',         Trans.trans_date,
		                                            'debit_amount',       Trans.debit_amount,
	                                              'l_amount',           Trans.l_amount,
	                                              'fee_amount',         Trans.fee_amount,
		                                            'val_course',         Trans.val_course,
		                                            'trans_name',         Trans.trans_name,
		                                            'cust_name',          Trans.cust_name,
                                                'cust_lname',         Trans.cust_lname,
                                                'cust_passport',      Trans.cust_passport,
                                                'exch_name',          Trans.exch_name,
                                                'cust_father',        Trans.cust_father,
                                                'cust_date',          Trans.cust_date,
                                                'cust_confirm',       Trans.cust_confirm,
                                                'cust_giving_member', Trans.cust_giving_member,
                                                'val_nb_course',      Trans.val_nb_course,
                                                'val_name',           Trans.val_name,
                                                'val_changed_name',   'AZN',
                                                'val_changed_id',     Trans.val_changed_id,
                                                'val_changed_course', Trans.val_changed_course,
                                                'cust_country',       Trans.cust_country,
                                                'country',            Trans.country,
                                                'SessionName',        Trans.SessionName
                                                  ]);

           with ODSExchProvarch do Refresh;
           with ODSExchRate do Refresh;                  


     end;{case -2-}



   end;{case}


 end; {with}





       Except
           on E : Exception do
           begin
             sboapiDataModule.SBSession.Rollback;
             ShowMessage(E.Message);
           end;{try}


     end;

 Screen.Cursor:=crDefault;
 Close;

 end
     else
          ShowMessage('Valyutalar eynidir!');

end;

