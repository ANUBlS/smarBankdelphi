end;

procedure TDataModExch.ODSReportingCalcFields(DataSet: TDataSet);
begin
  ODSReportingDeltaAmount.AsFloat:=ODSReportingPURCHASEAMOUNT.AsFloat-ODSReportingSALESAMOUNT.AsFloat;
end;

