end;

procedure TDataModExch.ODSExchProvarchAfterScroll(DataSet: TDataSet);
begin
  ExchangeMGR_X.DBGridEhTrans.SelectedRows.Clear;
  ExchangeMGR_X.ToolButton1.Enabled:=not DataSet.IsEmpty;
  ExchangeMGR_X.ToolButton1.Enabled:=DataModExch.ODSExchProvarch.FieldByName('trans_close').AsInteger in [msCommit];
  ExchangeMGR_X.ToolButton27.Enabled:=not DataSet.IsEmpty;
  ExchangeMGR_X.ToolButton27.Enabled:=DataModExch.ODSExchProvarch.FieldByName('trans_close').AsInteger in [msdefault];

end;

procedure TDataModExch.ODSExchProvarchBeforeInsert(DataSet: TDataSet);
begin
