implementation


function RoundEx(X: Double; Precision: Integer ): Double;

var
  ScaledFractPart, Temp: Double;
begin
  ScaledFractPart := Frac(X) * Precision;
  Temp := Frac(ScaledFractPart);
  ScaledFractPart := Int(ScaledFractPart);
  if Temp=5 then
    ScaledFractPart := ScaledFractPart + 1;
  if Temp=-5 then
    ScaledFractPart := ScaledFractPart - 1;


  RoundEx := Int(X) + ScaledFractPart / Precision;
end;


procedure SetRU;
var
  Layout: array [0.. KL_NAMELENGTH] of char;
begin
  LoadKeyboardLayout(StrCopy(Layout, '00000419'), KLF_ACTIVATE);
end;

procedure SetEN;
var
  Layout: array [0.. KL_NAMELENGTH] of char;
begin
  LoadKeyboardLayout(StrCopy(Layout, '00000409'), KLF_ACTIVATE);
end;

function SumNumToFullVal(Number :real; val_name, val :string):string;
var
  PartNum, TruncNum, NumTMP, D: integer;
  NumStr : string;
  i, R : byte;
  Flag11 : boolean;
begin
PartNum:=0;
  D:=1000000;
  R:=4;

  TruncNum:=Trunc(Number);
  if TruncNum<>0 then
    repeat
      PartNum:=TruncNum div D;
      Dec(R);
      D:=D div 1000;
    until
      PartNum<>0
  else
    R:=0;


  for i:=R downto 1 do
  begin
    Flag11:=False;

    NumTMP:=PartNum div 100;
    case NumTMP of
      1: NumStr:=NumStr+'YÜZ ';
      2: NumStr:=NumStr+'İKİ YÜZ ';
      3: NumStr:=NumStr+'ÜÇ YÜZ ';
      4: NumStr:=NumStr+'DÖRD YÜZ ';
      5: NumStr:=NumStr+'BEŞ YÜZ ';
      6: NumStr:=NumStr+'ALTI YÜZ ';
      7: NumStr:=NumStr+'YEDDİ YÜZ ';
      8: NumStr:=NumStr+'SƏKKİZ YÜZ ';
      9: NumStr:=NumStr+'DOQQUZ YÜZ ';
    end;

    NumTMP:=(PartNum mod 100) div 10;
    case NumTMP of
      1:
      begin
        NumTMP:=PartNum mod 100;
        case NumTMP of
          10: NumStr:=NumStr+'ON ';
          11: NumStr:=NumStr+'ON BİR ';
          12: NumStr:=NumStr+'ON İKİ ';
          13: NumStr:=NumStr+'ON ÜÇ ';
          14: NumStr:=NumStr+'ON DÖRD ';
          15: NumStr:=NumStr+'ON BEŞ ';
          16: NumStr:=NumStr+'ON ALTI ';
          17: NumStr:=NumStr+'ON YEDDİ ';
          18: NumStr:=NumStr+'ON SƏKKİZ ';
          19: NumStr:=NumStr+'ON DOQQUZ ';
        end;
        case i of
          3: NumStr:=NumStr+'MİLİYON ';
          2: NumStr:=NumStr+'MİN ';
          1: NumStr:=NumStr+val_name;
        end;
        Flag11:=True;
      end;
      2: NumStr:=NumStr+'ийирми ';
      3: NumStr:=NumStr+'отуз ';
      4: NumStr:=NumStr+'гырх ';
      5: NumStr:=NumStr+'ялли ';
      6: NumStr:=NumStr+'атмыш ';
      7: NumStr:=NumStr+'йетмиш ';
      8: NumStr:=NumStr+'сексен ';
      9: NumStr:=NumStr+'дохсан ';
    end;

    NumTMP:=PartNum mod 10;
    if not Flag11 then
    begin
      case NumTMP of
        1:
          if i=2 then
            NumStr:=NumStr+'бир '
          else
            NumStr:=NumStr+'бир ';
        2:
          if i=2 then
            NumStr:=NumStr+'ики '
          else
            NumStr:=NumStr+'ики ';
        3: NumStr:=NumStr+'цч ';
        4: NumStr:=NumStr+'дюрд ';
        5: NumStr:=NumStr+'беш ';
        6: NumStr:=NumStr+'алты ';
        7: NumStr:=NumStr+'йедди ';
        8: NumStr:=NumStr+'секкиз ';
        9: NumStr:=NumStr+'доггуз ';
      end;
      case i of
        3:
          case NumTMP of
            1: NumStr:=NumStr+'милйон ';
            2,3,4: NumStr:=NumStr+'милйон ';
            else
              NumStr:=NumStr+'милйон ';
          end;
        2:
          case NumTMP of
            1 : NumStr:=NumStr+'мин ';
            2,3,4: NumStr:=NumStr+'мин ';
            else
              if PartNum<>0 then
                NumStr:=NumStr+'мин ';
          end;
        1:
          case NumTMP of
            1 : NumStr:=NumStr+val_name;
            2,3,4: NumStr:=NumStr+val_name;
            else
              NumStr:=NumStr+val_name;
          end;
      end;
    end;
    if i>1 then
    begin
      PartNum:=(TruncNum mod (D*1000)) div D;
      D:=D div 1000;
    end;
  end;


  PartNum:=Round(Frac(Number)*100);
  if PartNum=0 then
  begin
    SumNumToFullVal:=NumStr;
    Exit;
  end;

  NumTMP:=PartNum div 10;
  if NumTMP=0 then
    NumStr:=NumStr+'0'+IntToStr(PartNum)+' '
  else
    NumStr:=NumStr+IntToStr(PartNum)+' ';

  NumTMP:=PartNum mod 10;
  case NumTMP of
    1:
      if PartNum<>11 then
        NumStr:=NumStr+val
      else
        NumStr:=NumStr+val;
    2,3,4:
      if (PartNum<5) or (PartNum>14) then
        NumStr:=NumStr+val
      else
        NumStr:=NumStr+val
    else
      NumStr:=NumStr+val;
  end;
  SumNumToFullVal:=NumStr;
end;


