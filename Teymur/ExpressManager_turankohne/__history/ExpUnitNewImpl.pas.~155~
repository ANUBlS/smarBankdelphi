procedure TExpFormNew.clearall;
var i,j,k,z:integer;
BEGIN
   WITH  TabSheet1 DO
      BEGIN

        FOR i:=0 TO ControlCount-1 DO
        BEGIN
          IF  (Controls[i] is TPanel) THEN
          WITH (Controls[i] as TPanel)DO
          BEGIN
            FOR j:=0 TO ControlCount-1 DO
            BEGIN
              IF (Controls[j] is TGroupBox)THEN
              WITH (Controls[j]as TGroupBox)DO
              BEGIN
                FOR k:= 0 TO ControlCount-1 DO
                BEGIN
                  IF (Controls[k]  is TPanel) then
                  WITH (Controls[k]as TPanel)DO
                  BEGIN
                    FOR z:= 0 TO ControlCount-1 DO
                    BEGIN
                      IF (Controls[z] is TEdit)             THEN
                      IF (Controls[z] as TEdit).Name='CMCurrencyEdit'  THEN (Controls[z] as TEdit).Text:='0.00'
                      ELSE (Controls[z] as TEdit).Clear;
                      IF (Controls[z] is TDBLookupComboBox) THEN
                      IF (Controls[z] as TDBLookupComboBox).Name='FilialName'
                      THEN
                        (Controls[z] as TDBLookupComboBox).KeyValue:=ExpDataModule.FilialDataSet.FieldByName('id').AsInteger
                      ELSE
                        (Controls[z] as TDBLookupComboBox).KeyValue:=-1;
                      IF(Controls[z] is TDBDateTimeEditEh) THEN (Controls[z] as TDBDateTimeEditEh).Clear;
                    END;
                  END;
                END;
              END;
              IF (Controls[j] is TRadioGroup) THEN (Controls[j] as TRadioGroup).ItemIndex:=-1;
            END;
          END;
        END;
      END;
    WITH  TabSheet2 DO
      BEGIN
        FOR i:=0 TO ControlCount-1 DO
        BEGIN

          IF  (Controls[i] is TPanel) THEN
          WITH (Controls[i] as TPanel)DO
          BEGIN
            FOR j:= 0 TO ControlCount-1 DO
            BEGIN
              IF (Controls[j] is TGroupBox)THEN
              WITH (Controls[j]as TGroupBox)DO
              BEGIN
                FOR k:= 0 TO ControlCount-1 DO
                BEGIN
                  IF (Controls[k]  is TPanel) then
                  WITH (Controls[k]as TPanel)DO
                  BEGIN
                    FOR z:= 0 TO ControlCount-1 DO
                    BEGIN
                      IF (Controls[z] is TEdit)                  THEN
                      IF (Controls[z] as TEdit).Name<>'EditDate' THEN (Controls[z] as TEdit).Clear;
                      IF (Controls[z] is TMaskEdit)              THEN (Controls[z] as TMaskEdit).Clear;
                      IF (Controls[z] is TDBLookupComboBox)      THEN (Controls[z] as TDBLookupComboBox).KeyValue:=-1;
                      IF (Controls[z] is TDBDateTimeEditEh)      THEN (Controls[z] as TDBDateTimeEditEh).Clear;
                      IF (Controls[z] is TMemo)                  THEN (Controls[z] as TMemo).Clear;
                    END;
                  END;
                END;
              END;
              IF (Controls[j] is TRadioGroup) THEN   (Controls[j] as TRadioGroup).ItemIndex:=-1;
            END;
          END;
        END;
      END;


END;
procedure TExpFormNew.CMCurrencyEditChange(Sender: TObject);
var sum:real;
begin
  sum:=0;
  if Length(CMCurrencyEdit.Text)=0   then  begin
                                             CMCurrencyEdit2.Text:='';
                                             CMCurrencyEdit3.text:='';
                                             exit
                                           end
  else
  begin
    IF EditCustid.text<>'' THEN  Sum:=ExpDataModule.Repair.CallFloatFunction('SumNominalid',[StrToInt(EditCustid.text)])+StrToFloat(CMCurrencyEdit.Text);
    if (StrToFloat(CMCurrencyEdit.Text)>=20000) and ((RadioGroup1.ItemIndex=-1) or (RadioGroup1.ItemIndex=0)) then ButtonNominal.Enabled:=true
                                                                                                              else ButtonNominal.Enabled:=false;


    CMCurrencyEdit2.Value:=ExpDataModule.Repair.CallFloatFunction('Exp_comissionoperation',[1,StrToFloat(CMCurrencyEdit.Text)]);
    CMCurrencyEdit3.Value:=StrToFloat(CMCurrencyEdit.Text)+CMCurrencyEdit2.Value;
    Edit15.Text:=Mani(StrToFloat(CMCurrencyEdit.text));


  end;
end;

