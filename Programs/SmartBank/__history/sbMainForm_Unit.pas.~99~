  if sboapiDataModule.SBSession.Connected
    and (Mode = modeNormal) then
    with LogTreeView do
      while Sb_LogGetLine(Line) do
      begin
        Selected := LogTreeView.Items.Add;
        with Selected do
        begin
          Caption := TimeToStr(Time);
          SubItems.Add(Line);
        end;
      end;
end;

