        'te=6 and type_id in(1,3,4,8,13,21) and ic.kli_id=c.id and c.cust' +
        '_type=1 ) as fiziki_cem_count,'
      ''
      
        '(select sum(ammount) from ins_contracts ic,customers c where sta' +
        'te=6 and type_id in(1,3,4,8,13,21) and ic.kli_id=c.id and c.cust' +
        '_type=0 ) as huquqi_cem_sum_ammount,'
      
        '(select  sum(ammount) from ins_contracts ic,customers c where st' +
        'ate=6 and type_id in(1,3,4,8,13,21) and ic.kli_id=c.id and c.cus' +
