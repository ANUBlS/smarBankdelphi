  object Ds_Aktiv_full: TOracleDataSet
    SQL.Strings = (
      'select '
      'distinct'
      '(select count(ic.id) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=1 ) as fiziki_count,'
      ''
      '(select count(ic.id) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=1 and ic.bnf_type=0) as f_bnf0_count,'
      ''
      '(select count(ic.id) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=1 and ic.bnf_type=1) as f_bnf1_count,'
      ''
      '(select count(ic.id) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=0 ) as huquqi_count,'
      ''
      '(select count(ic.id) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=0 and ic.bnf_type=0) as h_bnf0_count,'
      ''
      '(select count(ic.id) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=0 and ic.bnf_type=1) as h_bnf1_count,'
      ''
      'nvl((select sum(ammount) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=0),0) as h_sum_ammount,'
      ''
      'nvl((select sum(ammount) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=0 and bnf_type=0),0) as h_sum_ammount_bnf0,'
      ''
      'nvl((select sum(ammount) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=0 and bnf_type=1),0) as h_sum_ammount_bnf1,'
      ''
      'nvl((select sum(ammount) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=1),0) as f_sum_ammount,'
      ''
      'nvl((select sum(ammount) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=1 and bnf_type=0),0) as f_sum_ammount_bnf0,'
      ''
      'nvl((select sum(ammount) from ins_contracts ic,customers c '
      
        'where state=6 and type_id=:TYPE_ID and ic.kli_id=c.id and c.cust' +
        '_type=1 and bnf_type=1),0) as f_sum_ammount_bnf1,'
      ''
      
        'ic.type_id,count(ic.id) as say,(select name from ins_insurances ' +
        'where id = ic.type_id) as type_id_name,'
      'sum(ic.ammount) as siq_haqqi, sum(ic.inssumm) as siq_mebleq,'
      
        'round(((sum(ic.ammount)/sum(ic.inssumm))*100),2) as orta_siq_tar' +
        'ifi,'
      ''
      
        '(select count(*) from ins_contracts ic,customers c where ic.stat' +
        'e=6 and ic.type_id in(1,3,4,8,13,21) and ic.kli_id=c.id) as cemi' +
        '_say,'
      ''
      
        '(select sum(ammount) from ins_contracts ic,customers c where ic.' +
        'state=6 and ic.type_id in(1,3,4,8,13,21) and ic.kli_id=c.id) as ' +
        'cemi_siq_haqq,'
      
        '(select sum(inssumm) from ins_contracts ic,customers c where ic.' +
        'state=6 and ic.type_id in(1,3,4,8,13,21) and ic.kli_id=c.id) as ' +
        'cemi_siq_mebleq,'
      ' '
      
        'round(((select sum(ammount) from ins_contracts ic,customers c wh' +
        'ere ic.state=6 and ic.type_id in(1,3,4,8,13,21) and ic.kli_id=c.' +
        'id)/'
      
        '(select sum(inssumm) from ins_contracts ic,customers c where ic.' +
        'state=6 and ic.type_id in(1,3,4,8,13,21) and ic.kli_id=c.id)*100' +
        '),2) as cem_orta_siq_tarifi,'
      ''
      
        '(select count(ic.id) from ins_contracts ic,customers c where sta' +
        'te=6 and type_id in(1,3,4,8,13,21) and ic.kli_id=c.id and c.cust' +
        '_type=0 ) as huquqi_cem_count,'
      
