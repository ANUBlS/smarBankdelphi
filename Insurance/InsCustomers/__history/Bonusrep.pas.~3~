unit Bonusrep;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, CMExcelExport, StdCtrls, ComCtrls;

type
  TBonusReport = class(TForm)
    Edit1: TEdit;
    Edit2: TEdit;
    DateTimePicker1: TDateTimePicker;
    DateTimePicker2: TDateTimePicker;
    Button1: TButton;
    ExcelExport: TCMExcelExport;
    Label1: TLabel;
    Label2: TLabel;
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  BonusReport: TBonusReport;

implementation

uses InsDataModule;

{$R *.dfm}

procedure TBonusReport.Button1Click(Sender: TObject);
begin
InsDataMod.ins_bonushesabat.CloseAll;

InsDataMod.ins_bonushesabat.SetVariable('dat1',DateTimePicker1.Date);
InsDataMod.ins_bonushesabat.SetVariable('dat2',DateTimePicker2.Date);
InsDataMod.ins_bonushesabat.SetVariable('balcndb',edit1.text);
InsDataMod.ins_bonushesabat.SetVariable('balcnkr',edit2.text);
InsDataMod.ins_bonushesabat.Open;
 with ExcelExport do
   begin
      Connect;
      ExportDataset(InsDataMod.ins_bonushesabat,'Bonus Hesabatý.',True,false);
      Disconnect;
   end;
end;

end.
