function TfmMEDSuggestion.UIObjectActivate: HResult;
begin
       id := StrToInt(Get_Params('MED_ID'));
       ODSAvalute.open;       
       ODSCusts.SetVariable('id',StrToInt(Get_Params('KLI_ID')));
       ODSCusts.Open;

       ODSMEDICAL.SetVariable('MED_ID', id);
       ODSMEDICAL.Open;

       ODSMEDS.SetVariable('MED_ID', id);
       ODSMEDS.Open;

       ODSCONTRACTS.SetVariable('blankid', id);
       ODSCONTRACTS.Open;

       IsSaved := false;
       if ODSMEDS.isEmpty then begin   //-----Insert mod
         ODSMEDS.Insert;
         DTPContractDate.DateTime := now;

         Caption := format(fmCaption, ['Yeni teklifname']);
       end
       else begin  //-----Edit mod
         DTPContractDate.DateTime := ODSMEDSENDDATE.value;
         ODSMEDS.Edit;
         Caption := format(fmCaption, ['Redakte']);
         if ODSMEDSITSPEC.Value = 'M'
           then ckMonth.Checked := true;
         if ODSMEDSITSPEC.Value = 'Y'
           then ckYear.Checked := true;
         btPrint.Enabled := True;
         btPolicy.Enabled := True;
       end;  

  Result := S_OK;
end;

