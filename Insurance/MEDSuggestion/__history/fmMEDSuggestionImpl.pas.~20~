  if SaveData() then
  begin
    btPrint.Enabled := True;
    btPolicy.Enabled := True;
    btApply.Enabled := False;
  end;
end;

procedure TfmMEDSuggestion.btPolicyClick(Sender: TObject);
var
  PolicFormGuid : TGuid;
  Params : TStringList;
begin

  with  ODSContracts do
    if State in [dsEdit, dsInsert] then
     if MessageDlg('Dəyişkəlik yadda saxlanılsın?',
                mtInformation, [mbYes, mbCancel], 0) = mrYes then
     SaveData()
    else
     Exit;

  Params := TStringList.Create;
  PolicFormGuid := StringToGUID('{6730B53F-5460-40A6-8554-F904B6690915}');
  Params.Values['MEDS_ID'] := FloatToStr(ODSMEDSID.Value);
  Params.Values['med_id'] := FloatToStr(ODSMEDSMED_ID.Value);
  with pmcPolicy do
   ShowModal(PolicFormGuid, Params);
  Params.Free;

end;

