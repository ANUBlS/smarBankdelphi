function TfmMEDSuggestion.SaveData():Boolean;
begin
  Result := False;

  with ODSMEDS do begin
    if not (State in [dsEdit, dsInsert]) then exit;
    FieldByName('med_id').AsFloat := id;
    FieldByName('enddate').AsDateTime := DTPContractDate.DateTime;
    if ckMonth.Checked then
     FieldByName('ITSPEC').asString := 'M';
    if ckYear.Checked then
     FieldByName('ITSPEC').asString := 'Y';

    Post;
    RefreshRecord();
    ODSContracts.Edit;
   // ODSContracts.FieldByName('sugg_id').AsFloat := FieldByName('id').asFloat;
    ODSContracts.FieldByName('ins_date').AsDateTime := DTPContractDate.DateTime;
    ODSContracts.FieldByName('TYPE_ID').AsFloat := 9;
    ODSContracts.Post;
    IsSaved := True;
    result := True;
  end;

end;


procedure TfmMEDSuggestion.btPrintClick(Sender: TObject);
const
    months : array [1..12] of String = ('Yanvar', 'Fevral', 'Mart', 'Aprel', 'May', 'Iyun',
                                         'Iyul', 'Avqust', 'Sentyabr', 'Oktyabr', 'Noyabr', 'Dekabr');
var
  DocFile : TFileName;
  str, str2 : String;
  day, month, year : word;
begin
  try
    DocFile := ExtractFilePath(Application.ExeName)+'\MedicalSuggestion.doc';
    with SuggestionReport do begin
      FileName := DocFile;
      if ODSMEDS.FieldByName('ITSPEC').AsString = 'M' then
        str := IntToStr(ODSMEDSINSURANCETIME.AsInteger) + ' ay ərzində';
      if ODSMEDS.FieldByName('ITSPEC').AsString = 'Y' then
        str := IntToStr(ODSMEDSINSURANCETIME.AsInteger) + ' il ərzində';

      Open(False);
      SetBookmark('name', ODSCustsNAME.Value, False, False, False, False, 10, 'Arial AzLat', False);
      SetBookmark('empnum', IntToStr(ODSMedicalEMPNUM.value) , False, False, False, False, 10, 'Arial AzLat', False);
      DecodeDate(ODSMEDSENDDATE.AsDateTime, year, month, day);
      SetBookmark('enddate', IntToStr(day)+'    '+months[month]+'    '+IntToStr(year), False, False, False,
                 False, 10, 'Arial AzLat', False);
      SetBookmark('itspec', str, False, False, False, False, 10, 'Arial AzLat', False);
      SetBookmark('inssum', CurrToStr(ODSMEDSINSSUM.value), False, False, False, False, 10, 'Arial AzLat', False);
      SetBookmark('insammounteveryone', CurrToStr(ODSMEDSINSAMMOUNTEVERYONE.Value), False, False, False, False, 10, 'Arial AzLat', False);
      SetBookmark('insammountall', CurrToStr(ODSCONTRACTSAMMOUNT.Value), False, False, False, False, 10, 'Arial AzLat', False);
    end;


  finally
     SuggestionReport.Show;
  end;


end;

