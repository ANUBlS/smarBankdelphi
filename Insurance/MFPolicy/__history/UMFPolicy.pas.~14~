procedure TMFPolicy.SaveData;
begin
     PolicyMS_id.Value:=SuggestionID.Value;
     PolicyPOLICYNUM.Value:=ODSContractsPOLICY_NUM.Value;
     Policy.Post;
     Policy.RefreshRecord();
    { with ODSContracts do
     if State in [dsEdit, dsInsert] then
     begin
        FieldByName('policy_id').asFloat := Policy.FieldByName('id').asFloat;  
        Post;
     end;  }
          with ODSContracts do
     if State in [dsEdit, dsInsert] then
     begin
        FieldByName('policy_id').asFloat := Policy.FieldByName('id').asFloat;
        Post;
     end;
end;

procedure TMFPolicy.ENumKeyPress(Sender: TObject; var Key: Char);
begin
     if Key = #13 then
     begin
        if HiWord(GetKeyState(VK_Shift))<>0 then
           with Sender as TControl do
           SelectNext(ActiveControl,False, True)
        else
           with Sender as TControl do
           SelectNext(ActiveControl,True, True);
        key:=#0;
     end;
end;

procedure TMFPolicy.BitBtn2Click(Sender: TObject);
begin
         SaveData;
         with Policy do
         begin
              if State in [dsInsert, dsEdit] then  Post;
              RefreshRecord;
         end;
         PostMessage(FOwnerHandle, WM_ModalResult, mrOk, 0);
end;

procedure TMFPolicy.btPrintClick(Sender: TObject);
var
   i:integer;
begin
      if  MessageDlg('Əməliyyat aparılsın?', mtConfirmation,[mbYes, mbNo], 0) = mrYes then
      AddTransh();
      AValute.Locate('valute',ODSCOntractsValute_ID.Value,[]);
      Customers.Locate('id',Ins_MotorFullKli_ID.value,[]);
      with INSWordExporter1 do
      begin
          ODSBeneficiary.Locate('id',Ins_MotorFullProfitID.Value,[]);
          ODSAgents.Locate('id',Ins_MotorFullBroker.Value,[]);
          if not ODSAutoTypes.Active then ODSAutoTypes.Open;
          ODSAutoTypes.Locate('ID',Ins_MotorFullInsuredType.Value,[]);
          FileName:=ExtractFilePath(Application.ExeName)+ '\MotorFullPolicys.doc';   
          Open(False);
          if not CustomersName.IsNull then
          SetBookmark('Insured1',CustomersName.value, false, false, False, false, 8, 'Arial AzLat', False);
          if not SuggestionEndDate.IsNull then
          begin
               SetBookmark('Date1',DateToStr(SuggestionEndDate.value), False, False, False, False, 8, 'Arial AzLat', False);
               SetBookmark('Date2',DateToStr(SuggestionEndDate.value), False, False, False, False, 8, 'Arial AzLat', False);
          end;

          SetBookmark('Agent',ODSAgentsName.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('PolicyN',ODSContractsPolicy_Num.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Beneficiary',ODSBeneficiaryName.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Insured',CustomersName.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('AInsured',CustomersAddress.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('TInsured',CustomersMobilePhone.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Geo',Ins_MotorFullInsuranceGeographicalLimit.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Model',Ins_MotorFullInsuredMark.value+' '+Ins_MotorFullInsuredModel.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Year',InTToStr(Ins_MotorFullInsuredoutputYear.value), false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Color',Ins_MotorFullInsuredColor.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Type',ODSAutoTypesName.Value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Capacity',IntToStr(Ins_MotorFullInsuredNumSeats.value), false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Engine',Ins_MotorFullInsuredEngineNum.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Body',Ins_MotorFullInsuredBody.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Chassis',Ins_MotorFullInsuredChassisNum.value, false, false, False, false, 8, 'Arial AzLat', False);
          SetBookmark('Plate',Ins_MotorFullInsuredStateNum.value, false, false, False, false, 8, 'Arial AzLat', False);

          if not Franshiz.Fields[1].IsNull then
          SetBookmark('Deductible',Franshiz.Fields[1].value, false, false, False, false, 8, 'Arial AzLat', False);
          if not SuggestionInsuranceSum.IsNull then
          SetBookmark('SumInsured',CurrToStr(SuggestionInsuranceSum.value), false, false, False, false, 8, 'Arial AzLat', False);
          if not ODSContractsAmmount.IsNull then
          SetBookmark('InsPrem',CurrToStr(ODSContractsAmmount.value), false, false, False, false, 8, 'Arial AzLat', False);
          { if not ODSContractsPolicy_num.IsNull then
          SetBookmark('SValue',ODSContractsPolicy_num.value, false, false, False, false, 8, 'Arial AzLat', False);  }
          if not AValute.Fields[0].IsNull then
          SetBookmark('Currency',AValute.Fields[0].value, false, false, False, false, 8, 'Arial AzLat', False);
          MoreThan.First;
          for i:=0 to MoreThan.RecordCount-1 do
          begin
              if MoreThan.Fields[0].IsNull then Continue;
              SetBookmark('Drivers',MoreThan.Fields[0].value+#13#10, false, false, false, false, 8, 'Arial AzLat', False);
              MoreThan.Next;
          end;
          Show;
     end;
end;

procedure TMFPolicy.btApplyClick(Sender: TObject);
begin
      SaveData;
      with Policy do
      begin
           if State in [dsInsert, dsEdit] then  Post;
           RefreshRecord;
           Edit;
      end;
      btPrint.Enabled:=true;
      btApply.Enabled:=false;
end;

procedure TMFPolicy.DBEdit8Change(Sender: TObject);
begin
     btApply.Enabled:=true;
end;

procedure TMFPolicy.AddTransh;
begin
     with OPCOMMON do begin
      ODSContracts.Close;
      ODSContracts.SetVariable('blankid',Ins_MotorFullID.Value);
      ODSContracts.Open;
      if CallIntegerFunction('addtransaction', [
                      ODSContracts.FieldByName('LOANACC_ID').asFloat,
                      ODSContracts.FieldByName('CURRACC_ID').asFloat,
                      ODSContracts.FieldByName('AMMOUNT').asFloat]) > 0 then
      MessageDlg('Emeliyyat kecirildi.', mtInformation, [mbOK], 0);
      Close;
    end;
end;

