function TMFPolicy.UIObjectActivate: HResult;
begin
        id := StrToInt(Get_Params('id'));
        //showmessage(floattostr(id));
        Ins_motorFull.Locate('ID',id,[]);
        Franshiz.Locate('ID',Ins_motorFullBroker.Value,[]);
        Suggestion.Locate('MK_ID', Ins_MotorFullID.Value,[]);
        //showmessage(floattostr(Ins_MotorFullID.Value));
        ODSContracts.Close;
        ODSContracts.SetVariable('blankid',Ins_MotorFullID.value);
        ODSContracts.Open;
        ODSContracts.Edit;
        Policy.SetVariable('MS_ID', SuggestionId.value);
         Policy.Open;
         //showmessage(floattostr(SuggestionId.value));
         //showmessage(Get_Params('Mod'));
        tid:=Ins_MotorFullTypeId.Value;
        if Get_Params('Mod') = 'Insert' then
        begin
          Caption := format(fmCaption, ['Elave']);
          Policy.Insert;
          Policy.SetVariable('MS_ID', FloatToStr(SuggestionId.value));
          Policy.Open;
       end ;
       //else
       if Get_Params('Mod') = 'Edit' then
          begin
              Caption := format(fmCaption, ['Redakte']);
              Policy.Edit;
              Policy.SetVariable('MS_ID', SuggestionId.value);
              Policy.Open;
              btPrint.Enabled := True;
              btApply.Enabled:=true;
          end;
       Result := S_OK;
end;

