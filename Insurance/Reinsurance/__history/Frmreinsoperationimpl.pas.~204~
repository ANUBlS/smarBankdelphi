procedure TFrmreinsoperation.ActionFilterExecute(Sender: TObject);

   function  CheckFiltered(IsChecked: Boolean; const FilterStr: String; Args: array of const): String;
   begin
    Result :='';
    if  IsChecked  then
     Result :=Format(FilterStr, Args);

   end;
      const
   BooleanPrefix = ' AND ';
   p_instypeFilter= '(ii.id=%d)';


var
   p_instype: String;


   FilterStr: String;
begin
 FilterStr :='';

 p_instype:=CheckFiltered(
              XFCheckBox8.Checked
             ,p_instypeFilter
             ,[DBLookupComboBox1.ListSource.DataSet.FieldByName('id').asinteger]
              );


                if  XFCheckBox8.Checked
  then
  if  FilterStr=''  then
    FilterStr :=p_instype
  else
    FilterStr :=FilterStr + BooleanPrefix + p_instype;


    FilterStr:=' and '+ FilterStr;

        FilterStr:=FilterStr1+FilterStr;
        //showmessage(FilterStr);


  DMreinsurance.ds_reins_info.sql.Clear;
 DMreinsurance.ds_reins_info.sql.Text:=FilterStr;
  memo1.Text:=DMreinsurance.ds_reins_info.sql.Text;
  DMreinsurance.ds_reins_info.close;
   DMreinsurance.ds_reins_info.Open;

   end;


end.
