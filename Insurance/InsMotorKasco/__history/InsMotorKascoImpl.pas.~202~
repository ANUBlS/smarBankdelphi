procedure TfmInsMotorKasco.XDBGrid1DrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TXColumn; State: TGridDrawState);
var
  ImageIndex: Integer;
begin
 with Sender as TXDBGrid do
  begin
    if DataSource.DataSet.RecordCount <> 0 then
    begin
      ImageIndex := DataSource.DataSet.FieldByName('state').AsInteger;
      if (DataCol = 1) and (ImageIndex <> -1) then begin
        Canvas.brush.Style := bsSolid;
        Canvas.FillRect(Rect);
        ImageList2.Draw(Canvas, Rect.Left, Rect.Top, ImageIndex, True); end
      else
        DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;
  end;

end;

procedure TfmInsMotorKasco.XDBGrid1TitleClick(Column: TXColumn);
var
   TitleName :string;
   SortPosition: word;
begin
 SortPosition :=100;
 if (DMMotorkasko.DSContract.IsEmpty) or (Column.FieldName = EmptyStr) then Exit;
 Screen.Cursor :=crHourGlass;
 TitleName :=Column.FieldName;
 with DMMotorkasko, DSContract do
  try
   SortPosition :=SQL.Add('ORDER BY '+ TitleName);
   Refresh;
  finally
   SQL[SortPosition] :=EmptyStr;
   Screen.Cursor :=crDefault;
  end;

end;

