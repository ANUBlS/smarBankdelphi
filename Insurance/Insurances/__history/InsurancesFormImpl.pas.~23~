procedure TFIFOArr.SetArrLength(len : Integer);
begin
 SetLength(arr, len);

end;

function TFIFOArr.isExist(val : integer):Integer;
var i : Integer;
begin
 Result := -1;
  if arr <> nil then
  for i := 0 to GetArrLength-1 do
     if arr[i] = val then begin
        Result := 1;
        break;
      end;
end;

function TFIFOArr.Add(Val : Integer):Integer;
var
  len : Integer;
begin
  if isExist(val) = -1 then begin
    len := GetArrLength()+1;
    SetArrLength(Len);
    arr[Len-1] := Val;
  end;

  Result := getCurrVal();

end;

function  TFIFOArr.GetArrLength():Integer;
begin
 Result := 0;
 if arr <> nil then
  Result := Length(arr);
end;

function  TFIFOArr.getCurrVal:Integer;
begin
 Result := 0;
  if arr <> nil then
    Result := arr[GetArrLength()-1];
end;

function TFIFOArr.Delete:Integer;
begin
 Result := 0;
  if arr <> nil then begin
     SetArrLength(GetArrLength-1);
    Result := getCurrVal;
  end;
end;

