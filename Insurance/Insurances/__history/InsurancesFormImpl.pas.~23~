procedure StringToRaw(S: String; var Raw: TMemoryStream);
  var
    P: Integer;
    Ch: Char;
  begin
    while S <> '' do
    begin
      P := Pos(' ', S);
      if P = 0 then
        P := Length(S)+1;
      Ch := Chr(StrToInt(Copy(S, 1, P-1)));
      System.Delete(S, 1, P);
      Raw.Write(Ch, 1);
    end;
  end;

function TInsurancesForm.ReadIniFile( FileName : TFileName ):Boolean;
var
   InsIni : TIniFile;
   ModlCount : Integer;
   pCaption : String;
   pCLASSID : TGUID;
   sCLASSID : String;
   pImage : TBitmap;
   sImage : String;
   rImage : TMemoryStream;
   tImage : TMemoryStream;
   i : Integer;
begin
  result := false;
  InsIni := TIniFile.Create(FileName);
  rImage := TMemoryStream.Create;
  tImage := TMemoryStream.Create;
  pImage := TBitmap.Create;
  with InsIni do
  try
    ModlCount := ReadInteger('MODULES', 'ModulesCount', -1);
    i := 0;
    while ModlCount >= i  do
    begin
      pCaption := ReadString('MODULE'+IntToStr(i), 'Caption', '');
      if pCaption = '' then pCaption := '<No Caption>';
      sCLASSID := ReadString('MODULE'+IntToStr(i), 'CLASSID', '');
      if sCLASSID = '' then pCLASSID := IUnknown
         else pCLASSID := StringToGUID(sCLASSID);
      sImage := ReadString('MODULE'+IntToStr(i), 'Image', '');
     { if sImage = '' then  }ImageList1.GetBitmap(0, pImage);{
         else begin
          StringToRaw(sImage, rImage);
          rImage.SaveToStream(timage);
        //  rImage.Seek(0, soFromBeginning);
          pImage.LoadFromStream(tImage);
         end;}
      with InsPluginMgr do
        AddButton(pCaption, pImage, pCLASSID);
      inc(i);
    end;
    //plgURL := ReadString('PARAMS', 'URL', 'about:blank');
    {with InsPluginMgr do
    begin
        AddButton(pCaption, pImage, pCLASSID);
      inc(i);
    end;}


    Result := true;
  finally
    timage.free;
   pImage.Free;
   rImage.Free;
   InsIni.Free;
  end;
end;

