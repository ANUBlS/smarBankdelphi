function TInsurancesForm.ChangeMDIState(MDITag : Integer; State:Integer):Integer;
var
  i : Integer;
begin
   Result := 0;
   for i:=0 to length(mdiforms)-1 do
   if Assigned(MDIForms[i]) then
     case State of
      0 : if MDIForms[i].tag = MDITag then MDIForms[i].Visible := False;
      1 : if MDIForms[i].tag = MDITag then MDIForms[i].Visible := True;
      3 : if MDIForms[i].tag = MDITag then begin
               MDIForms[i].visible := true;
               result := 1 ;
          end else MDIForms[i].visible := false;
      9 : MDIForms[i].Free;
     end;
end;


