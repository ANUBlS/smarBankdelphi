procedure TInsCustomersForm.ActionFilterExecute1(Sender: TObject);

   function  CheckFiltered(IsChecked: Boolean; const FilterStr: String; Args: array of const): String;
   begin
    Result :='';
    if  IsChecked  then
     Result :=Format(FilterStr, Args);
   end;

const
   BooleanPrefix = ' AND ';

   StatusFilter = '(ic.close_prefix=%d)';
   type_idFilter = '(type_id=%d)';
   TARIFFFilter = '(ic.TARIFF=%d)';
   franshizFilter = '(ic.franshiz=%d)';
   TipaccFilter = '(Tipacc like  %s)';
   BalanceFilter = '(Bal_cn1=%s)';
   RepSymbFilter = '(Sim_Otcet=%d)';
var
   Status:    String;
   p_type_id:    String;
   p_TARIFF:  String;
   p_franshiz:  String;
   Tipacc:    String;
   Balance:   String;
   RepSymb:   String;
   FilterStr: String;
begin
 FilterStr :='';

 Status :=CheckFiltered(
              RGContract.ItemIndex <> -1
             ,StatusFilter
             ,[RGContract.ItemIndex]
              );

 p_type_id :=CheckFiltered(
              XFCheckBox8.Checked//DBLookupBranch.KeyValue <> -1
             ,type_idFilter
             ,[DBLookupComboBox5.ListSource.DataSet.FieldByName('ID').AsInteger]
              );

  //showmessage(CurrencyEdit1.Text);

