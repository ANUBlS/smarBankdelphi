    FilterStr :=p_TARIFF
  else
    FilterStr :=FilterStr + BooleanPrefix + p_TARIFF;
    //showmessage('FilterStr= '+FilterStr) ;
  if  XFCheckBox10.Checked //Operator <> ''
  then
  if  FilterStr=''  then
    FilterStr :=p_franshiz
  else
    FilterStr :=FilterStr + BooleanPrefix + p_franshiz;

 {if  CbAccType.Checked //Tipacc <> ''
  then
  if  FilterStr=''  then
    FilterStr :=Tipacc
  else
    FilterStr :=FilterStr + BooleanPrefix + Tipacc;

  if   CBBal_Cn.Checked //Balance <> ''
  then
