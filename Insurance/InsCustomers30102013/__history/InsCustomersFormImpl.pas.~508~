procedure TInsCustomersForm.MouseWheelHandler(var Message: TMessage);
type
    TMWDataSet = ^TOracleDataSet;
    TWMDBGriid = ^TDBGrid;
var
    MWDataSet : TMWDataSet;
    MWDBGrid : TWMDBGriid;

begin
//  inherited;

 if not (InsCustomersForm.ActiveControl is TDBGrid) then exit;
  with InsCustomersForm, InsDataMod do
    case (ActiveControl as TDBGrid).tag  of
     0 : begin MWDataSet := @ODSInsCustomers; MWDBGrid := @DBGridCust end;
     1 : begin MWDataSet := @ODSContracts; MWDBGrid := @DBGridContracts end;
     2 : begin MWDataSet := @ODSAccount;  MWDBGrid := @DBGridAcc end;
    end;
  MWDBGrid.SelectedRows.Clear;
  with TCMMouseWheel(Message), MWDataSet^ do
    if WheelDelta < 0 then
      Next
    else
      Prior;
  MWDBGrid.Repaint;
end;

