procedure TMainReInsReceive.ActionFilterExecute(Sender: TObject);

   function  CheckFiltered(IsChecked: Boolean; const FilterStr: String; Args: array of const): String;
   begin
    Result :='';
    if  IsChecked  then
     Result :=Format(FilterStr, Args);
     //showmessage('Result= '+Result)  ;
   end;
      // a.type_id=1
const
   BooleanPrefix = ' AND ';
   StatusFilter = '(a.close_prefix=%d)';
   nametype= '(a.type_id=%d)';
   nameFilter = '(a.KLI_ID=%d)';
   //custFilter = '(custgroup_id=%d)';
   custFilter = '(cust.id=%d)';
   AGENT_IDFilter = '(a.AGENT_ID=%d)';
   FransizaFilter = '(a.franshiz=%d)';
   begindateFilter = ' a.begin_date ';
   enddateFilter = ' a.end_date ';
   sigortanovuFilter = '(a.type_id=%d)';
var
   Status:    String;
   p_name:    String;
   p_CUST_ID:  String;
   p_AGENT_ID:  String;
   p_marka:    String;
   p_Avtotype:   String;
   p_fransiza:   String;
   p_type:     String;
   p_begin_date:   String;
   p_end_date:   String;
   p_ins_type:string;
     pstate :integer;
   FilterStr: String;
    p_Reins:string;
begin
 FilterStr :='';
  // showmessage(StatusFilter);
 Status :=CheckFiltered(
               RGContract.ItemIndex <> -1
             ,StatusFilter
             ,[RGContract.ItemIndex]
              );
  // showmessage(Status);
    //showmessage(nameFilter);
    //showmessage(DBLookupComboBox1.ListSource.DataSet.FieldByName('name1').asstring);


 p_name :=CheckFiltered(
              XFCheckBox1.Checked//DBLookupBranch.KeyValue <> -1
             ,nameFilter
             ,[DBLookupComboBox1.ListSource.DataSet.FieldByName('id').asinteger]
              );
 p_cust_id :=CheckFiltered(
              XFCheckBox9.Checked  //DBLookupOperator.KeyValue <> -1
             ,custFilter
             ,[DBLookupComboBox6.ListSource.DataSet.FieldByName('ID').AsInteger]
              );

 p_AGENT_ID:=CheckFiltered(
              XFCheckBox2.Checked//DBLookupCurrency.KeyValue <> -1
             ,AGENT_IDFilter
             ,[DBLookupComboBox2.ListSource.DataSet.FieldByName('id').AsInteger]
              );

  p_ins_type :=CheckFiltered(
              XFCheckBox5.Checked  //DBLookupOperator.KeyValue <> -1
             ,sigortanovuFilter
             ,[DBLookupComboBox3.ListSource.DataSet.FieldByName('ID').AsInteger]
              );

                        if XFCheckBox7.Checked=true then
    begin

              if ComboBox2.ItemIndex=0 then

      p_Reins:=' a.id in  (select cid from ins_reinsurance)'
      else
      p_Reins:=' a.id in  ((select id from ins_contracts minus select id from ins_contracts where id in  (select cid from ins_reinsurance)))';
      end
      else
      begin

      p_Reins:='';
      end;

  if Status='' then
   FilterStr:='status is not null'
 else
    FilterStr :=Status;

  if  XFCheckBox1.Checked //Branch <> ''
  then
  if  FilterStr=''  then
    FilterStr :=p_name
  else
    FilterStr :=FilterStr + BooleanPrefix + p_name;

     if  XFCheckBox5.Checked //Branch <> ''
  then
     if  FilterStr=''  then
    FilterStr := p_ins_type
  else
    FilterStr :=FilterStr + BooleanPrefix + p_ins_type;

    if  XFCheckBox9.Checked //Operator <> ''
  then
  if  FilterStr=''  then
    FilterStr :=p_cust_id
  else
    FilterStr :=FilterStr + BooleanPrefix + p_cust_id;

 if  XFCheckBox2.Checked //Currency <> ''
  then
  if  FilterStr=''  then
    FilterStr :=p_AGENT_ID
  else
    FilterStr :=FilterStr + BooleanPrefix + p_AGENT_ID;

     if  XFCheckBox7.Checked
  then
  if  FilterStr=''  then
    FilterStr :=p_Reins
  else
    FilterStr :=FilterStr + BooleanPrefix + p_Reins;


  if XFCheckBox3.Checked then
  begin
      if XFRadioGroup1.ItemIndex=0 then
      begin
        p_begin_date:=begindateFilter+ ' between  '+''''+datetostr(DateTimePicker1.DateTime)+''''+' and '+''''+datetostr(DateTimePicker2.DateTime)+'''';

  if  FilterStr=''  then
    FilterStr :=BooleanPrefix+p_begin_date
  else
    FilterStr :=FilterStr + BooleanPrefix + p_begin_date;
    //showmessage(FilterStr);
      end;

      if XFRadioGroup1.ItemIndex=1 then
      begin
       p_end_date:=enddateFilter+ ' between  '+''''+datetostr(DateTimePicker1.DateTime)+''''+' and '+''''+datetostr(DateTimePicker2.DateTime)+'''';
       //showmessage(p_end_date);
  if  FilterStr=''  then
    FilterStr :=p_end_date
  else
    FilterStr :=FilterStr + BooleanPrefix + p_end_date;
      end;
        //else


  end;
    if XFCheckBox4.Checked=true then
    begin

    case ComboBox1.ItemIndex of
   0:pstate:=6;
   1:pstate:=0;
   2:pstate:=7;
   3:pstate:=8;
     end;

       if  FilterStr=''  then
       begin

    FilterStr :=' and ic.state='+inttostr(pstate);
    end
  else
    FilterStr :=FilterStr + ' and a.state='+inttostr(pstate);
      end;

    //showmessage(' and '+ FilterStr);
    //showmessage(DMMainTravel.DSContract.sql.Text);
    DMIns_ReinsReceive.DSMain.sql.Text:='';
              sql:=sql1+' and '+ FilterStr;
  //DMMainTravel.DSContract.sql:=' and '+ FilterStr;
  DMIns_ReinsReceive.DSMain.sql.Text:=sql;

  memo1.Text:= DMIns_ReinsReceive.DSMain.sql.Text;
  DMIns_ReinsReceive.DSMain.sql.text:=Stringreplace(DMIns_ReinsReceive.DSMain.sql.text,'status','DECODE (a.close_prefix, 0, 1, 2)', [rfReplaceAll, rfIgnoreCase]);

  DMIns_ReinsReceive.DSMain.close;
  DMIns_ReinsReceive.DSMain.Open;

end;

