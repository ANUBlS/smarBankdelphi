  object ODSMotorKasco: TOracleDataSet
    SQL.Strings = (
      'SELECT  im.rowid, im.id, im.insuredtype, im.insuredcolor,'
      
        '       im.insuredoutputyear, im.insuredstatenum, im.underframenu' +
        'm,'
      
        '       im.insuredbannum, im.insuredenginenum, im.driveintended,i' +
        'm.franshiz,'
      
        '       im.drivecost, ic.beneficiary,ic.inssumm, im.typeid, ic.be' +
        'n_id, im.insuredmark||'#39' '#39'|| im.insuredmodel as mark,'
      
        ' im.bank_id, im.month_id,im.cid,ic.begin_date, ic.end_date, ic.k' +
        'li_id,icu.name||'#39' '#39'||icu.surname||'#39' '#39'||icu.fathername as name '
      '  FROM ins_motorkasco im,  ins_contracts ic,ins_customers icu'
      ' WHERE  '
      '       ic.id = im.CID'
      '  and  ic.type_id = 1'
      '  and  ic.CLOSE_PREFIX=0'
      '  and icu.id=ic.kli_id'
      '')
    QBEDefinition.QBEFieldDefs = {
