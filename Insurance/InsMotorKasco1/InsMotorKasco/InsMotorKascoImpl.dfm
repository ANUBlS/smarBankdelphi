  object ODSMotorKasco: TOracleDataSet
    SQL.Strings = (
      'SELECT  im.rowid, im.id, im.insuredtype, im.insuredcolor,'
      
        '       im.insuredoutputyear, im.insuredstatenum, im.underframenu' +
        'm,im.insuredmark||'#39' '#39'||im.insuredmodel as mark,'
      
        '       im.insuredbannum, im.insuredenginenum, im.driveintended,i' +
        'm.franshiz,val.valute,VAL.VAL_NAME as valyuta,im.close_prefix,'
      
        '       im.drivecost||'#39' '#39'||val.val_name drivecost, im.inssumm,im.' +
        'ammount, im.typeid, ic.ben_id, im.insuredmark,'
      
        '       im.insuredmodel, im.bank_id, im.month_id,im.cid,ic.policy' +
        '_num,ic.beneficiary,ic.begin_date, ic.end_date,ic.kli_id,icu.sur' +
        'name||'#39' '#39'||icu.name||'#39' '#39'||icu.fathername as name,iag.name||'#39' '#39'||' +
        'iag.surname||'#39' '#39'||iag.fathername as agent '
      
        '  FROM ins_motorkasco im,  ins_contracts ic,ins_customers icu,in' +
        's_agents iag,avalute val'
      ' WHERE  '
      '       ic.id = im.CID'
      '  and  ic.type_id = 1  '
      '  and  ic.close_prefix=0'
      '  and  icu.id=ic.kli_id'
      '  and  iag.id=ic.agent_id'
      '  and val.valute=ic.valute_id order by ic.policy_num desc '
      '')
    Variables.Data = {0300000001000000060000003A5449544C45010000000000000000000000}
