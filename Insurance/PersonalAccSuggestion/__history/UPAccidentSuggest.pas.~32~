function TPAccidentSuggest.UIObjectActivate: HResult;
begin
     id := StrToInt(Get_Params('MK_ID'));
    //showmessage(Get_Params('Mod'));
   // exit;
     DBLookupComboBox3.KeyValue:=0;
       f:=true;
       ODSPAccident.Close;
       ODSPAccident.SetVariable('ID',id);
       ODSPaccident.Open;

       ODSContracts.Close;
       ODSContracts.SetVariable('cid', ODSPAccident.FieldByName('cid').AsInteger);
       ODSContracts.Open;

       if Get_Params('Mod') = 'Insert' then
       begin
          ODSPAccSuggest.Insert;
          Caption := format(fmCaption, ['Elave']);
          ODSPAccSuggest.SetVariable('paid',id);
          ODSPAccSuggest.Open;
          DTPContractDate.DateTime:=PAccidentSuggest.DsSysdat.FieldByName('tek_dat').AsDateTime;
       end
       else
          begin  //-----Edit mode
              ODSPAccSuggest.Close;
              ODSPAccSuggest.SetVariable('paid',id);
              ODSPAccSuggest.Open;
              ODSPAccSuggest.Edit;     
              DTPContractDate.DateTime := ODSPAccSuggestInsurancetime.value;
              memConditions.Text:='';
              Caption := format(fmCaption, ['Redakte']);
              btPrint.Enabled := True;
              btPolicy.Enabled := True;
           end;
         //    end;
  Result := S_OK;
end;

