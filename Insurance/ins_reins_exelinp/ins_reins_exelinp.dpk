package ins_reins_exelinp;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  Sbtranslate,
  sboapi50,
  VCLXFiles150,
  InsVCL50;

contains
  dmins_reins_exelinpimpl in 'dmins_reins_exelinpimpl.pas' {dmins_reins_exelinp: TDataModule},
  frmins_reins_exelinpimpl in 'frmins_reins_exelinpimpl.pas' {frmins_reins_exelinp};

end.
