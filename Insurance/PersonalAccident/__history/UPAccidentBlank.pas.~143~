function TPAccidentBlank.UIObjectActivate: HResult;
var
pro_cid,pro_kli_id,pro_bid :integer;
pro_mod :string;
begin
       if Get_Params('Mod') = 'Insert' then
       begin
           if not ODSPAccident.Active then
           ODSPAccident.Open;
           ODSPAccident.Insert;
           edBeginDate.DateTime := PAccidentBlank.DsSysdat.FieldByName('tek_dat').AsDateTime;
           edEndDate.DateTime :=PAccidentBlank.DsSysdat.FieldByName('tek_dat').AsDateTime;
           DateTP1.DateTime:=PAccidentBlank.DsSysdat.FieldByName('tek_dat').AsDateTime;
           DateTP2.DateTime:=PAccidentBlank.DsSysdat.FieldByName('tek_dat').AsDateTime;
           InsLookupComboBox.KeyValue :=  StrToInt(Get_Params('KLI_ID'));
           MonthPeriod;
       end;
       if Get_Params('Mod')='Edit' then
       begin
       //pmcCallActiveX.p_id
          DSIns_cid.Open;
          pro_cid :=DSIns_cid.FieldByName('CID').AsInteger;
          pro_kli_id :=DSIns_cid.FieldByName('KLI_ID').AsInteger;
          pro_bid :=DSIns_cid.FieldByName('bid').AsInteger;
          pro_mod :=DSIns_cid.FieldByName('mod').AsString;
