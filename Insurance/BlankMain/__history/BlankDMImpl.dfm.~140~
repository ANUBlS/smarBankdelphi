        ' = 4 THEN mk.drivecost WHEN ic.type_id = 41 THEN mk.drivecost WH' +
        'EN ic.type_id = 1 THEN mk.drivecost WHEN ic.type_id = 13 THEN mk' +
        '.drivecost WHEN ic.type_id = 43 THEN mk.drivecost WHEN ic.type_i' +
