procedure TFrmFilterBlankMain.XFBitBtn1Click(Sender: TObject);
    var
  SearchField : string;
  SearchOptions : TSearchRecordOptions;
    begin
    SearchOptions := [srIgnoreCase ,srPartialMatch ];

  with Sender as TEdit  do
  begin
    SearchField := copy(Name,5,length(Name));
    with  TOracleDataSet(BlankDM.DSFullContarct) do
    if  not SearchRecord(
                  SearchField
                 ,CmbBoxFindWhat.Text
                 ,SearchOptions + [srFromCurrent , srForward ]
                 ) then
    if MessageDlg(
              'Axtarış sona çatdı.'+#13+'Əvvəldən başlansın?'
             ,mtInformation
             ,[mbNo , mbYes]
             ,0
             ) = mrYes  then
    if not SearchRecord(
                 SearchField
                ,CmbBoxFindWhat.Text
                ,SearchOptions + [ srFromBeginning ]
                )  then
    MessageDlg('Yazı tapılmayıb!',mtInformation,[mbOK],0);
 end;
// FindRecord;
end;

  function TFrmFilterBlankMain.FindNextRecord(DataSet : TDataSet;FieldName : String;Value : String) : Boolean;

resourcestring
  rsRecordRecachedEOF = 'Axtarış cərgənin sonuna çatıb .';
  rsContinueFromTop   = 'Əvvəldən axtarmaqla davam etmək istəyirsiniz?';
  rsRecordNotFound    = 'Yazı Tapılmadı.';

var
  SearchOptions : TSearchRecordOptions;

begin
  SearchOptions := [srIgnoreCase ,srPartialMatch];
  with  (DataSet as TOracleDataSet) do
  begin

    Result := SearchRecord(
                FieldName,
                Value,
                SearchOptions + [srFromCurrent, srForward]
    );
    if not Result then

    if MessageDlg(
              rsRecordRecachedEOF + #10#13 + rsContinueFromTop
             ,mtInformation
             ,[mbNo , mbYes]
             ,0
             ) = mrYes  then
    begin

      Result := SearchRecord(
                  FieldName,
                  Value,
                  SearchOptions + [srFromBeginning]
      );

      if not Result then
      MessageDlg(rsRecordNotFound,mtInformation,[mbOk],0);

    end;
  end;
end;
procedure TFrmFilterBlankMain.FindRecord;
resourcestring
  rsNothingToSearch = 'Axtarılmalı olanı daxil edin!';

var
  FieldToSearch : String;
  SearchValue : String;
begin
  SearchValue := CmbBoxFindWhat.Text;

  if SearchValue = '' then
  if not Visible then
  begin
    Show;
    CmbBoxFindWhat.SetFocus;
    CmbBoxFindWhat.SelectAll;
    Exit
  end
  else
    //raise ESearchError.Create(rsNothingToSearch);

  //CommonDBGrid.SelectedRows.Clear; //!!!

  FieldToSearch := CBSearchWhere.KeyValue;
  if
  FindNextRecord(
      BlankDM.DSFullContarct,
      FieldToSearch,
      SearchValue
  ) then
  with CmbBoxFindWhat.Items do
  if IndexOf(SearchValue) = -1 then
  Add(SearchValue);

end;

