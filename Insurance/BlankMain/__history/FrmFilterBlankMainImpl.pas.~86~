procedure TFrmFilterBlankMain.FindRecord;
resourcestring
  rsNothingToSearch = 'Axtarılmalı olanı daxil edin!';

var
  FieldToSearch : String;
  SearchValue : String;
begin
  SearchValue := CmbBoxFindWhat.Text;

  if SearchValue = '' then
  if not Visible then
  begin
    Show;
    CmbBoxFindWhat.SetFocus;
    CmbBoxFindWhat.SelectAll;
    Exit
  end
  else
    raise ESearchError.Create(rsNothingToSearch);

  CommonDBGrid.SelectedRows.Clear; //!!!

  FieldToSearch := CBSearchWhere.KeyValue;
  if
  FindNextRecord(
      BlankDM.DSFullContarct,
      FieldToSearch,
      SearchValue
  ) then
  with CmbBoxFindWhat.Items do
  if IndexOf(SearchValue) = -1 then
  Add(SearchValue);

end;

