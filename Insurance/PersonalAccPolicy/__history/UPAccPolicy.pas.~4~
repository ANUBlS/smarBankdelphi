function TPAccPolicy.UIObjectActivate: HResult;
begin
      id := StrToInt(Get_Params('id'));
      with PolicyDModule do
      begin
           ODSPAccident.Close;
           ODSPAccident.SetVariable('id',id);
           ODSPAccident.Open;
           ODSCustomers.Close;
           ODSCustomers.SetVariable('id',ODSPAccidentkli_id.Value);
           ODSCustomers.Open;
           ODSContracts.Close;
           ODSContracts.SetVariable('blankid',ODSPAccidentId.value);
           ODSContracts.Open;
           ODSPAccSuggest.Close;
           ODSPAccSuggest.SetVariable('PAID',StrToInt(Get_Params('id')));
           ODSPAccSuggest.Open;
           tid:=ODSPAccidentTypeID.Value;
           if ODSContractsPolicy_Num.IsNull then
           begin
              ODSContracts.Close;
              ODSContracts.SetVariable('blankid',ODSPAccidentId.value);
              ODSContracts.Open;
              ODSContracts.Edit;
              Caption := format(fmCaption, ['Elave']);
              btPrint.Enabled:=false;
           end
           else
           begin
              ODSContracts.Edit;
              Caption := format(fmCaption, ['Redakte']);
              btPrint.Enabled:=true;
           end;
      end;
      Result := S_OK;
end;

