procedure TPAccPolicy.BitBtn2Click(Sender: TObject);
begin
     PostMessage(FOwnerHandle, WM_ModalResult, mrCancel, 0);
end;

procedure TPAccPolicy.BitBtn1Click(Sender: TObject);
begin
     with PolicyDModule,ODSContracts do
     if State in [dsEdit, dsInsert] then
     begin
        if ODSContractsPolicy_Num.IsNull then
        FieldByName('POLICY_NUM').AsString:=OPCommon.callStringFunction('generatePolicy_Num',[tid]);
        Post;
     end;
     PostMessage(FOwnerHandle, WM_ModalResult, mrOk, 0);
end;

procedure TPAccPolicy.btApplyClick(Sender: TObject);
begin
     with PolicyDModule,ODSContracts do
     if State in [dsEdit, dsInsert] then
     begin
        if ODSContractsPolicy_Num.IsNull then
        FieldByName('POLICY_NUM').AsString:=OPCommon.callStringFunction('generatePolicy_Num',[tid]);
        Post;
        RefreshRecord();
     end;
     btApply.Enabled:=false;
     btPrint.Enabled:=true;
end;

procedure TPAccPolicy.ENumChange(Sender: TObject);
begin
     btApply.Enabled:=true;
end;

procedure TPAccPolicy.ENumKeyPress(Sender: TObject; var Key: Char);
begin
     if Key = #13 then
     begin
        if HiWord(GetKeyState(VK_Shift))<>0 then
           with Sender as TControl do
           SelectNext(ActiveControl,False, True)
        else
           with Sender as TControl do
           SelectNext(ActiveControl,True, True);
        key:=#0;
     end;
end;

procedure TPAccPolicy.btPrintClick(Sender: TObject);
begin
     if  MessageDlg('Əməliyyat aparılsın?', mtConfirmation	, [mbYes, mbNo], 0) = mrYes then
     AddTransh();
     with PolicyDModule do
     begin
       ODSCondition.Close;
       ODSCondition.SetVariable('vid',ODSPAccSuggestCNDT_ID.Value);
       ODSCondition.Open;
       Franshiz.Close;
       Franshiz.SetVariable('fid',ODSPAccSuggestFRZ_ID.Value);
       Franshiz.Open;
       ODSBeneficiary.Locate('id',ODSPAccidentPROFITID.Value,[]);
       ODSAgent.Locate('id',ODSPAccidentAgentid.Value,[]);
       try
          with PolicyExporter do
          begin
               FileName:=ExtractFilePath(Application.ExeName)+ '\ferdi qeza polis.doc';
               Open(False);
               SetBookmark('Policynum',ODSContractsPolicy_num.value, false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('Agent',ODSAgentName.value, false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('Insured',ODSCustomersName.value, false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('AInsured',ODSCustomersAddress.value, false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('Insperiod',DateToStr(ODSContractsBegin_date.value)+' - '+DateToStr(ODSContractsEnd_date.value), false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('Beneficiary',ODSBeneficiaryName.value, false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('Inssum',FloatToStr(ODSPAccSuggestInsurancesum.value), false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('Insammount',CurrToStr(ODSCONtractsAmmount.value), false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('Inst',DateToStr(ODSPAccSuggestInsuranceTime.value), false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('Franshiz',FranshizName.value, false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('Cond',ODSConditionName.value, false, false, False, false, 8, 'Arial AzLat', False);
               SetBookmark('Insured1',ODSCustomersName.value, false, false, False, false, 9, 'Arial AzLat', False);
        end;
    finally
        PolicyExporter.Show;
    end;
    end;
end;

procedure TPAccPolicy.AddTransh;
begin
      with PolicyDModule do begin
      ODSContracts.Close;
      ODSContracts.SetVariable('blankid',ODSPAccidentID.Value);
      ODSContracts.Open;
      if OPCOMMON.CallIntegerFunction('addtransaction', [
                      ODSContracts.FieldByName('LOANACC_ID').asFloat,
                      ODSContracts.FieldByName('CURRACC_ID').asFloat,
                      ODSContracts.FieldByName('AMMOUNT').asFloat]) > 0 then
      MessageDlg('Əməliyyat keçirildi.', mtInformation, [mbOK], 0);
      Close;
    end;
end;

