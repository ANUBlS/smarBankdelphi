procedure TfmMEDPolicy.AddTransh;
var
i:integer;
begin
    with ODSReport, OPCOMMON do begin
      ODSReport.Close;
      ODSReport.SetVariable('mp_id', ODSPolicyID.value);
      ODSReport.Open;

      showmessage(FieldByName('AMMOUNT').AsString);
      //exit;
      i:=CallIntegerFunction('get_acc_id',[ODSReport.FieldByName('id').AsInteger]);
        if i=0 then
        begin
          showmessage('Diqqət! Bu müqavilə üçün uyğun hesablar açılmayıb.');
          exit;
        end;

      if CallIntegerFunction('addtransaction', [
                      FieldByName('LOANACC_ID').asFloat,
                      FieldByName('CURRACC_ID').asFloat,
                      FieldByName('AMMOUNT').asFloat]) > 0 then
      MessageDlg('Əməliyyat keçirildi.', mtInformation, [mbOK], 0);
      Close;
    end;
end;

