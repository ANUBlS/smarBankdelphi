function TfmMEDPolicy.SaveData():Boolean;
begin
  //----------Save new risk----------------
  if  memSpecCond.Text <> ''  then
  with ODSSpecCond do begin
    Insert;
    FieldByName('name').asString := memSpecCond.Text;
    Post;
    RefreshRecord;
    memSpecCond.Text := '';
  end;

  with ODSPolicy do
  if State in [dsEdit, dsInsert] then begin
    FieldByName('MEDS_ID').asFloat := id;
    FieldByName('sc_id').AsFloat := ODSSpecCond.FieldByName('id').asFloat;
    Post;
    RefreshRecord;
  end;

  with ODSContracts do
  if State in [dsEdit, dsInsert] then begin
     FieldByName('franshiz').asFloat:=ODSPolicy.FieldByName('FRANSHIZ').asFloat;
     //FieldByName('policy_id').asFloat := ODSPolicy.FieldByName('id').asFloat;
     if ODSContractsPolicy_Num.IsNull then
        FieldByName('POLICY_NUM').AsString:=OPCommon.callStringFunction('generatePolicy_Num',[tid]);
     Post;
  end;

  Result := True;
end;

procedure TfmMEDPolicy.ExportToWord();
const
    months : array [1..12] of String = ('Yanvar', 'Fevral', 'Mart', 'Aprel', 'May', 'Iyun',
                                         'Iyul', 'Avgust', 'Sentyabr', 'Oktyabr', 'Noyabr', 'Dekabr');
var
  DocFile : TFileName;
  day, month, year : word;
  i : integer;
begin

    DocFile := ExtractFilePath(Application.ExeName)+'\MedicalPolicy.doc';
    with INSWordExporter, ODSReport do begin
      FileName := DocFile;
      INSWordExporter.Open(False);
      SetVariable('mp_id', ODSPolicyID.value);
      ODSReport.Open;

      for i:=0 to FieldCount-5 do
      try
        SetBookmark(lowercase(fields[i].DisplayName), VarToStr( fields[i].AsVariant ),
              False, False, False, False, 10, 'Arial AzLat', False);
      except
        on E:Exception do
          MessageDlg(E.Message, mtConfirmation, [mbYes, mbNo], 0);
      end;

      DecodeDate(ODSReport.FieldByName('CONTRACTDATE').Value, year, month, day);

      SetBookmark('contractdate', IntToStr(day)+'    '+months[month]+'    '+IntToStr(year),
              False, False, False, False, 10, 'Arial AzLat', False);
      Show;
      INSWordExporter.Close;
//      ShowMessage(FieldByName('policy_num').asString);
      Close;
    end;

end;


