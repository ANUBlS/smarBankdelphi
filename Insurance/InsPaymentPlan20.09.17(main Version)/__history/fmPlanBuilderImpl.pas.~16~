unit fmPlanBuilderImpl;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, ExtCtrls, HintBox, StdCtrls, Buttons, XFSCtrls, ComCtrls;

type
  TfmPlanBuilder = class(TForm)
    XFGroupBox1: TXFGroupBox;
    XFLabel1: TXFLabel;
    XFLabel2: TXFLabel;
    XFLabel3: TXFLabel;
    XFLabel4: TXFLabel;
    XFLabel5: TXFLabel;
    edAmmount: TEdit;
    edPeriod: TEdit;
    cbType: TComboBox;
    dtpEnd: TDateTimePicker;
    dtpBegin: TDateTimePicker;
    XFPanel1: TXFPanel;
    BitBtn1: TBitBtn;
    BitBtn2: TBitBtn;
    hbError: THintBox;
    procedure BitBtn2Click(Sender: TObject);
    procedure cbTypeChange(Sender: TObject);
    procedure BitBtn1Click(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  fmPlanBuilder: TfmPlanBuilder;

implementation

uses DMPaymentPlanImpl, InsPaymentPlanImpl;

{$R *.dfm}

procedure TfmPlanBuilder.BitBtn1Click(Sender: TObject);
begin
 if MessageDlg('Plan hazirlansin', mtConfirmation,
                                    mbYesNoCancel, 0 ) = mrYes then
                                    begin

 with DMPaymentPlan, OPCOMMON, ODSContracts do

  CallBooleanFunction('makeplan', [FieldByName('ID').asInteger,
                                   dtpBegin.DateTime,
                                   dtpEnd.DateTime,
                                   cbType.ItemIndex,
                                   StrToFloat(Trim(edAmmount.Text)),
                                   StrToInt(Trim(edPeriod.Text))]);
  DMPaymentPlan.ODSPayPlan.refresh;
  //DMPaymentPlan.DSPaymentsetting.Refresh;
  ModalResult := mrOk;
 // frmPaymentPlan.Enabled:=false;

  end;

end;

procedure TfmPlanBuilder.BitBtn2Click(Sender: TObject);
begin
  ModalResult := mrCancel
end;

procedure TfmPlanBuilder.cbTypeChange(Sender: TObject);

begin
  case cbType.ItemIndex  of
    0 : edPeriod.Text := IntToStr(trunc((dtpEnd.DateTime - dtpBegin.DateTime)/30));
    1 : edPeriod.Text := IntToStr(trunc((dtpEnd.DateTime - dtpBegin.DateTime)/(30*3)));
    2 : edPeriod.Text := IntToStr(trunc((dtpEnd.DateTime - dtpBegin.DateTime)/(30*6)));
    3 : edPeriod.Text := IntToStr(trunc((dtpEnd.DateTime - dtpBegin.DateTime)/(30*12)));
  end;
end;

procedure TfmPlanBuilder.FormCreate(Sender: TObject);
begin
 with DMPaymentPlan, OPCOMMON, ODSContracts do begin
   dtpBegin.DateTime := FieldByName('Begin_date').asDateTime;
   dtpEnd.DateTime := FieldByName('End_date').asDateTime;
   cbType.ItemIndex := 0;
   edPeriod.Text := IntToStr(trunc((dtpEnd.DateTime - dtpBegin.DateTime)/30));
   edAmmount.Text:= CurrToStr(FieldByName('AMMOUNT').asCurrency+(DMPaymentPlan.DSmesuliyyetShaqqi.FieldByName('SIGHAQQIM').AsFloat)+
   DMPaymentPlan.DSFerdiqezaShaqqi.FieldByName('SIGHAQQIF').AsFloat);
   //SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);

end;
end;

procedure TfmPlanBuilder.FormKeyPress(Sender: TObject; var Key: Char);
begin
if ord(key)=vk_escape then close

end;

end.
