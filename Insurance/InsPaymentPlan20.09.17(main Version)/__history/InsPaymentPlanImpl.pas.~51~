procedure TfrmPaymentPlan.CMCurrencyEdit4Change(Sender: TObject);
begin
if CMCurrencyEdit4.Value>DMPaymentPlan.DSplancontract.FieldByName('AMMOUNT').AsFloat then
begin
  Showmessage('Daxil olunan məbləğ sığorta haqqından böyük olmamalıdır!');
  CMCurrencyEdit4.Value:=DMPaymentPlan.DSplancontract.FieldByName('AMMOUNT').AsFloat;
  exit;
end
else
begin
     CMCurrencyEdit1.Value:=((CMCurrencyEdit4.Value)*100)/DMPaymentPlan.DSplancontract.FieldByName('AMMOUNT').AsFloat;
end;

if (CMCurrencyEdit4.Text='') or (CMCurrencyEdit4.Value=0)then
begin
   CMCurrencyEdit4.Value:=0;
   CMCurrencyEdit1.Value:=0;
end;


   CMCurrencyEdit1.Enabled:=false;
end;

