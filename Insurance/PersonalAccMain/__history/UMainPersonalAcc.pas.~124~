procedure TMainPersonalAcc.XDBGrid1DrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TXColumn; State: TGridDrawState);
var
  ImageIndex: Integer;
begin
  with Sender as TXDBGrid do
  begin
    if DataSource.DataSet.RecordCount <> 0 then
    begin
      ImageIndex := XDBGrid1.DataSource.DataSet.FieldByName('STATE').AsInteger;
      if (DataCol = 1) and (ImageIndex <> -1) then begin
        Canvas.brush.Style := bsSolid;
        Canvas.FillRect(Rect);
        ImageList2.Draw(Canvas, Rect.Left, Rect.Top, ImageIndex, True); end
      else
        DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;
  end;

end;

procedure TMainPersonalAcc.XDBGrid1TitleClick(Column: TXColumn);
var
   TitleName :string;
   SortPosition: word;
begin
