  object INS_CONSTRUCTION: TOracleDataSet
    SQL.Strings = (
      
        'SELECT  C.ROWID,C.*,ic.begin_date,ic.end_date,ia.surname||'#39' '#39'||i' +
        'a.name||'#39' '#39'||ia.fathername as agent ,'
      
        'icust.surname||'#39' '#39'||icust.name||'#39' '#39'||icust.fathername as name,ic' +
        '.agent_id,ic.policy_num,ic.franshiz,ic.inssumm,ic.ammount'
      
        'FROM INS_CONSTRUCTION C,ins_contracts ic ,ins_customers icust,in' +
        's_agents ia'
      'WHERE ic.id=c.cid '
      'and   ic.agent_id=ia.id(+)'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      'and   ic.kli_id=icust.id')
