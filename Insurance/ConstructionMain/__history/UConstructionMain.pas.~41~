procedure TConstructionMain.ADeleteExecute(Sender: TObject);
var
    id:longint;
    i: Integer;
    WaitNextConfirm, WillRefresh: Boolean;
begin
    WaitNextConfirm :=True;
    WillRefresh :=False;
    with GridConstruction,SelectedRows,Ins_Construction do
    try
       if Count = 0 then  CurrentRowSelected := True;
         for  I:=0 to  Count - 1 do
    begin
      GotoBookmark(Pointer(Items[I]));
      ID :=FieldbyName('ID').AsInteger;

      if  WaitNextConfirm  then
      case MessageDlg('Məlumatlar silinsin?'
               ,mtConfirmation
       ,[mbYes, mbNo ,mbCancel ,mbYesToAll]
       ,0
       )   of
        mrNo       : Continue;
        mrCancel   : Break;
        mrYesToAll :
          if MessageDlg(Format('%d  sayda məlumat silinsin ?', [Count - I]), mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
             WaitNextConfirm :=False
          else
             Continue;
      end;
      Application.ProcessMessages;
      DeleteConstructionInfo(ID);
      WillRefresh :=True;
    end;
     ARefreshExecute(sender);

   finally
      if WillRefresh then
      ARefreshExecute(Sender);

  end;
end;

