    SQL.Strings = (
      'select '
      '       a.policy_num,'
      '       cus.name as sigortaetdiren, '
      
        '       ins_cus.surname||'#39' '#39'||ins_cus.name||'#39' '#39'||ins_cus.fatherna' +
        'me as sigortali,'
      '       a.ins_date, '
      '       a.begin_date, '
      '       a.end_date,'
      '       v.val_name,'
      '       a.ammount,  a.inssumm, a.franshiz, a.tariff,'
      '       a.agent_id,  a.beneficiary,f.name as filiali,'
      '       ins_c.NAME_CARGO as Yukun_adi,'
      '       ins_c.number_parcels as Baglamalarin_sayi,'
      '       ins_c.loading_station as Yuklenme_menteqesi,'
      '       ins_c.cargo_route as Yukun_marsrutu,'
      '       ins_c.loading_date as Yuklenme_tarixi,'
      '       ins_c.final_destination as Teyinat_menteqesi,'
      '       ins_c.ins_cover as Sigorta_teminati,'
      '       ins_c.special_conditions as Xususi_sertler,'
      '       case ins_c.neq_ship'
      '       when 1 then '#39'Gemi'#39
      '       end||'#39'-'#39'||'
      '       case ins_c.neq_lorry'
      '       when 1 then '#39'Yuk masini'#39
      '       end||'#39'-'#39'||'
      '       case ins_c.neq_train'
      '       when 1 then '#39'Qatar'#39
      '       end as neqliyyat_vasitesi,'
      
        '      (select acc_no from account where id=a.loanacc_id) as hesa' +
        'b1,'
      
        '       (select abs(nvl(pok_ostat,0)) from archost where datdate=' +
        'sbop.get_date and acc_id=a.loanacc_id) as hesab1_qaliq,'
      
        '       (select acc_no from account where id=a.curracc_id) as hes' +
        'ab2,'
      
        '       (select abs(nvl(pok_ostat,0)) from archost where datdate=' +
        'sbop.get_date and acc_id=a.curracc_id) as hesab2_qaliq,'
      
        '       a.state,a.id, a.type_id,a.valute_id, a.ben_id,a.condition' +
        's, a.sugnum, a.blank_id, a.op_id, a.reins, a.chkasko,'
      
        '       a.chm, a.chfq, a.commitop_id, a.commit_date, a.cancelopid' +
        ',a.canceldate,a.close_prefix, a.kli_id, a.loanacc_id,'
      '       a.curracc_id,'
      '       ins_common.get_tekrarsigorta(a.id) as tekrarsigortaci,'
      
        '       (nvl(a.ammount,0) * nvl((select sum(reins_part) from ins_' +
        'reinsurance ir where ir.cid=a.id ),0))/100 as Tekrarsigorta_haqq' +
        'i,'
      
        '       (nvl(a.inssumm,0) * nvl((select sum(reins_part) from ins_' +
        'reinsurance ir where ir.cid=a.id ),0))/100 as Tekrarsigorta_mebl' +
        'eq,'
      
        '       nvl((select sum(ammount) from ins_payments where ins_id=a' +
        '.id),0) as odenilmis_sig_haqq,'
      
        '       (((nvl(a.ammount,0) * nvl((select sum(reins_part) from in' +
        's_reinsurance ir where ir.cid=a.id ),0))/100)* '
      
        '       ( nvl((select sum(reins_part_komisiya) from ins_reinsuran' +
        'ce ir where ir.cid=a.id),0)))/100 as Tekrarsigortacidan_komissiy' +
        'a ,'
      
        '       (select terminted_dat from ins_contract_terminated where ' +
        'cid=a.id) as xitam_tarixi,'
      
        '       nvl((select terminted_amount from ins_contract_terminated' +
        '_detal where ter_id '
      
        '       in(select id from ins_contract_terminated where cid=a.id)' +
        '),0) as qaytarilmis_mebleq,'
      '       '
      '      ( select terminted_dat from ins_contract_terminated'
      
        'where cid in(select cid from ins_reinsurance ir where ir.cid=a.i' +
        'd)) as T_Siq_gond_xit_dat,'
      ''
      
        ' ( (nvl((select terminted_amount from ins_contract_terminated_de' +
        'tal where ter_id '
      
        '       in(select id from ins_contract_terminated where cid=a.id)' +
        '),0)) * (select nvl(sum(reins_part),0) from ins_reinsurance wher' +
        'e cid=a.id))/100 as qayta_meb_tek_siq_pay'
      
        ',case a.bnf_type when 0 then '#39'Bank'#39' when 1 then '#39'Kenar'#39' end as f' +
        'ayda_got_status'
      '       '
      'from   ins_contracts a,'
      '       filial f, '
      '       avalute v, '
      '       ins_customers ins_cus,'
      '       customers cus,'
      '       ins_contract_cargo ins_c'
      
        ' where  f.id=a.filial and v.valute=a.valute_id and cus.id=ins_cu' +
