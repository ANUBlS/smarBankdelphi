  object DSALLImtinaReploss: TOracleDataSet
    SQL.Strings = (
      ''
      ''
      'select ii.name,inscs.stage_muraciet_dat,'
      '       ic.surname||ic.name||ic.fathername as sigortali,'
      '       ids.driver as surucu,'
      '       (select insuredmark from ins_motorkasco'
      '       where cid=icr.id) as marka,'
      '        (select insuredmodel from ins_motorkasco'
      '       where cid=icr.id) as model,'
      '        (select insuredstatenum from ins_motorkasco'
      '       where cid=icr.id) as dovlet_nom,'
      '       MOBILEPHONE||'#39','#39'||HOMEPHONE||'#39','#39'||WORKPHONE as elaqeno,'
      '       ids.region||'#39'  '#39'||ids.street as Hadiseyeri,'
      '       icr.policy_num,'
      '       nvl(icr.INSSUMM,0) as INSSUMM,'
      '       ids.APPROXIMATE_AMMOUNT,'
      
        '       case inscs.stage_tesdiq  when 1 then ids.FINAL_AMOUNT_LOS' +
        'S     else   0  end  as FINAL_AMOUNT_LOSS1,'
      
        '       ((select nvl(sum(reins_part),0) from ins_reinsurance wher' +
        'e cid=ids.cid  and status=3)*(ids.APPROXIMATE_AMMOUNT)) as TQZ_T' +
        'ekrarsigorta_payi ,'
      '       icr.begin_date||'#39'  '#39'||icr.end_date as dat,'
      '       ids.detail,'
      '       (SELECT name  FROM ins_dict_marks where '
      
        '      id =(select nvl(MARKAID,0) from ins_claim_description wher' +
        'e id=ids.id and cid=ids.cid)) as marka,'
      
        '      ((select nvl(sum(ammount),0) from ins_claim_payment  where' +
        ' cid=icr.id and dep_id=ids.id)*((select nvl(sum(reins_part),0) f' +
        'rom ins_reinsurance where cid=ids.cid and status=3)))/100 as OZM' +
        '_TR_Pay,'
      '       ids.claim_date,'
      
        '       case when inscs.status=0 then '#39'Arasdirilir'#39' when inscs.st' +
        'atus=1 then '#39'Imtina'#39
      
        '       when  inscs.dep_id in(select dep_id from ins_claim_paymen' +
        't) then '#39'Odenis'#39' else '#39'Taninma'#39'  end as status,      '
      '       nvl(ids.REFUSAL_AMMOUNT,0) as imtinamebelegi,'
      '       ids.refusal_description as imtinasebebi,'
      
        '     -- (select nvl(sum(ammount),0) from ins_claim_payment  wher' +
        'e cid=icr.id and dep_id=ids.id) as odenmis_zerer_m,'
      
        '       CASE inscs.status when 2 then (select nvl(sum(ammount),0)' +
        ' from ins_claim_payment  where cid=icr.id and dep_id=ids.id) '
      '       when 0 then 0  else 0 end as odenmis_zerer_m,'
      
        '       ((ids.FINAL_AMOUNT_LOSS)*(select nvl(sum(reins_part),0) f' +
        'rom ins_reinsurance where cid=ids.cid  and status=3))/100 as YZM' +
        '_Tekrarsigorta_payi,'
      
        '       ids.EMPL_ACC,--(select max(paydate) from ins_claim_paymen' +
        't  where cid=icr.id and dep_id=ids.id) as odenme_tarixi'
      
        '        CASE inscs.status when 2 then (select max(paydate) from ' +
        'ins_claim_payment  where cid=icr.id and dep_id=ids.id)'
      '         when 0 then null  else null end as odenme_tarixi'
      
        'from ins_claim_description ids, ins_insurances ii,ins_customers ' +
        'ic,ins_contracts icr, ins_claim_status inscs'
      'where ids.cid=icr.id'
      'and icr.type_id=ii.id'
      'and ic.id=icr.kli_id'
      'and ids.id=inscs.dep_id'
      'and inscs.status=1'
      'and ids.id  not in (select dep_id from ins_claim_payment)'
      '')
