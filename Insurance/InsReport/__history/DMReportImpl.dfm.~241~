  object DSDataMesuliyyet: TOracleDataSet
    SQL.Strings = (
      
        'SELECT a.policy_num,cus.name as sigortaetdiren, ins_cus.surname|' +
        '|'#39' '#39'||ins_cus.name||'#39' '#39'||ins_cus.fathername as sigortali,'
      '       a.ins_date, a.begin_date, a.end_date,v.val_name,'
      '       a.ammount,  a.inssumm, a.franshiz, a.tariff,'
      '       a.state, a.agent_id,  a.beneficiary,'
      
        '       nvl(m.resp_ammount,0)as Mesuliyyet_sig_mebleg,nvl(m.resp_' +
        'premium,0)as Mesuliyyet_sig_haqqi,'
      
        '       nvl(fq.personal_count,0) as fq_Sigorta_olunanlarin_sayi, ' +
        'nvl(fq.one_accident_amount,0)as fq_bir_sigolunan_ucun_sig_meb,'
      
        '       nvl(fq.one_accident_event_amount,0)as fqbir_hadise_ucunsi' +
        'g_meblegi,nvl(fq.one_max_med_expenses,0) as fqbir_sig_ucun_max_t' +
        'ibbi_xerc,'
      
        '       nvl(fq.oneinsevent_max_med_expenses,0)as fq_bir_sig_hadi_' +
        'max_tibbixerc,nvl(fq.ins_premium,0)as fqsigorta_haqqi,'
      '       f.name as filiali,'
      '       --color.name rengi,'
      
        '       a.id, a.type_id,a.valute_id, a.ben_id,a.conditions, a.sug' +
        'num, a.blank_id, a.op_id, a.reins, a.chkasko,'
      
        '       a.chm, a.chfq, a.commitop_id, a.commit_date, a.cancelopid' +
        ',a.canceldate,a.close_prefix, a.kli_id, a.loanacc_id,'
      
        '       a.curracc_id,a.filial,m.loanacc_id as loanacc_id_m,m.curr' +
        'acc_id as curracc_id_m ,fq.loanacc_id as loanacc_id_fq, fq.curra' +
        'cc_id as curracc_id_fq ,'
      '       im.*,'
      
        '       (select acc_no from account where id=a.loanacc_id) as hes' +
        'ab1,'
      
        '       (select abs(nvl(pok_ostat,0)) from archost where datdate=' +
        'sbop.get_date and acc_id=a.loanacc_id) as hesab1_qaliq,'
      
        '       (select acc_no from account where id=a.curracc_id) as hes' +
        'ab2,'
      
        '       (select abs(nvl(pok_ostat,0)) from archost where datdate=' +
        'sbop.get_date and acc_id=a.curracc_id) as hesab2_qaliq,'
      '        ins_common.get_tekrarsigorta(a.id) as tekrarsigortaci,'
      
        '       (nvl(a.ammount,0) * nvl((select sum(reins_part) from ins_' +
        'reinsurance ir where ir.cid=a.id ),0))/100 as Tekrarsigorta_haqq' +
        'i,'
      
        '       (nvl(a.inssumm,0) * nvl((select sum(reins_part) from ins_' +
        'reinsurance ir where ir.cid=a.id ),0))/100 as Tekrarsigorta_mebl' +
        'eq,'
      
        '       nvl((select sum(ammount) from ins_payments where ins_id=a' +
        '.id),0) as odenilmis_sig_haqq,'
      
