  object DSDataKasko: TOracleDataSet
    SQL.Strings = (
      
        'SELECT a.policy_num,cus.name as sigortaetdiren, ins_cus.surname|' +
        '|'#39' '#39'||ins_cus.name||'#39' '#39'||ins_cus.fathername as sigortali,'
      
        '       a.ins_date, a.begin_date, a.end_date,v.val_name,(select s' +
        'um(nvl(p.ammount,0)) from ins_payments p,sb_business_processes s' +
        'b_p,sb_business_opers sb_o,provarch pr'
      
        'where p.traid=sb_o.parentid and sb_o.busproc=sb_p.id and  p.ins_' +
        'id=a.id and sb_o.busproc in(14,15,16,17,18,19,20) and pr.id=sb_o' +
        '.parentid) as siq_haqqi,a.inssumm, a.franshiz, a.tariff,'
      '       a.state, a.agent_id,  a.beneficiary,'
      '    (select sum(nvl(p.ammount,0))'
      
        'from ins_payments p,sb_business_processes sb_p,sb_business_opers' +
        ' sb_o'
      'where p.traid=sb_o.parentid'
      'and sb_o.busproc=sb_p.id'
      'and  p.ins_id=a.id'
      
        'and sb_o.busproc in(35,36,37,38,39,40,41)) as odenilmis_sig_haqq' +
        ','
      
        ' nvl(m.resp_ammount,0)as Mesuliyyet_sig_mebleg,nvl(m.resp_premiu' +
        'm,0)as Mesuliyyet_sig_haqqi,'
      
        '       nvl(fq.personal_count,0) as fq_Sigorta_olunanlarin_sayi, ' +
        'nvl(fq.one_accident_amount,0)as fq_bir_sigolunan_ucun_sig_meb,'
      
        '       nvl(fq.one_accident_event_amount,0)as fqbir_hadise_ucunsi' +
        'g_meblegi,nvl(fq.one_max_med_expenses,0) as fqbir_sig_ucun_max_t' +
        'ibbi_xerc,'
      
        '       nvl(fq.oneinsevent_max_med_expenses,0)as fq_bir_sig_hadi_' +
        'max_tibbixerc,nvl(fq.ins_premium,0)as fqsigorta_haqqi,'
      '       f.name as filiali,'
      '       --color.name rengi,'
      
        '       a.id, a.type_id,a.valute_id, a.ben_id,a.conditions, a.sug' +
        'num, a.blank_id, a.op_id, a.reins, a.chkasko,'
      
        '       a.chm, a.chfq, a.commitop_id, a.commit_date, a.cancelopid' +
        ',a.canceldate,a.close_prefix, a.kli_id, a.loanacc_id,'
      
        '       a.curracc_id,a.filial,m.loanacc_id as loanacc_id_m,m.curr' +
        'acc_id as curracc_id_m ,fq.loanacc_id as loanacc_id_fq, fq.curra' +
        'cc_id as curracc_id_fq ,'
      '       im.*,'
      
        '       (select acc_no from account where id=a.loanacc_id) as hes' +
        'ab1,'
      
        '       nvl((select abs(nvl(pok_ostat,0)) from archost where datd' +
        'ate=sbop.get_date and acc_id=a.loanacc_id),0) as hesab1_qaliq,'
      
        '       (select acc_no from account where id=m.loanacc_id) as hes' +
        'ab1M,'
      
        '       nvl((select abs(nvl(pok_ostat,0)) from archost where datd' +
        'ate=sbop.get_date and acc_id=m.loanacc_id),0) as hesab1m_qaliq,'
      
        '       (select acc_no from account where id=fq.loanacc_id) as he' +
        'sab1FQ,'
      
        '       nvl((select abs(nvl(pok_ostat,0)) from archost where datd' +
        'ate=sbop.get_date and acc_id=fq.loanacc_id),0) as hesab1FQ_qaliq' +
        ','
      
        '       --(select abs(nvl(pok_ostat,0)) from archost where datdat' +
        'e=sbop.get_date and acc_id in (fq.loanacc_id,m.loanacc_id,a.loan' +
        'acc_id) as tam_qaliq,'
      
        '       (select acc_no from account where id=a.curracc_id) as hes' +
        'ab2,'
      
        '       nvl((select abs(nvl(pok_ostat,0)) from archost where datd' +
        'ate=sbop.get_date and acc_id=a.curracc_id),0) as hesab2_qaliq,'
      
        '       (select acc_no from account where id=m.curracc_id) as hes' +
        'ab2M,'
      
        '       nvl((select abs(nvl(pok_ostat,0)) from archost where datd' +
        'ate=sbop.get_date and acc_id=m.curracc_id),0) as hesab2M_qaliq,'
      
        '       (select acc_no from account where id=fq.curracc_id) as he' +
        'sab2FQ,'
      
        '       nvl((select abs(nvl(pok_ostat,0)) from archost where datd' +
        'ate=sbop.get_date and acc_id=fq.curracc_id),0) as hesab2FQ_qaliq' +
        ','
      '       ins_common.get_tekrarsigorta(a.id) as tekrarsigortaci,'
      
        '       (nvl(a.ammount,0) * nvl((select sum(reins_part) from ins_' +
        'reinsurance ir where ir.cid=a.id ),0))/100 as Tekrarsigorta_haqq' +
        'i,'
      
        '       (nvl(a.inssumm,0) * nvl((select sum(reins_part) from ins_' +
        'reinsurance ir where ir.cid=a.id ),0))/100 as Tekrarsigorta_mebl' +
        'eq,'
      '       '
      
        '       (((nvl(a.ammount,0) * nvl((select sum(reins_part) from in' +
        's_reinsurance ir where ir.cid=a.id ),0))/100)* '
      
        '       ( nvl((select sum(reins_part_komisiya) from ins_reinsuran' +
        'ce ir where ir.cid=a.id),0)))/100 as Tekrarsigortacidan_komissiy' +
        'a ,'
      
        '       (select terminted_dat from ins_contract_terminated where ' +
        'cid=a.id) as xitam_tarixi,'
      
        '       nvl((select terminted_amount from ins_contract_terminated' +
        '_detal where ter_id '
      
        '       in(select id from ins_contract_terminated where cid=a.id)' +
        '),0) as qaytarilmis_mebleq,'
      '       '
      '      ( select terminted_dat from ins_contract_terminated'
      
        'where cid in(select cid from ins_reinsurance ir where ir.cid=a.i' +
        'd)) as T_Siq_gond_xit_dat,'
      ''
      
        ' ( (nvl((select terminted_amount from ins_contract_terminated_de' +
        'tal where ter_id '
      
        '       in(select id from ins_contract_terminated where cid=a.id)' +
        '),0)) * (select nvl(sum(reins_part),0) from ins_reinsurance wher' +
        'e cid=a.id))/100 as qayta_meb_tek_siq_pay'
      ''
      
        '    ,case a.bnf_type when 0 then '#39'Bank'#39' when 1 then '#39'Kenar'#39' end ' +
        'as fayda_got_status    '
      '         FROM ins_contracts a,'
      '       ins_contr_per_acc_motor fq,'
      '       ins_contract_responsibility m,'
      '       filial f, '
      '       avalute v, '
      '       ins_customers ins_cus,'
      '       customers cus,'
      '       ins_motorkasco im'
      '     '
      
        ' where a.id=fq.cid(+) and a.id=m.cid(+) and f.id=a.filial and v.' +
        'valute=a.valute_id and cus.id=ins_cus.cust_id and a.kli_id=ins_c' +
