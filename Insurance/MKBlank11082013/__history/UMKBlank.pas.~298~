procedure TfmMKBlank.MakeTariffList;
begin
  with InsMKDataMod, ODSTariffs do
  begin
    Open;
    edTariff.Items.Clear;
    First;
    while not EOF do
    begin
       edTariff.Items.Add(FloatToStr(FieldByName('Ammount').asFloat));
       Next;
    end;
    First
  end;
end;

