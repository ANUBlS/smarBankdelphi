    //showmessage(enddate);
    //showmessage(ODSMotorKasko.FieldByName('InsuredOutputYear').AsString);


    if (ODSMotorKasko.FieldByName('InsuredOutputYear').AsString<begindate) or
       (ODSMotorKasko.FieldByName('InsuredOutputYear').AsString>enddate)  then
         raise TCalcException.Create('Verilmiş avtomabil markasının buraxılış ilinə uyğun tarif hesablanmır!');

    ODSMonths.Close;
    ODSMonths.SetVariable('release_id',ODSReliaseDatesID.AsInteger);
    ODSMonths.Open;

    ODSFranshiz.Close;
    ODSFranshiz.SetVariable('month_id',ODSMonthsID.AsInteger);
    ODSFranshiz.Open;

    MakeFranshizList;
  except
   on E : Exception do
    MessageDlg(E.Message , mtInformation, [mbOK], 0);
  end;
