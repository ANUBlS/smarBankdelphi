procedure TfmMedBlank.btEmployesClick(Sender: TObject);
begin
  with MedBDataMod, ODSEmployees do
  try
    SetVariable('MED_ID', ODSMedicalID.Value);
    Open;
    ODSOccupation.open;
    fmEmploees := TfmEmploees.Create(Self);
    fmEmploees.ShowModal;
  finally
    Close;
    ODSOccupation.Close;
    fmEmploees.Free
  end;
end;

procedure TfmMedBlank.btApplyClick(Sender: TObject);
begin
  if SaveData() then btApply.Enabled := False;
  btSuggestion.Enabled := True;
  btEmployes.Enabled := True;
end;

procedure TfmMedBlank.DBEdit1KeyPress(Sender: TObject; var Key: Char);
begin
  if Key = #13 then
     begin
       FindNextControl(ActiveControl,true,true,false).SetFocus;
       Key := #0
     end
  else
     btApply.Enabled := True;
end;

procedure TfmMedBlank.setChecks;
var
   i : Integer;
begin
  with MedBDataMod, ODSMedical do
  for i:=0 to FieldCount-1 do
    if Fields[i].Tag = 777 then
      setChecksByName(Fields[i].FieldName, Fields[i].AsInteger);
end;

function TfmMedBlank.getChecksByName(fieldname : String):Integer;
var
   res : Integer;
begin
  res := 0;
  with MedBDataMod, ODSMedical, gbChecks do begin
   if TCheckBox(FindChildControl('chb'+fieldname+'a')).Checked then
      res := res + TCheckBox(FindChildControl('chb'+fieldname+'a')).Tag;
   if TCheckBox(FindChildControl('chb'+fieldname+'b')).Checked then
      res := res + TCheckBox(FindChildControl('chb'+fieldname+'b')).Tag;
   if TCheckBox(FindChildControl('chb'+fieldname+'c')).Checked then
      res := res + TCheckBox(FindChildControl('chb'+fieldname+'c')).Tag;
  end;
  result := res;
end;

procedure TfmMedBlank.getChecks;
var
   i : Integer;
begin
  with MedBDataMod, ODSMedical do
  for i:=0 to FieldCount-1 do
    if Fields[i].Tag = 777 then
      Fields[i].AsInteger := getChecksByName(Fields[i].FieldName);
end;

procedure TfmMedBlank.setChecksByName(chbname : String; value : integer);
begin
   with gbChecks do
   case value of
     7 : begin
           TCheckBox(FindChildControl('chb'+chbname+'a')).Checked := true;
           TCheckBox(FindChildControl('chb'+chbname+'b')).Checked := true;
           TCheckBox(FindChildControl('chb'+chbname+'c')).Checked := true;
         end;
     6 : begin
           TCheckBox(FindChildControl('chb'+chbname+'a')).Checked := true;
           TCheckBox(FindChildControl('chb'+chbname+'b')).Checked := true;
         end;
     5 : begin
           TCheckBox(FindChildControl('chb'+chbname+'a')).Checked := true;
           TCheckBox(FindChildControl('chb'+chbname+'c')).Checked := true;
         end;
     3 : begin
           TCheckBox(FindChildControl('chb'+chbname+'b')).Checked := true;
           TCheckBox(FindChildControl('chb'+chbname+'c')).Checked := true;
         end;
     4 : TCheckBox(FindChildControl('chb'+chbname+'a')).Checked := true;
     2 : TCheckBox(FindChildControl('chb'+chbname+'b')).Checked := true;
     1 : TCheckBox(FindChildControl('chb'+chbname+'c')).Checked := true;
   end;

end;

procedure TfmMedBlank.gbChecksDblClick(Sender: TObject);
