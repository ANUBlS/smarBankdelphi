procedure TfmMedBlank.ActiveFormCreate(Sender: TObject);
begin
  fmMedBlank := Self;
  FParams := TStringList.Create;
  isSaved := False;

  MedBDataMod :=  TMedBDataMod.Create(Self)

end;

function TfmMedBlank.SaveData():Boolean;
begin
  result := True;
  try
  with MedBDataMod, ODSMedical do begin
    Edit;
    FieldByName('begindate').AsDateTime := edBeginDate.DateTime;
    FieldByName('enddate').AsDateTime := edEndDate.DateTime;
    getChecks();
    Post;
    RefreshRecord;
    if Get_Params('Mod') = 'Insert' then
     OPCOMMON.CallIntegerFunction('newinsurance', [9,
                                                  FieldByName('ID').asFloat,
                                                  FieldByName('begindate').AsDateTime,
                                                  FieldByName('enddate').AsDateTime,
                                                  FieldByName('kli_id').AsFloat]);
    if Get_Params('Mod') = 'Edit' then
     OPCOMMON.CallBooleanFunction('setblankdata', [9,
                                                  FieldByName('ID').asFloat,
                                                  FieldByName('begindate').AsDateTime,
                                                  FieldByName('enddate').AsDateTime,
                                                  FieldByName('kli_id').AsFloat]);

  end;
  except
   on E:Exception do begin
    hbErrMsg.ShowMessage(E.Message);
    Result := false;
   end;
  end;
end;

