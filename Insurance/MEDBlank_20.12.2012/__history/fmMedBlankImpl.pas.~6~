function TfmMedBlank.UIObjectActivate: HResult;
begin
    if Get_Params('Mod') = 'Insert' then begin
       id := -1;
       edBeginDate.DateTime := Now;
       edEndDate.DateTime := Now;
       Caption := format(fmCaption, ['Yeni anket']);
       with MedBDataMod, ODSMedical do begin
         SetVariable('ID', id);
         Open;
         Insert;
         FieldByName('KLI_ID').asFloat := StrToInt(Get_Params('KLI_ID'));
       end;
    end;
    if Get_Params('Mod') = 'Edit' then begin
       id := StrToInt(Get_Params('ID'));
       with MedBDataMod, ODSMedical do begin
         SetVariable('ID', id);
         Open;
         edBeginDate.DateTime := FieldByName('begindate').AsDateTime;
         edEndDate.DateTime := FieldByName('enddate').AsDateTime;
         setChecks;
         Edit;
       end;
       Caption := format(fmCaption, ['Redakte']);
       btSuggestion.Enabled := True;
       btEmployes.Enabled := True;

    end;
  Result := S_OK;
end;

