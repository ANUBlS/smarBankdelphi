end;

procedure TfmMedBlank.btSuggestionClick(Sender: TObject);
var
   params : TStringList;
begin
   params := TStringList.Create;
   with MedBDataMod do begin
     params.Values['MED_ID'] := IntToStr(ODSMedicalID.Value);
     params.Values['KLI_ID'] := IntToStr(ODSCustsID.Value);
   end;
   with pmcSuggestion do begin
     ShowModal(StringToGuid('{8488AAD4-B4AC-42D2-B3F4-53A042977147}'),params )
   end;
   params.Free;

end;

