procedure TFrmIns_ammountReport.ActionFilterExecute(Sender: TObject);

   function  CheckFiltered(IsChecked: Boolean; const FilterStr: String; Args: array of const): String;
   begin
    Result :='';
    if  IsChecked  then
     Result :=Format(FilterStr, Args);

   end;

const
   BooleanPrefix = ' AND ';
   p_begindatfilter='(a.begin_date=%d)';
   bankenarfilter = '(a.bnf_type=%d)';
   p_instypeFilter= '(ii.id=%d)';
   nameFilter = '(ins_cus.cust_id=%d)';


var
   p_name:String;
   p_begindat:String;
   p_instype: string;
   bankenar: String;
   FilterStr: String;


begin
 FilterStr :='';

 p_instype:=CheckFiltered(
              XFCheckBox1.Checked
             ,p_instypeFilter
             ,[DBLookupComboBox1.ListSource.DataSet.FieldByName('id').asinteger]
              );

p_name:=CheckFiltered(
              XFCheckBox4.Checked
             ,nameFilter
             ,[DBLookupComboBox3.ListSource.DataSet.FieldByName('id').asinteger]
              );

 if XFCheckBox2.Checked then
 begin
  if XFRadioButton12.Checked=true then
  begin
   bankenar:='a.bnf_type=0';
  end;
  if XFRadioButton13.Checked=true then
  begin
    bankenar:='a.bnf_type=1';
  end;
 end;


    if XFCheckBox7.Checked=true then
    begin
    p_begindat:=' TO_DATE(a.begin_date,''dd.MM.yyyy'')'+ ' between  '+''''+datetostr(DateTimePicker1.DateTime)+''''+' and '+''''+datetostr(DateTimePicker2.DateTime)+'''';
    end
    else
    begin
     p_begindat:='';
    end;

       if  XFCheckBox4.Checked
  then
  if  FilterStr=''  then
    FilterStr :=p_name
  else
    FilterStr :=FilterStr + BooleanPrefix + p_name;



     if  XFCheckBox1.Checked
  then
  if  FilterStr=''  then
    FilterStr :=p_instype
  else
    FilterStr :=FilterStr + BooleanPrefix + p_instype;


     if XFCheckBox2.Checked=true then
     begin
     if XFRadioButton12.Checked=true then
     begin
    if  FilterStr=''  then
    FilterStr :=bankenar
  else
    FilterStr :=FilterStr + BooleanPrefix + bankenar;
    end;

     if XFRadioButton13.Checked=true then
     begin
    if  FilterStr=''  then
    FilterStr :=bankenar
  else
    FilterStr :=FilterStr + BooleanPrefix + bankenar;
    end;
    end;


    if  XFCheckBox7.Checked
  then
  if  FilterStr=''  then
    FilterStr :=p_begindat
  else
    FilterStr :=FilterStr + BooleanPrefix + p_begindat;


    //ShowMessage(FilterStr);

              if FilterStr<>'' then
               begin
         FilterStr:=' and '+ FilterStr;
         end;


        with ExcelExport do
   begin


          DMReport.Dskaskohesabat.close;
        FilterStr:=FilterKasko+FilterStr;
        DMReport.Dskaskohesabat.sql.Clear;
        DMReport.Dskaskohesabat.sql.Text:=FilterStr;
        DMReport.Dskaskohesabat.Open;
        memo1.Text:=DMReport.Dskaskohesabat.sql.Text;


   if DMReport.Dskaskohesabat.RecordCount<>0 then
         begin
      Connect;
      ExportDataset(DMReport.Dskaskohesabat,'Kasko Hesabat.',True,false);
      Disconnect;
      end
      else

      showmessage('Uyğun seçimlərə uyğun məluamt yoxdur!');
   end  ;

end;

