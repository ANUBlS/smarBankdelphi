{$R *.dfm}
   procedure InitPlugin(s:string);export;
begin
FrmReport.c:=s;
      if s='' then
   begin
     FrmReport.ShowModal;
   end;
      if s='Portfel' then
   begin
     FrmPortfel.ShowModal;
   end;
         if s='loss' then
   begin
     FrmLossReport.ShowModal;
   end;

end;
