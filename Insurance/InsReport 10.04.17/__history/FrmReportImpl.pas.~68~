procedure TFrmReport.FormKeyPress(Sender: TObject; var Key: Char);
begin
if ord(key)=vk_escape then close;

end;

procedure TFrmReport.FormShow(Sender: TObject);
begin
DMReport.DScustomers.Close;
DMReport.DScustomers.open;
edit1.Text:='';
ComboBox1.Text:='';
if BarderoReportType='Xitam verilmis.XLS' then
       begin
       ComboBox1.Text:='Xitam verilmis.XLS';

