procedure TfmPaymentsMain.aNewExecute(Sender: TObject);
begin
  fmNewPayments := TfmNewPayments.CreateIt(ctNew);
  try
    if fmNewPayments.ShowModal = mrOk then
      PayDataMod.ODSPayments.Refresh;
  finally
    fmNewPayments.free;
  end;
end;

procedure TfmPaymentsMain.aRefreshExecute(Sender: TObject);
begin
 with PayDataMod, ODSPayments do
   Refresh;
end;

procedure TfmPaymentsMain.aDeleteExecute(Sender: TObject);
var
  traDelAskRes : Boolean;
begin

  with PayDataMod do
   if MessageDlg('Secilmish odeme pozulacaq',
        mtWarning, [mbYes, mbNo], 0) = mrYes then
        begin
          traDelAskRes := MessageDlg('Odemenin emeliyyati pozlsun?', mtWarning, [mbYes, mbNo], 0) = mrYes;
          if ODSPayments.FieldByName('PLANID').asInteger = -1 then
            OPCOMMON.CallBooleanFunction('deletepayment', [ODSPaymentsID.Value, traDelAskRes])
          else
            OPCOMMON.CallBooleanFunction('delpaybyplan', [ODSPayments.FieldByName('PLANID').asInteger, traDelAskRes]);
          ODSPayments.Refresh;
        end;


end;

procedure TfmPaymentsMain.aEditExecute(Sender: TObject);
begin
  fmNewPayments := TfmNewPayments.CreateIt(ctEdit, PayDataMod.ODSPaymentsID.asInteger);
  try
    if fmNewPayments.ShowModal = mrOk then
      PayDataMod.ODSPayments.Refresh;
  finally
    fmNewPayments.free;
  end;
end;

