procedure TFrmResponsibilityBlank.XFButton1Click(Sender: TObject);
var
   a,c_acc:integer;
begin

with DMResponsibilityBlank,sb_aca do
 begin
      CallProcedure('checkadvancedobjectaccess',['SAVECONTRACT_RESPONSIBLE']);
 end;

 if Edit1.Text='' then
 begin
   showmessage('Diqqət! Polis №-i daxil olunmayıb!');
   exit;
 end;

  if InsLookupComboBox.Text='' then
 begin
   showmessage('Diqqət! Sığorta etdirən daxil olunmayıb!');
   exit;
 end;

   if DBLookupComboBox2.Text='' then
 begin
   showmessage('Diqqət! Agent daxil olunmayıb!');
   exit;
 end;

     if dblcValute.Text='' then
 begin
   showmessage('Diqqət! Valyuta daxil olunmayıb!');
   exit;
 end;

     if dbeSum.Text='' then
 begin
   showmessage('Diqqət! Sığorta məbləği daxil olunmayıb!');
   exit;
 end;

        if dbcFranshiz.Text='' then
 begin
   showmessage('Diqqət! Franşiza daxil olunmayıb!');
   exit;
 end;

         if dbeTarif.Text='' then
 begin
   showmessage('Diqqət! Tarif daxil olunmayıb!');
   exit;
 end;

          if dbeAmmount.Text='' then
 begin
   showmessage('Diqqət! Sığorta haqqı daxil olunmayıb!');
   exit;
 end;

 with DMResponsibilityBlank, ins_common do
   begin
     a:=CallIntegerFunction('get_acc_balanc_hesab',[13]);

     if a=0 then
     begin
       showmessage('Diqqət ! Bu müqavilə tipində avtomatik hesabların açılası üçün balans hesabları sazlanmayıb!.');
       exit;
     end;
   end;


with   DMResponsibilityBlank,DSins_contracts do
//
begin
  Edit;
begin
  FieldByName('kli_id').AsInteger:=FrmResponsibilityBlank.InsLookupComboBox.KeyValue;
  //FrmResponsibilityBlank.DBLookupComboBox3.KeyValue:=DMResponsibilityBlank.DSins_contracts.FieldByName('kli_id').AsInteger;
  FieldByName('agent_id').AsInteger:=FrmResponsibilityBlank.DBLookupComboBox2.KeyValue;
  FieldByName('ins_date').AsDateTime:=edIns_Date.DateTime;
  FieldByName('begin_date').AsDateTime:=DateTimePicker1.DateTime;
  FieldByName('end_date').AsDateTime:=DateTimePicker2.DateTime;
  FieldByName('valute_id').AsInteger:=FrmResponsibilityBlank.dblcValute.KeyValue;
  FieldByName('inssumm').AsFloat:=FrmResponsibilityBlank.dbeSum.Value;
  FieldByName('franshiz').AsFloat:=strtofloat(FrmResponsibilityBlank.dbcFranshiz.Text);
  FieldByName('tariff').AsFloat:=FrmResponsibilityBlank.dbeTarif.Value;
  FieldByName('ammount').AsFloat:=FrmResponsibilityBlank.dbeAmmount.Value;
  FieldByName('type_id').AsFloat:=13;
  FieldByName('POLICY_NUM').AsString:=Edit1.Text;

   Post;
      RefreshRecord;
      CID := FieldByName('id').asInteger;
      //showmessage(FieldByName('id').AsString);

end;
end;

with   DMResponsibilityBlank,DSins_contract_responsibility do
//
begin
  Edit;
       begin
  FieldByName('cid').AsFloat:=CID;
  FieldByName('close_prefix').AsFloat:=0;
  FieldByName('TYPEID').AsFloat:=13;
   Post;
       end;
      RefreshRecord;
       end;
      with DMResponsibilityBlank, ins_common do
   begin
     c_acc:=CallIntegerFunction('get_acc_id',[CID]);

     if c_acc=0 then
       begin
    CallProcedure('account_open',[CID]);
       end;
end;
FrmResponsibilityBlank.Close;
end;

