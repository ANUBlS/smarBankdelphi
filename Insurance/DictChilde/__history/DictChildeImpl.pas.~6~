function findreplacechar(source : String; from : String; to_ : Char):String;
var res : String;
begin
  res := source;

  while pos(from, res) > 0 do
    res[pos(from,  res)]:= to_;
  Result := res;  
end;

function TfmDictChilde.UIObjectActivate: HResult;
resourcestring vSQL = 'select c.rowid, c.* from %s c where c.%s=%s ';
var i : Integer;
begin
 TabSheet1.Caption := findreplacechar(Get_Params('Caption'), '_', ' ');
 with ODSMain do begin
   Close;
   SetVariable('maintable', Get_Params('MainTable'));

   Open;
   FieldByName(Get_Params('MainField')).Required := False;
 end;

 with dbgMain do begin
   for i := 1 to Columns.Count
      do Columns[i-1].Destroy;

   Columns.Add;
   Columns[0].FieldName := Get_Params('MasterField');
   Columns[0].Title.Color := clNavy;
   Columns[0].Title.Font.Color := clWhite;
   Columns[0].Title.Caption := 'Груплар';
 end;


 with ODSChilde do begin
   Close;
   DeleteVariables;
   SQL.Text:=Format(vSQL, [Get_Params('ChildeTable'),
                               Get_Params('ChildeField'),
                               ':'+Get_Params('ChildeField')]);
   DeclareVariable(Get_Params('ChildeField'), otFloat);
   MasterFields := Get_Params('MainField');
   DetailFields := Get_Params('ChildeField');
   Open;
   FieldByName(Get_Params('ChildeField')).Required := False;
 end;

 with dbgChilde do begin
   for i := 1 to Columns.Count
      do Columns[i-1].Destroy;

   Columns.Add;
   Columns[0].FieldName := Get_Params('DetailField');
   Columns[0].Title.Color := clNavy;
   Columns[0].Title.Font.Color := clWhite;
   Columns[0].Title.Caption := 'Табе оланлар';
 end;
  Result := S_OK;
end;

