unit URiskTypes;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, Buttons, Grids, DBGrids, ExtCtrls;

type
  TfmRiskTypes = class(TForm)
    DBGrid1: TDBGrid;
    Panel1: TPanel;
    btAdd: TBitBtn;
    btOk: TBitBtn;
    procedure btAddClick(Sender: TObject);
    procedure btOkClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  fmRiskTypes: TfmRiskTypes;

implementation

uses UMFSuggestion, UDModule;

{$R *.DFM}

procedure TfmRiskTypes.btAddClick(Sender: TObject);
begin
     with MFSuggestion, memRisk  do
     begin
          if Text <> '' then Text := Text + ', ';
          Text:= Text+DModule.RisktypesNAME.Value;
     end;
end;

procedure TfmRiskTypes.btOkClick(Sender: TObject);
begin
    ModalResult := mrOk;
end;

procedure TfmRiskTypes.FormCreate(Sender: TObject);
begin
      if DModule.Risktypes.IsEmpty then btAdd.Enabled := False;
      DBGrid1.DataSource := DModule.RisktypesData;
end;

end.
