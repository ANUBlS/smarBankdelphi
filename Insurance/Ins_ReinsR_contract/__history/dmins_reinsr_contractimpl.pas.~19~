implementation

{$R *.dfm}
 uses sboapiDataModuleImpl,CommanParametrs;
procedure Tdmins_reinsr_contract.DataModuleCreate(Sender: TObject);
begin
ds_ins_reinsr_contract.Open;
DSins_dict_companie.Open;
DSsysdat.Open;
dsreins.Open;
end;

procedure Tdmins_reinsr_contract.DataModuleDestroy(Sender: TObject);
begin
ds_ins_reinsr_contract.close;
DSins_dict_companie.close;
DSsysdat.close;
end;

procedure Tdmins_reinsr_contract.ds_contractsAfterInsert(DataSet: TDataSet);
begin
ds_contracts.FieldByName('filial').asinteger:=0;
ds_contracts.FieldByName('reins').asinteger:=1;

end;

end.
