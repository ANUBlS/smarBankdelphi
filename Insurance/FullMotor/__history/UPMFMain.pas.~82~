procedure TPMFMain.ActionDeleteExecute(Sender: TObject);
var
    id:longint;
    i: Integer;
    WaitNextConfirm, WillRefresh: Boolean;
begin
with sb_aca do
 begin
      CallProcedure('checkadvancedobjectaccess',['CLOSECONTRACT_ALLMOTORFULL']);
 end;
    WaitNextConfirm :=True;
    WillRefresh :=False;
    with GridMotor,SelectedRows,Ins_MotorFull do
    try
       if Count = 0 then  CurrentRowSelected := True;
         for  I:=0 to  Count - 1 do
    begin
      GotoBookmark(Pointer(Items[I]));
      ID :=FieldbyName('CID').AsInteger;

      if  WaitNextConfirm  then
      case MessageDlg('Məlumatlar silinsin ?'
               ,mtConfirmation
       ,[mbYes, mbNo ,mbCancel ,mbYesToAll]
       ,0
       )   of
        mrNo       : Continue;
        mrCancel   : Break;
        mrYesToAll :
          if MessageDlg(Format('%d  sayda məlumat silinsin?', [Count - I]), mtConfirmation, [mbYes, mbCancel], 0) = mrYes then
             WaitNextConfirm :=False
          else
             Continue;
      end;
      Application.ProcessMessages;
      DeleteMotorInfo(ID);
      WillRefresh :=True;
    end;
     ActionRefreshExecute(sender);

   finally
      if WillRefresh then
      ActionRefreshExecute(Sender);

  end;

end;

