function TConstructionPolicy.UIObjectActivate: HResult;
begin
        id := StrToInt(Get_Params('id'));

        ODSConstruction.CloseAll;
        ODSConstruction.SetVariable('id',id);
        ODSConstruction.Open;
        ODSContracts.Close;

        ODSContracts.SetVariable('cid',ODSConstructionCID.value);
        ODSContracts.Open;
        ODSContracts.Edit;

        ODSConstructionR.CloseAll;
        ODSConstructionR.SetVariable('id',id);
        ODSConstructionR.Open;

        ODSConstSuggest.CloseAll;
        ODSCONSTSUGGEST.SetVariable('CID',StrToInt(Get_Params('id')));
        ODSConstSuggest.Open;
        ODSCONSTSUGGEST.Locate('CID', ODSConstructionID.Value,[]);
        ODSRisks.Locate('id',StrToInt(Get_Params('riskid')),[]);
        Franshiz.Locate('id',StrToInt(Get_Params('fid')),[]);
        Conditions.Locate('id',StrToInt(Get_Params('cdid')),[]);
        tid:=ODSConstructionTypeID.Value;
        if Get_Params('Mod') = 'Insert' then
        begin
            ODSConstPolicy.Insert;
            ODSConstPolicy.CloseAll;
            ODSConstPolicy.SetVariable('CS_ID',FloatToStr(ODSCONSTSUGGESTID.value));
            ODSConstPolicy.Open;
        end;
        if (Get_Params('Mod') = 'Insert') and (ODSConstPolicy.RecordCount<1) {or (ODSContractsPolicy_Num.IsNull)} then
        begin
           Caption := format(fmCaption, ['Elave']);
           btPrint.Enabled:=false;
        end   
        else
           Caption := format(fmCaption, ['Redakte']);
      Result := S_OK;
end;

