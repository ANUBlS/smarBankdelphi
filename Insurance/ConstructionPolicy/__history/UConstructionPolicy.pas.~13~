procedure TConstructionPolicy.BitBtn2Click(Sender: TObject);
begin
      with ODSConstPolicy do
      begin
           ODSConstPolicyCs_id.Value:=ODSConstSuggestID.Value;
           if State in [dsInsert, dsEdit] then  Post;
           RefreshRecord;
      end;
     with ODSContracts do
     if State in [dsEdit, dsInsert] then
     begin
        FieldByName('policy_id').asFloat := ODSConstPolicy.FieldByName('id').asFloat;
        if ODSContractsPolicy_Num.IsNull then
        FieldByName('POLICY_NUM').AsString:=OPCommon.callStringFunction('generatePolicy_Num',[tid]);
        Post;
     end;
     PostMessage(FOwnerHandle, WM_ModalResult, mrOk, 0);
end;

