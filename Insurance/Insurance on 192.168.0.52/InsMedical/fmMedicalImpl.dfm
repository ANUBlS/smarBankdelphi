  object ODSMedical: TOracleDataSet
    SQL.Strings = (
      'SELECT im.ROWID, im.*,ic.*, ims.ID meds_id, imp.ID medp_id'
      
        '  FROM ins_medical im, ins_med_suggestion ims, ins_med_policy im' +
        'p, ins_customers ic'
      ' WHERE ic.ID = im.kli_id '
      '  AND im.ID = ims.med_id(+) '
      '  AND ims.ID = imp.meds_id(+) AND im.CLOSE_PREFIX=0'
      ''
      '')
    QBEDefinition.QBEFieldDefs = {
