  object ODSMotorKasco: TOracleDataSet
    SQL.Strings = (
      
        'SELECT  im.rowid, im.id,  im.name, im.surname, im.fathername, im' +
        '.homephone,'
      '       im.workphone, im.mobilphone, im.address, im.profitname,'
      
        '       im.profitaddress, im.profitphone, im.insuredtype, im.insu' +
        'redcolor,'
      
        '       im.insuredoutputyear, im.insuredstatenum, im.underframenu' +
        'm,'
      
        '       im.insuredbannum, im.insuredenginenum, im.driveaccesspiop' +
        'le1,'
      
        '       im.driveaccesspiople2, im.driverbirthday1, im.driverbirth' +
        'day2,'
      
        '       im.driverexperience1, im.driverexperience2, im.driveinten' +
        'ded,'
      
        '       im.drivecost, im.insuredsum, im.typeid, im.ben_id, im.ins' +
        'uredmark,'
      
        '       im.insuredmodel, im.bank_id, im.month_id, im.franshiz_id,' +
        ' ic.sugg_ID , ic.policy_id, ic.begin_date, ic.end_date, ic.kli_i' +
        'd '
      '  FROM ins_motorkasco im,  ins_contracts ic'
      ' WHERE  '
      '       ic.blank_id = im.ID'
      '  and  ic.type_id = 1'
      '  and  ic.CLOSE_PREFIX=0'
      '')
