unit InsNewInsurance;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  Grids, DBGrids, StdCtrls, Buttons, ComObj, PlgModalContainer;

type
  TGuidError = Exception;
  TfmNewInsurance = class(TForm)
    GroupBox1: TGroupBox;
    btOk: TBitBtn;
    btCancel: TBitBtn;
    DBGrid1: TDBGrid;
    pmcCallNewBlank: TPlgModalContainer;
    CheckBox1: TCheckBox;
    procedure btOkClick(Sender: TObject);
    procedure btCancelClick(Sender: TObject);
    procedure CheckBox1Click(Sender: TObject);
  private
    function CallChangeForm(Params : TStringList):Integer;
    { Private declarations }
  public
    { Public declarations }
  end;

var
  fmNewInsurance: TfmNewInsurance;

implementation

uses InsDataModule;

{$R *.DFM}

function TfmNewInsurance.CallChangeForm(Params : TStringList):Integer;
var
  CallerGuid : TGUID;
begin
 with InsDataMod.ODSInsurances do
 begin

  if FieldByName('CHANGEGUID').AsString = '' then
  raise   TGuidError.Create('Guid is empty');
  CallerGuid := StringToGuid(FieldByName('CHANGEGUID').AsString);
//  fmContainer := TfmContainer.Create(Self);
  with pmcCallNewBlank do
    Result :=ShowModal(CallerGuid, Params);

//  fmContainer.OpenObj(CallerGuid, Params);

//  Result := fmContainer.ShowModal;
 end;
end;

procedure TfmNewInsurance.btOkClick(Sender: TObject);
var
  Params : TStringList;
begin
  Params := TStringList.Create;
  with InsDataMod.ODSInsCustomers, Params do
  try
    Values['Mod']:= 'Insert';
    ShowMessage(FloatToStr(FieldByName('ID').asFloat));
    Values['KLI_ID']:= FloatToStr(FieldByName('ID').asFloat);
    ModalResult := CallChangeForm(Params);
  finally
    Params.Free;
  end;
end;

procedure TfmNewInsurance.btCancelClick(Sender: TObject);
begin
  ModalResult := mrCancel
end;

procedure TfmNewInsurance.CheckBox1Click(Sender: TObject);
begin
  with InsDataMod do
    ODSInsurances.Filtered := CheckBox1.Checked;
end;

end.
