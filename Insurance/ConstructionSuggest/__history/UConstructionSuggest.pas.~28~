          end
          else
             Caption := format(fmCaption, ['Redakte']);
          if  ODSCONSTSUGGESTId.Value=0 then
          begin
              btPrint.Enabled:=false;
              btPolicy.Enabled:=false;
              //LoadData;
              //DTPContractDate.DateTime:=ODSConstSuggest.FieldByName('enddate').AsDateTime;
          end;
          //DTPContractDate.DateTime:=ODSConstSuggest.FieldByName('enddate').AsDateTime;
          LoadData;
          ODSConstSuggest.Edit;

      // end;
       Result := S_OK;
end;

