procedure TConstructionSuggest.btPrintClick(Sender: TObject);
begin
     ODSInterest.Locate('id',ODSCONSTSUGGESTInter_ID.Value,[]);
     AValute.Locate('valute',ODSCOntractsValute_ID.Value,[]);
     try
        with ConstructionWordExporter do
        begin
             FileName:=ExtractFilePath(Application.ExeName)+ '\ConstructionSuggest.doc';
             Open(False);
             SetBookmark('Insured',CustomersName.value, false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('IAddress',CustomersAddress.value, false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('IPeriod',DateToStr(ODSContractsBegin_date.value)+' - '+DateToStr(ODSContractsEnd_date.value), false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('MLimit',CurrToStr(ODSCONSTSUGGESTMLimit.value), false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Franshiz',FranshizName.value, false, false, False, false, 8, 'Arial AzLat', False);
