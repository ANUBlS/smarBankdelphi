function TConstructionSuggest.SaveData: Boolean;
begin
     Result := False;
   if   cbFranshiz.State = cbChecked then
    with Franshiz do
    begin
        Insert;
        //ODSConstSuggest.Insert;
        FieldByName('name').asString := memFrashize.Text;
        Post;
        RefreshRecord;
    end;

    if   cbConditions.State = cbChecked then
    with Conditions do
    begin
         Insert;
         //ODSConstSuggest.Insert;
         FieldByName('name').asString := memConditions.Text;
         Post;
         RefreshRecord;
    end;

    if   cbInterest.State = cbChecked then
    with ODSInterest do
    begin
         Insert;
         //ODSConstSuggest.Insert;
         FieldByName('name').asString := memInterest.Text;
         Post;
         RefreshRecord;
    end;

    with ODSConstSuggest do
    begin
         FieldByName('cid').AsFloat := id;
         FieldByName('frz_id').AsFloat := Franshiz.FieldByName('id').asFloat;
         FieldByName('rfrz_id').AsFloat := Franshiz.FieldByName('id').asFloat;
         FieldByName('cndt_id').AsFloat := Conditions.FieldByName('id').asFloat;
         FieldByName('inter_id').AsFloat := ODSInterest.FieldByName('id').asFloat;
         FieldByName('enddate').AsDateTime := DTPContractDate.DateTime;
         if State in [dsInsert,dsEdit] then Post;
         RefreshRecord();
         if f then
         begin
            ODSContracts.Edit;
            //ODSContracts.FieldByName('sugg_id').AsFloat := FieldByName('id').asFloat;
            ODSContracts.FieldByName('ins_date').AsDateTime := DTPContractDate.DateTime;
            ODSContracts.Post;
         end;
         f:=false;
         result := True;
    end;
end;

