package InsVCL50;

{$R *.res}
{$R 'INSWordExporter.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Smart Insurence Visual Components Library'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl,
  sbplg50,
  dclofficexp,
  VCLXFiles150;

contains
  FlatSpeed in 'FlatSpeed.pas',
  PanelSpeed in 'PanelSpeed.pas',
  MDIChildPanel in 'MDIChildPanel.pas',
  UIMDIMainCaller in 'UIMDIMainCaller.pas',
  UPlgContainer in 'UPlgContainer.pas' {fmContainer},
  PlgModalContainer in 'PlgModalContainer.pas',
  INSWordExporter in 'INSWordExporter.pas',
  CommanParametrs in 'CommanParametrs.pas';

end.
