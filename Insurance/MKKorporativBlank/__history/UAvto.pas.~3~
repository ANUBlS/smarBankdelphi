unit UAvto;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, Grids, DBGrids, ExtCtrls, DBCtrls;

type
  TfrmAvto = class(TForm)
    GroupBox1: TGroupBox;
    DBGrid1: TDBGrid;
    DBNavigator1: TDBNavigator;
    procedure FormActivate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmAvto: TfrmAvto;

implementation

uses DModuleInsKorporativ, UInsKorporativKasco,SBTranslateProc,sboapiDataModuleimpl;

{$R *.DFM}

procedure TfrmAvto.FormActivate(Sender: TObject);
begin
     DModuleKorporativ.ODSMotorkasko.Close;
     DModuleKorporativ.ODSMotorkasko.SetVariable('cid',DModuleKorporativ.ODSContractsID.value);
     DModuleKorporativ.ODSMotorkasko.Open;
end;

procedure TfrmAvto.FormCreate(Sender: TObject);
begin


SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);


end;

procedure TfrmAvto.FormDestroy(Sender: TObject);
var
    s:real;
    i:integer;
begin
     s:=0;
     with DModuleKorporativ.ODSMotorkasko do
     begin
        {  First;
          for i:=0 to RecordCount-1 do
          begin
              s:=s+FieldByName('ODSMotorkaskoKORPORATIV_INS_SUM').AsCurrency;
              Next;
          end;    }
          Close;
          SetVariable('cid',DModuleKorporativ.ODSContractsID.value);
          Open;
          //DModuleKorporativ.ODSContractsInSSumm.Value:=s;  
     end;
end;

procedure TfrmAvto.FormKeyPress(Sender: TObject; var Key: Char);
begin
if ord(key)=vk_escape then frmAvto.Close;

end;

end.
