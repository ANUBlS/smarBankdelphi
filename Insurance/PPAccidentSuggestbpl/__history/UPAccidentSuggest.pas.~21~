function TPAccidentSuggest.SaveData: boolean;
begin
with DMPAccidentSuggest,sb_aca do
 begin
      CallProcedure('checkadvancedobjectaccess',['SUGGESTIONCOMMITCONTRACT_PERSACCIDENT']);
 end;
        Result := False;
    {if   cbConditions.State = cbChecked then
    with ODSCondition do
    begin
         Insert;
         FieldByName('name').asString := memConditions.Text;
         Post;
         RefreshRecord;
    end;

    if   cbFranshiz.State = cbChecked then
    with Franshiz do
    begin
         Insert;
         FieldByName('name').asString := memFrashize.Text;
         Post;
         RefreshRecord;
    end;   }

    with DMPAccidentSuggest,ODSPAccSuggest do
    begin

         FieldByName('paid').AsFloat := id;
         FieldByName('cndt_id').AsFloat := ODSCondition.FieldByName('id').asFloat;
         FieldByName('insurancetime').AsDateTime := DTPContractDate.DateTime;
         if State in [dsInsert,dsEdit] then Post;
         RefreshRecord();
         if f then begin
         ODSContracts.Edit;
         //showmessage(DBEdit1.Text);
         //ODSContracts.FieldByName('sugg_id').AsFloat := FieldByName('id').asFloat;
         ODSContracts.FieldByName('inssumm').AsFloat := strtofloat(DBEdit1.Text);
         ODSContracts.FieldByName('ins_date').AsDateTime := DTPContractDate.DateTime;

         //if ODSContracts.State in [dsInsert,dsEdit] then
         ODSContracts.Post;
         end;
         f:=false;
         result := True;
    end;
end;


procedure TPAccidentSuggest.btPolicyClick(Sender: TObject);
var
   p : TStringList;
begin

with sb_aca do
 begin
      CallProcedure('checkadvancedobjectaccess',['POLISCONTRACT_PERSACCIDENT']);
 end;

   p:= TStringList.Create;
   p.Values['ID']:=FloatToStr(ODSPAccidentId.value);
   with PolicyContainer do begin
     ShowModal(StringToGuid('{DF05FA85-2A5E-472D-8506-3C31DF75BDD8}'),p );
   end;
   p.Free;

end;

procedure TPAccidentSuggest.btPrintClick(Sender: TObject);
begin

with DMPAccidentSuggest,sb_aca do
 begin
      CallProcedure('checkadvancedobjectaccess',['SUGGESTIONPRINTCONTRACT_PERSACCIDENT']);
 end;


      DMPAccidentSuggest.AValute.Locate('valute',DMPAccidentSuggest.ODSCOntractsValute_ID.Value,[]);
      DMPAccidentSuggest.Risks.Locate('id',DMPAccidentSuggest.ODSPAccidentRISKid.Value,[]);
      DMPAccidentSuggest.ODSBeneficiary.Locate('id',DMPAccidentSuggest.ODSPAccidentPROFITID.Value,[]);
      DMPAccidentSuggest.ODSCondition.Locate('id',DMPAccidentSuggest.ODSPaccSuggestCNDT_ID.Value,[]);
      DMPAccidentSuggest.Franshiz.Locate('id',DMPAccidentSuggest.ODSPaccSuggestFRZ_ID.Value,[]);
      try
        with SuggestExporter do
        begin
             FileName:=ExtractFilePath(Application.ExeName)+ '\Ferdi Qeza Teklif.doc';
             Open(False);
             SetBookmark('Insured',DMPAccidentSuggest.CustomersName.value, false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Insperiod',DateToStr(DMPAccidentSuggest.ODSContractsBegin_date.value)+' - '+DateToStr(DMPAccidentSuggest.ODSContractsEnd_date.value), false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Valute',DMPAccidentSuggest.AValuteValu_name.value, false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Insrisks',DMPAccidentSuggest.RisksName.value, false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Beneficiary',DMPAccidentSuggest.ODSBeneficiaryName.value, false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Inssum',FloatToStr(DMPAccidentSuggest.ODSPAccSuggestInsurancesum.value), false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Franshiz',DMPAccidentSuggest.FranshizName.value, false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Insammount',CurrToStr(DMPAccidentSuggest.ODSCONtractsAmmount.value), false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Medicalcost',CurrToStr(DMPAccidentSuggest.ODSPAccSuggestMedicalcost.value), false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('AInsammount',FloatToStr(DMPAccidentSuggest.ODSPAccSuggestAll_InsAmmount.value), false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Geo',DMPAccidentSuggest.ODSPaccSuggestGeo.value, false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Instime',DateToStr(DMPAccidentSuggest.ODSPAccSuggestInsuranceTime.value), false, false, False, false, 8, 'Arial AzLat', False);
             SetBookmark('Cond',DMPAccidentSuggest.ODSConditionName.value, false, false, False, false, 8, 'Arial AzLat', False);

        end;



    finally
        SuggestExporter.Show;
    end;

end;

