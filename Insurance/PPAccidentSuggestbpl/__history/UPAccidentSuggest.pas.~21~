if ord(key)=vk_escape then  close;
 end;

procedure TPAccidentSuggest.FormShow(Sender: TObject);
begin
id := contactid;
    //showmessage(Get_Params('Mod'));
   // exit;
     DBLookupComboBox3.KeyValue:=0;
       f:=true;
       DMPAccidentSuggest.ODSPAccident.Close;
       DMPAccidentSuggest.ODSPAccident.SetVariable('ID',id);
       DMPAccidentSuggest.ODSPaccident.Open;

       DMPAccidentSuggest.ODSContracts.Close;
       DMPAccidentSuggest.ODSContracts.SetVariable('cid', DMPAccidentSuggest.ODSPAccident.FieldByName('cid').AsInteger);
       DMPAccidentSuggest.ODSContracts.Open;

       //if Get_Params('Mod') = 'Insert' then
       if ins_or_upd='Insert' then

       begin
          DMPAccidentSuggest.ODSPAccSuggest.Insert;
          Caption := format(fmCaption, ['Elave']);
          DMPAccidentSuggest.ODSPAccSuggest.SetVariable('paid',id);
          DMPAccidentSuggest.ODSPAccSuggest.Open;
          DTPContractDate.DateTime:=DMPAccidentSuggest.DsSysdat.FieldByName('tek_dat').AsDateTime;
       end
       else
          begin  //-----Edit mode
              DMPAccidentSuggest.ODSPAccSuggest.Close;
              DMPAccidentSuggest.ODSPAccSuggest.SetVariable('paid',id);
              DMPAccidentSuggest.ODSPAccSuggest.Open;
              DMPAccidentSuggest.ODSPAccSuggest.Edit;
              DTPContractDate.DateTime := DMPAccidentSuggest.ODSPAccSuggestInsurancetime.value;
              memConditions.Text:='';
              Caption := format(fmCaption, ['Redakte']);
              btPrint.Enabled := True;
              btPolicy.Enabled := True;
           end;
         //    end;

end;

initialization
 PAccidentSuggest := TPAccidentSuggest.Create(Application);
end.
