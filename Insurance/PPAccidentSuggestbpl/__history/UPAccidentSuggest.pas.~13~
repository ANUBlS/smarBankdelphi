  TPAccidentSuggest = class(TForm)
    XFPanel1: TXFPanel;
    XFLabel1: TXFLabel;
    XFLabel2: TXFLabel;
    XFLabel3: TXFLabel;
    XFLabel4: TXFLabel;
    XFLabel5: TXFLabel;
    XFLabel6: TXFLabel;
    XFLabel7: TXFLabel;
    XFLabel9: TXFLabel;
    XFLabel10: TXFLabel;
    XFLabel11: TXFLabel;
    DBEdit4: TDBEdit;
    DBEdit5: TDBEdit;
    DBEdit3: TDBEdit;
    DBEdit1: TDBEdit;
    DBLookupComboBox3: TDBLookupComboBox;
    DBLookupComboBoxCondition: TDBLookupComboBox;
    memConditions: TMemo;
    DBLookupComboBoxFranshiz: TDBLookupComboBox;
    memFrashize: TMemo;
    DBEdit6: TDBEdit;
    DTPContractDate: TDateTimePicker;
    cbConditions: TXFCheckBox;
    cbFranshiz: TXFCheckBox;
    XFPanel2: TXFPanel;
