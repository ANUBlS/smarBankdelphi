  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  PAccidentSuggest: TPAccidentSuggest;
  procedure InitPlugin(s:string);export;
implementation

uses DMPAccidentSuggestImpl,ComObj,CommanParametrs,sboapiDataModuleImpl,SBTranslateProc;

{$R *.dfm}

procedure InitPlugin(s:string);export;
begin


   PAccidentSuggest.ShowModal;
end;
exports
     InitPlugin;

     procedure TPAccidentSuggest.DBEdit1Change(Sender: TObject);
begin
     with DMPAccidentSuggest.ODSCondition do
          memConditions.Text := FieldByName('name').asString;
     btApply.Enabled:=true;
end;

procedure TPAccidentSuggest.DBLookupComboBox3Click(Sender: TObject);
begin
 btApply.Enabled:=true;
end;

procedure TPAccidentSuggest.DBLookupComboBox3KeyPress(Sender: TObject;
  var Key: Char);
begin
     if Key = #13 then
     begin
        if HiWord(GetKeyState(VK_Shift))<>0 then
           with Sender as TControl do
           SelectNext(ActiveControl,False, True)
        else
           with Sender as TControl do
           SelectNext(ActiveControl,True, True);
        key:=#0;
     end;
end;

procedure TPAccidentSuggest.FormCreate(Sender: TObject);
begin
DMPAccidentSuggest:=TDMPAccidentSuggest.create(self);
SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TPAccidentSuggest.FormKeyPress(Sender: TObject; var Key: Char);
begin
if ord(key)=vk_escape then  close;
 end;

initialization
 PAccidentSuggest := TPAccidentSuggest.Create(Application);
end.
