procedure TfmMKPolicy.FillRow(Doc: Variant; Row: Integer; Text0, Text1,
  Text2, Text3, Text4,Text5: String);
begin
     Doc.Tables.Item(1).Cell(Row,1).Range.InsertAfter(Text0);
     Doc.Tables.Item(1).Cell(Row,2).Range.InsertAfter(Text1);
     Doc.Tables.Item(1).Cell(Row,3).Range.InsertAfter(Text2);
     Doc.Tables.Item(1).Cell(Row,4).Range.InsertAfter(Text3);
     Doc.Tables.Item(1).Cell(Row,5).Range.InsertAfter(Text4);
     Doc.Tables.Item(1).Cell(Row,6).Range.InsertAfter(Text5);
end;

procedure TfmMKPolicy.MakeExtras(wrdDataDoc: Variant);
var
    i,n:integer;
    str:WideString;
begin
    with ODSMotorKasko do
    begin
        n:=RecordCount;
        First;
        for i:= 1 to n do
        begin
            wrdDataDoc.Tables.Item(1).Rows.Add;
            wrdDataDoc.Tables.Item(1).Rows.Item(i+1).Range.Font.Name := 'Arial AzLat';
            wrdDataDoc.Tables.Item(1).Rows.Item(i+1).Range.Bold:=false;
            FillRow(wrdDataDoc, i+1,ODSMotorKaskoInsuredMark.AsString+' '+ODSMotorKaskoInsuredModel.AsString,ODSMotorKaskoInsuredColor.AsString+', '+ODSMotorKaskoInsuredType.AsString+','+IntToStr(ODSMotorKaskoInsuredOutputYear.Value),ODSMotorKaskoInsuredEngineNum.AsString,ODSMotorKaskoInsuredBanNum.AsString,ODSMotorKaskoInsuredStateNum.AsString,ODSMotorKaskoUnderFrameNum.AsString+', '+ODSMotorKaskoNumSeats.AsString);

            wrdDataDoc.Tables.Item(2).Rows.Add;
            wrdDataDoc.Tables.Item(2).Rows.Item(i+1).Range.Font.Name := 'Arial AzLat';
            wrdDataDoc.Tables.Item(2).Rows.Item(i+1).Range.Bold:=false;
            FillRow1(wrdDataDoc,i+1,ODSMotorKaskoFranshiz.AsString+' '+ODSAvaluteVal_Name.Value,ODSMotorKaskoDriveCost.AsString+' '+ODSAvaluteVal_Name.Value,ODSMotorKaskoInssumm.AsString+' '+ODSAvaluteVal_Name.Value,ODSMotorKaskoAmmount.AsString+' '+ODSAvaluteVal_Name.Value);
            Next;
        end;
    end;

end;

procedure TfmMKPolicy.FillRow1(Doc: Variant; Row: Integer; Text0, Text1,Text2,Text3: String);
begin
    Doc.Tables.Item(2).Cell(Row,1).Range.InsertAfter(Text0);
    Doc.Tables.Item(2).Cell(Row,2).Range.InsertAfter(Text1);
    Doc.Tables.Item(2).Cell(Row,3).Range.InsertAfter(Text2);
    Doc.Tables.Item(2).Cell(Row,4).Range.InsertAfter(Text3);
end;

{function TfmMKPolicy.UTFEncoder(str: WideString): WideString;
var
   i,j:integer;
begin
   for i:=1 to length(str) do
   begin
       for j:=0 to lbNonUnicode.Items.Count-1 do
       begin
           if str[i]=lbNonUnicode.Items[j] then
              str[i]:=tlbUnicode.Items[j][1];
       end;
   end;
   result:=str;
end;  }



