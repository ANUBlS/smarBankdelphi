procedure TfmMKPolicy.MakeExtras(wrdDataDoc: Variant);
var
    i,n:integer;
    str:WideString;
begin
    with DMMKPolicy,ODSMotorKasko do
    begin
        n:=RecordCount;
        First;
        for i:= 1 to n do
        begin
            wrdDataDoc.Tables.Item(1).Rows.Add;
            wrdDataDoc.Tables.Item(1).Rows.Item(i+1).Range.Font.Name := 'Arial AzLat';
            wrdDataDoc.Tables.Item(1).Rows.Item(i+1).Range.Bold:=false;
            FillRow(wrdDataDoc, i+1,ODSMotorKaskoInsuredMark.AsString+' '+ODSMotorKaskoInsuredModel.AsString,ODSMotorKaskoInsuredColor.AsString+', '+ODSMotorKaskoInsuredType.AsString+','+IntToStr(ODSMotorKaskoInsuredOutputYear.Value),ODSMotorKaskoInsuredEngineNum.AsString,ODSMotorKaskoInsuredBanNum.AsString,ODSMotorKaskoInsuredStateNum.AsString,ODSMotorKaskoUnderFrameNum.AsString+', '+ODSMotorKaskoNumSeats.AsString);

            wrdDataDoc.Tables.Item(2).Rows.Add;
            wrdDataDoc.Tables.Item(2).Rows.Item(i+1).Range.Font.Name := 'Arial AzLat';
            wrdDataDoc.Tables.Item(2).Rows.Item(i+1).Range.Bold:=false;
            FillRow1(wrdDataDoc,i+1,ODSMotorKaskoFranshiz.AsString+' '+ODSAvaluteVal_Name.Value,ODSMotorKaskoDriveCost.AsString+' '+ODSAvaluteVal_Name.Value,ODSMotorKaskoInssumm.AsString+' '+ODSAvaluteVal_Name.Value,ODSMotorKaskoAmmount.AsString+' '+ODSAvaluteVal_Name.Value);
            Next;
        end;
    end;

end;

