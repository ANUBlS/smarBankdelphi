procedure TDModule.DataModuleCreate(Sender: TObject);
begin
ODSAgent.Open;
ODSBeneficiary.Open;
ODSRisks.Open;
ODSRiskType.Open;
ODSCustomers.Open;
ODSAvalute.Open;
ODSSex.Open;
ODSBanks.Open;
ODSReliaseDates.Open;
ODSMonths.Open;
DSFilial.Open;
