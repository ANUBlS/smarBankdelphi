end;

procedure TDModule.DataModuleDestroy(Sender: TObject);
begin

ODSAgent.close;
ODSBeneficiary.close;
ODSRisks.close;
ODSRiskType.close;
ODSCustomers.close;
ODSAvalute.close;
ODSSex.close;
ODSBanks.close;
ODSReliaseDates.close;
ODSMonths.close;
DSFilial.close;
Ds_bnf_type.close;
end;

procedure TDModule.ODSContractsAfterInsert(DataSet: TDataSet);
begin
      DataSet.FieldByName('TYPE_ID').asInteger := 3;
end;

procedure TDModule.ODSCPropertyAfterInsert(DataSet: TDataSet);
begin
     DataSet.FieldByName('CID').asInteger := CProperty.CID;
end;

end.
