end;

if  dmPaymentTer.Pins_common.CallBooleanFunction('ins_pay_Ter_contaract',[contactid,CurrencyEdit2.Value,DBLookupComboBox1.KeyValue])=true then
     showmessage('Xitam ödəndi.');
