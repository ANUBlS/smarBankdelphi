package MKSuggestionbpl;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  Sbtranslate,
  sboapi50,
  sbcmvcl50,
  VCLXFiles150,
  InsVCL50,
  SearchCB,
  SBCommon50,
  sbplg50;

contains
  FrmMKSuggestionImpl in 'FrmMKSuggestionImpl.pas' {FrmMKSuggestion},
  DMMKSuggestionImpl in 'DMMKSuggestionImpl.pas' {DMMKSuggestion: TDataModule},
  URiskTypes in 'URiskTypes.pas' {fmRiskTypes},
  MKSUnderTable in 'MKSUnderTable.pas' {fmUndertable};

end.
