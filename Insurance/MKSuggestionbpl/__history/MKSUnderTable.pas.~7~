unit MKSUnderTable;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, Mask, DBCtrls, HintBox, Buttons, ExtCtrls, OleCtnrs,DB;

type
  TfmUndertable = class(TForm)
    OleContainer1: TOleContainer;
    Panel1: TPanel;
    BitBtn1: TBitBtn;
    BitBtn2: TBitBtn;
    RadioButton1: TRadioButton;
    RadioButton2: TRadioButton;
    hbError: THintBox;
    DBEdit1: TDBEdit;
    Panel2: TPanel;
    BitBtn3: TBitBtn;
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure BitBtn3Click(Sender: TObject);
    procedure RadioButton1Click(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  fmUndertable: TfmUndertable;

implementation

uses DMMKSuggestionImpl;

{$R *.dfm}

procedure TfmUndertable.BitBtn3Click(Sender: TObject);
begin
 with OleContainer1 do
    DoVerb(ovPrimary);
end;

procedure TfmUndertable.FormClose(Sender: TObject; var Action: TCloseAction);
begin
    if OleContainer1.State in [osLoaded] then
    OleContainer1.Close;
end;

procedure TfmUndertable.FormCreate(Sender: TObject);
begin
DBEdit1.DataSource := DMMKSuggestion.DSTemplates;
    DBEdit1.DataField := 'NAME';
    with DMMKSuggestion, ODSTemplates do
    if IsEmpty then RadioButton2.Checked := True
       else Edit;
       //SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TfmUndertable.FormKeyPress(Sender: TObject; var Key: Char);
begin
if ord(key)=vk_escape then close;

end;

procedure TfmUndertable.FormShow(Sender: TObject);
begin
     OpenContainer;
end;


procedure TfmUndertable.RadioButton1Click(Sender: TObject);
begin
    with DMMKSuggestion, ODSTemplates do begin
    if State in [dsEdit, dsInsert] then Cancel;
    ODSTemplates.Edit;
    FormShow(Sender);
end;

end;

procedure TfmUndertable.OpenContainer(Show: Boolean);
var
  buf : TStream;
  FWordApl : Variant;
begin

  with DMMKSuggestion, ODSTemplates do
   if State in [dsEdit] then
   begin
      Buf := TMemoryStream.Create;
      TBlobField( FieldByName('TEMPLATE')).SaveToStream(Buf);
      Buf.Position := 0;
      OleContainer1.LoadFromStream(Buf);
   end
   else
     OleContainer1.CreateObject('Word.Document', False);

   if Show then
   OleContainer1.DoVerb(ovShow);

end;


end.
