unit AccInterval;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  ComCtrls, StdCtrls, PlgModalContainer, XFSCtrls, ExtCtrls;

type
  TFormInterval = class(TForm)
    XFGroupBox1: TXFGroupBox;
    Label2: TLabel;
    Label1: TLabel;
    StartDateEdit: TDateTimePicker;
    EndDateEdit: TDateTimePicker;
    XFPanel1: TXFPanel;
    OkButton: TButton;
    CancelButton: TButton;
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormShow(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormInterval: TFormInterval;

implementation

{$R *.DFM}
    uses sboapiDataModuleimpl,SBTranslateProc, InsDataModule;
procedure TFormInterval.FormCreate(Sender: TObject);
begin
SBTranslateProc.TranslateAllCompForms(Self,sboapiDataModule.OrPack_SL);
end;

procedure TFormInterval.FormKeyPress(Sender: TObject; var Key: Char);
begin
      if Ord(Key) = VK_ESCAPE then
      Close;
end;

procedure TFormInterval.FormShow(Sender: TObject);
begin
     ActiveControl :=StartDateEdit;

     StartDateEdit.DateTime:=InsDataMod.Sysdat.FieldByName('tek_dat').AsDateTime;
      EndDateEdit.DateTime:=InsDataMod.Sysdat.FieldByName('tek_dat').AsDateTime;
end;



end.
