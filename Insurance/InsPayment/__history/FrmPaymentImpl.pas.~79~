procedure TFrmPayment.ToolButton1Click(Sender: TObject);
begin
 with DMPayment,sb_aca do
 begin
      CallProcedure('checkadvancedobjectaccess',['SEEPAYMENT']);
 end;
  FrmAddPayment := TFrmAddPayment.Create(self);
  try
    if FrmAddPayment.ShowModal = mrOk then
      DMPayment.ODSPayments.Refresh;
  finally
    FrmAddPayment.free;
  end;

end;

