  ClearEdit;
  Account.Close;
  Account.Open;
  FormNominalCustomers.RH := false;
  IF FForm = 0 then
  BEGIN

    ExpSettingsType.Close;
    ExpSettingsType.SetVariable('stypeid', optype);
    ExpSettingsType.Open;

    IF ExpSettingsType.RecordCount = 1 THEN
      DBLookupComboBox2.KeyValue := ExpSettingsType.FieldByName('id').AsInteger
    ELSE
      DBLookupComboBox2.KeyValue := -1;

    RadioButton1.Checked:=True;
    ClearSearch;
    FormNominalCustomers.FTip := 0;
    FormNominalCustomers.CBoxPassPlace.KeyValue := null;
    FormNominalCustomers.CbBoxClick(Sender);
  END
  ELSE
  BEGIN
    FormNominalCustomers.FTip := 1;
