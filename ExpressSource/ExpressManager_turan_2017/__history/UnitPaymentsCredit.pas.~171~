procedure TFormPaymentsCredit.KreditSearchidKeyPress(Sender: TObject;
  var Key: Char);
VAR
  s: string;
  Accno: string;
BEGIN
  s := '';
  IF Key = #13 THEN
  BEGIN
    s := copy((Sender as TEdit).Name, 13, length((Sender as TEdit).Name));
    IF s = 'id' THEN s := 'c.' + s;
    s := '(' + s + '=' + '''' + (Sender as TEdit).Text + '''' + ')';
    WITH ExpDataModule DO
    BEGIN
      SearchCustDataSet.Close;
