procedure TFormSearchCustName.EditLastNameExit(Sender: TObject);
begin
  TEdit(Sender).Text := EmptyStr;
end;

procedure TFormSearchCustName.EditLastNameKeyPress(Sender: TObject;
  var Key: Char);
begin
  if Key = #13 then
    ActionSearchExecute(Sender);
end;

procedure TFormSearchCustName.ActionSearchExecute(Sender: TObject);
var
  SearchField: string;
  SearchOptions: TSearchRecordOptions;
  Grid: TDBGrid;
begin
  SearchOptions := [srIgnoreCase, srPartialMatch];

  with Sender as TEdit do
  begin
    SearchField := copy(Name, 5, length(Name));
    with TOracleDataSet(DBGrid1.DataSource.DataSet) do

      if not SearchRecord(SearchField, Text, SearchOptions + [srFromCurrent,
        srForward]) then

        if MessageDlg('Axtarış sona çatdı.' + #13 + 'Əvvəldən başlasın?',
          mtInformation, [mbNo, mbYes], 0) = mrYes then

          if not SearchRecord(SearchField, Text,
            SearchOptions + [srFromBeginning]) then
            MessageDlg('Yazı tapılmayıb!', mtInformation, [mbOK], 0);

  end;
end;

procedure TFormSearchCustName.FormActivate(Sender: TObject);
begin
  IF not(FormNominalCustomers.RH) THEN
    BorderIcons := BorderIcons - [biSystemMenu];
  IF ExpFormNew.RFormNew THEN
    BorderIcons := BorderIcons + [biSystemMenu];
  IF MessageDlg('Belə müştəri artıq mövcuddur' + #10#13 +
    'Cədvəldən müştərini seçib qəbul düyməsinə basın', mtWarning, [mbYes], 0,
    mbYes) = mrYes then
    Close;
end;

end.
