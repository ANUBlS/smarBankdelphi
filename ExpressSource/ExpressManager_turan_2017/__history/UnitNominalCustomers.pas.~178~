procedure TFormNominalCustomers.Button1Click(Sender: TObject);
Var
  S: real;
  H: set of Char;
  D: string[1];
  text: UTF8String;
BEGIN
  IF not(ExpFormNew.RFormNew) THEN
  BEGIN
    H := ['2' .. '8'];
    D := CBoxPassPlace.KeyValue;
    IF ExpFormNew.RFormNew THEN
      S := StrToFloat(ExpFormNew.CMCurrencyEdit.text)
    ELSE
      S := StrToFloat(FormPaymentsCredit.CMCurrencyEdit1.text);

    IF (CBoxPassPlace.text = '') THEN
    BEGIN
      ShowMessage('Göndərən şəxsin sənədin növü sahəsi seçilməyib!');
      exit;
    END;
    IF (CBoxPassPlace.KeyValue = 1) THEN
    BEGIN
      IF Editpasspin.text = '' THEN
      BEGIN
        ShowMessage('Göndərən şəxsin pinkod sahəsi doldurulmayıb!');
        exit;
      END;
      IF EditSerial.text = '' THEN
      BEGIN
        ShowMessage('Göndərən şəxsin seriya sahəsi doldurulmayıb!');
        exit;
      END;
      IF EditPassport.text = '' THEN
      BEGIN
        ShowMessage('Göndərən şəxsin nömrə sahəsi doldurulmayıb!');
        exit;
      END;
    END;
    IF D[1] in H THEN
    BEGIN
      IF EditSerial.text = '' THEN
      BEGIN
        ShowMessage('Göndərən şəxsin seriya sahəsi doldurulmayıb!');
        exit;
      END;
      IF EditPassport.text = '' THEN
      BEGIN
        ShowMessage('Göndərən şəxsin nömrə sahəsi doldurulmayıb!');
        exit;
      END;
    END;

    IF CBoxPassPlace.KeyValue = 9 THEN
    BEGIN
      WITH FormSearchCustName.SendDataSetName DO
      BEGIN
        text := EditLastName.text + EditName1.text + EditSoname.text;
        Close;
        SQL[1] := 'where replace(lower(custname),'' '')=' + 'lower(' +
          QuotedStr(text) + ')';
        Open;
        IF RecordCount > 0 THEN
          FormSearchCustName.ShowModal;
      END;
    END;
  END;

  IF CheckField(S) THEN
  BEGIN
    IF ExpFormNew.RFormNew THEN
    BEGIN
      if (EditMobil.text = '') and (EditPhone.text = '') then
      begin
        ShowMessage
          ('Göndərən şəxsin mobil və ya şəhər telefon sahəsi doldurulmayıb');
        exit;
      end;
    END;
    Parametr;
    RH := true;
    FormNominalCustomers.Close;
  END;

END;

