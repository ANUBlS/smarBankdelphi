procedure TFormNominalCustomers.CBoxPassPlaceClick(Sender: TObject);
begin
  FTip := 2;
  CBoxPassPlaceCloseUp(Sender);
end;

procedure TFormNominalCustomers.CBoxPassPlaceCloseUp(Sender: TObject);
begin

  IF VarIsNull(CBoxPassPlace.KeyValue) or (CBoxPassPlace.KeyValue = -1) THEN
  BEGIN
    Editpasspin.ReadOnly := false;
    Editpasspin.Color := clWhite;
    EditSerial.ReadOnly := false;
    EditSerial.Color := clWhite;
    EditPassport.ReadOnly := false;
    EditPassport.Color := clWhite;
    Label58.Visible := true;
    Label60.Visible := true;
    exit;
  END;

  IF FTip <> 1 THEN
  BEGIN
    Editpasspin.Clear;
    EditPassport.Clear;
  END;

  Case CBoxPassPlace.KeyValue of
    1:
      begin
        Editpasspin.ReadOnly := false;
        Editpasspin.Color := clWhite;
        EditSerial.ReadOnly := false;
        EditSerial.Color := clWhite;
        EditPassport.ReadOnly := false;
        EditPassport.Color := clWhite;
        Label58.Visible := true;
        Label60.Visible := true;
        EditSerial.text := ExpDataModule.DocTypesDataSet.FieldByName
          ('series').AsString;
        EditSerial.ReadOnly := true;
        EditPassport.MaxLength := 8;
      end;
    2, 3, 4, 5, 6, 7, 8:
      begin
        Editpasspin.ReadOnly := true;
        Editpasspin.Color := clSilver;
        EditSerial.ReadOnly := false;
        EditSerial.Color := clWhite;
        EditPassport.ReadOnly := false;
        EditPassport.Color := clWhite;
        Label58.Visible := false;
        Label60.Visible := true;
        EditPassport.MaxLength := 0;
        EditSerial.text := ExpDataModule.DocTypesDataSet.FieldByName
          ('series').AsString;
      end;
    9:
      begin
        Editpasspin.ReadOnly := true;
        Editpasspin.Color := clSilver;
        EditSerial.ReadOnly := true;
        EditSerial.Color := clSilver;
        EditPassport.ReadOnly := true;
        EditPassport.Color := clSilver;
        Label58.Visible := false;
        Label60.Visible := false;
        EditSerial.text := ExpDataModule.DocTypesDataSet.FieldByName
          ('series').AsString;
      end;
  end;

end;

