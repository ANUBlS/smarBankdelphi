unit ExpUnitFilter;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, ExtCtrls, StdCtrls, DBCtrls, DB, OracleData,XDBGrids;

type
  TFormFilter = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    GroupBox1: TGroupBox;
    DBLCBTransfer: TDBLookupComboBox;
    CheckBox3: TCheckBox;
    Panel3: TPanel;
    GroupBox2: TGroupBox;
    DBLCBValyuta: TDBLookupComboBox;
    CheckBox2: TCheckBox;
    Panel4: TPanel;
    GroupBox3: TGroupBox;
    DBLCSFilial: TDBLookupComboBox;
    CheckBox1: TCheckBox;
    Button1: TButton;
    Button2: TButton;
    DataSource1: TDataSource;
    OracleDataSet1: TOracleDataSet;
    OracleDataSet2: TOracleDataSet;
    DataSource2: TDataSource;
    OracleDataSet3: TOracleDataSet;
    DataSource3: TDataSource;
    Panel5: TPanel;
    GroupBox4: TGroupBox;
    DBLCBFilial: TDBLookupComboBox;
    CheckBox4: TCheckBox;
    OracleDataSet4: TOracleDataSet;
    DataSource4: TDataSource;
    procedure Button2Click(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    DBGridFilter:TXDBGrid;
  end;

var
  FormFilter: TFormFilter;

implementation
uses sboapiDataModuleImpl,ExpressManagerImpl,ExpDataModuleUnit;

{$R *.dfm}

procedure TFormFilter.Button1Click(Sender: TObject);
var  s,st,sk,sp:string;
begin
  if CheckBox1.Checked then s:='(a.filial='+DBLCSFilial.KeyValue+')'
                       else s:='';

  if CheckBox4.Checked then st:='(a.bfilial='+DBLCBFilial.KeyValue+')'
                       else st:='';

  if CheckBox2.Checked then sk:='(a.val_cod='+DBLCBValyuta.KeyValue+')'
                       else sk:='';

  if CheckBox3.Checked then sp:='(a.setid='+DBLCBTransfer.KeyValue+')'
                       else sp:='';

  if ExpressFrom.XDBGrid1=DBGridFilter
  then
      With ExpDataModule,ExpBatchsDataSet do
      begin
        Filtered:=False;
        Filter:='(a.filial='+DBLookupComboBox1.KeyValue+DBLookupComboBox2.KeyValue+DBLookupComboBox3.KeyValue;
        Filtered:=True;
      end;
end;

procedure TFormFilter.Button2Click(Sender: TObject);
begin
  FormFilter.Close;
end;

procedure TFormFilter.FormShow(Sender: TObject);
begin
  CheckBox1.Checked:=False;
  CheckBox2.Checked:=False;
  CheckBox3.Checked:=False;
  DBLookupComboBox1.KeyValue:=-1;
  DBLookupComboBox2.KeyValue:=-1;
  DBLookupComboBox3.KeyValue:=-1;
end;

end.
