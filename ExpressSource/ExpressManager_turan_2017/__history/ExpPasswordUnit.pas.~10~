unit ExpPasswordUnit;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, ExtCtrls, CMHintBox;

type
  TExpPasswordForm = class(TForm)
    GroupBox1: TGroupBox;
    Button1: TButton;
    Button2: TButton;
    EditPassword: TEdit;
    CMHintBox1: TCMHintBox;
    procedure Button2Click(Sender: TObject);
    procedure Button1Click(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
  private
    { Private declarations }
  public
    const FMani:boolean=False;
    { Public declarations }
  end;

var
  ExpPasswordForm: TExpPasswordForm;

implementation

uses ExpDataModuleUnit, ExpUnitImpl, ExpUnitNewImpl,sboapiDataModuleImpl;

{$R *.dfm}

procedure TExpPasswordForm.Button1Click(Sender: TObject);
var
  descript, s: string;
  ID:integer;
begin
  with ExpDataModule, ExpIncomingPassword do
  begin
    s := EditPassword.Text;
    close;
    SetVariable('v_password', s);
    Open;

    if (RecordCount > 0)  then
    begin
      if not(FMani) then
      begin
        ExpFormNew.FForm := 2;
        ExpFormNew.Button1.Visible := True;
        ExpFormNew.ShowModal;
      end
      else
        begin
           ID:=FieldByName('id').AsInteger;
           Try
              Repair.CallProcedure('ReturnAmountTransaction', [ID]);
              sboapiDataModule.SBSession.Commit;
              ExpPasswordForm.Close;
              ExpIncomingDataSet.Refresh;
              ExpIncomingDataSet.Locate('ID', ID, []);
            Except
             on E: Exception do
             begin
               descript := E.Message;
               sboapiDataModule.SBSession.Rollback;
               ShowMessage(descript);
             end;
          end
       end
    end
    else
    begin
      CMHintBox1.ShowMessage('Şifrə düzgün deyil!');
      EditPassword.clear;
    end;
  end;

end;

procedure TExpPasswordForm.Button2Click(Sender: TObject);
begin
  FMani:=False;
  close;
end;

procedure TExpPasswordForm.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  ExpFormNew.FForm := 0;
end;

end.
