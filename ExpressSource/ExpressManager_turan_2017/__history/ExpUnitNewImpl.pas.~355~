function TExpFormNew.Mani(CurrencyEdit: variant): string;
var
  sr, ET: string;
  s: Integer;
  st: real;

begin
  with ExpDataModule do
  begin
    Exp_avalute.Close;
    if FiledBatchs then
      Exp_avalute.SetVariable('valute', ExpBatchsDataSetVAL_COD.AsInteger);
    if FiledIncoming then
      Exp_avalute.SetVariable('valute', ExpIncomingDataSetVAL_COD.AsInteger);
    if FieldBatchsArchive then
      Exp_avalute.SetVariable('valute',
        ExpBatchsArchiveDataSetVAL_COD.AsInteger);
    if FiledIncomingArchive then
      Exp_avalute.SetVariable('valute',
        ExpIncomingarchiveDataSet.FieldByName('VAL_COD').AsInteger);
    Exp_avalute.Open;

  end;

  sr := CurrencyToHR_Azeri(trunc(CurrencyEdit), 0, [0]);
  s := pos('manat', sr);
  delete(sr, s, 5);
  st := round(frac(CurrencyEdit) * 100);

  if CurrencyEdit >= 1 then
  begin
    if st > 0 then
    begin
      ET := sr + '' + ExpDataModule.Exp_avalute.FieldByName('VALU_NAME')
        .AsString + ' ' + FloatToStr(st) + ' ' +
        ExpDataModule.Exp_avalute.FieldByName('Valu_Bala').AsString
    end
    else
      ET := '(' + sr + ')' + '  ' + ExpDataModule.Exp_avalute.FieldByName
        ('VALU_NAME').AsString;
  end
  else
    ET := '(' + FloatToStr(st) + ')' + '  ' +
      ExpDataModule.Exp_avalute.FieldByName('Valu_Bala').AsString;
  Mani := ET;

end;

