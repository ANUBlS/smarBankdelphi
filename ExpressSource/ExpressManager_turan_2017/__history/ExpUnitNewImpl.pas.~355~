procedure TExpFormNew.ClearAll;
var
  i, j, k, z: Integer;
BEGIN
  WITH TabSheet1 DO
  BEGIN
    FOR i := 0 TO ControlCount - 1 DO
    BEGIN
      IF (Controls[i] is TPanel) THEN
        WITH (Controls[i] as TPanel) DO
        BEGIN
          FOR j := 0 TO ControlCount - 1 DO
          BEGIN
            IF (Controls[j] is TGroupBox) THEN
              WITH (Controls[j] as TGroupBox) DO
              BEGIN
                FOR k := 0 TO ControlCount - 1 DO
                BEGIN
                  IF (Controls[k] is TPanel) then
                    WITH (Controls[k] as TPanel) DO
                    BEGIN
                      FOR z := 0 TO ControlCount - 1 DO
                      BEGIN
                        IF (Controls[z] is TDBLookupComboBox) THEN
                          IF (Controls[z] as TDBLookupComboBox)
                            .Name = 'FilialName' THEN
                            (Controls[z] as TDBLookupComboBox).KeyValue :=
                              ExpDataModule.FilialDataSet.FieldByName('id')
                              .AsInteger ELSE (Controls[z] as TDBLookupComboBox)
                              .KeyValue := -1;
                        IF (Controls[z] is TEdit) THEN
                          IF (Controls[z] as TEdit).Name = 'CMCurrencyEdit' THEN
                            (Controls[z] as TEdit).Text :=
                              '0.00' ELSE (Controls[z] as TEdit).Clear;
                        IF (Controls[z] is TDBDateTimeEditEh) THEN
                          (Controls[z] as TDBDateTimeEditEh).Clear;

                      END;
                    END;
                  IF (Controls[k] is TEdit) THEN
                    (Controls[k] as TEdit).Clear;
                END;
              END;
            IF (Controls[j] is TRadioGroup) THEN
              (Controls[j] as TRadioGroup).ItemIndex := -1;
          END;
        END;
    END;
  END;
  WITH TabSheet2 DO
  BEGIN
    FOR i := 0 TO ControlCount - 1 DO
    BEGIN

      IF (Controls[i] is TPanel) THEN
        WITH (Controls[i] as TPanel) DO
        BEGIN
          FOR j := 0 TO ControlCount - 1 DO
          BEGIN
            IF (Controls[j] is TGroupBox) THEN
              WITH (Controls[j] as TGroupBox) DO
              BEGIN
                FOR k := 0 TO ControlCount - 1 DO
                BEGIN
                  IF (Controls[k] is TPanel) then
                    WITH (Controls[k] as TPanel) DO
                    BEGIN
                      FOR z := 0 TO ControlCount - 1 DO
                      BEGIN
                        IF (Controls[z] is TEdit) THEN
                          IF ((Controls[z] as TEdit).Name <> 'EditDate') OR
                            ((Controls[z] as TEdit).Name <> 'EditTime') THEN
                            (Controls[z] as TEdit).Clear;
                        IF (Controls[z] is TMaskEdit) THEN
                          (Controls[z] as TMaskEdit).Clear;
                        IF (Controls[z] is TDBLookupComboBox) THEN
                          (Controls[z] as TDBLookupComboBox).KeyValue := -1;
                        IF (Controls[z] is TDBDateTimeEditEh) THEN
                          (Controls[z] as TDBDateTimeEditEh).Clear;
                        IF (Controls[z] is TMemo) THEN
                          (Controls[z] as TMemo).Clear;
                      END;
                    END;
                  IF (Controls[k] is TEdit) THEN
                    (Controls[k] as TEdit).Clear;
                END;
              END;
            IF (Controls[j] is TRadioGroup) THEN
              (Controls[j] as TRadioGroup).ItemIndex := -1;
          END;
        END;
    END;
  END;

END;

