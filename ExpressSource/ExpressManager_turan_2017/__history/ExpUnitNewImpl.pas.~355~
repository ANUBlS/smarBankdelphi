PROCEDURE TExpFormNew.BitBtn1Click(Sender: TObject);
VAR Nametxt:UTF8String;
BEGIN
  IF (RadioGroup1.ItemIndex = -1) OR (RadioGroup1.ItemIndex = 0) THEN
  BEGIN
    IF (CBoxPassPlaceI.Text = '') THEN
    BEGIN
      CMHintBox3.ShowMessage('Göndərən şəxsin sənədin növü sahəsi seçilməyib');
      exit
    END;
    IF CBoxPassPlaceI.KeyValue = 1 THEN
    BEGIN
      IF (EditPINCodeI.Text = '') THEN
      BEGIN
        CMHintBox3.ShowMessage('Göndərən şəxsin pinkod sahəsi doldurulmayıb ');
        exit
      END;
    END;

    CASE CBoxPassPlaceI.KeyValue OF
      1, 2, 3, 4, 5, 6, 7, 8:
        BEGIN
          IF (EditSerialI.Text = '') THEN
          BEGIN
            CMHintBox3.ShowMessage
              ('Göndərən şəxsin seriya sahəsi doldurulmayıb ');
            exit
          END;

          IF (EditPassportI.Text = '') THEN
          BEGIN
            CMHintBox3.ShowMessage
              ('Göndərən şəxsin nömrə sahəsi doldurulmayıb ');
            exit
          END;

          IF (DBCBox_DocTYPEI.Text = '') THEN
          BEGIN
            CMHintBox3.ShowMessage
              ('Göndərən şəxsin verən orqan sahəsi doldurulmayıb ');
            exit
          END;

          IF VarIsNull(DateEditI.Value) THEN
          BEGIN
            CMHintBox3.ShowMessage
              ('Göndərən şəxsin verildiyi tarix sahəsi seçilməyib');
            exit
          END;
        END;
    END;

    IF (EditLastNameI.Text = '') THEN
    BEGIN
      CMHintBox3.ShowMessage('Göndərən şəxsin soyadı sahəsi doldurulmayıb ');
      exit
    END;

    IF (EditNameI.Text = '') THEN
    BEGIN
      CMHintBox3.ShowMessage('Göndərən şəxsin adı sahəsi doldurulmayıb ');
      exit
    END;

    IF (EditSonameI.Text = '') THEN
    BEGIN
      CMHintBox3.ShowMessage
        ('Göndərən şəxsin atasının adı sahəsi doldurulmayıb ');
      exit
    END;

    IF ((EditMobilI.Text = '') AND (EditPhoneI.Text = '')) THEN
    BEGIN
      CMHintBox3.ShowMessage
        ('Göndərən şəxsin mobil və ya şəhər telefon sahəsi doldurulmayıb ');
      exit
    END;
  END;

  IF (ValuteName.Text = '') THEN
  BEGIN
    CMHintBox3.ShowMessage('Valyuta sahəsi seçilməyib ');
    exit
  END;

  IF (CMCurrencyEdit.Text = '0.00') THEN
  BEGIN
    CMHintBox3.ShowMessage('Məbləğ sahəsi doldurulmayıb ');
    exit
  END;

  IF SenderAccNo.Enabled AND (SenderAccNo.Text = '') THEN
  BEGIN
    CMHintBox3.ShowMessage('Göndərən şəxsin hesab sahəsi seçilməyib ');
    exit
  END;

  IF RemitInfEdit.Text = '' THEN
  BEGIN
    CMHintBox3.ShowMessage('Təyinat sahəsi doldurulmayıb ');
    exit
  END;

  IF ButtonNominal.Enabled AND not(FormNominalCustomers.RH) THEN
  BEGIN
    CMHintBox3.ShowMessage('Nominal şəxsin bütün məlumatlar sahəsini doldur!');
    exit
  END;

  IF RadioGroup1.ItemIndex = -1 THEN
  BEGIN
    WITH FormSearchCustName.SendDataSetName do
    BEGIN
      Nametxt := EditLastNameI.Text + EditNameI.Text + EditSonameI.Text;
      Close;
      SQL[1] := 'where replace(lower(custname),'' '')=' + 'lower(' +
        QuotedStr(Nametxt) + ')';
      Open;
      if RecordCount > 0 then
      begin
        ExpFormNew.RFormNew := True;
        FormSearchCustName.ShowModal;
      end;
    end;
  end;

  PageControl1.ActivePageIndex := 1;

end;

