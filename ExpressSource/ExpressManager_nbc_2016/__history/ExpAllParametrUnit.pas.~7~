procedure TExpAllParametr.FormShow(Sender: TObject);
begin
  IF not (FilialDataSet.Active)            then   FilialDataSet.Open;
  IF not(ExpTypeDataSet.Active)            then   ExpTypeDataSet.Open;
  IF not(ExpSettingsDataSet.Active)        then   ExpSettingsDataSet.Open;
