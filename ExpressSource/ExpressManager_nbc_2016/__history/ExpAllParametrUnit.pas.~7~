  end;}

    ExpTypeAccountsDataSet.Refresh;

end;

procedure TExpAllParametr.ActnDelExecute(Sender: TObject);
begin
   if ExpTypeAccountsDataSet.RecordCount=0 then exit;



   if   MessageDlg('Silinməsinə  əminsiniz?'
              ,mtConfirmation
              ,[mbYes,mbNo],0
              )<>mrYes then Exit;

   with ExpTypeAccountsDataSet do
   begin
      Delete;
      Refresh;
   end;
end;

procedure TExpAllParametr.ActnEditExecute(Sender: TObject);
