procedure TfrmDepositContract.GenAnnualInt;
var DepositID,CurrencyID :Integer;
    Amount :Real;
begin
   DepositID := ContractTypes.ListSource.DataSet.FieldByName('ID').AsInteger;
   CurrencyID := DBLCBValutes.ListSource.DataSet.FieldByName('valute').AsInteger;
   Amount := dmDepositContract.DepositPorps.FieldByName('Amount').AsFloat;
   if (Amount <> 0) and FInserted then
   with dmDepositContract,sbcm_contract,DepositPorps do
   begin
        FieldByName('INTEREST').AsFloat := CallFloatFunction('Get_DefaultContractRate',
                            ['p_DepositType',DepositID,
                              'p_Currency',CurrencyID,
                              'p_DepositAmount',Amount,
                              'p_defint',True]);

        FieldByName('DUEINTEREST').AsFloat := CallFloatFunction('Get_DefaultContractRate',
                            ['p_DepositType',DepositID,
                              'p_Currency',CurrencyID,
                              'p_DepositAmount',Amount,
                              'p_defint',False]);

   end;

end;

procedure TfrmDepositContract.CheckNeedsFields;
  const
    sDefEmptyFieldMessage = '"%s" sahəsinə qiymət daxil olunmayıb! ';

    procedure ShowMessage(const Message: String);
    begin
      ContractHint.ShowMessage(Message);
      Abort;
    end;

    procedure Check(
      Field: TField;
      Message: String = sDefEmptyFieldMessage;
      FieldName: String = '');
    begin
      if Field.IsNull  then
      begin
        if FieldName = '' then
          FieldName := Field.DisplayName;
        Message := Format(Message, [FieldName]);
        ShowMessage(Message);
      end;
    end;

    procedure CheckByName(const FieldName: String);
    begin
      with dmDepositContract.DepositPorps do
        Check(FieldByName(FieldName));
    end;

    procedure CheckByNames(const Names: array of String);
    var
      Index: Integer;
    begin
      for Index := Low(Names) to High(Names) do
        CheckByName(Names[Index]);
    end;

  begin
    CheckByNames(['BRANCHID', 'CONTRACTNO', 'OPENDATE', 'CLOSEDATE', 'INTEREST','OVERDUEINTEREST',
                   'CONTRACTTYPE','CLIENTTYPE','PERSONALTYPE','CURRENCY','CUSTOMERID']);
    with dmDepositContract,DepositPorps,sbcm_contract do
    begin

       if FieldByName('ContractAccID').AsInteger = 0 then ShowMessage('Deposit Hesabı sahəsinə qiymət daxil olunmayıb! ');
       if FieldByName('ClientAccID').AsInteger = 0   then ShowMessage('Cari    Hesabı sahəsinə qiymət daxil olunmayıb! ');
       if FieldByName('InterestAccID').AsInteger = 0 then ShowMessage('Faizlər Hesabı sahəsinə qiymət daxil olunmayıb! ');
      // if FieldByName('TaxAccID').AsInteger = 0      then ShowMessage('Plastik Kart Hesabı sahəsinə qiymət daxil olunmayıb! ');

       if not CallBooleanFunction('Check_BankAccount',['p_categoryID',FieldByName('ClientType').AsInteger,
                                                       'p_currencyID',FieldByName('CURRENCY').AsInteger,
                                                       'p_BranchID',FieldByName('BRANCHID').AsInteger]) then
       ShowMessage('Bu tip müqaviləyə "donorlarda  faizlər üçün məxaric hesabı" sazlanmayıb! ');

    end;
  end;


