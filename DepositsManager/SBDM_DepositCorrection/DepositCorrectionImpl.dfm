  object Deposits: TOracleDataSet
    SQL.Strings = (
      'Select'
      '  ContrCorrect.RowID'
      ' ,ContrCorrect.*'
      '  From '
      '   SBCM_Contract_Correction ContrCorrect'
      ' Where '
      '    ('
      '      ContrCorrect.Type#=('
      '      Select  ID'
      '        From  SBCM_Contract_Types'
      '         Where upper(Name)= '#39'DEPOSIT'#39')'
      '     )'
      'order by :OrderKind'
      ' ')
    ReadBuffer = 25
    Optimize = True
    Debug = False
    Variables.Data = {
      03000000010000000A0000003A4F524445524B494E4401000000000000000000
      0000}
    StringFieldsOnly = False
    SequenceField.ApplyMoment = amOnPost
    OracleDictionary.EnforceConstraints = False
